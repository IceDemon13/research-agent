OPENAI_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

MODEL_NAME=gpt-4o-mini
STRONG_MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

POSTGRES_USER=research_agent
POSTGRES_PASSWORD=research_agent
POSTGRES_DB=research_agent
POSTGRES_DSN=postgresql://research_agent:research_agent@postgres:5432/research_agent
POSTGRES_POOL_SIZE=5

SESSION_SECRET=change-me-session-secret
SESSION_COOKIE_NAME=research_agent_session
SESSION_MAX_AGE_SECONDS=43200
SESSION_HTTPS_ONLY=false
ALLOW_DEV_LOGIN=false
ALLOW_HEADER_ACTOR_FALLBACK=false

BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Bootstrap Admin

DEFAULT_ACTOR_ROLE=admin
DEFAULT_ACTOR_DISPLAY_NAME=Local CLI

AUTO_PUBLISH_IMPLEMENTATION_RUNS=false
MAX_RETRY_ATTEMPTS=3
ALLOW_REAL_APPLY=false
ALLOW_PR_CREATION=false
ALLOW_REVIEW_CREATION=false

VALIDATION_BUILD_COMMAND=
VALIDATION_LINT_COMMAND=
VALIDATION_TEST_COMMAND=
VALIDATION_STOP_ON_FAILURE=false
VALIDATION_OUTPUT_MAX_CHARS=4000
VALIDATION_TIMEOUT_SECONDS=120

DATA_DIR=data
INDEX_DIR=index
REPO_REGISTRY_PATH=artifacts/repos/registry.json
REPO_CLONE_ROOT=/repos

LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=agent.log
LOG_LEVEL_CONSOLE=steps
LOG_LEVEL_FILE=debug
LOG_CONSOLE_MAX_CHARS=600
LOG_FILE_MAX_CHARS=0
PIPELINE_CONSOLE_OUTPUT_MODE=summary
PIPELINE_CONSOLE_PREVIEW_CHARS=1200

JIRA_BASE_URL=https://example.invalid
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ALLOWED_PROJECTS=TEL
JIRA_DEFAULT_LIMIT=10

BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
