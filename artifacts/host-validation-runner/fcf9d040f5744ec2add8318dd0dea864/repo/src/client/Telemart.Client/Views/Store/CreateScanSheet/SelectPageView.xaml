<UserControl x:Class="Telemart.Client.Views.Store.CreateScanSheet.SelectPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:createScanSheet="clr-namespace:Telemart.Client.ViewModels.Store.CreateScanSheet"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             mc:Ignorable="d"
             DataContext="{client:Container Type=createScanSheet:SelectPageViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type createScanSheet:SelectPageViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Назад"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Left">
                <dxlc:LayoutItem Label="Заказов">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=Model.Orders.Count, Mode=OneWay, FallbackValue=0}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" шт." />
                    </StackPanel>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Мест">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=Model.PlacesCount, Mode=OneWay, FallbackValue=0}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" шт." />
                    </StackPanel>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=Model.Orders, Mode=OneWay}"
                             CurrentItem="{Binding Path=Model.SelectedOrder, Mode=TwoWay}"
                             ShowBorder="True"
                             SelectionMode="None"
                             AutoExpandAllGroups="True"
                             DesignTimeDataObjectType="{x:Type createScanSheet:ScanSheetOrderViewItem}">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:LayoutSerializationBehavior FileName="shippments.xml" />
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                    <dxmvvm:FocusBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Заказ"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="Id"
                                    FixedWidth="True"
                                    AllowResizing="True"
                                    AllowBestFit="False"
                                    AllowColumnFiltering="False"
                                    MinWidth="55"
                                    Width="60">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Дата X"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="DeliveryTime"
                                    FixedWidth="True"
                                    MinWidth="24"
                                    Width="100"
                                    AllowBestFit="False"
                                    AllowResizing="True"
                                    AllowAutoFilter="False"
                                    AllowSorting="True"
                                    GroupInterval="Date">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                  NullText=""
                                                  MaskUseAsDisplayFormat="True"
                                                  Mask="dd.MM.yyyy HH:mm"
                                                  MaskType="DateTime" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Подразд."
                                    HeaderToolTip="Подразделение"
                                    FieldName="Subdivision"
                                    FixedWidth="False"
                                    Width="83"
                                    MinWidth="24"
                                    AllowBestFit="False"
                                    FilterPopupMode="CheckedList"
                                    ColumnFilterMode="DisplayText"
                                    AllowResizing="True"
                                    AllowAutoFilter="False"
                                    DisplayTemplate="{StaticResource SubdivisionColumnDisplayTemplate}">
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Доставка"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="Carry"
                                    FixedWidth="False"
                                    Width="94"
                                    MinWidth="24"
                                    AllowBestFit="False"
                                    FilterPopupMode="CheckedList"
                                    ColumnFilterMode="DisplayText"
                                    AllowResizing="True"
                                    AllowColumnFiltering="True"
                                    AllowAutoFilter="False"
                                    SortMode="Custom"
                                    DisplayTemplate="{StaticResource CarryTypeColumnDisplayTemplate}">
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True"
                                   AllowEditing="False"
                                   NavigationStyle="Cell"
                                   ShowIndicator="False"
                                   ShowAutoFilterRow="False"
                                   ShowGroupedColumns="False"
                                   ShowFixedTotalSummary="False"
                                   IsTotalSummaryMenuEnabled="False"
                                   IsColumnChooserVisible="False"
                                   AllowColumnMoving="False"
                                   ShowTotalSummary="False"
                                   AllowGrouping="False"
                                   ShowGroupPanel="False"
                                   EditorShowMode="MouseDownFocused"
                                   AllowFilterEditor="False"
                                   AllowSorting="False"
                                   AllowBestFit="True"
                                   AllowPrintDetails="True"
                                   AllowResizing="True"
                                   AllowMasterDetail="False"
                                   IsColumnMenuEnabled="False">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxe:ProgressBarEdit Value="{Binding Path=Model.ProgressValue, Mode=OneWay}"
                                 Content="{Binding Path=Model.ProgressText, Mode=OneWay}"
                                 ContentDisplayMode="Content"
                                 IsPercent="False"
                                 Height="22" />
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>
