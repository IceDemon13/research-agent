<UserControl x:Class="Telemart.Client.Views.ProductCompatibility.ProductCompatibilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.ProductCompatibility"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
             DataContext="{client:Container Type=viewModels:ProductCompatibilitiesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:ProductCompatibilitiesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}"/>
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarSubItem Content="Добавить"
                                ToolTip="Добавить"
                                LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                Glyph="{dx:DXImage Image=Add_16x16.png}"
                                IsVisible="{Binding Path=CanCreate}" >
                    <dxb:BarButtonItem Content="Правило сборки ПК"
                                       ToolTip="Правило сборки ПК"
                                       Glyph="../../Images/Common/plugin_add.png"
                                       Command="{Binding Path=CreateCommand, Mode=OneTime}"
                                       CommandParameter="{x:Static dictionaries:ProductCompatibilityType.PC}"/>
                    <dxb:BarButtonItem Content="Правило для аксессуаров"
                                       ToolTip="Правило для аксессуаров"
                                       Glyph="../../Images/Common/mouse_add.png"
                                       Command="{Binding Path=CreateCommand, Mode=OneTime}"
                                       CommandParameter="{x:Static dictionaries:ProductCompatibilityType.Accessory}"/>
                </dxb:BarSubItem>
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneTime}"
                                   IsVisible="{Binding Path=CanEdit}" />
                <dxb:BarButtonItem Content="Удалить"
                                   ToolTip="Удалить (Del)"
                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                   Command="{Binding Path=DeleteCommand, Mode=OneWay}"
                                   IsVisible="{Binding Path=CanDelete}" />
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxlc:LayerSeparator Height="1"
                             Kind="Horizontal" />
        <dxg:GridControl x:Name="GridControl"
                         ItemsSource="{Binding Path=ProductCompatibilities, Mode=OneWay}"
                         CurrentItem="{Binding Path=SelectedProductCompatibility, Mode=TwoWay}"
                         ShowBorder="False"
                         SelectionMode="None"
                         ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
            <dxmvvm:Interaction.Behaviors>
                <behaviors:LayoutSerializationBehavior FileName="assembly_compatibilities_2.xml" />
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Bands>
                <dxg:GridControlBand Header="Инфо"
                                     HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn Header="Код"
                                    HeaderToolTip="Код"
                                    FieldName="Id"
                                    FixedWidth="True"
                                    Width="50"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Знак"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="CompareMethod"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    Width="50"
                                    FixedWidth="True"/>
                    <dxg:GridColumn Header="Сообщение"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="ValidationMessageTemplate"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False" />
                    <dxg:GridColumn Header="Тип"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="TypeId"
                                    FixedWidth="True"
                                    Width="40"
                                    AllowColumnFiltering="True"
                                    ColumnFilterMode="DisplayText"
                                    FilterPopupMode="CheckedList"
                                    AllowGrouping="True" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Types}"
                                                      ValueMember="Id"
                                                      DisplayMember="ShortName"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="А"
                                    HeaderToolTip="Активна"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="Active"
                                    Width="26"
                                    FilterPopupMode="CheckedList"
                                    FixedWidth="True"
                                    AllowResizing="False"
                                    DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                    </dxg:GridColumn>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="Oграничиваемый товар"
                                     HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn Header="Категория"
                                    HeaderToolTip="Категория"
                                    FieldName="SlaveCategoryId"
                                    FixedWidth="True"
                                    FilterPopupMode="CheckedList"
                                    ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Categories}"
                                                      DisplayMember="DisplayValue"
                                                      ValueMember="Id" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Характеристика"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="SlaveFeature.DisplayValue"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    FixedWidth="True"/>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="Oграничивающий товар"
                                     HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn Header="Категория"
                                    HeaderToolTip="Категория"
                                    FieldName="MasterCategoryId"
                                    FixedWidth="True"
                                    FilterPopupMode="CheckedList"
                                    ColumnFilterMode="DisplayText">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Categories}"
                                                      DisplayMember="DisplayValue"
                                                      ValueMember="Id" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Характеристика"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="MasterFeature.DisplayValue"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    FixedWidth="True"/>
                    <dxg:GridColumn Header="Уведомление"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Left"
                                    FieldName="NotificationImageId"
                                    AllowBestFit="True"
                                    AllowResizing="True"
                                    MinWidth="30"
                                    Width="60"
                                    MaxWidth="100"
                                    AllowGrouping="True"
                                    AllowColumnFiltering="True"
                                    FilterPopupMode="CheckedList"
                                    AllowAutoFilter="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=NotificationImages}"
                                                      ValueMember="Id"
                                                      DisplayMember="Name"
                                                      HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
            </dxg:GridControl.Bands>
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                               AllowEditing="False"
                               NavigationStyle="Cell"
                               ShowIndicator="False"
                               ShowAutoFilterRow="False"
                               ShowFixedTotalSummary="False"
                               IsTotalSummaryMenuEnabled="False"
                               ShowTotalSummary="False"
                               AllowSorting="True"
                               AllowGrouping="True"
                               AllowColumnFiltering="True"
                               AllowColumnMoving="True"
                               AllowResizing="True"
                               AllowBestFit="True"
                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                               Command="{Binding Path=EditCommand, Mode=OneWay}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem SummaryType="Count"
                                     Alignment="Right"
                                     Visible="True" />
            </dxg:GridControl.GroupSummary>
        </dxg:GridControl>
    </dxlc:LayoutControl>

</UserControl>