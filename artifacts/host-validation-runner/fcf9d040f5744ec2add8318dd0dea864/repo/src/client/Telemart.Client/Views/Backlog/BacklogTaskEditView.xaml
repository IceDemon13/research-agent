<UserControl x:Class="Telemart.Client.Views.Backlog.BacklogTaskEditView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Backlog"
             DataContext="{client:Container Type=viewModels:BacklogTaskEditViewModel}"
             Width="900"
             Height="500"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:BacklogTaskEditViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Priority.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ComboBoxReadOnlyConditionsStyle"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutItem Label="Задача">
                <dxlc:LayoutGroup VerticalAlignment="Top">
                    <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}"
                                  AcceptsReturn="False" />
                    <dx:SimpleButton HorizontalAlignment="Right"
                                     Width="22"
                                     MinWidth="22"
                                     Padding="2"
                                     GlyphToContentOffset="0"
                                     GlyphAlignment="Right"
                                     ButtonKind="Toggle"
                                     IsChecked="{Binding Path=Model.IsFavorite}"
                                     Command="{Binding AddOrRemoveTaskFromFavoritesCommand}"
                                     Glyph="../../Images/Common/star_16x16.png"
                                     HorizontalContentAlignment="Right" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxlc:LayoutGroup x:Name="Tab0"
                                  Orientation="Horizontal"
                                  Margin="8">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/information.png" />
                                <TextBlock Text="Основное"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup x:Name="MainLayoutGroup"
                                      Orientation="Vertical"
                                      dxe:ValidationService.IsValidationContainer="True"
                                      IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
                        <dxlc:LayoutItem Label="Приоритет">
                            <dxe:ComboBoxEdit EditValue="{Binding Path=Model.Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              ItemsSource="{Binding Path=Priorities}"
                                              ApplyItemTemplateToSelectedItem="True"
                                              IsTextEditable="False"
                                              Style="{StaticResource ComboBoxReadOnlyConditionsStyle}"
                                              ItemTemplate="{StaticResource PriorityComboBoxItemTemplate}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Ответственный">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.Employee, Mode=OneWay, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            Height="22"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                Command="{Binding Path=ChangeResponsibleCommand, Mode=OneWay}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Estimate">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.Estimate, Mode=OneWay, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            Height="22"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                Command="{Binding Path=ChangeEstimateCommand, Mode=OneWay}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Jira">
                            <dxe:TextEdit CharacterCasing="Upper"
                                          EditValue="{Binding Path=Model.JiraId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Комментарий"
                                         LabelVerticalAlignment="Top"
                                         VerticalAlignment="Stretch">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          VerticalContentAlignment="Top"
                                          MaxLength="1000"
                                          TextWrapping="Wrap"
                                          AcceptsReturn="True"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      Width="200">
                        <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                                      LabelColumnWidth="*"
                                                      ContentColumnWidth="2*" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Категории">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/ProductsCatalog/folder_table_32x32.png"
                                            Width="16"
                                            Height="16" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Margin="5,0,0,0"
                                           Foreground="{Binding Path=DataContext.IsNotAnyCategoryChecked, ElementName=LayoutControl, Mode=OneWay, Converter={StaticResource BooleanToColorConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup x:Name="Tab1"
                                      Orientation="Vertical"
                                      ItemSpace="0">
                        <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                            IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                            <dxb:BarButtonItem Content="Развернуть"
                                               ToolTip="{Binding Path=Content, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                               Glyph="../../Images/Actions/toggle_expand_16_16.png"
                                               Command="{Binding Path=View.Commands.(dxg:TreeListViewCommands.ExpandAllNodes), Mode=OneTime, ElementName=CategoriesGridControl}" />
                            <dxb:BarButtonItem Content="Свернуть"
                                               ToolTip="{Binding Path=Content, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                               Glyph="../../Images/Actions/toggle_16_16.png"
                                               Command="{Binding Path=View.Commands.(dxg:TreeListViewCommands.CollapseAllNodes), Mode=OneTime, ElementName=CategoriesGridControl}" />
                        </dxb:ToolBarControl>
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl x:Name="CategoriesGridControl"
                                         ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                         SelectionMode="Row"
                                         ShowBorder="False"
                                         ItemsSourceChanged="CategoriesGridControlOnItemsSourceChanged">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Name" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="TreeListView"
                                                  TreeDerivationMode="Selfreference"
                                                  ShowColumnHeaders="False"
                                                  ShowCheckboxes="True"
                                                  CheckBoxFieldName="Checked"
                                                  AllowRecursiveNodeChecking="True"
                                                  KeyFieldName="Id"
                                                  ParentFieldName="ParentId"
                                                  NavigationStyle="Row"
                                                  FilterMode="Extended"
                                                  ShowSearchPanelMode="Always"
                                                  SearchPanelHighlightResults="True"
                                                  ExpandNodesOnFiltering="True"
                                                  AllowEditing="False"
                                                  AllowBestFit="True"
                                                  AllowSorting="False"
                                                  AllowDrop="False"
                                                  ShowVerticalLines="False"
                                                  ShowHorizontalLines="False"
                                                  FetchSublevelChildrenOnExpand="False"
                                                  ShowIndicator="False"
                                                  TreeLineStyle="Solid"
                                                  AutoWidth="True"
                                                  ShowFilterPanelMode="Never"
                                                  AutoExpandAllNodes="False"
                                                  ShowExpandButtons="True"
                                                  UseEvenRowBackground="False">
                                    <dxg:TreeListView.FormatConditions>
                                        <dxg:FormatCondition Expression="[Active] = false">
                                            <dx:Format Foreground="DarkGray" />
                                        </dxg:FormatCondition>
                                    </dxg:TreeListView.FormatConditions>
                                </dxg:TreeListView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">


                    <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                      Orientation="Horizontal"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                        <dxlc:LayoutGroup.Visibility>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                <Binding Path="OkCommand.IsExecuting" />
                                <Binding Path="SaveCommand.IsExecuting" />
                                <Binding Path="LockCommand.IsExecuting" />
                            </MultiBinding>
                        </dxlc:LayoutGroup.Visibility>
                        <viewComponents:WaitImage HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Обработка..." />
                    </dxlc:LayoutGroup>
                    <TextBlock
                        Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                        Foreground="Red"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="Model.EmployeeLockId"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:ObjectToBooleanConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <dx:SimpleButton Content="Уточнить"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     Glyph="/Images/Order/add_from_template.png"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.SpecifyBacklogTaskCommand, Mode=OneTime}" />
                    <dx:SimpleButton Content="Передать в IT"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     Glyph="/Images/Common/android_16x16.png"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.TransferToItBacklogTaskCommand, Mode=OneTime}" />
                    <dx:SimpleButton Content="Создать в Jira"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.CreateInJiraBacklogTaskCommand, Mode=OneTime}" />
                    <dx:SimpleButton Content="Добавить в план"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     Glyph="/Images/Common/calendar_edit.png"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.AddToPlanBacklogTaskCommand, Mode=OneTime}" />
                    <dx:SimpleButton Content="Отменить"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     Glyph="/Images/Common/canceled.png"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.CancelBacklogTaskCommand, Mode=OneTime}" />
                    <dx:SimpleButton Content="Завершить"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     Glyph="/Images/Common/tick.png"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.CompleteBacklogTaskCommand, Mode=OneTime}" />
                    <dx:SimpleButton Content="Реализовать"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                     Glyph="/Images/Common/tick_grey_16x16.png"
                                     CommandParameter="{Binding Path=Model, Mode=OneWay}"
                                     Command="{Binding Path=DocumentCommands.RealizeBacklogTaskCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="MainLayoutGroup"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee" />
                                <Binding Path="IsNotAnyCategoryChecked"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>