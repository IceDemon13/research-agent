<UserControl x:Class="Telemart.Client.Views.Directories.Organization.OrganizationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:organization="clr-namespace:Telemart.Client.ViewModels.Directories.Organization"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             mc:Ignorable="d"
             x:Name="CurrentUserControl"
             DataContext="{client:Container Type=organization:OrganizationsViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type organization:OrganizationsViewModel}}"
             d:DesignHeight="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   ToolTip="Создать (Insert)"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddCommand, Mode=OneWay}"
                                   GlyphAlignment="Top"
                                   IsVisible="{Binding Path=IsCurrentUserEditable}">
                </dxb:BarButtonItem>
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Path=CurrentOrganization, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxlc:LayerSeparator Height="1"
                             VerticalAlignment="Top"
                             Grid.Row="1"
                             Kind="Horizontal" />
        <dxdo:DockLayoutManager Grid.Row="2">
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Margin="0">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel x:Name="Center"
                                      Style="{StaticResource PanelStyle}"
                                      ShowBorder="False">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Organizations, Mode=OneWay}"
                                         CurrentItem="{Binding Path=CurrentOrganization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ShowBorder="False"
                                         SelectionMode="None"
                                         AutoExpandAllGroups="True">
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="RefreshCommand.IsExecuting" />
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="organizations.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Id"
                                                Header="Номер"
                                                FixedWidth="True"
                                                AllowMoving="False"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="False"
                                                AllowColumnFiltering="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="OrganizationOwnership.Name"
                                                Header="Тип"
                                                HeaderToolTip="Форма собственности"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Name"
                                                Header="Название"
                                                AllowBestFit="True"
                                                FixedWidth="False"
                                                AllowColumnFiltering="False"
                                                AllowGrouping="False"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Stretch" />
                                <dxg:GridColumn FieldName="Inn"
                                                Header="ИНН"
                                                AllowBestFit="True"
                                                FixedWidth="False"
                                                AllowSorting="False"
                                                AllowColumnFiltering="False"
                                                AllowGrouping="False"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Left" />
                                <dxg:GridColumn FieldName="InnVatPayer"
                                                Header="ИНН НДС"
                                                AllowBestFit="True"
                                                FixedWidth="False"
                                                AllowSorting="False"
                                                AllowColumnFiltering="False"
                                                AllowGrouping="False"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Left" />
                                <dxg:GridColumn FieldName="Okpo"
                                                Header="ОКПО"
                                                AllowBestFit="True"
                                                FixedWidth="False"
                                                AllowSorting="False"
                                                AllowColumnFiltering="False"
                                                AllowGrouping="False"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Stretch" />
                                <dxg:GridColumn FieldName="IsVatPayer"
                                                Header="НДС"
                                                HeaderToolTip="Является плательщиком НДС"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                AllowColumnFiltering="True"
                                                AllowGrouping="False"
                                                MinWidth="35"
                                                Width="35"
                                                HorizontalHeaderContentAlignment="Stretch">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/tick.png"
                                                        Visibility="{Binding Path=RowData.Row.IsVatPayer, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                                <dxg:GridColumn FieldName="Active"
                                                Header="А"
                                                HeaderToolTip="Активна"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                AllowColumnFiltering="True"
                                                AllowGrouping="False"
                                                MinWidth="24"
                                                Width="24"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/tick.png"
                                                        Visibility="{Binding Path=RowData.Row.Active, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                                <dxg:GridColumn Header="З"
                                                HorizontalHeaderContentAlignment="Center"
                                                HeaderToolTip="Заблокировал"
                                                FieldName="EmployeeLockId"
                                                FixedWidth="True"
                                                Width="24"
                                                MinWidth="24"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowAutoFilter="False"
                                                AllowSorting="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/lock.png"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Path=RowData.Row.EmployeeLockId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                        HorizontalAlignment="Center">
                                                <dx:DXImage.ToolTip>
                                                    <dxlc:LayoutControl Orientation="Vertical">
                                                        <dxlc:LayoutControl.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight"
                                                                        Value="Bold" />
                                                            </Style>
                                                        </dxlc:LayoutControl.Resources>
                                                        <dxlc:LayoutItem Label="Заблокировал:">
                                                            <TextBlock Text="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay}" />
                                                        </dxlc:LayoutItem>
                                                    </dxlc:LayoutControl>
                                                </dx:DXImage.ToolTip>
                                            </dx:DXImage>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True"
                                               AllowEditing="False"
                                               NavigationStyle="Cell"
                                               ShowIndicator="False"
                                               ShowAutoFilterRow="False"
                                               ShowFixedTotalSummary="False"
                                               IsTotalSummaryMenuEnabled="False"
                                               ShowGroupPanel="False"
                                               ShowTotalSummary="False"
                                               ItemsSourceErrorInfoShowMode="None"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                               CommandParameter="{Binding Path=CurrentOrganization, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>

</UserControl>
