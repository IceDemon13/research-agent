<UserControl x:Class="Telemart.Client.Views.Service.ServiceRepairs.TakeFromServiceCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             DataContext="{client:Container Type=viewModels:TakeFromServiceCenterViewModel}"
             Width="380"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:TakeFromServiceCenterViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <dxmvvm:ObjectToObjectConverter x:Key="DenyOfWarrantyConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="{x:Static dictionaries:ServiceRepairState.DenyOfWarranty }"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="RemovedFromRegisterConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="{x:Static dictionaries:ServiceRepairState.RemovedFromRegister }"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="ConclusionConverter"
                                                    DefaultTarget="Visible">
                        <dxmvvm:MapItem Source="{x:Static dictionaries:ServiceRepairState.NotRepaired}"
                                        Target="Collapsed" />
                        <dxmvvm:MapItem Source="{x:Static dictionaries:ServiceRepairState.WrongSent}"
                                        Target="Collapsed" />
                        <dxmvvm:MapItem Source="{x:Static dictionaries:ServiceRepairState.NotSent}"
                                        Target="Collapsed" />
                    </dxmvvm:ObjectToObjectConverter>
                    <x:Array x:Key="States"
                             Type="{x:Type dictionaries:ServiceRepairState}">
                        <x:Static Member="dictionaries:ServiceRepairState.Repaired" />
                        <x:Static Member="dictionaries:ServiceRepairState.NotRepaired" />
                        <x:Static Member="dictionaries:ServiceRepairState.DefectWasNotConfirmed" />
                        <x:Static Member="dictionaries:ServiceRepairState.DenyOfWarranty" />
                        <x:Static Member="dictionaries:ServiceRepairState.RemovedFromRegister" />
                        <x:Static Member="dictionaries:ServiceRepairState.WrongSent" />
                        <x:Static Member="dictionaries:ServiceRepairState.NotSent" />
                    </x:Array>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Склад">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Path=WarehouseLocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Результат">
                    <dxe:ComboBoxEdit ItemsSource="{StaticResource States}"
                                      EditValue="{Binding Path=RepairState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name" />
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  Visibility="{Binding Path=RepairState, Mode=OneWay, Converter={StaticResource DenyOfWarrantyConverter}}">
                    <dxlc:LayoutItem Label="Причина">
                        <dxe:TextEdit EditValue="{Binding Path=RejectReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="{x:Static viewModels:TakeFromServiceCenterViewModel.MaxReasonLength}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Альтернатива">
                        <dxe:TextEdit EditValue="{Binding Path=RejectAlternative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="{x:Static viewModels:TakeFromServiceCenterViewModel.MaxAltLength}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Снять с гарантии"
                                     Visibility="{Binding Path=WarrantyRemoveVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                        <dxe:CheckEdit EditValue="{Binding Path=WarrantyRemove, Mode=TwoWay}"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutItem Label="Акт"
                                 Visibility="{Binding Path=RepairState, Mode=OneWay, Converter={StaticResource RemovedFromRegisterConverter}}">
                    <dxe:TextEdit EditValue="{Binding Path=Act, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="{x:Static viewModels:TakeFromServiceCenterViewModel.MaxActLength}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Вывод АСЦ"
                                 Visibility="{Binding Path=RepairState, Mode=OneWay, Converter={StaticResource ConclusionConverter}}">
                    <dxe:TextEdit EditValue="{Binding Path=ServiceCenterConclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="{x:Static viewModels:TakeFromServiceCenterViewModel.MaxConclusionLength}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <Button Content="Принять"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
