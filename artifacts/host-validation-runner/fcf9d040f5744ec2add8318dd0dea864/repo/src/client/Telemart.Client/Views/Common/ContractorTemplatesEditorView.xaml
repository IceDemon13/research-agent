<UserControl x:Name="CurrentUserControl"
             x:Class="Telemart.Client.Views.Common.ContractorTemplatesEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:common="clr-namespace:Telemart.Client.ViewModels.Common"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type common:ContractorTemplatesEditorViewModel}}"
             d:DesignHeight="300"
             d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand}" />
        <!--TODO: Code duplicate. Use DialogDocumentManagerService from WorkspaceView-->
        <dx:WindowedDocumentUIService x:Name="DialogDocumentManagerService"
                                      DocumentShowMode="Dialog"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterOwner">
            <dx:WindowedDocumentUIService.WindowStyle>
                <Style TargetType="{x:Type dx:DXWindow}">
                    <Setter Property="SizeToContent"
                            Value="WidthAndHeight" />
                    <Setter Property="ResizeMode"
                            Value="NoResize" />
                    <Setter Property="AllowSystemMenu"
                            Value="False" />
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemSpace="0"
                        Padding="0">
        <dxmvvm:Interaction.Behaviors>
            <dxmvvm:KeyToCommand KeyGesture="Insert"
                                 Command="{Binding Path=CreateContractorTemplateCommand, Mode=OneWay}" />
            <dxmvvm:KeyToCommand KeyGesture="Delete"
                                 Command="{Binding Path=DeleteContractorTemplateCommand, Mode=OneWay}" />
        </dxmvvm:Interaction.Behaviors>
        <dxlc:LayoutGroup ItemSpace="0"
                          Orientation="Vertical">
            <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                <dxb:BarButtonItem Content="Создать (Insert)"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=CreateContractorTemplateCommand, Mode=OneWay}"/>
                <dxb:BarButtonItem Content="Удалить (Delete)"
                                   Command="{Binding Path=DeleteContractorTemplateCommand, Mode=OneWay}"
                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"/>
                    <dxb:BarButtonItem Content="По умолчанию"
                                   Glyph="../../Images/Order/Actions/lightbulb.png"
                                   Command="{Binding Path=SetDefaultCommand, Mode=OneWay}"
                                   CommandParameter="{StaticResource True}"
                                   IsVisible="{Binding Path=SelectedContractorTemplate.IsDefault, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <dxb:BarButtonItem Content="Удалить умолчание"
                                   Glyph="../../Images/Common/lightbulb_delete.png"
                                   Command="{Binding Path=SetNonDefaultCommand, Mode=OneWay}"
                                   CommandParameter="{StaticResource False}"
                                   IsVisible="{Binding Path=SelectedContractorTemplate.IsDefault, Mode=OneWay}">
                </dxb:BarButtonItem>
            </dxb:ToolBarControl>
            <dxlc:LayerSeparator Height="1"
                                 Kind="Horizontal"
                                 VerticalAlignment="Top" />
            <dxg:GridControl Name="GridControl"
                             ItemsSource="{Binding Path=ContractorTemplates, Mode=OneWay}"
                             CurrentItem="{Binding Path=SelectedContractorTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             ShowBorder="False">
                <dxg:GridControl.ShowLoadingPanel>
                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="HandleSelectedContractorChangedCommand.IsExecuting"
                                 Mode="OneWay" />
                        <Binding Path="CreateContractorTemplateCommand.IsExecuting"
                                 Mode="OneWay" />
                        <Binding Path="DeleteContractorTemplateCommand.IsExecuting"
                                 Mode="OneWay" />
                        <Binding Path="SetDefaultCommand.IsExecuting"
                                 Mode="OneWay" />
                        <Binding Path="SetNonDefaultCommand.IsExecuting"
                                 Mode="OneWay" />
                    </MultiBinding>
                </dxg:GridControl.ShowLoadingPanel>
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Name"
                                    Header="Название"
                                    HeaderToolTip="Название шаблона"
                                    FixedWidth="False"
                                    HorizontalHeaderContentAlignment="Stretch">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit Name="PART_Editor">
                                    <dxe:TextEdit.Style>
                                        <Style TargetType="{x:Type dxe:TextEdit}">
                                            <Setter Property="FontWeight"
                                                    Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=RowData.Row.IsDefault, Mode=OneWay}"
                                                             Value="True">
                                                    <Setter Property="FontWeight"
                                                            Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxe:TextEdit.Style>
                                </dxe:TextEdit>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowResizing="False"
                                   AllowPerPixelScrolling="True"
                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                   Command="{Binding Path=OkCommand, Mode=OneWay}" />
                            <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                                                   Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                                                   PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>