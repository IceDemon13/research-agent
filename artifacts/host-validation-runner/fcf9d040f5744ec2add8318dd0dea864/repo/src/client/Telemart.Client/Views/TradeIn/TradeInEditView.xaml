<controls:TelemartUserControl x:Class="Telemart.Client.Views.TradeIn.TradeInEditView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.TradeIn"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:complaint="clr-namespace:Telemart.Client.Views.Complaint"
                              DataContext="{client:Container Type=viewModels:TradeInEditViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:TradeInEditViewModel}, IsDesignTimeCreatable=True}"
                              mc:Ignorable="d"
                              Width="1140"
                              MinWidth="1140"
                              MaxWidth="1140"
                              Height="650"
                              MinHeight="650"
                              MaxHeight="650"
                              d:DesignHeight="650" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
        <dxmvvm:OpenFileDialogService Title="Выберите документ"
                                      Filter="PDF|*.pdf|Word 97-2003 Document|*.doc|Word Document|*.docx|JPEG|*.jpg|PNG|*.png"
                                      FilterIndex="4"
                                      Multiselect="True" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent"
                         Margin="0">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=IsVisible, ElementName=BusyIndicator, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dxlc:LayoutGroup Header="Клиент"
                                  Orientation="Vertical"
                                  VerticalAlignment="Stretch"
                                  View="GroupBox">
                    <dxlc:LayoutItem Label="Телефон">
                        <dxlc:LayoutGroup Orientation="Horizontal">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.Phone, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                            AllowDefaultButton="False"
                                            IsTextEditable="True"
                                            Style="{StaticResource  PhoneTextEditReadOnlyConditionsStyle}"
                                            IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}">
                                <dxe:ButtonInfo ToolTip="История клиента по номеру"
                                                GlyphKind="Custom"
                                                Command="{Binding ShowPhoneHistoryClientCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Model.Phone, Mode=OneWay}">
                                    <dxe:ButtonInfo.Content>
                                        <dx:DXImage Margin="2 0 1 0"
                                                    Source="../../../Images/Common/report_magnify_16x16.png" />
                                    </dxe:ButtonInfo.Content>
                                </dxe:ButtonInfo>
                                <dxe:ButtonInfo GlyphKind="Custom"
                                                ToolTip="Найти клиента по номеру"
                                                Command="{Binding CustomerSearchCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Path=Model.Phone, Mode=OneWay}">
                                    <dxe:ButtonInfo.Content>
                                        <dx:DXImage Margin="2 0 1 0"
                                                    Source="../../../Images/Common/book_addresses.png" />
                                    </dxe:ButtonInfo.Content>
                                </dxe:ButtonInfo>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="E-mail">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="50"
                                      IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Фамилия">
                        <dxe:TextEdit EditValue="{Binding Path=Model.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="50"
                                      IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Имя">
                        <dxe:TextEdit EditValue="{Binding Path=Model.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="50"
                                      IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Отчество">
                        <dxe:TextEdit EditValue="{Binding Path=Model.MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="50"
                                      IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="ИНН">
                        <controls:InnTextEdit
                            IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                            Style="{StaticResource ReadOnlyConditionsStyle}"
                            EditValue="{Binding Path=Model.Inn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Связанные документы"
                                  Orientation="Vertical"
                                  VerticalAlignment="Stretch"
                                  View="GroupBox">
                    <dxlc:LayoutItem Label="Заказ">
                        <dxe:ButtonEdit EditValue="{Binding Path=Model.OrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        IsTextEditable="True"
                                        AllowDefaultButton="False"
                                        MaskType="Numeric"
                                        Mask="########"
                                        MaskUseAsDisplayFormat="True"
                                        Style="{StaticResource ReadOnlyConditionsStyle}">
                            <dxe:ButtonEdit.IsReadOnly>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                    <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                    <Binding Path="Model.AllowEdit"/>
                                    <Binding Path="Model.BoughtInTelemart"/>
                                </MultiBinding>
                            </dxe:ButtonEdit.IsReadOnly>
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                       Command="{Binding Path= OrderIdChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxe:ButtonInfo ButtonKind="Simple"
                                            GlyphKind="Cancel"
                                            IsEnabled="{Binding Path=Model.OrderId, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}"
                                            Command="{Binding Path=RemoveOrderCommand, Mode=OneTime}" />
                            <dxe:ButtonInfo GlyphKind="Custom"
                                            ToolTip="Найти заказ"
                                            Command="{Binding SearchOrderCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Path=Model.OrderId, Mode=OneWay}" >
                                <dxe:ButtonInfo.Content>
                                    <dx:DXImage Margin="2 0 1 0"
                                                Source="../../../Images/Common/book_addresses.png" />
                                </dxe:ButtonInfo.Content>
                            </dxe:ButtonInfo>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Серв.заявка">
                        <dxe:ButtonEdit EditValue="{Binding Path=Model.ServiceRequestId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        IsReadOnly="True"
                                        IsTextEditable="True"
                                        AllowDefaultButton="False"
                                        Style="{StaticResource  ReadOnlyConditionsStyle}">
                            <dxe:ButtonInfo ToolTip="Просмотр серверной зявки"
                                            GlyphKind="Custom"
                                            Command="{Binding OpenServiceRequestCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Model.ServiceRequestId, Mode=OneWay}">
                                <dxe:ButtonInfo.Content>
                                    <dx:DXImage Margin="2 0 1 0"
                                                Source="../../../Images/Common/report_magnify_16x16.png" />
                                </dxe:ButtonInfo.Content>
                            </dxe:ButtonInfo>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Предпр. заказ">
                        <dxe:ButtonEdit EditValue="{Binding Path=Model.PresaleOrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        IsTextEditable="True"
                                        AllowDefaultButton="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource ReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="ПТиУ 1С">
                        <dxe:TextEdit EditValue="{Binding Path=Model.CreateInvoice1cResponse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource  ReadOnlyConditionsStyle}"
                                      IsReadOnly="True">
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Возврат 1С">
                        <dxe:TextEdit EditValue="{Binding Path=Model.ReturnInvoice1cResponse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource  ReadOnlyConditionsStyle}"
                                      IsReadOnly="True">
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup  Orientation="Vertical"
                                   VerticalAlignment="Stretch"
                                   Width="320">
                    <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                                  LabelColumnWidth="*"
                                                  ContentColumnWidth="1.7*" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="SelectedTabChildChanged"
                                           Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
                <dxlc:LayoutGroup x:Name="InfoTab"
                                  Header="Инфо"
                                  Orientation="Horizontal"
                                  Padding="10">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/information.png" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutGroup Orientation="Vertical">
                            <dxlc:LayoutItem Label="Покупал в телемарт">
                                <dxe:CheckEdit EditValue="{Binding Model.BoughtInTelemart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                               Style="{StaticResource  ReadOnlyConditionsStyle}">
                                    <dxe:CheckEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:CheckEdit.IsReadOnly>
                                </dxe:CheckEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Товар"
                                             Visibility="{Binding Model.OrderFound, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                                  EditValue="{Binding Path=Model.ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  IsTextEditable="False"
                                                  ValueMember="Id"
                                                  TextWrapping="NoWrap"
                                                  TextTrimming="WordEllipsis"
                                                  AllowUpdateTwoWayBoundPropertiesOnSynchronization="False"
                                                  Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                                    <dxe:ComboBoxEdit.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Background="Transparent"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="WordEllipsis"
                                                       Margin="3,0,0,0" />
                                        </DataTemplate>
                                    </dxe:ComboBoxEdit.ItemTemplate>
                                    <dxe:ComboBoxEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:ComboBoxEdit.IsReadOnly>
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                               Command="{Binding Path=ProductEditValueChangedCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Товар"
                                             Visibility="{Binding Model.OrderFound, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                <dxe:ButtonEdit EditValue="{Binding Path=Model.ProductName, Mode=OneWay}"
                                                IsTextEditable="False"
                                                AllowDefaultButton="False"
                                                Style="{StaticResource ReadOnlyConditionsStyle}">
                                    <dxe:ButtonEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:ButtonEdit.IsReadOnly>
                                    <dxe:ButtonInfo ButtonKind="Simple"
                                                    GlyphKind="Cancel"
                                                    IsEnabled="{Binding Path=Model.ProductId, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}"
                                                    Command="{Binding Path=RemoveProductCommand, Mode=OneTime}" />
                                    <dxe:ButtonInfo ButtonKind="Simple"
                                                    GlyphKind="Regular"
                                                    Command="{Binding Path=SelectProductCommand, Mode=OneTime}" />
                                </dxe:ButtonEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Категория"
                                             Visibility="{Binding Model.OrderFound, Mode=OneWay,UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxe:ButtonEdit EditValue="{Binding Path=SelectedCategory.Name}"
                                                IsTextEditable="False"
                                                AllowDefaultButton="False"
                                                Style="{StaticResource ReadOnlyConditionsStyle}">
                                    <dxe:ButtonEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:ButtonEdit.IsReadOnly>
                                </dxe:ButtonEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Категория"
                                             Visibility="{Binding Model.OrderFound, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                <dxg:LookUpEdit ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                                EditValue="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                DisplayMember="Name"
                                                AutoPopulateColumns="False"
                                                AutoComplete="False"
                                                IncrementalFiltering="True"
                                                FilterCondition="Like"
                                                FindMode="Always"
                                                ImmediatePopup="True"
                                                IsPopupAutoWidth="True"
                                                InvalidValueBehavior="AllowLeaveEditor"
                                                PopupContentTemplate="{StaticResource LookUpEditCategoryControlTemplate}"
                                                Style="{StaticResource LookUpReadOnlyConditionsStyle}">
                                    <dxg:LookUpEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxg:LookUpEdit.IsReadOnly>
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:SearchLookUpEditStyleSettings />
                                    </dxg:LookUpEdit.StyleSettings>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Бренд">
                                <dxe:AutoSuggestEdit EditValue="{Binding Path=Model.Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     ItemsSource="{Binding CurrentCategoryManufactors, Mode=OneWay}"
                                                     Style="{StaticResource  LookUpReadOnlyConditionsStyle}"
                                                     AllowPopupTextHighlighting="True"
                                                     PopupHighlightedTextCriteria="Contains"
                                                     ImmediatePopup="True"
                                                     MaxLength="255"
                                                     IsTextEditable="True">
                                    <dxe:AutoSuggestEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:AutoSuggestEdit.IsReadOnly>
                                    <dxe:AutoSuggestEdit.Buttons>
                                        <dxe:ButtonInfo GlyphKind="Custom"
                                                        ClickMode="Hover"
                                                        IsEnabled="True"
                                                        ToolTip="{Binding Model.CustomerBrand, Mode=OneWay}"
                                                        Visibility="{Binding Path= Model.CustomerBrandChanged, Converter={dx:BooleanToVisibilityConverter}}">
                                            <dxe:ButtonInfo.Content>
                                                <dx:DXImage Margin="2 0 1 0"
                                                            Source="../../../Images/CategoryOptions/pencil.png" />
                                        </dxe:ButtonInfo.Content>
                                    </dxe:ButtonInfo>
                                    </dxe:AutoSuggestEdit.Buttons>
                                </dxe:AutoSuggestEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Сегмент"
                                             Visibility="Visible">
                                <dxe:TextEdit EditValue="{Binding Path=Model.TradeInSegmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource  ReadOnlyConditionsStyle}"
                                              IsReadOnly="True">
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Серийный номер"
                                             Visibility="{Binding OrderFoundProductChanged, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                <dxe:TextEdit EditValue="{Binding Path=Model.SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MaxLength="50"
                                              TextWrapping="NoWrap"
                                              TextTrimming="WordEllipsis"
                                              Style="{StaticResource  ReadOnlyConditionsStyle}"
                                              IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}">
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Серийный номер"
                                             Visibility="{Binding OrderFoundProductChanged, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=SerialNumbers, Mode=OneWay}"
                                                  EditValue="{Binding Path=Model.SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="SerialNumber"
                                                  ValueMember="SerialNumber"
                                                  IsTextEditable="False"
                                                  ApplyItemTemplateToSelectedItem="False"
                                                  AllowNullInput="True"
                                                  Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                                  IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Модель или PN">
                                <dxe:ButtonEdit EditValue="{Binding Path=Model.ModelOrPn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                IsTextEditable="True"
                                                AllowDefaultButton="False"
                                                MaxLength="255"
                                                TextWrapping="NoWrap"
                                                TextTrimming="WordEllipsis"
                                                Style="{StaticResource  ReadOnlyConditionsStyle}">
                                    <dxe:ButtonEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:ButtonEdit.IsReadOnly>
                                    <dxe:ButtonInfo GlyphKind="Custom"
                                                    IsEnabled="True"
                                                    ClickMode="Hover"
                                                    ToolTip="{Binding Model.CustomerModelOrPn, Mode=OneWay}"
                                                    Visibility="{Binding Path= Model.CustomerModelOrPnChanged, Converter={dx:BooleanToVisibilityConverter}}">
                                        <dxe:ButtonInfo.Content>
                                            <dx:DXImage Margin="2 0 1 0"
                                                        Source="../../../Images/CategoryOptions/pencil.png" />
                                        </dxe:ButtonInfo.Content>
                                    </dxe:ButtonInfo>
                                </dxe:ButtonEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Состояние товара">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=TradeInClassValues, Mode=OneWay}"
                                                  EditValue="{Binding Path=Model.ClassId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  ValueMember="Id"
                                                  AllowNullInput="False"
                                                  NullValueButtonPlacement="None"
                                                  IsTextEditable="False"
                                                  Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                                  ToolTip="{Binding ToolTipClass, Mode=OneWay}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                               Command="{Binding Path= EditValueChangedCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="False"/>
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxe:ComboBoxEdit.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Background="Transparent"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="WordEllipsis"
                                                       Margin="3,0,0,0" />
                                        </DataTemplate>
                                    </dxe:ComboBoxEdit.ItemTemplate>
                                    <dxe:ComboBoxEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:ComboBoxEdit.IsReadOnly>
                                    <dxe:ComboBoxEdit.Buttons>
                                        <dxe:ButtonInfo GlyphKind="Custom"
                                                        ClickMode="Hover"
                                                        ToolTip="{Binding CustomerClass, Mode=OneWay}"
                                                        IsEnabled="True"
                                                        Visibility="{Binding Path= Model.CustomerClassChanged, Converter={dx:BooleanToVisibilityConverter}}">
                                            <dxe:ButtonInfo.Content>
                                                <dx:DXImage Margin="2 0 1 0"
                                                            Source="../../../Images/CategoryOptions/pencil.png" />
                                            </dxe:ButtonInfo.Content>
                                        </dxe:ButtonInfo>
                                    </dxe:ComboBoxEdit.Buttons>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Гарантия">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=TradeInWarrantyValues, Mode=OneWay}"
                                                  EditValue="{Binding Path=Model.WarrantyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="Name"
                                                  ValueMember="Id"
                                                  AllowNullInput="False"
                                                  NullValueButtonPlacement="None"
                                                  Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                       <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                               Command="{Binding Path= EditValueChangedCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="False"/>
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxe:ComboBoxEdit.IsReadOnly>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                            <Binding Path="Model.AllowEdit"/>
                                        </MultiBinding>
                                    </dxe:ComboBoxEdit.IsReadOnly>
