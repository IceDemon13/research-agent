                                                IsTextEditable="False"
                                                AllowDefaultButton="False"
                                                IsReadOnly="{Binding IsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                Style="{StaticResource ReadOnlyConditionsStyle}">
                                    <dxe:ButtonInfo GlyphKind="Edit"
                                                    ToolTipService.ToolTip="Выбрать адрес"
                                                    IsEnabled="{Binding IsLockedByCurrentEmployee}"
                                                    Command="{Binding Path=SelectDeliveryAddressCommand, Mode=OneWay}" />
                                </dxe:ButtonEdit>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                 </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="CrmTab"
                                  Header="CRM"
                                  Orientation="Vertical"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/user_suit_16x16.png" />
                                <TextBlock Text="{Binding}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                        <dxb:BarButtonItem Content="Обновить"
                                           ToolTip="{Binding Path=Content, RelativeSource={RelativeSource Self}}"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshCrmCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Колонки"
                                           LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                           Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                           Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                           CommandTarget="{Binding Path=ClientContactsView, ElementName=CrmInfoView}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <commonViews:CrmInfoView x:Name="CrmInfoView"
                                             ClientContacts="{Binding Path=ClientContactsHistoryItems, Mode=OneWay}"
                                             ShowLoadingPanel="{Binding Path=RefreshCrmCommand.IsExecuting, Mode=OneWay}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="ComplaintsTab"
                                              Header="{Binding Path=Model.ComplaintsCountString, Mode=OneWay, FallbackValue=?}"
                                              Orientation="Vertical"
                                              ItemSpace="0">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../../Images/Common/thumb_down_16x16.png" />
                                <TextBlock Text="{Binding StringFormat=Жалобы ({0})}"
                                                       Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <complaint:ComplaintsDocumentControlView AddComplaintCommand="{Binding AddComplaintCommand}"
                                                                         Complaints="{Binding Complaints}"
                                                                         RefreshComplaintsCommand="{Binding RefreshComplaintsCommand}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="BusyIndicator"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="SaveCommand.IsExecuting" />
                            <Binding Path="LockCommand.IsExecuting" />
                            <Binding Path="CompleteRequestCommand.IsExecuting" />
                            <Binding Path="SearchOrderCommand.IsExecuting"/>
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  UseLayoutRounding="True"
                                  Height="22"
                                  Visibility="{Binding ElementName=BusyIndicator, Path=IsVisible, Converter={dx:BooleanToVisibilityConverter Invert=True}}">
                    <dx:SimpleButton x:Name="Lock"
                                     HorizontalAlignment="Left"
                                     Content="Редактировать"
                                     Glyph="/Images/CategoryOptions/pencil.png"
                                     Command="{Binding Path=LockCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                    <dx:SimpleButton Content="Оценить"
                                     Glyph="/Images/TradeIn/ruby_go.png"
                                     Command="{Binding Path=EvaluateRequestCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                    <dx:SimpleButton Content="Принять"
                                     Glyph="/Images/Common/page_white_ruby.png"
                                     Command="{Binding Path=ReceiveCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                    <dx:SimpleButton Content="Переоценить"
                                     Glyph="/Images/TradeIn/ruby_go_1.png"
                                     Command="{Binding Path=ОverEvaluateRequestCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                    <dx:DropDownButton Content="Обработать"
                                       Glyph="/Images/Common/lightning_16x16.png"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                                       Visibility="{Binding Path=TradeInHandleButtonsIsVisible, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}">
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Протестировать"
                                               Glyph="/Images/TradeIn/ruby_key.png"
                                               Command="{Binding Path=TestRequestCommand, Mode=OneWay}"/>
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                    <dx:SimpleButton Content="Создать задачу"
                                     Glyph="/Images/Common/bitrix24.png"
                                     Command="{Binding Path=CreateTaskRequestCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Завершить"
                                     Command="{Binding Path=CompleteRequestCommand, Mode=OneWay}"
                                     Glyph="../../../Images/Common/tick.png"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Отменить"
                                     Command="{Binding Path=CancelRequestCommand, Mode=OneWay}"
                                     Glyph="../../../Images/Common/canceled.png"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  Visibility="{Binding ElementName=BusyIndicator, Path=IsVisible, Converter={dx:BooleanToVisibilityConverter Invert=True}}">
                    <dx:DropDownButton Content="Печать"
                                       Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                       Padding="8,0,0,0">
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Акт"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../Images/Common/cheque.png"
                                               Command="{Binding Path=PrintActCommand, Mode=OneTime}" />
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                    <Button x:Name="OkButton"
                                    Content="OK"
                                    Command="{Binding Path=OkCommand, Mode=OneTime}">
                    <Button.IsEnabled>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter}">
                            <Binding Path="(dxe:ValidationService.HasValidationError)"
                                     Mode="OneWay"
                                     ElementName="LayoutControl"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                            <Binding Path="IsNewOrIsLockedByCurrentEmployee"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>