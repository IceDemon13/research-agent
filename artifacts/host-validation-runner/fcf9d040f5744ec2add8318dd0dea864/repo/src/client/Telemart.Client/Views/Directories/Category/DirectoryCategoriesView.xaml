<UserControl x:Class="Telemart.Client.Views.Directories.Category.DirectoryCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
             xmlns:views="clr-namespace:Telemart.Client.Views.Directories.Category"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Category"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             DataContext="{client:Container Type=viewModels:DirectoryCategoriesViewModel}"
             mc:Ignorable="d"
             d:DesignWidth="1024"
             d:DesignHeight="768"
             d:DataContext="{d:DesignInstance Type=viewModels:DirectoryCategoriesViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CategoryOptionInheritanceMode.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dx:WindowedDocumentUIService Name="CreateCategoryDocumentManagerService"
                                      DocumentShowMode="Dialog"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterOwner">
            <dx:WindowedDocumentUIService.WindowStyle>
                <Style TargetType="{x:Type dx:DXWindow}">
                    <Setter Property="ResizeMode"
                            Value="NoResize" />
                    <Setter Property="SizeToContent"
                            Value="Height" />
                    <Setter Property="AllowSystemMenu"
                            Value="False" />
                    <Setter Property="MinWidth"
                            Value="400" />
                    <Setter Property="Width"
                            Value="400" />
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>

        <dx:WindowedDocumentUIService Name="SaveCategoryDocumentManagerService"
                                      DocumentShowMode="Dialog"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterOwner">
            <dx:WindowedDocumentUIService.WindowStyle>
                <Style TargetType="{x:Type dx:DXWindow}">
                    <Setter Property="ResizeMode"
                            Value="NoResize" />
                    <Setter Property="SizeToContent"
                            Value="Height" />
                    <Setter Property="AllowSystemMenu"
                            Value="False" />
                    <Setter Property="MinHeight"
                            Value="400" />
                    <Setter Property="MinWidth"
                            Value="768" />
                    <Setter Property="Width"
                            Value="768" />
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>

        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxdo:DockLayoutManager>
        <dxdo:LayoutGroup Orientation="Vertical"
                          ItemHeight="*"
                          Margin="2"
                          DockItemInterval="0"
                          LayoutGroupInterval="0"
                          LayoutItemInterval="0">
            <dxdo:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Top"
                              ItemHeight="Auto">
                <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                  VerticalAlignment="Top"
                                  AllowSizing="False"
                                  ShowBorder="False"
                                  ItemHeight="Auto">
                    <dxb:BarManager>
                        <dxb:ToolBarControl>
                            <dxb:BarButtonItem Content="Обновить"
                                               Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                               Command="{Binding RefreshCommand, Mode=OneWay}"
                                               IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                            </dxb:BarButtonItem>
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Добавить"
                                               Glyph="{dx:DXImage Image=Add_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                               Command="{Binding Path=ShowCreateCategoryDialogCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=SelectedCategory, Mode=OneWay}">
                            </dxb:BarButtonItem>
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Робот (New)"
                                               Glyph="../../../Images/Common/android_16x16.png"
                                               LargeGlyph="../../../Images/Common/android_32x32.png"
                                               Command="{Binding Path=RobotCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=SelectedCategory, Mode=OneWay}"/>
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Сохранить"
                                               LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                               Glyph="{dx:DXImage Image=Save_16x16.png}"
                                               Command="{Binding Path=ShowSaveOptionsDialogCommand, Mode=OneWay}">
                                <dxb:BarButtonItem.IsEnabled>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}"
                                                 ElementName="CategoryOptions" />
                                    </MultiBinding>
                                </dxb:BarButtonItem.IsEnabled>
                                <dxb:BarButtonItem.IsVisible>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsEditingAllowed"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </dxb:BarButtonItem.IsVisible>
                            </dxb:BarButtonItem>
                            <dxb:BarButtonItem Content="Изменить"
                                               LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                               Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                               Command="{Binding Path=LockCommand, Mode=OneWay}">
                                <dxb:BarButtonItem.IsEnabled>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsLongOperationInProgress"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                    </MultiBinding>
                                </dxb:BarButtonItem.IsEnabled>
                                <dxb:BarButtonItem.Style>
                                    <Style BasedOn="{StaticResource {x:Type dxb:BarButtonItem}}"
                                           TargetType="dxb:BarButtonItem">
                                        <Setter Property="IsVisible"
                                                Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                        <Binding Path="IsLockedByCurrentEmployee"
                                                                 Mode="OneWay"
                                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                                        <Binding Path="IsEditingAllowed"
                                                                 Mode="OneWay" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="IsVisible"
                                                        Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                        <Binding Path="IsLockedByCurrentEmployee"
                                                                 Mode="OneWay"
                                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                                        <Binding Path="IsMarketer"
                                                                 Mode="OneWay" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="IsVisible"
                                                        Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxb:BarButtonItem.Style>
                            </dxb:BarButtonItem>
                            <dxb:BarButtonItem Content="Отмена"
                                               LargeGlyph="{dx:DXImage Image=Cancel_32x32.png}"
                                               Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                               Command="{Binding Path=CancelCommand, Mode=OneWay}"
                                               IsVisible="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                            </dxb:BarButtonItem>
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Порядок"
                                               LargeGlyph="{StaticResource Accordion32}"
                                               Command="{Binding Path=ReorderCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=SelectedCategory, Mode=OneWay}">
                                <dxb:BarButtonItem.IsVisible>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsAdmin" />
                                        <Binding Path="IsMarketer" />
                                    </MultiBinding>
                                </dxb:BarButtonItem.IsVisible>
                            </dxb:BarButtonItem>
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Перенос"
                                               LargeGlyph="../../../Images/Common/folders_32x32.png"
                                               Command="{Binding Path=MoveCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=SelectedCategory, Mode=OneWay}"
                                               IsVisible="{Binding Path=IsAdmin, Mode=OneWay}" />
                            <dxb:BarItemSeparator />
                            <controls:WikiBarButtonItem />
                        </dxb:ToolBarControl>
                    </dxb:BarManager>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Stretch"
                              ItemHeight="*">
                <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                  ItemWidth="300"
                                  ShowBorder="False">
                    <commonViews:CategoryTreeView Categories="{Binding Path=Categories, Mode=OneWay}"
                                                  SelectedCategory="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="NameWithId">
                        <commonViews:CategoryTreeView.ShowLoadingPanel>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="RefreshCommand.IsExecuting" />
                                <Binding Path="IsLongOperationInProgress" />
                            </MultiBinding>
                        </commonViews:CategoryTreeView.ShowLoadingPanel>
                        <commonViews:CategoryTreeView.IsTreeEnabled>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                <Binding Path="IsLockedByCurrentEmployee" />
                                <Binding Path="IsLongOperationInProgress" />
                            </MultiBinding>
                        </commonViews:CategoryTreeView.IsTreeEnabled>
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="CurrentItemChanged"
                                                   Command="{Binding Path=SetCategoryCommand}"
                                                   PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>
                    </commonViews:CategoryTreeView>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                  ItemWidth="*"
                                  ShowBorder="False">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                        </Grid.ColumnDefinitions>
                        <views:CategoryOptionsView DataContext="{Binding Path=CategoryOptions, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                   HorizontalAlignment="Stretch"
                                                   x:Name="CategoryOptions"
                                                   Grid.Column="0">
                        </views:CategoryOptionsView>
                        <dxlc:LayoutGroup Orientation="Vertical"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Stretch"
                                          View="GroupBox"
                                          Header="Легенда"
                                          Margin="8 0 0 0"
                                          Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="{StaticResource CategoryResourceImage}"
                                            Height="16"
                                            Width="16"
                                            HorizontalAlignment="Left" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="{Binding Path=Name, Source={x:Static dictionaries:CategoryOptionInheritanceMode.InheritableToCategory}, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="{StaticResource ProductResourceImage}"
                                            Height="16"
                                            Width="16"
                                            HorizontalAlignment="Left" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="{Binding Path=Name, Source={x:Static dictionaries:CategoryOptionInheritanceMode.InheritableToCategoryAndProduct}, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border BorderThickness="1"
                                        BorderBrush="DarkGray">
                                    <Rectangle Width="15"
                                               Height="15"
                                               Fill="LightGreen" />
                                </Border>
                                <TextBlock Text=" - " />
                                <TextBlock Text="Значение не равно родительскому" />
                            </StackPanel>
                        </dxlc:LayoutGroup>
                        <dx:WaitIndicator HorizontalAlignment="Left"
                                          Margin="260 0 0 0"
                                          IsHitTestVisible="True"
                                          Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                          DeferedVisibility="True"
                                          Grid.Column="0">
                        </dx:WaitIndicator>
                    </Grid>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>

</UserControl>