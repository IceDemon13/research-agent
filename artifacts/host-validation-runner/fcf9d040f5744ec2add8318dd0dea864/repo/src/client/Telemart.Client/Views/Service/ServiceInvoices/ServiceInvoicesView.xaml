<UserControl x:Class="Telemart.Client.Views.Service.ServiceInvoices.ServiceInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceInvoices"
             DataContext="{client:Container Type=viewModels:ServiceInvoicesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ServiceInvoicesViewModel}}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ServiceInvoiceState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary>
                    <converters:ServiceInvoiceStateSelectedItemsConverter x:Key="ServiceInvoiceStateSelectedItemsConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   ToolTip="Создать (Insert)"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=AddCommand, Mode=OneTime}"
                                   IsVisible="{Binding Path=IsAllowCreate, Mode=OneWay}"/>
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Path=CurrentServiceInvoice, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Реестр"
                                       LargeGlyph="/Images/Common/page_green_32x32.png"
                                       Command="{Binding Path=CreateScanSheetCommand, Mode=OneWay}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Content="Печать"
                                   ToolTip="{Binding Path=Content, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                   LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                   Glyph="{dx:DXImage Image=Print_16x16.png}"
                                   Command="{Binding Path=PrintServiceInvoiceCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Path=CurrentServiceInvoice, Mode=OneWay}" />
                <dxb:BarItemLinkSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel x:Name="Center"
                                      Style="{StaticResource PanelStyle}"
                                      ShowBorder="False">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=ServiceInvoices, Mode=OneWay}"
                                         CurrentItem="{Binding Path=CurrentServiceInvoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ShowBorder="True"
                                         ClipboardCopyMode="ExcludeHeader"
                                         SelectionMode="None"
                                         AutoExpandAllGroups="True">
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="RefreshCommand.IsExecuting" />
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="service_invoices.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Id"
                                                Header="Номер"
                                                FixedWidth="True"
                                                AllowMoving="False"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="False"
                                                AllowColumnFiltering="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Отправка"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                FieldName="SendDate"
                                                MinWidth="24"
                                                Width="70"
                                                GroupIndex="0"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowAutoFilter="False"
                                                GroupInterval="Date">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="{x:Static business:DateFormattingRules.DateFormat}"
                                                              MaskType="DateTime">
                                        </dxe:DateEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="СЦ"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="ServiceCenterId"
                                                FixedWidth="False"
                                                Width="85"
                                                MinWidth="60"
                                                AllowBestFit="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                  ItemsSource="{Binding Path=ServiceCenters, Mode=OneWay}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Склад"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="WarehouseId"
                                                FixedWidth="False"
                                                Width="85"
                                                MinWidth="60"
                                                AllowBestFit="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                  ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Доставка"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="CarryType"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowSorting="True"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                FixedWidth="True"
                                                MinWidth="110"
                                                Width="120"
                                                AllowAutoFilter="True"
                                                DisplayTemplate="{StaticResource CarryTypeColumnDisplayTemplate}">
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Товаров"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FieldName="ProductsCount"
                                                FixedWidth="True"
                                                Width="65"
                                                MinWidth="60"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Статус"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Left"
                                                FieldName="State"
                                                FixedWidth="True"
                                                MaxWidth="80"
                                                Width="30"
                                                MinWidth="26"
                                                AllowBestFit="True"
                                                FilterPopupMode="CheckedList"
                                                AllowColumnFiltering="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                ColumnFilterMode="DisplayText"
                                                DisplayTemplate="{StaticResource ServiceInvoiceStateColumnDisplayTemplate}"/>
                                <dxg:GridColumn FieldName="EmployeeCarrierId"
                                                Header="Водитель"
                                                Visible="False"
                                                AllowBestFit="True"
                                                FixedWidth="False"
                                                ColumnFilterMode="DisplayText"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                Width="120"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Stretch">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                  ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="ТТН"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                Visible="False"
                                                FieldName="Ttn"
                                                FixedWidth="True"
                                                Width="85"
                                                MinWidth="60"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings NullText="0"
                                                              NullValue="{x:Null}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Заявка"
                                                HeaderToolTip="Номер заявки на вызов курьера"
                                                FieldName="NpCourierCallBarcode"
                                                FixedWidth="True"
                                                MaxWidth="90"
                                                MinWidth="24"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Интервал"
                                                HeaderToolTip="Временной интервал заявки на вызов курьера"
                                                FieldName="NpCourierCallInterval"
                                                FixedWidth="True"
                                                MaxWidth="135"
                                                MinWidth="24"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True"
                                               AllowEditing="False"
                                               NavigationStyle="Cell"
                                               ShowIndicator="False"
                                               ShowAutoFilterRow="False"
                                               ShowFixedTotalSummary="False"
                                               IsTotalSummaryMenuEnabled="True"
                                               ShowTotalSummary="False"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                               CommandParameter="{Binding Path=CurrentServiceInvoice, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">

                                <dxlc:LayoutItem Label="Дата">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Order/Filter/calendar.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      VerticalAlignment="Center">
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.ServiceInvoiceSendAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        <TextBlock Text="-"
                                                   Width="8"
                                                   TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.ServiceInvoiceSendBefore, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>

                                <dxlc:LayoutItem Label="Номер">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/cheque.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxg:PrintTextEdit EditValue="{Binding Path=Filter.InvoiceIds, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                       Mask="d"
                                                       AllowNullInput="True"
                                                       MaskType="Numeric" />
                                </dxlc:LayoutItem>

                                <dxlc:LayoutItem Label="Склад">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Invoice/Filter/house.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Warehouses, Mode=OneWay}"
                                                      DisplayMember="DisplayValue"
                                                      EditValue="{Binding Path=Filter.SelectedWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:ComboBoxItemsConverter}}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}"
                                                      AllowNullInput="True">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>

                                <dxlc:LayoutItem Label="СЦ">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/NavigationMenu/wrench.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.ServiceCenters, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedServiceCenters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:ComboBoxItemsConverter}}"
                                                      DisplayMember="DisplayValue"
                                                      Style="{StaticResource TokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>

                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.ServiceInvoiceStates, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedServiceInvoiceStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ServiceInvoiceStateSelectedItemsConverter}}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}"
                                                      ItemTemplate="{StaticResource ServiceInvoiceStateComboBoxItemTemplate}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>

                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Накладных">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=ServiceInvoices.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>

</UserControl>
