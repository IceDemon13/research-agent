<UserControl x:Class="Telemart.Client.Views.Store.Order.ScheduleDeliveryCityCarryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             DataContext="{client:Container Type=viewModels:ScheduleDeliveryCityCarryViewModel}"
             Height="155"
             Width="380"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ScheduleDeliveryCityCarryViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Horizontal">

            </dxlc:LayoutGroup>
            <dxlc:LayoutItem Label="Доставка">
                <dxe:ComboBoxEdit
                    EditValue="{Binding SelectedCarryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    ItemsSource="{Binding Path=Carries, Mode=OneWay}"
                    DisplayMember="DisplayValue"
                    ValueMember="Id"
                    NullValueButtonPlacement="EditBox"
                    Style="{StaticResource LookupComboBoxStyle}"
                    IsReadOnly="False" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Город">
                <dxe:ComboBoxEdit
                    EditValue="{Binding SelectedCityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                    DisplayMember="DisplayValue"
                    ValueMember="Id"
                    NullValueButtonPlacement="EditBox"
                    Style="{StaticResource LookupComboBoxStyle}"
                    IsReadOnly="False" />
            </dxlc:LayoutItem>
            <!-- <dxlc:LayoutItem Label="Дата"> -->
            <!--     <dxlc:LayoutGroup Orientation="Horizontal"> -->
            <!--         <dxe:DateEdit EditValue="{Binding Path=SelectedDate, Mode=TwoWay, ValidatesOnDataErrors=True}" -->
            <!--                       MinValue="{x:Static system:DateTime.Today}" -->
            <!--                       Style="{StaticResource BasicDateEdit}" -->
            <!--                       Mask="{x:Static business:DateFormattingRules.DateFormat}" -->
            <!--                       NullValueButtonPlacement="EditBox" -->
            <!--                       MaskType="DateOnly" -->
            <!--                       ShowClearButton="False" -->
            <!--                       AllowNullInput="False"/> -->
            <!--     </dxlc:LayoutGroup> -->
            <!-- </dxlc:LayoutItem> -->
            <dxlc:LayoutItem Label="Дата">
                <dxe:DateEdit EditValue="{Binding Path=SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MinValue="{x:Static system:DateTime.Today}"
                              MaskType="DateOnly"
                              Mask="dd.MM.yyyy"
                              MaskUseAsDisplayFormat="True"
                              IsTextEditable="False"
                              AllowNullInput="False"
                              AllowRoundOutOfRangeValue="True">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:DateEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           HorizontalAlignment="Left"
                           Style="{StaticResource ImageStyle}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                            IsTabStop="True">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>