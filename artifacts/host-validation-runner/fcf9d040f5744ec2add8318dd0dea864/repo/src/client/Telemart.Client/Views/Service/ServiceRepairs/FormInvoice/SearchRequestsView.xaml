<UserControl x:Class="Telemart.Client.Views.Service.ServiceRepairs.FormInvoice.SearchRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:formInvoice="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs.FormInvoice"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             mc:Ignorable="d"
             DataContext="{client:Container Type=formInvoice:SearchRequestsViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type formInvoice:SearchRequestsViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl x:Name="FilterRoot"
                            Orientation="Vertical"
                            Width="400"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutItem Label="СЦ">
                <dxlc:LayoutItem.LabelTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="../../../../Images/Order/Filter/house.png"
                                        Style="{StaticResource ImageStyle}" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </dxlc:LayoutItem.LabelTemplate>
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=ServiceCenters, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.ServiceCenterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayValue"
                                  Style="{StaticResource SearchableComboBoxStyle}">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Статус">
                <dxlc:LayoutItem.LabelTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="../../../../Images/Order/Filter/lightbulb.png"
                                        Style="{StaticResource ImageStyle}" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </dxlc:LayoutItem.LabelTemplate>
                <dxe:TextEdit EditValue="{Binding Path=Model.State.Name, Mode=OneWay}"
                              Style="{StaticResource ReadOnlyEditorStyle}">
                </dxe:TextEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Местоположение">
                <dxlc:LayoutItem.LabelTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="../../../../Images/Order/Filter/package.png"
                                        Style="{StaticResource ImageStyle}" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </dxlc:LayoutItem.LabelTemplate>
                <dxe:TextEdit EditValue="{Binding Path=Model.Location.Name, Mode=OneWay}"
                              Style="{StaticResource ReadOnlyEditorStyle}">
                </dxe:TextEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Склад">
                <dxlc:LayoutItem.LabelTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="../../../../Images/Order/Filter/house.png"
                                        Style="{StaticResource ImageStyle}" />
                            <TextBlock Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </dxlc:LayoutItem.LabelTemplate>
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses}"
                                  EditValue="{Binding Path=Model.WarehouseId, Mode=OneWay}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayValue"
                                  ShowEditorButtons="False"
                                  Style="{StaticResource ReadOnlyEditorStyle}">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>
