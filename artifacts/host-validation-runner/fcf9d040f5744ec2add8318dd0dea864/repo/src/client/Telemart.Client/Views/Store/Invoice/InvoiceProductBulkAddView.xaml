<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Invoice.InvoiceProductBulkAddView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Invoice"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:dragDropManagers="clr-namespace:Telemart.Client.Common.DragDropManagers"
                              DataContext="{client:Container Type=viewModels:InvoiceProductBulkAddViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:InvoiceProductBulkAddViewModel}}"
                              d:DesignHeight="480"
                              d:DesignWidth="640">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <system:Boolean x:Key="TrueValue">True</system:Boolean>
                    <system:Boolean x:Key="FalseValue">False</system:Boolean>

                    <dxmvvm:ObjectToObjectConverter x:Key="IdToVisibilityConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="1"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="2"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="3"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="4"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="5"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="6"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=HandleTextCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        dxe:ValidationService.IsValidationContainer="True"
                        Orientation="Vertical">
        <dxlc:LayoutGroup Orientation="Horizontal">
            <dxlc:LayoutGroup>
                <dxe:TextEdit x:Name="RawTextEdit"
                              EditValue="{Binding Path=RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              TextWrapping="Wrap"
                              AcceptsReturn="True"
                              AcceptsTab="True"
                              VerticalScrollBarVisibility="Auto"
                              VerticalContentAlignment="Top" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical"
                              Width="210">
                <dxlc:LayoutItem Label="Валюта"
                                 LabelPosition="Top">
                    <dxe:ComboBoxEdit
                        ItemsSource="{Binding Path=Currencies, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                        ValueMember="Id"
                        EditValue="{Binding Path=CurrencyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">

                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Цена"
                                 LabelPosition="Top">
                    <dxe:ComboBoxEdit
                        IsEnabled="{Binding Path=PriceWithTaxEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                        EditValue="{Binding Path=PriceWithTax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                        <dxe:ComboBoxEdit.Items>
                            <dxe:CustomItem DisplayText="Цена с НДС"
                                            EditValue="{StaticResource TrueValue}" />
                            <dxe:CustomItem DisplayText="Цена без НДС"
                                            EditValue="{StaticResource FalseValue}" />
                        </dxe:ComboBoxEdit.Items>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Порядок колонок"
                                 LabelPosition="Top"
                                 VerticalAlignment="Stretch">
                    <dxe:ListBoxEdit ItemsSource="{Binding Path=Columns, Mode=OneWay}"
                                     AllowItemHighlighting="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <dxe:ListBoxEdit.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </dxe:ListBoxEdit.ItemsPanel>
                        <dxe:ListBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Width="200">
                                    <TextBlock
                                        Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <Button Content="x"
                                            HorizontalAlignment="Right"
                                            Width="16"
                                            MinWidth="16"
                                            FontWeight="Bold"
                                            Foreground="Firebrick"
                                            Padding="0 -1 0 2"
                                            Visibility="{Binding Id, Converter={StaticResource IdToVisibilityConverter}}"
                                            Command="{Binding Path=DataContext.RemoveColumnItemCommand, ElementName=LayoutControl}"
                                            CommandParameter="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </dxe:ListBoxEdit.ItemTemplate>
                        <dxmvvm:Interaction.Behaviors>
                            <dragDropManagers:MyListBoxDragDropManager x:Name="ListBoxDragDropManager" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ListBoxEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxg:GridControl ItemsSource="{Binding Path=Items, Mode=OneWay}"
                             ClipboardCopyMode="ExcludeHeader"
                             ShowLoadingPanel="{Binding Path=HandleTextCommand.IsExecuting, Mode=OneWay}">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Код"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="70"
                                    MinWidth="70"
                                    HeaderToolTip="Код товара"
                                    FixedWidth="True"
                                    Binding="{Binding Path=RowData.Row.ProductId, Mode=OneWay}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Код поставщика"
                                    HeaderToolTip="Код товара товара"
                                    HorizontalHeaderContentAlignment="Center"
                                    Binding="{Binding Path=RowData.Row.SupplierProductId, Mode=OneWay}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Артикул"
                                    HorizontalHeaderContentAlignment="Left"
                                    HeaderToolTip="Артикул"
                                    Binding="{Binding Path=RowData.Row.Pn, Mode=OneWay}" />
                    <dxg:GridColumn Header="Название"
                                    HorizontalHeaderContentAlignment="Left"
                                    HeaderToolTip="Название товара"
                                    Binding="{Binding Path=RowData.Row.ProductName, Mode=OneWay}" />
                    <dxg:GridColumn Header="Название поставщика"
                                    HorizontalHeaderContentAlignment="Left"
                                    HeaderToolTip="Название товара поставщика"
                                    Binding="{Binding Path=RowData.Row.SupplierProductName, Mode=OneWay}" />
                    <dxg:GridColumn Header="Шт."
                                    Width="45"
                                    MinWidth="45"
                                    FixedWidth="True"
                                    HorizontalHeaderContentAlignment="Center"
                                    Binding="{Binding Path=RowData.Row.Quantity, Mode=OneWay}"
                                    HeaderToolTip="Штук">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Цена"
                                    Width="70"
                                    MinWidth="70"
                                    FixedWidth="True"
                                    HorizontalHeaderContentAlignment="Center"
                                    Binding="{Binding Path=RowData.Row.Price, Mode=OneWay}"
                                    HeaderToolTip="Цена">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="С"
                                    HeaderToolTip="Статус"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="20"
                                    MinWidth="20"
                                    FixedWidth="True"
                                    Binding="{Binding Path=RowData.Row.Product, Mode=OneWay}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Order/Bulk_add/tick.png"
                                                Height="16"
                                                Width="16"
                                                Margin="2 0 0 0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                ToolTip="Товар успешно обработан"
                                                Visibility="{Binding Path=RowData.Row.IsValid, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                    <dx:DXImage Source="/Images/Order/Bulk_add/error.png"
                                                Height="16"
                                                Width="16"
                                                Margin="2 0 0 0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                ToolTip="Товар не распознан"
                                                Visibility="{Binding Path=RowData.Row.IsValid, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView CheckBoxSelectorColumnWidth="24"
                                   ShowCheckBoxSelectorColumn="True"
                                   EditorShowMode="MouseDownFocused"
                                   AllowGrouping="False"
                                   AllowFilterEditor="False"
                                   AllowSorting="False"
                                   AllowBestFit="True"
                                   AllowResizing="False"
                                   IsColumnChooserVisible="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Center">
            <dxlc:LayoutGroup HorizontalAlignment="Left">
                <Button
                    Content="Добавить колонку"
                    Margin="0 0 8 0"
                    Command="{Binding Path=AddColumnItemCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup HorizontalAlignment="Right">
                <StackPanel
                    IsEnabled="{Binding Path=HandleTextCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                    Orientation="Horizontal">
                    <Button x:Name="HandleRaw"
                            Content="Обработать"
                            Width="90"
                            Margin="0 0 8 0"
                            Command="{Binding Path=HandleTextCommand, Mode=OneWay}" />
                    <Button x:Name="OkBtn"
                            Content="Добавить"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Margin="0 0 8 0"
                            Command="{Binding Path=OkCommand, Mode=OneWay}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </StackPanel>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</controls:TelemartUserControl>