<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.FillSourcesWarehousesListView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              DataContext="{client:Container Type=viewModels:FillSourcesWarehousesListViewModel}"
                              Width="400"
                              Height="300"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:FillSourcesWarehousesListViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemSpace="0"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                <dxb:BarButtonItem Content="Переместить вверх"
                                   Glyph="/Images/Parser/arrow_up_16_16.png"
                                   Command="{Binding Path=MoveUpCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarButtonItem Content="Переместить вниз"
                                   Glyph="/Images/Common/arrow_down_16x16.png"
                                   Command="{Binding Path=MoveDownCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
            </dxb:ToolBarControl>
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                             SelectionMode="None">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header=" "
                                    FieldName="IsChecked"
                                    FixedWidth="True"
                                    Width="24" />
                    <dxg:GridColumn Header="Склад"
                                    FieldName="Item.Name"
                                    ReadOnly="True" />
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                                   AllowEditing="True"
                                   AllowSorting="False"
                                   EnableImmediatePosting="True" />
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              Margin="0,10,0,0">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Установка источников..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxe:CheckEdit Content="Проставлять закупку"
                               EditValue="{Binding Path=UseInvoices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Visibility="{Binding Path=IsVisible, ElementName=WaitImage, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"/>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
