<UserControl x:Class="Telemart.Client.Views.Store.Order.ScheduleDeliveryView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              DataContext="{client:Container Type=viewModels:ScheduleDeliveryViewModel}"
                              Height="245"
                              Width="645"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ScheduleDeliveryViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Vertical"
                                  Header="Текущее значение"
                                  IsEnabled="False"
                                  View="GroupBox"
                                  Width="300"
                                  HorizontalAlignment="Left"
                                  GroupBoxStyle="{StaticResource GroupBoxWithHeaderStyle}">
                    <dxlc:LayoutItem Label="Дата">
                        <dxe:TextEdit
                            EditValue="{Binding Path=ScheduleDelivery.DeliveryDateOld, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Диапазон доставки">
                        <dxe:TextEdit
                            EditValue="{Binding Path=CourierDeliveryOld, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="Время доставки ОТ">
                        <dxe:TextEdit EditValue="{Binding Path=DeliveryTimeOld, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      Style="{StaticResource TimeSpanTextEdit}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Время доставки ДО">
                        <dxe:TextEdit EditValue="{Binding Path=DeliveryTimeToOld, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      Style="{StaticResource TimeSpanTextEdit}" />
                    </dxlc:LayoutItem>

                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  View="GroupBox"
                                  Header="Новое значение"
                                  Width="300"
                                  HorizontalAlignment="Right"
                                  GroupBoxStyle="{StaticResource GroupBoxWithHeaderStyle}">
                    <dxlc:LayoutItem Label="Дата">
                        <dxe:TextEdit
                            IsEnabled="False"
                            EditValue="{Binding Path=ScheduleDelivery.DeliveryDateOld, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Диапазон доставки">
                        <dxe:ComboBoxEdit
                            EditValue="{Binding ScheduleDelivery.SelectedCourierDelivery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            ItemsSource="{Binding Path=CourierDeliveries, Mode=OneWay}"
                            DisplayMember="DisplayText"
                            NullValueButtonPlacement="EditBox"
                            Style="{StaticResource LookupComboBoxStyle}"
                            IsReadOnly="False" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Время доставки ОТ">
                        <dxe:TextEdit EditValue="{Binding Path=ScheduleDelivery.DeliveryTime, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      Style="{StaticResource TimeSpanTextEdit}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Время доставки ДО">
                        <dxe:TextEdit EditValue="{Binding Path=ScheduleDelivery.DeliveryTimeTo, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      Style="{StaticResource TimeSpanTextEdit}" />
                    </dxlc:LayoutItem>

                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutItem Label="Курьер">
                <dxe:ComboBoxEdit
                    EditValue="{Binding ScheduleDelivery.SelectedCourierEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    ItemsSource="{Binding Path=CourierEmployees, Mode=OneWay}"
                    DisplayMember="DisplayValue"
                    ValueMember="Id"
                    NullValueButtonPlacement="EditBox"
                    Style="{StaticResource LookupComboBoxStyle}"
                    IsReadOnly="False" />
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           HorizontalAlignment="Left"
                           Style="{StaticResource ImageStyle}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                            IsTabStop="True">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>