<controls:TelemartUserControl x:Class="Telemart.Client.Views.Bitrix.CategorizeBitrixTasksView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Bitrix"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:CategorizeBitrixTasksViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:CategorizeBitrixTasksViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="800"
                              d:DesignHeight="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Priority.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GroupBoxStyle"
                   BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}"
                   TargetType="dxlc:GroupBox">
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="Padding"
                        Value="8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup>
                    <dxg:GridControl x:Name="DeliveriesGridControl"
                                     ItemsSource="{Binding Path=Tasks, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedTask, Mode=TwoWay}"
                                     SelectionMode="None">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Название"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Name"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowSorting="False"
                                            AllowColumnFiltering="False" />
                            <dxg:GridColumn Header="Приоритет"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="OurPriority"
                                            MinWidth="24"
                                            Width="85"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowAutoFilter="False"
                                            AllowSorting="True"
                                            FixedWidth="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            DisplayTemplate="{StaticResource PriorityColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дедлайн"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Deadline"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="60"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="Date">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Роль"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="RoleId"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList"
                                            Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Roles}"
                                                              DisplayMember="Name"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="C"
                                            HeaderToolTip="Статус"
                                            Width="24"
                                            FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Margin="0 2 0 0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <dx:DXImage Source="../../Images/Common/tick.png"
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Path=RowData.Row.IsSuccess, Converter={dx:BooleanToVisibilityConverter}}" />
                                            <dx:DXImage Source="../../Images/warning.png"
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ToolTipService.ToolTip="{Binding Path=RowData.Row.Error}"
                                                        Visibility="{Binding Path=RowData.Row.Error, Converter={converters:StringToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Параметры"
                                  GroupBoxStyle="{StaticResource GroupBoxStyle}"
                                  Orientation="Vertical"
                                  Width="300"
                                  IsEnabled="{Binding SelectedTask, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                    <dxlc:LayoutItem Label="Приоритет">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Priorities}"
                                          EditValue="{Binding SelectedTask.OurPriority, UpdateSourceTrigger=PropertyChanged}"
                                          ApplyItemTemplateToSelectedItem="True"
                                          IsTextEditable="False"
                                          ItemTemplate="{StaticResource PriorityComboBoxItemTemplate}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Категории"
                                     LabelVerticalAlignment="Top"
                                     VerticalAlignment="Stretch">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                         SelectionMode="Row"
                                         ItemsSourceChanged="GridControlOnItemsSourceChanged">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Name" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TreeListView x:Name="TreeListView"
                                                  TreeDerivationMode="Selfreference"
                                                  ShowColumnHeaders="False"
                                                  ShowCheckboxes="True"
                                                  CheckBoxFieldName="Checked"
                                                  AllowRecursiveNodeChecking="True"
                                                  KeyFieldName="Id"
                                                  ParentFieldName="ParentId"
                                                  NavigationStyle="Row"
                                                  FilterMode="Extended"
                                                  ShowSearchPanelMode="Never"
                                                  SearchPanelHighlightResults="True"
                                                  ExpandNodesOnFiltering="True"
                                                  AllowEditing="False"
                                                  AllowBestFit="True"
                                                  AllowSorting="False"
                                                  AllowDrop="False"
                                                  ShowVerticalLines="False"
                                                  ShowHorizontalLines="False"
                                                  FetchSublevelChildrenOnExpand="False"
                                                  ShowIndicator="False"
                                                  TreeLineStyle="Solid"
                                                  AutoWidth="True"
                                                  ShowFilterPanelMode="Never"
                                                  AutoExpandAllNodes="True"
                                                  ShowExpandButtons="True"
                                                  UseEvenRowBackground="False">
                                </dxg:TreeListView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Создание..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
