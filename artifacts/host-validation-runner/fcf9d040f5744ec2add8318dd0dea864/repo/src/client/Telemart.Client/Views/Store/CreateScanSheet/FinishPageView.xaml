<UserControl x:Class="Telemart.Client.Views.Store.CreateScanSheet.FinishPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Validation"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:createScanSheet="clr-namespace:Telemart.Client.ViewModels.Store.CreateScanSheet"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             mc:Ignorable="d"
             DataContext="{client:Container Type=createScanSheet:FinishPageViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type createScanSheet:FinishPageViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Закрыть"
                                   dxco:Wizard.IsButtonFinish="True">
                </dxco:WizardButton>
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <Grid>
            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="8"
                        Orientation="Horizontal"
                        Visibility="{Binding Path=IsVisible, Converter={dxmvvm:BooleanNegationConverter}, ElementName=GridControl}">
                <dx:DXImage Source="../../../Images/Common/tick.png"
                            Margin="0,0,4,0"
                            Style="{StaticResource ImageStyle}" />
                <TextBlock Text="Заказы успешно проведены в 1С" />
            </StackPanel>
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Model.ValidationItems, Mode=OneWay}"
                             Visibility="{Binding Model.ValidationItems, Converter={converters:ObjectToVisibilityConverter}, Mode=OneWay}"
                             Margin="8"
                             DesignTimeDataObjectType="{x:Type viewModels:ValidationResultItem}"
                             DesignTimeDataSourceRowCount="4">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.View>
                    <dxg:TableView AllowSorting="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}" />
                </dxg:GridControl.View>
                <dxg:GridColumn Header=" "
                                FieldName="IsError"
                                FixedWidth="True"
                                AllowResizing="False"
                                Width="24">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <dx:DXImage Source="{StaticResource WarningImage}"
                                            Visibility="{Binding RowData.Row.IsError, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False, Inverse=True}}" />
                                <dx:DXImage Source="{StaticResource ErrorImage}"
                                            Visibility="{Binding RowData.Row.IsError, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Сообщение"
                                FieldName="Message">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings TextWrapping="Wrap" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl>
        </Grid>
    </DockPanel>

</UserControl>
