<controls:TelemartUserControl x:Class="Telemart.Client.Views.Warehouse.WarehouseDeliveryEditView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:WarehouseDeliveryEditViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:WarehouseDeliveryEditViewModel}, IsDesignTimeCreatable=True}"
                              Width="400"
                              Height="Auto" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Подразделение">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.SubdivisionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  NullValueButtonPlacement="EditBox"
                                  ValueMember="Id"
                                  DisplayMember="Name" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Доставка">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.CarryIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  IsTextEditable="False"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Дни">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=DaysOfWeek, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.DaysOfWeek, Mode=TwoWay, Converter={converters:StringToDaysOfWeekConverter}, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  IsTextEditable="False"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Дней">
                <dxe:SpinEdit EditValueType="{x:Type system:Int32}"
                              EditValue="{Binding Path=Model.Days, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AllowNullInput="True"
                              IsFloatValue="False"
                              MinValue="0"
                              MaxValue="5"
                              InvalidValueBehavior="AllowLeaveEditor" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Получение">
                <dxe:TextEdit EditValue="{Binding Path=Model.TimeGet, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              Style="{StaticResource TimeSpanTextEdit}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Заявка">
                <dxe:CheckEdit EditValue="{Binding Path=Model.PlanCourierCall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                               Command="{Binding Path=LoadIntervalsCommand, Mode=OneTime}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Вес"
                             Visibility="{Binding Path=Model.PlanCourierCall, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dxe:SpinEdit EditValue="{Binding Path=Model.PlannedWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              EditValueType="{x:Type system:Int32}"
                              AllowNullInput="True"
                              IsFloatValue="False"
                              MinValue="0"
                              Mask="#####">
                </dxe:SpinEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Сущности"
                             Visibility="{Binding Path=Model.PlanCourierCall, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=EntityTypes, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.EntityTypeIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayName"
                                  IsTextEditable="False"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Интервал"
                             Visibility="{Binding Path=Model.PlanCourierCall, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=NPCourierCallIntervals, Mode=OneWay}"
                                  EditValue="{Binding Path=SelectedNPCourierCallInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMember="DisplayValue"
                                  IsTextEditable="False"
                                  AllowNullInput="True"
                                  NullValue="{x:Null}"
                                  Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                  IsReadOnly="{Binding Path=IsNovaposhta, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="SelectedIndexChanged"
                               Command="{Binding Path=NPCourierCallIntervalChangedCommand, Mode=OneTime}" />
                        <dxmvvm:EventToCommand EventName="PopupOpening"
                               Command="{Binding Path=LoadIntervalsCommand, Mode=OneTime}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Доставка с">
                <dxe:TextEdit EditValue="{Binding Path=Model.TimeDeliveryFrom, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              Style="{StaticResource TimeSpanTextEdit}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Доставка до">
                <dxe:TextEdit EditValue="{Binding Path=Model.TimeDeliveryTo, Converter={converters:TimeSpanToDateTimeConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              Style="{StaticResource TimeSpanTextEdit}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>

