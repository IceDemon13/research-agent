<UserControl x:Class="Telemart.Client.Views.Directories.ProductsCatalog.GetProductCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Telemart.Client.Views.Directories.ProductsCatalog"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:productsCatalog="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsCatalog"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             DataContext="{client:Container Type=productsCatalog:GetProductCategoryViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type productsCatalog:GetProductCategoryViewModel}}"
             d:DesignWidth="360"
             d:DesignHeight="600"
             Width="360"
             Height="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl Orientation="Vertical"
                        x:Name="LayoutControl">
        <dxg:GridControl ItemsSource="{Binding Path=Categories}"
                         SelectedItem="{Binding Path=SelectedCategory, Mode=TwoWay}"
                         SelectionMode="None">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Name"
                                Header="Категория"
                                HeaderToolTip="Категория"
                                FixedWidth="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <Label Content="{Binding Path=RowData.Row.Name, Mode=OneWay}"
                                   HorizontalAlignment="Stretch"
                                   Background="Transparent">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="MouseDoubleClick"
                                                           Command="{Binding Path=DataContext.OkCommand, ElementName=LayoutControl}">
                                    </dxmvvm:EventToCommand>
                                </dxmvvm:Interaction.Behaviors>
                            </Label>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TreeListView ParentFieldName="ParentId"
                                  NavigationStyle="Row"
                                  KeyFieldName="Id"
                                  AllowEditing="False"
                                  AllowColumnMoving="False"
                                  AllowColumnFiltering="False"
                                  AllowMoveColumnToDropArea="False"
                                  AllowBestFit="True"
                                  AllowResizing="False"
                                  ShowIndicator="False"
                                  AllowSorting="False"
                                  AutoWidth="True"
                                  AutoExpandAllNodes="True"
                                  IsColumnMenuEnabled="False">
                </dxg:TreeListView>
            </dxg:GridControl.View>
        </dxg:GridControl>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
            <Button Content="OK"
                    Command="{Binding Path=OkCommand, Mode=OneWay}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:FocusBehavior/>
                </dxmvvm:Interaction.Behaviors>
            </Button>
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
