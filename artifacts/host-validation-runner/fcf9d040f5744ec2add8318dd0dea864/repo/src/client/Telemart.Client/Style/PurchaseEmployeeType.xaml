<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:store="clr-namespace:Telemart.Client.ViewModels.Store">

    <BitmapImage x:Key="SystemUserImage"
                 UriSource="/Images/Common/android_16x16.png" />
    <BitmapImage x:Key="CurrentUserImage"
                 UriSource="/Images/Common/user_green.png" />
    <BitmapImage x:Key="AnotherUserImage"
                 UriSource="/Images/Common/user_red_16x16.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="EmployeeSupToImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource SystemUserImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource CurrentUserImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource AnotherUserImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <ControlTemplate x:Key="EmployeeSupColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type store:PurchaseEmployeeType}">
                    <StackPanel Orientation="Horizontal"
                                Background="Transparent">
                        <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource EmployeeSupToImageConverter}}"
                                    ToolTip="{Binding Path=Name, Mode=OneWay}"
                                    Height="16"
                                    Width="16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="5,0,0,0" />
                        <Label Content="{Binding Path=Name, Mode=OneWay}"
                               Background="Transparent"
                               Margin="5,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </ControlTemplate>

</ResourceDictionary>