<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:signalR="clr-namespace:Microsoft.AspNetCore.SignalR.Client;assembly=Microsoft.AspNetCore.SignalR.Client.Core">
    <BitmapImage x:Key="GreenImage"
                 UriSource="/Images/Common/bullet_green_16x16.png" />
    <BitmapImage x:Key="YellowImage"
                 UriSource="/Images/Common/bullet_yellow_16x16.png" />
    <BitmapImage x:Key="RedImage"
                 UriSource="/Images/Common/bullet_red_16x16.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="ConnectionTemplateConverter">
        <dxmvvm:MapItem Source="{x:Static signalR:HubConnectionState.Connected}"
                        Target="{StaticResource GreenImage}" />
        <dxmvvm:MapItem Source="{x:Static signalR:HubConnectionState.Reconnecting}"
                        Target="{StaticResource YellowImage}" />
        <dxmvvm:MapItem Source="{x:Static signalR:HubConnectionState.Connecting}"
                        Target="{StaticResource YellowImage}" />
        <dxmvvm:MapItem Source="{x:Static signalR:HubConnectionState.Disconnected}"
                        Target="{StaticResource RedImage}" />

    </dxmvvm:ObjectToObjectConverter>

</ResourceDictionary>