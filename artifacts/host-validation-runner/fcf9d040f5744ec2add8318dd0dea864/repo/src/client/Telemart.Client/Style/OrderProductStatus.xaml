<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="NewImage"
                 UriSource="/Images/Order/OrderProductState/0.png" />
    <BitmapImage x:Key="ClarifyImage"
                 UriSource="/Images/Order/OrderProductState/1.png" />
    <BitmapImage x:Key="AgreedImage"
                 UriSource="/Images/Order/OrderProductState/2.png" />
    <BitmapImage x:Key="DoneImage"
                 UriSource="/Images/Order/OrderProductState/6.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="OrderProductStatusImageConverter">
        <dxmvvm:MapItem Source="0"
                        Target="{StaticResource NewImage}" />
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource ClarifyImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource AgreedImage}" />
        <dxmvvm:MapItem Source="6"
                        Target="{StaticResource DoneImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="OrderProductStatusComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:OrderProductStatus}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource OrderProductStatusImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="OrderProductStatusColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource OrderProductStatusComboBoxItemTemplate}"/>
    </ControlTemplate>
</ResourceDictionary>