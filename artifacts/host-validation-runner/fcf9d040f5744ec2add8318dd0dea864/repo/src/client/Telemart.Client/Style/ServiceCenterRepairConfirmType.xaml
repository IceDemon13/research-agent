<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
    <BitmapImage x:Key="Required"
                 UriSource="/Images/Common/bullet_yellow_16x16.png" />
    <BitmapImage x:Key="NotRequired"
                 UriSource="/Images/Common/bullet_green_16x16.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="ServiceCenterRepairConfirmTypeImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource NotRequired}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource Required}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="ServiceCenterRepairConfirmTypeComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:ServiceCenterRepairConfirmType}">
        <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource ServiceCenterRepairConfirmTypeImageConverter}}"
                    ToolTip="{Binding Path=Name, Mode=OneWay}"
                    Height="16"
                    Width="16" />
    </DataTemplate>

    <ControlTemplate x:Key="ServiceCenterRepairConfirmTypeColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource ServiceCenterRepairConfirmTypeComboBoxItemTemplate}" />
    </ControlTemplate>
</ResourceDictionary>