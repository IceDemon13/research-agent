<UserControl x:Class="Telemart.Client.Views.AssemblyService.AssemblyServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AssemblyService"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:AssemblyServicesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AssemblyServicesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/AssemblyServiceState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InformationImageStyle"
                   TargetType="dx:DXImage">
                <Setter Property="ToolTip">
                    <Setter.Value>
                        <ToolTip>
                            <dxlc:LayoutControl Orientation="Vertical">
                                <dxlc:LayoutItem Label="Сборку редактирует:"
                                                 Visibility="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               MaxWidth="200"/>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem
                                    Visibility="{Binding Path=RowData.Row.OrderComment, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Path=RowData.Row.OrderComment, Mode=OneWay}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               MaxWidth="200" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutControl>
                        </ToolTip>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup>
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarSubItem Content="Изменить"
                                    LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                    Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top">
                        <dxb:BarButtonItem Content="Сборку"
                                           ToolTip="Изменить сборку (F2)"
                                           Glyph="../../Images/Common/computer_16x16.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=EditCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Дату сборки"
                                           Glyph="../../Images/Common/calendar_edit.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=EditAssemblyDateCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Ответственного"
                                           Glyph="../../Images/Common/user_suit_16x16.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=EditEmployeeCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Количество мест"
                                           Glyph="../../Images/Common/package.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=EditAssemblyPlacesCommand, Mode=OneTime}"
                                           IsVisible="{Binding AllowEditAssemblyPlaces}" />
                    </dxb:BarSubItem>
                    <dxb:BarButtonItem Content="Удалить"
                                   ToolTip="Удалить"
                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                   Command="{Binding Path=DeleteCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator/>
                    <dxb:BarButtonItem Content="Рассогл."
                                       LargeGlyph="../../Images/Common/lightbulb_back_32x32.png"
                                       Command="{Binding Path=DisagreeCommand, Mode=OneTime}" />
                    <dxb:BarSubItem Content="Дефект"
                                    LargeGlyph="../../Images/Common/defect_32x32.png"
                                    IsEnabled="{Binding Path=IsDefectEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top">
                        <dxb:BarButtonItem Content="Создать СЗ"
                                           ToolTip="Создать сервисную заявку"
                                           Glyph="../../Images/Common/toolbox.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=DefectCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Создать звонок"
                                           Glyph="../../Images/Common/phone_sound_16x16.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=CreateDefectCallCommand, Mode=OneTime}" />
                    </dxb:BarSubItem>

                    <dxb:BarItemSeparator />
                    <dxb:BarSubItem Content="Печать"
                                    Glyph="{dx:DXImage Image=Print_16x16.png}"
                                    LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top">
                        <dxb:BarButtonItem Content="Реестр"
                                           ToolTip="Напечатать реестр"
                                           Glyph="../../Images/Common/computer_16x16.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           IsVisible="{Binding AllowPrintAssemblyReport}"
                                           Command="{Binding Path=PrintAssemblyCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="ШК сборки"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../Images/Common/barcode_16x16.png"
                                           Command="{Binding Path=PrintBarcodeMovementCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Печать нашего ШК"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../Images/Common/barcode_16x16.png"
                                           Command="{Binding Path=PrintOurBarcodeCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Паспорт сборки"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../Images/Common/information.png"
                                           Command="{Binding Path=PrintAssemblyPassportCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="ШК B2B"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../Images/Common/barcode_16x16.png"
                                           CommandParameter="True"
                                           Command="{Binding Path=PrintB2BBarcodeCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="SN B2B"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../Images/Common/barcode_16x16.png"
                                           CommandParameter="True"
                                           Command="{Binding Path=PrintB2BSerialCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Лист на сборку"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="{dx:DXImage Image=Print_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                           Command="{Binding Path=PrintAssemblySheetCommand, Mode=OneTime}" />
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Margin="0"
                                  Orientation="Horizontal">
                    <dxdo:LayoutGroup>
                        <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                          AllowSizing="True">
                            <dxg:GridControl x:Name="GridControl"
                                             ItemsSource="{Binding Path=Assemblies, Mode=OneWay}"
                                             CurrentItem="{Binding Path=SelectedAssembly, Mode=TwoWay}"
                                             ShowBorder="False"
                                             SelectionMode="None"
                                             AutoExpandAllGroups="True"
                                             ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:LayoutSerializationBehavior FileName="assembly_services_2.xml" />
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Заказ"
                                                    HeaderToolTip="Номер заказа"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="OrderId"
                                                    FixedWidth="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowBestFit="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    MinWidth="60"
                                                    Width="60"
                                                    MaxWidth="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Статус заказа"
                                                    HeaderToolTip="Статус заказа"
                                                    FieldName="OrderStateId"
                                                    FixedWidth="False"
                                                    Width="90"
                                                    MinWidth="30"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowMoving="True"
                                                    AllowAutoFilter="False"
                                                    AllowSorting="True"
                                                    AllowColumnFiltering="True"
                                                    ColumnFilterMode="DisplayText"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=OrderStates}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left"
                                                                      ApplyItemTemplateToSelectedItem="True"
                                                                      IsTextEditable="False"
                                                                      ItemTemplate="{StaticResource OrderStatusComboBoxItemTemplate}"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Склад заказа"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Left"
                                                FieldName="OrderWarehouseId"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                MinWidth="40"
                                                Width="60"
                                                MaxWidth="150"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Warehouses}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Сборка"
                                                    HeaderToolTip="Номер сборки"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Id"
                                                    FixedWidth="True"
                                                    Width="60"
                                                    MinWidth="60"
                                                    MaxWidth="100"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Конфигурация"
                                                    HeaderToolTip="Название конфигурации"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    FieldName="ProductName"
                                                    FixedWidth="True"
                                                    AllowEditing="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowBestFit="False"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList"
                                                    AllowAutoFilter="False"
                                                    MinWidth="50"
                                                    Width="120"
                                                    MaxWidth="200">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                                                  VerticalContentAlignment="Center"
                                                                  NullText="Пользовательская"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Вид работ"
                                                    HeaderToolTip="Вид работ: сборка/разборка"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    FieldName="KindOfJob"
                                                    FixedWidth="True"
                                                    AllowEditing="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowBestFit="False"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList"
                                                    AllowAutoFilter="False"
                                                    MinWidth="50"
                                                    Width="80"
                                                    MaxWidth="120">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                                                  VerticalContentAlignment="Center"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Склад"
                                                    HeaderToolTip="Номер склада"
                                                    FieldName="WarehouseId"
                                                    FixedWidth="False"
                                                    Width="60"
                                                    MinWidth="40"
                                                    MaxWidth="150"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Warehouses}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Статус сборки"
                                                    HeaderToolTip="Статус сборки"
                                                    FieldName="StateId"
                                                    FixedWidth="False"
                                                    MaxWidth="120"
                                                    Width="100"
                                                    MinWidth="30"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=States}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      IsTextEditable="False"
                                                                      ItemTemplate="{StaticResource AssemblyServiceComboBoxItemTemplate}"
                                                                      ApplyItemTemplateToSelectedItem="True"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Ответственный"
                                                    HeaderToolTip="Ответственный сборщик"
                                                    FieldName="EmployeeId"
                                                    FixedWidth="False"
                                                    MaxWidth="150"
                                                    Width="100"
                                                    MinWidth="70"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Подразд."
                                                    HeaderToolTip="Подразделение"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    FieldName="Subdivision"
                                                    FixedWidth="True"
                                                    Width="85"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    FilterPopupMode="CheckedList"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    AllowColumnFiltering="True"
                                                    AllowSorting="True"
                                                    DisplayTemplate="{StaticResource SubdivisionColumnDisplayTemplate}" />
                                    <dxg:GridColumn Header="Дата прибытия"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    HeaderToolTip="Дата прибытия"
                                                    FieldName="ArrivedOn"
                                                    FixedWidth="True"
                                                    Width="100"
                                                    MinWidth="70"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Дата сборки (план)"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    HeaderToolTip="Дата сборки (план)"
                                                    FieldName="AssemblyDate"
                                                    FixedWidth="True"
                                                    Width="90"
                                                    MinWidth="70"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  DisplayFormat="{x:Static business:DateFormattingRules.DateFormat}"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Дата сборки (факт)"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    HeaderToolTip="Дата сборки (факт)"
                                                    FieldName="CompletedOn"
                                                    FixedWidth="True"
                                                    Width="90"
                                                    MinWidth="70"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Дата X"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    HeaderToolTip="Дата X"
                                                    FieldName="OrderDeliveryTimeTo"
                                                    FixedWidth="True"
                                                    Width="90"
                                                    MinWidth="90"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowMoving="True"
                                                    ColumnFilterMode="DisplayText"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    FilterPopupMode="CheckedList" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="И"
                                                    HeaderToolTip="Информация"
                                                    FieldName="EmployeeLockName"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowColumnFiltering="False"
                                                    AllowAutoFilter="False"
                                                    AllowSorting="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxlc:LayoutGroup Orientation="Horizontal"
                                                                  Height="22">
                                                    <dx:DXImage x:Name="LockedImage"
                                                                Source="../../Images/Common/lock.png"
                                                                Height="16"
                                                                Width="16"
                                                                VerticalAlignment="Center"
                                                                Margin="4 0 0 0"
                                                                Style="{StaticResource InformationImageStyle}"
                                                                Visibility="{Binding Path=RowData.Row.EmployeeLockName, Converter={converters:StringToVisibilityConverter}}">
                                                    </dx:DXImage>
                                                    <dx:DXImage Source="../../Images/Common/comment.png"
                                                                    Height="16"
                                                                    Width="16"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource InformationImageStyle}"
                                                                    Margin="4 0 0 0">
                                                        <dx:DXImage.Visibility>
                                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                                <Binding Path="IsVisible"
                                                                             ElementName="LockedImage"
                                                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                                                <Binding Path="RowData.Row.OrderComment"
                                                                             Converter="{dxmvvm:StringToBooleanConverter}" />
                                                            </MultiBinding>
                                                        </dx:DXImage.Visibility>
                                                    </dx:DXImage>
                                                    <TextBlock Text="{Binding Path=RowData.Row.OrderComment, Mode=OneWay, Converter={converters:MultiLineToSingleLineTextConverter}}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Visibility="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget, Converter={converters:TrimmedTextBlockVisibilityConverter}}">
                                                                <ToolTip.Content>
                                                                    <TextBlock Text="{Binding Path=RowData.Row.OrderComment}"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxHeight="200"/>
                                                                </ToolTip.Content>
                                                            </ToolTip>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </dxlc:LayoutGroup>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="True"
                                                   AllowEditing="False"
                                                   NavigationStyle="Cell"
                                                   ShowIndicator="False"
                                                   ShowAutoFilterRow="False"
                                                   ShowFixedTotalSummary="False"
                                                   IsTotalSummaryMenuEnabled="False"
                                                   ShowTotalSummary="False"
                                                   IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}"
                                                   CustomCellAppearance="TableView_OnCustomCellAppearance"
                                                   CustomRowAppearance="TableView_OnCustomRowAppearance">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                                   Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                                        </dxmvvm:Interaction.Behaviors>
                                        <dxg:TableView.FormatConditions>
                                            <dxg:FormatCondition Expression="[NotCompletedStateAndHasQuickAssemblyAdditionalService]"
                                                                 ApplyToRow="True">
                                                <dx:Format Background="{StaticResource PinkColor}"
                                                           Foreground="Black"/>
                                            </dxg:FormatCondition>
                                        </dxg:TableView.FormatConditions>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                                <dxg:GridControl.GroupSummary>
                                    <dxg:GridSummaryItem SummaryType="Count"
                                                         Alignment="Right"
                                                         Visible="True" />
                                </dxg:GridControl.GroupSummary>
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                    <dxdo:LayoutGroup  MinWidth="360"
                                       MaxWidth="500"
                                       ItemWidth="360"
                                       Orientation="Vertical">
                        <dxdo:LayoutPanel Caption="Поиск"
                                          AllowClose="False"
                                          AllowDrag="False"
                                          AllowDock="True"
                                          AutoHidden="False"
                                          AllowHide="True"
                                          FloatOnDoubleClick="False"
                                          MinWidth="360"
                                          MaxWidth="500"
                                          ItemWidth="360"
                                          IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                          behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                            <dxlc:LayoutControl Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Дата X">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/calendar.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      VerticalAlignment="Center">
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.OrderDeliveryTimeToBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch"
                                                      AllowNullInput="True"
                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                      AllowRoundOutOfRangeValue="False"
                                                      Style="{StaticResource BasicDateEdit}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                     Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxe:DateEdit>
                                        <TextBlock Text="-"
                                                   Width="8"
                                                   TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.OrderDeliveryTimeToAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch"
                                                      AllowNullInput="True"
                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                      AllowRoundOutOfRangeValue="False"
                                                      Style="{StaticResource BasicDateEdit}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                     Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxe:DateEdit>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Дата сборки">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/calendar.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      VerticalAlignment="Center">
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.AssemblyDateBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch"
                                                      NullText="Не заполнено">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                     Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxe:DateEdit>
                                        <TextBlock Text="-"
                                                   Width="8"
                                                   TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.AssemblyDateAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch"
                                                      NullText="Не заполнено">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                     Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxe:DateEdit>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Заказ">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/cart.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.OrderIds, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Сборка">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/NavigationMenu/computer.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.Ids, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=States, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      EditValue="{Binding Path=Filter.SelectedStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Товар">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/package.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ButtonEdit EditValue="{Binding Path=Filter.ProductName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    AllowDefaultButton="False">
                                        <dxe:ButtonInfo ButtonKind="Simple"
                                                        GlyphKind="Cancel"
                                                        Command="{Binding Path=Filter.CancelProductCommand, Mode=OneTime}" />
                                        <dxe:ButtonInfo ButtonKind="Simple"
                                                        GlyphKind="Regular"
                                                        Command="{Binding Path=SelectProductCommand, Mode=OneTime}" />
                                    </dxe:ButtonEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Конфигурация">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/package.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ButtonEdit EditValue="{Binding Path=Filter.AssemblyServiceProductName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    AllowDefaultButton="False">
                                        <dxe:ButtonInfo ButtonKind="Simple"
                                                        GlyphKind="Cancel"
                                                        Command="{Binding Path=Filter.CancelAssemblyServiceProductCommand, Mode=OneTime}" />
                                        <dxe:ButtonInfo ButtonKind="Simple"
                                                        GlyphKind="Regular"
                                                        Command="{Binding Path=SelectAssemblyServiceProductCommand, Mode=OneTime}" />
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ButtonEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Сборок">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Assemblies.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem>
                                    <dxb:ToolBarControl GlyphSize="Small">
                                        <dxb:BarButtonItem Content="Применить"
                                                           Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                           GlyphAlignment="Left"
                                                           Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItem Content="Отмена"
                                                           Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                           GlyphAlignment="Left"
                                                           Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}" />
                                    </dxb:ToolBarControl>
                                </dxlc:LayoutItem>
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>