<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.CreateScanSheetForEntities"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:scanSheets="clr-namespace:Telemart.Client.Business.Delivery.ScanSheets"
             x:Class="Telemart.Client.Views.Store.CreateScanSheetForEntities.SearchCriteriaPageView"
             DataContext="{client:Container Type=viewModels:SearchCriteriaPageViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:SearchCriteriaPageViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="250">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <viewComponents:WaitImage VerticalAlignment="Center"
                                          Visibility="{Binding IsLongOperationInProgress, Converter={dxmvvm:BooleanToVisibilityConverter}, Mode=OneWay}" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding Mode=OneWay}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl x:Name="FilterRoot"
                            Orientation="Vertical"
                            Width="430"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding IsLongOperationInProgress, Converter={dxmvvm:BooleanNegationConverter}, Mode=OneWay}">
            <dxlc:LayoutItem Label="Дата создания ТТН">
                <dxlc:LayoutItem.LabelTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="../../../Images/Order/Filter/time.png"
                                        Style="{StaticResource ImageStyle}" />
                            <TextBlock Text="{Binding Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </dxlc:LayoutItem.LabelTemplate>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Center">
                    <dxe:DateEdit EditValue="{Binding Model.DateFrom, Mode=TwoWay, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                  HorizontalAlignment="Stretch"
                                  NullValueButtonPlacement="EditBox"
                                  MinValue="{Binding DateFromMinDate, Mode=OneWay}"
                                  MaxValue="{Binding DateFromMaxDate, Mode=OneWay}">
                        <dxe:DateEdit.StyleSettings>
                            <dxe:DateEditCalendarStyleSettings />
                        </dxe:DateEdit.StyleSettings>
                    </dxe:DateEdit>
                    <TextBlock Text="-"
                               Width="8"
                               TextAlignment="Center" />
                    <dxe:DateEdit EditValue="{Binding Model.DateTo, Mode=TwoWay, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                  HorizontalAlignment="Stretch"
                                  NullValueButtonPlacement="EditBox"
                                  MinValue="{Binding DateToMinDate, Mode=OneWay}"
                                  MaxValue="{Binding DateToMaxDate, Mode=OneWay}">
                        <dxe:DateEdit.StyleSettings>
                            <dxe:DateEditCalendarStyleSettings />
                        </dxe:DateEdit.StyleSettings>
                    </dxe:DateEdit>
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Склад">
                <dxlc:LayoutItem.LabelTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="../../../Images/Order/Filter/house.png"
                                        Style="{StaticResource ImageStyle}" />
                            <TextBlock Text="{Binding Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </dxlc:LayoutItem.LabelTemplate>
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.SelectedWarehouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  IsTextEditable="True"
                                  ImmediatePopup="True"
                                  IncrementalFiltering="True"
                                  ValidateOnTextInput="False">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>

