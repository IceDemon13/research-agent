<controls:TelemartUserControl x:Class="Telemart.Client.Views.Money.Receive.BankPaymentsConfirmView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Money.Receive.BankPayment"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              DataContext="{client:Container Type=viewModels:BankPaymentsConfirmViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:BankPaymentsConfirmViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="750"
                              d:DesignHeight="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Payment.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
        <dxmvvm:DispatcherService />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Payments, Mode=OneWay}"
                                 SelectionMode="None">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                        <behaviors:LayoutSerializationBehavior FileName="bank_payments_confirm_1.xml" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Заказ"
                                        HeaderToolTip="Номер заказа"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="OrderId"
                                        FixedWidth="True"
                                        Width="60">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ParsedOrderId"
                                        Visible="False"
                                        ShowInColumnChooser="False"/>
                        <dxg:GridColumn Header="Назначение"
                                        HeaderToolTip="Назначение платежа"
                                        FieldName="Comment">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings TextWrapping="Wrap"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="ФИО"
                                        HeaderToolTip="ФИО"
                                        FieldName="Order.Fio"/>
                        <dxg:GridColumn Header="Статус"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="Order.State"
                                        FixedWidth="True"
                                        Width="24"
                                        MinWidth="24"
                                        DisplayTemplate="{StaticResource OrderStatusColumnDisplayTemplate}">
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Оплата"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="Order.Payment"
                                        FixedWidth="True"
                                        Width="24"
                                        MinWidth="24">
                            <dxg:GridColumn.DisplayTemplate>
                                <ControlTemplate>
                                    <ContentControl Content="{Binding Path=RowData.Row.Order.Payment, UpdateSourceTrigger=PropertyChanged}"
                                                    ContentTemplate="{Binding Path=RowData.Row.Order.IsPaid, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IsPaidToPaymentTemplateConverter}}"/>
                                </ControlTemplate>
                            </dxg:GridColumn.DisplayTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Комментарий"
                                        HeaderToolTip="Комментарий"
                                        FieldName="Order.Comment">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayTextConverter="{converters:MultiLineToSingleLineTextConverter}"
                                                      TextWrapping="Wrap"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Оплачено"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="PayedSumFormatted"
                                        FixedWidth="True"
                                        Width="90"/>
                        <dxg:GridColumn Header="К оплате"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="SumToPayFormatted"
                                        FixedWidth="True"
                                        Width="90"/>
                        <dxg:GridColumn Header="Сумма"
                                        HeaderToolTip="Сумма"
                                        FieldName="AmountFormatted"
                                        FixedWidth="True"
                                        Width="90"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       AllowSorting="True"
                                       AllowGrouping="False"
                                       AllowBestFit="False"
                                       AllowColumnMoving="True"
                                       AllowMoveColumnToDropArea="False"
                                       Style="{StaticResource ReadOnlyTableViewStyle}"
                                       CustomCellAppearance="TableViewOnCustomCellAppearance">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition Expression="[ParsedOrderId] Is Null Or [ParsedOrderId] &lt;&gt; [OrderId]"
                                                     FieldName="OrderId">
                                    <dx:Format Background="{StaticResource PinkColor}"
                                               Foreground="Black"/>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding HandleRowDoubleClickCommand}"
                                                       PassEventArgsToCommand="True"/>
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneTime}"/>
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneTime}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>

