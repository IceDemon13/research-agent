<UserControl x:Class="Telemart.Client.Views.Store.Order.SetOrderProductPriceView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             DataContext="{client:Container Type=viewModels:SetOrderProductPriceViewModel}"
             Width="900"
             Height="500"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:SetOrderProductPriceViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup Orientation="Horizontal" VerticalAlignment="Top">
                    <dxlc:LayoutItem Label="Тип цены" 
                                     HorizontalAlignment="Left">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=PriceKinds, Mode=OneWay}"
                                          EditValue="{Binding Path=SelectedPriceKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          Width="400"
                                          IsReadOnly="False">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <Label Content="{Binding Path = TotalDeltaStr, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Right"/>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Top">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                     SelectionMode="None">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="ProductName"
                                            Header="Товар"
                                            MaxWidth="600"
                                            Width="300"
                                            MinWidth="100"
                                            HeaderToolTip="Товар">
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Quantity"
                                            Header="Кол-во"
                                            HeaderToolTip="Количество"
                                            AllowBestFit="True"
                                            FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center"
                                            Width="80"
                                            MinWidth="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="ТЦ"
                                            HeaderToolTip="Тип цены"
                                            FieldName="PriceId"
                                            FixedWidth="False"
                                            MaxWidth="150"
                                            Width="80"
                                            MinWidth="40"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=PriceKinds}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PriceOld"
                                            Header="Цена (старая)"
                                            HeaderToolTip="Цена (старая)"
                                            AllowBestFit="True"
                                            FixedWidth="True"
                                            Width="100"
                                            MinWidth="60">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit x:Name="PART_Editor"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{Binding Path=RowData.Row.CurrencyOldId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}}"
                                                      MaskCulture="{Binding Path=RowData.Row.CurrencyOldId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                                      MaskSaveLiteral="False"
                                                      IsFloatValue="True"
                                                      AllowDefaultButton="False"
                                                      HorizontalContentAlignment="Right"
                                                      IsReadOnly="True" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PriceNew"
                                            Header="Цена (новая)"
                                            HeaderToolTip="Цена (новая)"
                                            AllowBestFit="True"
                                            FixedWidth="True"
                                            AllowEditing="True"
                                            Width="100"
                                            MinWidth="60">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit x:Name="PART_Editor"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{Binding Path=RowData.Row.CurrencyOldId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}}"
                                                      MaskCulture="{Binding Path=RowData.Row.CurrencyOldId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                                      MaskSaveLiteral="False"
                                                      IsFloatValue="True"
                                                      AllowDefaultButton="False"
                                                      HorizontalContentAlignment="Right"
                                                      IsReadOnly="True" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Delta"
                                            Header="Скидка"
                                            HeaderToolTip="Скидка"
                                            AllowBestFit="True"
                                            FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center"
                                            Width="80"
                                            MinWidth="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="TableView"
                                           Style="{StaticResource ReadOnlyTableViewStyle}" Height="410">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         Mode="OneWay"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="HasValidationError"
                                         Mode="OneWay"
                                         ElementName="TableView"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
