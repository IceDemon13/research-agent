<controls:TelemartUserControl x:Class="Telemart.Client.Views.TradeIn.TradeInCreateView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.TradeIn"
                              xmlns:helpers="clr-namespace:Telemart.Client.Helpers"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              DataContext="{client:Container Type=viewModels:TradeInCreateViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:TradeInCreateViewModel}, IsDesignTimeCreatable=True}"
                              mc:Ignorable="d"
                              Width="450"
                              Height="790"
                              d:DesignHeight="850"
                              d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent"
                         Margin="0">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Телефон">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:ButtonEdit EditValue="{Binding Path=Phone, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                        AllowDefaultButton="False"
                                        IsTextEditable="True"
                                        Style="{StaticResource PhoneTextEdit}">
                            <dxe:ButtonInfo ToolTip="История клиента по номеру"
                                            GlyphKind="Custom"
                                            Command="{Binding ShowPhoneHistoryClientCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Phone, Mode=OneWay}">
                                <dxe:ButtonInfo.Content>
                                    <dx:DXImage Margin="2 0 1 0"
                                                Source="../../../Images/Common/report_magnify_16x16.png" />
                                </dxe:ButtonInfo.Content>
                            </dxe:ButtonInfo>
                            <dxe:ButtonInfo GlyphKind="Custom"
                                            ToolTip="Найти клиента по номеру"
                                            Command="{Binding CustomerSearchCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Path=Phone, Mode=OneWay}">
                                <dxe:ButtonInfo.Content>
                                    <dx:DXImage Margin="2 0 1 0"
                                                Source="../../../Images/Common/book_addresses.png" />
                                </dxe:ButtonInfo.Content>
                            </dxe:ButtonInfo>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="E-mail">
                    <dxe:TextEdit EditValue="{Binding Path=Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="50"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Фамилия">
                    <dxe:TextEdit EditValue="{Binding Path=LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="50"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Имя">
                    <dxe:TextEdit EditValue="{Binding Path=FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="50"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Отчество">
                    <dxe:TextEdit EditValue="{Binding Path=MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="50"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutItem Label="Покупал в телемарт">
                        <dxe:CheckEdit EditValue="{Binding BoughtInTelemart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Заказ">
                    <dxe:ButtonEdit EditValue="{Binding Path=OrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    IsTextEditable="True"
                                    AllowDefaultButton="False"
                                    IsReadOnly="{Binding BoughtInTelemart, Converter={dxmvvm:BooleanNegationConverter}}"
                                    Style="{StaticResource ReadOnlyConditionsStyle}"
                                    MaskType="Numeric"
                                    Mask="########"
                                    MaskUseAsDisplayFormat="True">
                        <dxe:ButtonInfo ButtonKind="Simple"
                                        GlyphKind="Cancel"
                                        IsEnabled="{Binding Path=OrderId, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}"
                                        Command="{Binding Path=RemoveOrderCommand, Mode=OneTime}" />
                        <dxe:ButtonInfo GlyphKind="Custom"
                                        ToolTip="Найти заказ"
                                        Command="{Binding SearchOrderCommand, Mode=OneWay}" >
                            <dxe:ButtonInfo.Content>
                                <dx:DXImage Margin="2 0 1 0"
                                            Source="../../../Images/Common/book_addresses.png" />
                            </dxe:ButtonInfo.Content>
                        </dxe:ButtonInfo>
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutItem Label="Товар"
                                 Visibility="{Binding OrderFound, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                      EditValue="{Binding Path=ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsTextEditable="False"
                                      ValueMember="Id">
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Background="Transparent"
                                           TextWrapping="NoWrap"
                                           TextTrimming="WordEllipsis"
                                           Margin="3,0,0,0" />
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Товар"
                                 Visibility="{Binding OrderFound, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <dxe:ButtonEdit EditValue="{Binding Path=ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    IsTextEditable="False"
                                    AllowDefaultButton="False"
                                    TextWrapping="NoWrap"
                                    TextTrimming="WordEllipsis">
                        <dxe:ButtonInfo ButtonKind="Simple"
                                       GlyphKind="Cancel"
                                        IsEnabled="{Binding Path=ProductId, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}"
                                        Command="{Binding Path=RemoveProductCommand, Mode=OneTime}" />
                        <dxe:ButtonInfo ButtonKind="Simple"
                                        GlyphKind="Regular"
                                        Command="{Binding Path=SelectProductCommand, Mode=OneTime}" />
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Категория"
                                 Visibility="{Binding OrderFound, Mode=OneWay,UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ButtonEdit EditValue="{Binding Path=SelectedCategory.Name}"
                                    IsTextEditable="False"
                                    AllowDefaultButton="False">
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Категория"
                                 Visibility="{Binding OrderFound, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <dxg:LookUpEdit ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                    EditValue="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    DisplayMember="Name"
                                    AutoPopulateColumns="False"
                                    AutoComplete="False"
                                    IncrementalFiltering="True"
                                    FilterCondition="Like"
                                    FindMode="Always"
                                    ImmediatePopup="True"
                                    IsPopupAutoWidth="True"
                                    InvalidValueBehavior="AllowLeaveEditor"
                                    NullValueButtonPlacement="EditBox"
                                    PopupContentTemplate="{StaticResource LookUpEditCategoryControlTemplate}">
                        <dxg:LookUpEdit.StyleSettings>
                            <dxg:SearchLookUpEditStyleSettings />
                        </dxg:LookUpEdit.StyleSettings>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Бренд">
                    <dxe:AutoSuggestEdit EditValue="{Binding Path=Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ItemsSource="{Binding CurrentCategoryManufactors, Mode=OneWay}"
                                         AllowPopupTextHighlighting="True"
                                         PopupHighlightedTextCriteria="Contains"
                                         ImmediatePopup="True"
                                         MaxLength="255">
                    </dxe:AutoSuggestEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Сегмент">
                    <dxe:TextEdit EditValue="{Binding Path=TradeInSegmentName}"
                                  IsReadOnly="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Серийный номер"
                                 Visibility="{Binding OrderFoundProductChanged, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <dxe:TextEdit EditValue="{Binding Path=SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="50"
                                  TextWrapping="NoWrap"
                                  TextTrimming="WordEllipsis"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Серийный номер"
                                 Visibility="{Binding OrderFoundProductChanged, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=SerialNumbers, Mode=OneWay}"
                                      EditValue="{Binding Path=SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="SerialNumber"
                                      ValueMember="SerialNumber"
                                      IsTextEditable="False"
                                      AllowNullInput="True">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Модель или PN">
                    <dxe:TextEdit EditValue="{Binding Path=ModelOrPn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="255"
                                  TextWrapping="NoWrap"
                                  TextTrimming="WordEllipsis"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Состояние товара">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=TradeInClassValues, Mode=OneWay}"
                                      EditValue="{Binding Path=ClassId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ValueMember="Id"
                                      IsTextEditable="False"
                                      ToolTip="{Binding ToolTipClass, Mode=OneWay}">
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Background="Transparent"
                                           TextWrapping="NoWrap"
                                           TextTrimming="WordEllipsis"
                                           Margin="3,0,0,0" />
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Гарантия">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=TradeInWarrantyValues, Mode=OneWay}"
                                      EditValue="{Binding Path=WarrantyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Упаковка">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=TradeInPackageValues, Mode=OneWay}"
                                      EditValue="{Binding Path=PackId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Склад приёма">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Warehouse, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMember="Name"
                                      HorizontalContentAlignment="Left"
                                      AllowNullInput="True"
                                      NullValueButtonPlacement="EditBox"
                                      AutoComplete="True"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Описание клиента">
                    <dxe:TextEdit EditValue="{Binding Path=CustomerDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="1000"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  AcceptsTab="True"
                                  Height="40"
                                  VerticalContentAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий клиента">
                    <dxe:TextEdit EditValue="{Binding Path=CustomerComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="1000"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  AcceptsTab="True"
                                  Height="40"
                                  VerticalContentAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий сотрудника">
                    <dxe:TextEdit EditValue="{Binding Path=Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="1000"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  AcceptsTab="True"
                                  VerticalContentAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  Height="40"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="ИНН">
                    <controls:InnTextEdit
                        IsReadOnly="False"
                        EditValue="{Binding Path=Inn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Доставка">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=CarryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Город">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                      EditValue="{Binding Path=CityId, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextEditable="True"
                                      ImmediatePopup="True"
                                      IncrementalFiltering="True"
                                      ValidateOnTextInput="False"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      ApplyItemTemplateToSelectedItem="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Адрес">
                    <dxe:ButtonEdit EditValue="{Binding Path=DeliveryData}"
                                    AllowDefaultButton="False">
                        <dxe:ButtonInfo GlyphKind="Edit"
                                        ToolTipService.ToolTip="Выбрать адрес"
                                        Command="{Binding Path=SelectDeliveryAddressCommand, Mode=OneWay}" />
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  BusyText="Создание..."
                                                  Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <viewComponents:WaitImage x:Name="BusyIndicator"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              BusyText="Обработка...">
                        <viewComponents:WaitImage.Visibility>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                <Binding Path="SearchOrderCommand.IsExecuting"/>
                            </MultiBinding>
                        </viewComponents:WaitImage.Visibility>
                    </viewComponents:WaitImage>
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>