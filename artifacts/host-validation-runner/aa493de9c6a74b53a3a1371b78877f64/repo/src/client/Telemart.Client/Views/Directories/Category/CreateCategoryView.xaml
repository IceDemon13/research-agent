<UserControl x:Class="Telemart.Client.Views.Directories.Category.CreateCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Category"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             DataContext="{client:Container Type=viewModels:CreateCategoryViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateCategoryViewModel}}"
             d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutGroup Orientation="Vertical"
                          VerticalAlignment="Top">
            <dxlc:LayoutItem Label="Родитель">
                <dxe:TextEdit EditValue="{Binding Path=CategoryParentFullName, Mode=OneWay}"
                              IsReadOnly="True"
                              Opacity="{StaticResource DisabledElementOpacity}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (рус.)">
                <dxe:TextEdit EditValue="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (укр.)">
                <dxe:TextEdit EditValue="{Binding Path=NameUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (англ.)">
                <dxe:TextEdit EditValue="{Binding Path=NameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Тип">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left">
                    <RadioButton Content="Родитель"
                                 IsChecked="{Binding Path=Type, Mode=TwoWay, TargetNullValue=False, UpdateSourceTrigger=PropertyChanged,  NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True, Converter={converters:EnumToBooleanConverter}, ConverterParameter=Parent}">
                        <RadioButton.Style>
                            <Style BasedOn="{StaticResource {x:Type RadioButton}}"
                                   TargetType="RadioButton">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="IsCurrentUserAdmin" />
                                                <Binding Path="IsCurrentUserMarketer" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Content="Папка"
                                 IsChecked="{Binding Path=Type, Mode=TwoWay, TargetNullValue=False, UpdateSourceTrigger=PropertyChanged,  NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True, Converter={converters:EnumToBooleanConverter}, ConverterParameter=Folder}">
                        <RadioButton.Style>
                            <Style BasedOn="{StaticResource {x:Type RadioButton}}"
                                   TargetType="RadioButton">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsCurrentUserAdmin" />
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Content="Бренд"
                                 Width="60"
                                 IsChecked="{Binding Path=Type, Mode=TwoWay, TargetNullValue=False, UpdateSourceTrigger=PropertyChanged,  NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True, Converter={converters:EnumToBooleanConverter}, ConverterParameter=Brand}">
                        <RadioButton.Style>
                            <Style BasedOn="{StaticResource {x:Type RadioButton}}"
                                   TargetType="RadioButton">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="IsCurrentUserAdmin" />
                                                <Binding Path="IsCurrentUserMarketer" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Ссылка">
                <dxe:TextEdit EditValue="{Binding Path=LinkRewrite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100"
                              EditValueChanging="TextEditEditValueChanging">
                </dxe:TextEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Top">
            <viewComponents:WaitImage HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
            <Button Content="ОК"
                    HorizontalAlignment="Right"
                    Command="{Binding Path=OkCommand, Mode=OneTime}"
                    IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
            <Button Content="Отмена"
                    HorizontalAlignment="Right"
                    Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>