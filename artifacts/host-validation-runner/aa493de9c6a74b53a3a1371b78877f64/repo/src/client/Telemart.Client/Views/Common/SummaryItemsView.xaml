<UserControl x:Class="Telemart.Client.Views.Common.SummaryItemsView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             xmlns:flowDocuments="clr-namespace:Telemart.Client.ThirdParty.FlowDocuments"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="200"
             d:DataContext="{d:DesignInstance Type=commonViews:SummaryItemsView, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <RichTextBox DataContext="{Binding ElementName=CurrentUserControl}"
                 Background="Transparent"
                 BorderThickness="{Binding BorderThickness}"
                 IsReadOnly="True"
                 Padding="0,4,0,4">
        <FlowDocument PagePadding="0"
                      ColumnGap="0">
            <flowDocuments:ItemsContent ItemsSource="{Binding Path=SummaryItems, Mode=OneWay}">
                <flowDocuments:ItemsContent.ItemsPanel>
                    <DataTemplate>
                        <flowDocuments:Fragment>
                            <Table>
                                <Table.Columns>
                                    <TableColumn Width="{Binding Path=LabelColumnWidth, Mode=OneWay}" />
                                    <TableColumn Width="{Binding Path=ContentColumnWidth, Mode=OneWay}" />
                                </Table.Columns>
                                <TableRowGroup flowDocuments:Attached.IsItemsHost="True" />
                            </Table>
                        </flowDocuments:Fragment>
                    </DataTemplate>
                </flowDocuments:ItemsContent.ItemsPanel>
                <flowDocuments:ItemsContent.ItemTemplate>
                    <DataTemplate DataType="{x:Type common:SummaryViewItem}">
                        <flowDocuments:Fragment>
                            <TableRow>
                                <TableCell>
                                    <Paragraph>
                                        <flowDocuments:BindableRun BoundText="{Binding Path=Key, StringFormat={}{0}:}"
                                                                   FontWeight="Bold">
                                            <flowDocuments:BindableRun.Style>
                                                <Style TargetType="{x:Type flowDocuments:BindableRun}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Foreground}" />
                                                    </Style>
                                                </flowDocuments:BindableRun.Style>
                                        </flowDocuments:BindableRun>
                                    </Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph>
                                        <flowDocuments:BindableRun BoundText="{Binding Path=Value}">
                                            <flowDocuments:BindableRun.Style>
                                                <Style TargetType="{x:Type flowDocuments:BindableRun}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Foreground}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <Binding Path="Level"
                                                                         Mode="OneWay"
                                                                         Converter="{converters:IsEqualConverter}"
                                                                         ConverterParameter="{x:Static common:SummaryViewItem.GreenLevel}" />
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Foreground"
                                                                    Value="MediumSeaGreen" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <Binding Path="Level"
                                                                         Mode="OneWay"
                                                                         Converter="{converters:IsEqualConverter}"
                                                                         ConverterParameter="{x:Static common:SummaryViewItem.RedLevel}" />
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Foreground"
                                                                    Value="#FFCC0000" />
                                                            <Setter Property="FontWeight"
                                                                    Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </flowDocuments:BindableRun.Style>
                                        </flowDocuments:BindableRun>
                                    </Paragraph>
                                </TableCell>
                            </TableRow>
                        </flowDocuments:Fragment>
                    </DataTemplate>
                </flowDocuments:ItemsContent.ItemTemplate>
            </flowDocuments:ItemsContent>
        </FlowDocument>
    </RichTextBox>
</UserControl>