<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.OrderConfirmView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:validation="clr-namespace:Telemart.Client.ViewModels.Validation"
                              xmlns:store="clr-namespace:Telemart.Client.ViewModels.Store"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              DataContext="{client:Container Type=viewModels:OrderConfirmViewModel}"
                              Width="1000"
                              Height="680"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderConfirmViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderProductSource.xaml" />
                <ResourceDictionary>
                    <Style x:Key="GroupBoxStyle"
                           TargetType="{x:Type dxlc:GroupBox}">
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               FontWeight="DemiBold"
                                               HorizontalAlignment="Left" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=WaitImage}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Top">
                    <dxlc:LayoutGroup Header="Логистика"
                                      View="GroupBox"
                                      GroupBoxStyle="{StaticResource GroupBoxStyle}"
                                      Padding="8"
                                      Orientation="Vertical">
                        <dxlc:LayoutItem Label=" "
                                         AddColonToLabel="False">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold">Текущее значение</TextBlock>
                                <TextBlock FontWeight="SemiBold">Расчетное значение</TextBlock>
                                <TextBlock FontWeight="SemiBold">Новое значение</TextBlock>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Дата Х от">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:DateEdit EditValue="{Binding Path=Original.DeliveryTime, Mode=OneWay}"
                                              AllowRoundOutOfRangeValue="False"
                                              AllowDefaultButton="False"
                                              Style="{StaticResource ReadOnlyDateEditorStyle}" />
                                <dxe:DateEdit EditValue="{Binding Path=Calculated.DeliveryTime, Mode=OneWay}"
                                              AllowRoundOutOfRangeValue="False"
                                              AllowDefaultButton="False"
                                              Style="{StaticResource ReadOnlyDateEditorStyle}" />
                                <dxe:DateEdit EditValue="{Binding Path=DeliveryTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MinValue="{Binding Path=Calculated.DeliveryTime, Mode=OneWay}"
                                              NullValueButtonPlacement="EditBox"
                                              ShowClearButton="False"
                                              AllowNullInput="True"
                                              NullValue="{x:Null}"
                                              Style="{StaticResource BasicDateEdit}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Дата Х до">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:DateEdit EditValue="{Binding Path=Original.DeliveryTimeTo, Mode=OneWay}"
                                              AllowRoundOutOfRangeValue="False"
                                              AllowDefaultButton="False"
                                              Style="{StaticResource ReadOnlyDateEditorStyle}" />
                                <dxe:DateEdit EditValue="{Binding Path=Calculated.DeliveryTimeTo, Mode=OneWay}"
                                              AllowRoundOutOfRangeValue="False"
                                              AllowDefaultButton="False"
                                              Style="{StaticResource ReadOnlyDateEditorStyle}" />
                                <dxe:DateEdit EditValue="{Binding Path=DeliveryTimeTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MinValue="{Binding Path=Calculated.DeliveryTimeTo, Mode=OneWay}"
                                              NullValueButtonPlacement="EditBox"
                                              ShowClearButton="False"
                                              AllowNullInput="True"
                                              NullValue="{x:Null}"
                                              Style="{StaticResource BasicDateEdit}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Плательщик:"
                                         AddColonToLabel="False">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=DeliveryPaymentModes, Mode=OneWay}"
                                                  EditValue="{Binding Path=Original.PackageDeliveryPaid, Mode=OneWay}"
                                                  DisplayMember="Title"
                                                  ShowEditorButtons="False"
                                                  Style="{StaticResource ReadOnlyEditorStyle}">
                                </dxe:ComboBoxEdit>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=DeliveryPaymentModes, Mode=OneWay}"
                                                  EditValue="{Binding Path=Calculated.PackageDeliveryPaid, Mode=OneWay}"
                                                  DisplayMember="Title"
                                                  ShowEditorButtons="False"
                                                  Style="{StaticResource ReadOnlyEditorStyle}">
                                </dxe:ComboBoxEdit>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=DeliveryPaymentModes, Mode=OneWay}"
                                                  EditValue="{Binding Path=PackageDeliveryPaid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  CausesValidation="True"
                                                  DisplayMember="Title"
                                                  AllowDrop="False"
                                                  ValidateOnTextInput="False"
                                                  ApplyItemTemplateToSelectedItem="True"
                                                  ShowEditorButtons="False"
                                                  Style="{StaticResource ReadOnlyEditorStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                               Command="{Binding Path=HandleDeliveryChangedCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Доставка">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:SpinEdit EditValue="{Binding Path=Original.PackageDeliveryCost, Mode=OneWay}"
                                              HorizontalContentAlignment="Right"
                                              MinValue="0"
                                              MaskType="Numeric"
                                              Mask="{x:Static business:CurrencyFormatingRules.UahFormat}"
                                              MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                              MaskUseAsDisplayFormat="True"
                                              ShowEditorButtons="False"
                                              Style="{StaticResource ReadOnlyEditorStyle}">
                                </dxe:SpinEdit>
                                <dxe:SpinEdit EditValue="{Binding Path=Calculated.PackageDeliveryCost, Mode=OneWay}"
                                              HorizontalContentAlignment="Right"
                                              MinValue="0"
                                              MaskType="Numeric"
                                              Mask="{x:Static business:CurrencyFormatingRules.UahFormat}"
                                              MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                              MaskUseAsDisplayFormat="True"
                                              ShowEditorButtons="False"
                                              Style="{StaticResource ReadOnlyEditorStyle}">
                                </dxe:SpinEdit>
                                <dxe:SpinEdit Value="{Binding Path=PackageDeliveryCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MaxLength="9"
                                              InvalidValueBehavior="AllowLeaveEditor"
                                              HorizontalContentAlignment="Right"
                                              MaskType="Numeric"
                                              Mask="{x:Static business:CurrencyFormatingRules.UahFormat}"
                                              MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                              MaskUseAsDisplayFormat="True"
                                              ShowEditorButtons="False"
                                              Style="{StaticResource ReadOnlyEditorStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                               Command="{Binding Path=HandleDeliveryChangedCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:SpinEdit>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Заберет">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:DateEdit EditValue="{Binding Path=OriginalReceiveTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              AllowRoundOutOfRangeValue="False"
                                              AllowDefaultButton="False"
                                              Style="{StaticResource ReadOnlyDateEditorStyle}" />
                                <Label Visibility="Hidden" />
                                <dxe:DateEdit EditValue="{Binding Path=ReceiveTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MinValue="{Binding Path=ReceiveTimeMinValue, Mode=OneWay}"
                                              NullValueButtonPlacement="EditBox"
                                              ShowClearButton="False"
                                              AllowNullInput="True"
                                              NullValue="{x:Null}"
                                              Style="{StaticResource BasicDateEdit}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Оплата"
                                      View="GroupBox"
                                      GroupBoxStyle="{StaticResource GroupBoxStyle}"
                                      VerticalAlignment="Stretch"
                                      Width="224">
                        <common:OrderPaymentInfoView Items="{Binding Path=OrderPaymentViewModel.Items, Mode=OneWay}"
                                                     ShowBorder="False"
                                                     IsUsdVisible="{Binding Path=Subdivision.IsRetail, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Товары"
                                  View="GroupBox"
                                  GroupBoxStyle="{StaticResource GroupBoxStyle}">
                    <dxg:GridControl ItemsSource="{Binding Path=OrderProducts, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False"
                                     ClipboardCopyMode="ExcludeHeader"
                                     DesignTimeShowSampleData="True"
                                     DesignTimeDataSourceRowCount="3"
                                     DesignTimeDataObjectType="{x:Type store:OrderProductViewItem}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Товар"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="ProductFullName"
                                            FixedWidth="False"
                                            Width="200">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/gift_add.png"
                                                        Visibility="{Binding Path=RowData.Row.IsGift, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                        Height="16"
                                                        Width="16"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Подарок"/>
                                            <dx:DXImage Source="../../../Images/Common/server_lightning.png"
                                                        Visibility="{Binding Path=RowData.Row.ShowAdditionalServiceIcon, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                        Height="16"
                                                        Width="16"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Услуга"/>
                                            <dx:DXImage Source="../../../Images/Common/module.png"
                                                        Visibility="{Binding Path=RowData.Row.ShowAccessoryAdditionalServiceIcon, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                        Height="16"
                                                        Width="16"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Аксессуар"/>
                                            <dx:DXImage
                                                Source="../../../Images/Common/screwdriver.png"
                                                Height="16"
                                                Width="16"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="1,0,0,0"
                                                ToolTipService.ToolTip="Товар для оказания услуги"
                                                Visibility="{Binding RowData.Row.IsAdditionalServiceConsumable, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                            <dxe:TextEdit x:Name="PART_Editor"
                                                          IsReadOnly="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Шт."
                                            HeaderToolTip="Количество"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Quantity"
                                            FixedWidth="True"
                                            Width="{StaticResource QuantityColumnWidth}"
                                            MinWidth="{StaticResource MinQuantityColumnWidth}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Цена"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Right"
                                            FieldName="PriceOut"
                                            FixedWidth="True"
                                            Width="{StaticResource PriceColumnWidth}"
                                            MinWidth="{StaticResource MinPriceColumnWidth}">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit x:Name="PART_Editor"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{Binding Path=RowData.Row.CurrencyOutId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}}"
                                                      MaskCulture="{Binding Path=RowData.Row.CurrencyOutId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                                      MaskSaveLiteral="False"
                                                      IsFloatValue="True"
                                                      AllowDefaultButton="False"
                                                      HorizontalContentAlignment="Right" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="State"
                                            FixedWidth="True"
                                            Width="80"
                                            MinWidth="24">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit x:Name="PART_Editor"
                                                      EditValue="{Binding Path=RowData.Row.State.Name, Mode=OneWay}">
                                            <dxe:TextEdit.Style>
                                                <Style TargetType="dxe:TextEdit">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="{x:Static Brushes.Red}">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{converters:OrderProductStateColorConverter}">
                                                                    <Binding Path="RowData.Row.State"
                                                                             Mode="OneWay"/>
                                                                    <Binding Path="RowData.Row.IsOnWarehouse"
                                                                             Mode="OneWay"/>
                                                                    <Binding Path="RowData.Row.OrderConfirmedBy"
                                                                             Mode="OneWay"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Foreground"
                                                                Value="Red"/>
                                                        </DataTrigger>
                                                        <DataTrigger Value="{x:Static Brushes.Green}">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{converters:OrderProductStateColorConverter}">
                                                                    <Binding Path="RowData.Row.State"
                                                                             Mode="OneWay"/>
                                                                    <Binding Path="RowData.Row.IsOnWarehouse"
                                                                             Mode="OneWay"/>
                                                                    <Binding Path="RowData.Row.OrderConfirmedBy"
                                                                             Mode="OneWay"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Foreground"
                                                                Value="Green"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </dxe:TextEdit.Style>
                                        </dxe:TextEdit>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Источник товара"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Source"
                                            FixedWidth="True"
                                            Width="24"
                                            MinWidth="24">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Height="16"
                                                    Width="16"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <dx:DXImage Source="{Binding Path=RowData.Row.Source.Id, Mode=OneWay, Converter={StaticResource OrderProductSourceImageConverter}}"
                                                        Visibility="{Binding Path=RowData.Row.IsOnWarehouse, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                                                        ToolTip="{Binding Path=RowData.Row.Source.SourceText, Mode=OneWay}" />
                                            <dx:DXImage Source="../../../Images/Common/tick.png"
                                                        Visibility="{Binding Path=RowData.Row.IsOnWarehouse, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                        ToolTip="{Binding Path=RowData.Row.Source.SourceText, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата X"
                                            FieldName="DeliveryDateTime"
                                            FixedWidth="True"
                                            Width="70"
                                            MinWidth="70">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.ShortDateTimeFormat}"
                                                          MaskType="DateTimeAdvancingCaret">
                                    </dxe:DateEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowSorting="False"
                                           Style="{StaticResource ReadOnlyTableViewStyle}">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Предупреждения"
                                  View="GroupBox"
                                  GroupBoxStyle="{StaticResource GroupBoxStyle}"
                                  Visibility="{Binding Path=IsValidationItemsVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxg:GridControl ItemsSource="{Binding Path=ValidationItems, Mode=OneWay}"
                                     ShowBorder="False"
                                     DesignTimeDataObjectType="{x:Type validation:ValidationResultItem}"
                                     DesignTimeDataSourceRowCount="4">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header=" "
                                            FieldName="IsError"
                                            FixedWidth="True"
                                            AllowResizing="False"
                                            Width="24">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <dx:DXImage Source="{StaticResource WarningImage}"
                                                        Visibility="{Binding Path=RowData.Row.IsError, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False, Inverse=True}}" />
                                            <dx:DXImage Source="{StaticResource ErrorImage}"
                                                        Visibility="{Binding Path=RowData.Row.IsError, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Сообщение"
                                            FieldName="Message">
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowSorting="False"
                                           ShowColumnHeaders="False"
                                           Style="{StaticResource ReadOnlyTableViewStyle}" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxe:CheckEdit Content="Отправить дату Х в SMS"
                               EditValue="{Binding Path=SendSms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Visibility="{Binding Path=IsVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}, ElementName=WaitImage}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsTabStop="True"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=LayoutControl}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>