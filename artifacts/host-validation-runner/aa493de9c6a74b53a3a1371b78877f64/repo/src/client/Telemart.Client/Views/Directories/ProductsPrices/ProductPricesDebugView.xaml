<controls:TelemartUserControl x:Class="Telemart.Client.Views.Directories.ProductsPrices.ProductPricesDebugView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsPrices"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:validation="clr-namespace:Telemart.Client.ViewModels.Validation"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              DataContext="{client:Container Type=viewModels:ProductPricesDebugViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:ProductPricesDebugViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="640"
                              d:DesignHeight="480">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="GroupBoxStyle"
                           TargetType="{x:Type dxlc:GroupBox}">
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               FontWeight="DemiBold"
                                               HorizontalAlignment="Left" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxlc:LayoutGroup>
            <dxlc:LayoutItem VerticalAlignment="Stretch">
                <dxe:TextEdit EditValue="{Binding Path=Text, Mode=OneWay}"
                              IsReadOnly="True"
                              TextWrapping="Wrap"
                              AcceptsReturn="True"
                              AcceptsTab="True"
                              VerticalContentAlignment="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Header="Ошибки"
                          View="GroupBox"
                          Height="193"
                          MinHeight="193"
                          dxlc:LayoutControl.AllowVerticalSizing="True"
                          GroupBoxStyle="{StaticResource GroupBoxStyle}">
            <dxlc:LayoutGroup.MaxHeight>
                <MultiBinding Mode="OneWay"
                              Converter="{converters:ResizableLayoutGroupMaxDimensionConverter OppositeMinDimensionValue=300}">
                    <Binding Path="ActualHeight"
                             Mode="OneWay"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    <Binding Path="ItemSpace"
                             Mode="OneWay"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    <Binding Path="Padding"
                             Mode="OneWay"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                </MultiBinding>
            </dxlc:LayoutGroup.MaxHeight>
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=ValidationItems, Mode=OneWay}"
                             ShowBorder="False"
                             DesignTimeDataObjectType="{x:Type validation:ValidationResultItem}"
                             DesignTimeDataSourceRowCount="7">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.View>
                    <dxg:TableView AllowSorting="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}" />
                </dxg:GridControl.View>
                <dxg:GridColumn Header=" "
                                FieldName="IsError"
                                FixedWidth="True"
                                AllowResizing="False"
                                Width="24">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <dx:DXImage Source="{StaticResource WarningImage}"
                                            Visibility="{Binding Path=RowData.Row.IsError, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False, Inverse=True}}" />
                                <dx:DXImage Source="{StaticResource ErrorImage}"
                                            Visibility="{Binding Path=RowData.Row.IsError, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Сообщение"
                                FieldName="Message">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings TextWrapping="Wrap" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</controls:TelemartUserControl>

