<UserControl x:Class="Telemart.Client.Views.Store.Invoice.InvoiceEditBudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Invoice"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:InvoiceEditBudgetsViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:InvoiceEditBudgetsViewModel}}"
             Width="700"
             Height="400"
             d:DesignWidth="700"
             d:DesignHeight="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <DockPanel>
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
               
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="0"
                                  View="GroupBox"
                                  IsEnabled="True"
                                  GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="True">
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=RemoveCommand, Mode=OneWay}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Budgets, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     SelectedItem="{Binding Path=SelectedBudget, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     CurrentItem="{Binding Path=SelectedBudget, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     SelectionMode="Cell">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Бюджет"
                                            HeaderToolTip="Общий бюджет за период, $"
                                            FieldName="Budget"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="150">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskSaveLiteral="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Период ОТ"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Период от"
                                            FieldName="DateFrom"
                                            FixedWidth="True"
                                            Width="120"
                                            MinWidth="80"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          DisplayFormat="{x:Static business:DateFormattingRules.DateFormat}"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Период ДО"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Период до"
                                            FieldName="DateTo"
                                            FixedWidth="True"
                                            Width="120"
                                            MinWidth="80"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          DisplayFormat="{x:Static business:DateFormattingRules.DateFormat}"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создан"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Создан"
                                            FieldName="CreatedOn"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="70"
                                            AllowEditing="False"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="ТП"
                                            HeaderToolTip="Текущий период"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="CurrentBudget"
                                            FixedWidth="True"
                                            Width="32"
                                            MinWidth="32"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowAutoFilter="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dx:DXImage Source="../../../Images/Common/tick.png"
                                                    Width="16"
                                                    Height="16"
                                                    Visibility="{Binding Path=RowData.Row.CurrentBudget, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowResizing="True"
                                           AllowPerPixelScrolling="True"
                                           ShowGroupPanel="False"
                                           AutoWidth="True"
                                           AllowEditing="True"
                                           ShowIndicator="False"
                                           AllowGrouping="False" >
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Справка"
                                  Orientation="Vertical"
                                  View="GroupBox"
                                  VerticalAlignment="Top"
                                  GroupBoxStyle="{StaticResource GroupBorderWithHeaderStyle}">
                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Bottom">
                        Даты периодов ОТ и ДО указываются <Span FontWeight="Bold">включительно</Span>
                    </TextBlock>
                </dxlc:LayoutGroup>
                
                
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="HandleLoadedCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsTabStop="True"
                            IsEnabled="True" />
                    <Button Content="Отмена"
                            IsTabStop="True"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>
</UserControl>