<controls:TelemartUserControl x:Class="Telemart.Client.Views.Warehouse.WarehouseView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:sys="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              DataContext="{client:Container Type=viewModels:WarehouseViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="700"
                              d:DesignHeight="530"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:WarehouseViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="LocalReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 Mode="OneWay"
                                                 ElementName="CurrentUserControl" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SearchableComboBoxReadOnlyConditionsStyle"
                           BasedOn="{StaticResource SearchableComboBoxStyle}"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SearchableComboBoxWithNullValueButtonReadOnlyConditionsStyle"
                           BasedOn="{StaticResource SearchableComboBoxStyle}"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="NullValueButtonPlacement"
                                        Value="EditBox" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="CoordinatesReadOnlyConditionsStyle"
                           BasedOn="{StaticResource LocalReadOnlyConditionsStyle}"
                           TargetType="{x:Type dxe:TextEdit}">
                        <Setter Property="EditValueType"
                                Value="{x:Type sys:String}" />
                        <Setter Property="MaskType"
                                Value="RegEx" />
                        <Setter Property="ValidateOnTextInput"
                                Value="False" />
                        <Setter Property="MaxLength"
                                Value="20" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullText"
                                Value="{StaticResource NullTextValue}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              SelectedTabIndex="{Binding Path=SelectedTabIndex, Mode=TwoWay}"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="SelectedTabChildChanged"
                                           Command="{Binding Path=HandleTabSelectionChangedCommand, Mode=OneWay}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
                <dxlc:LayoutGroup x:Name="Tab0"
                                  Orientation="Vertical"
                                  Margin="8">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/information.png" />
                                <TextBlock Text="Основное"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutItem Label="Название">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      TextWrapping="Wrap"
                                      AcceptsReturn="False"
                                      AcceptsTab="False"
                                      VerticalContentAlignment="Top"
                                      MaxHeight="22"
                                      Style="{StaticResource LocalReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Локация">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Locations, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.LocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          Style="{StaticResource SearchableComboBoxWithNullValueButtonReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Вывеска">
                        <dxe:TextEdit EditValue="{Binding Path=Model.TagsHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      TextWrapping="Wrap"
                                      AcceptsReturn="False"
                                      AcceptsTab="False"
                                      VerticalContentAlignment="Top"
                                      MaxHeight="22"
                                      Style="{StaticResource LocalReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Тип">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.TypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          ValueMember="Id"
                                          Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Ответственный">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.Employee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Буферный склад">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=BufferWarehouses, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.BufferWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                          IsTextEditable="False"
                                          Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Город">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          IsTextEditable="False"
                                          Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Телефон склада">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaskType="Simple"
                                      Mask="(000) 000-00-00"
                                      MaskUseAsDisplayFormat="True"
                                      MaskSaveLiteral="False"
                                      Style="{StaticResource LocalReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Вес">
                        <dxe:SpinEdit EditValue="{Binding Path=Model.MaxPackageWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      EditValueType="{x:Type sys:Int32}"
                                      Mask="n0"
                                      MaskType="Numeric"
                                      HorizontalContentAlignment="Left"
                                      Style="{StaticResource LocalReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Широта">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Latitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, TargetNullValue={x:Static sys:String.Empty}}"
                                      Mask="-?([1-8]?[0-9]\.{1}\d{1,6}|90\.{1}0{1,6})"
                                      Style="{StaticResource CoordinatesReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Долгота">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Longitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, TargetNullValue={x:Static sys:String.Empty}}"
                                      Mask="-?((([1]?[0-7][0-9]|[1-9]?[0-9])\.{1}\d{1,6})|[1]?[1-8][0]\.{1}0{1,6})"
                                      Style="{StaticResource CoordinatesReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      ItemLabelsAlignment="Local">
                        <dxlc:LayoutItem Label="Ячеечное хранение">
                            <dxe:CheckEdit EditValue="{Binding Path=Model.UseCells, Mode=TwoWay}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}">
                                <dxe:CheckEdit.IsReadOnly>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                        <Binding Path="IsLockedByCurrentEmployee" />
                                        <Binding Path="Model.AllowCells" />
                                    </MultiBinding>
                                </dxe:CheckEdit.IsReadOnly>
                            </dxe:CheckEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Авто-источник">
                            <dxe:CheckEdit EditValue="{Binding Path=Model.AutoSource, Mode=TwoWay}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}">
                                <dxe:CheckEdit.IsReadOnly>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                        <Binding Path="IsLockedByCurrentEmployee" />
                                    </MultiBinding>
                                </dxe:CheckEdit.IsReadOnly>
                            </dxe:CheckEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutItem Label="Статус">
                        <dxlc:LayoutGroup Orientation="Horizontal"
                                          HorizontalAlignment="Left">
                            <dxlc:LayoutGroup.Style>
                                <Style TargetType="dxlc:LayoutGroup">
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                    <Setter Property="Opacity"
                                            Value="{StaticResource DisabledElementOpacity}" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Mode="OneWay"
                                                              Converter="{converters:BooleanOrMultiValueConverter}">
                                                    <Binding Path="IsNew"
                                                             Mode="OneWay" />
                                                    <Binding Path="IsLockedByCurrentEmployee"
                                                             Mode="OneWay" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="IsEnabled"
                                                    Value="True" />
                                            <Setter Property="Opacity"
                                                    Value="{StaticResource EnabledElementOpacity}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </dxlc:LayoutGroup.Style>
                            <RadioButton Content="Активен"
                                         IsChecked="{Binding Path=Model.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                            <RadioButton Content="Не активен"
                                         IsChecked="{Binding Path=Model.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                         VerticalAlignment="Center" />
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutGroup View="GroupBox"
                                      Header="Услуги"
                                      Orientation="Vertical"
                                      GroupBoxStyle="{StaticResource GroupBoxWithNoPaddingStyle}"
                                      ItemSpace="0">
                        <dxlc:LayoutItem Label="Алгоритм планирования услуг"
                                         Margin="0 3">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=PerformancePatterns, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.PerformancePatternId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="True"
                                              NullValue="{x:Null}"
                                              Style="{StaticResource SearchableComboBoxWithNullValueButtonReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Квота на услуги"
                                         Margin="0 3">
                            <dxe:ButtonEdit  EditValue="{Binding Model.Quota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             ToolTip="дни.часы:минуты"
                                             AllowNullInput="True"
                                             AllowDefaultButton="False"
                                             NullValue="{x:Null}"
                                             HorizontalContentAlignment="Left"
                                             Mask="dd.hh:mm"
                                             MaskType="TimeSpan"
                                             Style="{StaticResource TimeSpanReadonlyButtonEdit}">
                                <dxe:ButtonEdit.IsReadOnly>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                        <Binding Path="IsLockedByCurrentEmployee" />
                                        <Binding Path="AllowQuota" />
                                    </MultiBinding>
                                </dxe:ButtonEdit.IsReadOnly>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Мастер услуг"
                                         Margin="0 3">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.EmployeeAdditionalService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Склад сборки"
                                         Margin="0 3">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=AssemblyWarehouses, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.AssemblyWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              IsTextEditable="False"
                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Глав. сборщик"
                                         Margin="0 3">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=AssemblyEmployees, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.EmployeeAssembly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab1"
                                  Orientation="Vertical"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Common/house.png" />
                                <TextBlock Text="Перемещения"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                        <dxb:BarButtonItem Content="Обновить"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshRoutesCommand, Mode=OneWay}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=CreateRouteCommand, Mode=OneWay}"
                                           IsEnabled="{Binding Path=Model.IsActive, Mode=OneWay}"
                                           IsVisible="{Binding CanCreateRoute}" />
                        <dxb:BarButtonItem Content="Редактировать"
                                           Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                           Command="{Binding Path=EditRouteCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}"
                                           IsVisible="{Binding CanUpdateRoute}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteRouteCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}"
                                           IsVisible="{Binding CanDeleteRoute}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=WarehouseRoutes, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False"
                                     ShowLoadingPanel="{Binding Path=DeleteRouteCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Style>
                            <Style TargetType="dxg:GridControl"
                                   BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource EnabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridControl.Style>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="WarehouseFrom.Name"
                                            Header="Отправитель"
                                            HeaderToolTip="Склад отправитель"
                                            Width="*" />
                            <dxg:GridColumn FieldName="WarehouseTo.Name"
                                            Header="Получатель"
                                            HeaderToolTip="Склад получатель"
                                            Width="*" />
                            <dxg:GridColumn FieldName="Weight"
                                            Header="Вес"
                                            Width="50"
                                            FixedWidth="True"/>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="TableView"
                                           AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand EventName="RowDoubleClick"
                                                         Command="{Binding Path=EditRouteCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition ApplyToRow="True"
                                                         Expression="WarehouseFrom.Active = 0 or WarehouseTo.Active = 0">
                                        <dxg:FormatCondition.Format>
                                            <dx:Format Foreground="DarkGray" />
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab2"
                                  Orientation="Vertical"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Common/lorry_16x16.png" />
                                <TextBlock Text="Доставки"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                        <dxb:BarButtonItem Content="Обновить"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshDeliveriesCommand, Mode=OneWay}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=CreateDeliveryCommand, Mode=OneWay}"
                                           IsVisible="{Binding CanCreateDelivery}" />
                        <dxb:BarButtonItem Content="Редактировать"
                                           Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                           Command="{Binding Path=EditDeliveryCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=DeliveriesGridControl}"
                                           IsVisible="{Binding CanUpdateDelivery}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteDeliveryCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=DeliveriesGridControl}"
                                           IsVisible="{Binding CanDeleteDelivery}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="DeliveriesGridControl"
                                     ItemsSource="{Binding Path=WarehouseDeliveries, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False"
                                     ShowLoadingPanel="{Binding Path=DeleteDeliveryCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="warehouse_deliveries.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Style>
                            <Style TargetType="dxg:GridControl"
                                   BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource EnabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridControl.Style>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="CarriesString"
                                            Header="Доставка"
                                            HeaderToolTip="Доставка"
                                            MinWidth="24"
                                            Width="220"
                                            FixedWidth="True"
                                            AllowBestFit="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SubdivisionId"
                                            Header="Подразделение"
                                            HeaderToolTip="Подразделение"
                                            Width="24"
                                            FixedWidth="True"
                                            AllowBestFit="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ValueMember="Id"
                                                              DisplayMember="Name"
                                                              IsTextEditable="False"
                                                              ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                                              ApplyItemTemplateToSelectedItem="True"
                                                              ItemTemplate="{StaticResource SubdivisionComboBoxItemTemplate}"></dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DaysOfWeek"
                                            Header="Дни"
                                            HeaderToolTip="Дни недели, в которые работает правило"
                                            AllowBestFit="True" />
                            <dxg:GridColumn FieldName="TimeGet"
                                            Header="Получ."
                                            HeaderToolTip="Время, к которому товар должен быть на складе"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MaskType="DateTime"
                                                          Mask="t"
                                                          MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PlanCourierCall"
                                            Header="Заявка"
                                            HeaderToolTip="Создавать заявку на это время"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings IsThreeState="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PlannedWeight"
                                            Header="Вес"
                                            HeaderToolTip="Планируемый вес заявки"
                                            AllowBestFit="True">
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TimeDeliveryFrom"
                                            Header="Дост. с"
                                            HeaderToolTip="Доставка с"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MaskType="DateTime"
                                                          Mask="t"
                                                          MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TimeDeliveryTo"
                                            Header="Дост. до"
                                            HeaderToolTip="Доставка до"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MaskType="DateTime"
                                                          Mask="t"
                                                          MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand EventName="RowDoubleClick"
                                                         Command="{Binding Path=EditDeliveryCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=DeliveriesGridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab3"
                                  Orientation="Vertical"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Common/timeline.png" />
                                <TextBlock Text="Производительность"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                        <dxb:BarButtonItem Content="Обновить"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshPerfomancesCommand, Mode=OneWay}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=CreatePerfomanceCommand, Mode=OneWay}"
                                           IsVisible="{Binding CanCreatePerfomance}" />
                        <dxb:BarButtonItem Content="Редактировать"
                                           Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                           Command="{Binding Path=EditPerfomanceCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=WarehousePerfomancesGridControl}"
                                           IsVisible="{Binding CanUpdatePerfomance}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeletePerfomanceCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=WarehousePerfomancesGridControl}"
                                           IsVisible="{Binding CanUpdatePerfomance}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="WarehousePerfomancesGridControl"
                                     ItemsSource="{Binding Path=WarehousePerfomances, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False"
                                     ShowLoadingPanel="{Binding Path=DeleteDeliveryCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="warehouse_performance.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Style>
                            <Style TargetType="dxg:GridControl"
                                   BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource EnabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridControl.Style>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="WorkId"
                                            HorizontalHeaderContentAlignment="Center"
                                            Header="Работа"
                                            HeaderToolTip="Вид работы"
                                            AllowResizing="False"
                                            Width="110"
                                            FixedWidth="True"
                                            AllowBestFit="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding WorkTypes}"
                                                              ValueMember="Id"
                                                              DisplayMember="Work"
                                                              HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Binding="{Binding DayOfWeek, Mode=TwoWay}"
                                            FieldName="DayOfWeek"
                                            HorizontalHeaderContentAlignment="Center"
                                            Header="День недели"
                                            AllowResizing="False"
                                            Width="100"
                                            FixedWidth="True"
                                            AllowBestFit="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Performance"
                                            Header="Пр"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="false"
                                            Width="40"
                                            FixedWidth="True"
                                            HeaderToolTip="Производительность"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Estimate"
                                            Header="Трудозатраты"
                                            AllowResizing="false"
                                            HorizontalHeaderContentAlignment="Center"
                                            Width="90"
                                            FixedWidth="True"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                          MaskType="TimeSpan"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="dd.hh:mm"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="AdditionalServiceName"
                                            Header="Услуга"
                                            HorizontalHeaderContentAlignment="Left"
                                            AllowResizing="false"
                                            Width="100"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SubdivisionId"
                                            Header="Подразделение"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="False"
                                            Width="110"
                                            FixedWidth="True"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ValueMember="Id"
                                                              DisplayMember="Name"
                                                              IsTextEditable="False"
                                                              ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                                              ApplyItemTemplateToSelectedItem="True"
                                                              ItemTemplate="{StaticResource SubdivisionComboBoxItemTemplate}">
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Activity"
                                            Header="А"
                                            HeaderToolTip="Активность"
                                            AllowResizing="False"
                                            FixedWidth="True"
                                            Width="25"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowBestFit="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dx:DXImage x:Name="PART_Editor"
                                                    Source="../../Images/Common/tick.png"
                                                    Height="16"
                                                    Width="16"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,0"
                                                    Visibility="{Binding Path=RowData.Row.Activity, Converter={dx:BooleanToVisibilityConverter}}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand EventName="RowDoubleClick"
                                                         Command="{Binding Path=EditPerfomanceCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=WarehousePerfomancesGridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab4"
                                  Orientation="Vertical"
                                  ItemSpace="0"
                                  Visibility="{Binding Model.AllowCells, Converter={dx:BooleanToVisibilityConverter}}">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Common/box_16x16.png" />
                                <TextBlock Text="Адресное хранение"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                        <dxb:BarButtonItem Content="Обновить"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshCellsCommand, Mode=OneWay}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=CreateCellCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Редактировать"
                                           Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                           Command="{Binding Path=UpdateCellCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CellsGridControl}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteCellCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CellsGridControl}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="CellsGridControl"
                                     ItemsSource="{Binding Path=WarehouseCells, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False"
                                     ShowLoadingPanel="{Binding Path=DeleteCellCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="warehouse_cells.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Style>
                            <Style TargetType="dxg:GridControl"
                                   BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource EnabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridControl.Style>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Id"
                                            Header="Код"
                                            HeaderToolTip="Код"
                                            AllowResizing="False"
                                            AllowBestFit="True"
                                            FixedWidth="True"
                                            Width="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Name"
                                            Header="Название"
                                            HeaderToolTip="Название ячейки"
                                            AllowResizing="False"
                                            Width="100"
                                            AllowBestFit="True" />
                            <dxg:GridColumn Header="А"
                                            HeaderToolTip="Активна"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Active"
                                            Width="24"
                                            FilterPopupMode="CheckedList"
                                            FixedWidth="True"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}"></dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand EventName="RowDoubleClick"
                                                         Command="{Binding Path=UpdateCellCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CellsGridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility></TextBlock>
                <dxlc:LayoutGroup x:Name="ButtonsLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <dx:SimpleButton x:Name="CopyButton"
                                     Glyph="../../../Images/Order/Menu/copy.png"
                                     Width="24"
                                     MinWidth="24"
                                     Margin="0,0,-4,0"
                                     Command="{Binding CopyWarehouseCommand, Mode=OneTime}">
                        <dx:SimpleButton.Visibility>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="CanCopyWarehouse" Mode="OneWay"/>
                                <Binding Path="IsLockedByCurrentEmployee" Mode="OneWay"/>
                            </MultiBinding>
                        </dx:SimpleButton.Visibility>
                    </dx:SimpleButton>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         Mode="OneWay"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>