<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.OrderEditContractorView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:themes="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              Loaded="OnLoaded"
                              Height="107"
                              Width="350"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderEditContractorViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Старый">
                    <dxe:ComboBoxEdit x:Name="OldContractorComboBox"
                                      ItemsSource="{Binding Path=AllContractors, Mode=OneWay}"
                                      EditValue="{Binding Path=CurrentContractor, Mode=OneWay}"
                                      DisplayMember="Name"
                                      AllowDefaultButton="False"
                                      IsTextEditable="True"
                                      ItemTemplate="{StaticResource SubdivisionComboBoxItemTemplate}"
                                      Style="{StaticResource ReadOnlyEditorStyle}">
                        <dxe:ComboBoxEdit.EditTemplate>
                            <ControlTemplate>
                                <dxlc:LayoutGroup Padding="0,2"
                                                  ItemSpace="0"
                                                  Orientation="Horizontal">
                                    <dx:DXImage Source="{Binding Path=EditValue.Subdivision.Id, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}, ElementName=OldContractorComboBox}"
                                                Visibility="{Binding Path=Source, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBox Text="{Binding Path=EditValue.Name, Mode=OneWay}"
                                             Style="{DynamicResource {themes:TextEditThemeKey ResourceKey=TextStyle}}" />
                                </dxlc:LayoutGroup>
                            </ControlTemplate>
                        </dxe:ComboBoxEdit.EditTemplate>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новый">
                    <dxe:ComboBoxEdit x:Name="NewContractorComboBox"
                                      ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedContractor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      Style="{StaticResource SearchableComboBoxStyle}">
                        <dxe:ComboBoxEdit.EditTemplate>
                            <ControlTemplate>
                                <dxlc:LayoutGroup Padding="0,2"
                                                  ItemSpace="0"
                                                  Orientation="Horizontal">
                                    <dx:DXImage Source="{Binding Path=EditValue.Subdivision.Id, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}, ElementName=NewContractorComboBox}"
                                                Visibility="{Binding Path=Source, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBox x:Name="PART_Editor"
                                             Style="{DynamicResource {themes:TextEditThemeKey ResourceKey=TextStyle}}" />
                                </dxlc:LayoutGroup>
                            </ControlTemplate>
                        </dxe:ComboBoxEdit.EditTemplate>
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="{Binding Path=Subdivision.Id, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}}"
                                                Margin="0,0,5,0"
                                                Style="{StaticResource ImageStyle}" />
                                    <Label Content="{Binding Path=Name, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <Button Content="OK"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=OkCommand, Mode=OneTime}"
                        IsTabStop="True" />
                <Button Content="Отмена"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=CancelCommand, Mode=OneTime}"
                        IsTabStop="True" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
