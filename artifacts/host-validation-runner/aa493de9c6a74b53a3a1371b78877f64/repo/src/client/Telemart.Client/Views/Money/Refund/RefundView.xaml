<controls:TelemartUserControl x:Class="Telemart.Client.Views.Money.Refund.RefundView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:refund="clr-namespace:Telemart.Client.ViewModels.Money.Refund"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              DataContext="{client:Container Type=refund:RefundViewModel}"
                              Loaded="OnLoaded"
                              Width="750"
                              Height="378"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type refund:RefundViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SearchableComboBoxReadOnlyConditionsStyle"
                           BasedOn="{StaticResource SearchableComboBoxStyle}"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="NullValueButtonPlacement"
                                        Value="EditBox" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="PhoneTextEditReadOnlyConditionsStyle"
                           BasedOn="{StaticResource PhoneTextEdit}"
                           TargetType="dxe:TextEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:CurrentWindowService />
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutItem Label="Заказ">
                        <dxe:ButtonEdit x:Name="OrderButtonEdit"
                                        EditValue="{Binding Path=Model.OrderId, Mode=OneWay}"
                                        AllowDefaultButton="False"
                                        Style="{StaticResource ReadOnlyEditorStyle}">
                            <dxe:ButtonInfo GlyphKind="Search"
                                            ToolTipService.ToolTip="Открыть заказ"
                                            Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Path=Model.OrderId, Mode=OneWay}" />
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Серв. заявка"
                                     Visibility="{Binding Path=Model.ServiceRequestId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}">
                        <dxe:ButtonEdit EditValue="{Binding Path=Model.ServiceRequestId, Mode=OneWay}"
                                        AllowDefaultButton="False"
                                        Style="{StaticResource ReadOnlyEditorStyle}">
                            <dxe:ButtonInfo GlyphKind="Search"
                                            ToolTipService.ToolTip="Открыть сервисную заявку"
                                            Command="{Binding Path=OpenServiceRequestCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Path=Model.ServiceRequestId, Mode=OneWay}" />
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Способ">
                        <dxe:ComboBoxEdit x:Name="PaymentsComboBox"
                                          ItemsSource="{Binding Path=Payments, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.Payment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          AllowNullInput="True"
                                          NullValue="{x:Null}"
                                          NullText="{StaticResource NullTextValue}"
                                          NullValueButtonPlacement="EditBox"
                                          Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                       Command="{Binding HandlePaymentChangedCommand}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Транзакция"
                                     Visibility="{Binding Path=TransactionVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                        <dxe:ComboBoxEdit EditValue="{Binding Path=Model.OrderPaymentId}"
                                          ItemsSource="{Binding Path=OrderPaymentsTransactions}"
                                          DisplayMember="DisplayValue"
                                          HorizontalContentAlignment="Left"
                                          ValueMember="Id"
                                          Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Касса">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.CashboxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          ValueMember="Id"
                                          DisplayMember="DisplayValue"
                                          NullText="{StaticResource NullTextValue}"
                                          AllowNullInput="True"
                                          NullValueButtonPlacement="EditBox"
                                          Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Сумма">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="100"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="ФИО">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Fio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxLength="100"
                                      IsReadOnly="True"
                                      IsEnabled="False"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Телефон">
                        <dxe:ButtonEdit x:Name="PhoneEdit"
                                        AllowDefaultButton="False"
                                        EditValue="{Binding Path=Model.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        Style="{StaticResource PhoneTextEditReadOnlyConditionsStyle}">
                            <dxe:ButtonInfo GlyphKind="Custom"
                                            IsEnabled="{Binding Path=HasValidationError, ElementName=PhoneEdit, Converter={dxmvvm:BooleanNegationConverter}}"
                                            ToolTipService.ToolTip="Отправить повторно приглашение за ДС"
                                            Command="{Binding Path=SendSmsCommand, Mode=OneWay}"
                                            CommandParameter="{Binding Path=Model.Phone, Mode=OneWay}"
                                            Margin="1">
                                <dxe:ButtonInfo.Content>
                                    <dx:DXImage Margin="2 1"
                                                Source="{dx:DXImage Image=Mail_16x16.png}" />
                                </dxe:ButtonInfo.Content>
                            </dxe:ButtonInfo>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Описание"
                                     LabelVerticalAlignment="Top"
                                     VerticalAlignment="Stretch">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                      TextWrapping="Wrap"
                                      MaxLength="1000"
                                      AcceptsReturn="True"
                                      AcceptsTab="True"
                                      VerticalContentAlignment="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Style="{StaticResource ReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  Width="240">
                    <common:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                             LabelColumnWidth="*"
                                             ContentColumnWidth="1.8*" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup x:Name="ButtonsLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Подтвердить"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                            Command="{Binding Path=DataContext.ConfirmCommand, Mode=OneWay, ElementName=LayoutControl}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Order/thumb_up_go_16x16.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Реквизиты"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                            Command="{Binding Path= SetRequisitesCommand, Mode=OneWay}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/user_green.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Вернуть ДС"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                            Command="{Binding Path=DataContext.RefundCommand, Mode=OneWay, ElementName=LayoutControl}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/coins_delete_16x16.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Переоткрыть"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                            Command="{Binding Path=DataContext.RevertRefundCommand, Mode=OneWay, ElementName=LayoutControl}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/arrow_undo_16x16.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Отменить"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                            Command="{Binding Path=DataContext.CancelRefundCommand, Mode=OneWay, ElementName=LayoutControl}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/canceled.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <dx:SimpleButton Content="Возвратный чек"
                                     Glyph="../../../Images/Common/cash_register_left_16x16.png"
                                     Command="{Binding Path=PrintFiscalReturnChequeCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                    <dx:DropDownButton Content="Печать"
                                       Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                       Height="22"
                                       Visibility="{Binding Path=IsPrintVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                       Padding="8,0,0,0">
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Акт"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                               Command="{Binding Path=PrintRefundDocumentCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Заявление на возврат"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                               Command="{Binding Path=PrintStatementReturnRefundCommand, Mode=OneTime}" />
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="SaveCommand.IsExecuting" />
                            <Binding Path="LockCommand.IsExecuting" />
                            <Binding Path="ConfirmCommand.IsExecuting" />
                            <Binding Path="RefundCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>