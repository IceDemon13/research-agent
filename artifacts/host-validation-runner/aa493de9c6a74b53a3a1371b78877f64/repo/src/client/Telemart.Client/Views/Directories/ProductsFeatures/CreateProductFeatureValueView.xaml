<controls:TelemartUserControl x:Class="Telemart.Client.Views.Directories.ProductsFeatures.CreateProductFeatureValueView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsFeatures"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:CreateProductFeatureValueViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:CreateProductFeatureValueViewModel}, IsDesignTimeCreatable=True}"
                              Width="400"
                              Height="226">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Значение (рус.)">
                <dxe:TextEdit EditValue="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Значение (укр.)">
                <dxe:TextEdit EditValue="{Binding Path=ValueUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              IsReadOnly="{Binding Parameter.MultiLanguage}"
                              Style="{StaticResource ReadOnlyConditionsStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Значение (англ.)">
                <dxe:TextEdit EditValue="{Binding Path=ValueEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              IsReadOnly="{Binding Parameter.MultiLanguage}"
                              Style="{StaticResource ReadOnlyConditionsStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Ссылка (рус.)">
                <dxe:TextEdit EditValue="{Binding Path=Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              IsReadOnly="{Binding Parameter.IsUrlReadOnly, Mode=OneWay,  UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Ссылка (укр.)">
                <dxe:TextEdit EditValue="{Binding Path=UrlUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" >
                    <dxe:TextEdit.IsReadOnly>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="DataContext.Parameter.MultiValue" />
                            <Binding Path="DataContext.Parameter.IsUrlReadOnly"
                                     ElementName="CurrentUserControl" />
                        </MultiBinding>
                    </dxe:TextEdit.IsReadOnly>
                </dxe:TextEdit >
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Ссылка (англ.)">
                <dxe:TextEdit EditValue="{Binding Path=UrlEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" >
                    <dxe:TextEdit.IsReadOnly>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="DataContext.Parameter.MultiValue" />
                            <Binding Path="DataContext.Parameter.IsUrlReadOnly"
                                     ElementName="CurrentUserControl" />
                        </MultiBinding>
                    </dxe:TextEdit.IsReadOnly>
                </dxe:TextEdit >
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Создание..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
