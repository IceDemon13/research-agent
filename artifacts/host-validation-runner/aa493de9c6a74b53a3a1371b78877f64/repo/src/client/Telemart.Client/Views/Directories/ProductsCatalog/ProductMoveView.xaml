<controls:TelemartUserControl x:Class="Telemart.Client.Views.Directories.ProductsCatalog.ProductMoveView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:validation="clr-namespace:Telemart.Client.ViewModels.Validation"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsCatalog"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              DataContext="{client:Container Type=viewModels:ProductMoveViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="450"
                              d:DesignHeight="800"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:ProductMoveViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GroupBoxStyle"
                   TargetType="{x:Type dxlc:GroupBox}">
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode=OneWay}"
                                       FontWeight="DemiBold"
                                       HorizontalAlignment="Left" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Категория">
                    <dxe:TextEdit EditValue="{Binding Path=CurrentCategory, Mode=OneWay}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новая категория">
                    <dxg:LookUpEdit ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                    EditValue="{Binding Path=TargetCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    DisplayMember="Name"
                                    AutoPopulateColumns="False"
                                    AutoComplete="False"
                                    IncrementalFiltering="True"
                                    FilterCondition="Like"
                                    FindMode="Always"
                                    ImmediatePopup="True"
                                    IsPopupAutoWidth="True"
                                    NullValueButtonPlacement="EditBox">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:FocusBehavior />
                            <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                   Command="{Binding Path=HandleTargetCategoryChangedCommand, Mode=OneWay}" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:LookUpEdit.StyleSettings>
                            <dxg:SearchLookUpEditStyleSettings />
                        </dxg:LookUpEdit.StyleSettings>
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <dxg:GridControl Name="PART_GridControl">
                                    <dxg:GridControl.Resources>
                                        <Style TargetType="dxg:GridColumn"
                                               BasedOn="{StaticResource GeneralGridColumnStyle}">
                                        </Style>
                                    </dxg:GridControl.Resources>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="NameWithId"
                                                        Header="Категория"
                                                        AllowResizing="False"
                                                        FixedWidth="False" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView AutoWidth="True"
                                                          AutoExpandAllNodes="False"
                                                          KeyFieldName="Id"
                                                          ParentFieldName="ParentId"
                                                          ShowIndicator="False"
                                                          UseEvenRowBackground="True"
                                                          AlternationCount="2"
                                                          AlternateRowBackground="{StaticResource AlternateRowBackgroundBrush}" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup Header="Свойства"
                                  View="GroupBox"
                                  GroupBoxStyle="{StaticResource GroupBoxStyle}">
                    <dxg:GridControl ItemsSource="{Binding Path=Properties, Mode=OneWay}"
                                     ShowLoadingPanel="{Binding Path=HandleTargetCategoryChangedCommand.IsExecuting, Mode=OneWay}"
                                     SelectionMode="None"
                                     ShowBorder="False">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Свойство"
                                            FieldName="DisplayName" />
                            <dxg:GridColumn Header="Товар"
                                            HeaderToolTip="Текущее значение свойства у товара"
                                            FieldName="ProductValue" />
                            <dxg:GridColumn Header="Категория"
                                            HeaderToolTip="Значение в новой категории"
                                            FieldName="CategoryValue" />
                            <dxg:GridColumn Header="Новое"
                                            HeaderToolTip="Значение, которое будет сохранено"
                                            FieldName="Value"
                                            AllowEditing="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding Path=RowData.Row.Values, Mode=OneWay}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="True"
                                           ShowIndicator="False"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowSorting="False"
                                           AllowColumnFiltering="False"
                                           AllowFilterEditor="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           EditorShowMode="MouseDown"
                                           EnableImmediatePosting="True"
                                           CustomCellAppearance="TableViewOnCustomCellAppearance">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                           Command="{Binding Path=DataContext.HandleProductPropertyChangedCommand, Mode=OneWay, ElementName=LayoutControl}" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition Expression="[IsChanged] = TRUE">
                                        <dx:Format Background="{StaticResource RoseColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Предупреждения"
                                  View="GroupBox"
                                  Height="108"
                                  MinHeight="108"
                                  dxlc:LayoutControl.AllowVerticalSizing="True"
                                  GroupBoxStyle="{StaticResource GroupBoxStyle}">
                    <dxlc:LayoutGroup.MaxHeight>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:ResizableLayoutGroupMaxDimensionConverter OppositeMinDimensionValue=300}">
                            <Binding Path="ActualHeight"
                                     Mode="OneWay"
                                     RelativeSource="{RelativeSource AncestorType=dxlc:LayoutGroup}" />
                            <Binding Path="ItemSpace"
                                     Mode="OneWay"
                                     RelativeSource="{RelativeSource AncestorType=dxlc:LayoutGroup}" />
                            <Binding Path="Padding"
                                     Mode="OneWay"
                                     RelativeSource="{RelativeSource AncestorType=dxlc:LayoutGroup}" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.MaxHeight>
                    <dxg:GridControl ItemsSource="{Binding Path=Validations, Mode=OneWay}"
                                     ShowBorder="False"
                                     DesignTimeDataObjectType="{x:Type validation:ValidationResultItem}"
                                     DesignTimeDataSourceRowCount="4">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header=" "
                                            FieldName="IsError"
                                            FixedWidth="True"
                                            AllowResizing="False"
                                            Width="24">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <dx:DXImage Source="{StaticResource WarningImage}"
                                                        Visibility="{Binding Path=RowData.Row.IsError, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False, Inverse=True}}" />
                                            <dx:DXImage Source="{StaticResource ErrorImage}"
                                                        Visibility="{Binding Path=RowData.Row.IsError, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Сообщение"
                                            FieldName="Message">
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowSorting="False"
                                           ShowColumnHeaders="False"
                                           Style="{StaticResource ReadOnlyTableViewStyle}" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>