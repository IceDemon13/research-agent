<UserControl x:Class="Telemart.Client.ViewComponents.Threading.BusyIndicator"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:threading="clr-namespace:Telemart.Client.ViewComponents.Threading"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             Height="Auto"
             Width="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <StackPanel DataContext="{Binding ElementName=CurrentUserControl}"
                Orientation="Horizontal">
        <Viewbox Width="16"
                 Height="16"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <threading:CircularProgressBar />
        </Viewbox>
        <TextBlock Text="{Binding Path=BusyText, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   Visibility="{Binding Path=BusyText, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
