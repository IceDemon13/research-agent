<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="PickupImage"
                 UriSource="/Images/Order/Carry/carry1.png" />
    <BitmapImage x:Key="DeliveryImage"
                 UriSource="/Images/Order/Carry/carry2.png" />
    <BitmapImage x:Key="NpWarehouseImage"
                 UriSource="/Images/Order/Carry/carry3.png" />
    <BitmapImage x:Key="NpDeliveryImage"
                 UriSource="/Images/Order/Carry/carry4.png" />
    <BitmapImage x:Key="GunselImage"
                 UriSource="/Images/Order/Carry/carry5.png" />
    <BitmapImage x:Key="NochnikImage"
                 UriSource="/Images/Order/Carry/carry6.png" />
    <BitmapImage x:Key="OtherImage"
                 UriSource="/Images/Order/Carry/carry7.png" />
    <BitmapImage x:Key="MiniBusImage"
                 UriSource="/Images/Order/Carry/carry8.png" />
    <BitmapImage x:Key="MeestExpressImage"
                 UriSource="/Images/Order/Carry/carry12.png" />
    <BitmapImage x:Key="UkrposhtaImage"
                 UriSource="/Images/Order/Carry/ukrposhta_logo.png" />
    <BitmapImage x:Key="TeksImage"
                 UriSource="/Images/Order/Carry/teks_16.png" />
    <BitmapImage x:Key="UklonImage"
                 UriSource="/Images/Common/uklon.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="CarryTypeImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource PickupImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource DeliveryImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource NpWarehouseImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource NpDeliveryImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource GunselImage}" />
        <dxmvvm:MapItem Source="6"
                        Target="{StaticResource NochnikImage}" />
        <dxmvvm:MapItem Source="7"
                        Target="{StaticResource OtherImage}" />
        <dxmvvm:MapItem Source="8"
                        Target="{StaticResource MiniBusImage}" />
        <dxmvvm:MapItem Source="9"
                        Target="{StaticResource DeliveryImage}" />
        <dxmvvm:MapItem Source="10"
                        Target="{StaticResource DeliveryImage}" />
        <dxmvvm:MapItem Source="11"
                        Target="{StaticResource DeliveryImage}" />
        <dxmvvm:MapItem Source="12"
                        Target="{StaticResource MeestExpressImage}" />
        <dxmvvm:MapItem Source="13"
                        Target="{StaticResource MeestExpressImage}" />
        <dxmvvm:MapItem Source="15"
                        Target="{StaticResource MeestExpressImage}" />
        <dxmvvm:MapItem Source="16"
                        Target="{StaticResource MeestExpressImage}" />
        <dxmvvm:MapItem Source="17"
                        Target="{StaticResource NpWarehouseImage}" />
        <dxmvvm:MapItem Source="18"
                        Target="{StaticResource DeliveryImage}" />
        <dxmvvm:MapItem Source="19"
                        Target="{StaticResource DeliveryImage}" />
        <dxmvvm:MapItem Source="20"
                        Target="{StaticResource UkrposhtaImage}" />
        <dxmvvm:MapItem Source="21"
                        Target="{StaticResource UkrposhtaImage}" />
        <dxmvvm:MapItem Source="22"
                        Target="{StaticResource TeksImage}"/>
        <dxmvvm:MapItem Source="23"
                        Target="{StaticResource UklonImage}"/>
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="CarryTypeComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:CarryType}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource CarryTypeImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CarryTypeShortComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:CarryType}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource CarryTypeImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=NameShort, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="CarryTypeColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource CarryTypeComboBoxItemTemplate}" />
    </ControlTemplate>

    <ControlTemplate x:Key="CarryTypeShortColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource CarryTypeShortComboBoxItemTemplate}" />
    </ControlTemplate>

</ResourceDictionary>