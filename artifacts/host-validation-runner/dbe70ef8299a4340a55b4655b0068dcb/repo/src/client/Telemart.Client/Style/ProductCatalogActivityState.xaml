<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm">

    <BitmapImage x:Key="ActiveImage"
                 UriSource="/Images/Common/tick.png" />
    <BitmapImage x:Key="PendingActiveImage"
                 UriSource="/Images/Common/tick_grey_16x16.png" />
    <BitmapImage x:Key="ViewedInB2BImage"
                 UriSource="/Images/Common/b2b.png" />
    <BitmapImage x:Key="HiddenImage"
                 UriSource="/Images/Common/cross.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="ProductCatalogActivityStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource ActiveImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource PendingActiveImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource ViewedInB2BImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource HiddenImage}" />
    </dxmvvm:ObjectToObjectConverter>

</ResourceDictionary>