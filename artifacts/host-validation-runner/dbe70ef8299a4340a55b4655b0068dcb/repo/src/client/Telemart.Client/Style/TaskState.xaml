<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="NewImage"
                 UriSource="/Images/Common/lightbulb.png" />
    <BitmapImage x:Key="InProgressImage"
                 UriSource="/Images/Common/control_play_blue_16x16.png" />
    <BitmapImage x:Key="CompletedImage"
                 UriSource="/Images/Common/tick.png" />
    <BitmapImage x:Key="CancelImage"
                 UriSource="/Images/Common/canceled.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="TaskStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource NewImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource InProgressImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource CompletedImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource CancelImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="TaskStateComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:TaskState}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource TaskStateImageConverter}}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="TaskStateColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource TaskStateComboBoxItemTemplate}" />
    </ControlTemplate>

</ResourceDictionary>