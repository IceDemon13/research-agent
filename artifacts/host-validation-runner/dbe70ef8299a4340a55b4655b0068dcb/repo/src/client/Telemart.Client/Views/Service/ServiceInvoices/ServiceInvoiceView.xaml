<controls:TelemartUserControl x:Class="Telemart.Client.Views.Service.ServiceInvoices.ServiceInvoiceView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceInvoices"
                              mc:Ignorable="d"
                              d:DesignHeight="768"
                              d:DesignWidth="1024"
                              DataContext="{client:Container Type=viewModels:ServiceInvoiceViewModel}"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ServiceInvoiceViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ServiceInvoiceProductState.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutControl.IsEnabled>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                    <Binding Path="HandleLoadedCommand.IsExecuting" />
                    <Binding Path="LockCommand.IsExecuting" />
                    <Binding Path="OkCommand.IsExecuting" />
                    <Binding Path="SendServiceInvoiceCommand.IsExecuting" />
                    <Binding Path="CompleteServiceInvoiceCommand.IsExecuting" />
                </MultiBinding>
            </dxlc:LayoutControl.IsEnabled>
            <dxlc:LayoutGroup Name="Center"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup VerticalAlignment="Stretch"
                                  ItemSpace="0"
                                  Orientation="Vertical">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                        <dxb:BarButtonItem Content="Удалить"
                                           Hint="Удалить (Del)"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteProductCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, ElementName=GridControl, Mode=OneWay}"
                                           KeyGesture="Del">
                            <dxb:BarButtonItem.IsEnabled>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                    <Binding Path="HandleLoadedCommand.IsExecuting"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                    <Binding Path="IsLockedByCurrentEmployee"
                                             Mode="OneWay" />
                                    <Binding Path="Model.State.Id"
                                             Mode="OneWay"
                                             Converter="{converters:IsEqualConverter}"
                                             ConverterParameter="{x:Static dictionaries:ServiceInvoiceState.NewId}" />
                                </MultiBinding>
                            </dxb:BarButtonItem.IsEnabled>
                        </dxb:BarButtonItem>
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Экспорт в Excel"
                                           Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}"
                                           Command="{Binding Path=ExportToXlsxCommand, Mode=OneWay}"
                                           CommandParameter="{Binding ElementName=TableView}"
                                           KeyGesture="Alt+E">
                        </dxb:BarButtonItem>
                    </dxb:ToolBarControl>
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Model.Products, Mode=OneWay, ValidatesOnDataErrors=False}"
                                     CurrentItem="{Binding Path=SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                     ShowLoadingPanel="{Binding Path=IsEnabled, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=LayoutControl}"
                                     SelectionMode="None"
                                     ShowBorder="True"
                                     ClipToBounds="True">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="service_invoice.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Style>
                            <Style TargetType="dxg:GridControl">
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="dx:ScrollBarExtensions.ScrollBarMode"
                                        Value="TouchOverlap"></Setter>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="Model.State.Id"
                                                         Mode="OneWay"
                                                         Converter="{converters:IsEqualConverter Inverse=True}"
                                                         ConverterParameter="{x:Static dictionaries:ServiceInvoiceState.NewId}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridControl.Style>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="ServiceRepairId"
                                            Header="Ремонт"
                                            HeaderToolTip="Номер ремонта"
                                            HorizontalHeaderContentAlignment="Center"
                                            FixedWidth="True"
                                            Width="60"
                                            MinWidth="40"
                                            AllowSorting="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ServiceRequestId"
                                            Header="Заявка"
                                            HeaderToolTip="Номер заявки"
                                            HorizontalHeaderContentAlignment="Center"
                                            FixedWidth="True"
                                            Width="70"
                                            MinWidth="50"
                                            AllowSorting="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ProductName"
                                            Header="Товар"
                                            HorizontalHeaderContentAlignment="Left"
                                            Width="150"
                                            MinWidth="80"
                                            AllowSorting="True">
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SerialNumber"
                                            Header="SN"
                                            HorizontalHeaderContentAlignment="Left"
                                            MinWidth="40"
                                            AllowSorting="True" />
                            <dxg:GridColumn FieldName="Defect"
                                            Header="Дефект"
                                            MinWidth="40" />
                            <dxg:GridColumn Header="Сохранка"
                                            FieldName="RepairInvoice"
                                            MinWidth="40">
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="State"
                                            Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            AllowEditing="False"
                                            FixedWidth="True"
                                            MaxWidth="80"
                                            Width="26"
                                            MinWidth="26"
                                            AllowBestFit="True"
                                            FilterPopupMode="CheckedList"
                                            AllowColumnFiltering="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            DisplayTemplate="{StaticResource ServiceInvoiceProductStateColumnDisplayTemplate}">
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="TableView"
                                           AllowEditing="False"
                                           AutoWidth="True"
                                           AllowGrouping="False"
                                           AllowFilterEditor="False"
                                           AllowSorting="False"
                                           AllowBestFit="True"
                                           AllowPrintDetails="True"
                                           AllowResizing="True"
                                           AllowColumnFiltering="False"
                                           AllowColumnMoving="False"
                                           ShowAutoFilterRow="False"
                                           AllowMasterDetail="False"
                                           ShowGroupPanel="False"
                                           ShowIndicator="False"
                                           NavigationStyle="Cell"
                                           IsColumnMenuEnabled="False"
                                           IsColumnChooserVisible="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding HandleRowDoubleClickCommand}"
                                                           PassEventArgsToCommand="True"/>
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <common:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                         LabelColumnWidth="*"
                                         ContentColumnWidth="1.4*"
                                         VerticalAlignment="Top"
                                         Width="200" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup x:Name="Bottom"
                              Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              ItemSpace="20">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">
                    <Button x:Name="EditButton"
                            Content="Редактировать"
                            Width="105"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Command="{Binding Path=LockCommand, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="Model.State.Id"
                                                         Mode="OneWay"
                                                         Converter="{converters:IsEqualConverter}"
                                                         ConverterParameter="{x:Static dictionaries:ServiceInvoiceState.NewId}" />
                                                <Binding Path="HandleLoadedCommand.IsExecuting"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="Model.EmployeeLockName"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:ObjectToBooleanConverter Inverse=True}" />
                                                <Binding Path="IsAllowEdit"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Отправить"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Width="110"
                            Command="{Binding Path=SendServiceInvoiceCommand, Mode=OneWay}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <dx:DXImage Source="/Images/Common/lorry_go.png"
                                                Stretch="Fill" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.Visibility>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="IsInvoiceCompletionAllowed"
                                         Mode="OneWay" />
                                <Binding Path="Model.State.Id"
                                         Mode="OneWay"
                                         Converter="{converters:IsEqualConverter}"
                                         ConverterParameter="{x:Static dictionaries:ServiceInvoiceState.NewId}" />
                                <Binding Path="Model.EmployeeLockName"
                                         Converter="{dxmvvm:ObjectToBooleanConverter Inverse=True}"
                                         Mode="OneWay" />
                                <Binding Path="HandleLoadedCommand.IsExecuting"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsAllowEdit"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>
                    <Button Content="Завершить"
                            Width="110"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Command="{Binding Path=CompleteServiceInvoiceCommand, Mode=OneWay}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <dx:DXImage Source="/Images/Common/tick.png"
                                                Stretch="Fill" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.Visibility>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="IsInvoiceCompletionAllowed"
                                         Mode="OneWay" />
                                <Binding Path="Model.State.Id"
                                         Mode="OneWay"
                                         Converter="{converters:IsEqualConverter}"
                                         ConverterParameter="{x:Static dictionaries:ServiceInvoiceState.SentId}" />
                                <Binding Path="Model.EmployeeLockName"
                                         Converter="{dxmvvm:ObjectToBooleanConverter Inverse=True}"
                                         Mode="OneWay" />
                                <Binding Path="HandleLoadedCommand.IsExecuting"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsAllowEdit"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup.Style>
                        <Style TargetType="dxlc:LayoutGroup">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                            <Binding Path="IsLockedByCurrentEmployee"
                                                     Mode="OneWay"
                                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                                            <Binding Path="Model.EmployeeLockName"
                                                     Converter="{dxmvvm:ObjectToBooleanConverter}"
                                                     Mode="OneWay" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxlc:LayoutGroup.Style>
                    <TextBlock Text="Редактирует: "
                               Foreground="Red" />
                    <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup VerticalAlignment="Center"
                                  HorizontalAlignment="Right">
                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      ItemSpace="8">
                        <dx:DropDownButton Content="Печать"
                                           Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                           Padding="8,0,0,0">
                            <dx:DropDownButton.IsEnabled>
                                <MultiBinding Mode="OneWay"
                                              Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                    <Binding Path="IsLockedByCurrentEmployee"
                                             Mode="OneWay" />
                                </MultiBinding>
                            </dx:DropDownButton.IsEnabled>
                            <dxb:PopupMenu>
                                <dxb:BarButtonItem Content="Накладная"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   Glyph="{dx:DXImage Image=Print_16x16.png}"
                                                   LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                                   Command="{Binding Path=PrintCommand, Mode=OneTime}"/>
                                <dxb:BarButtonItem Content="ТТН"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   Glyph="{dx:DXImage Image=Print_16x16.png}"
                                                   LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                                   Command="{Binding Path=PrintTrackNumberCommand, Mode=OneTime}" />
                            </dxb:PopupMenu>
                        </dx:DropDownButton>
                        <StackPanel Style="{StaticResource VerticalSeparatorStackPanelStyle}" />
                        <Button x:Name="OkBtn"
                                Content="OK"
                                Visibility="{Binding Path=Model.State, Mode=OneWay, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static dictionaries:ServiceInvoiceState.NewId}}"
                                Command="{Binding Path=OkCommand, Mode=OneWay}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                    <Binding Path="(dxe:ValidationService.HasValidationError)"
                                             ElementName="LayoutControl"
                                             Mode="OneWay"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                    <Binding Path="IsLockedByCurrentEmployee"
                                             Mode="OneWay" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                        <Button x:Name="SaveBtn"
                                Content="Сохранить"
                                Visibility="{Binding Path=Visibility, ElementName=OkBtn, Mode=OneWay}"
                                Command="{Binding Path=SaveCommand, Mode=OneWay}"
                                IsEnabled="{Binding Path=IsEnabled, ElementName=OkBtn}">
                        </Button>
                    </dxlc:LayoutGroup>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
