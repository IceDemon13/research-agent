<UserControl x:Class="Telemart.Client.Views.Store.StoreOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:commonUserControls="clr-namespace:Telemart.Client.Views.Common"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             DataContext="{client:Container Type=viewModels:StoreOrdersViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type=viewModels:StoreOrdersViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Payment.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
                <ResourceDictionary>
                    <converters:SubdivisionSelectedItemsConverter x:Key="SubdivisionSelectedItemsConverter" />
                    <converters:PaymentSelectedItemsConverter x:Key="PaymentSelectedItemsConverter" />
                    <converters:CarrySelectedItemsConverter x:Key="CarrySelectedItemsConverter" />
                    <converters:StatusSelectedItemsConverter x:Key="StatusSelectedItemsConverter" />
                    <Style TargetType="dxg:GridColumn">
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="ShowInColumnChooser"
                                Value="True" />
                        <Setter Property="HorizontalHeaderContentAlignment"
                                Value="Center" />
                    </Style>

                    <dxmvvm:ObjectToObjectConverter x:Key="NewCallsCountToStrikethroughConverter"
                                                    DefaultTarget="StrikeThrough">
                        <dxmvvm:MapItem Source="0"
                                        Target="None" />
                        <dxmvvm:MapItem Source="{x:Null}"
                                        Target="None" />
                    </dxmvvm:ObjectToObjectConverter>
                    <Style x:Key="InformationImageStyle"
                           TargetType="dx:DXImage">
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip>
                                    <dxlc:LayoutControl Orientation="Vertical">
                                        <dxlc:LayoutItem Label="Заказ редактирует:"
                                                         Visibility="{Binding Path=RowData.Row.LockEmployee, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Path=RowData.Row.LockEmployee, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="200" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem
                                                         Visibility="{Binding Path=RowData.Row.Comment, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Path=RowData.Row.Comment, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="200" />
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutControl>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                <dxb:BarCheckItem Content="Товары"
                                  ToolTip="Товары (Alt+P)"
                                  LargeGlyph="{dx:DXImage Image=Suggestion_32x32.png}"
                                  Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                  IsChecked="{Binding Path=ShowProducts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarSubItem Content="Вид"
                                LargeGlyph="../../../Images/Common/layout_32x32.png"
                                BarItemDisplayMode="ContentAndGlyph"
                                GlyphAlignment="Top"
                                IsVisible="True">
                    <dxb:BarButtonItem Content="Загрузить"
                                       Glyph="{dx:DXImage Image=Open2_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Open2_32x32.png}"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=FilterModuleLayoutService.LoadLayoutCommand, Mode=OneTime}"
                                       CommandParameter="{Binding ElementName=GridControl}"/>
                    <dxb:BarButtonItem Content="Сохранить"
                                       Glyph="{dx:DXImage Image=Save_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=FilterModuleLayoutService.SaveLayoutCommand, Mode=OneTime}"
                                       CommandParameter="{Binding ElementName=GridControl}"/>
                </dxb:BarSubItem>
                <dxb:BarItemSeparator />
                <dxb:BarSplitButtonItem Content="Создать"
                                        ToolTip="Создать (Insert)"
                                        LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                        Glyph="{dx:DXImage Image=Add_16x16.png}"
                                        GlyphAlignment="Top"
                                        ArrowAlignment="Right"
                                        BarItemDisplayMode="ContentAndGlyph"
                                        IsEnabled="{Binding Path=IsAddButtonEnabled, Mode=OneWay}"
                                        IsVisible="{Binding IsOutsourceSeller, Converter={dxmvvm:BooleanNegationConverter}}"
                                        Command="{Binding Path=AddCommand, Mode=OneTime}">
                    <dxb:BarSplitButtonItem.PopupControl>
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Из шаблона"
                                               Glyph="/Images/Order/add_from_template.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Command="{Binding Path=AddFromTemplateCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Списание"
                                               Glyph="/Images/Common/package_green_16x16.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Command="{Binding Path=AddPresaleCommand, Mode=OneTime}"
                                               IsVisible="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                        </dxb:PopupMenu>
                    </dxb:BarSplitButtonItem.PopupControl>
                </dxb:BarSplitButtonItem>
                <dxb:BarButtonItem Content="С витрины"
                                   ToolTip="С витрины"
                                   Glyph="../../Images/Common/time_go_32x32.png"
                                   Command="{Binding Path=CreateCompletedOrderCommand, Mode=OneTime}"
                                   IsVisible="{Binding CanCreateCompletedOrder}" />
                <dxb:BarSubItem Content="Изменить"
                                LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                BarItemDisplayMode="ContentAndGlyph"
                                IsEnabled="{Binding SelectedOrder.EmployeeLockId, Converter={dxmvvm:ObjectToBooleanConverter Inverse=True}}"
                                IsVisible="{Binding IsOutsourceSeller, Converter={dxmvvm:BooleanNegationConverter}}"
                                GlyphAlignment="Top">
                    <dxb:BarButtonItem Content="Заказ"
                                       ToolTip="Изменить заказ (F2)"
                                       Glyph="../../Images/Common/cart_full_16x16.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=EditCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Оплату"
                                       Glyph="../../Images/Order/Filter/money.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=EditPaymentCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Дату X"
                                       Glyph="../../Images/Common/calendar_edit.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=EditDeliveryDateCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Контрагента"
                                       Glyph="../../Images/Order/Filter/user_suit.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       IsVisible="{Binding CanChangeContractor}"
                                       Command="{Binding Path=EditContractorCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Гарантию"
                                       Glyph="../../Images/Common/tick_grey_16x16.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       IsVisible="{Binding CanChangeWarranty}"
                                       Command="{Binding Path=EditWarrantyCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Инфо"
                                       Glyph="../../Images/Contractor/information.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=EditInfoCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Стоимость"
                                       Glyph="../../Images/Common/coins_16x16.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=EditPriceCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=CanEditProductPrices, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Менеджера"
                                       ToolTip="Менеджера"
                                       Glyph="../../Images/Order/Filter/user.png"
                                       Command="{Binding Path=SetManagerCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=CanSetManager, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Нал. платеж"
                                       ToolTip="Наложенный платеж"
                                       Glyph="../../Images/Common/lorry_16x16.png"
                                       Command="{Binding Path=SetMoneyBackAmountCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=CanSetMoneyBack, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Доставку"
                                       ToolTip="Доставку"
                                       Glyph="../../Images/Common/lorry_16x16.png"
                                       Command="{Binding Path=SetCarryCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=CanSetCarry, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="ТТН"
                                       ToolTip="Изменить ТТН Новой Почты"
                                       Glyph="../../Images/Common/novaposhta_16x16.png"
                                       Command="{Binding Path=UpdateNpTtnCommand, Mode=OneTime}"
                                       Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"/>
                </dxb:BarSubItem>
                <dxb:BarSubItem Content="Инстр."
                                ToolTip="Инструменты"
                                LargeGlyph="pack://application:,,,/Telemart.Client;component/Images/Common/setting_tools_32x32.png"
                                Glyph="pack://application:,,,/Telemart.Client;component/Images/Common/setting_tools_16x16.png"
                                GlyphAlignment="Top"
                                BarItemDisplayMode="ContentAndGlyph"
                                IsVisible="{Binding IsOutsourceSeller, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Скопировать"
                                       ToolTip="Скопировать (Alt+Insert)"
                                       Glyph="/Images/Order/page_copy_16x16.png"
                                       Command="{Binding Path=CopyOrderCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Объединить"
                                       Glyph="/Images/Order/cart_full_16x16.png"
                                       Command="{Binding Path=MergeOrderCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <dxb:BarButtonItem Content="Перенести"
                                       ToolTip="Перенести"
                                       Glyph="/Images/Order/cart_remove.png"
                                       Command="{Binding Path=MoveProductCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <dxb:BarButtonItem Content="Привязать"
                                       ToolTip="Привязать"
                                       Glyph="/Images/Common/user_add_16x16.png"
                                       Command="{Binding Path=SetCustomerCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}"
                                       IsVisible="{Binding Path=CanSetCustomer, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Шутник"
                                       ToolTip="Шутник"
                                       Glyph="/Images/Common/user_bart.png"
                                       Command="{Binding Path=SetJokerCommand, Mode=OneTime}"
                                       IsVisible="{Binding Path=CanSetJoker, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Инициировать распаковку"
                                       ToolTip="Инициировать распаковку"
                                       Glyph="/Images/Order/installer_box.png"
                                       Command="{Binding Path=CreateUnpackEventCommand, Mode=OneTime}"
                                       IsVisible="{Binding Path=CanCreateUnpackEvent, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Запланировать доставку"
                                       ToolTip="Запланировать доставку"
                                       Glyph="/Images/Common/lorry_16x16.png"
                                       Command="{Binding Path=ScheduleDeliveryCommand, Mode=OneTime}"
                                       Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"/>
                    <dxb:BarButtonItem Content="Масс. планирование доставки"
                                       ToolTip="Массовое планирование доставки"
                                       Glyph="/Images/Common/lorry_go.png"
                                       Command="{Binding Path=ScheduleDeliveriesCommand, Mode=OneTime}"
                                       Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"/>
                    <dxb:BarButtonItem Content="Ост. отмену заказа з сайта"
                                       ToolTip="Остановить отмену заказа з сайта"
                                       Glyph="/Images/Common/lorry_16x16.png"
                                       Command="{Binding Path=StopCancelingOrderFromSiteCommand, Mode=OneTime}"
                                       Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"/>
                </dxb:BarSubItem>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="SMS"
                                   ToolTip="Отправить SMS"
                                   LargeGlyph="../../Images/Actions/mail_yellow_32_32.png"
                                   Command="{Binding Path=SendSmsCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                <dxb:BarSubItem x:Name="TrackNumberBarSubItem"
                                Content="ТТН"
                                LargeGlyph="../../Images/Actions/barcode_32_32.png"
                                GlyphAlignment="Top"
                                BarItemDisplayMode="ContentAndGlyph"
                                IsVisible="{Binding IsOutsourceSeller, Converter={dxmvvm:BooleanNegationConverter}}"
                                IsEnabled="{Binding Path=SelectedOrder, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                    <dxb:BarButtonItem Content="Номер (В буфер)"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="../../Images/Order/Menu/barcode.png"
                                       Command="{Binding Path=CopyWaybillToClipboardCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Отследить"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="../../Images/Order/Menu/search.png"
                                       Command="{Binding Path=TrackWaybillCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                </dxb:BarSubItem>
                <dxb:BarButtonItem Content="Упр. хэш."
                                   ToolTip="Управление хэштегами"
                                   LargeGlyph="../../Images/Common/tag_hash.png"
                                   IsVisible="{Binding Path=CanManagePhoneHashtags, Mode=OneWay}"
                                   Command="{Binding Path=ManagePhoneHashtagsCommand, Mode=OneTime}"/>
                <dxb:BarSubItem x:Name="SettingsBarSubItem"
                                Content="Настройки"
                                LargeGlyph="../../Images/Common/order_settings.png"
                                GlyphAlignment="Top"
                                BarItemDisplayMode="ContentAndGlyph"
                                IsVisible="{Binding Path=SettingsVisible, Mode=OneWay}"
                                IsEnabled="{Binding Path=SelectedOrder, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                    <dxb:BarButtonItem Content="Корзина"
                                       ToolTip="Настройки корзины"
                                       Glyph="../../Images/Common/cart_full_16x16.png"
                                       IsVisible="{Binding Path=OrderConfigurationVisible, Mode=OneWay}"
                                       Command="{Binding Path=OrderConfigurationCommand, Mode=OneTime}"/>
                    <dxb:BarButtonItem Content="Авто-согласование"
                                       ToolTip="Настройки авто-согласования"
                                       Glyph="../../Images/Common/android_16x16.png"
                                       IsVisible="{Binding Path=OrderAutoConfirmSettingsVisible, Mode=OneWay}"
                                       Command="{Binding Path=OrderAutoConfirmSettingsCommand, Mode=OneTime}"/>
                    <dxb:BarButtonItem Content="Авто-источник"
                                       ToolTip="Настройки авто-источника"
                                       Glyph="{StaticResource Lightning16}"
                                       Command="{Binding Path=AutoSourceSettingsCommand, Mode=OneTime}"/>
                </dxb:BarSubItem>
                <dxb:BarItemSeparator />
                <dxb:BarSubItem Content="Печать"
                                ToolTip="Печать"
                                LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                GlyphAlignment="Top"
                                BarItemDisplayMode="ContentAndGlyph"
                                IsEnabled="{Binding Path=SelectedOrder, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                    <dxb:BarButtonItem Content="Лист на сборку"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintAssemblyCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Расх. Накладная"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintAcceptanceProtocolCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Гар. талон"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintWarrantyCardCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="ТТН"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintTrackNumberCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Чек"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintChequeCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Хрупкое"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=DocumentCommands.PrintStickerFragileCommand, Mode=OneWay}">
                        <dxb:BarButtonItem.CommandParameter>
                            <MultiBinding Converter="{converters:PrintStickerParameterMultiValueConverter}">
                                <Binding Path="SelectedOrder.Carry.Id"
                                         Mode="OneWay"/>
                            </MultiBinding>
                        </dxb:BarButtonItem.CommandParameter>
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Вверх"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path= DocumentCommands.PrintStickerWayUpCommand, Mode=OneWay}">
                        <dxb:BarButtonItem.CommandParameter>
                            <MultiBinding Converter="{converters:PrintStickerParameterMultiValueConverter}">
                                <Binding Path="SelectedOrder.Carry.Id"
                                         Mode="OneWay"/>
                            </MultiBinding>
                        </dxb:BarButtonItem.CommandParameter>
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Акт принятия гос. товара"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintActIncomeCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Акт возврата гос. товара"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Command="{Binding Path=PrintActOutcomeCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedOrder, Mode=OneWay}" />
                </dxb:BarSubItem>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel AllowActivate="False"
                                      AllowContextMenu="False"
                                      AllowFloat="False"
                                      AllowHide="False"
                                      AllowMaximize="False"
                                      AllowMinimize="False"
                                      AllowMove="False"
                                      AllowRestore="False"
                                      AllowRename="False"
                                      AllowSizing="True"
                                      FloatOnDoubleClick="False"
                                      Padding="0"
                                      MinHeight="230"
                                      Style="{StaticResource PanelStyle}">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Orders, Mode=OneWay}"
                                         CurrentItem="{Binding Path=SelectedOrder, Mode=TwoWay}"
                                         ShowBorder="False"
                                         SelectionMode="None"
                                         AutoExpandAllGroups="True"
                                         CustomColumnGroup="GridOnCustomColumnGroup"
                                         CustomColumnDisplayText="GridOnCustomColumnDisplayText"
                                         DesignTimeDataObjectType="{x:Type viewModels:OrderViewItem}">
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="IsLongOperationInProgress" />
                                    <Binding Path="PrintChequeCommand.IsExecuting" />
                                    <Binding Path="PrintAcceptanceProtocolCommand.IsExecuting" />
                                    <Binding Path="PrintWarrantyCardCommand.IsExecuting" />
                                    <Binding Path="PrintTrackNumberCommand.IsExecuting" />
                                    <Binding Path="EditPaymentCommand.IsExecuting"/>
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="orders_6.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                                <behaviors:GridLayoutBehavior Layout="{Binding Path=FilterModuleLayoutService.Layout, Mode=OneWay}" />
                                <dxmvvm:EventToCommand EventName="CustomColumnSort"
                                                       Command="{Binding Path=HandleCustomColumnSortCommand, Mode=OneTime}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn Header="Заказ"
