<UserControl x:Class="Telemart.Client.Views.Store.Order.ScheduleDeliveriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             x:Name="CurrentUserControl"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             DataContext="{client:Container Type=viewModels:ScheduleDeliveriesViewModel}"
             Height="480"
             Width="1000"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ScheduleDeliveriesViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">

                <dxlc:LayoutItem Label="Диапазон доставки">
                    <dxe:ComboBoxEdit
                        EditValue="{Binding SelectedCourierDelivery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        ItemsSource="{Binding Path=CourierDeliveries, Mode=OneWay}"
                        DisplayMember="DisplayText"
                        NullValueButtonPlacement="EditBox"
                        Style="{StaticResource LookupComboBoxStyle}"
                        IsReadOnly="False" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Курьер">
                    <dxe:ComboBoxEdit
                        EditValue="{Binding SelectedCourierEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        ItemsSource="{Binding Path=CourierEmployees, Mode=OneWay}"
                        HorizontalContentAlignment="Left"
                        DisplayMember="DisplayValue"
                        ValueMember="Id"
                        NullValueButtonPlacement="EditBox"
                        Style="{StaticResource LookupComboBoxStyle}"
                        IsReadOnly="False" />
                </dxlc:LayoutItem>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Orders, ValidatesOnDataErrors=True, Mode=OneWay}"
                                 CurrentItem="{Binding SelectedScheduleDeliveryViewItem, Mode=TwoWay}"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 AllowDrop="False"
                                 SelectionMode="Cell"
                                 CopyingToClipboard="GridControl_OnCopyingToClipboard">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Заказ"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="OrderId"
                                        FixedWidth="True"
                                        AllowMoving="False"
                                        Width="60"
                                        AllowBestFit="False"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Адрес"
                                        FieldName="Address"
                                        FixedWidth="True"
                                        MinWidth="50"
                                        Width="150"
                                        MaxWidth="200"
                                        AllowBestFit="False"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowMoving="False"
                                        AllowAutoFilter="False"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Тел.клиента"
                                        FieldName="CustomerPhone"
                                        FixedWidth="True"
                                        AllowBestFit="False"
                                        AllowResizing="False"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        Width="100"
                                        MinWidth="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                      MaskType="Simple"
                                                      Mask="(000) 000-00-00"
                                                      MaskUseAsDisplayFormat="True"
                                                      MaskSaveLiteral="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Дата Х"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="DateX"
                                        FixedWidth="True"
                                        AllowEditing="True"
                                        AllowResizing="False"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowBestFit="False"
                                        AllowColumnFiltering="True"
                                        FilterPopupMode="Date"
                                        Width="75"
                                        GroupInterval="Date">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                      MaskUseAsDisplayFormat="True"
                                                      MinValue="{x:Static system:DateTime.Today}"
                                                      Mask="{x:Static business:DateFormattingRules.DateFormat}"
                                                      MaskType="DateTime" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Время ОТ"
                                        HeaderToolTip="Время доставки ОТ"
                                        FieldName="DeliveryTime"
                                        FixedWidth="True"
                                        Width="100"
                                        AllowResizing="False"
                                        AllowBestFit="False"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        AllowMoving="False"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Время ДО"
                                        HeaderToolTip="Время доставки ДО"
                                        FieldName="DeliveryTimeTo"
                                        FixedWidth="True"
                                        Width="100"
                                        AllowResizing="False"
                                        AllowBestFit="False"
                                        AllowGrouping="False"
                                        AllowMoving="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Диапазон"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        FieldName="SelectedCourierDelivery"
                                        ReadOnly="False"
                                        AllowMoving="False"
                                        IsEnabled="True"
                                        AllowEditing="True"
                                        HorizontalHeaderContentAlignment="Center"
                                        MinWidth="100"
                                        Width="140">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                      ItemsSource="{Binding Path=DataContext.CourierDeliveries, Mode=OneWay, ElementName=CurrentUserControl}"
                                                      DisplayMember="DisplayText"
                                                      HorizontalContentAlignment="Center" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Курьер"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        FieldName="SelectedCourierEmployeeId"
                                        ReadOnly="False"
                                        AllowMoving="False"
                                        IsEnabled="True"
                                        AllowEditing="True"
                                        HorizontalHeaderContentAlignment="Center"
                                        MinWidth="80"
                                        Width="130">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                      ItemsSource="{Binding Path=DataContext.CourierEmployees, Mode=OneWay, ElementName=CurrentUserControl}"
                                                      ValueMember="Id"
                                                      DisplayMember="DisplayValue"
                                                      HorizontalContentAlignment="Left" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Комментарий"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="Comment"
                                        FixedWidth="True"
                                        Width="150"
                                        MinWidth="50"
                                        AllowEditing="True"
                                        AllowBestFit="True"
                                        AllowSorting="False"
                                        AllowResizing="True"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings TextTrimming="CharacterEllipsis"
                                                      AcceptsReturn="False"
                                                      DisplayTextConverter="{converters:MultiLineToSingleLineTextConverter}"
                                                      ShowTooltipForTrimmedText="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowResizing="True"
                                       AllowPerPixelScrolling="True"
                                       ShowGroupPanel="False"
                                       AutoWidth="True"
                                       AllowEditing="False"
                                       ShowIndicator="False"
                                       AllowGrouping="False">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding Path=RowDoubleClickCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True">
                                </dxmvvm:EventToCommand>
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>

            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           HorizontalAlignment="Left"
                           Style="{StaticResource ImageStyle}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                            IsTabStop="True">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>