<controls:TelemartUserControl x:Class="Telemart.Client.Views.Dialogs.ChangeDateTimeView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:dialogs="clr-namespace:Telemart.Client.ViewModels.Dialogs"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:business="clr-namespace:Telemart.Client.Business"
                              DataContext="{client:Container Type=dialogs:ChangeDateTimeViewModel}"
                              Width="400"
                              Height="340"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type dialogs:ChangeDateTimeViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Старое значение">
                    <dxe:DateEdit EditValue="{Binding Path=OldDateTime, Mode=OneWay, ValidatesOnDataErrors=True}"
                                  MaskType="DateTime"
                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                  MaskUseAsDisplayFormat="True"
                                  Style="{StaticResource ReadOnlyDateEditorStyle}"/>

                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новое значение">
                    <dxe:DateEdit EditValue="{Binding Path=NewDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError = True}"
                                  MaskType="DateTime"
                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                  MaskUseAsDisplayFormat="True"
                                  IsTextEditable="False"
                                  EditValuePostMode="Immediate"
                                  ValidateOnTextInput="True"
                                  AllowRoundOutOfRangeValue="True">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:FocusBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxe:DateEdit.StyleSettings>
                            <dxe:DateEditNavigatorWithTimePickerStyleSettings />
                        </dxe:DateEdit.StyleSettings>
                    </dxe:DateEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Причина"
                                 LabelVerticalAlignment="Top"
                                 VerticalAlignment="Stretch">
                    <common:OrderChangeStateReasonsView Reasons="{Binding Path=ChangeReasons, Mode=OneWay}"
                                                        CurrentReason="{Binding Path=CurrentChangeReason, Mode=TwoWay}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий"
                                 LabelVerticalAlignment="Top"
                                 Height="80">
                    <dxe:TextEdit EditValue="{Binding Path=Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap"
                                  VerticalContentAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="80"
                                  Style="{StaticResource ReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneTime}"
                        IsTabStop="True"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=ValidationContainer, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        IsTabStop="True"
                        Command="{Binding Path=CancelCommand, Mode=OneTime}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>