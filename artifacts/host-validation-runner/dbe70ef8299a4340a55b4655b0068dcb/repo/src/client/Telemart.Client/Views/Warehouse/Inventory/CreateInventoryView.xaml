<UserControl x:Class="Telemart.Client.Views.Warehouse.Inventory.CreateInventoryView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:inventory="clr-namespace:Telemart.Client.ViewModels.Warehouse.Inventory"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             DataContext="{client:Container Type=inventory:CreateInventoryViewModel}"
             MinHeight="300"
             Height="485"
             MaxHeight="520"
             Width="500"
             MaxWidth="500"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type inventory:CreateInventoryViewModel}}"
             d:DesignHeight="520"
             d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Склады">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      DisplayMember="Name"
                                      EditValue="{Binding Path=SelectedWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Тип товара">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=InventoryProductTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedInventoryProductType, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMember="Name"
                                      IsTextEditable="False">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Категории"
                                 LabelVerticalAlignment="Top"
                                 IsEnabled="{Binding Path=CategoriesEnabled, Mode=OneWay}">
                    <dxg:GridControl ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                     ShowBorder="True"
                                     Height="300">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name"
                                            VisibleIndex="0" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TreeListView TreeDerivationMode="Selfreference"
                                              ShowColumnHeaders="False"
                                              AllowRecursiveNodeChecking="True"
                                              CheckBoxFieldName="Selected"
                                              ShowCheckboxes="True"
                                              NavigationStyle="Row"
                                              KeyFieldName="Id"
                                              ParentFieldName="ParentId"
                                              FilterMode="Extended"
                                              ShowSearchPanelMode="Always"
                                              SearchPanelHighlightResults="True"
                                              ExpandNodesOnFiltering="True"
                                              AllowEditing="False"
                                              AllowBestFit="True"
                                              AllowSorting="False"
                                              AllowDrop="False"
                                              ShowVerticalLines="False"
                                              ShowHorizontalLines="False"
                                              FetchSublevelChildrenOnExpand="False"
                                              ShowIndicator="False"
                                              TreeLineStyle="Solid"
                                              AutoWidth="True"
                                              ShowFilterPanelMode="Never"
                                              AutoExpandAllNodes="False"
                                              ShowExpandButtons="True"
                                              UseEvenRowBackground="False">
                                <dxg:TreeListView.FormatConditions>
                                    <dxg:FormatCondition Expression="[IsParent] = FALSE AND [IsBrand] = False">
                                        <dx:Format FontStyle="Italic" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] &lt; 0.5">
                                        <dx:Format Foreground="DarkGray" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] = 0">
                                        <dx:Format TextDecorations="Strikethrough" />
                                    </dxg:FormatCondition>
                                </dxg:TreeListView.FormatConditions>
                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий">
                    <dxe:MemoEdit EditValue="{Binding Path=Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="22"
                                  TextWrapping="Wrap"
                                  PopupMinWidth="200"
                                  PopupMaxWidth="500"
                                  MaxLength="100"
                                  AcceptsReturn="True"
                                  AcceptsTab="True"
                                  VerticalContentAlignment="Top"
                                  MemoVerticalScrollBarVisibility="Auto"
                                  MemoHorizontalScrollBarVisibility="Auto"
                                  MemoTextWrapping="Wrap"
                                  ShowIcon="False"
                                  ShowSizeGrip="True" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="WaitIndicatorLayoutGroup"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right">
                    <Button Content="Создать"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>