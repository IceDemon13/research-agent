<UserControl x:Class="Telemart.Client.Views.Store.Order.MoveProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             DataContext="{client:Container Type=viewModels:MoveProductViewModel}"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:MoveProductViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=IsVisible, Converter={dxmvvm:BooleanNegationConverter}, ElementName=WaitLayoutGroup}">
            <dxg:GridControl x:Name="ValidationGridControl"
                             ItemsSource="{Binding Path=ValidationItems, Mode=OneWay}"
                             Visibility="{Binding Path=ValidationItems, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter='True'}"
                             VerticalAlignment="Stretch">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header=" "
                                    FieldName="IsError"
                                    FixedWidth="True"
                                    AllowResizing="False"
                                    Width="24">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <dx:DXImage Source="{StaticResource WarningImage}"
                                                Visibility="{Binding Path=RowData.Row.IsError, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False, Inverse=True}}" />
                                    <dx:DXImage Source="{StaticResource ErrorImage}"
                                                Visibility="{Binding Path=RowData.Row.IsError, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Сообщение"
                                    FieldName="Message">
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowSorting="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}" />
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutGroup Orientation="Vertical"
                              Visibility="{Binding Path=ValidationItems, Converter={converters:ObjectToVisibilityConverter Negate=True}, ConverterParameter='True'}">
                <common:OrderProductsView OrderProducts="{Binding Path=OrderProducts, Mode=OneWay}"
                                          SelectedOrderProducts="{Binding Path=SelectedOrderProducts, Mode=OneWay}"
                                          ShowCheckBoxSelectorColumn="True"
                                          ShowBorder="True" />
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Orders, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Stretch"
                                 SelectionMode="None"
                                 CustomColumnSort="GridControl_OnCustomColumnSort">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Заказ"
                                        HeaderToolTip="Номер заказа"
                                        FieldName="Id"
                                        HorizontalHeaderContentAlignment="Center"
                                        FixedWidth="True"
                                        Width="70"
                                        SortMode="Custom">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical">
                                        <Label Content="{Binding Path=RowData.Row.Id, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               HorizontalContentAlignment="Center"
                                               Visibility="{Binding Path=RowData.Row.Id, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter='True'}" />
                                        <Button Visibility="{Binding Path=RowData.Row.Id, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter Negate=True}, ConverterParameter='True'}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Style="{StaticResource NoBordersButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="{dx:DXImage Image=Add_16x16.png}" />
                                                <TextBlock Text="Создать"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:ConfirmationBehavior Command="{Binding Path=DataContext.CreateOrderCommand, Mode=OneWay, ElementName=LayoutControl}"
                                                                             MessageText="Вы уверены, что хотите создать заказ?"
                                                                             MessageButton="YesNo"
                                                                             MessageIcon="Question" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="ФИО"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        FieldName="Fio"
                                        SortMode="Custom">
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Дата X"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        FieldName="DeliveryTime"
                                        HorizontalHeaderContentAlignment="Center"
                                        FixedWidth="True"
                                        MinWidth="24"
                                        Width="80"
                                        GroupInterval="Date"
                                        SortMode="Custom">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                      NullText=""
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{x:Static business:DateFormattingRules.ShortDateTimeFormat}"
                                                      MaskType="DateTime" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowResizing="False"
                                       AllowPerPixelScrolling="True"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding Path=OkCommand, Mode=OneWay}" />
                                <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                                                       Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="WaitLayoutGroup"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="CreateOrderCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <dxe:CheckEdit EditValue="{Binding Path=OpenOrders, Mode=TwoWay}"
                                   Content="Открыть заказы" />
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
