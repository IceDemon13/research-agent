<UserControl x:Class="Telemart.Client.Views.Money.Receive.BankPaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Money.Receive.BankPayment"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:BankPaymentsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:BankPaymentsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:OpenFileDialogService x:Name="ImportFromExcelFileDialogService"
                                      Title="Выберите Excel файл для импорта"
                                      AddExtension="True"
                                      RestorePreviouslySelectedDirectory="True"
                                      Filter="Excel Workbook|*.xlsx"
                                      CheckFileExists="True"
                                      CheckPathExists="True" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Top"
                          ItemSpace="0">
            <dxb:BarManager>
                <dxb:ToolBarControl>
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Загрузить"
                                       ToolTip="Загрузить"
                                       LargeGlyph="../../../Images/Common/table_insert.png"
                                       Command="{Binding Path=ImportCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Распознать"
                                       ToolTip="Распознать"
                                       LargeGlyph="../../../Images/Common/google_custom_search_32x32.png"
                                       Command="{Binding Path=RecognizeCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Экспорт"
                                       ToolTip="Экспортировать в Excel"
                                       LargeGlyph="/Images/Parser/excel_32_32.png"
                                       Command="{Binding Path=ExportExcelCommand, Mode=OneTime}"/>
                    <dxb:BarButtonItem Content="Импорт"
                                       ToolTip="Импортировать из Excel"
                                       LargeGlyph="/Images/ProductsCatalog/folder_table_32x32.png"
                                       Command="{Binding Path=ImportExcelCommand, Mode=OneTime}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarSubItem Content="Обработать"
                                    Glyph="{StaticResource Lightning32}"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top">
                        <dxb:BarButtonItem Content="Провести ДС"
                                           ToolTip="Провести ДС (F9)"
                                           Glyph="../../../Images/Common/tick.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=ProcessCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Не учитывать"
                                           ToolTip="Не учитывать"
                                           Glyph="../../../Images/Common/canceled.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=IgnoreCommand, Mode=OneTime}" />
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0"
                              Margin="0">
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Padding="0"
                                  MinHeight="230"
                                  Style="{StaticResource PanelStyle}">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Payments, Mode=OneWay}"
                                     SelectedItems="{Binding Path=SelectedPayments, Mode=OneWay}"
                                     CurrentItem="{Binding Path=CurrentPayment, Mode=TwoWay}"
                                     ShowBorder="False"
                                     SelectionMode="Row"
                                     AutoExpandAllGroups="True"
                                     ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}"
                                     CopyingToClipboard="OnCopyingToClipboard">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="bank_payments_5.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Заказ"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="OrderId"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="True"
                                            AllowEditing="True"
                                            AllowColumnFiltering="False"
                                            AllowMoving="False"
                                            FixedWidth="True"
                                            MinWidth="48"
                                            Width="60"
                                            MaxWidth="65">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit HorizontalContentAlignment="Center"
                                                      x:Name="PART_Editor"
                                                      IsEnabled="{Binding RowData.Row.AllowEdit}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ParsedOrderId"
                                            Visible="False"
                                            ShowInColumnChooser="False" />
                            <dxg:GridColumn Header="Назначение"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Comment"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            AllowMoving="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings TextWrapping="Wrap" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="PaidOn"
                                            MinWidth="85"
                                            Width="89"
                                            MaxWidth="90"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowAutoFilter="False"
                                            AllowSorting="True"
                                            GroupInterval="Date"
                                            AllowMoving="False"
                                            FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Сумма"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Amount"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowSorting="False"
                                            AllowMoving="False"
                                            FixedWidth="True"
                                            Width="50"
                                            AllowColumnFiltering="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit x:Name="PART_Editor"
                                                      HorizontalContentAlignment="Left"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="C2"
                                                      MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                                      MaskSaveLiteral="False"
                                                      MinValue="0"
                                                      IsFloatValue="False"
                                                      AllowDefaultButton="False"
                                                      IsReadOnly="True" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Валюта"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="CurrencyId"
                                            MinWidth="35"
                                            Width="59"
                                            MaxWidth="65"
                                            AllowBestFit="False"
                                            AllowGrouping="True"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Currencies, Mode=OneWay}"
                                                              HorizontalContentAlignment="Center"
                                                              DisplayMember="Title"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Касса"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="CashboxId"
                                            FixedWidth="True"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="False"
                                            AllowSorting="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            GroupIndex="0">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Контрагент"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="ContractorName"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings TextWrapping="Wrap" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Референс"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Reference"
                                            FixedWidth="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False" />
                            <dxg:GridColumn Header="Ответственный"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="CompletedBy"
                                            FixedWidth="True"
                                            Width="100"
                                            MinWidth="24"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="StateId"
                                            FixedWidth="True"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            AllowMoving="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding States, Mode=OneWay}"
                                                              DisplayMember="Name"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="C"
                                            HeaderToolTip="Статус обработки"
                                            Width="24"
                                            FixedWidth="True"
                                            AllowMoving="False"
                                            AllowResizing="False"
                                            AllowSorting="False"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    Margin="0 2 0 0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding RowData.Row.IsProcessed, Converter={dx:BooleanToVisibilityConverter}}">
                                            <dx:DXImage Source="../../../Images/Common/tick.png"
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ToolTipService.ToolTip="Все ОК"
                                                        Visibility="{Binding Path=RowData.Row.IsError, Converter={dx:BooleanToVisibilityConverter Invert=True}}" />
                                            <dx:DXImage Source="../../../Images/warning.png"
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ToolTipService.ToolTip="{Binding Path=RowData.Row.ErrorMessage}"
                                                        Visibility="{Binding Path=RowData.Row.IsError, Converter={dx:BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Ошибка при обработке"
                                            HeaderToolTip="Ошибка при обработке"
                                            FieldName="LastError"
                                            MinWidth="24"
                                            Width="100"
                                            MaxWidth="120"
                                            AllowEditing="False"
                                            FixedWidth="False"
                                            AllowMoving="True"
                                            AllowResizing="True"
                                            AllowSorting="False"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="2 2 0 0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <dx:DXImage Source="{StaticResource ErrorImage}"
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ToolTipService.ToolTip="{Binding Path=RowData.Row.LastError}"
                                                        Visibility="{Binding Path=RowData.Row.VisibleLastError, Converter={dx:BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding RowData.Row.LastError}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Background="Transparent"
                                                           TextWrapping="Wrap"
                                                           Foreground="Black"
                                                           MaxWidth="100"
                                                           Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowEditing="False"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           IsTotalSummaryMenuEnabled="False"
                                           ShowTotalSummary="False"
                                           AllowGrouping="True"
                                           AllowBestFit="False"
                                           EnableImmediatePosting="True"
                                           ShowCheckBoxSelectorColumn="True"
                                           RetainSelectionOnClickOutsideCheckBoxSelector="True"
                                           CheckBoxSelectorColumnWidth="20"
                                           CustomCellAppearance="TableViewOnCustomCellAppearance"
                                           AllowCommitOnValidationAttributeError="True"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition Expression="[ParsedOrderId] Is Null Or [ParsedOrderId] &lt;&gt; [OrderId]"
                                                         FieldName="OrderId">
                                        <dx:Format Background="{StaticResource PinkColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                        </dxg:GridControl.GroupSummary>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Создан">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/calendar.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      VerticalAlignment="Center">
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.CreatedFrom, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        <TextBlock Text="-"
                                                   Width="8"
                                                   TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.CreatedTo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Заказ">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/cart.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.OrderIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Statuses, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      EditValue="{Binding Path=Filter.SelectedStatuses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}"
                                                      ValueMember="Id">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Касса">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/NavigationMenu/cash_stack.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Cashboxes, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedCashboxes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="DisplayValue"
                                                      Style="{StaticResource TokenComboBoxStyle}"
                                                      ValueMember="Id">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Платежей">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Payments.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>
</UserControl>