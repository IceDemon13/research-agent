<UserControl x:Class="Telemart.Client.Views.Directories.ProductsCatalog.ProductsCatalogView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:themes="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:helpers="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsCatalog"
             DataContext="{client:Container Type=viewModels:ProductsCatalogViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductsCatalogViewModel}}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ProductCatalogActivityState.xaml" />
                <ResourceDictionary>
                    <converters:ComboBoxItemsConverter x:Key="ComboBoxItemsConverter" />

                    <dxmvvm:ObjectToObjectConverter x:Key="FilterTypeToImageSourceConverter"
                                                    DefaultTarget="/Images/Common/filter_32x32.png">
                        <dxmvvm:MapItem Source="{x:Static viewModels:ProductsCatalogFilterType.Changed}"
                                        Target="/Images/Common/filter_pencil_32x32.png" />
                        <dxmvvm:MapItem Source="{x:Static viewModels:ProductsCatalogFilterType.WithErrors}"
                                        Target="/Images/Common/filter_error_32x32.png" />
                    </dxmvvm:ObjectToObjectConverter>

                    <DataTemplate x:Key="ColorItemTemplate">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                            <Ellipse Fill="{Binding Path=Color, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}}"
                                     Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                     Stroke="Gray"
                                     StrokeThickness="0.5"
                                     Margin="3 0 0 0"
                                     Width="14"
                                     Height="14" />
                            <Label Content="{Binding Path=Name, Mode=OneWay}"
                                   Background="Transparent"
                                   Padding="0,0,0,0"
                                   Margin="5,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />

        <dxmvvm:OpenFileDialogService x:Name="ImportFromExcelFileDialogService"
                                      Title="Выберите Excel файл для импорта"
                                      AddExtension="True"
                                      RestorePreviouslySelectedDirectory="True"
                                      Filter="Excel Workbook|*.xlsx"
                                      CheckFileExists="True"
                                      CheckPathExists="True" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Orientation="Vertical"
                        ItemSpace="0"
                        Padding="0">
        <dxlc:LayoutGroup>
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl AllowQuickCustomization="False"
                                    AllowCustomizationMenu="False"
                                    IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding ElementName=GridControl, Path=View}" />
                    <dxb:BarSubItem  Content="Фильтр"
                                     ToolTip="{Binding Path=FilterType, Converter={converters:EnumToDisplayTextConverter}}"
                                     BarItemDisplayMode="ContentAndGlyph"
                                     GlyphAlignment="Top"
                                     LargeGlyph="{Binding Path=FilterType, Converter={StaticResource FilterTypeToImageSourceConverter}}">
                        <dxb:BarCheckItem Content="Все"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=FilterType, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:ProductsCatalogFilterType.All}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding Path=SetFilterTypeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:ProductsCatalogFilterType.All}" />
                        <dxb:BarCheckItem Content="Измененные"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=FilterType, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:ProductsCatalogFilterType.Changed}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding Path=SetFilterTypeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:ProductsCatalogFilterType.Changed}" />
                        <dxb:BarCheckItem Content="С ошибками"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=FilterType, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:ProductsCatalogFilterType.WithErrors}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding Path=SetFilterTypeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:ProductsCatalogFilterType.WithErrors}" />
                    </dxb:BarSubItem>
                    <dxb:BarButtonItem Content="Сохранить"
                                       ToolTip="Сохранить в БД (Ctrl+S)"
                                       LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                       Command="{Binding Path=SaveCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Добавить"
                                       ToolTip="Добавить (Insert)"
                                       LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                       Command="{Binding Path=AddCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Клонировать"
                                       ToolTip="Клонировать (Alt+Insert)"
                                       LargeGlyph="{dx:DXImage Image=Copy_32x32.png}"
                                       Command="{Binding Path=CloneCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Удалить"
                                       ToolTip="Удалить (Alt+D)"
                                       LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                       Command="{Binding Path=RemoveCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=SelectedProduct, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Сброс"
                                       ToolTip="Установка наследуемых значений по-умолчанию (Alt+R)"
                                       LargeGlyph="/Images/ProductsCatalog/arrow_undo_32x32.png"
                                       Command="{Binding Path=ResetCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=SelectedProduct, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Экспорт"
                                       ToolTip="Экспортировать в Excel (Alt+E)"
                                       LargeGlyph="/Images/Parser/excel_32_32.png"
                                       Command="{Binding Path=ExportCommand, Mode=OneWay}"
                                       CommandParameter="{Binding ElementName=TableView}" />
                    <dxb:BarButtonItem Content="Импорт"
                                       ToolTip="Импортировать из Excel (Alt+I)"
                                       LargeGlyph="/Images/ProductsCatalog/folder_table_32x32.png"
                                       Command="{Binding Path=ImportCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Padding="0"
                                  Margin="0">
                    <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                      AllowSizing="True">
                        <dxg:GridControl x:Name="GridControl"
                                         ImplyNullLikeEmptyStringWhenFiltering="True"
                                         ItemsSource="{Binding Path=ProductsView, Mode=OneWay}"
                                         CurrentItem="{Binding Path=SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}"
                                         SelectionMode="None"
                                         AutoExpandAllGroups="True"
                                         ShowBorder="False"
                                         PreviewKeyDown="GridControl_PreviewKeyDown"
                                         PropertyChanged="GridControlPropertyChanged"
                                         DesignTimeDataObjectType="viewModels:ProductCatalogViewItemWrapper"
                                         DesignTimeDataSourceRowCount="16"
                                         DesignTimeUseDistinctSampleValues="True"
                                         DesignTimeShowSampleData="True">
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="RefreshCommand.IsExecuting" />
                                    <Binding Path="HandleLoadedCommand.IsExecuting" />
                                    <Binding Path="SaveCommand.IsExecuting" />
                                    <Binding Path="ImportCommand.IsExecuting" />
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="products_catalog1.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="IsEditingOvertimed"
                                                Header="П"
                                                HeaderToolTip="Проверка"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                MinWidth="26"
                                                Width="26"
                                                AllowResizing="False"
                                                AllowGrouping="False"
                                                AllowMoving="False"
                                                AllowColumnFiltering="False"
                                                AllowSorting="False"
                                                AllowPrinting="False"
                                                ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxlc:LayoutGroup Orientation="Horizontal"
                                                              ItemSpace="0">
                                                <dx:DXImage Width="16"
                                                            Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Source="../../../Images/CategoryOptions/pencil.png"
                                                            Visibility="{Binding Path=RowData.Row.IsEdited, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                </dx:DXImage>
                                            </dxlc:LayoutGroup>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Id"
                                                x:Name="Id"
                                                Header="Код"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                AllowEditing="False"
                                                MinWidth="40"
                                                Width="70"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Category"
                                                Header="Категория"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                FixedWidth="True"
                                                MinWidth="50"
                                                Width="80"
                                                AllowEditing="True"
                                                AllowPrinting="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AutoFilterCondition="Contains">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <dxe:TextEdit x:Name="PART_Editor"
                                                              EditValue="{Binding Path=RowData.Row.Category.Name}" />
                                                <dx:SimpleButton Grid.Column="1"
                                                                 Command="{Binding Path=DataContext.GetCategoryCommand, Mode=OneWay, ElementName=CurrentUserControl}"
                                                                 Content="..."
                                                                 Width="20"
                                                                 MinWidth="20"
                                                                 Height="20"
                                                                 Padding="1"
                                                                 Visibility="{Binding Path=RowData.Row.IsNew, Converter={dx:BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Category.Id"
                                                x:Name="CategoryId"
                                                Header="Код категории"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowMoving="True"
                                                FixedWidth="True"
                                                MinWidth="50"
                                                Width="80"
                                                Visible="False"
                                                VisibleIndex="-1"
                                                AllowEditing="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="Value"
                                                AutoFilterCondition="Contains">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Manufactor"
                                                x:Name="Manufactor"
                                                Header="Вендор"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="50"
                                                Width="65"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AutoFilterCondition="Contains">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.Manufactor"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.Manufactor"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PrefixRus"
                                                x:Name="PrefixRus"
                                                Header="Префикс (рус)"
                                                Image="../../../Images/Common/russian_flag.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="85"
                                                Visible="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.PrefixRus"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.PrefixRus"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PrefixUkr"
                                                x:Name="PrefixUkr"
                                                Header="Префикс (укр)"
                                                Image="../../../Images/Common/ukrainian_flag.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                Visible="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.PrefixUkr"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.PrefixUkr"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PrefixEn"
                                                x:Name="PrefixEn"
                                                Header="Префикс (англ)"
                                                Image="../../../Images/Common/flag_great_britain.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                Visible="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.PrefixEn"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.PrefixEn"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Name"
                                                x:Name="Name"
                                                Header="Название"
                                                Image="../../../Images/Common/russian_flag.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                            <Binding  Path="RowData.Row.IsEditingOvertimed"
                                                                      Mode="OneWay" />
                                                            <Binding Path="DataContext.IsAllowEditProductNameAnyTime"
                                                                     Mode="OneWay"
                                                                     Converter="{dxmvvm:BooleanNegationConverter}"
                                                                     ElementName="CurrentUserControl" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground"
                                                            Value="DarkGray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="NameUkr"
                                                x:Name="NameUkr"
                                                Header="Название (укр.)"
                                                Image="../../../Images/Common/ukrainian_flag.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                            <Binding  Path="RowData.Row.IsEditingOvertimed"
                                                                      Mode="OneWay" />
                                                            <Binding Path="DataContext.IsAllowEditProductNameAnyTime"
                                                                     Mode="OneWay"
                                                                     Converter="{dxmvvm:BooleanNegationConverter}"
                                                                     ElementName="CurrentUserControl" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground"
                                                            Value="DarkGray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="NameEn"
                                                x:Name="NameEn"
                                                Header="Название (англ)"
                                                Image="../../../Images/Common/flag_great_britain.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                            <Binding  Path="RowData.Row.IsEditingOvertimed"
                                                                      Mode="OneWay" />
                                                            <Binding Path="DataContext.IsAllowEditProductNameAnyTime"
                                                                     Mode="OneWay"
                                                                     Converter="{dxmvvm:BooleanNegationConverter}"
                                                                     ElementName="CurrentUserControl" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground"
                                                            Value="DarkGray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Model"
                                                x:Name="Model"
                                                Header="Модель"
                                                Image="../../../Images/Common/russian_flag.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ModelUkr"
                                                Name="ModelUkr"
                                                Header="Модель (укр.)"
                                                Image="../../../Images/Common/ukrainian_flag.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False" />
                                <dxg:GridColumn FieldName="ModelEn"
                                                Name="ModelEn"
                                                Header="Модель (англ)"
                                                Image="../../../Images/Common/flag_great_britain.png"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False" />
                                <dxg:GridColumn FieldName="Modific"
                                                x:Name="Modific"
                                                Header="Модификация"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                Visible="False"
                                                AllowEditing="False"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="100"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Setter Property="Foreground"
                                                    Value="DarkGray"/>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="GroupName"
                                                FieldName="GroupName"
                                                Header="Группа"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="100"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="GroupFeatureId"
                                                Header="Характеристика группы"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                FixedWidth="True"
                                                MinWidth="50"
                                                Width="100"
                                                AllowEditing="True"
                                                AllowPrinting="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AutoFilterCondition="Contains">
                                    <dxg:GridColumn.EditTemplate>
                                        <ControlTemplate>
                                            <dxe:ComboBoxEdit EditValue="{Binding RowData.Row.GroupFeatureId}"
                                                              ItemsSource="{Binding Path=DataContext.Features, ElementName=CurrentUserControl}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              NullValueButtonPlacement="EditBox"
                                                              ShowBorder="False"/>
                                        </ControlTemplate>
                                    </dxg:GridColumn.EditTemplate>

                                    <dxg:GridColumn.DisplayTemplate>
                                        <ControlTemplate>
                                            <dxe:ComboBoxEdit EditValue="{Binding RowData.Row.GroupFeatureId}"
                                                              ItemsSource="{Binding Path=DataContext.AllFeatures, ElementName=CurrentUserControl}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              AllowDefaultButton="False"
                                                              ShowBorder="False"/>
                                        </ControlTemplate>
                                    </dxg:GridColumn.DisplayTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="GroupFeatureId"
                                                FieldName="GroupFeatureId"
                                                Header="Код характеристики группы"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowMoving="True"
                                                FixedWidth="True"
                                                MinWidth="50"
                                                Width="80"
                                                Visible="False"
                                                VisibleIndex="-1"
                                                AllowEditing="False"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="Value"
                                                AutoFilterCondition="Contains">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Color"
                                                x:Name="Color"
                                                Header="Цвет"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="30"
                                                Width="80"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                AllowMoving="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ColorPrimary"
                                                x:Name="ColorPrimary"
                                                Header="Цвет 1"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="21"
                                                Width="80"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="True"
                                                ColumnFilterMode="DisplayText"
                                                FilterPopupMode="CheckedList"
                                                AllowMoving="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                              ItemsSource="{Binding Path=DataContext.ProductColors, Mode=OneWay, ElementName=CurrentUserControl}"
                                                              Width="{Binding Path=ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxg:LightweightCellEditor}}}"
                                                              DisplayMember="Name"
                                                              EditMode="InplaceActive"
                                                              EditValuePostMode="Immediate"
                                                              ItemTemplate="{StaticResource ColorItemTemplate}"
                                                              Style="{StaticResource SearchableComboBoxStyle}">
                                                <dxe:ComboBoxEdit.EditTemplate>
                                                    <ControlTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent">
                                                            <Ellipse Fill="{Binding Path=RowData.Row.ColorPrimary.Color, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}, PresentationTraceSources.TraceLevel=High}"
                                                                     Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                                     Stroke="Gray"
                                                                     StrokeThickness="0.5"
                                                                     Margin="3 0 0 0"
                                                                     Width="14"
                                                                     Height="14" />
                                                            <TextBox x:Name="PART_Editor"
                                                                     Style="{DynamicResource {themes:TextEditThemeKey ResourceKey=TextStyle}}"
                                                                     helpers:EditorMarginHelper.Margin="2,2,2,2,0,2,2,2" />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </dxe:ComboBoxEdit.EditTemplate>
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ColorSecondary"
                                                x:Name="ColorSecondary"
                                                Header="Цвет 2"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="21"
                                                Width="80"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="True"
                                                ColumnFilterMode="DisplayText"
                                                FilterPopupMode="CheckedList"
                                                AllowMoving="True">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                              ItemsSource="{Binding Path=DataContext.ProductColors, Mode=OneWay, ElementName=CurrentUserControl}"
                                                              Width="{Binding Path=ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxg:LightweightCellEditor}}}"
                                                              DisplayMember="Name"
                                                              EditMode="InplaceActive"
                                                              EditValuePostMode="Immediate"
                                                              ItemTemplate="{StaticResource ColorItemTemplate}"
                                                              Style="{StaticResource SearchableComboBoxStyle}">
                                                <dxe:ComboBoxEdit.EditTemplate>
                                                    <ControlTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent">
                                                            <Ellipse Fill="{Binding Path=RowData.Row.ColorSecondary.Color, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}, PresentationTraceSources.TraceLevel=High}"
                                                                     Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                                     Stroke="Gray"
                                                                     StrokeThickness="0.5"
                                                                     Margin="3 0 0 0"
                                                                     Width="14"
                                                                     Height="14" />
                                                            <TextBox x:Name="PART_Editor"
                                                                     Style="{DynamicResource {themes:TextEditThemeKey ResourceKey=TextStyle}}"
                                                                     helpers:EditorMarginHelper.Margin="2,2,2,2,0,2,2,2" />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </dxe:ComboBoxEdit.EditTemplate>
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PartNumber"
                                                x:Name="PartNumber"
                                                Header="Артикул"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="90"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                              Mask="\P{Ll}*"
                                                              MaskType="RegEx"
                                                              MaskUseAsDisplayFormat="False" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Keywords"
                                                x:Name="Keywords"
                                                Header="Ключ"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="70"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                              Mask="(\P{Lu}|\d)+"
                                                              MaskType="RegEx"
                                                              MaskUseAsDisplayFormat="False" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="YandexId"
                                                x:Name="YandexId"
                                                Header="YandexId"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="TypeId"
                                                x:Name="TypeId"
                                                Header="Тип товара"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=ProductTypes, Mode=OneWay}"
                                                                  DisplayMember="Name"
                                                                  ValueMember="Id" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="WarrantyRetailId"
                                                x:Name="WarrantyRetailId"
                                                Header="Гар. (розн)"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Warranties, Mode=OneWay}"
                                                                  DisplayMember="Name"
                                                                  ValueMember="Id" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.WarrantyRetailId"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.WarrantyRetailId"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="WarrantyWholesaleId"
                                                x:Name="WarrantyWholesaleId"
                                                Header="Гар. (опт)"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Warranties, Mode=OneWay}"
                                                                  DisplayMember="Name"
                                                                  ValueMember="Id" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.WarrantyWholesaleId"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.WarrantyWholesaleId"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="WarrantyTypeId"
                                                x:Name="WarrantyTypeId"
                                                Header="Тип гарантии"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="80"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=WarrantyTypes, Mode=OneWay}"
                                                                  DisplayMember="Name"
                                                                  ValueMember="Id" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor"
                                               BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{converters:IsDifferentValuesConverter}">
                                                            <Binding Path="RowData.Row.WarrantyTypeId"
                                                                     Mode="OneWay" />
                                                            <Binding Path="RowData.Row.Category.WarrantyTypeId"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="TextBlock.FontStyle"
                                                            Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                               
                                <dxg:GridColumn FieldName="ActiveExpected"
                                                Header="Акт"
                                                HeaderToolTip="Активен"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                MinWidth="48"
                                                Width="48"
                                                AllowPrinting="False"
                                                AllowEditing="True"
                                                AllowResizing="False"
                                                AllowGrouping="False"
                                                AllowMoving="False"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings IsThreeState="True"
                                                               DisplayFormat="F1" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxlc:LayoutGroup Orientation="Horizontal"
                                                              ItemSpace="0">
                                                <dxe:ErrorControl Content="{Binding Path=ValidationError.ErrorContent, ElementName=ActiveEdit}"
                                                                  ToolTip="{Binding Path=ValidationError.ErrorContent, ElementName=ActiveEdit}"
                                                                  Width="24"
                                                                  Visibility="{Binding Path=HasValidationError, ElementName=ActiveEdit, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                                <dxe:CheckEdit x:Name="ActiveEdit"
                                                               IsChecked="{Binding Path=RowData.Row.ActiveExpected, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                                               HorizontalAlignment="Center"
                                                               IsThreeState="True">
                                                    <dxe:CheckEdit.Template>
                                                        <ControlTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <!--<dxe:ErrorControl x:Name="PART_ErrorPresenter" />-->
                                                                <dxe:EditorControl x:Name="PART_Content"
                                                                                   Template="{Binding Path=(dxe:BaseEdit.OwnerEdit).ActualEditorControlTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </dxe:CheckEdit.Template>
                                                    <dxe:CheckEdit.Visibility>
                                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                            <Binding Path="RowData.Row.IsNew"
                                                                     Mode="OneWay" />
                                                        </MultiBinding>
                                                    </dxe:CheckEdit.Visibility>
                                                </dxe:CheckEdit>
                                                <dx:DXImage x:Name="WaitingForActivationImage"
                                                            Width="16"
                                                            Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding Path=RowData.Row.ActivityState.Name}"
                                                            Source="{Binding Path=RowData.Row.ActivityState.Id, Converter={StaticResource ProductCatalogActivityStateImageConverter}}"
                                                            Visibility="{Binding Path=RowData.Row.IsNew, Converter={dx:BooleanToVisibilityConverter Invert=True}}">
                                                </dx:DXImage>

                                            </dxlc:LayoutGroup>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="TableView"
                                               EditorButtonShowMode="ShowAlways"
                                               ImmediateUpdateRowPosition="False"
                                               RetainSelectionOnClickOutsideCheckBoxSelector="True"
                                               AllowSorting="{Binding Path=AllowSorting, Mode=OneWay}"
                                               EnableImmediatePosting="True"
                                               AutoWidth="True"
                                               ShowIndicator="False"
                                               AllowEditing="True"
                                               NavigationStyle="Cell"
                                               AllowFilterEditor="False"
                                               ShowFilterPanelMode="Default"
                                               ShowAutoFilterRow="False"
                                               ShowFixedTotalSummary="False"
                                               IsTotalSummaryMenuEnabled="True"
                                               ShowTotalSummary="False"
                                               AllowGrouping="True"
                                               AllowLeaveInvalidEditor="True"
                                               AllowCommitOnValidationAttributeError="True"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               EditorShowMode="MouseDownFocused"
                                               ShownEditor="TableView_ShownEditor"
                                               PrintAutoWidth="True">
                                    <!--AllowMoveColumnToDropArea="False"-->
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="ShowingEditor"
                                                               Command="{Binding Path=HandleShowingEditorCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand EventName="Loaded"
                                                               Command="{Binding Path=HandleTableViewLoadedCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                    <dxdo:LayoutPanel Caption="Поиск"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      AllowHide="True"
                                      FloatOnDoubleClick="False"
                                      MinWidth="300"
                                      MaxWidth="500"
                                      ItemWidth="400">
                        <dxlc:LayoutControl Orientation="Vertical"
                                            ItemStyle="{StaticResource LayoutItemStyle}"
                                            IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxlc:LayoutItem Label="Название">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Parser/book_16_16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=Filter.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Наличие">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/package.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.AvailTypes, Mode=OneWay}"
                                                  DisplayMember="DisplayValue"
                                                  EditValue="{Binding Path=Filter.SelectedAvailTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ComboBoxItemsConverter}}"
                                                  Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Категория"
                                             LabelPosition="Left"
                                             LabelVerticalAlignment="Top"
                                             VerticalAlignment="Stretch">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Parser/folders_16_16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <commonViews:CategoryTreeView Categories="{Binding Path=Filter.Categories, Mode=OneWay}"
                                                              SelectedCategory="{Binding Path=Filter.SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionMode="None"
                                                              ShowBorder="True"
                                                              ShowLoadingPanel="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </commonViews:CategoryTreeView>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Товаров"
                                             VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=Products.Count, Mode=OneWay, FallbackValue=0}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal"
                                                 VerticalAlignment="Bottom" />
                            <dxlc:LayoutItem VerticalAlignment="Bottom">
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       GlyphAlignment="Left"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       GlyphAlignment="Left"
                                                       Command="{Binding Path=ResetFilterCommand, Mode=OneWay}" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>