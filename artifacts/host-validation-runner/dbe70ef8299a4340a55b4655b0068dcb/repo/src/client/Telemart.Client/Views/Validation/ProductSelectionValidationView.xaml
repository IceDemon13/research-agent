<UserControl x:Class="Telemart.Client.Views.Validation.ProductSelectionValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Validation"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             Loaded="OnLoaded"
             Width="550"
             DataContext="{client:Container Type=viewModels:ProductSelectionValidationViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductSelectionValidationViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:EventToCommand EventName="Unloaded"
                               Command="{Binding Path=HandleUnloadedCommand, Mode=OneTime}" />
        <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                               Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneTime}"
                               PassEventArgsToCommand="True" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        dxe:ValidationService.IsValidationContainer="True"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxlc:LayoutGroup Orientation="Vertical">
            <dxlc:LayoutItem Label="Товар">
                <TextBlock Text="{Binding Path=ProductName, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           FontWeight="SemiBold">
                </TextBlock>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="ШК"
                             Visibility="{Binding Path=NewBarcode, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                <TextBlock Text="{Binding Path=NewBarcode, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           FontWeight="SemiBold">
                </TextBlock>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Ошибки"
                             LabelVerticalAlignment="Top"
                             Visibility="{Binding Path=HasValidationItems, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                             Height="44">
                <dxg:GridControl ItemsSource="{Binding Path=Items, Mode=OneWay}"
                                 DesignTimeDataObjectType="{x:Type viewModels:ValidationResultItem}"
                                 DesignTimeDataSourceRowCount="1">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header=" "
                                        FieldName="IsError"
                                        FixedWidth="True"
                                        AllowResizing="False"
                                        Width="24">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <dx:DXImage Source="{StaticResource WarningImage}"
                                                    Visibility="{Binding Path=RowData.Row.IsError, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False, Inverse=True}}" />
                                        <dx:DXImage Source="{StaticResource ErrorImage}"
                                                    Visibility="{Binding Path=RowData.Row.IsError, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Предупреждения"
                                        FieldName="Message">
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowSorting="False"
                                       Style="{StaticResource ReadOnlyTableViewStyle}"
                                       ShowColumnHeaders="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="{Binding Path=OkContent, Mode=OneWay}"
                    IsEnabled="{Binding Path=OkIsEnabled, Mode=OneWay}"
                    Visibility="{Binding Path=HasErrors, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                    Command="{Binding Path=OkCommand, Mode=OneTime}"
                    IsTabStop="True" />
            <Button x:Name="NoButton"
                    Content="Нет (N)"
                    Visibility="{Binding Path=HasErrors, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                    Command="{Binding Path=NoCommand, Mode=OneTime}"
                    IsTabStop="True" />
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneTime}"
                    IsTabStop="True" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>
