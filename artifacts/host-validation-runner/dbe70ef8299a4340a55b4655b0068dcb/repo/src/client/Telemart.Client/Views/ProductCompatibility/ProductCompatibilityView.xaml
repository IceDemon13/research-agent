<UserControl x:Class="Telemart.Client.Views.ProductCompatibility.ProductCompatibilityView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.ProductCompatibility"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             DataContext="{client:Container Type=viewModels:ProductCompatibilityViewModel}"
             Width="665"
             Height="482"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductCompatibilityViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="{Binding Path=SlaveProductLabel, Mode=OneWay}"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxWithHeaderStyle}">
                    <dxlc:LayoutItem Label="Категория">
                        <dxg:LookUpEdit ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                        EditValue="{Binding Path=Model.SlaveCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        DisplayMember="Name"
                                        ValueMember="Id"
                                        AutoPopulateColumns="False"
                                        AutoComplete="False"
                                        IncrementalFiltering="True"
                                        FilterCondition="Like"
                                        FindMode="Always"
                                        ImmediatePopup="True"
                                        IsPopupAutoWidth="True"
                                        InvalidValueBehavior="AllowLeaveEditor"
                                        Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                        IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                        PopupContentTemplate="{StaticResource LookUpEditCategoryControlTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="Validate"
                                                       Command="{Binding Path=CategoryValidateCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.StyleSettings>
                                <dxg:SearchLookUpEditStyleSettings />
                            </dxg:LookUpEdit.StyleSettings>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Хар-ка">
                        <dxg:LookUpEdit ItemsSource="{Binding Path=SlaveFeatures, Mode=OneWay}"
                                        EditValue="{Binding Path=Model.SlaveFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        DisplayMember="DisplayValue"
                                        AutoPopulateColumns="False"
                                        AutoComplete="False"
                                        IncrementalFiltering="True"
                                        FilterCondition="Like"
                                        FindMode="Always"
                                        ImmediatePopup="True"
                                        IsPopupAutoWidth="True"
                                        InvalidValueBehavior="AllowLeaveEditor"
                                        Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                        PopupContentTemplate="{StaticResource FeatureControlTemplate}"
                                        IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="Validate"
                                                       Command="{Binding Path=FeatureValidateCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.StyleSettings>
                                <dxg:SearchLookUpEditStyleSettings />
                            </dxg:LookUpEdit.StyleSettings>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="{Binding Path=MasterProductLabel, Mode=OneWay}"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxWithHeaderStyle}">
                    <dxlc:LayoutItem Label="Категория">
                        <dxg:LookUpEdit ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                        EditValue="{Binding Path=Model.MasterCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        DisplayMember="Name"
                                        ValueMember="Id"
                                        AutoPopulateColumns="False"
                                        AutoComplete="False"
                                        IncrementalFiltering="True"
                                        FilterCondition="Like"
                                        FindMode="Always"
                                        ImmediatePopup="True"
                                        IsPopupAutoWidth="True"
                                        InvalidValueBehavior="AllowLeaveEditor"
                                        Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                        PopupContentTemplate="{StaticResource LookUpEditCategoryControlTemplate}"
                                        IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="Validate"
                                                       Command="{Binding Path=CategoryValidateCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True"/>
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.StyleSettings>
                                <dxg:SearchLookUpEditStyleSettings />
                            </dxg:LookUpEdit.StyleSettings>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Хар-ка">
                        <dxg:LookUpEdit ItemsSource="{Binding Path=MasterFeatures, Mode=OneWay}"
                                        EditValue="{Binding Path=Model.MasterFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        DisplayMember="DisplayValue"
                                        AutoPopulateColumns="False"
                                        AutoComplete="False"
                                        IncrementalFiltering="True"
                                        FilterCondition="Like"
                                        FindMode="Always"
                                        ImmediatePopup="True"
                                        IsPopupAutoWidth="True"
                                        InvalidValueBehavior="AllowLeaveEditor"
                                        Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                        PopupContentTemplate="{StaticResource FeatureControlTemplate}"
                                        IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="Validate"
                                                       Command="{Binding Path=FeatureValidateCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.StyleSettings>
                                <dxg:SearchLookUpEditStyleSettings />
                            </dxg:LookUpEdit.StyleSettings>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Прочее"
                                  GroupBoxStyle="{StaticResource GroupBoxWithHeaderStyle}"
                                  Orientation="Vertical">
                    <dxlc:LayoutItem Label="Сравнение">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=CompareMethods, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.CompareMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Сообщение (рус.)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.ValidationMessageTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}">
                            <dxe:TextEdit.IsReadOnly>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                    <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                    <Binding Path="IsAssemblyRule"/>
                                </MultiBinding>
                            </dxe:TextEdit.IsReadOnly>
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Сообщение (укр.)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.ValidationMessageTemplateUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}">
                            <dxe:TextEdit.IsReadOnly>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                    <Binding Path="IsNewOrIsLockedByCurrentEmployee" />
                                    <Binding Path="IsAssemblyRule" />
                                </MultiBinding>
                            </dxe:TextEdit.IsReadOnly>
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Сообщение (англ.)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.ValidationMessageTemplateEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}">
                            <dxe:TextEdit.IsReadOnly>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                    <Binding Path="IsNewOrIsLockedByCurrentEmployee" />
                                    <Binding Path="IsAssemblyRule" />
                                </MultiBinding>
                            </dxe:TextEdit.IsReadOnly>
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Уведомление">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=NotificationImages, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.NotificationImageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          ValueMember="Id"
                                          IsTextEditable="False"
                                          Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                            <dxe:ComboBoxEdit.IsReadOnly>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="DataContext.IsNewOrIsLockedByCurrentEmployee"
                                             ElementName="CurrentUserControl"
                                             Converter="{dxmvvm:BooleanNegationConverter}"/>
                                    <Binding Path="Model.AllowEditNotificationImageId" Converter="{dxmvvm:BooleanNegationConverter}" />
                                </MultiBinding>
                            </dxe:ComboBoxEdit.IsReadOnly>
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Активно">
                        <dxe:CheckEdit EditValue="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       Style="{StaticResource ReadOnlyConditionsStyle}"
                                       IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup x:Name="ButtonsLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </dxlc:LayoutGroup>
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, ElementName=OkButton}"/>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>