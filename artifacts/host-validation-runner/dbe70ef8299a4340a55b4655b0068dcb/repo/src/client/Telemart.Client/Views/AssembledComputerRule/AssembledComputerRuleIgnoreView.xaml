<controls:TelemartUserControl x:Class="Telemart.Client.Views.AssembledComputerRule.AssembledComputerRuleIgnoreView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AssembledComputerRule"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              DataContext="{client:Container Type=viewModels:AssembledComputerRuleIgnoreViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="500"
                              d:DesignHeight="550"
                              d:DataContext="{d:DesignInstance Type=viewModels:AssembledComputerRuleIgnoreViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Name="Grid">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=AssemblySlotHostConsumers, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedAssemblySlotHostConsumer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     SelectionMode="None">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="assembled_computer_rule_ignore.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="И"
                                            HeaderToolTip="Игнорировать"
                                            AllowSorting="True"
                                            FieldName="Ignore"
                                            AllowEditing="True"
                                            Width="24"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowColumnFiltering="False"
                                            AllowResizing="False"
                                            VisibleIndex="1"
                                            AllowMoving="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Категория"
                                            HeaderToolTip="Категория"
                                            AllowColumnFiltering="False"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            FieldName="CategoryId"
                                            ReadOnly="True"
                                            AllowMoving="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Categories}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Характеристика"
                                            HeaderToolTip="Характеристика"
                                            AllowColumnFiltering="False"
                                            FieldName="FeatureId"
                                            ReadOnly="True"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowMoving="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Features}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Категория правила"
                                            HeaderToolTip="Категория"
                                            AllowColumnFiltering="False"
                                            FieldName="ConsumerCategoryId"
                                            ReadOnly="True"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowMoving="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Categories}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Характеристика правила"
                                            HeaderToolTip="Характеристика"
                                            AllowColumnFiltering="False"
                                            FieldName="ConsumerFeatureId"
                                            ReadOnly="True"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowMoving="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Features}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Сообщение"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="ValidationMessageTemplate"
                                            ReadOnly="True"
                                            AllowMoving="False"
                                            Width="130"
                                            AllowColumnFiltering="False"
                                            AllowBestFit="True"
                                            AllowResizing="True"/>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="TableView"
                                           AllowPerPixelScrolling="True"
                                           ShowGroupPanel="False"
                                           AllowDrop="False"
                                           AllowMoveColumnToDropArea="False"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           AutoWidth="True">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="Bottom"
                              VerticalAlignment="Bottom"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=GridControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>
