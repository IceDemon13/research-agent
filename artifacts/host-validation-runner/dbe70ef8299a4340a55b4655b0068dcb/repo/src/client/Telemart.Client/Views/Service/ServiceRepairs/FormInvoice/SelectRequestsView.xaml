<UserControl x:Class="Telemart.Client.Views.Service.ServiceRepairs.FormInvoice.SelectRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:formInvoice="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs.FormInvoice"
             xmlns:serviceRepairs="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             mc:Ignorable="d"
             DataContext="{client:Container Type=formInvoice:SelectRequestsViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type formInvoice:SelectRequestsViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Назад"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=Model.ServiceRepairs, Mode=OneWay}"
                             SelectedItems="{Binding Path=Model.SelectedServiceRepair, Mode=TwoWay}"
                             SelectionMode="Row"
                             DesignTimeDataObjectType="{x:Type serviceRepairs:ServiceRepairViewItem}">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                    <dxmvvm:FocusBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Id"
                                    Header="Ремонт"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FixedWidth="True"
                                    Width="70">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="DisplayProductName"
                                    Header="Название"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowBestFit="True">
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="SerialNumber"
                                    Header="SN"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowBestFit="True">
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Defect"
                                    Header="Дефект"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowBestFit="True">
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView ShowCheckBoxSelectorColumn="True"
                                   CheckBoxSelectorColumnWidth="24"
                                   AllowGrouping="False"
                                   AllowFilterEditor="False"
                                   AllowSorting="False"
                                   AllowBestFit="True"
                                   IsTotalSummaryMenuEnabled="False"
                                   IsColumnChooserVisible="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutItem Label="Отмечено">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Path=Model.SelectedServiceRepair.Count, Mode=OneWay, FallbackValue=0}"
                               FontWeight="Bold" />
                    <TextBlock Text=" / " />
                    <TextBlock Text="{Binding Path=Model.ServiceRepairs.Count, Mode=OneWay, FallbackValue=0}"
                               FontWeight="Bold" />
                </StackPanel>
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>