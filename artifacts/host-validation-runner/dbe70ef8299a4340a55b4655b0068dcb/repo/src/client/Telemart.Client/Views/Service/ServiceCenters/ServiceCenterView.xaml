<controls:TelemartUserControl x:Name="CurrentUserControl"
                              x:Class="Telemart.Client.Views.Service.ServiceCenters.ServiceCenterView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:serviceCenters="clr-namespace:Telemart.Client.ViewModels.Service.ServiceCenters"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
                              xmlns:common="clr-namespace:Telemart.Client.Common"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              DataContext="{client:Container Type=serviceCenters:ServiceCenterViewModel}"
                              Loaded="ServiceCenterViewLoaded"
                              Width="640"
                              Height="418"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type serviceCenters:ServiceCenterViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style TargetType="dxe:CheckEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="MemoEditStyle"
                           TargetType="dxe:MemoEdit"
                           BasedOn="{StaticResource BasicMemoEditStyle}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ComboBoxReadOnlyConditionsStyle"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="EditBox" />
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="dxg:LookUpEdit">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="EditBox" />
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsAdmin"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                        <Binding Path="IsHeadManager"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SearchableComboBoxReadOnlyConditionsStyle"
                           BasedOn="{StaticResource SearchableComboBoxStyle}"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                        <Binding Path="DataContext.IsNew"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="NullValueButtonPlacement"
                                        Value="EditBox" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="PhoneTextEditReadOnlyConditionsStyle"
                           BasedOn="{StaticResource PhoneTextEdit}"
                           TargetType="dxe:TextEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="TextEditReadOnlyConditionsStyle"
                           TargetType="dxe:TextEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              VerticalAlignment="Stretch">
                <dxlc:LayoutGroup x:Name="TabsLayoutGroup"
                                  Padding="0"
                                  View="Tabs"
                                  VerticalAlignment="Stretch"
                                  TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                                  TabStyle="{StaticResource LayoutGroupTabStyle}">
                    <dxlc:LayoutGroup x:Name="GeneralInfoLayoutGroup"
                                      Header="Инфо"
                                      Orientation="Vertical"
                                      Margin="8"
                                      ItemStyle="{StaticResource LayoutItemStyle}"
                                      dxe:ValidationService.IsValidationContainer="True">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Contractor/information.png" />
                                    <TextBlock Text="{Binding}"
                                               Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=GeneralInfoLayoutGroup, Converter={StaticResource BooleanToColorConverter}}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutItem Label="Тип">
                            <dxe:ComboBoxEdit x:Name="TypeComboBox"
                                              ItemsSource="{Binding Path=ServiceCenterTypes, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.TypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ValueMember="Id"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Поставщик">
                            <dxlc:LayoutItem.Visibility>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                    <Binding Path="Model.TypeId"
                                             Mode="OneWay"
                                             Converter="{converters:IsEqualConverter}"
                                             ConverterParameter="{x:Static dictionaries:ServiceCenterType.SupplierId}" />
                                </MultiBinding>
                            </dxlc:LayoutItem.Visibility>
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Suppliers, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.SupplierId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ValueMember="Id"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}">
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Название">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.NameMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Город">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ValueMember="Id"
                                              AllowNullInput="True"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Адрес">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.AddressMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Ответственный">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.Employee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              NullText="Не задан"
                                              AllowNullInput="True"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}">
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Сайт">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Link, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.LinkMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="ЕДРПОУ/ИНН">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Edrpou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaskType="RegEx"
                                          Mask="[0-9]{0,10}"
                                          AllowNullInput="True"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Накл. в день">
                            <dxe:TextEdit EditValue="{Binding Path=Model.InvoicesPerDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaskType="Numeric"
                                          Mask="###"
                                          MaskUseAsDisplayFormat="True"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Коммент">
                            <dxe:MemoEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.CommentMaxLength}"
                                          Style="{StaticResource MemoEditStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Статус">
                            <dxlc:LayoutGroup Orientation="Horizontal"
                                              HorizontalAlignment="Left">
                                <dxlc:LayoutGroup.Style>
                                    <Style TargetType="dxlc:LayoutGroup">
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                        <Binding Path="IsNew"
                                                                 Mode="OneWay" />
                                                        <Binding Path="IsLockedByCurrentEmployee"
                                                                 Mode="OneWay" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="IsEnabled"
                                                        Value="True" />
                                                <Setter Property="Opacity"
                                                        Value="{StaticResource EnabledElementOpacity}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxlc:LayoutGroup.Style>
                                <RadioButton Content="Активен"
                                             IsChecked="{Binding Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                <RadioButton Content="Не активен"
                                             IsChecked="{Binding Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                             VerticalAlignment="Center" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup x:Name="ContactsLayoutGroup"
                                      Header="Контакты"
                                      Orientation="Vertical"
                                      Margin="8"
                                      ItemStyle="{StaticResource LayoutItemStyle}"
                                      dxe:ValidationService.IsValidationContainer="True">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/book_addresses.png" />
                                    <TextBlock Text="{Binding}"
                                               Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=ContactsLayoutGroup, Converter={StaticResource BooleanToColorConverter}}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutItem Label="ФИО">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Fio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.FioMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Телефон">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:TextEdit EditValue="{Binding Path=Model.Phone, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource PhoneTextEditReadOnlyConditionsStyle}"
                                              MaxLength="{x:Static serviceCenters:ServiceCenterConstants.PhoneMaxLength}" />
                                <dxe:TextEdit EditValue="{Binding Path=Model.Phone2, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource PhoneTextEditReadOnlyConditionsStyle}"
                                              MaxLength="{x:Static serviceCenters:ServiceCenterConstants.PhoneMaxLength}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="E-mail">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.EmailMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Skype">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Skype, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.SkypeMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="ICQ">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Icq, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.IcqMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup x:Name="NovaposhtaLayoutGroup"
                                      Header="Новая почта"
                                      Orientation="Vertical"
                                      Margin="8"
                                      ItemStyle="{StaticResource LayoutItemStyle}"
                                      dxe:ValidationService.IsValidationContainer="True">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/ServiceRequest/np_16x16.png" />
                                    <TextBlock Text="{Binding}"
                                               Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=NovaposhtaLayoutGroup, Converter={StaticResource BooleanToColorConverter}}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutItem Label="Склад">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=NpWarehouses, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.NpWarehouseRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Address"
                                              ValueMember="Ref"
                                              AllowNullInput="True"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Почтомат">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=NpPostBoxes, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.NpPostBoxRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Address"
                                              ValueMember="Ref"
                                              AllowNullInput="True"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Улица">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=NpStreets, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.NpStreetRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ValueMember="Ref"
                                              AllowNullInput="True"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Дом">
                            <dxe:TextEdit EditValue="{Binding Path=Model.NpHouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="ФИО">
                            <dxe:TextEdit EditValue="{Binding Path=Model.RecipientFio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.FioMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"
                                          MaskType="RegEx"
                                          Mask="[а-яА-ЯіїєёІЇЄЁ’'\. \-\/\: ]*" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Телефон">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:TextEdit EditValue="{Binding Path=Model.RecipientPhone, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource PhoneTextEditReadOnlyConditionsStyle}"
                                              MaxLength="{x:Static serviceCenters:ServiceCenterConstants.PhoneMaxLength}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>

                    <dxlc:LayoutGroup x:Name="RegulationsLayoutGroup"
                                      Header="Регламент"
                                      Orientation="Vertical"
                                      Margin="8"
                                      ItemStyle="{StaticResource LayoutItemStyle}"
                                      dxe:ValidationService.IsValidationContainer="True">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/text_list_bullets_16x16.png" />
                                    <TextBlock Text="{Binding}"
                                               Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=RegulationsLayoutGroup, Converter={StaticResource BooleanToColorConverter}}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutItem Label="Регламент"
                                         VerticalAlignment="Stretch"
                                         LabelVerticalAlignment="Top">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Regulations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static serviceCenters:ServiceCenterConstants.RegulationsMaxLength}"
                                          AcceptsReturn="True"
                                          AcceptsTab="True"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="Top"
                                          TextWrapping="Wrap"
                                          Style="{StaticResource TextEditReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Подтв. ремонта">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=ServiceCenterRepairConfirmTypes, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.RepairConfirmType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource ComboBoxReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"
                            Width="106">
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="Model.EmployeeLockId"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:ObjectToBooleanConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Заблокировано пользователем: "
                                   Foreground="Red" />
                        <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay}" />
                    </StackPanel>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="LockCommand.IsExecuting" />
                            <Binding Path="SaveCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         ElementName="GeneralInfoLayoutGroup" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         ElementName="ContactsLayoutGroup" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         ElementName="RegulationsLayoutGroup" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         ElementName="NovaposhtaLayoutGroup" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Width="90"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, ElementName=OkButton}">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
