<UserControl x:Class="Telemart.Client.Views.Store.Order.PackList.PackListSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order.PackList"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:PackListSettingsViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:PackListSettingsViewModel}}"
             d:DesignHeight="180" d:DesignWidth="500"
             Height="180"
             Width="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        IsEnabled="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutGroup Orientation="Vertical"
                          VerticalAlignment="Center">
            <dxlc:LayoutItem Label="Склад">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                  EditValue="{Binding Path=WarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayValue" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Макс. вес заказа">
                <dxe:SpinEdit EditValue="{Binding Path=MaxTotalWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              HorizontalContentAlignment="Right"
                              ShowEditorButtons="False"
                              Mask="#######0.0"
                              MaskType="Numeric"
                              IsFloatValue="True"
                              AllowNullInput="True"
                              MaskUseAsDisplayFormat="True"
                              NullText="{StaticResource NullTextValue}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Макс. количество одного sku  товара в заказе">
                <dxe:SpinEdit EditValue="{Binding Path=MaxSkuQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              HorizontalContentAlignment="Right"
                              ShowEditorButtons="False"
                              MaskType="Numeric"
                              Mask="F0"
                              MaxLength="99"
                              IsFloatValue="True"
                              AllowNullInput="True"
                              MaskUseAsDisplayFormat="True"
                              NullText="{StaticResource NullTextValue}">
                </dxe:SpinEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Макс. количество строк в заказе">
                <dxe:TextEdit EditValue="{Binding Path=OrderProductMaxLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              HorizontalContentAlignment="Right"
                              MaskType="Numeric"
                              Mask="F0"
                              MaxLength="99">
                </dxe:TextEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom">
            <viewComponents:WaitImage HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      BusyText="Создание..."
                                      Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
            <dxlc:LayoutGroup HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                <Button Content="Создать"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
