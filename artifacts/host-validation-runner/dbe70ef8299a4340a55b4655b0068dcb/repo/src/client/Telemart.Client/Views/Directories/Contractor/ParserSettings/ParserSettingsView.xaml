<controls:TelemartUserControl x:Class="Telemart.Client.Views.Directories.Contractor.ParserSettings.ParserSettingsView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Contractor.ParserSettings"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:system="clr-namespace:System;assembly=System.Runtime"
                              DataContext="{client:Container Type=viewModels:ParserSettingsViewModel}"
                              mc:Ignorable="d"
                              x:Name="CurrentUserControl"
                              d:DesignWidth="800"
                              d:DesignHeight="450"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ParserSettingsViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="LayoutGroupReadOnlyStyle"
                           TargetType="dxlc:LayoutGroup">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNewOrIsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="BaseEditReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="GridControlReadOnlyConditionsStyle"
                           TargetType="dxg:GridControl"
                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee" />
                                        <Binding Path="IsNew" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ToolBarControlReadOnlyConditonsStyle"
                           TargetType="dxb:ToolBarControl"
                           BasedOn="{StaticResource SmallToolBarStyle}">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee" />
                                        <Binding Path="IsNew" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsEnabled"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ComboBoxReadOnlyConditionsStyle"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsNewOrIsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Horizontal"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">

            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutGroup View="Tabs"
                                      VerticalAlignment="Stretch"
                                      TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                                      TabStyle="{StaticResource LayoutGroupTabStyle}">
                        <dxlc:LayoutGroup x:Name="MainTab"
                                          Header="Основные"
                                          Orientation="Vertical"
                                          dxe:ValidationService.IsValidationContainer="True"
                                          Padding="10">
                            <dxlc:LayoutGroup.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="Основные">
                                        <dx:DXImage Source="/Images/Common/tree_list_16x16.png" />
                                        <TextBlock Text="Основные"
                                                   Padding="4,0,0,0"
                                                   FontSize="12"
                                                   FontWeight="Normal" />
                                    </StackPanel>
                                </DataTemplate>
                            </dxlc:LayoutGroup.HeaderTemplate>
                            <dxlc:LayoutItem Label="Название">
                                <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Тип">
                                <dxe:ComboBoxEdit EditValue="{Binding Model.TypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  ItemsSource="{Binding Path=ParserSettingsTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ValueMember="Id"
                                                  DisplayMember="Name"
                                                  Style="{StaticResource ComboBoxReadOnlyConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutGroup Header="Авторизация"
                                              Orientation="Vertical"
                                              VerticalAlignment="Top"
                                              View="GroupBox">
                                <dxlc:LayoutGroup.GroupBoxStyle>
                                    <Style TargetType="dxlc:GroupBox"
                                           BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                        <Setter Property="Padding"
                                                Value="8" />
                                        <Setter Property="BorderThickness"
                                                Value="1" />
                                    </Style>
                                </dxlc:LayoutGroup.GroupBoxStyle>
                                <dxlc:LayoutItem Label="Логин">
                                    <dxe:TextEdit EditValue="{Binding Path=Model.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Пароль">
                                    <dxe:PasswordBoxEdit EditValue="{Binding Path=Model.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                         Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                               
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup Header="ВГХ"
                                              Orientation="Vertical"
                                              VerticalAlignment="Top"
                                              View="GroupBox">
                                <dxlc:LayoutGroup.GroupBoxStyle>
                                    <Style TargetType="dxlc:GroupBox"
                                           BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                        <Setter Property="Padding"
                                                Value="8" />
                                        <Setter Property="BorderThickness"
                                                Value="1" />
                                    </Style>
                                </dxlc:LayoutGroup.GroupBoxStyle>
                                <dxlc:LayoutItem Label="Парсить и сохранять для неактивных категорий">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.ParseInactiveCategories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                   Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup Header="Разное"
                                              Orientation="Vertical"
                                              VerticalAlignment="Top"
                                              View="GroupBox">
                                <dxlc:LayoutGroup.GroupBoxStyle>
                                    <Style TargetType="dxlc:GroupBox"
                                           BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                        <Setter Property="Padding"
                                                Value="8" />
                                        <Setter Property="BorderThickness"
                                                Value="1" />
                                    </Style>
                                </dxlc:LayoutGroup.GroupBoxStyle>
                                 <dxlc:LayoutItem Label="Парсить все бренды">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.ParseAllBrands, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                   Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Авто-сопоставление">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.AutoRecognize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                   Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Время жизни">
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      HorizontalAlignment="Left">
                                        <dxlc:LayoutItem Label="РРЦ" HorizontalAlignment="Left">
                                            <dxe:SpinEdit EditValue="{Binding Model.PriceRrpLifetime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          MinValue="1"
                                                          MaxValue="365"
                                                          Width="60"
                                                          AllowSpinOnMouseWheel="True"
                                                          AllowNullInput="False"
                                                          IsFloatValue="False"
                                                          InvalidValueBehavior="AllowLeaveEditor"
                                                          EditValueType="{x:Type system:Int32}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}">
                                                <dxe:SpinEdit.ErrorToolTipContentTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={converters:SpinEditErrorToolTipConverter MinErrorText='Количество дней должно быть больше 0',MaxErrorText='Количество дней должно быть меньше 365'}, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=dxe:SpinEdit}}" />
                                                    </DataTemplate>
                                                </dxe:SpinEdit.ErrorToolTipContentTemplate>
                                            </dxe:SpinEdit>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Опт" HorizontalAlignment="Left">
                                            <dxe:SpinEdit EditValue="{Binding Model.PriceWholesaleLifetime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          MinValue="1"
                                                          MaxValue="365"
                                                          AllowNullInput="False"
                                                          Width="60"
                                                          AllowSpinOnMouseWheel="True"
                                                          IsFloatValue="False"
                                                          InvalidValueBehavior="AllowLeaveEditor"
                                                          EditValueType="{x:Type system:Int32}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}">
                                                <dxe:SpinEdit.ErrorToolTipContentTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={converters:SpinEditErrorToolTipConverter MinErrorText='Количество дней должно быть больше 0',MaxErrorText='Количество дней должно быть меньше 365'}, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=dxe:SpinEdit}}" />
                                                    </DataTemplate>
                                                </dxe:SpinEdit.ErrorToolTipContentTemplate>
                                            </dxe:SpinEdit>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Розница" HorizontalAlignment="Left">
                                            <dxe:SpinEdit EditValue="{Binding Model.PriceRetailLifetime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          MinValue="1"
                                                          MaxValue="365"
                                                          Width="60"
                                                          AllowSpinOnMouseWheel="True"
                                                          AllowNullInput="False"
                                                          IsFloatValue="False"
                                                          InvalidValueBehavior="AllowLeaveEditor"
                                                          EditValueType="{x:Type system:Int32}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}">
                                                <dxe:SpinEdit.ErrorToolTipContentTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={converters:SpinEditErrorToolTipConverter MinErrorText='Количество дней должно быть больше 0',MaxErrorText='Количество дней должно быть меньше 365'}, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=dxe:SpinEdit}}" />
                                                    </DataTemplate>
                                                </dxe:SpinEdit.ErrorToolTipContentTemplate>
                                            </dxe:SpinEdit>
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                
                            </dxlc:LayoutGroup>

                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup x:Name="ExcelTab"
                                          Header="Excel"
                                          Orientation="Horizontal"
                                          HorizontalAlignment="Stretch"
                                          dxe:ValidationService.IsValidationContainer="{Binding Path=ExcelTabVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding Path=ExcelTabVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                          Padding="10">
                            <dxlc:LayoutGroup.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="Настройки Excel">
                                        <dx:DXImage Source="/Images/Common/table_excel_16x16.png" />
                                        <TextBlock Text="Настройки Excel"
                                                   Padding="4,0,0,0"
                                                   FontSize="12"
                                                   FontWeight="Normal" />
                                    </StackPanel>
                                </DataTemplate>
                            </dxlc:LayoutGroup.HeaderTemplate>
                            <dxlc:LayoutGroup View="Tabs"
                                              VerticalAlignment="Stretch"
                                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                                <dxlc:LayoutGroup x:Name="GeneralTab"
                                                  Header="Общие"
                                                  Orientation="Vertical"
                                                  Padding="10">
                                    <dxlc:LayoutGroup.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip="Общие настройки">
                                                <dx:DXImage Source="/Images/Common/copying_and_distribution.png" />
                                                <TextBlock Text="Общие"
                                                           Padding="4,0,0,0"
                                                           FontSize="12"
                                                           FontWeight="Normal" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutGroup.HeaderTemplate>
                                    <dxlc:LayoutGroup
                                        Header="Столбцы"
                                        Orientation="Vertical"
                                        GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                                        <dxlc:LayoutItem Label="Стартовая строка">
                                            <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.StartLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}"
                                                          MaskType="Numeric"
                                                          Mask="####"/>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Стартовое слово">
                                            <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.StartWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Стоп слово">
                                            <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.StopWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Листы">
                                            <dxe:ComboBoxEdit EditValue="{Binding Model.ParserSettingsFile.SheetsTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              ItemsSource="{Binding Path=ParserSettingsFileSheetsTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                              Style="{StaticResource ComboBoxReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Склад поставщика">
                                            <dxe:ComboBoxEdit EditValue="{Binding Model.ParserSettingsFile.SupplierWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              ItemsSource="{Binding Path=SupplierWarehouses, Mode=OneWay}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                              Style="{StaticResource ComboBoxReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Формат выбора листа"
                                                         Visibility="{Binding Path=SheetsRecognizeVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                            <dxe:ComboBoxEdit EditValue="{Binding Model.ParserSettingsFile.SheetsRecognizeTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              ItemsSource="{Binding Path=ParserSettingsFileSheetsRecognizeTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                              Style="{StaticResource ComboBoxReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Шаблон выбора листа"
                                                         Visibility="{Binding Path=SheetsRecognizeVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                            <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.SheetsRecognizePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup x:Name="ColumnsTab"
                                                  Header="Столбцы"
                                                  Orientation="Vertical"
                                                  Padding="10">
                                    <dxlc:LayoutGroup.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip="Настройки столбцов">
                                                <dx:DXImage Source="/Images/Common/document_notes_16x16.png" />
                                                <TextBlock Text="Столбцы"
                                                           Padding="4,0,0,0"
                                                           FontSize="12"
                                                           FontWeight="Normal" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutGroup.HeaderTemplate>
                                    <dxlc:LayoutItem Label="Название"
                                                     ToolTip="Номер столбца с названием товара">
                                        <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.NameColumnNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                      Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Код"
                                                     ToolTip="Номер столбца с кодом товара">
                                        <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CodeColumnNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                      Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Артикул"
                                                     ToolTip="Номер столбца с артикулом товара">
                                        <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.PartNumberColumnNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                      Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Категория"
                                                     ToolTip="Номер столбца с категорией товара">
                                        <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryColumnNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                      Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Наличие"
                                                     ToolTip="Номер столбца с наличием товара">
                                        <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.AvailColumnNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                      MaskType="Numeric"
                                                      Mask="##"
                                                      AllowNullInput="True"
                                                      Style="{StaticResource BaseEditReadOnlyConditionsStyle}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutGroup View="GroupBox"
                                                      Header="Категория является заголовком"
                                                      ToolTip="Правила, которые определяют является ли категория заголовком"
                                                      Orientation="Horizontal"
                                                      HorizontalAlignment="Stretch"
                                                      ItemSpace="0"
                                                      GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                                      Height="220">
                                        <dxlc:LayoutGroup Orientation="Vertical" VerticalAlignment="Stretch">
                                            <dxlc:LayoutGroup Orientation="Horizontal" Margin="3,15,0,6" Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                                <dxlc:LayoutItem HorizontalAlignment="Left">
                                                    <dxe:CheckEdit ToolTip="Активное правило"
                                                                   EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule1.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource ReadOnlyConditionsStyle}"
                                                                   Visibility="Visible" />
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutItem Label="Столбец №" Width="70" HorizontalAlignment="Left" />
                                                <dxlc:LayoutItem HorizontalAlignment="Left">
                                                    <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule1.ColumnNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                  Width="50"
                                                                  MaskType="Numeric"
                                                                  Mask="##" />
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutGroup Orientation="Vertical"
                                                                  HorizontalAlignment="Left"
                                                                  Margin="0,-5,0,0"
                                                                  Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                                    <RadioButton Content="="
                                                                 FontSize="15"
                                                                 FontWeight="Bold"
                                                                 IsChecked="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule1.EqualsCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0,0,0,-3" />
                                                    <RadioButton Content="!="
                                                                 FontSize="15"
                                                                 FontWeight="Bold"
                                                                 IsChecked="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule1.EqualsCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0,-3,0,0" />
                                                </dxlc:LayoutGroup>
                                                <dxlc:LayoutItem HorizontalAlignment="Stretch" Margin="0,0,5,0">
                                                    <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule1.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                  MinWidth="220" />
                                                </dxlc:LayoutItem>
                                            </dxlc:LayoutGroup>

                                            <dxlc:LayoutGroup Orientation="Horizontal" Margin="3,15,0,6" Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                                <dxlc:LayoutItem HorizontalAlignment="Left">
                                                    <dxe:CheckEdit ToolTip="Активное правило"
                                                                   EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule2.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource ReadOnlyConditionsStyle}"
                                                                   Visibility="Visible" />
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutItem Label="Столбец №" Width="70" HorizontalAlignment="Left" />
                                                <dxlc:LayoutItem HorizontalAlignment="Left">
                                                    <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule2.ColumnNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                  Width="50"
                                                                  MaskType="Numeric"
                                                                  Mask="##"/>
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutGroup Orientation="Vertical"
                                                                  HorizontalAlignment="Left" Margin="0,-5,0,0"
                                                                  Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                                    <RadioButton Content="="
                                                                 FontSize="15"
                                                                 FontWeight="Bold"
                                                                 IsChecked="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule2.EqualsCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0,0,0,-3" />
                                                    <RadioButton Content="!="
                                                                 FontSize="15"
                                                                 FontWeight="Bold"
                                                                 IsChecked="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule2.EqualsCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0,-3,0,0" />
                                                </dxlc:LayoutGroup>
                                                <dxlc:LayoutItem HorizontalAlignment="Stretch" Margin="0,0,5,0">
                                                    <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule2.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                  MinWidth="220" />
                                                </dxlc:LayoutItem>
                                            </dxlc:LayoutGroup>
                                            <dxlc:LayoutGroup Orientation="Horizontal" Margin="3,15,0,6" Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                                <dxlc:LayoutItem HorizontalAlignment="Left">
                                                    <dxe:CheckEdit ToolTip="Активное правило"
                                                                   EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule3.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource ReadOnlyConditionsStyle}"
                                                                   Visibility="Visible" />
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutItem Label="Столбец №" Width="70" HorizontalAlignment="Left" />
                                                <dxlc:LayoutItem HorizontalAlignment="Left">
                                                    <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule3.ColumnNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                  Width="50"
                                                                  MaskType="Numeric"
                                                                  Mask="##"/>
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutGroup Orientation="Vertical"
                                                                  HorizontalAlignment="Left"
                                                                  Margin="0,-5,0,0"
                                                                  Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                                    <RadioButton Content="="
                                                                 FontSize="15"
                                                                 FontWeight="Bold"
                                                                 IsChecked="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule3.EqualsCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0,0,0,-3" />
                                                    <RadioButton Content="!="
                                                                 FontSize="15"
                                                                 FontWeight="Bold"
                                                                 IsChecked="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule3.EqualsCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0,-3,0,0" />
                                                </dxlc:LayoutGroup>
                                                <dxlc:LayoutItem HorizontalAlignment="Stretch" Margin="0,0,3,0">
                                                    <dxe:TextEdit EditValue="{Binding Path=Model.ParserSettingsFile.FileColumn.CategoryRule3.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                  MinWidth="220" />
                                                </dxlc:LayoutItem>
                                            </dxlc:LayoutGroup>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>

                                    <dxlc:LayoutGroup View="GroupBox"
                                                      Header="Цены"
                                                      ToolTip="Настройки колонок цен"
                                                      Orientation="Vertical"
                                                      VerticalAlignment="Stretch"
                                                      HorizontalAlignment="Stretch"
                                                      ItemSpace="0"
                                                      GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                                        <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                                            IsEnabled="True">
                                            <dxb:BarButtonItem Content="Добавить"
                                                               Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                               IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Command="{Binding Path=AddPriceCommand, Mode=OneWay}" />
                                            <dxb:BarButtonItem Content="Удалить"
                                                               IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                               Command="{Binding Path=DeletePriceCommand, Mode=OneWay}" />
                                        </dxb:ToolBarControl>
                                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                        <dxg:GridControl x:Name="PricesGridControl"
                                                         CurrentItem="{Binding Path=SelectedPrice, Mode=TwoWay}"
                                                         ItemsSource="{Binding Path=Model.ParserSettingsFile.FileColumn.Prices, Mode=OneWay}"
                                                         SelectionMode="Cell"
                                                         ShowBorder="False"
                                                         IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource GridControlReadOnlyConditionsStyle}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <behaviors:CopyCurrentCellToClipboardBehavior />
                                            </dxmvvm:Interaction.Behaviors>
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="ColumnNumber"
                                                                Header="Номер колонки"
                                                                MinWidth="40"
                                                                HeaderToolTip="Номер колонки">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                                              MaskType="Numeric"
                                                                              Mask="##"/>
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn Header="Тип цены"
                                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                                FieldName="ParserPriceTypeId"
                                                                ReadOnly="False"
                                                                AllowMoving="False"
                                                                IsEnabled="True"
                                                                AllowEditing="True"
                                                                MinWidth="70"
                                                                HorizontalHeaderContentAlignment="Center"
                                                                Width="120">
                                                    <dxg:GridColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                                              ItemsSource="{Binding Path=DataContext.ParserPriceTypes, Mode=OneWay, ElementName=CurrentUserControl}"
                                                                              ValueMember="Id"
                                                                              DisplayMember="Name"
                                                                              IsEnabled="True"
                                                                              HorizontalContentAlignment="Center" />
                                                        </DataTemplate>
                                                    </dxg:GridColumn.CellTemplate>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn Header="Валюта"
                                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                                FieldName="CurrencyId"
                                                                ReadOnly="False"
                                                                AllowMoving="False"
                                                                IsEnabled="True"
                                                                MinWidth="70"
                                                                AllowEditing="True"
                                                                HorizontalHeaderContentAlignment="Center"
                                                                Width="120">
                                                    <dxg:GridColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                                              ItemsSource="{Binding Path=DataContext.Currencies, Mode=OneWay, ElementName=CurrentUserControl}"
                                                                              ValueMember="Id"
                                                                              DisplayMember="Name"
                                                                              IsEnabled="True"
                                                                              HorizontalContentAlignment="Center" />
                                                        </DataTemplate>
                                                    </dxg:GridColumn.CellTemplate>
                                                </dxg:GridColumn>
                                            </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TableView AllowPerPixelScrolling="True"
                                                               AllowSorting="True"
                                                               AllowBestFit="False"
                                                               IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                               AllowEditing="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                               AllowMoveColumnToDropArea="False"
                                                               Style="{StaticResource ReadOnlyTableViewStyle}" />
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Horizontal" Name="Grids">
                        <dxlc:LayoutGroup Header="Настройки категорий"
                                          Orientation="Vertical"
                                          MinWidth="140"
                                          VerticalAlignment="Stretch"
                                          View="GroupBox"
                                          ItemSpace="0">
                            <dxlc:LayoutGroup.GroupBoxStyle>
                                <Style TargetType="dxlc:GroupBox"
                                       BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                    <Setter Property="BorderThickness"
                                            Value="1" />
                                </Style>
                            </dxlc:LayoutGroup.GroupBoxStyle>
                            <dxb:ToolBarControl Style="{StaticResource ToolBarControlReadOnlyConditonsStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                   Command="{Binding CreateCategoryCommand, Mode=OneWay}">
                                </dxb:BarButtonItem>
                                <dxb:BarButtonItem Content="Редактировать"
                                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                   Command="{Binding EditCategoryCommand, Mode=OneWay}"
                                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CategoriesGridControl}">
                                </dxb:BarButtonItem>
                                <dxb:BarButtonItem Content="Удалить"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                   Command="{Binding DeleteCategoryCommand, Mode=OneWay}"
                                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CategoriesGridControl}">
                                </dxb:BarButtonItem>
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="CategoriesGridControl"
                                             ItemsSource="{Binding Path=Model.Categories, Mode=OneWay}"
                                             SelectionMode="Row"
                                             ShowBorder="False"
                                             Style="{StaticResource GridControlReadOnlyConditionsStyle}">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="CategoriesFormatted"
                                                    Header="Категории"
                                                    MinWidth="40"
                                                    HeaderToolTip="Категории">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings TextWrapping="Wrap" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Url"
                                                    Header="Ссылка"
                                                    MinWidth="40"
                                                    HeaderToolTip="Ссылка"
                                                    FixedWidth="True"
                                                    Width="190" />
                                    <dxg:GridColumn FieldName="Description"
                                                    Header="Описание"
                                                    MinWidth="30"
                                                    HeaderToolTip="Описание"
                                                    FixedWidth="False"
                                                    AllowResizing="True"
                                                    Width="80" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="True"
                                                   NavigationStyle="Row"
                                                   AllowSorting="True"
                                                   AllowBestFit="False"
                                                   AllowMoveColumnToDropArea="False"
                                                   Style="{StaticResource ReadOnlyTableViewStyle}" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Header="Замены наличия"
                                          Orientation="Vertical"
                                          VerticalAlignment="Stretch"
                                          View="GroupBox"
                                          ItemSpace="0"
                                          Width="270"
                                          MinWidth="230">
                            <dxlc:LayoutGroup.MaxWidth>
                                <MultiBinding Converter="{converters:ResizableLayoutGroupMaxDimensionConverter OppositeMinDimensionValue=250}">
                                    <Binding Path="ActualWidth"
                                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                                    <Binding Path="ItemSpace"
                                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                                    <Binding Path="Padding"
                                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                                </MultiBinding>
                            </dxlc:LayoutGroup.MaxWidth>
                            <dxlc:LayoutGroup.GroupBoxStyle>
                                <Style TargetType="dxlc:GroupBox"
                                       BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                    <Setter Property="BorderThickness"
                                            Value="1" />
                                </Style>
                            </dxlc:LayoutGroup.GroupBoxStyle>
                            <dxb:ToolBarControl Style="{StaticResource ToolBarControlReadOnlyConditonsStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                   Command="{Binding Path=AddAvailabilityCommand, Mode=OneWay}">
                                </dxb:BarButtonItem>
                                <dxb:BarButtonItem Content="Удалить"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                   Command="{Binding Path=DeleteAvailabilityCommand, Mode=OneWay}"
                                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=AvailabilityGridControl}">
                                </dxb:BarButtonItem>
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="AvailabilityGridControl"
                                             ItemsSource="{Binding Path=Model.Availabilities, Mode=OneWay}"
                                             SelectionMode="Row"
                                             ShowBorder="False"
                                             Style="{StaticResource GridControlReadOnlyConditionsStyle}">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Avail"
                                                    Header="Строка наличия"
                                                    MinWidth="40"
                                                    HeaderToolTip="Строка наличия" />
                                    <dxg:GridColumn FieldName="AvailabilityTypeId"
                                                    Header="Наличие"
                                                    MinWidth="40"
                                                    HeaderToolTip="Наличие">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name"
                                                                  IsTextEditable="False"
                                                                  ItemsSource="{Binding Path=DataContext.Availalities, ElementName=LayoutControl}"
                                                                  Padding="5,0,0,0" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Quantity"
                                                    Header="Кол-во"
                                                    HeaderToolTip="Количество"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FixedWidth="True"
                                                    Width="{StaticResource QuantityColumnWidth}"
                                                    MinWidth="{StaticResource MinQuantityColumnWidth}">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:SpinEditSettings HorizontalContentAlignment="Center"
                                                                  IsFloatValue="False"
                                                                  MinValue="0"
                                                                  MaxValue="9999"
                                                                  Increment="1" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="TableView"
                                                   AllowCommitOnValidationAttributeError="True"
                                                   EditorShowMode="MouseDownFocused"
                                                   EnableImmediatePosting="True"
                                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                                        <dxg:TableView.AllowEditing>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee" />
                                                <Binding Path="IsNew" />
                                            </MultiBinding>
                                        </dxg:TableView.AllowEditing>
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Del"
                                                                 Command="{Binding Path=DeleteAvailabilityCommand}"
                                                                 CommandParameter="{Binding Path=CurrentItem, ElementName=AvailabilityGridControl}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                 <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="Model.EmployeeLockId"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:ObjectToBooleanConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Заблокировано пользователем: "
                                   Foreground="Red" />
                        <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay}" />
                    </StackPanel>
                </dxlc:LayoutGroup>
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="LockCommand.IsExecuting" />
                            <Binding Path="SaveCommand.IsExecuting" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         ElementName="MainTab" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         ElementName="ExcelTab" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, ElementName=OkButton}">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>