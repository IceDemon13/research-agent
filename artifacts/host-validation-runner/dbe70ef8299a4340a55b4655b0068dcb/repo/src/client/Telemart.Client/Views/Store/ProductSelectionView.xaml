<UserControl x:Class="Telemart.Client.Views.Store.ProductSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:store="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d"
             DataContext="{client:Container Type=store:ProductSelectionViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type store:ProductSelectionViewModel}}"
             d:DesignHeight="350"
             d:DesignWidth="300"
             MinHeight="353"
             MaxHeight="353"
             MinWidth="500"
             MaxWidth="500"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        HorizontalAlignment="Center">
        <dxlc:LayoutGroup x:Name="Center"
                          Orientation="Vertical">
            <dxg:GridControl x:Name="ProductsGrid"
                             ItemsSource="{Binding Path=Products, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                             CurrentItem="{Binding Path=SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectedItem="{Binding Path=CurrentItem, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                             SelectionMode="None"
                             ClipboardCopyMode="ExcludeHeader">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Item2" />
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                                   ShowColumnHeaders="False"
                                   NavigationStyle="Row"
                                   ShowSearchPanelMode="Always">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                   Command="{Binding Path=OkCommand, Mode=OneWay}" />
                            <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                                                   Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                                                   PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Center"
                          HorizontalAlignment="Right">
            <Button Content="OK"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=ProductsGrid}" />
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>
