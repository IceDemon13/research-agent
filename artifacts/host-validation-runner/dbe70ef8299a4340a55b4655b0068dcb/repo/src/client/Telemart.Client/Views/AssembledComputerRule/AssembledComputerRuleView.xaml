<controls:TelemartUserControl x:Class="Telemart.Client.Views.AssembledComputerRule.AssembledComputerRuleView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AssembledComputerRule"
             xmlns:views="clr-namespace:Telemart.Client.Views.AssembledComputerRule"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:productInformation="clr-namespace:Telemart.Client.Views.Store.Order.ProductInformation"
             xmlns:custom="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:AssembledComputerRuleViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:AssembledComputerRuleViewModel}}">
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ColorItemTemplate">
                <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                    <Ellipse Fill="{Binding Path=Color, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}}"
                                     Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                     Stroke="Gray"
                                     StrokeThickness="0.5"
                                     Margin="3 0 0 0"
                                     Width="14"
                                     Height="14" />
                    <Label Content="{Binding Path=Name, Mode=OneWay}"
                                   Background="Transparent"
                                   Padding="0,0,0,0"
                                   Margin="5,0,0,0" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator OwnerLock="LoadingContent">
        <dx:LoadingDecorator.IsSplashScreenShown>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                    <Binding Path="HandleLoadedCommand.IsExecuting"/>
                    <Binding Path="CheckCommand.IsExecuting"/>
                </MultiBinding>
        </dx:LoadingDecorator.IsSplashScreenShown>
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">

            <dxlc:LayoutGroup Name="TopGroup"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutGroup Name="TopLeftGroup"
                                  Orientation="Horizontal">
                        <dxlc:LayoutGroup Name="LeftGroup"
                                      Orientation="Vertical">
                            <dxlc:LayoutItem Label="Бренд">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Brands, Mode=OneWay}"
                                      DisplayMember="DisplayValue"
                                      IsTextEditable="False"
                                      EditValue="{Binding Path=Model.Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Префикс">
                                <dxe:TextEdit
                                  EditValue="{Binding Path=Model.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Префикс (укр)">
                                <dxe:TextEdit
                                    EditValue="{Binding Path=Model.PrefixUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Префикс (англ)">
                                <dxe:TextEdit
                                    EditValue="{Binding Path=Model.PrefixEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Линейка">
                                <dxe:TextEdit
                                  EditValue="{Binding Path=Model.Line, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Серия">
                                <dxe:TextEdit
                                  EditValue="{Binding Path=Model.Series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Конфигурация">
                                <dxe:TextEdit
                                  EditValue="{Binding Path=Model.Configuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Артикул">
                                <dxe:TextEdit
                                  EditValue="{Binding Path=Model.PartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="100"/>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Name="RightGroup"
                                      Orientation="Vertical">
                            <dxlc:LayoutItem Label="Цвет">
                                <dxe:TextEdit
                                  EditValue="{Binding Path=Model.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Цвет 1" Height="22">
                                <dxe:ComboBoxEdit
                                                              ItemsSource="{Binding Path=ProductColors, Mode=OneWay}"
                                                              DisplayMember="Name"
                                                              IsTextEditable="False"
                                                              AllowNullInput="True"
                                                              EditValue="{Binding Path=Model.ColorPrimary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              ItemTemplate="{StaticResource ColorItemTemplate}"
                                                              Style="{StaticResource SearchableComboBoxStyle}">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Цвет 2" Height="22">
                                <dxe:ComboBoxEdit
                                                              ItemsSource="{Binding Path=ProductColors, Mode=OneWay}"
                                                              DisplayMember="Name"
                                                              IsTextEditable="False"
                                                              AllowNullInput="True"
                                                              EditValue="{Binding Path=Model.ColorSecondary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              ItemTemplate="{StaticResource ColorItemTemplate}"
                                                              Style="{StaticResource SearchableComboBoxStyle}">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Модификация">
                                <dxe:TextEdit
                                    IsReadOnly="True"
                                    EditValue="{Binding Path=Model.Modific, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    MaxLength="100"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Модель">
                                <dxe:TextEdit IsReadOnly="True"
                                  EditValue="{Binding Path=Model.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Название">
                                <dxe:TextEdit IsReadOnly="True"
                                              EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="База"
                                             ToolTip="Базовая конфигурация"
                                             LabelVerticalAlignment="Top">
                                        <dxlc:LayoutGroup Orientation="Vertical">
                                            <dxe:ButtonEdit EditValue="{Binding Path=Model.BaseProductName, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                                            IsReadOnly="True"
                                                            AllowDefaultButton="False">
                                                <dxe:ButtonInfo GlyphKind="Custom"
                                                                Content="..."
                                                                IsEnabled="True"
                                                                ToolTipService.ToolTip="Выбрать базовую конфигурацию"
                                                                Command="{Binding Path=SelectBaseProductCommand, Mode=OneWay}">
                                                </dxe:ButtonInfo>
                                                <dxe:ButtonInfo GlyphKind="Custom"
                                                                Content="x"
                                                                Foreground="Red"
                                                                IsEnabled="{Binding Path= Model.BaseProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:StringToBooleanConverter}}"
                                                                ToolTipService.ToolTip="Очистить"
                                                                Command="{Binding Path=ClearBaseProductCommand, Mode=OneWay}">
                                                </dxe:ButtonInfo>
                                            </dxe:ButtonEdit>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Name="MiddleLeftGroup"
                                      Orientation="Horizontal">
                        <dxlc:LayoutGroup View="GroupBox"
                                          Header="Категории"
                                          Orientation="Vertical"
                                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                          ItemSpace="0">
                            <dxb:ToolBarControl VerticalAlignment="Top"
                                                Style="{StaticResource SmallToolBarStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                   Command="{Binding Path=AddCategoryCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Удалить"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                   Command="{Binding Path=DeleteCategoryCommand, Mode=OneWay}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItem Content="Игнорировать правила пересчетов"
                                                   Glyph="../../../Images/Common/pci.png"
                                                   Command="{Binding Path=IgnoreRecalculationRulesCommand, Mode=OneWay}" />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl ItemsSource="{Binding Path=Model.Categories, Mode=TwoWay}"
                                             CurrentItem="{Binding Path=SelectedCategory}"
                                             SelectionMode="None"
                                             x:Name="CategoriesGridControl"
                                             ShowBorder="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn AllowEditing="False"
                                                    Header="Название"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    MinWidth="80"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    FieldName="CategoryName"
                                                    HeaderToolTip="Название категории">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                        <dx:DXImage Source="../../Images/NavigationMenu/folder_wrench.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            Margin="5,0,0,0" />
                                                        <TextBlock Text="{Binding Path=RowData.Row.CategoryName, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Background="Transparent"
                                                           Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn AllowEditing="True"
                                                    Header="Типы товаров"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    MinWidth="100"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    FieldName="ProductTypeIds"
                                                    HeaderToolTip="Типы товаров для подбора">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=DataContext.ProductTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=views:AssembledComputerRuleView}}"
                                                                  EditValue="{Binding RowData.Row.ProductTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:ProductTypeSelectedItemsConverter}}"
                                                                  DisplayMember="Name"
                                                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Хар-ка"
                                            HeaderToolTip="Характеристика"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="FeatureName"
                                            FixedWidth="False"
                                            MinWidth="100"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="О"
                                                    HeaderToolTip="Операция"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="CompareMethod"
                                                    FixedWidth="False"
                                                    MinWidth="20"
                                                    Width="20"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Значение хар-ки"
                                            HeaderToolTip="Значение характеристики"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="FeatureValueName"
                                            FixedWidth="False"
                                            MinWidth="100"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Кол-во"
                                                FieldName="Quantity"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="50"
                                                AllowEditing="True"
                                                IsEnabled="True"
                                                ReadOnly="False"
                                                AllowResizing="False"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                FixedWidth="True">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:SpinEdit x:Name="PART_Editor"
                                                          HorizontalContentAlignment="Center"
                                                          IsFloatValue="False"
                                                          MinValue="1"
                                                          MaxValue="99"
                                                          Increment="1" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Д"
                                                    HeaderToolTip="Разрешено использовать другие товары"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="UseAnyProducts"
                                                    AllowEditing="True"
                                                    FixedWidth="True"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    Width="24"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings  />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           ShowColumnHeaders="True"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           IsEnabled="True"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           EnableImmediatePosting="True"
                                           AllowMoveColumnToDropArea="False">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                                   Command="{Binding OnCategoriesCellValueChangedCommand}"
                                                                   PassEventArgsToCommand="True"/>
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox"
                                  Header="Товары"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                            <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                            Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddProductCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteProductCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Приоритет"
                                           Glyph="../../Images/Common/priority_small.png"
                                           Command="{Binding Path=ReorderProductPriorityCommand, Mode=OneWay}" />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedProduct}"
                                     SelectionMode="None"
                                     x:Name="ProductsGridControl"
                                     ShowBorder="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn AllowEditing="False"
                                            Header="Название"
                                            HorizontalHeaderContentAlignment="Center"
                                            MinWidth="50"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            HeaderToolTip="Название товара">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                        <dx:DXImage Source="../../Images/NavigationMenu/box_front_open.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            Margin="5,0,0,0" />
                                                        <custom:HighlightTextBlock Text="{Binding Path=RowData.Row.ProductName, Mode=OneWay}"
                                                                                   HighlightText="{Binding Path=DataContext.EditorParameter.ProductName, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=views:AssembledComputerRuleView}}"
                                                                                   IgnoreCase="False"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Left"
                                                                                   Background="Transparent"
                                                                                   Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Цена"
                                            HeaderToolTip="Цена товара"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Price"
                                            FixedWidth="True"
                                            Width="70"
                                            MinWidth="70"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowSorting="False"
                                            AllowMoving="False"
                                            AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  MaskType="Numeric"
                                                                  Mask="C2"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="К"
                                                    HeaderToolTip="Обязательно к использованию"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Required"
                                                    AllowEditing="True"
                                                    FixedWidth="True"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    Width="24"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Кол-во"
                                                FieldName="QuantityToUse"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="50"
                                                AllowEditing="True"
                                                IsEnabled="True"
                                                AllowResizing="False"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                FixedWidth="True">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:SpinEdit x:Name="PART_Editor"
                                                              HorizontalContentAlignment="Center"
                                                              IsFloatValue="False"
                                                              MinValue="1"
                                                              MaxValue="99"
                                                              Increment="1">
                                                    <dxe:SpinEdit.Style>
                                                        <Style TargetType="dxe:SpinEdit">
                                                            <Setter Property="AllowNullInput" Value="True" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RowData.Row.Required, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                                                    <Setter Property="AllowNullInput" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </dxe:SpinEdit.Style>
                                                </dxe:SpinEdit>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Св. остаток"
                                            HeaderToolTip="Свободный остаток"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="QuantityFree"
                                            FixedWidth="True"
                                            Width="80"
                                            MinWidth="80"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowMoving="False"
                                            AllowSorting="False"
                                            AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           ShowColumnHeaders="True"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="False"
                                           AllowMoveColumnToDropArea="False"
                                           EnableImmediatePosting="True"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Name="TopRightGroup">
                    <productInformation:ProductInformation DataContext="{Binding Path=ProductInformation, Mode=OneWay}"
                                                           Width="300"
                                                           dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Path=DataContext, Mode=OneWay, ElementName=CurrentUserControl}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Name="BottomGroup"
                              Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                </dxlc:LayoutGroup>
                <dxe:CheckEdit Content="Активное"
                               EditValue="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                               VerticalAlignment="Center"
                               IsEnabled="{Binding Path=IsNew, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                               HorizontalAlignment="Left">
                </dxe:CheckEdit>
                <dx:SimpleButton x:Name="CopyButton"
                                 Glyph="../../../Images/Order/Menu/copy.png"
                                 Width="24"
                                 MinWidth="24"
                                 Margin="0,0, -4,0"
                                 Command="{Binding AssembledComputerRuleCopyCommand, Mode=OneTime}"/>
                <Button Content="Проверить"
                        Command="{Binding Path=CheckCommand, Mode=OneTime}"
                        HorizontalAlignment="Left"/>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>