<controls:TelemartUserControl x:Class="Telemart.Client.Views.Money.Receive.ProcessReceivedMoneyView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:controlswiki="clr-namespace:Telemart.Client.Controls"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Money.Receive"
                              DataContext="{client:Container Type=viewModels:ProcessReceivedMoneyViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:ProcessReceivedMoneyViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="750"
                              d:DesignHeight="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReceiveMoneyType.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:OpenFileDialogService x:Name="ImportFromExcelFileDialogService"
                                      Title="Выберите Excel файл для импорта"
                                      AddExtension="True"
                                      RestorePreviouslySelectedDirectory="True"
                                      Filter="Excel Workbook|*.xlsx"
                                      CheckFileExists="True"
                                      CheckPathExists="True" />
        <dxmvvm:DispatcherService />
        <dx:WindowedDocumentUIService x:Name="DialogDocumentManagerService"
                                      DocumentShowMode="Dialog"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterOwner">
            <dx:WindowedDocumentUIService.WindowStyle>
                <Style TargetType="{x:Type dx:DXWindow}">
                    <Setter Property="SizeToContent"
                            Value="WidthAndHeight" />
                    <Setter Property="ResizeMode"
                            Value="NoResize" />
                    <Setter Property="AllowSystemMenu"
                            Value="False" />
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>
        <dx:WindowedDocumentUIService x:Name="SizeableDialogDocumentManagerService"
                                      DocumentShowMode="Dialog"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterOwner">
            <dx:WindowedDocumentUIService.WindowStyle>
                <Style TargetType="{x:Type dx:DXWindow}">
                    <Setter Property="ResizeMode"
                            Value="CanResizeWithGrip" />
                    <Setter Property="WindowStyle"
                            Value="SingleBorderWindow" />
                    <Setter Property="AllowSystemMenu"
                            Value="True" />
                    <Setter Property="Width"
                            Value="{Binding Path=Content.DataContext.Width, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Height"
                            Value="{Binding Path=Content.DataContext.Height, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MinWidth"
                            Value="{Binding Path=Content.DataContext.MinWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MinHeight"
                            Value="{Binding Path=Content.DataContext.MinHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MaxWidth"
                            Value="{Binding Path=Content.DataContext.MaxWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MaxHeight"
                            Value="{Binding Path=Content.DataContext.MaxHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0">
                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                    <dxb:BarSubItem Content="Добавить"
                                    Glyph="{dx:DXImage Image=Add_16x16.png}"
                                    ItemLinksSource="{Binding Path=RecognizeTypes, Mode=OneWay}"
                                    LargeGlyph="{dx:DXImage Image=Add_32x32.png}">
                        <dxb:BarSubItem.ItemTemplate>
                            <DataTemplate>
                                <ContentControl>
                                    <dxb:BarButtonItem Content="{Binding Path=Title, Mode=OneWay}"
                                                       Command="{Binding Path=DataContext.ShowRecognizeDialogCommand, ElementName=LayoutControl, Mode=OneTime}"
                                                       Glyph="{Binding Path=Id, Mode=OneWay, Converter={StaticResource ReceiveMoneyTypeConverter }}"
                                                       CommandParameter="{Binding Mode=OneWay}" />
                                </ContentControl>
                            </DataTemplate>
                        </dxb:BarSubItem.ItemTemplate>
                    </dxb:BarSubItem>
                    <dxb:BarButtonItem Content="Очистить содержимое таблицы"
                                       Glyph="../../../Images/Common/page_white.png"
                                       Command="{Binding Path=RemoveAllCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Удалить выделенную строку"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       KeyGesture="Delete"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}"
                                       Command="{Binding Path=RemoveItemCommand, Mode=OneTime}" />
                    <dxb:BarItemSeparator />
                    <controlswiki:WikiBarButtonItem />
                </dxb:ToolBarControl>
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Items, Mode=OneWay}"
                                     CurrentItem="{Binding Path=CurrentItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectionMode="None">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="№"
                                            HeaderToolTip="Номер при сканировании"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Number"
                                            FixedWidth="True"
                                            Width="48">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Заказ"
                                            HeaderToolTip="Номер заказа"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="OrderId"
                                            FixedWidth="True"
                                            Width="60">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Факт"
                                            HeaderToolTip="Фактическая сумма денег"
                                            HorizontalHeaderContentAlignment="Right"
                                            FieldName="ActualAmount"
                                            AllowEditing="False"
                                            FixedWidth="True"
                                            Width="90">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit x:Name="PART_Editor"
                                                      HorizontalContentAlignment="Right"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="C2"
                                                      MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                                      MaskSaveLiteral="False"
                                                      IsFloatValue="False"
                                                      MinValue="0"
                                                      AllowDefaultButton="False"
                                                      EditValuePostMode="Delayed"
                                                      EditValuePostDelay="500">
                                        </dxe:SpinEdit>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="OrderState"
                                            Width="110"
                                            DisplayTemplate="{StaticResource OrderStatusColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="П"
                                            HeaderToolTip="ПКО создано"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Processed"
                                            FixedWidth="True"
                                            Width="24"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowResizing="False"
                                           AllowSorting="False"
                                           AllowGrouping="False"
                                           Style="{StaticResource ReadOnlyTableViewStyle}">
                                <dxg:TableView.FormatConditions>
                                    <dxg:IconSetFormatCondition Expression="[ActualAmount] / [PlannedAmount]"
                                                                FieldName="ActualAmount">
                                        <dx:IconSetFormat ElementThresholdType="Number">
                                            <dx:IconSetElement ThresholdComparisonType="Greater"
                                                               Threshold="1">
                                                <dx:IconSetElement.Icon>
                                                    <BitmapImage CacheOption="OnLoad"
                                                                 UriSource="pack://application:,,,/DevExpress.Xpf.Core.v24.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols23_3.png"
                                                                 UriCachePolicy="{x:Null}" />
                                                </dx:IconSetElement.Icon>
                                            </dx:IconSetElement>
                                            <dx:IconSetElement ThresholdComparisonType="GreaterOrEqual"
                                                               Threshold="1">
                                                <dx:IconSetElement.Icon>
                                                    <BitmapImage CacheOption="OnLoad"
                                                                 UriSource="pack://application:,,,/DevExpress.Xpf.Core.v24.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols23_1.png"
                                                                 UriCachePolicy="{x:Null}" />
                                                </dx:IconSetElement.Icon>
                                            </dx:IconSetElement>
                                            <dx:IconSetElement ThresholdComparisonType="GreaterOrEqual"
                                                               Threshold="0">
                                                <dx:IconSetElement.Icon>
                                                    <BitmapImage CacheOption="OnLoad"
                                                                 UriSource="pack://application:,,,/DevExpress.Xpf.Core.v24.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols23_2.png"
                                                                 UriCachePolicy="{x:Null}" />
                                                </dx:IconSetElement.Icon>
                                            </dx:IconSetElement>
                                        </dx:IconSetFormat>
                                    </dxg:IconSetFormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                    <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                                  LabelColumnWidth="1*"
                                                  ContentColumnWidth="1.6*"
                                                  VerticalAlignment="Stretch"
                                                  Width="200" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical"
                              View="GroupBox"
                              Header="Обработка"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Top">
                    <dxlc:LayoutItem Label="Оплата"
                                     Width="170">
                        <dxe:TextEdit EditValue="{Binding Path=SelectedPayment.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyEditorStyle}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Касса">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                          EditValue="{Binding Path=SelectedCashboxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          ValueMember="Id"
                                          DisplayMember="DisplayValue"
                                          Style="{StaticResource SearchableComboBoxStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Получены"
                                     Width="190">
                        <dxe:DateEdit EditValue="{Binding Path=ReceivedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MinValue="{Binding Path=ReceivedOnMinValue}"
                                      MaxValue="{Binding Path=ReceivedOnMaxValue}"
                                      MaskType="DateTimeAdvancingCaret"
                                      MaskUseAsDisplayFormat="True"
                                      AllowNullInput="True"
                                      NullValueButtonPlacement="EditBox"
                                      NullValue="{x:Null}"
                                      NullText="{StaticResource NullTextValue}">
                            <dxe:DateEdit.StyleSettings>
                                <dxe:DateEditCalendarStyleSettings />
                            </dxe:DateEdit.StyleSettings>
                        </dxe:DateEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxg:GridControl ItemsSource="{Binding Path=Messages, Mode=OneWay}"
                                 CurrentItem="{Binding Path=CurrentMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionMode="None"
                                 Height="130">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Время"
                                        HeaderToolTip="Время"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="Time"
                                        FixedWidth="True"
                                        Width="66"
                                        SortMode="Value"
                                        SortIndex="0"
                                        SortOrder="Descending">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                      Mask="HH:mm:ss"
                                                      MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Сообщение"
                                        HeaderToolTip="Сообщение"
                                        FieldName="Message">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings TextWrapping="Wrap" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowResizing="False"
                                       AllowSorting="False"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="Провести ДС"
                        Command="{Binding Path=OkCommand, Mode=OneTime}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneTime}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>