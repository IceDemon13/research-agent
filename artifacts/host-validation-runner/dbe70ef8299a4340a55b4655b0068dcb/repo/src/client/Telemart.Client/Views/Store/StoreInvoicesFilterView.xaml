<UserControl x:Class="Telemart.Client.Views.Store.StoreInvoicesFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=viewModels:StoreInvoicesFilterViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <!--move to main style-->
                <ResourceDictionary>
                    <Style TargetType="{x:Type Image}"
                           x:Key="ImageStyle">
                        <Setter Property="Margin"
                                Value="0,0,8,0" />
                        <Setter Property="Width"
                                Value="16" />
                        <Setter Property="Height"
                                Value="16" />
                        <Setter Property="VerticalAlignment"
                                Value="Center" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Name="Layout">
        <dxlc:LayoutControl Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="8">
                <dxlc:LayoutItem Label="Дата">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Order/Filter/calendar.png"
                                            Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      VerticalAlignment="Center">
                        <dxe:DateEdit EditValue="{Binding Path=InvoiceGetAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        <TextBlock Text="-"
                                   Width="8"
                                   TextAlignment="Center" />
                        <dxe:DateEdit EditValue="{Binding Path=InvoiceGetBefore, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Номер">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Common/cheque.png"
                                            Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=InvoiceIds, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                        </dxmvvm:Interaction.Behaviors>
                    </controls:FilterNumbersPrintTextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Склад">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Invoice/Filter/house.png"
                                            Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      DisplayMember="DisplayValue"
                                      EditValue="{Binding Path=SelectedWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:ComboBoxItemsConverter}}"
                                      Style="{StaticResource CheckedTokenComboBoxStyle}"
                                      AllowNullInput="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Контрагент">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Invoice/Filter/user_suit.png"
                                            Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                      DisplayMember="Name"
                                      EditValue="{Binding Path=SelectedContractors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource TokenComboBoxStyle}"></dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Статус">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Invoice/Filter/lightbulb.png"
                                            Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=InvoiceStateFilterViewItems, Mode=OneWay}"
                                      DisplayMember="DisplayValue"
                                      EditValue="{Binding Path=SelectedInvoiceStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:ComboBoxItemsConverter}}"
                                      Style="{StaticResource CheckedTokenComboBoxStyle}"></dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayerSeparator Kind="Horizontal"
                                     Thickness="1"
                                     Height="1" />
                <dxlc:LayoutItem Label="Накладных">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=InvoicesCount, Mode=OneWay}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" шт." />
                    </StackPanel>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</UserControl>
