<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.SelectDeliveryAddressView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              DataContext="{client:Container Type=viewModels:SelectDeliveryAddressViewModel}"
                              Loaded="OnLoaded"
                              Width="450"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type=viewModels:SelectDeliveryAddressViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutItem Label="Текущее"
                         LabelVerticalAlignment="Top">
            <TextBlock Text="{Binding Path=OldAddressValue, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Улица">
            <dxe:ComboBoxEdit x:Name="StreetComboBoxEdit"
                              ItemsSource="{Binding Path=Places, Mode=OneWay}"
                              EditValue="{Binding Path=Place, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMember="PlaceName"
                              AllowNullInput="True"
                              AssignNullValueOnClearingEditText="True"
                              ClearSelectionOnBackspace="True"
                              IsTextEditable="True"
                              ImmediatePopup="True"
                              IncrementalFiltering="True"
                              FilterCondition="Contains"
                              ValidateOnTextInput="False">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="EditValueChanged"
                                           Command="{Binding Path=HandleLoadHousesByStreetCommand, Mode=OneTime}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
            </dxe:ComboBoxEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutGroup Orientation="Horizontal">
            <dxlc:LayoutItem Label="Дом"
                             MaxWidth="130">
                <dxe:TextEdit EditValue="{Binding Path=House, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              MaxLength="10"
                              CharacterCasing="Upper"
                              MaskType="RegEx"
                              Mask="[1-9]{1}[0-9А-Яа-я\/\:\-]{0,9}"
                              MaskUseAsDisplayFormat="True" >
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="LostFocus"
                                               Command="{Binding Path=HandleDefinitionIndexCommand, Mode=OneTime}"
                                               PassEventArgsToCommand="True" />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:TextEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Кв."
                             MaxWidth="60"
                             IsEnabled="{Binding Path=SelectNpAddressForWarehouse, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxe:TextEdit EditValue="{Binding Path=FlatNumber, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              MaxLength="4"
                              IsReadOnly="{Binding Path=SelectNpAddressForWarehouse, UpdateSourceTrigger=PropertyChanged}"
                              MaskType="RegEx"
                              MaskIgnoreBlank="True"
                              AllowNullInput="True"
                              MaskUseAsDisplayFormat="True"
                              Mask="[1-9]{1}[0-9]{0,3}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Индекс"
                             Visibility="{Binding Path=VisibleIndex, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dxe:TextEdit EditValue="{Binding Path=Index, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              MaxLength="4"
                              MaskType="RegEx"
                              MaskIgnoreBlank="True"
                              AllowNullInput="True"
                              MaskUseAsDisplayFormat="True"
                              Mask="[0-9]{1,5}" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal">
            <dxlc:LayoutItem Label="Доп. инфо"
                             IsEnabled="{Binding Path=SelectNpAddressForWarehouse, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxe:TextEdit EditValue="{Binding Path=Comment, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              MaskType="RegEx"
                              IsReadOnly="{Binding Path=SelectNpAddressForWarehouse, UpdateSourceTrigger=PropertyChanged}"
                              Mask="[0-9а-яА-Яa-zA-ZіїєёІЇЄЁ][0-9а-яА-Яa-zA-ZіїєёІЇЄЁ’'\. \-\/\:]{0,39}"
                              AcceptsReturn="False"
                              MaxLength="40" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
            <dx:SimpleButton Content="OK"
                             Command="{Binding Path=OkCommand, Mode=OneTime}"
                             IsTabStop="True"
                             IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
            <dx:SimpleButton Content="Отмена"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}"
                             IsTabStop="True" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</controls:TelemartUserControl>
