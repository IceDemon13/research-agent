<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Call.CreateCallView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:themes="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Call"
                              DataContext="{client:Container Type=viewModels:CreateCallViewModel}"
                              Width="400"
                              Height="388"
                              Loaded="CreateCallViewOnLoaded"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateCallViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Priority.xaml" />
                <ResourceDictionary>
                    <system:Double x:Key="ComboBoxHeight">24</system:Double>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutControl.IsEnabled>
                <MultiBinding Mode="OneWay"
                              Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                    <Binding Path="OkCommand.IsExecuting"
                             Mode="OneWay" />
                    <Binding Path="RefreshContractorContactsCommand.IsExecuting"
                             Mode="OneWay" />
                </MultiBinding>
            </dxlc:LayoutControl.IsEnabled>
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Подразделение">
                    <dxe:ComboBoxEdit x:Name="SubdivisionComboBox"
                                      ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedSubdivision, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Path=AllowToEditSubdivision, Mode=OneWay}"
                                      DisplayMember="Name"
                                      ApplyItemTemplateToSelectedItem="True"
                                      IsTextEditable="False"
                                      Height="{StaticResource ComboBoxHeight}"
                                      ItemTemplate="{StaticResource SubdivisionComboBoxItemTemplate}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Контрагент">
                    <dxe:ComboBoxEdit x:Name="ContractorComboBox"
                                      ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedContractor, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Path=AllowToEditContractor, Mode=OneWay}"
                                      Height="{StaticResource ComboBoxHeight}"
                                      DisplayMember="Name"
                                      AllowNullInput="True"
                                      NullValue="{x:Null}"
                                      NullValueButtonPlacement="EditBox"
                                      Style="{StaticResource SearchableComboBoxStyle}">
                        <dxe:ComboBoxEdit.EditTemplate>
                            <ControlTemplate>
                                <dxlc:LayoutGroup ItemSpace="0"
                                                  Padding="0 4"
                                                  Orientation="Horizontal">
                                    <dx:DXImage Source="{Binding Path=EditValue.SubdivisionId, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}, ElementName=ContractorComboBox}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Path=Source, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                Margin="5 0 5 0"
                                                Width="16"
                                                Height="16" />
                                    <TextBox x:Name="PART_Editor"
                                             Style="{DynamicResource {themes:TextEditThemeKey ResourceKey=TextStyle}}" />
                                </dxlc:LayoutGroup>
                            </ControlTemplate>
                        </dxe:ComboBoxEdit.EditTemplate>
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <dxlc:LayoutGroup ItemSpace="0"
                                                  Orientation="Horizontal">
                                    <dx:DXImage Source="{Binding Path=SubdivisionId, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}}"
                                                Height="16"
                                                Width="16"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Margin="5,0,0,0" />
                                    <Label Content="{Binding Path=Name, Mode=OneWay}"
                                           Background="Transparent"
                                           Margin="5,0,0,0" />
                                </dxlc:LayoutGroup>
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Контакт"
                                 Visibility="{Binding Path=AllowToEditContractorContact, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit x:Name="ContractorContactComboBox"
                                      ItemsSource="{Binding Path=ContractorContacts, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedContractorContact, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                      Height="{StaticResource ComboBoxHeight}"
                                      DisplayMember="Name"
                                      AllowNullInput="True"
                                      NullValue="{x:Null}"
                                      NullValueButtonPlacement="EditBox"
                                      Style="{StaticResource SearchableComboBoxStyle}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Приоритет">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Priorities, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="{StaticResource ComboBoxHeight}"
                                      ApplyItemTemplateToSelectedItem="True"
                                      IsTextEditable="False"
                                      ItemTemplate="{StaticResource PriorityComboBoxItemTemplate}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Тип звонка">
                    <dxg:LookUpEdit ItemsSource="{Binding Path=CallTypes, Mode=OneWay}"
                                    EditValue="{Binding Path=CurrentCallType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    DisplayMember="Name"
                                    AutoPopulateColumns="False"
                                    AutoComplete="False"
                                    IncrementalFiltering="True"
                                    FilterCondition="Like"
                                    FindMode="Always"
                                    ImmediatePopup="True"
                                    Height="{StaticResource ComboBoxHeight}"
                                    IsPopupAutoWidth="True">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                   Command="{Binding Path=HandleCallTypeChangedCommand, Mode=OneWay}" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:LookUpEdit.StyleSettings>
                            <dxg:LookUpEditStyleSettings />
                        </dxg:LookUpEdit.StyleSettings>
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <dxg:GridControl Name="PART_GridControl">
                                    <dxg:GridControl.Resources>
                                        <Style TargetType="dxg:GridColumn"
                                               BasedOn="{StaticResource GeneralGridColumnStyle}">
                                        </Style>
                                    </dxg:GridControl.Resources>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="Name"
                                                        Header="Название"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        AllowResizing="False"
                                                        FixedWidth="False">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:TextEdit x:Name="PART_Editor">
                                                        <dxe:TextEdit.Style>
                                                            <Style TargetType="{x:Type dxe:TextEdit}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True"
                                                                                 Binding="{Binding Path=RowData.Row.ParentId, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter Inverse=True}}">
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </dxe:TextEdit.Style>
                                                    </dxe:TextEdit>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Position"
                                                        Header="Position"
                                                        Visible="False"
                                                        SortOrder="Ascending" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView KeyFieldName="Id"
                                                          ParentFieldName="ParentId"
                                                          AutoWidth="True"
                                                          AutoExpandAllNodes="True"
                                                          ShowIndicator="False"
                                                          UseEvenRowBackground="True"
                                                          AlternationCount="2"
                                                          AlternateRowBackground="{StaticResource AlternateRowBackgroundBrush}" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Ответственный">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      EditValue="{Binding Path=ResponsibleEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      NullText="Не задан"
                                      AllowNullInput="True"
                                      NullValueButtonPlacement="EditBox"
                                      Style="{StaticResource SearchableComboBoxStyle}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="ФИО">
                    <dxe:TextEdit EditValue="{Binding Path=Fio, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  MaxLength="100" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Телефон">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:TextEdit EditValue="{Binding Path=Phone, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource PhoneTextEdit}" />
                        <dxe:TextEdit EditValue="{Binding Path=Phone2, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource PhoneTextEdit}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Звонок">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:DateEdit EditValue="{Binding Path=CallFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      MinValue="{x:Static system:DateTime.Now}"
                                      Style="{StaticResource BasicDateEdit}" />
                        <dxe:DateEdit EditValue="{Binding Path=CallTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      MinValue="{x:Static system:DateTime.Now}"
                                      Style="{StaticResource BasicDateEdit}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Задача"
                                 LabelVerticalAlignment="Top"
                                 VerticalAlignment="Stretch">
                    <dxe:TextEdit EditValue="{Binding Path=Task, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  MinHeight="54"
                                  TextWrapping="Wrap"
                                  MaxLength="1000"
                                  AcceptsReturn="True"
                                  AcceptsTab="True"
                                  VerticalContentAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal">
                <viewComponents:WaitImage  HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="RefreshContractorContactsCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="HandleCallTypeChangedCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                            Command="{Binding Path=OkCommand, Mode=OneWay}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>