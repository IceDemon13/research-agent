<UserControl x:Class="Telemart.Client.Views.Carry.CarriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Carry"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             DataContext="{client:Container Type=viewModels:CarriesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:CarriesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                   CommandTarget="{Binding Mode=OneWay, ElementName=LayoutRoot}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneTime}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Порядок"
                                   LargeGlyph="{StaticResource Accordion32}"
                                   Command="{Binding Path=ReorderCommand, Mode=OneWay}">
                </dxb:BarButtonItem>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxlc:LayerSeparator Height="1"
                             Kind="Horizontal" />
        <dxg:GridControl x:Name="GridControl"
                         ItemsSource="{Binding Path=Carries, Mode=OneWay}"
                         CurrentItem="{Binding Path=SelectedCarry, Mode=TwoWay}"
                         ShowBorder="False"
                         SelectionMode="None"
                         AutoExpandAllGroups="True"
                         ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
            <dxmvvm:Interaction.Behaviors>
                <behaviors:LayoutSerializationBehavior FileName="carries_1.xml" />
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Код"
                                HeaderToolTip="Код способа доставки"
                                HorizontalHeaderContentAlignment="Center"
                                FieldName="Id"
                                FixedWidth="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                AllowColumnFiltering="False"
                                AllowMoving="False"
                                MinWidth="48"
                                Width="48">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Тип доставки"
                                HeaderToolTip="Тип доставки"
                                FieldName="CarryTypeId"
                                FixedWidth="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                GroupIndex="1"
                                AllowColumnFiltering="False"
                                AllowMoving="False"
                                MinWidth="100"
                                Width="100">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Название"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="Name"
                                AllowBestFit="True"
                                AllowResizing="True"
                                AllowGrouping="False"
                                AllowMoving="False"
                                AllowAutoFilter="False"
                                FixedWidth="False"
                                AllowColumnFiltering="False"
                                HorizontalHeaderContentAlignment="Left">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Название (краткое)"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="NameShort"
                                AllowBestFit="True"
                                AllowResizing="True"
                                AllowGrouping="False"
                                AllowMoving="False"
                                AllowAutoFilter="False"
                                FixedWidth="False"
                                AllowColumnFiltering="False"
                                HorizontalHeaderContentAlignment="Left">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Стоимость"
                                HeaderToolTip="Стоимость доставки"
                                FieldName="DeliveryCost"
                                FixedWidth="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                AllowColumnFiltering="False"
                                AllowMoving="False"
                                MinWidth="80"
                                Width="80">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                              MaskType="Numeric"
                                              Mask="f0"
                                              MaskUseAsDisplayFormat="True" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Лимит UAH"
                                HeaderToolTip="Лимит UAH"
                                FieldName="MaxLeftToPayUah"
                                FixedWidth="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                AllowColumnFiltering="False"
                                AllowMoving="False"
                                MinWidth="80"
                                Width="80">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                              MaskType="Numeric"
                                              Mask="c2"
                                              MaskUseAsDisplayFormat="True" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Лимит USD"
                                HeaderToolTip="Лимит USD"
                                FieldName="MaxLeftToPayUsd"
                                FixedWidth="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                AllowColumnFiltering="False"
                                AllowMoving="False"
                                MinWidth="80"
                                Width="80">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                              MaskType="Numeric"
                                              Mask="c2"
                                              MaskUseAsDisplayFormat="True" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="А"
                                HeaderToolTip="Активен"
                                HorizontalHeaderContentAlignment="Center"
                                FieldName="Active"
                                FixedWidth="True"
                                Width="24"
                                AllowBestFit="False"
                                AllowResizing="False"
                                AllowGrouping="True"
                                AllowMoving="True"
                                AllowColumnFiltering="True"
                                AllowAutoFilter="False"
                                ColumnFilterMode="DisplayText"
                                FilterPopupMode="CheckedList"
                                DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                               AllowEditing="False"
                               NavigationStyle="Cell"
                               ShowIndicator="False"
                               ShowAutoFilterRow="False"
                               AllowSorting="False"
                               ShowFixedTotalSummary="False"
                               IsTotalSummaryMenuEnabled="False"
                               ShowTotalSummary="False"
                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                               Command="{Binding Path=EditCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem SummaryType="Count"
                                     Alignment="Right"
                                     Visible="True" />
            </dxg:GridControl.GroupSummary>
        </dxg:GridControl>
    </dxlc:LayoutControl>

</UserControl>

