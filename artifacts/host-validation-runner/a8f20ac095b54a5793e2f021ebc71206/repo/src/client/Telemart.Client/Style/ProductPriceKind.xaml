<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="1Image"
                 UriSource="/Images/Common/1.png" />
    <BitmapImage x:Key="2Image"
                 UriSource="/Images/Common/2.png" />
    <BitmapImage x:Key="3Image"
                 UriSource="/Images/Common/3.png" />
    <BitmapImage x:Key="4Image"
                 UriSource="/Images/Common/4.png" />
    <BitmapImage x:Key="5Image"
                 UriSource="/Images/Common/5.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="ProductPriceKindImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource 1Image}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource 2Image}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource 3Image}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource 4Image}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource 5Image}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="ProductPriceKindComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:ProductPriceKind}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent">
            <dx:DXImage Source="{Binding Path=PriceColumn, Mode=OneWay, Converter={StaticResource ProductPriceKindImageConverter}}"
                        Height="16"
                        Width="16"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>