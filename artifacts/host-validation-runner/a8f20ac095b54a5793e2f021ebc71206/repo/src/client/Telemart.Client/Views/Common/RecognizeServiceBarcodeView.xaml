<UserControl x:Class="Telemart.Client.Views.Common.RecognizeServiceBarcodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Common.RecognizeServiceBarcode"
             Loaded="RecognizeBarcodeViewOnLoaded"
             IsEnabledChanged="RecognizeBarcodeViewOnIsEnabledChanged"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:RecognizeServiceBarcodeViewModel}}"
             d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="1"
            BorderBrush="DarkGray"
            UseLayoutRounding="True">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Padding="0"
                            ItemSpace="-1"
                            AllowVerticalSizing="True"
                            AllowItemSizing="True"
                            Background="{Binding Path=IsKeyboardFocusWithin, Mode=OneWay, ElementName=BarcodeTextEdit, Converter={StaticResource IsFocusedToColorConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Header="Штрих-код:"
                              View="GroupBox"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup.GroupBoxStyle>
                    <Style TargetType="{x:Type dxlc:GroupBox}">
                        <Setter Property="BorderThickness"
                                Value="0" />
                    </Style>
                </dxlc:LayoutGroup.GroupBoxStyle>
                <dxlc:LayoutItem>
                    <dxe:TextEdit x:Name="BarcodeTextEdit"
                                  EditValue="{Binding Path=BarcodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  CharacterCasing="Upper"
                                  GotFocus="BarcodeTextEditOnGotFocus">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                 Command="{Binding Path=RecognizeBarcodeCommand, Mode=OneWay}"
                                                 CommandParameter="{Binding Path=BarcodeText, Mode=OneWay }" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Border>
</UserControl>

