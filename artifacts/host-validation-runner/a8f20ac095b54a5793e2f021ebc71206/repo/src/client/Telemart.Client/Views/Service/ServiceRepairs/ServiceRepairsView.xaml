<controls:TelemartUserControl x:Class="Telemart.Client.Views.Service.ServiceRepairs.ServiceRepairsView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls1="clr-namespace:Telemart.Client.Controls"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs"
                              xmlns:controlswiki="clr-namespace:Telemart.Client.Controls"
                              DataContext="{client:Container Type=viewModels:ServiceRepairsViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ServiceRepairsViewModel}}"
                              d:DesignWidth="1024"
                              d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding Path=FormInvoiceCommand, Mode=OneWay}"
                    Gesture="Alt+I" />
    </UserControl.InputBindings>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarSplitButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditServiceRepairCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Path=CurrentItem, ElementName=GridControl}"
                                   GlyphAlignment="Top">
                    <dxb:BarSplitButtonItem.PopupControl>
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Статус (F8)"
                                               ToolTip="Статус (F8)"
                                               Glyph="../../../Images/Common/lightbulb.png"
                                               Command="{Binding Path=ChangeStateCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentItem, ElementName=GridControl}" />
                        </dxb:PopupMenu>
                    </dxb:BarSplitButtonItem.PopupControl>
                </dxb:BarSplitButtonItem>
                <dxb:BarButtonItem Content="Накладная"
                                   ToolTip="Накладная (Alt+I)"
                                   LargeGlyph="/Images/ServiceRequest/page_wrench_32x32.png"
                                   Command="{Binding Path=FormInvoiceCommand, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <controlswiki:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel x:Name="Center"
                                      Style="{StaticResource PanelStyle}"
                                      ShowBorder="False">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Repairs, Mode=OneWay}"
                                         CurrentItem="{Binding Path=CurrentServiceRepair, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ShowBorder="True"
                                         ClipboardCopyMode="ExcludeHeader"
                                         SelectionMode="None"
                                         AutoExpandAllGroups="True">
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="RefreshCommand.IsExecuting" />
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="service_repairs_1.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Id"
                                                Header="Номер"
                                                HeaderToolTip="Номер ремонта"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                AllowEditing="False"
                                                MinWidth="40"
                                                Width="60"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="DisplayProductName"
                                                Header="Название"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="SerialNumber"
                                                Header="SN"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="120"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Defect"
                                                Header="Дефект"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Left"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                FixedWidth="False"
                                                MinWidth="60"
                                                Width="120"
                                                MaxWidth="300"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=RowData.Row.Defect, Mode=OneWay, Converter={converters:MultiLineToSingleLineTextConverter}}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="5 0 0 0" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Visibility="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget, Converter={converters:TrimmedTextBlockVisibilityConverter}}">
                                                        <ToolTip.Content>
                                                            <TextBlock Text="{Binding Path=RowData.Row.Defect}"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="200" />
                                                        </ToolTip.Content>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceRequestId"
                                                Header="Заявка"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                AllowEditing="False"
                                                MinWidth="40"
                                                Width="70"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceRequestPurchasedFrom"
                                                Header="Поставщик"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                AllowEditing="False"
                                                MinWidth="40"
                                                Width="100"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                                                  DisplayMember="DisplayValue"
                                                                  ValueMember="Id"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceRequestSubdivision"
                                                Header="Подразделение"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="26"
                                                Width="26"
                                                AllowGrouping="True"
                                                AllowSorting="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                DisplayTemplate="{StaticResource SubdivisionColumnDisplayTemplate}">
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Принята"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="ServiceRequestReceivedOn"
                                                MinWidth="24"
                                                Width="70"
                                                AllowGrouping="True"
                                                AllowAutoFilter="False"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="dd.MM.yy"
                                                              MaskType="DateTime" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Создан"
                                                HeaderToolTip="Дата создания ремонта"
                                                FieldName="CreatedOn"
                                                MinWidth="24"
                                                Width="70"
                                                AllowGrouping="True"
                                                AllowAutoFilter="False"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="dd.MM.yy"
                                                              MaskType="DateTime" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceRequestWarehouseLocationId"
                                                Header="Склад"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="115"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                Visible="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceCenterId"
                                                Header="СЦ"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="True"
                                                Width="85"
                                                MinWidth="40"
                                                AllowBestFit="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                GroupInterval="DisplayText"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=DataContext.ServiceCenters, Mode=OneWay, ElementName=GridControl}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceInvoiceId"
                                                Header="Накладная"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                AllowEditing="False"
                                                MinWidth="40"
                                                Width="100"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="State.Name"
                                                Header="Статус"
                                                HeaderToolTip="Статус ремонта"
                                                FixedWidth="True"
                                                AllowEditing="False"
                                                MinWidth="40"
                                                Width="80"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                AllowSorting="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText">
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True"
                                               AllowEditing="False"
                                               NavigationStyle="Cell"
                                               ShowIndicator="False"
                                               ShowAutoFilterRow="False"
                                               ShowFixedTotalSummary="False"
                                               IsTotalSummaryMenuEnabled="True"
                                               AllowColumnMoving="True"
                                               ShowTotalSummary="False"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="ShowFilterPopup"
                                                               Command="{Binding Path=ShowFilterPopupHandlerCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding OnTableViewRowDoubleClickCommand}"
                                                               PassEventArgsToCommand="True"/>
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="State.Name" Expression="[State.Id] = 2">
                                            <dxg:FormatCondition.Format>
                                                <dx:Format Background="{StaticResource LightGreenColor}"
                                                           Foreground="Black"/>
                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition FieldName="State.Name" Expression="[State.Id] = 1">
                                            <dxg:FormatCondition.Format>
                                                <dx:Format Background="{StaticResource RoseColor}"
                                                           Foreground="Black"/>
                                            </dxg:FormatCondition.Format>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Заявка">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Call/toolbox.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls1:FilterNumbersPrintTextEdit  EditValue="{Binding Path=Filter.RequestNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls1:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Накладная">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/cheque.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls1:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.InvoiceNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls1:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Название">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Parser/book_16_16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:TextEdit EditValue="{Binding Path=Filter.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:TextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Склад">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/ServiceRequest/house_wrench_16x16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Warehouses, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="Name"
                                                      ValueMember="Id"
                                                      Style="{StaticResource SearchableComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="СЦ">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/NavigationMenu/wrench.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.ServiceCenters, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedServiceCenterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="Name"
                                                      ValueMember="Id"
                                                      AllowNullInput="True"
                                                      NullValueButtonPlacement="EditBox"
                                                      Style="{StaticResource SearchableComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.States, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      EditValue="{Binding Path=Filter.SelectedStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Ремонтов">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Repairs.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>

</controls:TelemartUserControl>