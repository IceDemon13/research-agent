<UserControl x:Class="Telemart.Client.Views.Directories.Contractor.SupplierWarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Contractor"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             Width="370"
             DataContext="{client:Container Type=viewModels:SupplierWarehouseViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:SupplierWarehouseViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded" Command="{Binding HandleLoadedCommand}"/>
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        dxe:ValidationService.IsValidationContainer="True"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        ItemSpace="8">
        <dxlc:LayoutGroup Name="Center" Orientation="Vertical">
            <dxlc:LayoutItem Label="Название">
                <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                              MaxLength="20"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Город">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="Id"
                                  IsTextEditable="True"
                                  ImmediatePopup="True"
                                  IncrementalFiltering="True"
                                  ValidateOnTextInput="False"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Кр. название">
                <dxe:TextEdit EditValue="{Binding Path=Model.ShortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="20"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Код Pricer24">
                <dxe:TextEdit EditValue="{Binding Path=Model.Pricer24Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Описание"
                             LabelVerticalAlignment="Top"
                             VerticalAlignment="Stretch">
                <dxe:ComboBoxEdit EditValue="{Binding Path=Model.SupplierWarehouseAvails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:StringCollectionConverter ToObservable=True}}"
                                  ValidateOnTextInput="True"
                                  ValidateOnEnterKeyPressed="True"
                                  AllowDefaultButton="False"
                                  Style="{StaticResource TokenComboBoxStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Активный"
                             VerticalAlignment="Stretch">
                <dxe:CheckEdit EditValue="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                               IsThreeState="False"
                               VerticalAlignment="Center"/>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="OK"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"/>
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}"/>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>