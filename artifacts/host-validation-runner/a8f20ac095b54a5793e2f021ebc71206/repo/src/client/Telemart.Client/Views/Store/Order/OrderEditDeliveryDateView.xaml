<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.OrderEditDeliveryDateView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              DataContext="{client:Container Type=viewModels:OrderEditDeliveryDateViewModel}"
                              Width="500"
                              Height="360"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderEditDeliveryDateViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="InnerTextStyle"
                           TargetType="{x:Type TextBlock}">
                        <Setter Property="Text"
                                Value="-" />
                        <Setter Property="Width"
                                Value="8" />
                        <Setter Property="TextAlignment"
                                Value="Center" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Текущая">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:DateEdit EditValue="{Binding Path=CurrentDeliveryDateFrom, Mode=OneWay}"
                                      AllowRoundOutOfRangeValue="False"
                                      AllowDefaultButton="False"
                                      NullText="{Binding NullText, Mode=OneWay }"
                                      Style="{StaticResource ReadOnlyDateEditorStyle}" />
                        <TextBlock Style="{StaticResource InnerTextStyle}" />
                        <dxe:DateEdit EditValue="{Binding Path=CurrentDeliveryDateTo, Mode=OneWay}"
                                      AllowRoundOutOfRangeValue="False"
                                      AllowDefaultButton="False"
                                      NullText="{Binding NullText, Mode=OneWay }"
                                      Style="{StaticResource ReadOnlyDateEditorStyle}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Расчетная"
                                 Visibility="{Binding Path= CalculatedDeliveryVisibility , Converter={dx:BooleanToVisibilityConverter}}">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:DateEdit EditValue="{Binding Path=CalculatedDeliveryDateFrom, Mode=OneWay}"
                                      AllowRoundOutOfRangeValue="False"
                                      AllowDefaultButton="False"
                                      Style="{StaticResource ReadOnlyDateEditorStyle}" />
                        <TextBlock Style="{StaticResource InnerTextStyle}" />
                        <dxe:DateEdit EditValue="{Binding Path=CalculatedDeliveryDateTo, Mode=OneWay}"
                                      AllowRoundOutOfRangeValue="False"
                                      AllowDefaultButton="False"
                                      Style="{StaticResource ReadOnlyDateEditorStyle}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новая">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:DateEdit EditValue="{Binding Path=SelectedDeliveryDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MinValue="{x:Static system:DateTime.Today}"
                                      Style="{StaticResource BasicDateEdit}"
                                      NullValueButtonPlacement="EditBox"
                                      ShowClearButton="False"
                                      AllowNullInput="True"
                                      NullValue="{x:Null}" />
                        <TextBlock Style="{StaticResource InnerTextStyle}" />
                        <dxe:DateEdit EditValue="{Binding Path=SelectedDeliveryDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MinValue="{x:Static system:DateTime.Today}"
                                      Style="{StaticResource BasicDateEdit}"
                                      NullValueButtonPlacement="EditBox"
                                      ShowClearButton="False"
                                      AllowNullInput="True"
                                      NullValue="{x:Null}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Причина"
                                 LabelVerticalAlignment="Top"
                                 VerticalAlignment="Stretch">
                    <common:OrderChangeStateReasonsView Reasons="{Binding Path=ChangeReasons, Mode=OneWay}"
                                                        CurrentReason="{Binding Path=CurrentChangeReason, Mode=TwoWay}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Width="90"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsTabStop="True"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:FocusBehavior />
                        </dxmvvm:Interaction.Behaviors>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>