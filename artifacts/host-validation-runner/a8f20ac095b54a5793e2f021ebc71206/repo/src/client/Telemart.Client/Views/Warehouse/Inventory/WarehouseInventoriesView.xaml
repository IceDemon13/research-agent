<UserControl x:Class="Telemart.Client.Views.Warehouse.Inventory.WarehouseInventoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:inventory="clr-namespace:Telemart.Client.ViewModels.Warehouse.Inventory"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             mc:Ignorable="d"
             x:Name="CurrentUserControl"
             DataContext="{client:Container Type=inventory:WarehouseInventoriesViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type inventory:WarehouseInventoriesViewModel}}"
             d:DesignHeight="768"
             d:DesignWidth="1024">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         SplashScreenLocation="CenterScreen">
        <dx:LoadingDecorator.IsSplashScreenShown>
            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                <Binding Path="HandleLoadedCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="RefreshCommand.IsExecuting"
                         Mode="OneWay" />
            </MultiBinding>
        </dx:LoadingDecorator.IsSplashScreenShown>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <dxb:BarManager Grid.Row="0">
                <dxb:ToolBarControl>
                    <dxb:ToolBarControl.IsEnabled>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="RefreshCommand.IsExecuting"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </dxb:ToolBarControl.IsEnabled>
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding ElementName=InventoriesGrid, Path=View}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Создать"
                                       ToolTip="Создать (Insert)"
                                       LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=AddCommand, Mode=OneWay}"
                                       GlyphAlignment="Top">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Изменить"
                                       ToolTip="Изменить (F2)"
                                       LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                       Command="{Binding Path=EditCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
            <dxdo:DockLayoutManager Grid.Row="1">
                <dxdo:LayoutGroup>
                    <dxdo:LayoutPanel AllowActivate="False"
                                      AllowClose="False"
                                      AllowContextMenu="False"
                                      AllowDock="False"
                                      AllowDrag="False"
                                      AllowFloat="False"
                                      AllowHide="False"
                                      AllowMaximize="False"
                                      AllowMinimize="False"
                                      AllowMove="False"
                                      AllowRestore="False"
                                      AllowRename="False"
                                      AllowSizing="False"
                                      FloatOnDoubleClick="False">
                        <dxg:GridControl x:Name="InventoriesGrid"
                                         ItemsSource="{Binding Path=Inventories, Mode=OneWay}"
                                         SelectedItem="{Binding Path=SelectedInventory, Mode=TwoWay}"
                                         ShowBorder="False">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="inventories_1.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Id"
                                                Header="Номер"
                                                FixedWidth="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="False"
                                                AllowColumnFiltering="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CreatedOn"
                                                Header="Дата"
                                                HeaderToolTip="Дата создания"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                MinWidth="80"
                                                FixedWidth="True"
                                                GroupInterval="Date"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              NullText=""
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="dd.MM.yyyy HH:mm"
                                                              MaskType="DateTime">
                                        </dxe:DateEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Warehouse.Name"
                                                Header="Склад"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                MinWidth="80"
                                                Width="120"
                                                HorizontalHeaderContentAlignment="Stretch" />
                                <dxg:GridColumn FieldName="CreatedByEmployeeName"
                                                Header="Создал"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                Width="120"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Stretch" />
                                <dxg:GridColumn FieldName="Comment"
                                                Header="Комментарий"
                                                AllowBestFit="True"
                                                FixedWidth="False"
                                                MinWidth="60"
                                                AllowGrouping="False"
                                                HorizontalHeaderContentAlignment="Stretch" />
                                <dxg:GridColumn Header="З"
                                                HorizontalHeaderContentAlignment="Center"
                                                HeaderToolTip="Заблокировал"
                                                FieldName="EmployeeLock.ShortName"
                                                FixedWidth="True"
                                                Width="24"
                                                MinWidth="24"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowAutoFilter="False"
                                                AllowSorting="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/lock.png"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Path=RowData.Row.EmployeeLockId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                        HorizontalAlignment="Center">
                                                <dx:DXImage.ToolTip>
                                                    <ToolTip>
                                                        <dxlc:LayoutControl Orientation="Vertical">
                                                            <dxlc:LayoutControl.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight"
                                                                            Value="Bold"/>
                                                                </Style>
                                                            </dxlc:LayoutControl.Resources>
                                                            <dxlc:LayoutItem Label="Заблокировал:">
                                                                <TextBlock Text="{Binding Path=RowData.Row.EmployeeLock.Name, Mode=OneWay}"></TextBlock>
                                                            </dxlc:LayoutItem>
                                                        </dxlc:LayoutControl>
                                                    </ToolTip>
                                                </dx:DXImage.ToolTip>
                                            </dx:DXImage>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                                <dxg:GridColumn Header="В"
                                                HorizontalHeaderContentAlignment="Center"
                                                HeaderToolTip="Выполнена"
                                                FieldName="IsCompleted"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                FixedWidth="True"
                                                AllowAutoFilter="False"
                                                Width="24"
                                                MinWidth="24"
                                                AllowMoving="True"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="True">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/tick.png"
                                                        Height="16"
                                                        Width="16"
                                                        Visibility="{Binding Path=RowData.Row.IsCompleted, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ToolTip="Выполнена">
                                            </dx:DXImage>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView ShowTotalSummary = "False"
                                               ShowGroupPanel="True"
                                               ShowIndicator="False"
                                               ShowGroupFooters="False"
                                               ShowFixedTotalSummary="False"
                                               ShowAutoFilterRow="False"
                                               ShowSearchPanelMode="Never"
                                               AllowResizing="True"
                                               IsColumnMenuEnabled="False"
                                               AllowColumnFiltering="False"
                                               NavigationStyle="Cell"
                                               AutoWidth="True"
                                               AllowEditing="False"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=EditCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="335"
                                      MinWidth="335"
                                      MaxWidth="500"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Orientation="Vertical"
                                                    ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Номер">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/house_table.png"
                                                                Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.InventoryNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                     Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Дата">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/calendar.png"
                                                                Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                          VerticalAlignment="Center">
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.DateAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" />
                                        <TextBlock Text="-"
                                                       Width="8"
                                                       TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.DateBefore, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" />
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>

                                <dxlc:LayoutItem Label="Склад">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/house.png"
                                                                Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Warehouses, Mode=OneWay}"
                                                          EditValue="{Binding Path=Filter.SelectedWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMember="DisplayValue"
                                                          Style="{StaticResource TokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Инвент.">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Inventories.Count, Mode=OneWay}"
                                                       FontWeight="Bold" />
                                        <TextBlock Text=" шт."/>
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                           Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                           Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                           GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                           Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                           Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                           GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </dx:LoadingDecorator>

</UserControl>