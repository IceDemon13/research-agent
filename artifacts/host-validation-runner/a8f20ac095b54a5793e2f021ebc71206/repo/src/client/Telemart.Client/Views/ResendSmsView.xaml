<controls:TelemartUserControl x:Class="Telemart.Client.Views.ResendSmsView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              Width="500"
                              Height="265"
                              DataContext="{client:Container Type=viewModels:ResendSmsViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ResendSmsViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ReadOnlyPhoneTextEdit"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource PhoneTextEdit}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="0.6" />
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding Path=DataContext.Phone, ElementName=CurrentUserControl, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="PhoneTextEdit"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource PhoneTextEdit}">
                        <Setter Property="IsReadOnly"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="0.6" />
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding Path=DataContext.ActualPhone, ElementName=CurrentUserControl, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            dxe:ValidationService.IsValidationContainer="True"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Vertical">

                <dxlc:LayoutItem Label="Телефон (текущий)">
                    <dxe:TextEdit Text="{Binding Path=Phone, Mode=OneWay}"
                                  IsPrintingMode="True"
                                  Style="{StaticResource ReadOnlyPhoneTextEdit}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Телефон (новый)">
                    <dxe:TextEdit Text="{Binding Path=ActualPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource PhoneTextEdit}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Способ отправки">
                    <dxe:TextEdit Text="{Binding Path=SendMessageType.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  VerticalContentAlignment="Top"
                                  IsReadOnly="True"
                                  Style="{StaticResource ReadOnlyConditionsStyle}">
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Текст"
                                 Height="100"
                                 LabelVerticalAlignment="Top">
                    <dxe:TextEdit Text="{Binding Path=Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  VerticalContentAlignment="Top"
                                  IsReadOnly="True"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ReadOnlyConditionsStyle}">
                    </dxe:TextEdit>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                    <Button Content="Отправить"
                            Width="106"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=ValidationContainer, Converter={dx:NegationConverter}}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../Images/Order/Menu/mail_yellow.png"
                                                Stretch="Fill" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Отмена"
                            Width="103"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>