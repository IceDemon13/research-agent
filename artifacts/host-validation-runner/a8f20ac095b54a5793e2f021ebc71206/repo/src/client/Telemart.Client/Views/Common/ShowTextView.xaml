<controls:TelemartUserControl x:Class="Telemart.Client.Views.Common.ShowTextView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:common="clr-namespace:Telemart.Client.ViewModels.Common"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              DataContext="{client:Container Type=common:ShowTextViewModel}"
                              Width="350"
                              MaxHeight="500"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type common:ShowTextViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl Orientation="Vertical"
                            x:Name="ValidationContainer"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="450">
                <TextBlock Text="{Binding Body}"
                           FontFamily="{Binding Font}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="Печать"
                        Command="{Binding Path=PrintCommand}"
                        Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />

                <Button Content="OK"
                        Command="{Binding Path=OkCommand}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError),
                                            ElementName=ValidationContainer,
                                            Converter={dxmvvm:BooleanNegationConverter}}" />
            </dxlc:LayoutGroup>

        </dxlc:LayoutControl>


    </dx:LoadingDecorator>
</controls:TelemartUserControl>