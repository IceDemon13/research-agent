<UserControl x:Class="Telemart.Client.Views.SupplierBill.SupplierBillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.SupplierBill"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:SupplierBillsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SupplierBillsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dx:DialogService x:Name="CreateSupplierBillWizardDialogService"
                          SetWindowOwner="True"
                          DialogWindowStartupLocation="CenterOwner">
            <dx:DialogService.ViewTemplate>
                <DataTemplate>
                    <Grid>
                        <dxco:Wizard AnimationType="SlideHorizontal">
                            <dxmvvm:Interaction.Behaviors>
                                <dxco:WizardService />
                                <dxmvvm:CurrentWindowService Window="{Binding Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
                                <dxmvvm:EventToCommand EventName="Loaded"
                                                       Command="{Binding Path=HandleWizardLoadedCommand, Mode=OneTime}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxco:Wizard>
                    </Grid>
                </DataTemplate>
            </dx:DialogService.ViewTemplate>
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="WindowStyle"
                            Value="SingleBorderWindow" />
                    <Setter Property="ResizeMode"
                            Value="CanResizeWithGrip" />
                    <Setter Property="Width"
                            Value="800" />
                    <Setter Property="Height"
                            Value="450" />
                    <Setter Property="MinWidth"
                            Value="500" />
                    <Setter Property="MinHeight"
                            Value="306" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   ToolTip="Создать (Insert)"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddCommand, Mode=OneTime}" />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}">
                </dxb:BarButtonItem>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0"
                              Margin="0">
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Padding="0"
                                  MinHeight="230"
                                  Style="{StaticResource PanelStyle}">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Bills, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedBill, Mode=TwoWay}"
                                     ShowBorder="False"
                                     SelectionMode="None"
                                     AutoExpandAllGroups="True"
                                     ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="Supplier_bill_1.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Код"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Id"
                                            FixedWidth="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            MinWidth="48"
                                            Width="48">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Накладная"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="InvoiceId"
                                            FixedWidth="True"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            MinWidth="75"
                                            Width="75">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата"
                                            HeaderToolTip="Дата выставления счета"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="InvoicedOn"
                                            FixedWidth="True"
                                            Width="80"
                                            MinWidth="80"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="Date">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.DateFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Поставщик"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="SupplierId"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Suppliers, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="ЕДРПОУ"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Edrpou"
                                            Width="90"
                                            FixedWidth="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="False"
                                            AllowSorting="False"
                                            AllowBestFit="True" />
                            <dxg:GridColumn Header="Номер"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Number"
                                            MinWidth="90"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowBestFit="True"
                                            FilterPopupMode="CheckedList" />
                            <dxg:GridColumn Header="Сумма"
                                            HeaderToolTip="Сумма с НДС"
                                            HorizontalHeaderContentAlignment="Right"
                                            FieldName="TotalPriceTax"
                                            FixedWidth="True"
                                            Width="70"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowSorting="False"
                                            AllowColumnFiltering="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                                          MaskSaveLiteral="False"
                                                          IsFloatValue="True"
                                                          AllowDefaultButton="False"
                                                          HorizontalContentAlignment="Right" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Валюта"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="CurrencyId"
                                            Width="36"
                                            FixedWidth="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Currencies}"
                                                              DisplayMember="Title"
                                                              ValueMember="Id"
                                                              HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="StateId"
                                            FixedWidth="True"
                                            Width="100"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="Value"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=States, Mode=OneWay}"
                                                              DisplayMember="Name"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="C"
                                            HeaderToolTip="Скан счета"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="AnyBillDocuments"
                                            FixedWidth="True"
                                            Width="24"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Р"
                                            HeaderToolTip="Скан расходной накладной"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="AnyInvoiceDocuments"
                                            FixedWidth="True"
                                            Width="24"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           IsTotalSummaryMenuEnabled="False"
                                           ShowTotalSummary="False"
                                           AllowGrouping="True"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                        </dxg:GridControl.GroupSummary>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Код">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/NavigationMenu/receipt_invoice.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.BillIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Номер">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/document_hash_tag.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Накладная">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/cheque.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.InvoiceIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Поставщик">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/user.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Suppliers, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedSuppliers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="DisplayValue"
                                                      ValueMember="Id"
                                                      Style="{StaticResource TokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.States, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      ValueMember="Id"
                                                      EditValue="{Binding Path=Filter.SelectedStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Счетов">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Bills.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>
</UserControl>