<UserControl x:Class="Telemart.Client.Views.Directories.Employee.CreateEmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Employee"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             DataContext="{client:Container Type=viewModels:CreateEmployeeViewModel}"
             Width="500"
             Height="600"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateEmployeeViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Фамилия (кириллица)">
                    <dxe:TextEdit Text="{Binding Path=Surname, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Имя (кириллица)">
                    <dxe:TextEdit Text="{Binding Path=Name, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Фамилия (транслит)">
                    <dxe:TextEdit Text="{Binding Path=SurnameTranslit, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Имя (транслит)">
                    <dxe:TextEdit Text="{Binding Path=NameTranslit, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Телефон">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:TextEdit Text="{Binding Path=Phone1, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource PhoneTextEdit}" />
                        <dxe:TextEdit Text="{Binding Path=Phone2, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource PhoneTextEdit}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Skype">
                    <dxe:TextEdit Text="{Binding Path=Skype, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Telegram">
                    <dxe:TextEdit Text="{Binding Path=Telegram, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Подразделение">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Subdivisions}"
                                      EditValue="{Binding Path=SelectedSubdivision, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ItemTemplate="{StaticResource SubdivisionComboBoxItemTemplate}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Отдел">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Departments, Mode=OneWay}"
                                      EditValue="{Binding Path= DepartmentId, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Должность">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Positions, Mode=OneWay}"
                                      EditValue="{Binding Position, Mode=TwoWay}"
                                      FilterCondition="Contains"
                                      ImmediatePopup="True"
                                      AllowDrop="False"
                                      ValidateOnTextInput="False"
                                      IncrementalFiltering="True"
                                      IsTextEditable="True"
                                      Validate="BaseEditOnValidate" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Город">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Пароль">
                    <dxlc:LayoutGroup ItemSpace="2">
                        <dxe:PasswordBoxEdit EditValue="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Visibility="{Binding Path=ShowPasswordSymbols, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}" />
                        <dxe:TextEdit EditValue="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Visibility="{Binding Path=ShowPasswordSymbols, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                        <Button Command="{Binding Path=GeneratePasswordCommand, Mode=OneWay}"
                                ToolTip="Сгенерировать пароль"
                                Style="{StaticResource NoBordersButton}">
                            <dx:DXImage Source="{StaticResource Lightning16}" />
                        </Button>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Подтверждение пароля">
                    <dxlc:LayoutGroup ItemSpace="2">
                        <dxe:PasswordBoxEdit Text="{Binding Path=PasswordConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Visibility="{Binding Path=ShowPasswordSymbols, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}" />
                        <dxe:TextEdit Text="{Binding Path=PasswordConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Visibility="{Binding Path=ShowPasswordSymbols, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                        <Button Command="{Binding Path=ShowPasswordSymbolsCommand, Mode=OneWay}"
                                ToolTip="Показать пароль"
                                Style="{StaticResource NoBordersButton}">
                            <dx:DXImage Source="{StaticResource Eye16}" />
                        </Button>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>

                <dxlc:LayoutGroup Orientation="Horizontal"
                                  ItemLabelsAlignment="Local">
                    <dxlc:LayoutItem Label="Касса" Width="92">
                        <dxe:CheckEdit EditValue="{Binding Path=CreateCashbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       IsThreeState="False"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Склад">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                          EditValue="{Binding Path= WarehouseId, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          HorizontalContentAlignment="Left"
                                          AllowNullInput="True"
                                          IsReadOnly="{Binding AllowSetWarehouse, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  ItemSpace="5">
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutItem Label="Почта">
                            <dxe:CheckEdit Content="{Binding Path=Email, Mode=OneWay}"
                                           EditValue="{Binding Path=CreateEmail, Mode=OneWay}"
                                           IsEnabled="False" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Удаленка">
                            <dxe:CheckEdit Content="{Binding Path=Login, Mode=OneWay}"
                                           EditValue="{Binding Path=CreateAccount1C, Mode=OneWay}"
                                           IsEnabled="False" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Битрикс">
                            <dxe:CheckEdit Content="{Binding Path=FullName, Mode=OneWay}"
                                           EditValue="{Binding Path=CreateAccontBitrix, Mode=OneWay}"
                                           IsEnabled="False" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="1С">
                            <dxe:CheckEdit EditValue="{Binding Path=CreateAccount1C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutItem Label="Telemart.ua">
                            <dxe:CheckEdit EditValue="{Binding Path=CreateAccountTelemart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                           IsEnabled="False" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Контрагент">
                            <dxe:CheckEdit EditValue="{Binding Path=CreateContractor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Сайт">
                            <dxe:CheckEdit EditValue="{Binding Path=CreateSiteCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsThreeState="False" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Доступ к инфо на сайте">
                            <dxe:CheckEdit EditValue="{Binding Path=CreateInfoSite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsThreeState="False"
                                           IsEnabled="{Binding AllowSetInfoSite}"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="Создать"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=ValidationContainer, Converter={dx:NegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>