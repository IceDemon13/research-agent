<UserControl x:Class="Telemart.Client.Views.Quotas.QuotasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dialogs="clr-namespace:Telemart.Client.ViewModels.Quotas"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             DataContext="{client:Container Type=dialogs:QuotasViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type dialogs:QuotasViewModel}}"
             d:DesignHeight="450" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0">
                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                    <dxb:BarButtonItem Content="Обновить"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshQuotasCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Добавить"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=AddQuotasCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Редактировать"
                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                       Command="{Binding Path=EditQuotaCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=QuotasGridControl}" />
                    <dxb:BarButtonItem Content="Удалить"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       Command="{Binding Path=DeleteQuotaCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=QuotasGridControl}" />
                </dxb:ToolBarControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup>
                <dxg:GridControl x:Name="QuotasGridControl"
                                 ItemsSource="{Binding Quotas, Mode=OneWay}"
                                 CurrentItem="{Binding SelectedQuotaViewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 SelectionMode="Row">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Дата"
                                        HeaderToolTip="Дата квоты"
                                        FieldName="QuotaDate"
                                        AllowResizing="True"
                                        FixedWidth="False"
                                        HorizontalHeaderContentAlignment="Center"
                                        MinWidth="60"
                                        MaxWidth="300"
                                        Width="70"
                                        ReadOnly="True"
                                        AllowMoving="True"
                                        AllowEditing="False"
                                        AllowColumnFiltering="False"
                                        AllowGrouping="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                      NullText=""
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="MM.yy"
                                                      MaskType="DateTime">
                                    <dxe:DateEditSettings.NullValue>
                                        <system:DateTime>1.0001</system:DateTime>
                                    </dxe:DateEditSettings.NullValue>
                                </dxe:DateEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Отдел"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="DepartmentId"
                                        MinWidth="60"
                                        MaxWidth="300"
                                        Width="160"
                                        AllowResizing="True"
                                        AllowBestFit="True"
                                        AllowGrouping="True"
                                        AllowMoving="True"
                                        AllowColumnFiltering="True"
                                        ColumnFilterMode="DisplayText"
                                        FilterPopupMode="CheckedList"
                                        AllowAutoFilter="False"
                                        FixedWidth="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Departments, Mode=OneWay}"
                                                          ValueMember="Id"
                                                          DisplayMember="DisplayValue"
                                                          HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Квота,ч."
                                        HeaderToolTip="Квота в часах"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="Value"
                                        FixedWidth="False"
                                        AllowResizing="True"
                                        AllowBestFit="False"
                                        AllowGrouping="False"
                                        AllowEditing="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        MinWidth="60"
                                        Width="60"
                                        MaxWidth="200">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Right"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Создана"
                                            HeaderToolTip="Дата создания квоты"
                                            FieldName="CreatedOn"
                                            Width="95"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            GroupInterval="Date"
                                            FixedWidth="True"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создал"
                                            HeaderToolTip="Создал квоту"
                                            FieldName="CreatedBy"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="60"
                                            Width="100"
                                            MaxWidth="300"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Left">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       AllowBestFit="True"
                                       AllowEditing="False"
                                       AllowResizing="False"
                                       AllowPerPixelScrolling="True"
                                       ShowGroupPanel="True"
                                       AllowGrouping="False"
                                       AllowDrop="False"
                                       AllowMoveColumnToDropArea="False"
                                       ShowIndicator="False"
                                       AutoWidth="True"
                                       AllowFilterEditor="False"
                                       AllowColumnFiltering="False"
                                       AllowColumnMoving="False"
                                       NavigationStyle="Row"
                                       IsColumnMenuEnabled="False">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=GridControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>