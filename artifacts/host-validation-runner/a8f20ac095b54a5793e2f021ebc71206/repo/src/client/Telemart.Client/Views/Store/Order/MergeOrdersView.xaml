<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.MergeOrdersView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:order="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:transferObjects="clr-namespace:Telemart.Client.TransferObjects;assembly=Telemart.Client.TransferObjects"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              DataContext="{client:Container Type=order:MergeOrdersViewModel}"
                              Width="470"
                              MaxWidth="470"
                              MaxHeight="250"
                              Height="250"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type order:MergeOrdersViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand}" />
        <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                               Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                               PassEventArgsToCommand="True" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsVisibleChanged="LayoutControlIsVisibleChanged"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Name="Center"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup Height="126"
                                  VerticalAlignment="Top"
                                  MaxWidth="180">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=OrdersToMerge, Mode=OneWay, ValidatesOnDataErrors=True}"
                                     SelectedItems="{Binding Path=SelectedOrdersToMerge, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                     SelectionMode="Row"
                                     ShowBorder="True"
                                     DesignTimeDataObjectType="{x:Type transferObjects:OrderDto}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Resources>
                            <Style TargetType="dxg:GridColumn"
                                   BasedOn="{StaticResource GeneralGridColumnStyle}" />
                        </dxg:GridControl.Resources>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Заказ"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Id"
                                            Width="60"
                                            FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата X"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="DeliveryTime"
                                            FixedWidth="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          HorizontalContentAlignment="Center"
                                                          Mask="dd.MM.yy HH:mm"
                                                          MaskType="DateTimeAdvancingCaret">
                                    </dxe:DateEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="TableView"
                                           CheckBoxSelectorColumnWidth="24"
                                           ShowCheckBoxSelectorColumn="True"
                                           AutoWidth="True"
                                           EditorShowMode="MouseDownFocused"
                                           AllowGrouping="False"
                                           AllowFilterEditor="False"
                                           AllowSorting="False"
                                           AllowBestFit="True"
                                           ShowGroupPanel="False"
                                           ShowIndicator="False"
                                           NavigationStyle="Cell"
                                           IsColumnMenuEnabled="False"
                                           IsColumnChooserVisible="False">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="InfoLayout"
                                  Height="126">
                    <common:SummaryItemsView x:Name="InfoBlock"
                                             SummaryItems="{Binding Path=OrderSummaryItems, Mode=OneWay}"
                                             LabelColumnWidth="0.9*"
                                             ContentColumnWidth="2*" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="Справка"
                              Orientation="Vertical"
                              View="GroupBox"
                              VerticalAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding Path=HelpContent}"
                           VerticalAlignment="Bottom" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="HandleLoadedCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom">
                    <Button x:Name="OkButton"
                            Content="Объединить"
                            Width="100"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:FocusBehavior />
                        </dxmvvm:Interaction.Behaviors>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
