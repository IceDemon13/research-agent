<UserControl x:Class="Telemart.Client.Views.Tasks.TaskView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Tasks"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:productInformation="clr-namespace:Telemart.Client.Views.Store.Order.ProductInformation"
             DataContext="{client:Container Type=viewModels:TaskViewModel}"
             Width="635"
             Height="418"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:TaskViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TabsConditionsStyle"
                   TargetType="dxlc:LayoutGroup">
                <Style.Triggers>
                    <DataTrigger Value="True"
                                 Binding="{Binding Path=ProductInfoVisible}">
                        <Setter Property="View"
                                Value="Tabs" />
                        <Setter Property="TabStyle"
                                Value="{StaticResource LayoutGroupTabStyle}" />
                        <Setter Property="TabsStyle"
                                Value="{StaticResource LayoutGroupTabsStyle}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <dxmvvm:BooleanToObjectConverter x:Key="BooleanToThicknessConverter"
                                             TrueValue="0"
                                             FalseValue="1" />
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxe:TextEdit EditValue="{Binding Path=Model.Task}"
                          VerticalAlignment="Top"
                          Style="{StaticResource ReadOnlyEditorStyle}" />
            <dxlc:LayoutItem Label="Заказ"
                             Visibility="{Binding Path=OrderVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dxe:ButtonEdit EditValue="{Binding Path=OrderId, Mode=OneWay}"
                                IsTextEditable="False"
                                AllowDefaultButton="False">
                    <dxe:ButtonInfo GlyphKind="Search"
                                    Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                    CommandParameter="{Binding Path=OrderId, Mode=OneWay}" />
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                             Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                             CommandParameter="{Binding Path=OrderId, Mode=OneWay}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:ButtonEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxe:TextEdit EditValue="{Binding Path=Model.Description}"
                              VerticalContentAlignment="Top"
                              TextWrapping="Wrap"
                              Style="{StaticResource ReadOnlyEditorStyle}" />
                <dxlc:LayoutGroup Style="{StaticResource TabsConditionsStyle}"
                                  Width="300">
                    <dxlc:LayoutGroup Header="Задача">
                        <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                                      LabelColumnWidth="*"
                                                      ContentColumnWidth="1.4*"
                                                      BorderThickness="{Binding Path=ProductInfoVisible, Converter={StaticResource BooleanToThicknessConverter}}"
                                                      BorderBrush="White" />
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Товар"
                                      Visibility="{Binding Path=ProductInfoVisible, Converter={dx:BooleanToVisibilityConverter}}">
                        <productInformation:ProductInformation DataContext="{Binding Path=ProductInformation, Mode=OneWay}"
                                                               dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Path=DataContext, Mode=OneWay, ElementName=CurrentUserControl}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="StartTaskCommand.IsExecuting" />
                            <Binding Path="CompleteTaskCommand.IsExecuting" />
                            <Binding Path="CancelTaskCommand.IsExecuting" />
                            <Binding Path="SuspendTaskCommand.IsExecuting" />
                            <Binding Path="ReopenTaskCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility></TextBlock>
                <dxlc:LayoutGroup Visibility="{Binding Path=IsVisible, ElementName=BusyIndicatorLayoutGroup, Converter={dx:BooleanToVisibilityConverter Invert=True}}">
                    <dx:SimpleButton Glyph="../../Images/Common/control_play_blue_16x16.png"
                                     Content="Приступить"
                                     Command="{Binding Path=StartTaskCommand, Mode=OneWay}"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Glyph="../../Images/Common/tick.png"
                                     Content="Выполнить"
                                     Command="{Binding Path=CompleteTaskCommand, Mode=OneWay}"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Glyph="../../Images/Common/canceled.png"
                                     Content="Отменить"
                                     Command="{Binding Path=CancelTaskCommand, Mode=OneWay}"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Glyph="../../Images/Common/control_pause_blue_16x16.png"
                                     Content="Приостановить"
                                     Command="{Binding Path=SuspendTaskCommand, Mode=OneWay}"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Glyph="../../Images/Common/arrow_refresh.png"
                                     Content="Переоткрыть"
                                     Command="{Binding Path=ReopenTaskCommand, Mode=OneWay}"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Glyph="../../Images/Common/arrow_undo_16x16.png"
                                     Content="Создать возврат"
                                     Command="{Binding DocumentCommands.ShowCreateReturnInvoiceCommand}"
                                     CommandParameter="{Binding Path=InvoiceId, Mode=TwoWay}"
                                     IsEnabled="{Binding Path=CanCreateReturnInvoice, Mode=OneWay, ValidatesOnDataErrors=True}"
                                     Visibility="{Binding Path=CanCreateReturnInvoice, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                     HorizontalAlignment="Left" />
                    <dx:SimpleButton Glyph="../../Images/Common/box_16x16.png"
                                     Content="Обработать товары"
                                     Command="{Binding ProcessPickupProductsCommand}"
                                     IsEnabled="{Binding Path=CanProcessPickupProducts, Mode=OneWay, ValidatesOnDataErrors=True}"
                                     Visibility="{Binding Path=CanProcessPickupProducts, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                     HorizontalAlignment="Left" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>