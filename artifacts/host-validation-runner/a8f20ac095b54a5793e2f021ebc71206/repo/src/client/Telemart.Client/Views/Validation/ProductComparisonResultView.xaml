<UserControl x:Class="Telemart.Client.Views.Validation.ProductComparisonResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Validation"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             MinWidth="650"
             MaxWidth="650"
             MinHeight="288"
             MaxHeight="288"
             DataContext="{client:Container Type=viewModels:ProductComparisonResultViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductComparisonResultViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        HorizontalAlignment="Center"
                        Orientation="Vertical">
        <dxlc:LayoutGroup>
            <dxg:GridControl ItemsSource="{Binding Path=Items, Mode=OneWay}"
                             ClipboardCopyMode="ExcludeHeader"
                             SelectionMode="Cell">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="ProductId"
                                    HorizontalHeaderContentAlignment="Center"
                                    Header="Код"
                                    Width="100"
                                    MinWidth="30"
                                    MaxWidth="100"
                                    AllowResizing="False"
                                    FixedWidth="True"
                                    Visible="{Binding VisibleProductId, Mode=OneWay}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="ProductName"
                                    Header="Название"
                                    SortIndex="0"
                                    SortOrder="Ascending"
                                    Width="100"
                                    MinWidth="30"
                                    MaxWidth="250"
                                    FixedWidth="False"
                                    AllowResizing="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings TextWrapping="Wrap" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="ExpectedQuantity"
                                    Header="План"
                                    AllowSorting="True"
                                    HorizontalHeaderContentAlignment="Center"
                                    FixedWidth="True"
                                    Width="50">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="QuantityReal"
                                    Header="Факт"
                                    AllowSorting="True"
                                    HorizontalHeaderContentAlignment="Center"
                                    FixedWidth="True"
                                    Width="50">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Deviation"
                                    Header="Откл."
                                    AllowSorting="True"
                                    HorizontalHeaderContentAlignment="Center"
                                    FixedWidth="True"
                                    Width="50">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="PART_Editor"
                                           Margin="0 0 3 0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Text="{Binding Path=RowData.Row.Deviation, Mode=OneWay}"
                                           Foreground="{Binding Path=RowData.Row.Color, Mode=OneWay}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="TableView"
                                   ShowColumnHeaders="True"
                                   AllowSorting="True"
                                   Style="{StaticResource ReadOnlyTableViewStyle}"
                                   RowStyle="{StaticResource CellSelectionRowStyle}" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom">
            <Button Command="{Binding Path=ExportToXlsxCommand, Mode=OneWay}"
                    CommandParameter="{Binding ElementName=TableView}"
                    HorizontalAlignment="Left"
                    Width="100">
                <StackPanel Orientation="Horizontal">
                    <dx:DXImage Source="/Images/Common/table_excel_16x16.png"
                                Stretch="Uniform" />
                    <TextBlock Text="Экспорт"
                               VerticalAlignment="Center"
                               Margin="5 0 0 0" />
                </StackPanel>

            </Button>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Right">

                <Button Content="Продолжить"
                        IsTabStop="True"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=AllowContinue, Mode=OneWay}"
                        Width="100">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior />
                    </dxmvvm:Interaction.Behaviors>
                </Button>
                <Button Content="Отмена"
                        IsTabStop="True"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}"
                        Width="100" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>