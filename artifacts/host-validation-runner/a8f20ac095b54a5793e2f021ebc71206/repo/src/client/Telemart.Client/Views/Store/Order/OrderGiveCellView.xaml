<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.OrderGiveCellView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              DataContext="{client:Container Type=viewModels:OrderGiveCellViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderGiveCellViewModel}}"
                              d:DesignWidth="800"
                              d:DesignHeight="500"
                              MaxHeight="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxlc:LayoutControl.IsEnabled>
            <MultiBinding Mode="OneWay"
                          Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                <Binding Path="HandleLoadedCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="OkCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="IsRecognitionInProgress"
                         Mode="OneWay" />
            </MultiBinding>
        </dxlc:LayoutControl.IsEnabled>
        <dxlc:LayoutGroup Orientation="Horizontal">
            <dxlc:LayoutGroup>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=OrderCells, Mode=OneWay}"
                                 SelectionMode="None"
                                 MaxHeight="1000">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Код"
                                        HeaderToolTip="Код ячейки"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="CellId"
                                        AllowBestFit="False"
                                        FixedWidth="True"
                                        MinWidth="24"
                                        Width="45"
                                        AllowMoving="False"
                                        AllowColumnFiltering="False"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Название"
                                        HeaderToolTip="Название ячейки"
                                        FieldName="CellName"
                                        AllowBestFit="True"
                                        FixedWidth="False"
                                        MinWidth="24"
                                        AllowMoving="False"
                                        AllowColumnFiltering="False"
                                        AllowEditing="False">
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="О"
                                        HeaderToolTip="Отсканирована"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="Completed"
                                        Width="26"
                                        AllowResizing="False"
                                        FilterPopupMode="CheckedList"
                                        FixedWidth="True"
                                        DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView IsColumnChooserVisible="False"
                                       AllowEditing="True"
                                       AllowResizing="False"
                                       EditorShowMode="MouseDown"
                                       EditorButtonShowMode="ShowAlways"
                                       AllowLeaveInvalidEditor="True"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical"
                              Width="230"
                              MinWidth="230"
                              Visibility="{Binding PrintDocuments, Converter={dx:BooleanToVisibilityConverter}}">
                <dxlc:LayoutGroup Orientation="Vertical"
                                  View="GroupBox"
                                  Header="Печать"
                                  VerticalAlignment="Top"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:CheckEdit Content="РН"
                                       EditValue="{Binding Path=IsAutoPrintAcceptanceProtocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Command="{Binding Path=PrintAcceptanceProtocolCommand, Mode=OneWay}"
                                Style="{StaticResource NoBordersButton}">
                            <dx:DXImage Source="{dx:DXImage Image=Print_16x16.png}" />
                        </Button>
                        <dxe:TextEdit IsReadOnly="{Binding Path=IsAutoPrintAcceptanceProtocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                      MaskType="Numeric"
                                      Mask="#"
                                      Width="19"
                                      AllowNullInput="False"
                                      ToolTip="Кол-во копий"
                                      EditValue="{Binding Path=AcceptanceProtocolQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxe:CheckEdit Content="Гар. талон"
                                       EditValue="{Binding Path=IsAutoPrintWarrantyCard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Command="{Binding Path=PrintWarrantyCardCommand, Mode=OneWay}"
                                Style="{StaticResource NoBordersButton}">
                            <dx:DXImage Source="{dx:DXImage Image=Print_16x16.png}" />
                        </Button>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      Visibility="{Binding IsAutoGuestProductPrintVisible, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}">
                        <dxe:CheckEdit Content="Акт возврата гос. товара"
                                       IsEnabled="True"
                                       EditValue="{Binding Path=IsAutoGuestProductPrint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      ItemSpace="0"
                                      Visibility="{Binding AllowBills, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}">
                        <dxlc:LayoutGroup Orientation="Horizontal">
                            <dxe:CheckEdit Content="Расходная накладная (бух.)"
                                           IsReadOnly="{Binding  IsReadonlyAutoPrintBillInvoice, Mode=OneWay}"
                                           EditValue="{Binding Path=IsAutoPrintBillInvoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding Path=PrintBillInvoiceCommand, Mode=OneWay}"
                                    Style="{StaticResource NoBordersButton}">
                                <dx:DXImage Source="{dx:DXImage Image=Print_16x16.png}" />
                            </Button>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Orientation="Horizontal">
                            <dxe:CheckEdit Content="Счет (бух.)"
                                           EditValue="{Binding Path=IsAutoPrintBill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding Path=PrintBillCommand, Mode=OneWay}"
                                    Style="{StaticResource NoBordersButton}">
                                <dx:DXImage Source="{dx:DXImage Image=Print_16x16.png}" />
                            </Button>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Bottom"
                          dxlc:LayoutControl.AllowVerticalSizing="True">
            <dxlc:LayoutGroup.MinHeight>
                <Binding Path="MinHeight"
                         Mode="OneWay"
                         ElementName="RecognizeBarcodeView" />
            </dxlc:LayoutGroup.MinHeight>
            <dxlc:LayoutGroup.Height>
                <Binding Path="MinHeight"
                         Mode="OneWay"
                         ElementName="RecognizeBarcodeView" />
            </dxlc:LayoutGroup.Height>
            <dxlc:LayoutGroup.MaxHeight>
                <MultiBinding Mode="OneWay" Converter="{converters:ResizableLayoutGroupMaxDimensionConverter OppositeMinDimensionValue=260}">
                    <Binding Path="ActualHeight"
                             Mode="OneWay"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    <Binding Path="ItemSpace"
                             Mode="OneWay"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    <Binding Path="Padding"
                             Mode="OneWay"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                </MultiBinding>
            </dxlc:LayoutGroup.MaxHeight>
            <common:RecognizeBarcodeView x:Name="RecognizeBarcodeView"
                                         DataContext="{Binding Path=RecognizeBarcodeViewModel, Mode=OneWay}" />
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom">
            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16" />
                <TextBlock Text="{Binding Path=ProgressText, Mode=OneWay}" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup HorizontalAlignment="Right">
                <Button Content="ОК"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"/>
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}"
                        IsEnabled="{Binding OkCommand.IsExecuting, Converter={dxmvvm:BooleanNegationConverter}}"/>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</controls:TelemartUserControl>