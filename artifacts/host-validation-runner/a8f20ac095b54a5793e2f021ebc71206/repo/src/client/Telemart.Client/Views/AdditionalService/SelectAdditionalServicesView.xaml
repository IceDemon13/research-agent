<UserControl x:Class="Telemart.Client.Views.AdditionalService.SelectAdditionalServicesView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AdditionalService"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             DataContext="{client:Container Type=viewModels:SelectAdditionalServicesViewModel}"
             Width="600"
             Height="400"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:SelectAdditionalServicesViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Товар">
                    <dxe:TextEdit IsReadOnly="True"
                                  EditValue="{Binding Path=ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Услуги"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=AdditionalServices, Mode=OneWay}"
                                     SelectedItems="{Binding Path=SelectedAdditionalServices, Mode=OneWay}"
                                     SelectionMode="Row"
                                     IsEnabled="True"
                                     ShowBorder="False">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Название услуги"
                                            HeaderToolTip="Название услуги"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Name"
                                            FixedWidth="False"
                                            Width="110"
                                            MinWidth="80"
                                            AllowBestFit="True"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList" />
                            <dxg:GridColumn Header="Название товара"
                                            HeaderToolTip="Название товара"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="DisplayProductName"
                                            FixedWidth="False"
                                            Width="110"
                                            MinWidth="80"
                                            AllowBestFit="True"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:HyperlinkEdit x:Name="PART_Editor"
                                                           NavigationUrl="{Binding Path=RowData.Row.ProductLink, Mode=OneWay}"
                                                           HorizontalAlignment="Left"
                                                           ToolTip="{Binding Path=RowData.Row.ProductName, Mode=OneWay}"
                                                           ShowNavigationUrlToolTip="False"
                                                           AllowAutoNavigate="True"
                                                           RequestNavigation="Product_OnRequestNavigation">
                                        </dxe:HyperlinkEdit>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Цена"
                                            HeaderToolTip="Цена услуги"
                                            FieldName="Price"
                                            HorizontalHeaderContentAlignment="Center"
                                            FixedWidth="False"
                                            Width="30"
                                            MinWidth="20"
                                            AllowBestFit="True"
                                            AllowMoving="False"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           CheckBoxSelectorColumnWidth="24"
                                           ShowCheckBoxSelectorColumn="{Binding Path=AllowEdit, Mode=OneWay}"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           IsEnabled="True"
                                           NavigationStyle="Row"
                                           AllowEditing="True"
                                           AllowResizing="True"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <TextBlock ToolTip="{Binding Path=InfoLabelToolTip, Mode=OneWay}"
                           Text="{Binding Path=InfoLabel, Mode=OneWay}"
                           HorizontalAlignment="Left" />
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsTabStop="True"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=ValidationContainer, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            IsTabStop="True"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>