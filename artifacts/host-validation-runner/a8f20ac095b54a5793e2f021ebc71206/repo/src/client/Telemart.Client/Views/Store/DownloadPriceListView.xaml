<UserControl x:Class="Telemart.Client.Views.Store.DownloadPriceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:DownloadPriceListViewModel}"
             Loaded="OnLoaded"
             Width="380"
             Height="520"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:DownloadPriceListViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
        <dxmvvm:CurrentWindowService />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical"
                              VerticalAlignment="Stretch">
                <dxlc:LayoutItem Label="Клиент">
                    <dxe:ComboBoxEdit x:Name="ContractorsComboBoxEdit"
                                      ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedContractorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Категории"
                                 LabelVerticalAlignment="Top"
                                 VerticalAlignment="Stretch">
                    <dxg:GridControl ItemsSource="{Binding Path=Categories, Mode=OneWay}">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name"
                                            VisibleIndex="0" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TreeListView TreeDerivationMode="Selfreference"
                                              AllowRecursiveNodeChecking="True"
                                              CheckBoxFieldName="Selected"
                                              ShowCheckboxes="True"
                                              NavigationStyle="Row"
                                              KeyFieldName="Id"
                                              ParentFieldName="ParentId"
                                              FilterMode="Extended"
                                              ShowSearchPanelMode="Always"
                                              SearchPanelHighlightResults="True"
                                              ExpandNodesOnFiltering="True"
                                              AllowEditing="False"
                                              AllowBestFit="True"
                                              AllowSorting="False"
                                              AllowDrop="False"
                                              ShowVerticalLines="False"
                                              ShowHorizontalLines="False"
                                              FetchSublevelChildrenOnExpand="False"
                                              ShowIndicator="False"
                                              TreeLineStyle="Solid"
                                              AutoWidth="True"
                                              ShowFilterPanelMode="Never"
                                              AutoExpandAllNodes="False"
                                              ShowExpandButtons="True"
                                              UseEvenRowBackground="False">
                                <dxg:TreeListView.FormatConditions>
                                    <dxg:FormatCondition Expression="[IsParent] = FALSE AND [IsBrand] = False">
                                        <dx:Format FontStyle="Italic" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] &lt; 0.5">
                                        <dx:Format Foreground="DarkGray" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] = 0">
                                        <dx:Format TextDecorations="Strikethrough" />
                                    </dxg:FormatCondition>
                                </dxg:TreeListView.FormatConditions>
                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <Button x:Name="OkButton"
                        Content="Сохранить"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                        HorizontalAlignment="Right">
                </Button>
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}"
                        HorizontalAlignment="Right" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
