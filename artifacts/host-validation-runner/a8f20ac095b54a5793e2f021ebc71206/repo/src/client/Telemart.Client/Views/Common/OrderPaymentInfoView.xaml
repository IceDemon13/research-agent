<UserControl x:Name="CurrentUserControl"
             x:Class="Telemart.Client.Views.Common.OrderPaymentInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:local="clr-namespace:Telemart.Client.Views.Common"
             mc:Ignorable="d"
             d:DesignWidth="224"
             d:DataContext="{d:DesignInstance Type=local:OrderPaymentInfoView, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="OrderPaymentRowStyle"
                           TargetType="{x:Type dxg:GridRowContent}"
                           BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=RowStyle}}">
                        <Setter Property="Background"
                                Value="Transparent" />
                        <Setter Property="Foreground"
                                Value="{StaticResource Foreground}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DataContext.Order, Mode=OneWay}"
                                         Value="6">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Foreground}"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="OrderPaymentTableViewStyle"
                           TargetType="dxg:TableView"
                           BasedOn="{StaticResource SimpleTableViewStyle}">
                        <Setter Property="UseLightweightTemplates"
                                Value="None" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=CurrentUserControl, Mode=OneWay}">
        <dxg:GridControl ItemsSource="{Binding Path=Items, Mode=OneWay}"
                         ShowBorder="{Binding Path=ShowBorder, Mode=OneWay}"
                         Style="{StaticResource SimpleGridControlStyle}">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="PaymentType"
                                Header="Статья"
                                FixedWidth="True"
                                Width="105"
                                MinWidth="105"
                                AllowBestFit="True" />
                <dxg:GridColumn FieldName="Uah"
                                Header="UAH"
                                HorizontalHeaderContentAlignment="Right">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Right"
                                              MaskType="Numeric"
                                              Mask="C2"
                                              MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                              MaskUseAsDisplayFormat="True" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Usd"
                                Header="USD"
                                HorizontalHeaderContentAlignment="Right"
                                Visible="{Binding Path=IsUsdVisible, Mode=OneWay}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Right"
                                              MaskType="Numeric"
                                              Mask="C2"
                                              MaskCulture="{x:Static business:CurrencyFormatingRules.UsdCultureInfo}"
                                              MaskUseAsDisplayFormat="True" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView RowStyle="{StaticResource OrderPaymentRowStyle}"
                               Style="{StaticResource OrderPaymentTableViewStyle}"
                               ShowColumnHeaders="False">
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>

</UserControl>