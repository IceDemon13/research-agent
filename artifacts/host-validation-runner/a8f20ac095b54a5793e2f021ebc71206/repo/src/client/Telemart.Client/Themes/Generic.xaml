<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Telemart.Client.Views.Base"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:threading="clr-namespace:Telemart.Client.ViewComponents.Threading"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
        <ResourceDictionary>
            <Style TargetType="{x:Type local:TelemartDialogViewBase}">
                <Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <ItemsControl>
                                <dxmvvm:EventToCommand EventName="Loaded"
                                       Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
                                <dxmvvm:KeyToCommand KeyGesture="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CancelKey}"
                                     x:Name="CancelCommandEvent"
                                     Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                                <dxmvvm:KeyToCommand KeyGesture="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OkKey}"
                                     x:Name="OkCommandEvent"
                                     Command="{Binding Path=OkCommand, Mode=OneWay}" />
                            </ItemsControl>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TelemartDialogViewBase}">

                            <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                                 OwnerLock="LoadingContent">
                                <dxlc:LayoutControl x:Name="LayoutControl"
                                    Orientation="Vertical"
                                    IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                    ItemStyle="{StaticResource LayoutItemStyle}"
                                    Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                                    dxe:ValidationService.IsValidationContainer="True">
                                    <ContentPresenter Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Bottom">
                                        <threading:BusyIndicator HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 BusyText="{TemplateBinding BusyText}"
                                                 Visibility="{Binding Path=IsEnabled, ElementName=OkButton, Converter={dx:BooleanToVisibilityConverter Invert=True}}"/>
                                        <dxlc:LayoutGroup HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                            <Button Content="OK"
                                                    x:Name="OkButton"
                                                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                                                    IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                                            <Button Content="Отмена"
                                                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutControl>
                            </dx:LoadingDecorator>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
