<controls:TelemartUserControl x:Class="Telemart.Client.Views.Dialogs.PreloaderView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Dialogs"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:PreloaderViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:PreloaderViewModel}, IsDesignTimeCreatable=True}"
                              Width="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:WaitIndicator Content="{Binding Message, Mode=OneWay}"
                      DeferedVisibility="True"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch" ContentPadding="-150,25,-50,25" Width="500">
        <dx:WaitIndicator.ContentTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="20" TextWrapping="Wrap"/>
            </DataTemplate>
        </dx:WaitIndicator.ContentTemplate>
    </dx:WaitIndicator>

</controls:TelemartUserControl>
