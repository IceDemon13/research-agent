<UserControl x:Name="CurrentControl"
             x:Class="Telemart.Client.Views.AssembledComputerRule.AssembledComputerRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AssembledComputerRule"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             DataContext="{client:Container Type=viewModels:AssembledComputerRulesViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type=viewModels:AssembledComputerRulesViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary>
                    <Style TargetType="dxg:GridColumn">
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="FixedWidth"
                                Value="True" />
                        <Setter Property="ShowInColumnChooser"
                                Value="True" />
                        <Setter Property="HorizontalHeaderContentAlignment"
                                Value="Center" />
                    </Style>
                    <Style x:Key="BaseProductImageStyle"
                           TargetType="dx:DXImage">
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip>
                                    <dxlc:LayoutControl Orientation="Vertical">
                                        <dxlc:LayoutItem
                                            Visibility="{Binding Path=RowData.Row.BaseProductName, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Path=RowData.Row.BaseProductName, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="200" />
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutControl>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl Height="Auto"
                                AllowQuickCustomization="False"
                                AllowCustomizationMenu="False">
                <dxb:ToolBarControl.IsEnabled>
                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="RefreshCommand.IsExecuting"
                                 Mode="OneWay"
                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                    </MultiBinding>
                </dxb:ToolBarControl.IsEnabled>
                <dxb:BarButtonItem Content="Обновить"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                   KeyGesture="F5" />
                <dxb:BarButtonItem Content="Колонки"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding ElementName=AssembledComputerRulesGrid, Path=View}"
                                   KeyGesture="F6" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   GlyphAlignment="Top"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=CreateCommand, Mode=OneWay}"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   KeyGesture="Insert" />
                <dxb:BarButtonItem Content="Изменить"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=EditCommand}"
                                   KeyGesture="F2" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Резерв"
                                   ToolTip="Резерв товаров"
                                   LargeGlyph="../../../Images/Parser/database_delete_32_32.png"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=ShowReserveCommand}"/>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutGroup>
                    <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                  AllowSizing="True">
                        <dxg:GridControl x:Name="AssembledComputerRulesGrid"
                                     ItemsSource="{Binding Path=AssembledComputerRules}"
                                     SelectedItem="{Binding Path=SelectedAssembledComputerRule}"
                                     ShowLoadingPanel="{Binding Path=IsLongOperationInProgress}"
                                     SelectionMode="None"
                                     ShowBorder="False">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="assembled_computer_rules1.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn Header="Код"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Id"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="90"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="True"
                                            SortOrder="Ascending"
                                            SortIndex="0">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Код товара"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="ProductId"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="90"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="True"
                                            SortOrder="Ascending"
                                            SortIndex="0">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Префикс"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Prefix"
                                            FixedWidth="True"
                                            MaxWidth="140"
                                            Width="90"
                                            MinWidth="70"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="True"
                                            SortOrder="Ascending"
                                            SortIndex="0">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Товар"
                                            HeaderToolTip="Название товара"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Name"
                                            FixedWidth="False"
                                            Width="160"
                                            MinWidth="80"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:HyperlinkEdit x:Name="PART_Editor"
                                                           NavigationUrl="{Binding Path=RowData.Row.Link, Mode=OneWay}"
                                                           HorizontalAlignment="Left"
                                                           ToolTip="{Binding Path=RowData.Row.Name, Mode=OneWay}"
                                                           ShowNavigationUrlToolTip="False"
                                                           AllowAutoNavigate="True"
                                                           RequestNavigation="Product_OnRequestNavigation">
                                            </dxe:HyperlinkEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Группа"
                                            HeaderToolTip="Группа"
                                            FieldName="GroupName"
                                            FixedWidth="False"
                                            Width="80"
                                            AllowGrouping="True"
                                            MinWidth="70"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Артикул"
                                            HeaderToolTip="Артикул"
                                            FieldName="PartNumber"
                                            FixedWidth="False"
                                            Width="100"
                                            MinWidth="100"
                                            AllowGrouping="False"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Цвет"
                                            HeaderToolTip="Цвет"
                                            FieldName="Color"
                                            FixedWidth="False"
                                            Width="100"
                                            MinWidth="100"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Создан"
                                            HeaderToolTip="Дата создания"
                                            FieldName="CreatedOn"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            FixedWidth="True"
                                            Width="120"
                                            MinWidth="120"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            HorizontalHeaderContentAlignment="Left"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Б"
                                                    HeaderToolTip="Базовая конфигурация"
                                                    FieldName="BaseProductName"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowColumnFiltering="False"
                                                    AllowAutoFilter="False"
                                                    AllowSorting="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxlc:LayoutGroup Orientation="Horizontal"
                                                                  Height="22">
                                                <dx:DXImage Source="../../Images/Common/server.png"
                                                                Height="16"
                                                                Width="16"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource BaseProductImageStyle}"
                                                                Margin="4 0 0 0">
                                                    <dx:DXImage.Visibility>
                                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                            <Binding Path="RowData.Row.BaseProductName"
                                                                         Converter="{dxmvvm:StringToBooleanConverter}" />
                                                        </MultiBinding>
                                                    </dx:DXImage.Visibility>
                                                </dx:DXImage>
                                            </dxlc:LayoutGroup>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="А"
                                                    HeaderToolTip="Активно"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Active"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="False"
                                                    AllowAutoFilter="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../Images/Common/tick.png"
                                                            Width="16"
                                                            Height="16"
                                                            Visibility="{Binding Path=RowData.Row.Active, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           ShowGroupPanel="True"
                                           AllowGrouping="True"
                                           IsTotalSummaryMenuEnabled="False"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           ShowTotalSummary="False">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                           PassEventArgsToCommand="False" />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:TableView.ColumnHeaderContentStyle>
                                        <Style TargetType="dxg:HeaderContentControl">
                                            <Setter Property="FontWeight"
                                                Value="Normal" />
                                        </Style>
                                    </dxg:TableView.ColumnHeaderContentStyle>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                            </dxg:GridControl.GroupSummary>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="355"
                                  MinWidth="355"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="355"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="True"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=IsLongOperationInProgress, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="LayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Товар">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/package.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxg:PrintTextEdit EditValue="{Binding Path=Filter.ProductName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:PrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</UserControl>