<UserControl x:Class="Telemart.Client.Views.Store.FiscalRegistrar.FiscalRegistrarCashbox.FiscalRegistrarCashboxCashCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.FiscalRegistrar.FiscalRegistrarCashbox"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:client="clr-namespace:Telemart.Client"
             Width="370"
             Height="200"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:FiscalRegistrarCashboxCashCollectionViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:FiscalRegistrarCashboxCashCollectionViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Разменная монета">
                    <dxe:SpinEdit EditValue="{Binding Incombustible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyEditorStyle}"
                                  MinValue="0"
                                  AllowNullInput="True"
                                  Mask="f2"
                                  MaskType="Numeric"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  AllowDefaultButton="False"
                                  EditValueType="{x:Type system:Decimal}"
                                  MaskUseAsDisplayFormat="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="На возвраты">
                    <dxe:SpinEdit EditValue="{Binding RefundsAmount, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyEditorStyle}"
                                  MinValue="0"
                                  AllowNullInput="True"
                                  Mask="f2"
                                  MaskType="Numeric"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  AllowDefaultButton="False"
                                  EditValueType="{x:Type system:Decimal}"
                                  MaskUseAsDisplayFormat="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="В кассе">
                    <dxe:SpinEdit EditValue="{Binding InCashbox, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyEditorStyle}"
                                  MinValue="0"
                                  AllowNullInput="True"
                                  Mask="f2"
                                  MaskType="Numeric"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  AllowDefaultButton="False"
                                  EditValueType="{x:Type system:Decimal}"
                                  MaskUseAsDisplayFormat="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Изъять">
                    <dxe:SpinEdit EditValue="{Binding Collect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MinValue="0.01"
                                  AllowNullInput="True"
                                  Mask="f2"
                                  MaskType="Numeric"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  AllowDefaultButton="False"
                                  EditValueType="{x:Type system:Decimal}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Останется">
                    <dxe:SpinEdit EditValue="{Binding Remain, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyEditorStyle}"
                                  MinValue="0"
                                  AllowNullInput="True"
                                  Mask="f2"
                                  MaskType="Numeric"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  AllowDefaultButton="False"
                                  EditValueType="{x:Type system:Decimal}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="Провести"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsTabStop="True"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
