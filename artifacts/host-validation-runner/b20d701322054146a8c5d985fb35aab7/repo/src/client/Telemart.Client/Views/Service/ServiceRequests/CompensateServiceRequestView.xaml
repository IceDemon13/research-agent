<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.CompensateServiceRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             DataContext="{client:Container Type=viewModels:CompensateServiceRequestViewModel}"
             Width="370"
             MinHeight="220"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CompensateServiceRequestViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Действие">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=CompenstateTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=CompensateType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      NullValueButtonPlacement="EditBox"
                                      NullText="Выберите действие" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Замена"
                                 Visibility="{Binding Path=NeedChooseProduct, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ButtonEdit EditValue="{Binding Path=Product, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    IsReadOnly="True"
                                    IsEnabled="{Binding Path=ChooseProductEnabled, Mode=OneWay}"
                                    AllowDefaultButton="True">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="DefaultButtonClick"
                                                   Command="{Binding Path=SelectProductCommand, Mode=OneTime}" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Цена продажи">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=CompensationPrices, Mode=OneWay}"
                                      EditValue="{Binding Path=CompensationPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="{Binding Path=IsReadOnlyCompensationPrice, Mode=OneWay}"
                                      Style="{StaticResource LookUpReadOnlyConditionsStyle}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Цена списания">
                    <dxe:SpinEdit EditValue="{Binding Path=Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="{Binding Path=CompensationPrice.CurrencyId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}, FallbackValue={x:Static business:CurrencyFormatingRules.UahFormat}}"
                                  MaskCulture="{Binding Path=CompensationPrice.CurrencyId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}, FallbackValue={x:Static business:CurrencyFormatingRules.UahCultureInfo}}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="False"
                                  HorizontalContentAlignment="Left"
                                  IsReadOnly="{Binding Path=IsReadOnlyAmount, Mode=OneWay}"
                                  Style="{StaticResource SpinEditReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий">
                    <dxe:TextEdit EditValue="{Binding Path=Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Оплата"
                                 Visibility="{Binding Path=PaymentVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=ReturnMoneyPaymentTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=ReturnMoneyPaymentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      AllowNullInput="True"
                                      NullValue="{x:Null}"
                                      NullText="{StaticResource NullTextValue}"
                                      NullValueButtonPlacement="EditBox">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                   Command="{Binding Path=HandlePaymentTypeChangedCommand, Mode=OneTime}" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem x:Name="CashboxLayoutItem"
                                 Label="Касса"
                                 Visibility="{Binding Path=CashboxVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                      EditValue="{Binding Path=Cashbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="DisplayValue"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
                <common:RequisitesView x:Name="RequisitesView" Model="{Binding Path=Requisites, Mode=OneWay}"/>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <Button Content="ОК"
                        Command="{Binding Path=OkCommand, Mode=OneTime}"
                        HorizontalAlignment="Right">
                    <Button.IsEnabled>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter}">
                            <Binding Path="(dxe:ValidationService.HasValidationError)"
                                     Mode="OneWay"
                                     ElementName="LayoutControl"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                            <Binding Path="IsValid"
                                     Mode="OneWay"
                                     ElementName="RequisitesView" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Content="Отмена"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=CancelCommand, Mode=OneTime}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>