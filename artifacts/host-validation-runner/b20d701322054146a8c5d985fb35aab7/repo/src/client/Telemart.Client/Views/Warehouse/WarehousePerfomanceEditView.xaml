<controls:TelemartUserControl x:Class="Telemart.Client.Views.Warehouse.WarehousePerfomanceEditView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:constants="clr-namespace:Telemart.Client.Dictionaries.Constants"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:WarehousePerfomanceEditViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:WarehousePerfomanceEditViewModel}, IsDesignTimeCreatable=True}"
                              Width="400"
                              Height="275">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Работа">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=WorkTypes, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Work"
                                  ValueMember="Id"
                                  IsTextEditable="False" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Услуга">
                <dxg:LookUpEdit ItemsSource="{Binding Path=AdditionalServices, Mode=OneWay}"
                                EditValue="{Binding Path=SelectedAdditionalService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                DisplayMember="DisplayValue"
                                AutoPopulateColumns="False"
                                AutoComplete="False"
                                IncrementalFiltering="True"
                                FilterCondition="Like"
                                FindMode="Always"
                                ImmediatePopup="True"
                                IsPopupAutoWidth="True"
                                InvalidValueBehavior="AllowLeaveEditor"
                                Style="{StaticResource LookUpReadOnlyConditionsStyle}"
                                PopupContentTemplate="{StaticResource LookUpEditHierarchicalControlTemplate}">
                    <dxg:LookUpEdit.IsReadOnly>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="Model.WorkId"
                                     Converter="{converters:IsNotEqualConverter}"
                                     ConverterParameter="{x:Static constants:WarehouseWorkTypeIds.AdditionalServiceWorkTypeId}"/>
                        </MultiBinding>
                    </dxg:LookUpEdit.IsReadOnly>
                <dxg:LookUpEdit.StyleSettings>
                        <dxg:SearchLookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                </dxg:LookUpEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="День недели">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=DaysOfWeek, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.DayOfWeek, Mode=TwoWay, Converter={converters:StringToDaysOfWeekConverter}, UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  IsTextEditable="False"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Производительность">
                <dxe:TextEdit EditValue="{Binding Path=Model.Performance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              MaxLength="3"
                              AllowNullInput="False"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Трудозатраты">
                <dxe:TextEdit EditValue="{Binding Path=Model.Estimate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                              Mask="dd.hh:mm"
                              MaskType="TimeSpan"
                              Style="{StaticResource TimeSpanTextEdit}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Подразделение">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.SubdivisionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="Id"
                                  IsTextEditable="False"
                                  AllowNullInput="True"
                                  NullValueButtonPlacement="EditBox"
                                  Style="{StaticResource LookUpReadOnlyConditionsStyle}">
                    <dxe:ComboBoxEdit.IsReadOnly>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="Model.WorkId"
                                     Converter="{converters:IsNotEqualConverter}"
                                     ConverterParameter="{x:Static constants:WarehouseWorkTypeIds.AssemblyServiceWorkTypeId}"/>
                        </MultiBinding>
                    </dxe:ComboBoxEdit.IsReadOnly>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Активность">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                          HorizontalAlignment="Left">
                    <RadioButton Content="Активен"
                                         IsChecked="{Binding Path=Model.Activity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                    <RadioButton Content="Не активен"
                                         IsChecked="{Binding Path=Model.Activity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                         VerticalAlignment="Center" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>

