<UserControl x:Class="Telemart.Client.Views.Store.CreateScanSheetForEntities.SelectEntitiesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:createScanSheet="clr-namespace:Telemart.Client.ViewModels.Store.CreateScanSheetForEntities"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             mc:Ignorable="d"
             DataContext="{client:Container Type=createScanSheet:SelectEntitiesPageViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type createScanSheet:SelectEntitiesPageViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:EventToCommand EventName="Unloaded"
                               Command="{Binding HandleUnloadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Назад"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Left">
                <dxlc:LayoutItem Label="Выбрано документов">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=SelectedCount, Mode=OneWay, FallbackValue=0}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" из " />
                        <TextBlock Text="{Binding Path=Model.Entities.Count, Mode=OneWay, FallbackValue=0}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" шт." />
                    </StackPanel>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=Model.Entities, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                             CurrentItem="{Binding Path=Model.SelectedEntity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ShowBorder="True"
                             SelectionMode="None"
                             AutoExpandAllGroups="True"
                             DesignTimeDataObjectType="{x:Type createScanSheet:ScanSheetEntityViewItem}">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:LayoutSerializationBehavior FileName="shippments.xml" />
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                    <dxmvvm:FocusBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn HeaderToolTip="Добавить в реестр"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="Selected"
                                    FixedWidth="True"
                                    AllowEditing="True"
                                    AllowResizing="False"
                                    AllowBestFit="False"
                                    AllowColumnFiltering="False"
                                    MinWidth="55"
                                    Width="55">
                        <dxg:GridColumn.HeaderTemplate>
                            <DataTemplate>
                                <dxe:CheckEdit EditValue="{Binding Path=DataContext.EntityCheckAllState, Mode=TwoWay, ElementName=GridControl}"/>
                            </DataTemplate>
                        </dxg:GridColumn.HeaderTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Номер документа"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="Id"
                                    FixedWidth="True"
                                    AllowResizing="True"
                                    AllowBestFit="False"
                                    AllowColumnFiltering="False"
                                    AllowSorting="True"
                                    MinWidth="120"
                                    Width="140">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="ТТН"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="TtnId"
                                    AllowEditing="False"
                                    AllowResizing="True"
                                    Fixed="None"
                                    BestFitMode="Default"
                                    BestFitArea="All"
                                    MinWidth="120"
                                    FixedWidth="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True"
                                   AllowEditing="False"
                                   NavigationStyle="Cell"
                                   ShowIndicator="False"
                                   ShowAutoFilterRow="False"
                                   ShowGroupedColumns="False"
                                   ShowFixedTotalSummary="False"
                                   IsTotalSummaryMenuEnabled="False"
                                   IsColumnChooserVisible="False"
                                   AllowColumnMoving="False"
                                   ShowTotalSummary="False"
                                   AllowGrouping="False"
                                   ShowGroupPanel="False"
                                   EditorShowMode="MouseDown"
                                   AllowFilterEditor="False"
                                   AllowSorting="False"
                                   AllowBestFit="True"
                                   AllowPrintDetails="True"
                                   AllowResizing="True"
                                   AllowMasterDetail="False"
                                   IsColumnMenuEnabled="False"
                                   EnableImmediatePosting="True">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxe:ProgressBarEdit Value="{Binding Path=Model.ProgressValue, Mode=OneWay}"
                                 Content="{Binding Path=Model.ProgressText, Mode=OneWay}"
                                 ContentDisplayMode="Content"
                                 IsPercent="False"
                                 Height="22" />
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>
