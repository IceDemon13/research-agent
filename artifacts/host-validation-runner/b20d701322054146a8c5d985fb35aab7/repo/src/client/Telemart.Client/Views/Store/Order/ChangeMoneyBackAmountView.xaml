<UserControl x:Class="Telemart.Client.Views.Store.Order.ChangeMoneyBackAmountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dialogs="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             DataContext="{client:Container Type=dialogs:ChangeMoneyBackAmountViewModel}"
             Width="420"
             Height="180"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type dialogs:ChangeMoneyBackAmountViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

        <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl Orientation="Vertical"
                            x:Name="ValidationContainer"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Заказ">
                    <dxe:ButtonEdit x:Name="OrderButtonEdit"
                                    EditValue="{Binding Path=OrderId, Mode=OneWay}"
                                    AllowDefaultButton="False"
                                    Style="{StaticResource ReadOnlyEditorStyle}">
                        <dxe:ButtonInfo GlyphKind="Search"
                                        ToolTipService.ToolTip="Открыть заказ"
                                        Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                        CommandParameter="{Binding Path=OrderId, Mode=OneWay}" />
                    </dxe:ButtonEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Сумма заказа">
                    <dxe:TextEdit EditValue="{Binding Path=SumOrder, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                  Opacity="{StaticResource DisabledElementOpacity}"
                                  MaskType="Numeric"
                                  Mask="f2"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Сумма к оплате">
                    <dxe:TextEdit EditValue="{Binding Path=ToPay, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                  Opacity="{StaticResource DisabledElementOpacity}"
                                  MaskType="Numeric"
                                  Mask="f2"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Налож. платеж"
                                 ToolTip="Сумма наложенного платежа">
                    <dxe:TextEdit EditValue="{Binding Path=MoneyBackAmount, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                  Opacity="{StaticResource EnabledElementOpacity}"
                                  MaskType="Numeric"
                                  Mask="f2"
                                  IsReadOnly="False" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsTabStop="True"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=ValidationContainer, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        IsTabStop="True"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>