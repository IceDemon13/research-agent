<UserControl x:Class="Telemart.Client.Views.Parser.Dictionary.ParserDictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Parser.Dictionary"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:parser="clr-namespace:Telemart.Client.Business.Parser"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:ProductParserDictionaryViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <converters:ParserAliasStateSelectedItemsConverter x:Key="StatusSelectedItemsConverter" />
                    <Style TargetType="dxg:GridColumn">
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="AllowBestFit"
                                Value="True" />
                        <Setter Property="AllowResizing"
                                Value="True" />
                        <Setter Property="AllowMoving"
                                Value="True" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Orientation="Vertical"
                        ItemSpace="0"
                        Padding="0">
        <dxlc:LayoutGroup>
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl AllowQuickCustomization="False"
                                    AllowCustomizationMenu="False"
                                    IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding ElementName=GridControl, Path=View}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Сохранить"
                                       ToolTip="Сохранить в БД (Ctrl+S)"
                                       LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                       Command="{Binding Path=SaveCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Удалить"
                                       ToolTip="Удалить из БД (Ctrl+Del)"
                                       LargeGlyph="../../../Images/Parser/database_delete_32_32.png"
                                       Command="{Binding Path=DeleteCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Соп. авто"
                                       ToolTip="Сопоставить (F9)"
                                       LargeGlyph="../../../Images/Parser/anchor_32_32.png"
                                       Command="{Binding Path=CompareAutoCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Соп. по характеристикам"
                                       ToolTip="Cопоставление по характеристикам"
                                       Glyph="/Images/Common/cog_32x32.png"
                                       IsVisible="{Binding AutoCompareByFeatures}"
                                       GlyphAlignment="Top"
                                       Command="{Binding Path=CompareAutoByFeaturesCommand, Mode=OneTime}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Соп. вручн."
                                       ToolTip="Сопоставить вручну (Alt+C)"
                                       LargeGlyph="../../../Images/Parser/link_add_32_32.png"
                                       Command="{Binding Path=CompareManuallyCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Не сопост."
                                       ToolTip="Не сопоставлено (Del)"
                                       LargeGlyph="../../../Images/Parser/link_unchain_32_32.png"
                                       Command="{Binding Path=SetNotAssociatedSateCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Отложить"
                                       ToolTip="Отложить на 30 дней (Alt+P)"
                                       LargeGlyph="../../../Images/Parser/stopwatch_pause_32_32.png"
                                       Command="{Binding Path=SetPostponedStateCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Игнор."
                                       ToolTip="Игнорировать (Alt+I)"
                                       LargeGlyph="../../../Images/Parser/cross_shiled_32_32.png"
                                       Command="{Binding Path=SetIgnoredStateCommand, Mode=OneWay}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="В Excel"
                                       ToolTip="Экспортировать в Excel (Alt+E)"
                                       LargeGlyph="../../../Images/Parser/excel_32_32.png"
                                       Command="{Binding Path=ExportCommand, Mode=OneWay}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Шаблоны"
                                       ToolTip="Шаблоны поиска по характеристикам"
                                       LargeGlyph="../../../Images/Common/google_custom_search_32x32.png"
                                       Command="{Binding Path=Templates, Mode=OneWay}"
                                       IsVisible="{Binding Path=IsTemplateVisible}"/>
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Padding="0"
                                  Margin="0">
                    <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                      AllowSizing="True">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=ParserAliases, Mode=OneWay}"
                                         CurrentItem="{Binding Path=SelectedParserAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedItems="{Binding Path=SelectedParserAliases, Mode=OneWay}"
                                         IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}"
                                         SelectionMode="Row"
                                         AutoExpandAllGroups="True"
                                         ShowBorder="False"
                                         DesignTimeDataObjectType="viewModels:ParserAliasViewItemWrapper"
                                         DesignTimeDataSourceRowCount="16"
                                         DesignTimeUseDistinctSampleValues="True"
                                         DesignTimeShowSampleData="True">
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="RefreshCommand.IsExecuting" />
                                    <Binding Path="SaveCommand.IsExecuting" />
                                    <Binding Path="DeleteCommand.IsExecuting" />
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="EndGrouping"
                                                       Command="{Binding Path=HandleEndGroupingCommand, Mode=OneWay}"
                                                       CommandParameter="{Binding ElementName=GridControl}" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Categories"
                                                Header="Категория"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                GroupIndex="{Binding Path=DataContext.CategoryColumnVisible, ElementName=GridControl, Mode=TwoWay, Converter={converters:BooleanToGroupIndexConverter}}"
                                                VisibleIndex="0"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Visible="{Binding Path=DataContext.CategoryColumnVisible, ElementName=GridControl}"
                                                Width="150"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AutoFilterCondition="Contains"
                                                SortOrder="Ascending">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="FeatureName"
                                                Header="Характеристика"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="True"
                                                Visible="{Binding Path=DataContext.FeatureColumnVisible, ElementName=GridControl}"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AutoFilterCondition="Contains"
                                                SortOrder="Ascending">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Name"
                                                Header="Название у контрагента"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PartNumber"
                                                Header="Артикул"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="90"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="SelectedComparsionItem"
                                                Header="Соответствие"
                                                HeaderToolTip="Название у нас"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False"
                                                AllowEditing="True">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor"
                                                              EditValue="{Binding Path=RowData.Row.SelectedComparsionItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding Path=RowData.Row.ComparsionItems, Mode=OneWay}"
                                                              ApplyItemTemplateToSelectedItem="True"
                                                              IsTextEditable="False"
                                                              EditValuePostMode="Immediate">
                                                <dxe:ComboBoxEdit.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Background="Transparent">
                                                            <dx:DXImage Height="16"
                                                                        Width="16"
                                                                        Margin="4,0,0,0">
                                                                <dx:DXImage.Style>
                                                                    <Style TargetType="{x:Type Image}">
                                                                        <Setter Property="Source"
                                                                                Value="{x:Null}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Path=ImageState, Mode=OneWay}"
                                                                                         Value="{x:Static parser:ParserAliasState.AssociatedAuto}">
                                                                                <Setter Property="Source"
                                                                                        Value="../../../Images/Common/android_16x16.png" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Path=ImageState, Mode=OneWay}"
                                                                                         Value="{x:Static parser:ParserAliasState.Associated}">
                                                                                <Setter Property="Source"
                                                                                        Value="../../../Images/Parser/link_16_16.png" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Path=ImageState, Mode=OneWay}"
                                                                                         Value="{x:Static parser:ParserAliasState.Postponed}">
                                                                                <Setter Property="Source"
                                                                                        Value="../../../Images/Parser/stopwatch_pause_16_16.png" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Path=ImageState, Mode=OneWay}"
                                                                                         Value="{x:Static parser:ParserAliasState.Ignored}">
                                                                                <Setter Property="Source"
                                                                                        Value="../../../Images/Parser/cross_shiled_16_16.png" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </dx:DXImage.Style>
                                                            </dx:DXImage>
                                                            <dxe:TextEdit IsPrintingMode="True"
                                                                          Text="{Binding Path=DisplayName, Mode=OneWay}"
                                                                          Background="Transparent"
                                                                          Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </dxe:ComboBoxEdit.ItemTemplate>
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ComparsionResult.ProposedValuesCount"
                                                Header="Кол-во"
                                                HeaderToolTip="Кол-во подходящих вариантов"
                                                FixedWidth="True"
                                                MinWidth="40"
                                                Width="60"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="NewProductId"
                                                Header="Код сайта"
                                                FixedWidth="True"
                                                MinWidth="60"
                                                Width="60"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                Visible="False">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CreatedOn"
                                                Header="Дата"
                                                HeaderToolTip="Дата добавления в словарь"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                MinWidth="60"
                                                Width="60"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="DateSmart">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings MaskType="DateTime"
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="dd.MM.yy"
                                                              HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Contractors"
                                                Header="Контрагент"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FixedWidth="False"
                                                MinWidth="80"
                                                Width="150"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AutoFilterCondition="Contains">
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Edited"
                                                Header="И"
                                                HeaderToolTip="Изменено"
                                                FixedWidth="True"
                                                MinWidth="24"
                                                Width="24"
                                                AllowGrouping="False"
                                                AllowMoving="False"
                                                AllowColumnFiltering="True"
                                                ColumnFilterMode="Value">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Width="16"
                                                        Height="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Source="../../../Images/CategoryOptions/pencil.png"
                                                        Visibility="{Binding Path=RowData.Row.Edited, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True}}">
                                            </dx:DXImage>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="TableView"
                                               ShowCheckBoxSelectorColumn="True"
                                               CheckBoxSelectorColumnWidth="24"
                                               RetainSelectionOnClickOutsideCheckBoxSelector="False"
                                               AutoWidth="True"
                                               ShowIndicator="False"
                                               AllowEditing="True"
                                               NavigationStyle="Cell"
                                               AllowFilterEditor="False"
                                               ShowFilterPanelMode="Default"
                                               ShowAutoFilterRow="False"
                                               ShowFixedTotalSummary="False"
                                               IsTotalSummaryMenuEnabled="False"
                                               ShowTotalSummary="False"
                                               ShowGroupedColumns="False"
                                               AllowGrouping="True"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               EditorShowMode="MouseDownFocused">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="ShownEditor"
                                                               Command="{Binding Path=HandleShownEditorCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand EventName="ShowFilterPopup"
                                                               Command="{Binding Path=ShowFilterPopupHandlerCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:TableView.RowCellMenuCustomizations>
                                        <dxb:BarLinkContainerItem>
                                            <dxb:BarSubItem Content="Перейти"
                                                            BarItemDisplayMode="ContentAndGlyph"
                                                            Glyph="{dx:DXImage Image=OpenHyperlink_16x16.png}">
                                                <dxb:BarLinkContainerItem ItemLinksSource="{Binding Path=(dxg:GridPopupMenu.GridMenuInfo).View.FocusedRow.Links, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                                                    <dxb:BarLinkContainerItem.ItemTemplate>
                                                        <DataTemplate>
                                                            <ContentControl>
                                                                <dxb:BarButtonItem Content="{Binding Path=Contractor, Mode=OneWay}"
                                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                                   Glyph="{dx:DXImage Image=ViewOnWeb_16x16.png}"
                                                                                   Command="{Binding Path=(dxg:GridPopupMenu.GridMenuInfo).View.DataContext.NavigateUriCommand, RelativeSource={RelativeSource Self}}"
                                                                                   CommandParameter="{Binding Path=Link, Mode=OneWay}"
                                                                                   IsEnabled="{Binding Path=Valid, Mode=OneWay}">
                                                                </dxb:BarButtonItem>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </dxb:BarLinkContainerItem.ItemTemplate>
                                                </dxb:BarLinkContainerItem>
                                            </dxb:BarSubItem>
                                        </dxb:BarLinkContainerItem>
                                    </dxg:TableView.RowCellMenuCustomizations>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                    <dxdo:LayoutPanel Caption="Поиск"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      AllowHide="True"
                                      FloatOnDoubleClick="False"
                                      MinWidth="300"
                                      MaxWidth="500"
                                      ItemWidth="400">
                        <dxlc:LayoutControl Orientation="Vertical"
                                            ItemStyle="{StaticResource LayoutItemStyle}"
                                            IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxlc:LayoutItem Label="Название">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Parser/book_16_16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=Filter.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Код">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/package.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=Filter.ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              MaskType="RegEx"
                                              Mask="\d*"
                                              MaskUseAsDisplayFormat="False" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Контрагент">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/user_suit.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Contractors, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.SelectedContractors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="DisplayValue"
                                                  Style="{StaticResource TokenComboBoxStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Статус">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/lightbulb.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.ParserAliasStates, Mode=OneWay}"
                                                  DisplayMember="Name"
                                                  EditValue="{Binding Path=Filter.SelectedStatuses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StatusSelectedItemsConverter}}"
                                                  Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Категория"
                                             LabelPosition="Left"
                                             LabelVerticalAlignment="Top"
                                             VerticalAlignment="Stretch">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Parser/folders_16_16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <common:CategoryTreeView Categories="{Binding Path=Filter.Categories, Mode=OneWay}"
                                                         SelectedCategories="{Binding Path=Filter.SelectedCategories, Mode=TwoWay}"
                                                         SelectionMode="Row"
                                                         ShowBorder="True"
                                                         ShowLoadingPanel="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </common:CategoryTreeView>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Строк"
                                             VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Filter.RecordsCount, Mode=OneWay}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal"
                                                 VerticalAlignment="Bottom" />
                            <dxlc:LayoutItem VerticalAlignment="Bottom">
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       GlyphAlignment="Left"
                                                       Command="{Binding RefreshCommand, Mode=OneWay}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       GlyphAlignment="Left"
                                                       Command="{Binding ResetFilterCommand, Mode=OneWay}" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>