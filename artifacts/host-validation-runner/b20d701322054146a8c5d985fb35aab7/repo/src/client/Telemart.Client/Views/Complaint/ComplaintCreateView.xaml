<UserControl x:Class="Telemart.Client.Views.Complaint.ComplaintCreateView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Complaint"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:ComplaintCreateViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:ComplaintCreateViewModel}, IsDesignTimeCreatable=True}"
             Width="675"
             Height="410">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Priority.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Источник">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Sources}"
                                  EditValue="{Binding Path=SourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  IsTextEditable="False"/>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Тип">
                <dxg:LookUpEdit ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                EditValue="{Binding Path=Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                DisplayMember="Name"
                                AutoPopulateColumns="False"
                                AutoComplete="False"
                                IncrementalFiltering="True"
                                FilterCondition="Like"
                                FindMode="Always"
                                ImmediatePopup="True"
                                IsPopupAutoWidth="True">
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:LookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate>
                            <dxg:GridControl Name="PART_GridControl">
                                <dxg:GridControl.Resources>
                                    <Style TargetType="dxg:GridColumn"
                                           BasedOn="{StaticResource GeneralGridColumnStyle}">
                                    </Style>
                                </dxg:GridControl.Resources>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Name"
                                                    Header="Название"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    AllowResizing="False"
                                                    FixedWidth="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor">
                                                    <dxe:TextEdit.Style>
                                                        <Style TargetType="{x:Type dxe:TextEdit}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True"
                                                                             Binding="{Binding Path=RowData.Row.ParentId, Converter={dxmvvm:ObjectToBooleanConverter Inverse=True}}">
                                                                    <Setter Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </dxe:TextEdit.Style>
                                                </dxe:TextEdit>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TreeListView KeyFieldName="Id"
                                                      ParentFieldName="ParentId"
                                                      AutoWidth="True"
                                                      AutoExpandAllNodes="False"
                                                      ShowIndicator="False"
                                                      UseEvenRowBackground="True"
                                                      AlternationCount="2"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Приоритет">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Priorities}"
                                  EditValue="{Binding Path=PriorityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  IsTextEditable="False"
                                  ItemTemplate="{StaticResource PriorityComboBoxItemTemplate}"
                                  ApplyItemTemplateToSelectedItem="True"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Жалоба"
                             LabelVerticalAlignment="Top"
                             VerticalAlignment="Stretch">
                <dxe:TextEdit EditValue="{Binding Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              VerticalContentAlignment="Top"
                              TextWrapping="Wrap"
                              AcceptsReturn="True"
                              MinHeight="50"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Товар"
                             Visibility="{Binding Path=ProductsVisible, Converter={dx:BooleanToVisibilityConverter}}">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Products}"
                                  EditValue="{Binding Path=ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayValue"
                                  IsTextEditable="False"
                                  NullValueButtonPlacement="EditBox"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Ответственный">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                  EditValue="{Binding Path=EmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="DisplayValue"
                                  ValueMember="Id"
                                  NullValueButtonPlacement="EditBox"
                                  FilterCondition="StartsWith"
                                  Style="{StaticResource SearchableComboBoxStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Дедлайн">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxe:DateEdit EditValue="{Binding Path=DeadLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                  MinValue="{Binding MinDeadLineValue}"
                                  MaxValue="{Binding MaxDeadLineValue}"
                                  Style="{StaticResource BasicDateEdit}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="ФИО">
                <dxe:TextEdit EditValue="{Binding Path=Fio, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Телефон">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxe:TextEdit EditValue="{Binding Path=Phone, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource PhoneTextEdit}" />
                    <dxe:TextEdit EditValue="{Binding Path=Phone2, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource PhoneTextEdit}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Email">
                <dxe:TextEdit EditValue="{Binding Path=Email, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" />
            </dxlc:LayoutItem>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Создание..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxe:CheckEdit Content="Открыть после создания"
                               EditValue="{Binding Path=OpenAfterCreate, Mode=TwoWay}"
                               Visibility="{Binding Path=IsVisible, ElementName=WaitImage, Converter={dx:BooleanToVisibilityConverter Invert=True}}"/>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>