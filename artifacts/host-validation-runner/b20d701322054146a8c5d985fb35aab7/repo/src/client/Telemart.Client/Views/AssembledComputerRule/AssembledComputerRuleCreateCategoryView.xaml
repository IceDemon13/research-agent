<controls:TelemartUserControl x:Class="Telemart.Client.Views.AssembledComputerRule.AssembledComputerRuleCreateCategoryView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:assembledComputerRule="clr-namespace:Telemart.Client.ViewModels.AssembledComputerRule"
                              DataContext="{client:Container Type=assembledComputerRule:AssembledComputerRuleCreateCategoryViewModel}"
                              Width="440"
                              Height="190"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type assembledComputerRule:AssembledComputerRuleCreateCategoryViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutItem Label="Категория">
                <dxg:LookUpEdit ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                EditValue="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                DisplayMember="Name"
                                AutoPopulateColumns="False"
                                AutoComplete="False"
                                IncrementalFiltering="True"
                                FilterCondition="Like"
                                FindMode="Always"
                                ImmediatePopup="True"
                                IsPopupAutoWidth="True"
                                InvalidValueBehavior="AllowLeaveEditor"
                                PopupContentTemplate="{StaticResource LookUpEditCategoryControlTemplate}">
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:SearchLookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                </dxg:LookUpEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Тип товара">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=ProductTypes, Mode=OneWay}"
                                  EditValue="{Binding Path=SelectedProductTypeIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Хар-ка">
                <dxg:LookUpEdit ItemsSource="{Binding Path=Features, Mode=OneWay}"
                                EditValue="{Binding Path=SelectedFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                DisplayMember="DisplayValue"
                                AutoPopulateColumns="False"
                                AutoComplete="False"
                                IncrementalFiltering="True"
                                FilterCondition="Like"
                                FindMode="Always"
                                NullValueButtonPlacement="EditBox"
                                ImmediatePopup="True"
                                IsPopupAutoWidth="True"

                                InvalidValueBehavior="AllowLeaveEditor"
                                PopupContentTemplate="{StaticResource FeatureControlTemplate}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="Validate"
                                               Command="{Binding Path=FeatureValidateCommand, Mode=OneWay}"
                                               PassEventArgsToCommand="True" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:SearchLookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                    <dxg:LookUpEdit.IsEnabled>
                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                            <Binding Path="AnyFeatures"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </dxg:LookUpEdit.IsEnabled>
                </dxg:LookUpEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Операция">
                <dxe:ComboBoxEdit EditValue="{Binding SelectedOperation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Operations}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Значение хар-ки">
                <dxg:LookUpEdit ItemsSource="{Binding Path=FeatureValues, Mode=OneWay}"
                                EditValue="{Binding Path=SelectedFeatureValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                DisplayMember="DisplayValue"
                                AutoPopulateColumns="False"
                                AutoComplete="False"
                                IncrementalFiltering="True"
                                FilterCondition="Like"
                                FindMode="Always"
                                ImmediatePopup="True"
                                IsEnabled="{Binding Path=IsFeatureValueEnabled, Mode=OneWay}"
                                IsPopupAutoWidth="True"
                                InvalidValueBehavior="AllowLeaveEditor"
                                PopupContentTemplate="{StaticResource FeatureControlTemplate}">
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:SearchLookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                </dxg:LookUpEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsTabStop="True"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        IsTabStop="True"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>