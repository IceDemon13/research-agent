<UserControl x:Class="Telemart.Client.Views.Parser.Monitoring.ParserCronicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Parser.Monitoring"
             DataContext="{client:Container Type=viewModels:ParserCronicleViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ParserCronicleViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:EventToCommand EventName="Unloaded"
                               Command="{Binding Path=HandleUnloadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager>
            <dxb:ToolBarControl AllowQuickCustomization="False"
                                AllowCustomizationMenu="False"
                                BorderThickness="1">
                <dxb:BarButtonItem Content="Назад"
                                   LargeGlyph="{dx:DXImage Image=Prev_32x32.png}"
                                   Glyph="{dx:DXImage Image=Prev_16x16.png}"
                                   ItemClick="PrevClick" />
                <dxb:BarButtonItem Content="Вперед"
                                   LargeGlyph="{dx:DXImage Image=Next_32x32.png}"
                                   Glyph="{dx:DXImage Image=Next_16x16.png}"
                                   ItemClick="NextClick" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Обновить"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding RefreshCommand}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Сообщить о проблеме"
                                   LargeGlyph="../../../Images/Common/user_comment_32x32.png"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding CreateDiscussionCommand}"/>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <wv2:WebView2 Grid.Row="1"
                      x:Name="WebBrowser"
                      Source="{Binding Path=NavigationUrl, Mode=OneWay}">
            <dxmvvm:Interaction.Behaviors>
                <dxmvvm:EventToCommand EventName="Loaded"
                                       Command="{Binding Path=WebView2LoadedCommand}"
                                       PassEventArgsToCommand="True"/>
                <dxmvvm:EventToCommand EventName="NavigationStarting"
                                       Command="{Binding NavigationStartingCommand}" PassEventArgsToCommand="True"/>
                <dxmvvm:EventToCommand EventName="NavigationCompleted"
                                       Command="{Binding NavigationCompletedCommand}" PassEventArgsToCommand="True"/>
            </dxmvvm:Interaction.Behaviors>
        </wv2:WebView2>
    </Grid>

</UserControl>