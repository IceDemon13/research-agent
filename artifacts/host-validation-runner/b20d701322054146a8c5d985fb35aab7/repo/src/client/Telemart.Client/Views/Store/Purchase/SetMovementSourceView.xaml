<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Purchase.SetMovementSourceView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:purchase="clr-namespace:Telemart.Client.ViewModels.Store.Purchase"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              DataContext="{client:Container Type=purchase:SetMovementSourceViewModel}"
                              Loaded="SetMovementSourceViewOnLoaded"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type purchase:SetMovementSourceViewModel}}"
                              d:DesignWidth="800"
                              d:DesignHeight="450">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style TargetType="dxg:GridColumn">
                        <Setter Property="AllowSorting"
                                Value="True" />
                        <Setter Property="AllowAutoFilter"
                                Value="False" />
                        <Setter Property="AllowBestFit"
                                Value="True" />
                        <Setter Property="AllowCellMerge"
                                Value="False" />
                        <Setter Property="AllowColumnFiltering"
                                Value="False" />
                        <Setter Property="AllowGrouping"
                                Value="False" />
                        <Setter Property="AllowMoving"
                                Value="True" />
                        <Setter Property="AllowResizing"
                                Value="False" />
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="FixedWidth"
                                Value="True" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               FontWeight="Bold"
                                               Width="{TemplateBinding Width}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=WaitImage}">
            <Border BorderBrush="DarkGray"
                    BorderThickness="1"
                    UseLayoutRounding="True"
                    VerticalAlignment="Top"
                    Height="31">
                <dxe:TextEdit EditValue="{Binding Path=ProductName, Mode=OneWay}"
                              IsPrintingMode="True"
                              Margin="10,0,0,0" />
            </Border>
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Movements, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedMovement, Mode=TwoWay}"
                                 ShowLoadingPanel="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                                 SelectionMode="None">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:LayoutSerializationBehavior FileName="set_movement_source_items.xml" />
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="MovementId"
                                        Header="Номер"
                                        HeaderToolTip="Номер перемещения"
                                        HorizontalHeaderContentAlignment="Center"
                                        Width="50">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="WarehouseFromName"
                                        Header="Отправитель"
                                        HeaderToolTip="Склад отправитель"
                                        FixedWidth="False" />
                        <dxg:GridColumn FieldName="WarehouseToName"
                                        Header="Получатель"
                                        HeaderToolTip="Склад получатель"
                                        FixedWidth="False" />
                        <dxg:GridColumn FieldName="DeliveryDateTime"
                                        Header="Дата Х"
                                        HeaderToolTip="Дата поступления"
                                        HorizontalHeaderContentAlignment="Left"
                                        Width="100">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Stretch">
                                        <dx:DXImage Source="{Binding Path=RowData.Row.SucceedInTimeState, Mode=OneWay, Converter={converters:EnumToImageSourceConverter}}"
                                                    ToolTip="{Binding Path=RowData.Row.SucceedInTimeState, Mode=OneWay, Converter={converters:EnumToDisplayTextConverter}}"
                                                    Width="16"
                                                    Height="16" />
                                        <dxe:DateEdit x:Name="PART_Editor"
                                                      Mask="dd.MM.yy HH:mm"
                                                      MaskUseAsDisplayFormat="True"
                                                      HorizontalContentAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AvailableQuantity"
                                        Header="Свободно"
                                        HeaderToolTip="Количество свободных товаров"
                                        HorizontalHeaderContentAlignment="Left"
                                        Width="80">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <dx:DXImage Source="{StaticResource BulletGreenImageSource}"
                                                    Width="16"
                                                    Height="16"
                                                    ToolTip="Все ОК"
                                                    Visibility="{Binding Path=RowData.Row.SatisfyNeeds, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                        <dx:DXImage Source="{StaticResource BulletRedImageSource}"
                                                    Width="16"
                                                    Height="16"
                                                    ToolTip="Недостаточно товара в свободном остатке"
                                                    Visibility="{Binding Path=RowData.Row.SatisfyNeeds, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}" />
                                        <dxe:TextEdit Name="PART_Editor"
                                                      HorizontalContentAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Quantity"
                                        Header="Всего"
                                        HeaderToolTip="Общее количество товаров"
                                        HorizontalHeaderContentAlignment="Left"
                                        Width="80">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView ShowTotalSummary="False"
                                       ShowGroupPanel="False"
                                       ShowIndicator="False"
                                       ShowGroupFooters="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowSearchPanelMode="Never"
                                       AllowResizing="False"
                                       AllowMoveColumnToDropArea="False"
                                       IsColumnMenuEnabled="False"
                                       AllowPerPixelScrolling="True"
                                       AutoWidth="True"
                                       AllowEditing="False"
                                       NavigationStyle="Row">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding Path=OkCommand, Mode=OneWay}" />
                                <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                                                       Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                                <dxmvvm:FocusBehavior PropertyName="IsEnabled"
                                                      SourceName="LayoutControl" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                              LabelColumnWidth="1*"
                                              ContentColumnWidth="3*"
                                              Width="200" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dx:SimpleButton Content="ОК"
                                 IsTabStop="True"
                                 HorizontalAlignment="Right"
                                 Command="{Binding Path=OkCommand, Mode=OneTime}" />
                <dx:SimpleButton Content="Отмена"
                                 IsTabStop="True"
                                 HorizontalAlignment="Right"
                                 Command="{Binding Path=CancelCommand, Mode=OneTime}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
