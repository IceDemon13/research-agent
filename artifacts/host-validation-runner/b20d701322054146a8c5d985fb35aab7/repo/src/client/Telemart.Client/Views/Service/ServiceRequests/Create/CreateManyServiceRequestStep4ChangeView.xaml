<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.Create.CreateManyServiceRequestStep4ChangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests.Create"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             mc:Ignorable="d" 
             DataContext="{client:Container Type=viewModels:CreateManyServiceRequestStep4ChangeViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateManyServiceRequestStep4ChangeViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <viewComponents:WaitImage VerticalAlignment="Center"
                                          Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Назад"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True">
                    <dxco:WizardButton.IsEnabled>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                            <Binding Path="(dxe:ValidationService.HasValidationError)"
                                     ElementName="LayoutControl" />
                            <Binding Path="IsLongOperationInProgress" />
                        </MultiBinding>
                    </dxco:WizardButton.IsEnabled>
                </dxco:WizardButton>
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Model.SelectedProducts, Mode=OneWay}"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         SelectionMode="None">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Товар"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="Name"
                                                ReadOnly="True"
                                                AllowMoving="False"
                                                Width="337"/>
                    <dxg:GridColumn Header="Товар"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="ChangeOnProductName"
                                                ReadOnly="True"
                                                Width="337">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <dxe:TextEdit x:Name="PART_Editor"
                                              EditValue="{Binding RowData.Row.ChangeOnProductName}" 
                                                  Width="315"/>
                                    <dx:SimpleButton Command="{Binding Path=DataContext.SelectProductCommand, Mode=OneWay, ElementName=LayoutControl}"
                                                     IsEnabled="{Binding Path=RowData.Row.BundleProduct, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                                     CommandParameter="{Binding Path=RowData.Row.ProductId, Mode=OneWay}"
                                                     Content="..."
                                                     Width="20"
                                                     MinWidth="20"
                                                     Height="20"
                                                     Padding="1 1 1 1"
                                                     HorizontalAlignment="Right" />
                                </DockPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowResizing="False"
                                               AllowPerPixelScrolling="True"
                                               ShowGroupPanel="False"
                                               ShowIndicator="False"
                                               AllowGrouping="False"/>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutControl>
    </DockPanel>
</UserControl>
