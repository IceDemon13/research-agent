<UserControl x:Class="Telemart.Client.Views.Money.Refund.RefundsView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:refund="clr-namespace:Telemart.Client.ViewModels.Money.Refund"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=refund:RefundsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type refund:RefundsViewModel}}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Contractor.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Payment.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Refund/RefundState.xaml" />
                <ResourceDictionary>
                    <converters:RefundStateSelectedItemsConverter x:Key="RefundStateSelectedItemsConverter" />
                    <converters:PaymentSelectedItemsConverter x:Key="PaymentSelectedItemsConverter" />

                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Path=CurrentRefund, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel x:Name="Center"
                                      Style="{StaticResource PanelStyle}"
                                      ShowBorder="False">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Refunds, Mode=OneWay}"
                                         CurrentItem="{Binding Path=CurrentRefund, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ShowBorder="True"
                                         ClipboardCopyMode="ExcludeHeader"
                                         SelectionMode="None"
                                         AutoExpandAllGroups="True">
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.ShowLoadingPanel>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="RefreshCommand.IsExecuting" />
                                    <Binding Path="HandleLoadedCommand.IsExecuting" />
                                </MultiBinding>
                            </dxg:GridControl.ShowLoadingPanel>
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="refunds.xml" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Id"
                                                Header="Возврат"
                                                FixedWidth="True"
                                                AllowMoving="False"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="False"
                                                AllowColumnFiltering="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CreatedOn"
                                                Header="Создана"
                                                FixedWidth="True"
                                                AllowMoving="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="Date"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="90">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              NullText=""
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                              MaskType="DateTime">
                                        </dxe:DateEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ApprovedOn"
                                                Header="Подтверждена"
                                                FixedWidth="True"
                                                AllowMoving="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="Date"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="90">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              NullText=""
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                              MaskType="DateTime">
                                        </dxe:DateEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PayedOn"
                                                Header="Выполнена"
                                                FixedWidth="True"
                                                AllowMoving="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="Date"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="90">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              NullText=""
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                              MaskType="DateTime">
                                        </dxe:DateEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Клиент"
                                                HeaderToolTip="Клиент заказа"
                                                FieldName="OrderClientId"
                                                FixedWidth="True"
                                                Width="85"
                                                MinWidth="24"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                  ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="Name"
                                                                  IsTextEditable="False"
                                                                  ApplyItemTemplateToSelectedItem="True"
                                                                  ItemTemplate="{StaticResource ContractorItemTemplate}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="OrderId"
                                                Header="Заказ"
                                                FixedWidth="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ServiceRequestId"
                                                Header="Заявка"
                                                HorizontalHeaderContentAlignment="Center"
                                                FixedWidth="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="False"
                                                MinWidth="60"
                                                Width="60">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Payment"
                                                Header="Оплата"
                                                HeaderToolTip="Оплата"
                                                HorizontalHeaderContentAlignment="Left"
                                                DisplayTemplate="{StaticResource PaymentColumnDisplayTemplate}"
                                                FixedWidth="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                Visible="False"
                                                MinWidth="24"
                                                Width="120"/>
                                <dxg:GridColumn Header="Валюта"
                                                HeaderToolTip="Валюта"
                                                FieldName="Currency.Title"
                                                FixedWidth="True"
                                                MaxWidth="80"
                                                Width="60"
                                                MinWidth="35"
                                                AllowBestFit="True"
                                                HorizontalHeaderContentAlignment="Center"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AllowColumnFiltering="True"
                                                AllowResizing="True"
                                                AllowGrouping="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CashboxId"
                                                Header="Касса"
                                                AllowBestFit="True"
                                                FixedWidth="True"
                                                AllowGrouping="True"
                                                AllowColumnFiltering="True"
                                                FilterPopupMode="CheckedList"
                                                MinWidth="80"
                                                Width="160">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                  ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="DisplayValue" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="ФЧ"
                                                HeaderToolTip="Фискальный чек"
                                                FieldName="RealCompletedOnFiscalRegistrar"
                                                FixedWidth="True"
                                                Width="34"
                                                MinWidth="34"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                FilterPopupMode="CheckedList"
                                                AllowColumnFiltering="True"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/tick.png"
                                                        Width="16"
                                                        Height="16"
                                                        Visibility="{Binding Path=RowData.Row.RealCompletedOnFiscalRegistrar, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Fio"
                                                Header="ФИО"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="False"
                                                MinWidth="50"
                                                Width="140"
                                                FixedWidth="True"
                                                AllowGrouping="False" />
                                <dxg:GridColumn FieldName="State"
                                                Header="Статус"
                                                HeaderToolTip="Статус"
                                                FixedWidth="True"
                                                MaxWidth="80"
                                                Width="26"
                                                MinWidth="26"
                                                AllowBestFit="True"
                                                AllowMoving="True"
                                                FilterPopupMode="CheckedList"
                                                ColumnFilterMode="DisplayText"
                                                AllowColumnFiltering="True"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                DisplayTemplate="{StaticResource RefundStateColumnDisplayTemplate}" />
                                <dxg:GridColumn FieldName="Amount"
                                                Header="Сумма"
                                                HorizontalHeaderContentAlignment="Right"
                                                AllowMoving="False"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="False"
                                                MinWidth="50"
                                                Width="100"
                                                FixedWidth="True">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor"
                                                          MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskCulture="{Binding Path=RowData.Row.Currency.Id, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                                          MaskSaveLiteral="False"
                                                          IsFloatValue="True"
                                                          AllowDefaultButton="False"
                                                          HorizontalContentAlignment="Right" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Description"
                                                Header="Описание"
                                                AllowMoving="False"
                                                AllowBestFit="True"
                                                AllowColumnFiltering="False" />
                                <dxg:GridColumn Header="З"
                                                HorizontalHeaderContentAlignment="Center"
                                                HeaderToolTip="Заблокировал"
                                                FieldName="EmployeeLockId"
                                                FixedWidth="True"
                                                Width="24"
                                                MinWidth="24"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowAutoFilter="False"
                                                AllowSorting="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dx:DXImage Source="../../../Images/Common/lock.png"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Path=RowData.Row.EmployeeLockId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                        HorizontalAlignment="Center">
                                                <dx:DXImage.ToolTip>
                                                    <dxlc:LayoutControl Orientation="Vertical">
                                                        <dxlc:LayoutControl.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight"
                                                                        Value="Bold" />
                                                            </Style>
                                                        </dxlc:LayoutControl.Resources>
                                                        <dxlc:LayoutItem Label="Заблокировал:">
                                                            <TextBlock Text="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay}" />
                                                        </dxlc:LayoutItem>
                                                    </dxlc:LayoutControl>
                                                </dx:DXImage.ToolTip>
                                            </dx:DXImage>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True"
                                               AllowEditing="False"
                                               NavigationStyle="Cell"
                                               ShowIndicator="False"
                                               ShowAutoFilterRow="False"
                                               ShowFixedTotalSummary="False"
                                               IsTotalSummaryMenuEnabled="True"
                                               ShowTotalSummary="False"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                               CommandParameter="{Binding Path=CurrentRefund, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl x:Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Создан">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Order/Filter/calendar.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      VerticalAlignment="Center">
                                        <dxe:DateEdit EditValue="{Binding Path=CreatedFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }" />
                                        <TextBlock Text="-"
                                                   Width="8"
                                                   TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=CreatedTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }" />
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Возврат">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Common/coins_delete_16x16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=RefundIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Заказ">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Order/Filter/cart.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=OrderIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Заявка">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Call/toolbox.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=ServiceRequestIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="ФИО">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/user_green.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxg:PrintTextEdit EditValue="{Binding Path=Fio, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:PrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Телефон">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/phone.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:TextEdit EditValue="{Binding Path=Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:TextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Оплата">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Order/Filter/money.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Payments, Mode=OneWay}"
                                                      EditValue="{Binding Path=SelectedPayments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PaymentSelectedItemsConverter}}"
                                                      DisplayMember="Name"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Касса">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Order/Filter/cart.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                                      EditValue="{Binding Path=SelectedCashboxes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="DisplayValue"
                                                      Style="{StaticResource TokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=RefundStates, Mode=OneWay}"
                                                      EditValue="{Binding Path=SelectedStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource RefundStateSelectedItemsConverter}}"
                                                      DisplayMember="Name"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Фискальный чек">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/cheque.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:CheckEdit EditValue="{Binding Path=CompletedOnFiscalRegistrar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsThreeState="True" />
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Возвратов"
                                                 Height="20">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                        <dxe:TextEdit EditValue="{Binding Path=Refunds.Count, Mode=OneWay}"
                                                      IsPrintingMode="True"
                                                      FontWeight="Bold" />
                                        <dxe:TextEdit EditValue=" шт."
                                                      IsPrintingMode="True" />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="На сумму"
                                                 Height="20">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                        <dxe:TextEdit EditValue="{Binding Path=SumUah, Mode=OneWay, FallbackValue=0}"
                                                      IsPrintingMode="True"
                                                      FontWeight="Bold"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="C2"
                                                      MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}" />
                                        <dxe:TextEdit EditValue=" грн, "
                                                      IsPrintingMode="True" />
                                        <dxe:TextEdit EditValue="{Binding Path=SumUsd, Mode=OneWay, FallbackValue=0}"
                                                      IsPrintingMode="True"
                                                      FontWeight="Bold"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{x:Static business:CurrencyFormatingRules.UsdFormat}"
                                                      MaskCulture="{x:Static business:CurrencyFormatingRules.UsdCultureInfo}" />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>

</UserControl>