<UserControl x:Class="Telemart.Client.Views.Notification.NotificationsSubscribesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Notification"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:NotificationsSubscribesViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:NotificationsSubscribesViewModel}}"
             Width="770"
             Height="400"
             d:DesignWidth="730"
             d:DesignHeight="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <DockPanel>
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="0"
                                  View="GroupBox"
                                  IsEnabled="True"
                                  GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Subscribes, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     SelectionMode="None">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Документ"
                                            HeaderToolTip="Название документа"
                                            FieldName="NotificationEntityId"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="70"
                                            ReadOnly="True"
                                            AllowEditing="False"
                                            MaxWidth="80"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=NotificationEntities, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Уведомление"
                                            HeaderToolTip="Текст уведомления"
                                            FieldName="NotificationTypeId"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            ReadOnly="True"
                                            AllowEditing="False"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Left">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=NotificationTypes, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TelemartClient"
                                            Header="Telemart.Client"
                                            FixedWidth="True"
                                            Width="110"
                                            AllowResizing="False"
                                            HeaderToolTip="Получать уведомления в Telemart.Client"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowColumnFiltering="False"
                                            AllowSorting="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="PART_Editor"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding RowData.Row.TelemartClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Telegram"
                                            Header="Telegram"
                                            FixedWidth="True"
                                            Width="110"
                                            AllowResizing="False"
                                            HeaderToolTip="Получать уведомления в Telegram"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowColumnFiltering="False"
                                            AllowSorting="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="PART_Editor"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding RowData.Row.Telegram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Н"
                                            FieldName="ConfigButtonVisible"
                                            HeaderToolTip="Настройка уведомлений"
                                            HorizontalHeaderContentAlignment="Center"
                                            Width="32"
                                            AllowColumnFiltering="False"
                                            AllowSorting="False"
                                            MinWidth="32"
                                            FixedWidth="True"
                                            AllowResizing="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚙️"
                                                x:Name="PART_Editor"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Margin="0,-2,0,-2"
                                                Visibility="{Binding Path=RowData.Row.ConfigButtonVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                Command="{Binding Path=View.DataContext.ShowConfigCommand, ElementName=GridControl}"
                                                CommandParameter="{Binding Path=RowData.Row, Mode=OneWay}"
                                                IsEnabled="True" />

                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowResizing="True"
                                           AllowPerPixelScrolling="True"
                                           ShowGroupPanel="False"
                                           AutoWidth="True"
                                           AllowEditing="True"
                                           ShowIndicator="False"
                                           AllowGrouping="False" >
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="HandleLoadedCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <Button Content="Инициализация Telegram бота"
                        ToolTip="Инициализация Telegram бота для получения уведомлений"
                        Command="{Binding Path=OpenTelegramNotificationBotCommand, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../../Images/Common/comment.png"
                                            Width="16"
                                            Height="16" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsTabStop="True"
                            IsEnabled="True" />
                    <Button Content="Отмена"
                            IsTabStop="True"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>
</UserControl>