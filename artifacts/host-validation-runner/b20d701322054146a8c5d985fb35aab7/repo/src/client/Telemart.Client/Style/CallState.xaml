<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="NewImage"
                 UriSource="/Images/Common/lightbulb.png" />
    <BitmapImage x:Key="SolvedImage"
                 UriSource="/Images/Common/tick.png" />
    <BitmapImage x:Key="NotSolvedImage"
                 UriSource="/Images/Common/emoticon_unhappy.png" />
    <BitmapImage x:Key="NotReachedImage"
                 UriSource="/Images/Common/phone_handset_16x16.png" />
    <BitmapImage x:Key="CanceledImage"
                 UriSource="/Images/Common/canceled.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="CallStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource NewImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource SolvedImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource NotSolvedImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource NotReachedImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource CanceledImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="CallStateComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:CallState}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource CallStateImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="CallStateColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource CallStateComboBoxItemTemplate}"/>
    </ControlTemplate>
</ResourceDictionary>