<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:transferObjects="clr-namespace:Telemart.Client.TransferObjects;assembly=Telemart.Client.TransferObjects">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Subdivision.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="ContractorItemTemplate"
                  DataType="{x:Type transferObjects:ContractorDto}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="21">
            <dx:DXImage Source="{Binding Path=SubdivisionId, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="4,0,0,0" />
            <Label Content="{Binding Path=Name, Mode=OneWay}"
                   Background="Transparent"
                   Margin="4,0,0,0" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>