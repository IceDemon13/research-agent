<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="LowImage"
                 UriSource="/Images/Priority/priority1.png" />
    <BitmapImage x:Key="NormalImage"
                 UriSource="/Images/Priority/priority2.png" />
    <BitmapImage x:Key="HighImage"
                 UriSource="/Images/Priority/priority3.png" />
    <BitmapImage x:Key="CriticalImage"
                 UriSource="/Images/Priority/priority4.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="PriorityImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource LowImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource NormalImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource HighImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource CriticalImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="PriorityComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:Priority}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource PriorityImageConverter}}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="PriorityColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource PriorityComboBoxItemTemplate}" />
    </ControlTemplate>

</ResourceDictionary>