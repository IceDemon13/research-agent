<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="OpenImage"
                 UriSource="/Images/Invoice/InvoiceState/1.png" />
    <BitmapImage x:Key="ClosedImage"
                 UriSource="/Images/Invoice/InvoiceState/2.png" />
    <BitmapImage x:Key="ArrivedImage"
                 UriSource="/Images/Invoice/InvoiceState/3.png" />
    <BitmapImage x:Key="ReceivedImage"
                 UriSource="/Images/Invoice/InvoiceState/4.png" />
    <BitmapImage x:Key="CanceledImage"
                 UriSource="/Images/Invoice/InvoiceState/5.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="InvoiceStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource OpenImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource ClosedImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource ArrivedImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource ReceivedImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource CanceledImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="InvoiceStateComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:InvoiceState}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource InvoiceStateImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="InvoiceStateColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource InvoiceStateComboBoxItemTemplate}"/>
    </ControlTemplate>
</ResourceDictionary>