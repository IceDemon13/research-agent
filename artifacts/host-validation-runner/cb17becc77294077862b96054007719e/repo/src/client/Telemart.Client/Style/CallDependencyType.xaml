<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="OrderImage"
                 UriSource="/Images/Common/cart_full_16x16.png" />
    <BitmapImage x:Key="ServiceRequestImage"
                 UriSource="/Images/Common/toolbox.png" />
    <BitmapImage x:Key="ComplaintImage"
                 UriSource="/Images/Common/thumb_down_16x16.png" />
    <BitmapImage x:Key="OrderProductImage"
                 UriSource="/Images/Order/Filter/package.png" />
    <BitmapImage x:Key="CallImage"
                 UriSource="/Images/Common/headphone.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="DependencyTypeImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource OrderImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource ServiceRequestImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource ComplaintImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource OrderProductImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource CallImage}" />

    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="DependencyTypeComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:CallDependencyType}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource DependencyTypeImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="DependencyTypeColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource DependencyTypeComboBoxItemTemplate}" />
    </ControlTemplate>
</ResourceDictionary>