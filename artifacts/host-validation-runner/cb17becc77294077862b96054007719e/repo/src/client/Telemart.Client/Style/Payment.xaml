<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PaymentGray.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BitmapImage x:Key="CashImage"
                 UriSource="/Images/Order/Payment/payment1.png" />
    <BitmapImage x:Key="BankImage"
                 UriSource="/Images/Order/Payment/payment2.png" />
    <BitmapImage x:Key="WmzImage"
                 UriSource="/Images/Order/Payment/payment3.png" />
    <BitmapImage x:Key="WmuImage"
                 UriSource="/Images/Order/Payment/payment4.png" />
    <BitmapImage x:Key="CashlessTaxImage"
                 UriSource="/Images/Order/Payment/payment5.png" />
    <BitmapImage x:Key="CashlessNoTaxImage"
                 UriSource="/Images/Order/Payment/payment6.png" />
    <BitmapImage x:Key="NoImage"
                 UriSource="/Images/Order/Payment/payment7.png" />
    <BitmapImage x:Key="BitcoinImage"
                 UriSource="/Images/Order/Payment/payment8.png" />
    <BitmapImage x:Key="CreditImage"
                 UriSource="/Images/Order/Payment/payment9.png" />
    <BitmapImage x:Key="LiqPayImage"
                 UriSource="/Images/Order/Payment/payment10.png" />
    <BitmapImage x:Key="TerminalImage"
                 UriSource="/Images/Order/Payment/payment11.png" />
    <BitmapImage x:Key="MonobankImage"
                 UriSource="/Images/Order/Payment/payment12.png" />
    <BitmapImage x:Key="OschadImage"
                 UriSource="/Images/Order/Payment/payment13.png" />
    <BitmapImage x:Key="AlfabankImage"
                 UriSource="/Images/Order/Payment/payment14.png" />
    <BitmapImage x:Key="IdeabankImage"
                 UriSource="/Images/Order/Payment/payment15.png" />
    <BitmapImage x:Key="PaylaterImage"
                 UriSource="/Images/Order/Payment/payment16.png" />
    <BitmapImage x:Key="MonoPayImage"
                 UriSource="/Images/Order/Payment/payment19.png" />
    <BitmapImage x:Key="NovaPayImage"
                 UriSource="/Images/Order/Payment/payment20.png" />
    <BitmapImage x:Key="PumbImage"
                 UriSource="/Images/Order/Payment/payment21.png" />
    <BitmapImage x:Key="ABankImage"
                 UriSource="/Images/Order/Payment/payment22.png" />
    <BitmapImage x:Key="BonusesImage"
                 UriSource="/Images/Order/Payment/ruby.png" />
    <dxmvvm:ObjectToObjectConverter x:Key="PaymentImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource CashImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource BankImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource WmzImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource WmuImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource CashlessTaxImage}" />
        <dxmvvm:MapItem Source="6"
                        Target="{StaticResource CashlessNoTaxImage}" />
        <dxmvvm:MapItem Source="7"
                        Target="{StaticResource NoImage}" />
        <dxmvvm:MapItem Source="8"
                        Target="{StaticResource BitcoinImage}" />
        <dxmvvm:MapItem Source="9"
                        Target="{StaticResource CreditImage}" />
        <dxmvvm:MapItem Source="10"
                        Target="{StaticResource LiqPayImage}" />
        <dxmvvm:MapItem Source="11"
                        Target="{StaticResource TerminalImage}" />
        <dxmvvm:MapItem Source="12"
                        Target="{StaticResource MonobankImage}" />
        <dxmvvm:MapItem Source="13"
                        Target="{StaticResource OschadImage}" />
        <dxmvvm:MapItem Source="14"
                        Target="{StaticResource AlfabankImage}" />
        <dxmvvm:MapItem Source="15"
                        Target="{StaticResource IdeabankImage}" />
        <dxmvvm:MapItem Source="16"
                        Target="{StaticResource PaylaterImage}" />
        <dxmvvm:MapItem Source="17"
                        Target="{StaticResource CreditImage}" />
        <dxmvvm:MapItem Source="18"
                        Target="{StaticResource BonusesImage}" />
        <dxmvvm:MapItem Source="19"
                        Target="{StaticResource MonoPayImage}" />
        <dxmvvm:MapItem Source="20"
                        Target="{StaticResource NovaPayImage}" />
        <dxmvvm:MapItem Source="21"
                        Target="{StaticResource PumbImage}" />
        <dxmvvm:MapItem Source="22"
                        Target="{StaticResource ABankImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="PaymentComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:Payment}">
        <StackPanel Orientation="Horizontal"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource PaymentImageConverter}}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="PaymentColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource PaymentComboBoxItemTemplate}" />
    </ControlTemplate>

    <dxmvvm:BooleanToObjectConverter x:Key="IsPaidToPaymentTemplateConverter"
                                     TrueValue="{StaticResource PaymentComboBoxItemTemplate}"
                                     FalseValue="{StaticResource PaymentGrayComboBoxItemTemplate}"/>

</ResourceDictionary>