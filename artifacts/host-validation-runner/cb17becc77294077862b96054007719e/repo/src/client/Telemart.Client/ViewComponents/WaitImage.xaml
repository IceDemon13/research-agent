<UserControl x:Class="Telemart.Client.ViewComponents.WaitImage"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             Height="Auto"
             Width="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BitmapImage x:Key="WaitImage"
                     UriSource="/Images/wait.gif" />
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=CurrentUserControl}"
                Orientation="Horizontal">
        <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
               Width="16"
               Height="16"
               VerticalAlignment="Center" />
        <TextBlock Text="{Binding Path=BusyText, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   Visibility="{Binding Path=BusyText, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}" />
    </StackPanel>

</UserControl>
