<UserControl x:Class="Telemart.Client.Views.Directories.Organization.OrganizationAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:organization="clr-namespace:Telemart.Client.ViewModels.Directories.Organization"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             DataContext="{client:Container Type=organization:OrganizationAccountViewModel}"
             Loaded="OrganizationAccountViewLoaded"
             Width="270"
             Height="260"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type organization:OrganizationAccountViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ReadOnlyEditStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsNew, Mode=OneWay}"
                                         Value="True">
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Название">
                    <dxe:TextEdit x:Name="NameTextEdit"
                                  EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="{x:Static organization:OrganizationConstants.AccountNameMaxLength}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Банк">
                    <dxe:ComboBoxEdit x:Name="BankComboBox"
                                      ItemsSource="{Binding Path=Banks, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.BankId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      ShowEditorButtons="{Binding Path=IsReadOnly, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}"
                                      Style="{StaticResource ReadOnlyEditStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Счет">
                    <dxe:TextEdit EditValue="{Binding Path=Model.Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="{x:Static organization:OrganizationConstants.AccountMaxLength}"
                                  Style="{StaticResource ReadOnlyEditStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Валюта">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Currencies, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                                      DisplayMember="Title"
                                      ShowEditorButtons="{Binding Path=IsReadOnly, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}"
                                      Style="{StaticResource ReadOnlyEditStyle}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                   Command="{Binding Path=HandleCurrencyChangedCommand, Mode=OneWay}" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Касса">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.CashboxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      ShowEditorButtons="{Binding Path=IsReadOnly, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}"
                                      Style="{StaticResource ReadOnlyEditStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Оплата">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Payments, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.Payments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:PaymentSelectedItemsConverter}, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      HorizontalScrollBarVisibility="Hidden"
                                      Style="{StaticResource CheckedTokenComboBoxStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Активен">
                    <dxe:CheckEdit EditValue="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
