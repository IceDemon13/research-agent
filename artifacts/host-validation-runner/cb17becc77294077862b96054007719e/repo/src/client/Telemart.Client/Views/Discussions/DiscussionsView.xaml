<UserControl x:Class="Telemart.Client.Views.Discussions.DiscussionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Discussions"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             DataContext="{client:Container Type=viewModels:DiscussionsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:DiscussionsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="770">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl
                IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                   CommandTarget="{Binding ElementName=GridControl}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarButtonItem Content="Создать"
                                   GlyphAlignment="Top"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=CreateCommand, Mode=OneWay}"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   KeyGesture="Insert" />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneTime}" />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal">
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Padding="0"
                                  MinHeight="230"
                                  Style="{StaticResource PanelStyle}">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Discussions, Mode=OneWay}"
                                     CurrentItem="{Binding Path= SelectedDiscussion, Mode=TwoWay}"
                                     ShowBorder="False"
                                     SelectionMode="None"
                                     AutoExpandAllGroups="True"
                                     DesignTimeDataSourceRowCount="5"
                                     IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanNegationConverter}}">
                        <dxg:GridControl.ShowLoadingPanel>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="RefreshCommand.IsExecuting"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </dxg:GridControl.ShowLoadingPanel>
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="discussions1.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                            <dxmvvm:FocusBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Код"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Id"
                                            AllowMoving="False"
                                            FixedWidth="True"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowBestFit="False"
                                            AllowColumnFiltering="False"
                                            Width="80">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Заголовок"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Title"
                                            AllowMoving="False"
                                            FixedWidth="False"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            MinWidth="120"
                                            Width="190">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="Статус"
                                            FieldName="StateId"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="110"
                                            Width="110"
                                            MaxWidth="200"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=States, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Тип"
                                            HeaderToolTip="Тип"
                                            FieldName="TypeId"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="110"
                                            Width="110"
                                            MaxWidth="200"
                                            AllowAutoFilter="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Приоритет"
                                            HeaderToolTip="Приоритет"
                                            FieldName="PriorityId"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="100"
                                            Width="110"
                                            MaxWidth="180"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Priorities, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Исполнитель"
                                            HeaderToolTip="Исполнитель"
                                            FieldName="ExecutorEmployeeId"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="80"
                                            Width="90"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn
                                Header="Хэштеги"
                                HeaderToolTip="Хэштеги"
                                Width="340"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                AllowSorting="False"
                                IsEnabled="False"
                                ReadOnly="True"
                                AllowEditing="False"
                                AllowColumnFiltering="False"
                                AllowResizing="True"
                                FixedWidth="False"
                                MinWidth="40"
                                FilterPopupMode="CheckedList">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit
                                            DisplayMember="DisplayValue"
                                            ValueMember="Id"
                                            ShowPopupIfReadOnly="False"
                                            IncrementalFiltering="True"
                                            IsTextEditable="False"
                                            ValidateOnEnterKeyPressed="False"
                                            AllowLiveDataShaping="False"
                                            AllowUpdateTwoWayBoundPropertiesOnSynchronization="False"
                                            IsEnabled="True"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Path=DataContext.Hashtags, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ElementName=GridControl}"
                                            EditValue="{Binding Path=RowData.Row.HashtagIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            ApplyItemTemplateToSelectedItem="False"
                                            Style="{StaticResource GridCheckedTokenComboBoxStyle}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Bitrix"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="BitrixId"
                                            FixedWidth="True"
                                            Width="60"
                                            MinWidth="60"
                                            AllowBestFit="True"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="False"
                                            AllowSorting="False"
                                            CellTemplate="{StaticResource BitrixTaskLinkCellTemplate}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дедлайн"
                                            HeaderToolTip="Дедлайн"
                                            FieldName="Deadline"
                                            Width="130"
                                            AllowResizing="False"
                                            AllowBestFit="True"
                                            AllowGrouping="True"
                                            GroupInterval="Date"
                                            AllowSorting="True"
                                            FixedWidth="True"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата создания"
                                            HeaderToolTip="Дата создания"
                                            FieldName="CreatedOn"
                                            Width="130"
                                            AllowResizing="False"
                                            AllowBestFit="True"
                                            AllowGrouping="True"
                                            GroupInterval="Date"
                                            FixedWidth="True"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создал"
                                            HeaderToolTip="Создал"
                                            FieldName="CreatedBy"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="80"
                                            Width="90"
                                            MaxWidth="130"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата изменения"
                                            HeaderToolTip="Дата изменения"
                                            FieldName="ModifiedOn"
                                            Width="130"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            GroupInterval="Date"
                                            FixedWidth="True"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Изменил"
                                            HeaderToolTip="Изменил"
                                            FieldName="ModifiedBy"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            FixedWidth="False"
                                            MinWidth="80"
                                            Width="90"
                                            MaxWidth="130"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="ПБ"
                                            HeaderToolTip="Приоритет Bitrix"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="PriorityBitrix"
                                            FixedWidth="True"
                                            Width="24"
                                            MinWidth="24"
                                            AllowBestFit="False"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dx:DXImage Source="../../Images/Common/fire.png"
                                                    Width="16"
                                                    Height="16"
                                                    Visibility="{Binding Path=RowData.Row.PriorityBitrix, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>

                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="True"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowSorting="True"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           IsTotalSummaryMenuEnabled="False"
                                           ShowTotalSummary="False"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           PassEventArgsToCommand="False"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>

                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutGroup ItemWidth="355"
                                  MinWidth="355"
                                  MaxWidth="500"
                                  Orientation="Vertical">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      AllowHide="True"
                                      FloatOnDoubleClick="False"
                                      ItemWidth="355"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <dxlc:LayoutControl Orientation="Vertical"
                                            ItemStyle="{StaticResource LayoutItemStyle}">
                            <dxlc:LayoutItem Label="Создано">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/calendar.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxlc:LayoutGroup Orientation="Horizontal"
                                                  VerticalAlignment="Center">
                                    <dxe:DateEdit
                                        EditValue="{Binding Path=Filter.CreatedOnBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"
                                        AllowNullInput="True"
                                        Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                        AllowRoundOutOfRangeValue="False"
                                        Style="{StaticResource BasicDateEdit}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                    <TextBlock Text="-"
                                               Width="8"
                                               TextAlignment="Center" />
                                    <dxe:DateEdit
                                        EditValue="{Binding Path=Filter.CreatedOnAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"
                                        AllowNullInput="True"
                                        Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                        AllowRoundOutOfRangeValue="False"
                                        Style="{StaticResource BasicDateEdit}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutItem>
                             <dxlc:LayoutItem Label="Дедлайн">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/calendar.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxlc:LayoutGroup Orientation="Horizontal"
                                                  VerticalAlignment="Center">
                                    <dxe:DateEdit
                                        EditValue="{Binding Path=Filter.DeadlineBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"
                                        AllowNullInput="True"
                                        Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                        AllowRoundOutOfRangeValue="False"
                                        Style="{StaticResource BasicDateEdit}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                    <TextBlock Text="-"
                                               Width="8"
                                               TextAlignment="Center" />
                                    <dxe:DateEdit
                                        EditValue="{Binding Path=Filter.DeadlineAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"
                                        AllowNullInput="True"
                                        Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                        AllowRoundOutOfRangeValue="False"
                                        Style="{StaticResource BasicDateEdit}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Код">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Common/user_comment_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.Ids, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </controls:FilterNumbersPrintTextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Создал"
                                             Visibility="{Binding Path=AccessAllDiscussions, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/user_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.CreatedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  IsEnabled="True"
                                                  NullValueButtonPlacement="EditBox"
                                                  ValidateOnTextInput="False"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Исполнитель"
                                             Visibility="{Binding Path=AccessAllDiscussions, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/user_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.ExecutorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  IsEnabled="True"
                                                  NullValueButtonPlacement="EditBox"
                                                  ValidateOnTextInput="False"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Соисполнитель"
                                             Visibility="{Binding Path=AccessAllDiscussions, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/user_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.CoExecutorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  IsEnabled="True"
                                                  NullValueButtonPlacement="EditBox"
                                                  ValidateOnTextInput="False"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Наблюдатель"
                                             Visibility="{Binding Path=AccessAllDiscussions, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/user_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.AuditorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  IsEnabled="True"
                                                  NullValueButtonPlacement="EditBox"
                                                  ValidateOnTextInput="False"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Статус">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/lightbulb.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=States, Mode=OneWay}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  EditValue="{Binding Path=Filter.StateIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:IntItemsConverter}}"
                                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
                            </dxlc:LayoutItem>

                            <dxlc:LayoutItem Label="Документ">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/page_white.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Entities, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.EntityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  IsEnabled="True"
                                                  NullValueButtonPlacement="EditBox"
                                                  ValidateOnTextInput="False"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Номер документа">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/page_red_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=Filter.DocumentId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              MaskType="Numeric"
                                              Mask="F0"
                                              AllowNullInput="True"
                                              EditValueType="{x:Type system:Int32}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Заголовок">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/information.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=Filter.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Bitrix">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Common/bitrix24.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=Filter.BitrixId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                             Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:TextEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal" />
                            <dxb:ToolBarControl GlyphSize="Small">
                                <dxb:BarButtonItem Content="Применить"
                                                   Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                   GlyphAlignment="Left" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItem Content="Отмена"
                                                   Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                   Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                   GlyphAlignment="Left" />
                            </dxb:ToolBarControl>
                        </dxlc:LayoutControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</UserControl>