<UserControl x:Class="Telemart.Client.Views.Shops.LocationView"
             x:Name="UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Locations"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             DataContext="{client:Container Type=viewModels:LocationViewModel}"
             Width="560"
             Height="500"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:LocationViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">

        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=IsVisible, ElementName=WaitImage, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Название">
                <dxe:TextEdit EditValue="{Binding Path= Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Адрес">
                <dxe:TextEdit EditValue="{Binding Path= Model.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Город">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="DisplayValue"
                                  ValueMember="Id"
                                  FilterCondition="StartsWith"
                                  Style="{StaticResource SearchableComboBoxStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Тип локации">
                <dxe:ComboBoxEdit EditValue="{Binding Model.LocationTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Path= LocationTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  IsReadOnly="False"
                                  Style="{StaticResource SearchableComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Основной график">
                <dxe:ComboBoxEdit EditValue="{Binding Model.WorkScheduleTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Path= WorkScheduleTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  AllowNullInput="True"
                                  NullValue="{x:Null}"
                                  NullValueButtonPlacement="EditBox"
                                  Style="{StaticResource SearchableComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="График услуг">
                <dxe:ComboBoxEdit EditValue="{Binding Model.AdditionalScheduleTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Path= AdditionalWorkScheduleTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  IsReadOnly="False"
                                  AllowNullInput="True"
                                  NullValue="{x:Null}"
                                  NullValueButtonPlacement="EditBox"
                                  Style="{StaticResource SearchableComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Локация Google"
                             Visibility="{Binding  TypeLocationShop, Mode=OneWay,  Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True}}">
                <dxe:ComboBoxEdit EditValue="{Binding Model.GoogleExternalLocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Path= ExternalLocations, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Id"
                                  DisplayMember="Description"
                                  IsReadOnly="False"
                                  AllowNullInput="True"
                                  NullValue="{x:Null}"
                                  NullValueButtonPlacement="EditBox"
                                  Style="{StaticResource SearchableComboBoxStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Кластер">
                <dxe:ComboBoxEdit EditValue="{Binding Model.ClusterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Path= Clusters, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Id"
                                  DisplayMember="Name"
                                  IsReadOnly="{Binding AllowCluster, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                  Style="{StaticResource ReadOnlySearchableComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Vertical"
                              View="GroupBox"
                              ItemSpace="0"
                              Header="Склады"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                <dxg:GridControl x:Name="WarehouseGridControl"
                                 ItemsSource="{Binding ShopWarehouses, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedWarehouse}"
                                 SelectionMode="None"
                                 MaxHeight="85"
                                 Margin="0"
                                 ShowBorder="False">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Номер склада"
                                        HeaderToolTip="Номер склада"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="Id"
                                        FixedWidth="True"
                                        Width="80"
                                        MinWidth="60"
                                        AllowBestFit="True"
                                        AllowResizing="False"
                                        AllowGrouping="False"
                                        AllowMoving="False"
                                        AllowAutoFilter="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Название"
                                        HeaderToolTip="Название"
                                        FieldName="Name"
                                        FixedWidth="False"
                                        Width="60"
                                        MinWidth="40"
                                        MaxWidth="150"
                                        AllowBestFit="True"
                                        AllowResizing="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        AllowColumnFiltering="True"
                                        AllowAutoFilter="False"
                                        FilterPopupMode="CheckedList" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowPerPixelScrolling="True"
                                       ShowTotalSummary="False"
                                       ShowIndicator="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowSearchPanelMode="Never"
                                       ShowGroupPanel="False"
                                       IsColumnMenuEnabled="False"
                                       AutoWidth="True"
                                       NavigationStyle="Cell"
                                       AllowResizing="True"
                                       AllowEditing="False"
                                       AllowGrouping="False"
                                       AllowColumnMoving="False"
                                       AllowColumnFiltering="False"
                                       AllowSorting="True"
                                       AllowMoveColumnToDropArea="False" >
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       PassEventArgsToCommand="False"
                                                       Command="{Binding Path=WarehouseEditCommand, Mode=OneWay}"/>
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical"
                              View="GroupBox"
                              ItemSpace="0"
                              Header="Графики"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                <dxg:GridControl x:Name="WorkScheduleGrid"
                                 ItemsSource="{Binding WorkSchedules, Mode=OneWay}"
                                 SelectionMode="None"
                                 MaxHeight="85"
                                 Margin="0"
                                 ShowBorder="False">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Название"
                                        HeaderToolTip="Название"
                                        FieldName="Name"
                                        FixedWidth="False"
                                        Width="60"
                                        MinWidth="40"
                                        MaxWidth="150"
                                        AllowBestFit="True"
                                        AllowResizing="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        AllowColumnFiltering="True"
                                        AllowAutoFilter="False"
                                        FilterPopupMode="CheckedList" />
                        <dxg:GridColumn Header="График"
                                        HeaderToolTip="График работі"
                                        FieldName="Time"
                                        FixedWidth="False"
                                        Width="60"
                                        MinWidth="40"
                                        MaxWidth="150"
                                        AllowBestFit="True"
                                        AllowResizing="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        AllowColumnFiltering="True"
                                        AllowAutoFilter="False"
                                        FilterPopupMode="CheckedList" />
                        <dxg:GridColumn Header="Дни"
                                        Binding="{Binding Days, Mode=TwoWay, Converter={converters:StringToDaysOfWeekConverter},  ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                        HeaderToolTip="День недели"
                                        AllowResizing="True"
                                        FixedWidth="False"
                                        Width="120"
                                        MinWidth="60"
                                        MaxWidth="200">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                      ItemsSource="{Binding Path=DataContext.DaysOfWeek, Mode=OneWay, ElementName=UserControl, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="ShortName"
                                                      NullValueButtonPlacement="None"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowPerPixelScrolling="True"
                                       ShowTotalSummary="False"
                                       ShowIndicator="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowSearchPanelMode="Never"
                                       ShowGroupPanel="False"
                                       IsColumnMenuEnabled="False"
                                       AutoWidth="True"
                                       NavigationStyle="Row"
                                       AllowResizing="True"
                                       AllowEditing="False"
                                       AllowGrouping="False"
                                       AllowColumnMoving="False"
                                       AllowColumnFiltering="False"
                                       AllowSorting="True"
                                       AllowMoveColumnToDropArea="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutItem Label="Не синхронизировать">
                <dxe:CheckEdit EditValue="{Binding Path=Model.SyncDeliverySchedules, Converter={dxmvvm:BooleanNegationConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left">
                </dxe:CheckEdit>
            </dxlc:LayoutItem>
             <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         Mode="OneWay"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>