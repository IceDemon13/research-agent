<UserControl x:Class="Telemart.Client.Views.Common.OrderProductsView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:local="clr-namespace:Telemart.Client.Views.Common"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:OrderProductsView, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderProductSource.xaml" />
                <ResourceDictionary>
                    <converters:OrderProductViewItemsSelectedItemsConverter x:Key="SelectedItemsConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=CurrentUserControl}">
        <dxg:GridControl ItemsSource="{Binding Path=OrderProducts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectedItems="{Binding Path=SelectedOrderProducts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SelectedItemsConverter}}"
                         ShowBorder="{Binding Path=ShowBorder, Mode=OneWay}"
                         SelectionMode="Row"
                         ClipboardCopyMode="ExcludeHeader"
                         DesignTimeShowSampleData="True"
                         DesignTimeDataSourceRowCount="3"
                         DesignTimeDataObjectType="{x:Type viewModels:OrderProductViewItem}">
            <dxmvvm:Interaction.Behaviors>
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Товар"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="ProductFullName"
                                Width="200">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../Images/Order/gift_add.png"
                                            Visibility="{Binding Path=RowData.Row.IsGift, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                            Height="16"
                                            Width="16"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            ToolTipService.ToolTip="Подарок" />
                                <dx:DXImage Source="../../Images/Common/server_lightning.png"
                                            Visibility="{Binding Path=RowData.Row.ShowAdditionalServiceIcon, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                            Height="16"
                                            Width="16"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            ToolTipService.ToolTip="Услуга" />
                                <dx:DXImage Source="../../../Images/Common/module.png"
                                            Visibility="{Binding Path=RowData.Row.ShowAccessoryAdditionalServiceIcon, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                            Height="16"
                                            Width="16"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            ToolTipService.ToolTip="Аксессуар" />
                                <dx:DXImage
                                    Source="../../../Images/Common/screwdriver.png"
                                    Height="16"
                                    Width="16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="1,0,0,0"
                                    ToolTipService.ToolTip="Товар для оказания услуги"
                                    Visibility="{Binding RowData.Row.IsAdditionalServiceConsumable, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                <dxe:TextEdit x:Name="PART_Editor"
                                              IsReadOnly="True" />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Шт."
                                HeaderToolTip="Количество"
                                FieldName="Quantity"
                                HorizontalHeaderContentAlignment="Center"
                                Width="{StaticResource QuantityColumnWidth}"
                                MinWidth="{StaticResource MinQuantityColumnWidth}"
                                FixedWidth="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:SpinEditSettings HorizontalContentAlignment="Center" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Цена"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                HorizontalHeaderContentAlignment="Right"
                                FieldName="PriceOut"
                                Width="{StaticResource PriceColumnWidth}"
                                MinWidth="{StaticResource MinPriceColumnWidth}"
                                FixedWidth="True">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dxe:SpinEdit x:Name="PART_Editor"
                                          MaskType="Numeric"
                                          MaskUseAsDisplayFormat="True"
                                          Mask="{Binding Path=RowData.Row.CurrencyOutId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}}"
                                          MaskCulture="{Binding Path=RowData.Row.CurrencyOutId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                          MaskSaveLiteral="False"
                                          IsFloatValue="True"
                                          AllowDefaultButton="False"
                                          HorizontalContentAlignment="Right" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Статус"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="State"
                                FixedWidth="True"
                                Width="80"
                                MinWidth="24">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dxe:TextEdit x:Name="PART_Editor"
                                          EditValue="{Binding Path=RowData.Row.State.Name, Mode=OneWay}">
                                <dxe:TextEdit.Style>
                                    <Style TargetType="dxe:TextEdit">
                                        <Style.Triggers>
                                            <DataTrigger Value="{x:Static Brushes.Red}">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{converters:OrderProductStateColorConverter}">
                                                        <Binding Path="RowData.Row.State"
                                                                 Mode="OneWay"/>
                                                        <Binding Path="RowData.Row.IsOnWarehouse"
                                                                 Mode="OneWay"/>
                                                        <Binding Path="RowData.Row.OrderConfirmedBy"
                                                                 Mode="OneWay"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                    Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger Value="{x:Static Brushes.Green}">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{converters:OrderProductStateColorConverter}">
                                                        <Binding Path="RowData.Row.State"
                                                                 Mode="OneWay"/>
                                                        <Binding Path="RowData.Row.IsOnWarehouse"
                                                                 Mode="OneWay"/>
                                                        <Binding Path="RowData.Row.OrderConfirmedBy"
                                                                 Mode="OneWay"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                    Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxe:TextEdit.Style>
                            </dxe:TextEdit>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Источник товара"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="Source"
                                HorizontalHeaderContentAlignment="Center"
                                Width="120"
                                MinWidth="24">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="{Binding Path=RowData.Row.Source.Id, Mode=OneWay, Converter={StaticResource OrderProductSourceImageConverter}}"
                                            Visibility="{Binding Path=RowData.Row.IsOnWarehouse, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                                            Height="16"
                                            Width="16"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="3,0,0,0" />
                                <dx:DXImage Source="../../Images/Common/tick.png"
                                            Visibility="{Binding Path=RowData.Row.IsOnWarehouse, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                            Height="16"
                                            Width="16"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="3,0,0,0" />
                                <dxe:TextEdit x:Name="PART_Editor"
                                              EditValue="{Binding Path=RowData.Row.Source.SourceText, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView ShowCheckBoxSelectorColumn="{Binding Path=ShowCheckBoxSelectorColumn, Mode=OneWay}"
                               CheckBoxSelectorColumnWidth="24"
                               AllowSorting="False"
                               Style="{StaticResource ReadOnlyTableViewStyle}">
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>

</UserControl>