<controls:TelemartUserControl x:Class="Telemart.Client.Views.Warehouse.Movement.ShowcaseRoutesView"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:store="clr-namespace:Telemart.Client.ViewModels.Warehouse.Movement"
                              DataContext="{client:Container Type=store:ShowcaseRoutesViewModel}"
                              mc:Ignorable="d"
                              Width="1000"
                              Height="550"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type store:ShowcaseRoutesViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                     SelectionMode="None"
                                     ShowBorder="True"
                                     ClipboardCopyMode="ExcludeHeader">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Код товара"
                                        HeaderToolTip="Код товара"
                                        FieldName="ProductId"
                                        FixedWidth="True" />
                        <dxg:GridColumn Header="Склад отправитель"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="WarehouseFromId"
                                        AllowBestFit="True"
                                        MinWidth="24"
                                        AllowResizing="True"
                                        AllowGrouping="True"
                                        FilterPopupMode="CheckedList"
                                        AllowAutoFilter="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                          ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                          ValueMember="Id"
                                                          DisplayMember="Name" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Склад получатель"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="WarehouseToId"
                                        AllowBestFit="True"
                                        MinWidth="24"
                                        AllowResizing="True"
                                        AllowGrouping="True"
                                        FilterPopupMode="CheckedList"
                                        AllowAutoFilter="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                          ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                          ValueMember="Id"
                                                          DisplayMember="Name" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Склад витрины"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="ShowcaseWarehouseId"
                                        AllowBestFit="True"
                                        MinWidth="24"
                                        AllowResizing="True"
                                        AllowGrouping="True"
                                        FilterPopupMode="CheckedList"
                                        AllowAutoFilter="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                          ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                          ValueMember="Id"
                                                          DisplayMember="Name" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Шт"
                                        HeaderToolTip="Количество к перемещению"
                                        FieldName="Quantity"
                                        AllowSorting="True"
                                        Width="45"
                                        MinWidth="45"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowResizing="False"
                                       AllowSorting="True"
                                       ShowSearchPanelMode="HotKey"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="ОК"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>