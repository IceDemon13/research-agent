<controls:TelemartUserControl x:Class="Telemart.Client.Views.Service.ServiceMovements.ServiceMovementCreateView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceMovements"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:ServiceMovementCreateViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:ServiceMovementCreateViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="600"
                              d:DesignHeight="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Priority.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent"
                         Margin="0">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Horizontal"
                              View="GroupBox">
                <dxlc:LayoutGroup.GroupBoxStyle>
                    <Style TargetType="dxlc:GroupBox">
                        <Setter Property="TitleVisibility" Value="Collapsed" />
                    </Style>
                </dxlc:LayoutGroup.GroupBoxStyle>
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutItem Label="Отправитель">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=FromWarehouses, Mode=OneWay}"
                                          EditValue="{Binding Path=WarehouseFromId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Получатель">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=ToWarehouses, Mode=OneWay}"
                                          EditValue="{Binding Path=WarehouseToId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Доставка">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                          EditValue="{Binding Path=CarryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          NullValueButtonPlacement="EditBox"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutItem Label="Отправка">
                        <dxe:TextEdit EditValue="{x:Static system:DateTime.Now}"
                                      MaskUseAsDisplayFormat="True"
                                      Mask="dd.MM.yyyy"
                                      MaskType="DateTime"
                                      IsReadOnly="True"
                                      Opacity="{StaticResource DisabledElementOpacity}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Получение">
                        <dxe:DateEdit EditValue="{Binding DateReceive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MinValue="{Binding MinDate}"
                                      MaxValue="{Binding MaxDate}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Тип доставки">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=DeliveryTypes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                          EditValue="{Binding Path=DeliveryTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          IsEnabled="{Binding ReadonlyDeliveryType, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0">
                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                    IsEnabled="{Binding Path=IsLockedByCurrentEmployee}">
                    <dxb:BarButtonItem Content="Удалить"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       Command="{Binding Path=DeleteCommand, Mode=OneWay}"/>
                    <dxb:BarButtonItem Content="Обработать записи"
                                       Glyph="../../../Images/Common/server_lightning.png"
                                       Command="{Binding Path=ProcessAllCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Заполнить"
                                       Glyph="../../../Images/Common/android.png"
                                       Command="{Binding Path=FillCommand, Mode=OneTime}" />
                </dxb:ToolBarControl>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedProduct, Mode=TwoWay}"
                                 SelectionMode="Row">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="ServiceRequestId"
                                        Header="Заявка"
                                        HeaderToolTip="Сервисная заявка"
                                        FixedWidth="True"
                                        Width="50">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="DisplayProductFullName"
                                        Header="Товар"
                                        HeaderToolTip="Название товара">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical">
                                        <dxe:ProgressBarEdit ShowNullText="True"
                                                             ShowBorder="False"
                                                             Visibility="{Binding Path=RowData.Row.IsProcessing, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter} }">
                                            <dxe:ProgressBarEdit.StyleSettings>
                                                <dxe:ProgressBarMarqueeStyleSettings />
                                            </dxe:ProgressBarEdit.StyleSettings>
                                        </dxe:ProgressBarEdit>
                                        <dxe:TextEdit x:Name="PART_Editor"
                                                      Visibility="{Binding Path=RowData.Row.IsProcessing, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ProductSn"
                                        Header="SN"
                                        HeaderToolTip="Серийный номер"
                                        FixedWidth="True"
                                        AllowBestFit="True">
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Скан."
                                        FieldName="Scanned"
                                        HorizontalHeaderContentAlignment="Center"
                                        Width="45"
                                        MinWidth="45"
                                        FixedWidth="True"
                                        DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}"
                                        AllowResizing="False">
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="IsProcessed"
                                        Header="С"
                                        HeaderToolTip="Статус"
                                        FixedWidth="True"
                                        Width="24">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical"
                                                Margin="0 2 0 0"
                                                VerticalAlignment="Center">
                                        <dx:DXImage Source="../../../Images/Common/tick.png"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding Path=RowData.Row.IsSuccess, Converter={dx:BooleanToVisibilityConverter}}"/>
                                        <dx:DXImage Source="../../../Images/warning.png"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    ToolTipService.ToolTip="{Binding Path=RowData.Row.ErrorMessage}"
                                                    Visibility="{Binding Path=RowData.Row.IsError, Converter={dx:BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       AllowPerPixelScrolling="True"
                                       ShowTotalSummary="False"
                                       ShowIndicator="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowSearchPanelMode="Never"
                                       ShowGroupPanel="False"
                                       IsColumnMenuEnabled="False"
                                       AutoWidth="True"
                                       NavigationStyle="Row"
                                       AllowResizing="True"
                                       AllowEditing="False"
                                       AllowGrouping="False"
                                       AllowColumnMoving="False"
                                       AllowColumnFiltering="False"
                                       AllowSorting="False"
                                       AllowMoveColumnToDropArea="False">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:KeyToCommand EventName="RowDoubleClick"
                                                     Command="{Binding EditRouteCommand}"
                                                     CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}"/>
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition ApplyToRow="True"
                                                     Expression="WarehouseFrom.Active = 0 or WarehouseTo.Active = 0">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Foreground="DarkGray"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <common:RecognizeServiceBarcodeView DataContext="{Binding RecognizeServiceBarcodeViewModel}"
                                                VerticalAlignment="Bottom"/>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Создание..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>