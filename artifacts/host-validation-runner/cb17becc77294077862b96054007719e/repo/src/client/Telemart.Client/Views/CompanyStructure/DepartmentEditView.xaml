<UserControl x:Class="Telemart.Client.Views.CompanyStructure.DepartmentEditView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.CompanyStructure"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             DataContext="{client:Container Type=viewModels:DepartmentEditViewModel}"
             Width="600"
             Height="300"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:DepartmentEditViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CompanyStructureTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=IsVisible, ElementName=WaitImage, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Название">
                    <dxe:TextEdit EditValue="{Binding Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaxLength="50"
                                  IsReadOnly="{Binding IsEdit, Converter={dxmvvm:BooleanNegationConverter}}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Родительский отдел">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Departments, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.ParentDepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"
                                      HorizontalContentAlignment="Left"
                                      AllowNullInput="True"
                                      AutoComplete="True"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                      IsReadOnly="{Binding IsEdit, Converter={dxmvvm:BooleanNegationConverter}}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Руководитель отдела">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      EditValue="{Binding Path= Model.EmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"
                                      HorizontalContentAlignment="Left"
                                      AllowNullInput="True"
                                      AutoComplete="True"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                      IsReadOnly="{Binding IsEdit, Converter={dxmvvm:BooleanNegationConverter}}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Сотрудники отдела"
                                 AddColonToLabel="False"/>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=DepartmentEmployees, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                 SelectedItem="{Binding Path=SelectedDepartmentEmployee, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 SelectionMode="Row">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Тип"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        FieldName="DepartmentEmployeeType"
                                        Width="30"
                                        AllowResizing="False"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowAutoFilter="False"
                                        FixedWidth="True"
                                        AllowBestFit="False"
                                        AllowColumnFiltering="True"
                                        FilterPopupMode="CheckedList"
                                        ColumnFilterMode="DisplayText"
                                        DisplayTemplate="{StaticResource DepartmentEmployeeColumnDisplayTemplate}"/>
                        <dxg:GridColumn Header="Код"
                                        FieldName="Id"
                                        FixedWidth="True"
                                        Width="60"
                                        AllowBestFit="False"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Имя"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="Name"
                                        Width="100"
                                        MinWidth="50"
                                        MaxWidth="120"
                                        AllowBestFit="True"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        AllowEditing="False"
                                        AllowResizing="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Должность"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="Position"
                                        Width="100"
                                        MinWidth="50"
                                        MaxWidth="120"
                                        AllowBestFit="True"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        AllowAutoFilter="False"
                                        AllowEditing="False"
                                        AllowResizing="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Телефон"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="Phone"
                                        FixedWidth="True"
                                        AllowBestFit="False"
                                        AllowResizing="False"
                                        AllowGrouping="False"
                                        AllowColumnFiltering="False"
                                        Width="100"
                                        MinWidth="100">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                      MaskType="Simple"
                                                      Mask="(000) 000-00-00"
                                                      MaskUseAsDisplayFormat="True"
                                                      MaskSaveLiteral="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowResizing="True"
                                       AllowPerPixelScrolling="True"
                                       ShowGroupPanel="False"
                                       AutoWidth="True"
                                       AllowEditing="False"
                                       ShowIndicator="False"
                                       AllowGrouping="False" >
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dx:SimpleButton x:Name="Lock"
                                 HorizontalAlignment="Left"
                                 Content="Редактировать"
                                 Glyph="/Images/CategoryOptions/pencil.png"
                                 Command="{Binding Path=EditCommand, Mode=OneWay}"
                                 Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         Mode="OneWay"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsEdit"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>
