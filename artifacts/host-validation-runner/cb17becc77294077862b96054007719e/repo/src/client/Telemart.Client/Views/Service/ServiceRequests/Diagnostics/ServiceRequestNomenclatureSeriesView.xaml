<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.Diagnostics.ServiceRequestNomenclatureSeriesView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests.Diagnostics"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             DataContext="{client:Container Type=viewModels:ServiceRequestNomenclatureSeriesViewModel}"
             mc:Ignorable="d"
             Width="900"
             Height="780"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ServiceRequestNomenclatureSeriesViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Товар">
                    <dxe:TextEdit EditValue="{Binding Path=ProductName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  IsReadOnly="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Серия номенклатуры">
                    <dxe:TextEdit EditValue="{Binding Path=NomenclatureSeries, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  IsReadOnly="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Текущая сборка"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      ItemSpace="0"
                                      View="GroupBox"
                                      GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl ItemsSource="{Binding Path=OldProducts, Mode=OneWay}"
                                         SelectionMode="Row"
                                         SelectedItem="{Binding Path=SelectedOldProduct, Mode=TwoWay}"
                                         Name="OldProductsGrid"
                                         ShowBorder="False">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="ProductId"
                                                Header="Код"
                                                HeaderToolTip="Код товара"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                MinWidth="40"
                                                Width="55"
                                                MaxWidth="55"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProductName"
                                                Header="Товар"
                                                HeaderToolTip="Название товара"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                Width="180"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Quantity"
                                                Header="Количество"
                                                HeaderToolTip="Количество"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                ColumnPosition="Right"
                                                Width="{StaticResource QuantityColumnWidth}"
                                                MinWidth="{StaticResource MinQuantityColumnWidth}"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True"
                                               ShowTotalSummary="False"
                                               ShowIndicator="False"
                                               ShowFixedTotalSummary="False"
                                               ShowAutoFilterRow="False"
                                               ShowSearchPanelMode="Never"
                                               ShowGroupPanel="False"
                                               IsColumnMenuEnabled="False"
                                               AutoWidth="True"
                                               NavigationStyle="Row"
                                               AllowResizing="True"
                                               AllowEditing="False"
                                               AllowGrouping="False"
                                               AllowColumnMoving="False"
                                               AllowColumnFiltering="False"
                                               AllowSorting="True"
                                               AllowMoveColumnToDropArea="False" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=ShowCurrentAssemblySerialsCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Новая сборка"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      ItemSpace="0"
                                      View="GroupBox"
                                      GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                        <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                            IsEnabled="True">
                            <dxb:BarButtonItem Content="Добавить"
                                               Glyph="{dx:DXImage Image=Add_16x16.png}"
                                               Command="{Binding Path=AddNewProductCommand, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Удалить"
                                               Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                               Command="{Binding Path=DeleteNewProductCommand, Mode=OneWay}"/>
                        </dxb:ToolBarControl>
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl Name="NewProductsGrid"
                                         ItemsSource="{Binding Path=NewProducts, Mode=OneWay}"
                                         SelectedItem="{Binding Path=SelectedNewProduct, Mode=TwoWay}"
                                         SelectionMode="Row"
                                         ShowBorder="False">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="ProductId"
                                                Header="Код"
                                                HeaderToolTip="Код товара"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                MinWidth="40"
                                                Width="55"
                                                MaxWidth="55"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProductName"
                                                Header="Товар"
                                                HeaderToolTip="Название товара"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                Width="140"
                                                MinWidth="140"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Price"
                                                Header="Цена"
                                                HeaderToolTip="Цена товара"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                Width="{StaticResource QuantityColumnWidth}"
                                                MinWidth="{StaticResource MinQuantityColumnWidth}"
                                                AllowEditing="{Binding Path=AllowEditPrice, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                              MaskType="Numeric"
                                                              Mask="######" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Quantity"
                                                Header="Кол-во"
                                                HeaderToolTip="Плановое количество товара"
                                                FixedWidth="False"
                                                AllowResizing="True"
                                                Width="{StaticResource QuantityColumnWidth}"
                                                MinWidth="{StaticResource MinQuantityColumnWidth}"
                                                AllowEditing="{Binding Path=DiagnosticStage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                              MaskType="Numeric"
                                                              Mask="##" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ScannedQuantity"
                                                Header="Скан."
                                                HeaderToolTip="Просканированное количество товара"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="{StaticResource QuantityColumnWidth}"
                                                MinWidth="{StaticResource MinQuantityColumnWidth}"
                                                FixedWidth="False"
                                                AllowResizing="True">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ButtonEdit x:Name="PART_Editor"
                                                            HorizontalContentAlignment="Center"
                                                            AllowDefaultButton="False"
                                                            MaskType="RegEx"
                                                            Mask="\d+"
                                                            MaskUseAsDisplayFormat="False">
                                                <dxe:ButtonEdit.Style>
                                                    <Style TargetType="{x:Type dxe:BaseEdit}">
                                                        <Setter Property="Foreground"
                                                                Value="Black" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=RowData.Row.IsScannedQuantityValid, Mode=OneWay}"
                                                                         Value="False">
                                                                <Setter Property="Foreground"
                                                                        Value="Red" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </dxe:ButtonEdit.Style>
                                                <dxe:ButtonInfo GlyphKind="Search"
                                                                Command="{Binding Path=DataContext.EditSerialsCommand, Mode=OneWay, ElementName=NewProductsGrid}"
                                                                Visibility="{Binding Path= RowData.Row.KeepSerialOverridden, Converter={dx:BooleanToVisibilityConverter}}"/>
                                                <dxe:ButtonInfo GlyphKind="Cancel"
                                                                Visibility="{Binding Path= RowData.Row.KeepSerialOverridden, Converter={dx:BooleanToVisibilityConverter Invert=True}}"
                                                                Command="{Binding Path=DataContext.ClearScannedQuantityCommand, Mode=OneWay, ElementName=NewProductsGrid}"/>
                                            </dxe:ButtonEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="SN"
                                                HeaderToolTip="По товару ведется учет SN"
                                                HorizontalHeaderContentAlignment="Center"
                                                FieldName="KeepSerialOverridden"
                                                AllowEditing="True"
                                                FixedWidth="True"
                                                Width="26"
                                                MinWidth="26">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit x:Name="PART_Editor"
                                                           IsThreeState="False"
                                                           Style="{StaticResource ReadOnlyConditionsStyle}">
                                                <dxe:CheckEdit.IsEnabled>
                                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                        <Binding Path="RowData.Row.KeepSerial"
                                                                 Mode="OneWay"
                                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                                        <Binding Path="RowData.Row.DiagnosticStage"
                                                                 Mode="OneWay"
                                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                                    </MultiBinding>
                                                </dxe:CheckEdit.IsEnabled>
                                            </dxe:CheckEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="И"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    HeaderToolTip="Информация"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="False"
                                                    AllowColumnFiltering="False"
                                                    AllowAutoFilter="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>

                                            <dxlc:LayoutGroup Orientation="Horizontal"
                                                              Height="22">
                                                <dx:DXImage Source="../../../../Images/Common/toolbox.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding Path=RowData.Row.ServiceImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                    <dx:DXImage.ToolTip>
                                                        <ToolTip>
                                                            <dxlc:LayoutControl Orientation="Vertical">
                                                                <dxlc:LayoutItem Label="Товар извлечен из сборки и ожидает приезда замены" />
                                                            </dxlc:LayoutControl>
                                                        </ToolTip>
                                                    </dx:DXImage.ToolTip>
                                                </dx:DXImage>
                                                <dx:DXImage Source="../../../../Images/Common/new_16x16.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding Path=RowData.Row.NewImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                    <dx:DXImage.ToolTip>
                                                        <ToolTip>
                                                            <dxlc:LayoutControl Orientation="Vertical">
                                                                <dxlc:LayoutItem Label="Новый товар приехал под замену, просканируйте его" />
                                                            </dxlc:LayoutControl>
                                                        </ToolTip>
                                                    </dx:DXImage.ToolTip>
                                                </dx:DXImage>
                                                <dx:DXImage Source="../../../../Images/Common/package.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding Path=RowData.Row.AnalogImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                    <dx:DXImage.ToolTip>
                                                        <ToolTip>
                                                            <dxlc:LayoutControl Orientation="Vertical">
                                                                <dxlc:LayoutItem Label="Аналогичный товар приехал под замену, просканируйте его" />
                                                            </dxlc:LayoutControl>
                                                        </ToolTip>
                                                    </dx:DXImage.ToolTip>
                                                </dx:DXImage>
                                            </dxlc:LayoutGroup>

                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True"
                                               ShowTotalSummary="False"
                                               ShowIndicator="False"
                                               ShowFixedTotalSummary="False"
                                               ShowAutoFilterRow="False"
                                               ShowSearchPanelMode="Never"
                                               ShowGroupPanel="False"
                                               IsColumnMenuEnabled="False"
                                               AutoWidth="True"
                                               NavigationStyle="Cell"
                                               AllowResizing="True"
                                               AllowEditing="False"
                                               AllowGrouping="False"
                                               AllowColumnMoving="False"
                                               AllowColumnFiltering="False"
                                               AllowSorting="True"
                                               AllowMoveColumnToDropArea="False" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=EditSerialsCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <common:RecognizeBarcodeView x:Name="RecognizeBarcodeView"
                                                  DataContext="{Binding Path=RecognizeBarcodeViewModel, Mode=OneWay}" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>