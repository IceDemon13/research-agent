<UserControl x:Class="Telemart.Client.Views.Warehouse.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:WarehousesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:WarehousesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                   CommandTarget="{Binding ElementName=LayoutRoot}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   ToolTip="Создать (Insert)"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddCommand, Mode=OneTime}"
                                   IsVisible="{Binding Path=CanCreate, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneTime}" />
                <dxb:BarButtonItem Content="Адрес НП"
                                   ToolTip="Изменить адрес НП"
                                   Glyph="../../Images/Order/page_np_32_32.png"
                                   Command="{Binding Path=EditNpAddressCommand, Mode=OneTime}" />
                <dxb:BarButtonItem Content="Склад НП"
                                   ToolTip="Изменить склад НП"
                                   Glyph="../../Images/NP_32_32.gif"
                                   Command="{Binding Path=EditNpWarehouseCommand, Mode=OneTime}" />
                <dxb:BarButtonItem Content="QR"
                                   ToolTip="QR код на telegram бота для курьеров"
                                   Glyph="../../../Images/Common/qr.png"
                                   Command="{Binding Path=ShowDeliveryBotQrCommand, Mode=OneWay}"/>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxlc:LayerSeparator Height="1"
                             Kind="Horizontal" />
        <dxg:GridControl x:Name="GridControl"
                         ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                         CurrentItem="{Binding Path=SelectedWarehouse, Mode=TwoWay}"
                         ShowBorder="False"
                         SelectionMode="None"
                         AutoExpandAllGroups="True"
                         ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
            <dxmvvm:Interaction.Behaviors>
                <behaviors:LayoutSerializationBehavior FileName="warehouses_1.xml" />
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Код"
                                HeaderToolTip="Код склада"
                                HorizontalHeaderContentAlignment="Center"
                                FieldName="Id"
                                FixedWidth="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowBestFit="True"
                                AllowColumnFiltering="False"
                                AllowSorting="True"
                                AllowMoving="False"
                                MinWidth="48"
                                Width="48">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Тип"
                                HeaderToolTip="Тип склада"
                                FieldName="TypeId"
                                MinWidth="24"
                                Width="110"
                                AllowResizing="True"
                                AllowGrouping="True"
                                AllowSorting="True"
                                AllowAutoFilter="False"
                                AllowMoving="True"
                                FixedWidth="True"
                                AllowBestFit="True"
                                AllowColumnFiltering="True"
                                FilterPopupMode="CheckedList"
                                HorizontalHeaderContentAlignment="Left"
                                ColumnFilterMode="DisplayText">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Types}"
                                                  ValueMember="Id"
                                                  DisplayMember="Name"
                                                  HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Название"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="Name"
                                AllowBestFit="True"
                                AllowResizing="True"
                                AllowGrouping="False"
                                AllowMoving="False"
                                AllowAutoFilter="False"
                                AllowSorting="True"
                                FixedWidth="False"
                                AllowColumnFiltering="False"
                                HorizontalHeaderContentAlignment="Left">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Вывеска"
                                HeaderToolTip="Вывеска в пункте самовывоза"
                                HorizontalHeaderContentAlignment="Left"
                                FieldName="TagsHeader"
                                FixedWidth="False"
                                AllowBestFit="True"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowAutoFilter="False"
                                AllowColumnFiltering="False"
                                AllowSorting="True"
                                Visible="False">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Город"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                HorizontalHeaderContentAlignment="Left"
                                FieldName="CityId"
                                FixedWidth="False"
                                AllowBestFit="True"
                                AllowResizing="False"
                                AllowGrouping="True"
                                AllowAutoFilter="False"
                                AllowColumnFiltering="True"
                                FilterPopupMode="CheckedList"
                                ColumnFilterMode="DisplayText"
                                AllowSorting="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Cities}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Вес"
                                HeaderToolTip="Максимальный вес"
                                HorizontalHeaderContentAlignment="Center"
                                FieldName="MaxPackageWeight"
                                AllowBestFit="False"
                                AllowResizing="True"
                                Width="48"
                                FixedWidth="True"
                                AllowGrouping="True"
                                AllowAutoFilter="False"
                                AllowColumnFiltering="True"
                                AllowSorting="True"
                                FilterPopupMode="CheckedList"
                                ColumnFilterMode="DisplayText">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Ответственный"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                HorizontalHeaderContentAlignment="Left"
                                FieldName="Employee"
                                FixedWidth="False"
                                AllowBestFit="True"
                                AllowResizing="True"
                                AllowGrouping="True"
                                AllowColumnFiltering="True"
                                ColumnFilterMode="DisplayText"
                                FilterPopupMode="CheckedList"
                                AllowAutoFilter="False"
                                AllowSorting="True">
                </dxg:GridColumn>
                <dxg:GridColumn Header="Активен"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                HorizontalHeaderContentAlignment="Center"
                                FieldName="Active"
                                FixedWidth="True"
                                Width="24"
                                AllowBestFit="False"
                                AllowResizing="False"
                                AllowGrouping="True"
                                AllowSorting="True"
                                AllowMoving="True"
                                AllowColumnFiltering="True"
                                AllowAutoFilter="False"
                                ColumnFilterMode="DisplayText"
                                FilterPopupMode="CheckedList">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dx:DXImage x:Name="PART_Editor"
                                        Source="../../Images/Common/tick.png"
                                        Height="16"
                                        Width="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="5,0,0,0"
                                        Visibility="{Binding Path=RowData.Row.IsActive, Converter={dx:BooleanToVisibilityConverter}}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                               AllowEditing="False"
                               NavigationStyle="Cell"
                               ShowIndicator="False"
                               ShowAutoFilterRow="False"
                               ShowFixedTotalSummary="False"
                               IsTotalSummaryMenuEnabled="False"
                               ShowTotalSummary="False"
                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                               Command="{Binding Path=EditCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem SummaryType="Count"
                                     Alignment="Right"
                                     Visible="True" />
            </dxg:GridControl.GroupSummary>
        </dxg:GridControl>
    </dxlc:LayoutControl>
</UserControl>