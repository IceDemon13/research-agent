<controls:TelemartUserControl x:Class="Telemart.Client.Views.AdditionalService.AdditionalServiceView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AdditionalService"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             DataContext="{client:Container Type=viewModels:AdditionalServiceViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:AdditionalServiceViewModel}}"
             d:DesignHeight="645">
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxlc:LayoutGroup x:Name="CommonTab"
                                  Header="Общее"
                                  Orientation="Horizontal"
                                  Padding="10">
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutItem Label="Группа">
                            <dxe:TextEdit IsReadOnly="True"
                                          EditValue="{Binding Path=Model.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Название (рус)">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="100"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Название (укр)">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Path=Model.NameUa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="100"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Название (англ)">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Path=Model.NameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="100"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Описание (рус)">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Path=Model.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="500"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Описание (укр)">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Path=Model.DescriptionUa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="500"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Описание (англ)">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Path=Model.DescriptionEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="500"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Товар">

                                <dxe:TextEdit EditValue="{Binding Model.ProductName, ValidatesOnDataErrors=True, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsReadOnly="True"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource ReadOnlyConditionsStyle}" />

                        </dxlc:LayoutItem>
                            <dx:SimpleButton Command="{Binding Path=DataContext.SelectProductCommand, Mode=OneWay, ElementName=LayoutControl}"
                                             Content="..."
                                             Width="20"
                                             MinWidth="20"
                                             Height="20"
                                             Padding="1 1 1 1"
                                             HorizontalAlignment="Right"
                                             IsEnabled="{Binding IsNewOrIsLockedByCurrentEmployee}" />
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutItem Label="Тип товара">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=ProductTypes, Mode=OneWay}"
                                              ValueMember="Id"
                                              DisplayMember="Name"
                                              EditValue="{Binding Path=Model.ProductTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                              IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Тип приоритета">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=PriorityTypes, Mode=OneWay}"
                                              ValueMember="Id"
                                              DisplayMember="Name"
                                              EditValue="{Binding Path=Model.PriorityTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                              IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Минимальная цена">
                            <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          MaskType="Numeric"
                                          Mask="#######"
                                          EditValue="{Binding Path=Model.MinPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="% от цены товара">
                            <dxe:SpinEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          EditValue="{Binding Model.Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"
                                          AllowNullInput="True"
                                          Mask="##.00"
                                          MaskType="Numeric"
                                          InvalidValueBehavior="AllowLeaveEditor"
                                          EditValueType="{x:Type system:Decimal}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Тип цены">
                            <dxe:ComboBoxEdit EditValue="{Binding Model.PriceIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                              ItemsSource="{Binding Path=Prices, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                              ValueMember="Id"
                                              DisplayMember="Name"
                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource CheckedTokenComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutGroup Orientation="Horizontal"
                                          ItemSpace="5">
                            <dxlc:LayoutGroup Orientation="Vertical">
                                <dxlc:LayoutItem Label="Автомат. добавление">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.AutoAdd, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Контроль в перемещениях">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.ControlInMovements, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   IsEnabled="{Binding AllowSetControlInMovements, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" >
                                    </dxe:CheckEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Оказывается при клиенте">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.PresenceOfCustomer, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Оказывается локально">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.IsLocal, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Участвует в сборке">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.AssemblyPart, Mode=TwoWay}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" >
                                        <dxe:CheckEdit.IsReadOnly>
                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                                <Binding Path="AllowSetAssemblyPart"/>
                                            </MultiBinding>
                                        </dxe:CheckEdit.IsReadOnly>
                                    </dxe:CheckEdit>
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup Orientation="Vertical">
                                <dxlc:LayoutItem Label="Продлевает гарантию">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.AdditionalWarranty, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Требуются товары для оказания">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.RequireProductsToProvide, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Активная">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.Active, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Создание уценки">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.CreateDiscount, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Раскомплектация">
                                    <dxe:CheckEdit EditValue="{Binding Path=Model.Disassembly, Mode=TwoWay}"
                                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                                   Style="{StaticResource ReadOnlyConditionsStyle}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="DependentObjectsTab"
                                  Header="Зависимые объекты"
                                  Orientation="Horizontal"
                                  Padding="10">
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutGroup View="GroupBox"
                                          ItemSpace="0"
                                          Orientation="Vertical"
                                          Header="На что оказывается"
                                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                            <dxb:ToolBarControl VerticalAlignment="Top"
                                                        Style="{StaticResource SmallToolBarStyle}"
                                                        IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                    <dxb:BarSubItem Content="Добавить"
                                                    Glyph="{dx:DXImage Image=Add_16x16.png}">
                                        <dxb:BarButtonItem Content="Товар"
                                                           ToolTip="Товар"
                                                           Glyph="../../Images/NavigationMenu/box_front_open.png"
                                                           Command="{Binding Path=AddSlaveProductCommand, Mode=OneTime}" />
                                        <dxb:BarButtonItem Content="Категорию"
                                                           ToolTip="Категорию"
                                                           Glyph="../../Images/NavigationMenu/folder_wrench.png"
                                                           Command="{Binding Path=AddSlaveCategoryCommand, Mode=OneTime}" />
                                    </dxb:BarSubItem>
                                    <dxb:BarButtonItem Content="Удалить"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=SlaveCategoryGridControl}"
                                                       Command="{Binding Path=DeleteSlaveCategoryCommand, Mode=OneWay}" />
                                </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="SlaveCategoryGridControl"
                                             ItemsSource="{Binding Path=Model.SlaveCategories, Mode=OneWay}"
                                             SelectedItem="{Binding Path=SelectedSlaveCategory}"
                                             SelectionMode="Row"
                                             ShowBorder="False">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.Style>
                                        <Style TargetType="dxg:GridControl"
                                               BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                            <Setter Property="Opacity"
                                                    Value="{StaticResource DisabledElementOpacity}" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                                    <Setter Property="Opacity"
                                                            Value="{StaticResource EnabledElementOpacity}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridControl.Style>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn AllowEditing="False"
                                                        Header="Объект"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        HeaderToolTip="Объект">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding Path=RowData.Row.IsCategory, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                                            <dx:DXImage Source="../../Images/NavigationMenu/box_front_open.png"
                                                                        Height="16"
                                                                        Width="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,0,0,0" />
                                                            <TextBlock Text="{Binding Path=RowData.Row.ProductName, Mode=OneWay}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Background="Transparent"
                                                                       Margin="5,0,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding Path=RowData.Row.IsCategory, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                            <dx:DXImage Source="../../Images/NavigationMenu/folder_wrench.png"
                                                                        Height="16"
                                                                        Width="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,0,0,0" />
                                                            <TextBlock Text="{Binding Path=RowData.Row.CategoryName, Mode=OneWay}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Background="Transparent"
                                                                       Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Хар-ка"
                                                        HeaderToolTip="Характеристика"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="Feature"
                                                        FixedWidth="True"
                                                        Width="190"
                                                        MinWidth="190"
                                                        AllowBestFit="True"
                                                        AllowResizing="False"
                                                        AllowGrouping="False"
                                                        AllowMoving="False"
                                                        AllowAutoFilter="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Значение хар-ки"
                                                        HeaderToolTip="Значение характеристики"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="FeatureValue"
                                                        FixedWidth="True"
                                                        Width="230"
                                                        MinWidth="230"
                                                        AllowBestFit="True"
                                                        AllowResizing="False"
                                                        AllowGrouping="False"
                                                        AllowMoving="False"
                                                        AllowAutoFilter="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowPerPixelScrolling="True"
                                                       ShowTotalSummary="False"
                                                       ShowIndicator="False"
                                                       ShowFixedTotalSummary="False"
                                                       ShowAutoFilterRow="False"
                                                       ShowSearchPanelMode="Never"
                                                       ShowGroupPanel="False"
                                                       IsColumnMenuEnabled="False"
                                                       ShowColumnHeaders="True"
                                                       AutoWidth="True"
                                                       NavigationStyle="Row"
                                                       AllowResizing="True"
                                                       AllowEditing="False"
                                                       AllowGrouping="False"
                                                       AllowColumnMoving="False"
                                                       AllowColumnFiltering="False"
                                                       AllowSorting="True"
                                                       AllowMoveColumnToDropArea="False" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox"
                                          ItemSpace="0"
                                          Orientation="Vertical"
                                          Header="Что нужно для оказания"
                                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                                <dxb:ToolBarControl VerticalAlignment="Top"
                                                    Style="{StaticResource SmallToolBarStyle}"
                                                    IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                    <dxb:BarSubItem Content="Добавить"
                                                    Glyph="{dx:DXImage Image=Add_16x16.png}">
                                        <dxb:BarButtonItem Content="Товар"
                                                           ToolTip="Товар"
                                                           Glyph="../../Images/NavigationMenu/box_front_open.png"
                                                           Command="{Binding Path=AddProductProvideRuleCommand, Mode=OneTime}" />
                                        <dxb:BarButtonItem Content="Категорию"
                                                           ToolTip="Категорию"
                                                           Glyph="../../Images/NavigationMenu/folder_wrench.png"
                                                           Command="{Binding Path=AddCategoryProvideRuleCommand, Mode=OneTime}" />
                                    </dxb:BarSubItem>
                                    <dxb:BarButtonItem Content="Удалить"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=ProvideRuleGridControl}"
                                                       Command="{Binding Path=DeleteProvideRuleCommand, Mode=OneWay}" />
                                </dxb:ToolBarControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxg:GridControl x:Name="ProvideRuleGridControl"
                                                 ItemsSource="{Binding Path=Model.ProvideRules, Mode=OneWay}"
                                                 SelectedItem="{Binding Path=SelectedProvideRule}"
                                                 SelectionMode="Row"
                                                 ShowBorder="False">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.Style>
                                        <Style TargetType="dxg:GridControl"
                                               BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                            <Setter Property="Opacity"
                                                    Value="{StaticResource DisabledElementOpacity}" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                                    <Setter Property="Opacity"
                                                            Value="{StaticResource EnabledElementOpacity}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:GridControl.Style>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn AllowEditing="False"
                                                        Header="Объект"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        HeaderToolTip="Объект">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding Path=RowData.Row.IsCategory, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                                            <dx:DXImage Source="../../Images/NavigationMenu/box_front_open.png"
                                                                        Height="16"
                                                                        Width="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,0,0,0" />
                                                            <TextBlock Text="{Binding Path=RowData.Row.ProductName, Mode=OneWay}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Background="Transparent"
                                                                       Margin="5,0,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding Path=RowData.Row.IsCategory, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                            <dx:DXImage Source="../../Images/NavigationMenu/folder_wrench.png"
                                                                        Height="16"
                                                                        Width="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,0,0,0" />
                                                            <TextBlock Text="{Binding Path=RowData.Row.CategoryName, Mode=OneWay}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Background="Transparent"
                                                                       Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Хар-ка"
                                                        HeaderToolTip="Характеристика"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="Feature"
                                                        FixedWidth="True"
                                                        Width="190"
                                                        MinWidth="190"
                                                        AllowBestFit="True"
                                                        AllowResizing="False"
                                                        AllowGrouping="False"
                                                        AllowMoving="False"
                                                        AllowAutoFilter="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Значение хар-ки"
                                                        HeaderToolTip="Значение характеристики"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="FeatureValue"
                                                        FixedWidth="True"
                                                        Width="230"
                                                        MinWidth="230"
                                                        AllowBestFit="True"
                                                        AllowResizing="False"
                                                        AllowGrouping="False"
                                                        AllowMoving="False"
                                                        AllowAutoFilter="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="А"
                                                        HeaderToolTip="Активна"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="Active"
                                                        Width="26"
                                                        FilterPopupMode="CheckedList"
                                                        FixedWidth="True"
                                                        AllowResizing="False"
                                                        AllowEditing="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:CheckEditSettings IsThreeState="False"
                                                                       HorizontalContentAlignment="Center"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowPerPixelScrolling="True"
                                                       ShowTotalSummary="False"
                                                       ShowIndicator="False"
                                                       ShowFixedTotalSummary="False"
                                                       ShowAutoFilterRow="False"
                                                       ShowSearchPanelMode="Never"
                                                       ShowGroupPanel="False"
                                                       IsColumnMenuEnabled="False"
                                                       ShowColumnHeaders="True"
                                                       AutoWidth="True"
                                                       NavigationStyle="Row"
                                                       AllowResizing="True"
                                                       AllowEditing="False"
                                                       AllowGrouping="False"
                                                       AllowColumnMoving="False"
                                                       AllowColumnFiltering="False"
                                                       AllowSorting="True"
                                                       AllowMoveColumnToDropArea="False" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility></TextBlock>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>