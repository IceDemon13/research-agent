<UserControl x:Class="Telemart.Client.Views.Store.Invoice.EditInvoiceWarehouseView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:local="clr-namespace:Telemart.Client.Views.Store.Invoice"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Invoice"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             DataContext="{client:Container Type=viewModels:EditInvoiceWarehouseViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:EditInvoiceWarehouseViewModel}}"
             mc:Ignorable="d"
             Width="350"
             d:DesignHeight="120" 
             d:DesignWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    
    <dxlc:LayoutControl x:Name="EditWarehouseControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutGroup x:Name="Body"
                          Orientation="Vertical">
            <dxlc:LayoutItem Label="Текущий склад">
                <dxe:ComboBoxEdit ItemsSource="{Binding Warehouses, Mode=OneWay}"
                                  EditValue="{Binding OldWarehouseId, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayValue"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource ReadOnlyLookUpEditStyle}"/>
            </dxlc:LayoutItem> 
            <dxlc:LayoutItem Label="Новый склад">
                <dxe:ComboBoxEdit ItemsSource="{Binding Warehouses, Mode=OneWay}"
                                  EditValue="{Binding WarehouseId, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                  ValueMember="Id"
                                  DisplayMember="DisplayValue"
                                  HorizontalContentAlignment="Left"
                                  Style="{StaticResource SearchableComboBoxStyle}"/>
            </dxlc:LayoutItem>
            
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          ItemSpace="8">
            <Button Content="OK"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=Body, Converter={dxmvvm:BooleanNegationConverter}}" />
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
