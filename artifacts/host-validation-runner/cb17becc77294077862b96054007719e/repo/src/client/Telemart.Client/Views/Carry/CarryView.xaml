<UserControl x:Class="Telemart.Client.Views.Carry.CarryView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Carry"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             DataContext="{client:Container Type=viewModels:CarryViewModel}"
             Width="600"
             Height="620"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:CarryViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="SelectedTabChildChanged"
                                           Command="{Binding Path=HandleTabSelectionChangedCommand, Mode=OneWay}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
                <dxlc:LayoutGroup x:Name="Tab0"
                                  Orientation="Vertical"
                                  Margin="8">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/information.png" />
                                <TextBlock Text="Инфо"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutItem Label="Тип доставки">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.CarryTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id"
                                          IsTextEditable="True"
                                          IsReadOnly="True"
                                          AllowDefaultButton="False"
                                          Opacity="{StaticResource DisabledElementOpacity}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Название">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Название (краткое)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.NameShort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Название (укр)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.NameUa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Название (англ)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.NameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Контрагент 1C">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.ContractorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          ValueMember="Id" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Лимит UAH">
                        <dxe:SpinEdit EditValue="{Binding Path=Model.MaxLeftToPayUah, Mode=TwoWay, TargetNullValue='Не заполнено', UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      HorizontalContentAlignment="Left"
                                      ShowEditorButtons="False"
                                      Mask="F2"
                                      MaskType="Numeric"
                                      MaxLength="9"
                                      MaskUseAsDisplayFormat="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Лимит USD">
                        <dxe:SpinEdit EditValue="{Binding Path=Model.MaxLeftToPayUsd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      HorizontalContentAlignment="Left"
                                      ShowEditorButtons="False"
                                      Mask="F2"
                                      MaskType="Numeric"
                                      MaxLength="9"
                                      MaskUseAsDisplayFormat="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Стоимость (по умолч.)">
                        <dxe:TextEdit EditValue="{Binding Path=Model.DeliveryCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      MaskType="Numeric"
                                      Mask="F0"
                                      MaxLength="5"
                                      AllowNullInput="False" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Мин. страховка, %">
                        <dxe:TextEdit EditValue="{Binding Path=Model.InsurancePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                      MaskType="Numeric"
                                      Mask="F0"
                                      MaxLength="5"
                                      AllowNullInput="False" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Беспл. дост.">
                        <dxe:SpinEdit EditValue="{Binding Path=Model.MinFreeDeliveryCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      HorizontalContentAlignment="Left"
                                      ShowEditorButtons="False"
                                      Mask="F0"
                                      MaskType="Numeric"
                                      MaxLength="9"
                                      MaskUseAsDisplayFormat="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Наша комиссия, %">
                        <dxe:SpinEdit EditValue="{Binding Path=Model.Comission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      HorizontalContentAlignment="Left"
                                      ShowEditorButtons="False"
                                      MaskType="Numeric"
                                      MaxLength="9"
                                      Mask="###.##"
                                      MaskUseAsDisplayFormat="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Лимит суммы заказа">
                        <dxe:TextEdit EditValue="{Binding Path=Model.OrderCostLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      HorizontalContentAlignment="Left"
                                      NullValue="True"
                                      AllowNullInput="True"
                                      Mask="F0"
                                      MaskType="Numeric"
                                      MaxLength="9"
                                      MaskUseAsDisplayFormat="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Статус">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=ActiveValues, Mode=OneWay}"
                                          EditValue="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:BooleanToEntityActiveConverter}}"
                                          DisplayMember="Name" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Параметры"
                                     LabelVerticalAlignment="Top">
                        <dxe:ListBoxEdit SelectionMode="Multiple"
                                         ShowCustomItems="False">
                            <dxe:ListBoxEdit.StyleSettings>
                                <dxe:CheckedListBoxEditStyleSettings />
                            </dxe:ListBoxEdit.StyleSettings>
                            <dxe:ListBoxEditItem Content="Требуется отчество"
                                                 IsSelected="{Binding Path=DataContext.Model.RequireMiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <dxe:ListBoxEditItem Content="Требуется фамилия"
                                                 IsSelected="{Binding Path=DataContext.Model.RequireLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <dxe:ListBoxEditItem Content="В пределах города"
                                                 IsSelected="{Binding Path=DataContext.Model.IsLocal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <dxe:ListBoxEditItem Content="Доступен для перемещений"
                                                 IsSelected="{Binding Path=DataContext.Model.UseInMovements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <dxe:ListBoxEditItem Content="Отправка с нашего склада"
                                                 IsSelected="{Binding Path=DataContext.Model.OurWarehouseShipment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </dxe:ListBoxEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab1"
                                  Orientation="Vertical"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/coins_16x16.png" />
                                <TextBlock Text="Стоимость"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}">
                        <dxb:BarButtonItem Content="Обновить"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshCarryPricesCommand, Mode=OneWay}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCarryPriceCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Редактировать"
                                           Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                           Command="{Binding Path=EditCarryPriceCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CarryPricesGridControl}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteCarryPriceCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CarryPricesGridControl}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="CarryPricesGridControl"
                                     ItemsSource="{Binding Path=CarryPrices, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="carry_prices.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="WeightFrom"
                                            Header="Вес от"
                                            HeaderToolTip="Вес от"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="False"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="c2"
                                                          MaskUseAsDisplayFormat="True"
                                                          MaskType="Numeric"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="WeightTo"
                                            Header="Вес до"
                                            HeaderToolTip="Вес до"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="false"
                                            Width="100"
                                            AllowBestFit="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="c2"
                                                          MaskUseAsDisplayFormat="True"
                                                          MaskType="Numeric"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Cost"
                                            Header="Цена"
                                            HeaderToolTip="Цена"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="False"
                                            AllowBestFit="True" />
                            <dxg:GridColumn FieldName="Active"
                                            Header="Активность"
                                            HeaderToolTip="Активность"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="False"
                                            AllowBestFit="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dx:DXImage x:Name="PART_Editor"
                                                    Source="../../Images/Common/tick.png"
                                                    Height="16"
                                                    Width="16"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="5,0,0,0"
                                                    Visibility="{Binding Path=RowData.Row.Active, Converter={dx:BooleanToVisibilityConverter}}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowMoveColumnToDropArea="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand EventName="RowDoubleClick"
                                                         Command="{Binding Path=EditCarryPriceCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CarryPricesGridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab2"
                                  Orientation="Vertical"
                                  ItemSpace="0"
                                  Visibility="{Binding Path=IsCourierTabVisible, Converter={dx:BooleanToVisibilityConverter}}"
                                  >
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Common/carry2.png" />
                                <TextBlock Text="Водители"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}">
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCourierCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=RemoveCourierCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=CouriersGridControl}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="CouriersGridControl"
                                     ItemsSource="{Binding Path=SelectedEmployeeCouriers, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="carry_prices.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name"
                                            Header="ФИО"
                                            HeaderToolTip="ФИО"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="False"
                                            AllowBestFit="True"
                                            ReadOnly="True">
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Row"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowMoveColumnToDropArea="False">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                    <Button Content="OK"
                                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                                    IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>