<UserControl x:Class="Telemart.Client.Views.Showcase.AutoShowcasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Showcase"
             xmlns:productInformation="clr-namespace:Telemart.Client.Views.Store.Order.ProductInformation"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxci="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:grid="clr-namespace:Telemart.Client.Common.MvvmEnhancements.Grid"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:AutoShowcasesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoShowcasesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="IdColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn grid:GridColumnHelper.BindingPath="{Binding Path=FieldName, Mode=OneWay}"
                                    grid:GridColumnHelper.FieldName="{Binding Path=FieldName, Mode=OneWay}"
                                    Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ColumnVisible, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowResizing="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanNegationConverter}}"
                                    FixedWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowEditing="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Editable, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:BooleanToDefaultBooleanConverter}}"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    AllowDrop="True"
                                    ShowInColumnChooser="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ShowInColumnChooser, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowMoving="True"
                                    MinWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HorizontalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource Self}}"/>
                           </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="ImageColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn grid:GridColumnHelper.BindingPath="{Binding Path=FieldName, Mode=OneWay}"
                                    grid:GridColumnHelper.FieldName="{Binding Path=FieldName, Mode=OneWay}"
                                    Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ColumnVisible, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowResizing="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanNegationConverter}}"
                                    FixedWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowEditing="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Editable, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:BooleanToDefaultBooleanConverter}}"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    AllowDrop="True"
                                    ShowInColumnChooser="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ShowInColumnChooser, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowMoving="True"
                                    MinWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Common/user_16x16.png"
                                                ToolTip="{Binding Path=Value, Mode=OneWay}"
                                                Height="16"
                                                Width="16"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding Value, Converter={converters:StringToVisibilityConverter}}"
                                                Margin="5,0,0,0" />
                                    <dx:DXImage Source="/Images/Common/android.png"
                                                ToolTip="{Binding Path=Value, Mode=OneWay}"
                                                Height="16"
                                                Width="16"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding Value, Converter={converters:StringToVisibilityConverter Invert=True}}"
                                                Margin="5,0,0,0" />
                                </dxlc:LayoutGroup>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="SpinIntColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn grid:GridColumnHelper.BindingPath="{Binding Path=FieldName, Mode=OneWay}"
                                    grid:GridColumnHelper.FieldName="{Binding Path=FieldName, Mode=OneWay}"
                                    Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ColumnVisible, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FixedWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowEditing="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Editable, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:BooleanToDefaultBooleanConverter}}"
                                    AllowColumnFiltering="False"
                                    AllowGrouping="False"
                                    ShowInColumnChooser="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ShowInColumnChooser, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowMoving="True"
                                    MinWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings MaskUseAsDisplayFormat="True"
                                                  MaskSaveLiteral="False"
                                                  IsFloatValue="False"
                                                  HorizontalContentAlignment="Center"
                                                  ValidateOnTextInput="True"
                                                  MaskType="Numeric"
                                                  Mask="###"
                                                  MinValue="0"
                                                  MaxValue="999"
                                                  IsEnabled="True"
                                                  AllowSpin="True"
                                                  IsTextEditable="True"
                                                  Increment="1"
                                                  ValidateOnEnterKeyPressed="True">
                                <dxe:SpinEditSettings.ErrorToolTipContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={converters:SpinEditErrorToolTipConverter MinErrorText='Количество должно быть больше 0',MaxErrorText='Количество должно быть меньше 999'}, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=dxe:SpinEdit}}" />
                                    </DataTemplate>
                                </dxe:SpinEditSettings.ErrorToolTipContentTemplate>
                            </dxe:SpinEditSettings>
                        </dxg:GridColumn.EditSettings>
                        <dxg:GridColumn.CellStyle>
                            <Style
                                BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}"
                                TargetType="{x:Type dxg:LightweightCellEditor}">
                                <Setter Property="Background" Value="#777771" />
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </dxg:GridColumn.CellStyle>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="NameColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn grid:GridColumnHelper.BindingPath="{Binding Path=FieldName, Mode=OneWay}"
                                    grid:GridColumnHelper.FieldName="{Binding Path=FieldName, Mode=OneWay}"
                                    Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FixedWidth="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowEditing="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Editable, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:BooleanToDefaultBooleanConverter}}"
                                    Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ColumnVisible, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowColumnFiltering="True"
                                    ShowInColumnChooser="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ShowInColumnChooser, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowGrouping="True"
                                    AllowDrop="True"
                                    AllowMoving="True"
                                    Width="200">
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <grid:GridColumnTemplateSelector x:Key="ColumnTemplateSelector"
                                             SpinIntColumnTemplate="{StaticResource SpinIntColumnTemplate}"
                                             NameColumnTemplate="{StaticResource NameColumnTemplate}"
                                             IdColumnTemplate="{StaticResource IdColumnTemplate}"
                                             ImageColumnTemplate="{StaticResource ImageColumnTemplate}"/>
            <DataTemplate x:Key="ChangedFormat">
                <ContentControl>
                    <dxg:FormatCondition ApplyToRow="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ApplyToRow, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         Expression="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Expression, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:FormatCondition.Format>
                            <dx:Format Background="Yellow"
                                       Foreground="Black"/>
                        </dxg:FormatCondition.Format>
                    </dxg:FormatCondition>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="ChangedToEmptyFormat">
                <ContentControl>
                    <dxg:FormatCondition ApplyToRow="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ApplyToRow, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         Expression="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Expression, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:FormatCondition.Format>
                            <dx:Format Background="LightPink"
                                       Foreground="Black"/>
                        </dxg:FormatCondition.Format>
                    </dxg:FormatCondition>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="ChangedFromEmptyFormat">
                <ContentControl>
                    <dxg:FormatCondition ApplyToRow="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ApplyToRow, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         Expression="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Expression, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:FormatCondition.Format>
                            <dx:Format Background="LightGreen"
                                       Foreground="Black"/>
                        </dxg:FormatCondition.Format>
                    </dxg:FormatCondition>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="RedForegroundFormat">
                <ContentControl>
                    <dxg:FormatCondition ApplyToRow="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ApplyToRow, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         Expression="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Expression, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                        <dxg:FormatCondition.Format>
                            <dx:Format Foreground="{StaticResource RetroRedColor}" />
                        </dxg:FormatCondition.Format>
                    </dxg:FormatCondition>
                </ContentControl>
            </DataTemplate>

            <Style x:Key="ColumnStyle"
                   TargetType="dxg:GridColumn">
                <Setter Property="AllowGrouping"
                        Value="True" />
                <Setter Property="MinWidth"
                        Value="25" />
                <Setter Property="AllowMoving"
                        Value="True" />
                <Setter Property="AllowSorting"
                        Value="True" />
                <Setter Property="AllowColumnFiltering"
                        Value="True" />
                <Setter Property="FilterPopupMode"
                        Value="CheckedList" />
            </Style>
            <Style TargetType="dxg:GroupRowDefaultSummaryControl" >

                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ControlTemplate>
                            <!--<UniformGrid Rows="2"/>-->
                            <!--<StackPanel Orientation="Vertical" HorizontalAlignment="Right"></StackPanel>-->
                            <WrapPanel Orientation="Horizontal"></WrapPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <dxmvvm:ObjectToObjectConverter x:Key="BoolToFixedStyleConverter"
                                            DefaultTarget="{x:Static dxg:FixedStyle.None}">
                <dxmvvm:MapItem Source="{StaticResource TrueValue}"
                                Target="{x:Static dxg:FixedStyle.Left}" />
                <dxmvvm:MapItem Source="{StaticResource FalseValue}"
                                Target="{x:Static dxg:FixedStyle.None}" />
            </dxmvvm:ObjectToObjectConverter>
            <grid:FormatConditionSelector x:Key="ConditionSelector"
                                          ChangedTemplate="{StaticResource ChangedFormat}"
                                          ChangedFromEmpty="{StaticResource ChangedFromEmptyFormat}"
                                          ChangedToEmpty="{StaticResource ChangedToEmptyFormat}"
                                          RedForeground="{StaticResource RedForegroundFormat}"/>

            <DataTemplate x:Key="BandTemplate">
                <ContentControl>
                    <dxg:GridControlBand Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).BandName, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).IsFixed, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToFixedStyleConverter}}"
                                         ColumnsSource="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Columns, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         ColumnGeneratorTemplateSelector="{StaticResource ColumnTemplateSelector}"
                                         ColumnGeneratorStyle="{StaticResource ColumnStyle}"/>
                </ContentControl>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
        <dxlc:LayoutControl Orientation="Horizontal"
                            ItemSpace="4"
                            Padding="2"
                            IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=GridControl}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0">
                <dxb:BarManager VerticalAlignment="Top">
                    <dxb:ToolBarControl AllowQuickCustomization="False"
                                        AllowCustomizationMenu="False"
                                        IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                        <dxb:BarButtonItem Content="Обновить"
                                           ToolTip="Обновить (F5)"
                                           LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshCommand, Mode=OneTime}"/>
                        <dxb:BarButtonItem Content="Колонки"
                                           ToolTip="Колонки (F6)"
                                           LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                           Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                           Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                           CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                       ToolTip="Добавить (Insert)"
                                       IsVisible="{Binding Path=CanCreate}"
                                       LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=AddCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           ToolTip="Удалить (Delete)"
                                           IsVisible="{Binding Path=CanDelete}"
                                           LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteCommand, Mode=OneTime}" />
                        <dxb:BarButtonItem Content="Сохранить"
                                           ToolTip="Сохранить (Ctrl+S)"
                                           LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                           Command="{Binding Path=SaveCommand, Mode=OneWay}">
                        </dxb:BarButtonItem>
                        <dxb:BarItemSeparator />
                        <dxb:BarSubItem Content="Ассортимент"
                                        ToolTip="Планирование ассортимента"
                                        LargeGlyph="../../Images/Common/assorti.png"
                                        Glyph="../../Images/Common/assorti.png">
                            <dxb:BarButtonItem Content="По кластерам"
                                               Glyph="../../Images/Showcase/cluster_segment_16.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Command="{Binding Path=ShowcaseClusterCommand, Mode=OneTime}"/>
                            <dxb:BarButtonItem Content="На витринах"
                                               Glyph="../../Images/NavigationMenu/shop.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Command="{Binding Path=ShowcaseCategoryCommand, Mode=OneTime}"/>
                        </dxb:BarSubItem>
                        <dxb:BarSubItem Content="Авто"
                                        ToolTip="Авто витрина"
                                        LargeGlyph="../../Images/Common/android_32x32.png"
                                        Glyph="../../Images/Common/android_16x16.png"
                                        BarItemDisplayMode="ContentAndGlyph"
                                        GlyphAlignment="Top"
                                        IsVisible="{Binding Path=AutoButtonVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <dxb:BarButtonItem Content="По всем товарам на выбранных складах"
                                               Glyph="../../Images/Common/box_16x16.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                               Command="{Binding Path=CalculateAutoShowcaseCommand, Mode=OneTime}"
                                               CommandParameter=""/>
                            <dxb:BarButtonItem Content="По категориям на выбранных складах"
                                               Glyph="../../Images/Common/folders_16_16.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                               Command="{Binding Path=CalculateAutoShowcaseByCategoriesCommand, Mode=OneTime}"/>
                        </dxb:BarSubItem>
                        <dxb:BarButtonItem Content="Маршруты"
                                           ToolTip="Маршруты товаров на витрины"
                                           LargeGlyph="../../Images/Common/house_go_32x32.png"
                                           Glyph="../../Images/Common/house_go_32x32.png"
                                           Command="{Binding Path=ShowcaseRoutesCommand, Mode=OneTime}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="История"
                                           ToolTip="История изменений витрин"
                                           LargeGlyph="../../Images/clock_history_frame.png"
                                           Glyph="../../Images/Order/Payment/payment7.png"
                                           IsVisible="{Binding VisibleHistory, Mode=OneWay}"
                                           Command="{x:Static common:NavCommands.NavigateShowcaseHistoryCommand}" />
                        <dxb:BarItemSeparator />
                        <controls:WikiBarButtonItem />
                    </dxb:ToolBarControl>
                </dxb:BarManager>
                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                <dxdo:DockLayoutManager>
                    <dxdo:LayoutGroup Orientation="Horizontal"
                                      Padding="0"
                                      Margin="0">
                        <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                          AllowSizing="True">
                            <dxg:GridControl x:Name="GridControl"
                                             ImplyNullLikeEmptyStringWhenFiltering="True"
                                             BandsSource="{Binding Path=Bands, Mode=OneWay}"
                                             ItemsSource="{Binding Path=Showcases, Mode=OneWay}"
                                             CurrentColumn="{Binding Path=CurrentColumn, Mode=OneWayToSource}"
                                             CurrentItem="{Binding Path=CurrentRow, Mode=OneWayToSource}"
                                             BandGeneratorTemplate="{StaticResource BandTemplate}"
                                             GroupSummarySource="{Binding SummaryItems}"
                                             SelectionMode="None"
                                             AutoExpandAllGroups="True"
                                             AllowLiveDataShaping="True"
                                             ShowBorder="False"
                                             CustomSummaryCommand="{Binding CustomSummaryCommand}">
                                <dxg:GridControl.ShowLoadingPanel>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="HandleLoadedCommand.IsExecuting" Mode="OneWay" />
                                        <Binding Path="SaveCommand.IsExecuting" Mode="OneWay" />
                                        <Binding Path="CalculateAutoShowcaseCommand.IsExecuting" Mode="OneWay" />
                                        <Binding Path="CalculateAutoShowcaseByCategoriesCommand.IsExecuting" Mode="OneWay" />
                                        <Binding Path="RefreshCommand.IsExecuting" Mode="OneWay" />
                                    </MultiBinding>
                                </dxg:GridControl.ShowLoadingPanel>

                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:LayoutSerializationBehavior FileName="auto_showcase2.xml" />
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>

                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="TableView"
                                                   FormatConditionGeneratorTemplateSelector="{StaticResource ConditionSelector}"
                                                   FormatConditionsSource="{Binding Path=FormattingRules, Mode=OneWay}"
                                                   NavigationStyle="Cell"
                                                   AutoWidth="False"
                                                   AllowSorting="True"
                                                   AllowGrouping="True"
                                                   AllowEditing="True"
                                                   AllowFilterEditor="False"
                                                   AllowMoveColumnToDropArea="True"
                                                   AllowLeaveInvalidEditor="True"
                                                   AllowCommitOnValidationAttributeError="False"
                                                   ShowIndicator="False"
                                                   ShowAutoFilterRow="False"
                                                   ShowFixedTotalSummary="False"
                                                   ShowTotalSummary="False"
                                                   IsTotalSummaryMenuEnabled="False"
                                                   EnableImmediatePosting="True"
                                                   ShowGroupPanel="True"
                                                   EditorShowMode="MouseUp"
                                                   CustomRowAppearance="TableViewCustomRowAppearance"
                                                   CustomCellAppearance="TableViewOnCustomCellAppearance"
                                                   GroupSummaryDisplayMode="Default">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                                   Command="{Binding Path=HandleOutQuantityChangedCommand, Mode=OneWay}"
                                                                   PassEventArgsToCommand="True" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                        <dxdo:LayoutPanel Caption="Поиск"
                                          AllowClose="False"
                                          AllowDrag="False"
                                          AllowDock="True"
                                          AutoHidden="False"
                                          AllowHide="True"
                                          FloatOnDoubleClick="False"
                                          MinWidth="300"
                                          MaxWidth="500"
                                          ItemWidth="400">
                            <dxlc:LayoutControl Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}"
                                                IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                                <dxlc:LayoutGroup Header="Поиск"
                                                  Margin="8,12,8,8">
                                    <dxlc:LayoutGroup Orientation="Vertical"
                                                      ItemStyle="{StaticResource LayoutItemStyle}"
                                                      Margin="0,0,0,0">
                                        <dxlc:LayoutItem Label="Ответственный">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Source="../../Images/Order/Filter/user_green.png"
                                                                    Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Employees, Mode=OneWay}"
                                                              EditValue="{Binding Path=Filter.SelectedCategoryEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"
                                                              NullValueButtonPlacement="EditBox"
                                                              ValidateOnTextInput="False"
                                                              IsTextEditable="False"/>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Склад">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Source="../../Images/Order/Filter/house.png"
                                                                    Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Warehouses, Mode=OneWay}"
                                                              EditValue="{Binding Path=Filter.WarehouseIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:IntCollectionConverter ToObservable=True}, ValidatesOnDataErrors=True}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"
                                                              Style="{StaticResource TokenComboBoxStyle}">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                         Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                                </dxmvvm:Interaction.Behaviors>
                                            </dxe:ComboBoxEdit>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Категория">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Source="../../../Images/Parser/folders_16_16.png"
                                                                    Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <dxg:LookUpEdit ItemsSource="{Binding Path=Filter.Categories, Mode=OneWay}"
                                                            EditValue="{Binding Path=Filter.SelectedCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                            DisplayMember="Name"
                                                            ValueMember="Id"
                                                            AutoPopulateColumns="False"
                                                            AutoComplete="False"
                                                            IncrementalFiltering="True"
                                                            FilterCondition="Like"
                                                            FindMode="Always"
                                                            ImmediatePopup="True"
                                                            IsPopupAutoWidth="True"
                                                            NullValueButtonPlacement="EditBox">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:FocusBehavior />
                                                </dxmvvm:Interaction.Behaviors>
                                            <dxg:LookUpEdit.StyleSettings>
                                                <dxg:SearchLookUpEditStyleSettings/>
                                            </dxg:LookUpEdit.StyleSettings>
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate>
                                                    <dxg:GridControl Name="PART_GridControl">
                                                        <dxg:GridControl.Resources>
                                                            <Style TargetType="dxg:GridColumn"
                                                                   BasedOn="{StaticResource GeneralGridColumnStyle}">
                                                            </Style>
                                                        </dxg:GridControl.Resources>
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="Name"
                                                                            Header="Папка"
                                                                            AllowResizing="False"
                                                                            FixedWidth="False" />
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView AutoWidth="True"
                                                                              AutoExpandAllNodes="True"
                                                                              KeyFieldName="Id"
                                                                              ParentFieldName="ParentId"
                                                                              ShowIndicator="False"
                                                                              UseEvenRowBackground="True"
                                                                              AlternationCount="2"/>
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>
                                            </dxg:LookUpEdit>
                                        </dxlc:LayoutItem>
                                        <!--<dxlc:LayoutItem Label="Кластер">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Source="../../Images/Order/Filter/house.png"
                                                                    Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Clusters, Mode=OneWay}"
                                                              EditValue="{Binding Path=Filter.ClusterIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:IntCollectionConverter ToObservable=True}, ValidatesOnDataErrors=True}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"
                                                              Style="{StaticResource TokenComboBoxStyle}">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                         Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                                </dxmvvm:Interaction.Behaviors>
                                            </dxe:ComboBoxEdit>
                                        </dxlc:LayoutItem>-->
                                        <dxlc:LayerSeparator Kind="Horizontal" />
                                        <dxlc:LayoutItem Label="Товаров">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding Mode=OneWay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Path=Showcases.Count, Mode=OneWay, FallbackValue=0}"
                                                           FontWeight="Bold" />
                                                <TextBlock Text=" шт." />
                                            </StackPanel>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayerSeparator Kind="Horizontal"
                                                             Thickness="1"
                                                             Height="1" />
                                        <dxlc:LayoutGroup Orientation="Horizontal">
                                            <Button VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource NoBordersButton}"
                                                    Command="{Binding Path=RefreshCommand, Mode=OneTime}">
                                                <StackPanel Orientation="Horizontal">
                                                    <dx:DXImage Source="{dx:DXImage Image=Apply_16x16.png}" />
                                                    <TextBlock Text="Применить"
                                                               Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>
                        <dxdo:LayoutPanel Caption="Инфо о товаре"
                                          AllowClose="False"
                                          AllowDrag="False"
                                          AllowDock="True"
                                          AutoHidden="True"
                                          AllowHide="True"
                                          FloatOnDoubleClick="False"
                                          MinWidth="300"
                                          MaxWidth="500"
                                          ItemWidth="400">
                            <dxlc:LayoutControl Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}"
                                                IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                                <productInformation:ProductInformation DataContext="{Binding Path=ProductInformation, Mode=OneWay}"
                                                                       dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Path=DataContext, Mode=OneWay, ElementName=GridControl}" />
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                </dxdo:DockLayoutManager>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
</UserControl>