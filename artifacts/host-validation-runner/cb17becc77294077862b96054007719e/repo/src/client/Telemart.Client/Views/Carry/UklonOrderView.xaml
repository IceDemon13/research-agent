<controls:TelemartUserControl x:Class="Telemart.Client.Views.Carry.UklonOrderView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Carry"
                              DataContext="{client:Container Type=viewModels:UklonOrderViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:UklonOrderViewModel}, IsDesignTimeCreatable=True}"
                              mc:Ignorable="d"
                              Width="400"
                              Height="545"
                              d:DesignHeight="420"
                              d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent"
                         Margin="0">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">

                <dxlc:LayoutGroup Header="Информация"
                                  Orientation="Vertical"
                                  VerticalAlignment="Top"
                                  View="GroupBox">
                    <dxlc:LayoutItem Label="Заказ">
                        <dxe:ButtonEdit EditValue="{Binding Path=OrderId, Mode=OneWay}"
                                        IsTextEditable="False"
                                        AllowDefaultButton="False"
                                        IsReadOnly="True" >
                            <dxe:ButtonInfo GlyphKind="Search"
                                            Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"/>
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Адрес">
                    <dxe:TextEdit EditValue="{Binding Path=Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  IsReadOnly="{Binding Path=CanCreateUklonOrder, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                  EditValuePostMode="Delayed"
                                  EditValuePostDelay="750"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Адрес (Uklon)">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=UklonAddresses, Mode=OneWay}"
                                          EditValue="{Binding Path=SelectedUklonAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource SearchableComboBoxStyle}"
                                          DisplayMember="DisplayValue"
                                          IsTextEditable="False"
                                          IsReadOnly="{Binding Path=CanCreateUklonOrder, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Статус">
                        <dxe:ComboBoxEdit EditValue="{Binding Path=UklonDocumentStateId, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                          ValueMember="Id"
                                          DisplayMember="Name"
                                          IsReadOnly="True"
                                          Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                          Opacity="1"
                                          ItemsSource="{Binding Path=UklonDocumentStates, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Водитель"
                                  Orientation="Vertical"
                                  VerticalAlignment="Center"
                                  View="GroupBox">
                    <dxlc:LayoutItem Label="Телефон">
                        <dxe:TextEdit EditValue="{Binding Path=DriverPhone, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Имя">
                        <dxe:TextEdit EditValue="{Binding Path=DriverName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Кол-во поездок">
                        <dxe:TextEdit EditValue="{Binding Path=DriverCompletedOrders, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Проблемы со слухом">
                        <dxe:CheckEdit EditValue="{Binding Path=DriverHasProblemsWithHearing, Mode=OneWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       IsReadOnly="True" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup
                    Header="Автомобиль"
                    Orientation="Vertical"
                    VerticalAlignment="Bottom"
                    View="GroupBox">
                    <dxlc:LayoutItem Label="Марка">
                        <dxe:TextEdit EditValue="{Binding Path=CarBrand, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Модель">
                        <dxe:TextEdit EditValue="{Binding Path=CarModel, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Цвет">
                        <dxe:TextEdit EditValue="{Binding Path=CarColor, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Номер">
                        <dxe:TextEdit EditValue="{Binding Path=CarLicencePlate, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="True" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <viewComponents:WaitImage x:Name="BusyIndicator"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              BusyText="Обработка...">
                        <viewComponents:WaitImage.Visibility>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                <Binding Path="SearchUklonDriverCommand.IsExecuting" />
                                <Binding Path="CancelUklonOrderCommand.IsExecuting" />
                                <Binding Path="HandleLoadedCommand.IsExecuting" />
                            </MultiBinding>
                        </viewComponents:WaitImage.Visibility>
                    </viewComponents:WaitImage>
                    <Button Content="Поиск водителя"
                            Visibility="{Binding Path=CanCreateUklonOrder, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                            Command="{Binding Path=SearchUklonDriverCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отменить поиск"
                            Command="{Binding Path=CancelUklonOrderCommand, Mode=OneWay}"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>