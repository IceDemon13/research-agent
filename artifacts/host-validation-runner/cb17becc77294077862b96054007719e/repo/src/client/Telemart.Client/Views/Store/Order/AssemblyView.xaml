<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.AssemblyView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order.Assembly"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              DataContext="{client:Container Type=viewModels:AssemblyViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:AssemblyViewModel}}"
                              d:DesignWidth="700"
                              d:DesignHeight="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <dxmvvm:BooleanToObjectConverter x:Key="ShowAllToImageSourceConverter"
                                             TrueValue="../../../Images/Common/check_boxes.png"
                                             FalseValue="../../../Images/Common/check_boxes_series.png"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0">
                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                    <dxb:BarButtonItem Content="Добавить"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=SelectProductCommand, Mode=OneWay}"/>
                    <dxb:BarButtonItem Content="Удалить"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       Command="{Binding Path=DeleteProductCommand, Mode=OneWay}"
                                       CommandParameter="{Binding CurrentItem, ElementName=GridControl}">
                    </dxb:BarButtonItem>
                    <dxb:BarSubItem Glyph="{Binding Path=ShowAll, Mode=OneWay, Converter={StaticResource ShowAllToImageSourceConverter}}">
                        <dxb:BarCheckItem Content="Отобразить все"
                                          BarItemDisplayMode="Content"
                                          IsEnabled="{Binding Path=ShowAll, Converter={dxmvvm:BooleanNegationConverter}}"
                                          IsChecked="{Binding Path=ShowAll}" />
                        <dxb:BarCheckItem Content="Скрыть пустые категории"
                                          BarItemDisplayMode="Content"
                                          IsEnabled="{Binding Path=ShowAll}"
                                          IsChecked="{Binding Path=ShowAll, Converter={dxmvvm:BooleanNegationConverter}}" />
                    </dxb:BarSubItem>
                </dxb:ToolBarControl>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Items, Mode=OneWay}"
                                 SelectionMode="Cell"
                                 AutoExpandAllGroups="True"
                                 FilterString="{Binding FilterString, Mode=TwoWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                        <behaviors:LayoutSerializationBehavior FileName="assembly_edit.xml"/>
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Категория"
                                        FieldName="Category.Name"
                                        HeaderToolTip="Категория"
                                        AllowEditing="False"
                                        FixedWidth="True"/>
                        <dxg:GridColumn Header="Тип"
                                        FieldName="CategoryTypeId"
                                        HeaderToolTip="Тип"
                                        AllowEditing="False"
                                        FixedWidth="True"
                                        GroupIndex="1">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding CategoryTypes}"
                                                          ValueMember="Id"
                                                          DisplayMember="Name"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ProductName"
                                        Header="Товар"
                                        HeaderToolTip="Товар"
                                        AllowEditing="False">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <dxe:TextEdit x:Name="PART_Editor"
                                                      Grid.Column="0"
                                                      ToolTip="{Binding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsReadOnly="True"
                                                      Margin="4 0 0 0"/>
                                        <dx:SimpleButton Grid.Column="1"
                                                         Command="{Binding Path=DataContext.DeleteProductCommand, Mode=OneWay, ElementName=LayoutControl}"
                                                         CommandParameter="{Binding RowData.Row}"
                                                         Content="x"
                                                         Width="20"
                                                         MinWidth="20"
                                                         Height="20"
                                                         Padding="1 -3 1 1"
                                                         HorizontalAlignment="Right" />
                                        <dx:SimpleButton Grid.Column="2"
                                                         Command="{Binding Path=DataContext.SelectProductCommand, Mode=OneWay, ElementName=LayoutControl}"
                                                         CommandParameter="{Binding RowData.Row}"
                                                         Content="..."
                                                         Width="20"
                                                         MinWidth="20"
                                                         Height="20"
                                                         Padding="1 1 1 1"
                                                         HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Product.Quantity"
                                        Header="Кол-во"
                                        HeaderToolTip="Количество товара"
                                        FixedWidth="True"
                                        AllowEditing="True"
                                        Width="60">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:SpinEdit Mask="N0"
                                                  x:Name="PART_Editor"
                                                  MinValue="1"
                                                  MaxValue="99"
                                                  AllowNullInput="True"
                                                  HorizontalContentAlignment="Left"
                                                  Style="{StaticResource ReadOnlyConditionsStyle}">
                                        <dxe:SpinEdit.IsReadOnly>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="RowData.Row.Product"
                                                         Converter="{dxmvvm:ObjectToBooleanConverter Inverse=True}"/>
                                                <Binding Path="RowData.Row.UniqueComplect"/>
                                                <Binding Path="RowData.Row.ReadOnly"/>
                                                <Binding Path="RowData.Row.IsGift"/>
                                            </MultiBinding>
                                        </dxe:SpinEdit.IsReadOnly>
                                    </dxe:SpinEdit>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AssemblyIncluded"
                                        Header="C"
                                        HeaderToolTip="Учавствует в сборке"
                                        FixedWidth="True"
                                        Width="40"
                                        AllowResizing="False"
                                        AllowEditing="True">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:CheckEdit x:Name="PART_Editor"
                                                   HorizontalAlignment="Left"
                                                   Padding="4 0 0 0"
                                                   Visibility="{Binding Path=DataContext.AssemblyService, ElementName=GridControl, Converter={dx:BooleanToVisibilityConverter}}">
                                        <dxe:CheckEdit.IsEnabled>
                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="RowData.Row.ReadOnly"
                                                         Converter="{dxmvvm:BooleanNegationConverter}"/>
                                                <Binding Path="RowData.Row.Product"
                                                         Converter="{dxmvvm:ObjectToBooleanConverter}"/>
                                                <Binding Path="DataContext.AssemblyService"
                                                         ElementName="GridControl"/>
                                            </MultiBinding>
                                        </dxe:CheckEdit.IsEnabled>
                                    </dxe:CheckEdit>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowPerPixelScrolling="True"
                                       ShowTotalSummary="False"
                                       ShowIndicator="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowSearchPanelMode="Never"
                                       ShowGroupPanel="False"
                                       ShowFilterPanelMode="Never"
                                       IsColumnMenuEnabled="False"
                                       EnableImmediatePosting="True"
                                       EditorShowMode="MouseDown"
                                       AutoWidth="True"
                                       NavigationStyle="Cell"
                                       AllowResizing="True"
                                       AllowEditing="True"
                                       AllowGrouping="False"
                                       AllowColumnMoving="False"
                                       AllowColumnFiltering="False"
                                       AllowSorting="True"
                                       AllowMoveColumnToDropArea="False">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left">
                    <dxlc:LayoutItem Label="Услуга сборки">
                        <dxe:CheckEdit EditValue="{Binding Path=AssemblyService}"
                                       IsEnabled="{Binding Path=ReadOnlyAssemblyService, Converter={dxmvvm:BooleanNegationConverter}}"/>
                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="Проверять на совместимость"
                                     Visibility="{Binding CheckCompatibilityVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                        <dxe:CheckEdit EditValue="{Binding Path=CheckCompatibility}"/>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>