<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.ServiceRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:ServiceRequestsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type=viewModels:ServiceRequestsViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary>
                    <Style x:Key="InformationImageStyle"
                           TargetType="dx:DXImage">
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip>
                                    <dxlc:LayoutControl Orientation="Vertical">
                                        <dxlc:LayoutItem Label="Заявку редактирует:"
                                                         Visibility="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="200" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Комментарий:"
                                                         Visibility="{Binding Path=RowData.Row.Comment, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Path=RowData.Row.Comment, Mode=OneWay, Converter={converters:MultiLineToSingleLineTextConverter}}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="200" />
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutControl>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl Orientation="Vertical"
                        ItemSpace="0"
                        Padding="0">
        <dxlc:LayoutGroup>
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl AllowQuickCustomization="False"
                                    AllowCustomizationMenu="False"
                                    IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarSplitButtonItem Content="Создать"
                                            ToolTip="Создать (Insert)"
                                            GlyphAlignment="Top"
                                            LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                            Glyph="{dx:DXImage Image=Add_16x16.png}"
                                            Command="{Binding Path=AddCommand, Mode=OneWay}"
                                            IsVisible="{Binding Path=AllowCreate, Mode=OneWay}">
                        <dxb:BarSplitButtonItem.PopupControl>
                            <dxb:PopupMenu>
                                <dxb:BarButtonItem Content="Несколько"
                                                   Glyph="../../../Images/Common/table_multiple.png"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=AddManyCommand, Mode=OneTime}" />
                            </dxb:PopupMenu>
                        </dxb:BarSplitButtonItem.PopupControl>
                    </dxb:BarSplitButtonItem>
                    <dxb:BarButtonItem Content="Изменить"
                                       ToolTip="Изменить (F2)"
                                       LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                       Command="{Binding Path=EditCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}"
                                       IsVisible="{Binding Path=AllowOpen, Mode=OneWay}" />
                    <dxb:BarSubItem Content="Инстр."
                                    LargeGlyph="/Images/Common/setting_tools_32x32.png"
                                    Glyph="/Images/Common/setting_tools_16x16.png"
                                    GlyphAlignment="Top"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    IsVisible="{Binding Path=AllowOpen, Mode=OneWay}"
                                    IsEnabled="{Binding Path= ToolsEnabled, Mode=OneWay}">
                        <dxb:BarButtonItem Content="Обьеденить"
                                           Glyph="/Images/ServiceRequest/group_stroke.png"
                                           Command="{Binding Path=JoinRequestsCommand, Mode=OneTime}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <dxb:BarButtonItem Content="Разьеденить"
                                           Glyph="/Images/ServiceRequest/ungroup_stroke.png"
                                           Command="{Binding Path=SplitRequestsCommand, Mode=OneTime}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <dxb:BarButtonItem Content="Привязать"
                                           ToolTip="Привязать"
                                           Glyph="/Images/Common/user_add_16x16.png"
                                           IsVisible="{Binding Path=AllowSetCustomer, Mode=OneWay}"
                                           Command="{Binding Path=SetCustomerCommand, Mode=OneTime}" />
                    </dxb:BarSubItem>
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Реестр"
                                       LargeGlyph="/Images/Common/page_green_32x32.png"
                                       Command="{Binding Path=CreateScanSheetCommand, Mode=OneWay}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Печать"
                                       ToolTip="{Binding Path=Content, Mode=Default, RelativeSource={RelativeSource Self}}"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       Command="{Binding Path=PrintCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Margin="0"
                                  Orientation="Horizontal">
                    <dxdo:LayoutGroup Orientation="Vertical">
                        <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                          AllowSizing="True">
                            <dxg:GridControl x:Name="GridControl"
                                             ItemsSource="{Binding Path=ServiceRequests, Mode=OneWay}"
                                             CurrentItem="{Binding Path=SelectedServiceRequest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             SelectionMode="None"
                                             AutoExpandAllGroups="True"
                                             ShowBorder="False">
                                <dxg:GridControl.ShowLoadingPanel>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="RefreshCommand.IsExecuting"
                                                 Mode="OneWay" />
                                        <Binding Path="PrintCommand.IsExecuting"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </dxg:GridControl.ShowLoadingPanel>
                                <dxg:GridControl.GroupSummary>
                                    <dxg:GridSummaryItem SummaryType="Count"
                                                         Alignment="Right"
                                                         Visible="True" />
                                </dxg:GridControl.GroupSummary>
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:LayoutSerializationBehavior FileName="service_requests_4.xml" />
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Заявка"
                                                    HeaderToolTip="Номер заявки"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Id"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowSorting="True"
                                                    AllowBestFit="False"
                                                    AllowMoving="False"
                                                    AllowColumnFiltering="False"
                                                    FixedWidth="True"
                                                    MinWidth="50"
                                                    Width="60">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Заказ"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="OrderId"
                                                    FixedWidth="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowColumnFiltering="False"
                                                    MinWidth="50"
                                                    Width="60">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Принята"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="ReceivedOn"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="False"
                                                    AllowColumnFiltering="False"
                                                    MinWidth="95"
                                                    Width="95"
                                                    GroupInterval="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Изменена"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="LastActivityOn"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="False"
                                                    AllowColumnFiltering="True"
                                                    MinWidth="95"
                                                    Width="95"
                                                    GroupInterval="Date"
                                                    FilterPopupMode="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Дата Х"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="DateX"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="False"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="Date"
                                                    MinWidth="95"
                                                    Width="95"
                                                    GroupInterval="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Подразделение"
                                                    HeaderToolTip="Подразделение"
                                                    FieldName="Subdivision"
                                                    FixedWidth="True"
                                                    Width="83"
                                                    MinWidth="24"
                                                    AllowBestFit="True"
                                                    FilterPopupMode="CheckedList"
                                                    ColumnFilterMode="DisplayText"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowAutoFilter="False"
                                                    DisplayTemplate="{StaticResource SubdivisionColumnDisplayTemplate}" />
                                    <dxg:GridColumn Header="Контрагент"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    FieldName="ContractorId"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=AllContractors, Mode=OneWay}"
                                                                      DisplayMember="Name"
                                                                      ValueMember="Id" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Требование"
                                                    FieldName="Requirement.Name"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="80"
                                                    Width="80" />
                                    <dxg:GridColumn Header="Решение"
                                                    FieldName="RequirementResolution.Name"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="80"
                                                    Width="80" />
                                    <dxg:GridColumn Header="Причина"
                                                    FieldName="RejectReasonId"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="80"
                                                    Width="80">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=RejectReasons}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="ФИО"
                                                    HeaderToolTip="ФИО заявителя"
                                                    FieldName="Fio"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowSorting="False"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="False"
                                                    MinWidth="100"
                                                    Visible="False"></dxg:GridColumn>
                                    <dxg:GridColumn Header="Телефон"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Phone"
                                                    FixedWidth="True"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="False"
                                                    AllowColumnFiltering="False"
                                                    Width="100"
                                                    MinWidth="100"
                                                    Visible="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                                  MaskType="Simple"
                                                                  Mask="(000) 000-00-00"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  MaskSaveLiteral="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Товар"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    FieldName="DisplayProductName"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="False"
                                                    MinWidth="100" />
                                    <dxg:GridColumn Header="Статус"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    FieldName="StateId"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=States, Mode=OneWay}"
                                                                      DisplayMember="Name"
                                                                      ValueMember="Id" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Детализация"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    FieldName="CustomerStateText"
                                                    FixedWidth="True"
                                                    Width="105"
                                                    MinWidth="24"
                                                    FilterPopupMode="CheckedList"
                                                    ColumnFilterMode="DisplayText"
                                                    AllowBestFit="False"
                                                    AllowSorting="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"/>
                                    <dxg:GridColumn Header="Группа"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    FieldName="Group"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="100"/>
                                    <dxg:GridColumn Header="Г"
                                                    HeaderToolTip="Готов к перекомплектации"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="ReadyForRecomplectation"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="True"
                                                    AllowMoving="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="DisplayText"
                                                    FilterPopupMode="CheckedList"
                                                    DisplayTemplate="{StaticResource BooleanTickWithCrossColumnDisplayTemplate}" />
                                    <dxg:GridColumn Header="Создана"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="CreatedOn"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="False"
                                                    AllowColumnFiltering="False"
                                                    MinWidth="95"
                                                    Width="95"
                                                    GroupInterval="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Создал"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    FieldName="CreatedBy"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowSorting="True"
                                                    AllowBestFit="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    MinWidth="100">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=AllEmployees, Mode=OneWay}"
                                                                      DisplayMember="Name"
                                                                      ValueMember="Id" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="ДС"
                                                    HeaderToolTip="Завершены все Возвраты ДС по заявке"
                                                    FieldName="CompletedOnMoneyRefund"
                                                    FixedWidth="True"
                                                    Width="34"
                                                    MinWidth="34"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    FilterPopupMode="CheckedList"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dx:DXImage Source="../../../Images/Common/tick.png"
                                                            Width="16"
                                                            Height="16"
                                                            Visibility="{Binding Path=RowData.Row.CompletedOnMoneyRefund, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="ФЧ"
                                                    HeaderToolTip="Фискальный чек"
                                                    FieldName="RealCompletedOnFiscalRegistrar"
                                                    FixedWidth="True"
                                                    Width="34"
                                                    MinWidth="34"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    FilterPopupMode="CheckedList"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dx:DXImage Source="../../../Images/Common/tick.png"
                                                            Width="16"
                                                            Height="16"
                                                            Visibility="{Binding Path=RowData.Row.RealCompletedOnFiscalRegistrar, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="И"
                                                HeaderToolTip="Информация"
                                                FieldName="EmployeeLockName"
                                                FixedWidth="True"
                                                Width="25"
                                                MinWidth="20"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowColumnFiltering="False"
                                                AllowAutoFilter="False"
                                                AllowSorting="False"
                                                HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxlc:LayoutGroup Orientation="Horizontal">
                                                    <dx:DXImage x:Name="LockedImage"
                                                            Source="../../../Images/Common/lock.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            Margin="4 0 0 0"
                                                            Style="{StaticResource InformationImageStyle}"
                                                            Visibility="{Binding Path=RowData.Row.EmployeeLockName, Converter={converters:StringToVisibilityConverter}}">
                                                    </dx:DXImage>
                                                    <dx:DXImage Source="../../../Images/Common/comment.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource InformationImageStyle}"
                                                            Margin="4 0 0 0">
                                                        <dx:DXImage.Visibility>
                                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                                <Binding Path="IsVisible"
                                                                     ElementName="LockedImage"
                                                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                                                                <Binding Path="RowData.Row.Comment"
                                                                     Converter="{dxmvvm:StringToBooleanConverter}" />
                                                            </MultiBinding>
                                                        </dx:DXImage.Visibility>
                                                    </dx:DXImage>
                                                    <TextBlock Text="{Binding Path=RowData.Row.Comment, Mode=OneWay, Converter={converters:MultiLineToSingleLineTextConverter}}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Visibility="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget, Converter={converters:TrimmedTextBlockVisibilityConverter}}">
                                                                <ToolTip.Content>
                                                                    <TextBlock Text="{Binding Path=RowData.Row.Comment, Converter={converters:MultiLineToSingleLineTextConverter}}" />
                                                                </ToolTip.Content>
                                                            </ToolTip>
                                                        </TextBlock.ToolTip>
                                                </TextBlock>
                                                </dxlc:LayoutGroup>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Заявка"
                                                HeaderToolTip="Номер заявки на вызов курьера"
                                                FieldName="NpCourierCallBarcode"
                                                FixedWidth="True"
                                                MaxWidth="90"
                                                MinWidth="24"
