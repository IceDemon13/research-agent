<UserControl x:Class="Telemart.Client.Views.Directories.ProductsFeatures.ProductFeaturesYandexMarketParseReportView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsFeatures.YandexMarketFeaturesParser"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:ProductFeaturesYandexMarketParseReportViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:ProductFeaturesYandexMarketParseReportViewModel}, IsDesignTimeCreatable=True}"
             Width="800"
             Height="450">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxg:GridControl ItemsSource="{Binding Path=Messages, Mode=OneWay}"
                         SelectionMode="Row">
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Сообщение"
                                FieldName="Message"
                                ReadOnly="True">
                    <dxg:GridColumn.CellStyle>
                        <Style TargetType="{x:Type dxg:LightweightCellEditor}" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                            <Setter Property="Foreground" Value="{Binding RowData.Row.Brush}"/>
                        </Style>
                    </dxg:GridColumn.CellStyle>
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings TextWrapping="Wrap"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView NavigationStyle="Row"
                               CustomRowAppearance="TableViewOnCustomRowAppearance"
                               Style="{StaticResource ReadOnlyTableViewStyle}"/>
            </dxg:GridControl.View>
        </dxg:GridControl>
        <dxe:ProgressBarEdit Maximum="{Binding CategoriesCount}"
                             Value="{Binding CurrentCategoryIndex}"
                             ContentDisplayMode="Content"
                             Content="{Binding CategoriesText}"
                             VerticalAlignment="Bottom"/>
        <dxe:ProgressBarEdit Maximum="{Binding ProductsCount}"
                             Value="{Binding CurrentProductIndex}"
                             Content="{Binding ProductsText}"
                             ContentDisplayMode="Content"
                             VerticalAlignment="Bottom"/>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom">
            <dxlc:LayoutGroup HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                <Button Content="ОК"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding ParseIsComplete}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>

