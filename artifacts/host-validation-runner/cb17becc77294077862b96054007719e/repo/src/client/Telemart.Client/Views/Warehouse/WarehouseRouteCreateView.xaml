<controls:TelemartUserControl x:Class="Telemart.Client.Views.Warehouse.WarehouseRouteCreateView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse"
                              xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
                              DataContext="{client:Container Type=viewModels:WarehouseRouteCreateViewModel}"
                              Width="300"
                              Height="140"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:WarehouseRouteCreateViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutControl.IsEnabled>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                    <Binding Path="OkCommand.IsExecuting" />
                </MultiBinding>
            </dxlc:LayoutControl.IsEnabled>
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Отправитель">
                    <dxe:ComboBoxEdit x:Name="ServiceCentersComboBox"
                                      ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Path=WarehouseFromId, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                      IsReadOnly="{Binding Path=OpenWithWarehouseFrom, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id">
                        <dxe:ComboBoxEdit.Style>
                            <Style TargetType="dxe:ComboBoxEdit">
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=OpenWithWarehouseFrom, Mode=OneWay}">
                                        <Setter Property="IsReadOnly"
                                                Value="True" />
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                        <Setter Property="AllowDefaultButton"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxe:ComboBoxEdit.Style>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Получатель">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Path=WarehouseToId, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Вес">
                    <dxe:TextEdit EditValue="{Binding Path=Weight, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                            Command="{Binding Path=OkCommand, Mode=OneWay}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>