<UserControl x:Class="Telemart.Client.Views.LogisticsAnalitics.LogisticsAnaliticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.LogisticsAnalitics"
             DataContext="{client:Container Type=viewModels:LogisticsAnaliticsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:LogisticsAnaliticsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="770">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/InvoiceState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/MovementState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}"/>
    </dxmvvm:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0" >
            <dxb:ToolBarControl>
                <dxb:ToolBarControl.IsEnabled>
                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                        <Binding Path="ShowLoadingPanel" ElementName="InvoiceGridControl" />
                        <Binding Path="ShowLoadingPanel" ElementName="MovementGridControl" />
                        <Binding Path="ShowLoadingPanel" ElementName="OrderGridControl" />
                    </MultiBinding>
                </dxb:ToolBarControl.IsEnabled>
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                   CommandTarget="{Binding ElementName=InvoiceGridControl}" />
                <dxb:BarSubItem Content="Вид"
                                LargeGlyph="../../../Images/Common/layout_32x32.png"
                                BarItemDisplayMode="ContentAndGlyph"
                                GlyphAlignment="Top"
                                IsVisible="True">
                    <dxb:BarButtonItem Content="Отобразить/Скрыть таблицу Накладные"
                                       Glyph="../../../Images/Common/tick.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Right"
                                       IsVisible="{Binding ShowInvoicesGrid}"
                                       Command="{Binding Path=OpenCloseInvoiceGridCommand, Mode=OneTime}"
                                       CommandParameter="{StaticResource FalseValue}"/>
                    <dxb:BarButtonItem Content="Отобразить/Скрыть таблицу Накладные"
                                       Glyph="../../../Images/Order/Source/source4.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       IsVisible="{Binding ShowInvoicesGrid, Converter={dxmvvm:BooleanNegationConverter}}"
                                       GlyphAlignment="Right"
                                       Command="{Binding Path=OpenCloseInvoiceGridCommand, Mode=OneTime}"
                                       CommandParameter="{StaticResource TrueValue}"/>
                    <dxb:BarButtonItem Content="Отобразить/Скрыть таблицу Перемещения"
                                       Glyph="../../../Images/Common/tick.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Right"
                                       IsVisible="{Binding ShowMovementsGrid}"
                                       Command="{Binding Path=OpenCloseMovementGridCommand, Mode=OneTime}"
                                       CommandParameter="{StaticResource FalseValue}"/>
                    <dxb:BarButtonItem Content="Отобразить/Скрыть таблицу Перемещения"
                                       Glyph="../../../Images/Order/Source/source4.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       IsVisible="{Binding ShowMovementsGrid, Converter={dxmvvm:BooleanNegationConverter}}"
                                       GlyphAlignment="Right"
                                       Command="{Binding Path=OpenCloseMovementGridCommand, Mode=OneTime}"
                                       CommandParameter="{StaticResource TrueValue}"/>
                    <dxb:BarButtonItem Content="Отобразить/Скрыть таблицу Заказов"
                                       Glyph="../../../Images/Common/tick.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       GlyphAlignment="Right"
                                       IsVisible="{Binding ShowOrdersGrid}"
                                       Command="{Binding Path=OpenCloseOrderGridCommand, Mode=OneTime}"
                                       CommandParameter="{StaticResource FalseValue}"/>
                    <dxb:BarButtonItem Content="Отобразить/Скрыть таблицу Заказов"
                                       Glyph="../../../Images/Order/Source/source4.png"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       IsVisible="{Binding ShowOrdersGrid, Converter={dxmvvm:BooleanNegationConverter}}"
                                       GlyphAlignment="Right"
                                       Command="{Binding Path=OpenCloseOrderGridCommand, Mode=OneTime}"
                                       CommandParameter="{StaticResource TrueValue}"/>
                </dxb:BarSubItem>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0">
                <dxdo:LayoutGroup Orientation="Vertical"
                                  Padding="0">
                    <dxdo:LayoutPanel AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="False"
                                      AutoHidden="False"
                                      AllowHide="False"
                                      FloatOnDoubleClick="False"
                                      Padding="0">
                        <dxlc:LayoutGroup  Orientation="Vertical">
                            <dxlc:LayoutGroup View="GroupBox"
                                              Visibility="{Binding Path=ShowInvoicesGrid,Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                              Header="Накладные"
                                              Orientation="Vertical"
                                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                              ItemSpace="0">
                                <dxb:ToolBarControl GlyphSize="Small"
                                                    BarItemDisplayMode="Default"
                                                    AllowCustomizationMenu="False"
                                                    AllowQuickCustomization="False"
                                                    Padding="0"
                                                    IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=InvoiceGridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                                    <dxb:BarButtonItem Content="Перенести"
                                                       ToolTip="Перенести"
                                                       Glyph="../../../Images/Common/clock_history_frame_16x16.png"
                                                       Command="{Binding Path=InvoiceMoveCommand, Mode=OneTime}"
                                                       CommandParameter="{Binding Path=SelectedInvoiceLogisticsAnaliticsViewItem, Mode=OneWay}">
                                    </dxb:BarButtonItem>
                                </dxb:ToolBarControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxg:GridControl x:Name="InvoiceGridControl"
                                                 ItemsSource="{Binding InvoiceLogisticsAnaliticsViewItems, Mode=OneWay }"
                                                 SelectedItem="{Binding SelectedInvoiceLogisticsAnaliticsViewItem, Mode=TwoWay}"
                                                 ShowBorder="False"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 SelectionMode="None"
                                                 CopyingToClipboard="OnCopyingToClipboard">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:LayoutSerializationBehavior FileName="analitics_invoice_1.xml" />
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.ShowLoadingPanel>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                            <Binding Path="RefreshCommand.IsExecuting" />
                                            <Binding Path="InvoiceMoveCommand.IsExecuting" />
                                            <Binding Path="HandleLoadedCommand.IsExecuting" />
                                        </MultiBinding>
                                    </dxg:GridControl.ShowLoadingPanel>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Накладная"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        FieldName="InvoiceId"
                                                        AllowMoving="False"
                                                        FixedWidth="True"
                                                        AllowResizing="False"
                                                        Width="100"
                                                        AllowSorting="True"
                                                        HorizontalHeaderContentAlignment="Center">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Статус"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        FieldName="State"
                                                        FixedWidth="True"
                                                        AllowResizing="True"
                                                        AllowBestFit="False"
                                                        AllowColumnFiltering="True"
                                                        MinWidth="24"
                                                        Width="100"
                                                        MaxWidth="150"
                                                        AllowAutoFilter="False"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        AllowGrouping="True"
                                                        AllowMoving="True"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText"
                                                        DisplayTemplate="{StaticResource InvoiceStateColumnDisplayTemplate}"/>
                                        <dxg:GridColumn Header="Дата приезда"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        FieldName="DateArrive"
                                                        AllowResizing="False"
                                                        AllowBestFit="False"
                                                        FixedWidth="True"
                                                        Width="100"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        AllowGrouping="True"
                                                        AllowMoving="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                      Mask="dd.MM.yyyy HH:mm"
                                                                      MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Просрочено (мин.)"
                                                            HeaderToolTip="Просрочена дата приезда (мин.)"
                                                            FieldName="OverdueDateArrive"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            Width="80"
                                                            MinWidth="50"
                                                            MaxWidth="100"
                                                            AllowResizing="True"
                                                            FixedWidth="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Дата принятия"
                                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            FieldName="DateReceive"
                                                            AllowResizing="False"
                                                            AllowBestFit="False"
                                                            FixedWidth="True"
                                                            Width="100"
                                                            AllowGrouping="True"
                                                            AllowMoving="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                          Mask="dd.MM.yyyy HH:mm"
                                                                          MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Просрочено (мин.)"
                                                            HeaderToolTip="Просрочена дата принятия (мин.)"
                                                            FieldName="OverdueDateReceive"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            Width="80"
                                                            MinWidth="50"
                                                            MaxWidth="100"
                                                            AllowResizing="True"
                                                            FixedWidth="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Строк (по заказам)"
                                                            HeaderToolTip="Строк (по заказам)"
                                                            FieldName="OrderRows"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            Width="80"
                                                            MinWidth="50"
                                                            MaxWidth="200"
                                                            AllowResizing="True"
                                                            FixedWidth="False"
                                                            AllowBestFit="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Строк (всего)"
                                                            HeaderToolTip="Строк (всего по накладной)"
                                                            FieldName="Rows"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            Width="80"
                                                            MinWidth="40"
                                                            MaxWidth="200"
                                                            AllowResizing="True"
                                                            FixedWidth="False"
                                                            AllowBestFit="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Заказов"
                                                            HeaderToolTip="Заказов"
                                                            FieldName="OrdersCount"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            Width="80"
                                                            MinWidth="40"
                                                            MaxWidth="200"
                                                            AllowResizing="True"
                                                            FixedWidth="False"
                                                            AllowBestFit="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings HorizontalContentAlignment="Right"
                                                                          MaskType="Numeric"
                                                                          Mask="f0"
                                                                          MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="Weight"
                                                            Header="Вес"
                                                            HeaderToolTip="Вес товаров в накладной"
                                                            Width="80"
                                                            MinWidth="40"
                                                            MaxWidth="200"
                                                            AllowResizing="True"
                                                            FixedWidth="False"
                                                            AllowBestFit="True"
                                                            HorizontalHeaderContentAlignment="Center">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings HorizontalContentAlignment="Right"
                                                                          MaskType="Numeric"
                                                                          Mask="f1"
                                                                          MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="Стоимость заказов"
                                                            HeaderToolTip="Стоимость заказов"
                                                            HorizontalHeaderContentAlignment="Center"
                                                            FieldName="OrdersPriceString"
                                                            Width="80"
                                                            MinWidth="50"
                                                            MaxWidth="200"
                                                            AllowResizing="True"
                                                            FixedWidth="False"
                                                            AllowBestFit="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings HorizontalContentAlignment="Right" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowPerPixelScrolling="True"
                                                       AllowedGroupFilters="None"
                                                       ShowColumnHeaders="True"
                                                       AllowGrouping="False"
                                                       ShowGroupPanel="True"
                                                       AllowSorting="True"
                                                       AllowMoveColumnToDropArea="False"
                                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                                       Command="{Binding Path=InvoiceHandleRowDoubleClickCommand, Mode=OneWay}"
                                                                       PassEventArgsToCommand="False"/>
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup View="GroupBox"
                                              Header="Перемещения"
                                              Orientation="Vertical"
                                              Visibility="{Binding Path=ShowMovementsGrid,Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                              ItemSpace="0">
                                <dxb:ToolBarControl GlyphSize="Small"
                                                BarItemDisplayMode="Default"
                                                AllowCustomizationMenu="False"
                                                AllowQuickCustomization="False"
                                                Padding="0"
                                                IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=InvoiceGridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                                    <dxb:BarButtonItem Content="Перенести"
                                                   ToolTip="Перенести"
                                                   Glyph="../../../Images/Common/clock_history_frame_16x16.png"
                                                   Command="{Binding Path=MovementMoveCommand, Mode=OneTime}"
                                                   CommandParameter="{Binding Path=SelectedMovementLogisticsAnaliticsViewItem, Mode=OneWay}">
                                    </dxb:BarButtonItem>
                                </dxb:ToolBarControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxg:GridControl x:Name="MovementGridControl"
                                                 ItemsSource="{Binding MovementLogisticsAnaliticsViewItems, Mode=OneWay }"
                                                 SelectedItem="{Binding SelectedMovementLogisticsAnaliticsViewItem, Mode=TwoWay}"
                                                 ShowBorder="False"
                                                 SelectionMode="None"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Stretch"
                                                 CopyingToClipboard="OnCopyingToClipboard">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:LayoutSerializationBehavior FileName="analitics_movement_1.xml" />
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.ShowLoadingPanel>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                            <Binding Path="RefreshCommand.IsExecuting" />
                                            <Binding Path="MovementMoveCommand.IsExecuting" />
                                            <Binding Path="HandleLoadedCommand.IsExecuting" />
                                        </MultiBinding>
                                    </dxg:GridControl.ShowLoadingPanel>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Перемещение"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="MovementId"
                                                        FixedWidth="True"
                                                        AllowResizing="True"
                                                        MinWidth="50"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowSorting="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Статус"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        FieldName="State"
                                                        FixedWidth="True"
                                                        AllowResizing="True"
                                                        AllowBestFit="False"
                                                        AllowColumnFiltering="True"
                                                        MinWidth="24"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowAutoFilter="False"
                                                        HorizontalHeaderContentAlignment="Left"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText"
                                                        AllowGrouping="True"
                                                        AllowMoving="True"
                                                        DisplayTemplate="{StaticResource MovementStateColumnDisplayTemplate}">
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Type"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        Header="Тип"
                                                        AllowResizing="True"
                                                        MinWidth="50"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowSorting="False"
                                                        FixedWidth="True"
                                                        AllowGrouping="True"
                                                        AllowMoving="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Принятие\Отправка"
                                                        HeaderToolTip="Дата принятия\отправки"
                                                        FieldName="DateRecievSent"
                                                        AllowResizing="False"
                                                        AllowBestFit="False"
                                                        FixedWidth="True"
                                                        MinWidth="80"
                                                        Width="100"
                                                        AllowGrouping="True"
                                                        AllowMoving="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                      Mask="dd.MM.yyyy HH:mm"
                                                                      MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Просрочено (мин.)"
                                                        HeaderToolTip="Просрочено (мин.)"
                                                        FieldName="Overdue"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        AllowResizing="True"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        FixedWidth="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Строк (по заказам)"
                                                        HeaderToolTip="Строк (по заказам)"
                                                        FieldName="OrderRows"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="150"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        AllowBestFit="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Строк (всего)"
                                                        HeaderToolTip="Строк (всего в перемещении)"
                                                        FieldName="Rows"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        AllowBestFit="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Заказов"
                                                        HeaderToolTip="Заказов"
                                                        FieldName="OrdersCount"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        AllowBestFit="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings HorizontalContentAlignment="Right"
                                                                      MaskType="Numeric"
                                                                      Mask="f0"
                                                                      MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Weight"
                                                        Header="Вес"
                                                        HeaderToolTip="Вес товаров в перемещении"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        AllowBestFit="True"
                                                        HorizontalHeaderContentAlignment="Center">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Right"
                                                                      MaskType="Numeric"
                                                                      Mask="f1"
                                                                      MaskUseAsDisplayFormat="True"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Стоимость заказов"
                                                        HeaderToolTip="Стоимость заказов"
                                                        FieldName="OrdersPriceString"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="200"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        AllowBestFit="True"
                                                        HorizontalHeaderContentAlignment="Center">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowPerPixelScrolling="True"
                                                       CheckBoxSelectorColumnWidth="20"
                                                       RetainSelectionOnClickOutsideCheckBoxSelector="True"
                                                       ShowCheckBoxSelectorColumn="True"
                                                       AllowedGroupFilters="None"
                                                       ShowColumnHeaders="True"
                                                       AllowGrouping="False"
                                                       AllowSorting="True"
                                                       AllowMoveColumnToDropArea="False"
                                                       ShowGroupPanel="True"
                                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                                       Command="{Binding Path=MovementHandleRowDoubleClickCommand, Mode=OneWay}"
                                                                       PassEventArgsToCommand="False"/>
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup View="GroupBox"
                                              Header="Заказы"
                                              Orientation="Vertical"
                                              Visibility="{Binding Path=ShowOrdersGrid,Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                              ItemSpace="0">
                                <dxb:ToolBarControl GlyphSize="Small"
                                                BarItemDisplayMode="Default"
                                                AllowCustomizationMenu="False"
                                                AllowQuickCustomization="False"
                                                Padding="0"
                                                IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=InvoiceGridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                                    <dxb:BarButtonItem Content="Перенести"
                                                       ToolTip="Перенести"
                                                       Glyph="../../../Images/Common/clock_history_frame_16x16.png"
                                                       Command="{Binding Path=OrderMoveCommand, Mode=OneTime}"
                                                       CommandParameter="{Binding Path=SelectedOrderLogisticsAnaliticsViewItems, Mode=OneWay}">
                                    </dxb:BarButtonItem>
                                </dxb:ToolBarControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxg:GridControl x:Name="OrderGridControl"
                                                 ItemsSource="{Binding OrderLogisticsAnaliticsViewItems, Mode=OneWay }"
                                                 SelectedItems="{Binding SelectedOrderLogisticsAnaliticsViewItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CurrentItem="{Binding Path=CurrentOrder, Mode=TwoWay}"
                                                 ShowBorder="False"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 SelectionMode="Row"
                                                 CopyingToClipboard="OnCopyingToClipboard">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:LayoutSerializationBehavior FileName="analitics_order_1.xml" />
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.ShowLoadingPanel>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                            <Binding Path="RefreshCommand.IsExecuting" />
                                            <Binding Path="OrderMoveCommand.IsExecuting" />
                                            <Binding Path="HandleLoadedCommand.IsExecuting" />
                                        </MultiBinding>
                                    </dxg:GridControl.ShowLoadingPanel>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Заказ"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="OrderId"
                                                        AllowResizing="True"
                                                        MinWidth="80"
                                                        Width="100"
                                                        MaxWidth="150"
                                                        AllowSorting="True"
                                                        FixedWidth="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Статус"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        HorizontalHeaderContentAlignment="Left"
                                                        FieldName="State"
                                                        FixedWidth="True"
                                                        AllowResizing="True"
                                                        AllowBestFit="False"
                                                        AllowColumnFiltering="True"
                                                        MinWidth="24"
                                                        Width="80"
                                                        MaxWidth="120"
                                                        AllowAutoFilter="False"
                                                        DisplayTemplate="{StaticResource OrderStatusColumnDisplayTemplate}"
                                                        AllowGrouping="True"
                                                        AllowMoving="True"/>
                                        <dxg:GridColumn Header="Дата X"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        FieldName="DeliveryTime"
                                                        AllowResizing="False"
                                                        AllowBestFit="False"
                                                        FixedWidth="True"
                                                        Width="100"
                                                        AllowGrouping="True"
                                                        AllowMoving="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                      Mask="dd.MM.yyyy HH:mm"
                                                                      MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                        <dxg:GridColumn Header="Просрочено (мин.)"
                                                        HeaderToolTip="Просрочено (мин.)"
                                                        FieldName="Overdue"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        Width="80"
                                                        MinWidth="50"
                                                        MaxWidth="100"
                                                        AllowResizing="True"
                                                        FixedWidth="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Строк"
                                                        HeaderToolTip="Строк"
                                                        FieldName="Rows"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        AllowResizing="True"
                                                        AllowBestFit="True"
                                                        FixedWidth="False"
                                                        MinWidth="100"
                                                        Width="100"
                                                        MaxWidth="200">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings HorizontalContentAlignment="Right" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Weight"
                                                        Header="Вес"
                                                        HeaderToolTip="Вес товаров в заказе"
                                                        Width="80"
                                                        MinWidth="50"
                                                        MaxWidth="100"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        HorizontalHeaderContentAlignment="Center">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Right"
                                                                      MaskType="Numeric"
                                                                      Mask="f1"
                                                                      MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Стоимость"
                                                        HeaderToolTip="Стоимость"
                                                        FieldName="OrdersPriceString"
                                                        Width="80"
                                                        MinWidth="50"
                                                        MaxWidth="100"
                                                        AllowResizing="True"
                                                        FixedWidth="False"
                                                        HorizontalHeaderContentAlignment="Center">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Right"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Подразд."
                                                        HeaderToolTip="Подразделение"
                                                        HorizontalHeaderContentAlignment="Left"
                                                        FieldName="Subdivision"
                                                        FixedWidth="True"
                                                        Width="24"
                                                        MinWidth="80"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText"
                                                        AllowBestFit="False"
                                                        AllowResizing="True"
                                                        AllowGrouping="True"
                                                        AllowColumnFiltering="True"
                                                        AllowAutoFilter="False"
                                                        DisplayTemplate="{StaticResource SubdivisionColumnDisplayTemplate}"></dxg:GridColumn>
                                        <dxg:GridColumn Header="У"
                                                        HeaderToolTip="Готов к упаковке"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="ReadyForPacking"
                                                        Width="35"
                                                        AllowAutoFilter="False"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        FixedWidth="True"
                                                        AllowResizing="False"
                                                        DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="И"
                                                        HeaderToolTip="Инициация распаковки"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="EventUnpackAndCancelOrder"
                                                        Width="26"
                                                        AllowAutoFilter="False"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        FixedWidth="True"
                                                        AllowResizing="False">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Background="Transparent">
                                                        <dx:DXImage Source="/Images/NavigationMenu/box_open.png"
                                                                    Height="16"
                                                                    Width="16"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="5,0,0,0"
                                                                    Visibility="{Binding RowData.Row.EventUnpackAndCancelOrder,  Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="О"
                                                        HeaderToolTip="Отмена заказа с сайта"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="CanceledFromSite"
                                                        Width="26"
                                                        AllowAutoFilter="False"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        FixedWidth="True"
                                                        AllowResizing="False">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Background="Transparent">
                                                        <dx:DXImage Source="/Images/Common/canceled.png"
                                                                    Height="16"
                                                                    Width="16"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="5,0,0,0"
                                                                    Visibility="{Binding RowData.Row.CanceledFromSite, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowPerPixelScrolling="True"
                                                       CheckBoxSelectorColumnWidth="20"
                                                       RetainSelectionOnClickOutsideCheckBoxSelector="True"
                                                       ShowCheckBoxSelectorColumn="True"
                                                       AllowedGroupFilters="None"
                                                       ShowColumnHeaders="True"
                                                       AllowGrouping="False"
                                                       AllowSorting="True"
                                                       AllowMoveColumnToDropArea="False"
                                                       ShowGroupPanel="True"
                                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                                       Command="{Binding Path=OrderHandleRowDoubleClickCommand, Mode=OneWay}"
                                                                       PassEventArgsToCommand="False"/>
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup ItemWidth="355"
                                  MinWidth="355"
                                  MaxWidth="500"
                                  Orientation="Vertical">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      AllowHide="True"
                                      FloatOnDoubleClick="False"
                                      ItemWidth="355"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <dxlc:LayoutControl Orientation="Vertical"
                                            ItemStyle="{StaticResource LayoutItemStyle}">
                            <dxlc:LayoutItem Label="Склад">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/house.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Warehouses, Mode=OneWay}"
                                                  EditValue="{Binding Path=Filter.SelectedWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  Style="{StaticResource SearchableComboBoxStyle}">
                                    <dxe:ComboBoxEdit.IsEnabled>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                            <Binding Path="ShowLoadingPanel" ElementName="InvoiceGridControl" />
                                            <Binding Path="ShowLoadingPanel" ElementName="MovementGridControl" />
                                            <Binding Path="ShowLoadingPanel" ElementName="OrderGridControl" />
                                        </MultiBinding>
                                    </dxe:ComboBoxEdit.IsEnabled>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Просрочено">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../../Images/Order/Filter/time.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:CheckEdit EditValue="{Binding Path=Filter.ExpiredOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               IsThreeState="False"
                                               ToolTip="Только просроченные">
                                    <dxe:CheckEdit.IsEnabled>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                            <Binding Path="ShowLoadingPanel" ElementName="InvoiceGridControl" />
                                            <Binding Path="ShowLoadingPanel" ElementName="MovementGridControl" />
                                            <Binding Path="ShowLoadingPanel" ElementName="OrderGridControl" />
                                        </MultiBinding>
                                    </dxe:CheckEdit.IsEnabled>
                                </dxe:CheckEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal"/>
                            <dxlc:LayoutItem Label="Накладных">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=InvoiceLogisticsAnaliticsViewItems.Count, Mode=OneWay}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Перемещений">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=MovementLogisticsAnaliticsViewItems.Count, Mode=OneWay}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Заказов">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=OrderLogisticsAnaliticsViewItems.Count, Mode=OneWay}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal" />
                            <dxb:ToolBarControl GlyphSize="Small">
                                <dxb:ToolBarControl.IsEnabled>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                        <Binding Path="ShowLoadingPanel" ElementName="InvoiceGridControl" />
                                        <Binding Path="ShowLoadingPanel" ElementName="MovementGridControl" />
                                        <Binding Path="ShowLoadingPanel" ElementName="OrderGridControl" />
                                    </MultiBinding>
                                </dxb:ToolBarControl.IsEnabled>

                                <dxb:BarButtonItem Content="Применить"
                                                   Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                   GlyphAlignment="Left">
                                </dxb:BarButtonItem>
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItem Content="Отмена"
                                                   Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                   Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                   GlyphAlignment="Left">
                                </dxb:BarButtonItem>
                            </dxb:ToolBarControl>
                        </dxlc:LayoutControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</UserControl>