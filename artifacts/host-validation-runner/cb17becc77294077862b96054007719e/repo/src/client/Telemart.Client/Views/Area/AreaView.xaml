<UserControl x:Class="Telemart.Client.Views.Area.AreaView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Area"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             DataContext="{client:Container Type=viewModels:AreaViewModel}"
             Width="460"
             Height="260"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:AreaViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <dxmvvm:BooleanToObjectConverter x:Key="ActiveToIntConverter"
                                             NullValue="{x:Null}">
                <dxmvvm:BooleanToObjectConverter.TrueValue>
                    <system:Int32>1</system:Int32>
                </dxmvvm:BooleanToObjectConverter.TrueValue>
                <dxmvvm:BooleanToObjectConverter.FalseValue>
                    <system:Int32>2</system:Int32>
                </dxmvvm:BooleanToObjectConverter.FalseValue>
            </dxmvvm:BooleanToObjectConverter>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
        <dxmvvm:CurrentWindowService />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=IsVisible, ElementName=WaitImage, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Название">
                <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (укр)">
                <dxe:TextEdit EditValue="{Binding Path=Model.NameUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (англ)">
                <dxe:TextEdit EditValue="{Binding Path=Model.NameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Область НП">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=NpAreas, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.NpAreaRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ShowEditorButtons="True"
                                  NullValueButtonPlacement="EditBox"
                                  DisplayMember="Name"
                                  ValueMember="Ref">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Область МЭ">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=MeAreas, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.MeAreaRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ShowEditorButtons="True"
                                  NullValueButtonPlacement="EditBox"
                                  DisplayMember="DescriptionRu"
                                  ValueMember="Ref">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Область УП">
                <dxe:ComboBoxEdit EditValue="{Binding Model.UpAreaIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ItemsSource="{Binding Path=UpAreas, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  ValueMember="Id"
                                  DisplayMember="NameUkr"
                                  IsReadOnly="False"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Активная">
                <dxe:CheckEdit EditValue="{Binding Path=Model.Active, Mode=TwoWay}"
                               IsReadOnly="False"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         Mode="OneWay"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>