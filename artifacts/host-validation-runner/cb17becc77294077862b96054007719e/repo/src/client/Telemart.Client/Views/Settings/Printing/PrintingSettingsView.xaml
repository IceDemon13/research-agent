<UserControl x:Class="Telemart.Client.Views.Settings.Printing.PrintingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Settings.Printing"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             DataContext="{client:Container Type=viewModels:PrintingSettingsViewModel}"
             Width="630"
             Height="750"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:PrintingSettingsViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="SettingsGroupBoxViewStyle"
                           TargetType="dxlc:GroupBox">
                        <Setter Property="TitleVisibility"
                                Value="Visible" />
                        <Setter Property="BorderThickness"
                                Value="1" />
                        <Setter Property="Padding"
                                Value="8,8,8,8" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               FontWeight="DemiBold" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="SettingsLayoutGroupStyle"
                           TargetType="dxlc:LayoutGroup">
                        <Setter Property="ItemSpace"
                                Value="8" />
                        <Setter Property="View"
                                Value="GroupBox" />
                        <Setter Property="Orientation"
                                Value="Vertical" />
                        <Setter Property="GroupBoxStyle"
                                Value="{StaticResource SettingsGroupBoxViewStyle}" />
                    </Style>
                    <Style TargetType="{x:Type dxe:ComboBoxEdit}">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="EditBox" />
                        <Setter Property="NullText"
                                Value="{StaticResource NullTextValue}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:FolderBrowserDialogService Description="Выберите папку"
                                           StartPath="{Binding FilesPath}"
                                           RestorePreviouslySelectedDirectory="True" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=WaitImage}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxlc:LayoutGroup x:Name="PrintingTab"
                                  Header="Печать"
                                  Orientation="Vertical"
                                  Padding="10">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="{dx:DXImage Image=Print_16x16.png}" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup Orientation="Horizontal">
                        <dxlc:LayoutItem Label="Тема">
                            <dxe:ComboBoxEdit EditValue="{Binding Path=ThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          ItemsSource="{Binding Themes}"
                                          ValueMember="Ref"
                                          DisplayMember="DisplayValue"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding PrintingSettings, Mode=OneWay}"
                                     SelectionMode="Row">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Type.Name"
                                            Header="Документ" />
                            <dxg:GridColumn FieldName="Printer"
                                            Header="Принтер"
                                            AllowEditing="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.Printers, Mode=OneWay, ElementName=LayoutControl}"
                                                          DisplayMember="Name" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PaperSource"
                                            Header="Лоток"
                                            AllowEditing="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding Path=RowData.Row.Printer.PaperSources, Mode=OneWay}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                                           EnableImmediatePosting="True"
                                           AllowSorting="False"
                                           EditorShowMode="MouseDownFocused"
                                           AllowCommitOnValidationAttributeError="True" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                    <dxlc:LayoutGroup Header="Параметры"
                                      Style="{StaticResource SettingsLayoutGroupStyle}">
                        <dxlc:LayoutItem Label="Формат РН">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=InvoiceFormats, Mode=OneWay}"
                                              EditValue="{Binding Path=SelectedInvoiceFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              NullValueButtonPlacement="None"
                                              DisplayMember="Name"
                                              ValueMember="Id" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Формат чека">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=ChequeFormats, Mode=OneWay}"
                                              EditValue="{Binding Path=SelectedChequeFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              NullValueButtonPlacement="None"
                                              ValueMember="Id" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Формат ШК">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=BarcodeFormats, Mode=OneWay}"
                                              EditValue="{Binding Path=SelectedBarcodeFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              NullValueButtonPlacement="None"
                                              DisplayMember="Name"
                                              ValueMember="Id" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Формат гар. талона">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=WarrantyFormats, Mode=OneWay}"
                                              EditValue="{Binding Path=SelectedWarrantyFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              NullValueButtonPlacement="None"
                                              DisplayMember="Name"
                                              ValueMember="Id" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:CheckEdit Content="Авт. печать ШК B2B и SN B2B после заверш. тест. сборки"
                                           IsThreeState="False"
                                           HorizontalContentAlignment="Left"
                                           EditValue="{Binding Path=AllowPrintBarcodeAssemblyProduct, Mode=TwoWay}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:CheckEdit Content="Отображать окно выбора способа отправки чека"
                                           IsThreeState="False"
                                           HorizontalContentAlignment="Left"
                                           EditValue="{Binding Path=AllowShowChoosePrintRroCheck, Mode=TwoWay}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="EquipmentTab"
                                  Header="Оборудование"
                                  Orientation="Vertical"
                                  Padding="10">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="{dx:DXImage Image=Technology_16x16.png}" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutGroup Header="РРО"
                                          Style="{StaticResource SettingsLayoutGroupStyle}"
                                          ItemSpace="0">
                            <dxlc:LayoutGroup.GroupBoxStyle>
                                <Style TargetType="dxlc:GroupBox"
                                       BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                    <Setter Property="Padding"
                                            Value="8" />
                                    <Setter Property="BorderThickness"
                                            Value="1" />
                                </Style>
                            </dxlc:LayoutGroup.GroupBoxStyle>
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxb:ToolBarControl GlyphSize="Small"
                                                BarItemDisplayMode="Default"
                                                AllowCustomizationMenu="False"
                                                AllowQuickCustomization="False">
                                    <dxb:BarButtonItem Content="Добавить"
                                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                       Command="{Binding Path=AddFiscalRegistrarSettingRroCommand, Mode=OneWay}" />
                                    <dxb:BarButtonItem Content="Изменить IP-адрес"
                                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                       Command="{Binding Path=ChangeIpAddressFiscalRegistrarSettingCommand, Mode=OneWay}"
                                                       CommandParameter="{Binding Path=CurrentItem, ElementName=GridControlRro}" />
                                    <dxb:BarButtonItem Content="Удалить"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                       Command="{Binding Path=RemoveFiscalRegistrarSettingRroCommand, Mode=OneWay}"
                                                       CommandParameter="{Binding Path=CurrentItem, ElementName=GridControlRro}" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutGroup>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="GridControlRro"
                                             ItemsSource="{Binding FiscalRegistrarSettingRroItems, Mode=OneWay }"
                                             SelectedItem="{Binding SelectedRroSettingsItem, Mode=TwoWay}"
                                             ShowBorder="False"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             SelectionMode="None">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Способ подключения"
                                                    FieldName="FiscalConnectionTypeId"
                                                    HeaderToolTip="Способ подключения"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    FixedWidth="False"
                                                    ReadOnly="True"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=FiscalRegistrarTypes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Касса"
                                                    FieldName="FiscalRegistrarCashboxId"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="True"
                                                    FixedWidth="False"
                                                    ReadOnly="True"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=FiscalRegistrarCashboxes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Юр. лицо"
                                                    FieldName="FiscalRegistrarLegalEntityId"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="True"
                                                    FixedWidth="False"
                                                    ReadOnly="True"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=LegalEntities}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="IP"
                                                    FieldName="FiscalRegistrarIp"
                                                    Width="120"
                                                    MinWidth="80"
                                                    AllowResizing="True"
                                                    FixedWidth="False"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    AllowEditing="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Пользователь"
                                                    FieldName="FiscalRegistrarUser"
                                                    HeaderToolTip="Пользователь"
                                                    Width="120"
                                                    MinWidth="80"
                                                    AllowResizing="True"
                                                    FixedWidth="False"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    AllowEditing="False"/>
                                    <dxg:GridColumn Header="Пароль"
                                                    FieldName="FiscalRegistrarPassword"
                                                    Width="120"
                                                    MinWidth="80"
                                                    AllowResizing="True"
                                                    FixedWidth="False"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    AllowEditing="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:PasswordBoxEditSettings />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="A"
                                                    FieldName="Selected"
                                                    FixedWidth="True"
                                                    AllowResizing="False"
                                                    Width="30"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    AllowEditing="True">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <RadioButton IsChecked="{Binding RowData.Row.Selected }"
                                                             GroupName="Actives"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"
                                                             ToolTip="{Binding Path=RowData.Row.ToolTipText}"/>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="SessionIsOpen"
                                                    Visible="False"
                                                    ShowInColumnChooser="False"/>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="False"
                                                   ShowTotalSummary="False"
                                                   ShowIndicator="False"
                                                   ShowFixedTotalSummary="False"
                                                   ShowAutoFilterRow="False"
                                                   ShowSearchPanelMode="Never"
                                                   ShowGroupPanel="False"
                                                   IsColumnMenuEnabled="False"
                                                   ShowColumnHeaders="True"
                                                   AutoWidth="True"
                                                   NavigationStyle="Row"
                                                   AllowResizing="True"
                                                   AllowEditing="False"
                                                   AllowGrouping="False"
                                                   AllowColumnMoving="False"
                                                   AllowColumnFiltering="False"
                                                   AllowSorting="True"
                                                   AllowMoveColumnToDropArea="False"
                                                   CustomCellAppearance="TableView_OnCustomCellAppearance"
                                                   CustomRowAppearance="TableView_OnCustomRowAppearance">
                                        <dxg:TableView.FormatConditions>
                                            <dxg:FormatCondition Expression="[SessionIsOpen] = True" ApplyToRow="True">
                                                <dx:Format Background="PaleGreen"
                                                           Foreground="Black"/>
                                            </dxg:FormatCondition>
                                        </dxg:TableView.FormatConditions>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Orientation="Horizontal">
                            <dx:SimpleButton HorizontalAlignment="Right"
                                             Content="Тест"
                                             Command="{Binding Path=TestFiscalRegistrarCommand, Mode=OneWay}" />
                            <dx:SimpleButton HorizontalAlignment="Right"
                                             Content="Синхронизация"
                                             Command="{Binding Path=SyncFiscalRegistrarCommand, Mode=OneWay}" />
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutGroup Header="POS терминалы"
                                          Style="{StaticResource SettingsLayoutGroupStyle}"
                                          ItemSpace="0">
                            <dxlc:LayoutGroup.GroupBoxStyle>
                                <Style TargetType="dxlc:GroupBox"
                                       BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                    <Setter Property="Padding"
                                            Value="8" />
                                    <Setter Property="BorderThickness"
                                            Value="1" />
                                </Style>
                            </dxlc:LayoutGroup.GroupBoxStyle>
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxb:ToolBarControl GlyphSize="Small"
                                                    BarItemDisplayMode="Default"
                                                    AllowCustomizationMenu="False"
                                                    AllowQuickCustomization="False">
                                    <dxb:BarButtonItem Content="Добавить"
                                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                       Command="{Binding Path=AddSettingPosCommand, Mode=OneWay}" />
                                    <dxb:BarButtonItem Content="Изменить IP-адрес"
                                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                       Command="{Binding Path=ChangeIpAddressPosSettingCommand, Mode=OneWay}"
                                                       CommandParameter="{Binding Path=CurrentItem, ElementName=GridControlPos}" />
                                    <dxb:BarButtonItem Content="Удалить"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                       Command="{Binding Path=RemoveSettingPosCommand, Mode=OneWay}"
                                                       CommandParameter="{Binding Path=CurrentItem, ElementName=GridControlPos}" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutGroup>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="GridControlPos"
                                             ItemsSource="{Binding SettingPosItems, Mode=OneWay}"
                                             SelectedItem="{Binding SelectedPosSettingsItem, Mode=TwoWay}"
                                             ShowBorder="False"
                                             SelectionMode="None"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Тип"
                                                    FieldName="PosTypeId"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="False"
                                                    FixedWidth="False"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=PosTypes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Касса"
                                                    FieldName="PosCashboxId"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="False"
                                                    FixedWidth="False"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=PosCashboxes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Юр.лицо"
                                                    FieldName="PosLegalEntityId"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="False"
                                                    FixedWidth="False"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Left">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=LegalEntities,Mode=OneWay}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue"
                                                                      HorizontalContentAlignment="Left"
                                                                      NullText="не заполнено">
                                            </dxe:ComboBoxEditSettings>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="IP"
                                                    FieldName="IpAddress"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="False"
                                                    FixedWidth="False"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Мерчант"
                                                    FieldName="Merchant"
                                                    Width="120"
                                                    MinWidth="90"
                                                    AllowResizing="False"
                                                    FixedWidth="False"
                                                    AllowEditing="False"
                                                    HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="False"
                                                   ShowTotalSummary="False"
                                                   ShowIndicator="False"
                                                   ShowFixedTotalSummary="False"
                                                   ShowAutoFilterRow="False"
                                                   ShowSearchPanelMode="Never"
                                                   ShowGroupPanel="False"
                                                   IsColumnMenuEnabled="False"
                                                   ShowColumnHeaders="True"
                                                   AutoWidth="True"
                                                   NavigationStyle="Row"
                                                   AllowResizing="True"
                                                   AllowEditing="False"
                                                   AllowGrouping="False"
                                                   AllowColumnMoving="False"
                                                   AllowColumnFiltering="False"
                                                   AllowSorting="True"
                                                   AllowMoveColumnToDropArea="False"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dx:SimpleButton HorizontalAlignment="Right"
                                         Content="Тест"
                                         Command="{Binding Path=TestTerminalCommand, Mode=OneWay}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="ServiceTab"
                                  Header="Служебные"
                                  Orientation="Vertical"
                                  Padding="10">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../../Images/Common/plugin_add.png" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup Style="{StaticResource SettingsLayoutGroupStyle}"
                                      Header="Логгирование">
                        <dxlc:LayoutGroup Orientation="Vertical">
                            <dx:SimpleButton HorizontalAlignment="Left"
                                             Content="Отправить логи"
                                             ToolTip="Логи отправляются в telegram бота, ответственному сотруднику"
                                             Command="{Binding Path=SendLogsCommand, Mode=OneWay}" />
                            <dxlc:LayoutGroup Header="Справка"
                                          View="GroupBox"
                                          Margin="-1">
                                <TextBlock TextWrapping="Wrap"
                                       VerticalAlignment="Bottom">
                                Логи отправляются ответственному сотруднику для поиска ошибок в работе программы Telemart.Client. НЕ используйте данный инстумент, если точно не уверены что ошибка именно в программе Telemart.Client.
                                </TextBlock>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Style="{StaticResource SettingsLayoutGroupStyle}"
                                      Header="Макеты">
                        <dxlc:LayoutGroup Orientation="Vertical">
                            <dx:SimpleButton HorizontalAlignment="Left"
                                                 Content="Очистить макеты"
                                                 ToolTip="Очистить макеты"
                                                 Command="{Binding Path=ClearLayoutsCommand, Mode=OneWay}" />
                            <dxlc:LayoutGroup Header="Справка"
                                                  View="GroupBox"
                                                  Margin="-1">
                                <TextBlock TextWrapping="Wrap"
                                               VerticalAlignment="Bottom">
                                        Макеты содержат в себе всю информацию о ширине форм, таблиц, отображаемых колонках. Если Вы не понимаете что это значит, НЕ очищайте макеты.
                                </TextBlock>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Style="{StaticResource SettingsLayoutGroupStyle}"
                                      Header="Кеширование">
                        <dxlc:LayoutGroup Orientation="Vertical">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dx:SimpleButton HorizontalAlignment="Left"
                                                 Content="Обновить кеш"
                                                 ToolTip="Обновить кеш"
                                                 Command="{Binding Path=UpdateCacheCommand, Mode=OneWay}" />
                                <dx:SimpleButton HorizontalAlignment="Left"
                                                 Content="Перезагрузить кеш"
                                                 ToolTip="Перезагрузить кеш"
                                                 Command="{Binding Path=ResetCacheCommand, Mode=OneWay}" />
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup Header="Справка"
                                              View="GroupBox"
                                              Margin="-1">
                                <TextBlock TextWrapping="Wrap"
                                           VerticalAlignment="Bottom">
Кеширование - это набор часто используемых данных Telemart.Client , подгруженный в оперативную память вашего компьютера для повышения производительности работы в программе. Иногда эти данные устаревают и их приходиться обновить. Обновляйте кеш ТОЛЬКО в том случае, когда вы точно уверены в необходимости этого действия.
<LineBreak/>Обновить кеш - это загрузка актуальных данных в кеш.
<LineBreak/>Перезагрузить кеш - это удаление всех данных из кеша и повторная их загрузка (может занять длительное время)
                                </TextBlock>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Style="{StaticResource SettingsLayoutGroupStyle}"
                                      Header="Параметры">
                        <dxlc:LayoutItem Label="Блокировка">
                            <dxe:TextEdit EditValue="{Binding Path=LockTimeout, Mode=TwoWay, ValidatesOnExceptions=True, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                          AllowNullInput="True"
                                          Mask="hh\:mm\:ss"
                                          MaskUseAsDisplayFormat="True"
                                          ValidateOnTextInput="True"
                                          MaskType="TimeSpan"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Путь к файлам">
                            <dxe:ButtonEdit EditValue="{Binding Path=FilesPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            IsReadOnly="True">
                                <dxe:ButtonInfo GlyphKind="Cancel"
                                                Command="{Binding DeleteFilesPathCommand}"/>
                                <dxe:ButtonInfo GlyphKind="Regular"
                                                ToolTipService.ToolTip="Выбрать папку"
                                                Command="{Binding Path=SelectFilesPathCommand, Mode=OneWay}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                              HorizontalAlignment="Left">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                         Mode="OneWay" />
                            <Binding Path="TestFiscalRegistrarCommand.IsExecuting"
                                         Mode="OneWay" />
                            <Binding Path="TestTerminalCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dx:SimpleButton x:Name="OkButton"
                                     Content="OK"
                                     HorizontalAlignment="Right"
                                     Command="{Binding Path=OkCommand, Mode=OneWay}"
                                     IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <dx:SimpleButton Content="Отмена"
                                     HorizontalAlignment="Right"
                                     Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>