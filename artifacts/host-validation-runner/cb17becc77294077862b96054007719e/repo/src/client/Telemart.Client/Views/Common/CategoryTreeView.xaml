<UserControl x:Name="CurrentUserControl"
             x:Class="Telemart.Client.Views.Common.CategoryTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:local="clr-namespace:Telemart.Client.Views.Common"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=local:CategoryTreeView, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <converters:CategoryViewItemsSelectedItemsConverter x:Key="CategoryViewItemsSelectedItemsConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=CurrentUserControl, Mode=OneWay}">
        <dxg:GridControl x:Name="GridControl"
                         ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                         CurrentItem="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectedItems="{Binding Path=SelectedCategories, Mode=TwoWay, Converter={StaticResource CategoryViewItemsSelectedItemsConverter}}"
                         SelectionMode="{Binding Path=SelectionMode, Mode=OneWay}"
                         ShowBorder="{Binding Path=ShowBorder, Mode=OneWay}"
                         ShowLoadingPanel="{Binding Path=ShowLoadingPanel, Mode=OneWay}"
                         FilterString="{Binding Path=FilterString, Mode=OneWay}"
                         IsEnabled="{Binding Path=IsTreeEnabled , Mode=OneWay}"
                         CurrentItemChanged="GridControlOnCurrentItemChanged"
                         ItemsSourceChanged="GridControlOnItemsSourceChanged">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="{Binding Path=DisplayMember, Mode=OneWay}"
                                VisibleIndex="0"
                                SortIndex="1"
                                SortOrder="Ascending" />
                <dxg:GridColumn FieldName="Position"
                                Visible="False"
                                VisibleIndex="1"
                                SortIndex="0"
                                SortOrder="Ascending" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TreeListView x:Name="TreeListView"
                                  AutoExpandAllNodes="{Binding Path=AutoExpandAllNodes, Mode=OneWay}"
                                  ShowSearchPanelMode="{Binding Path=ShowSearchPanelMode, Mode=OneWay}"
                                  TreeDerivationMode="Selfreference"
                                  KeyFieldName="Id"
                                  ParentFieldName="ParentId"
                                  ShowColumnHeaders="False"
                                  NavigationStyle="Row"
                                  FilterMode="Extended"
                                  SearchPanelHighlightResults="True"
                                  ExpandNodesOnFiltering="True"
                                  AllowEditing="False"
                                  AllowBestFit="True"
                                  AllowSorting="False"
                                  AllowDrop="False"
                                  ShowVerticalLines="False"
                                  ShowHorizontalLines="False"
                                  ShowIndicator="False"
                                  TreeLineStyle="Solid"
                                  AutoWidth="True"
                                  ShowExpandButtons="True"
                                  ShowFilterPanelMode="Never"
                                  UseEvenRowBackground="False"
                                  Loaded="TreeListViewOnLoaded"
                                  PreviewKeyDown="TreeListViewOnPreviewKeyDown">
                    <dxg:TreeListView.FormatConditions>
                        <dxg:FormatCondition Expression="[IsParent] = FALSE AND [IsBrand] = False">
                            <dx:Format FontStyle="Italic" />
                        </dxg:FormatCondition>
                        <dxg:FormatCondition Expression="[Active] &lt; 1">
                            <dx:Format Foreground="DarkGray" />
                        </dxg:FormatCondition>
                        <dxg:FormatCondition Expression="[Active] = 0">
                            <dx:Format TextDecorations="Strikethrough" />
                        </dxg:FormatCondition>
                    </dxg:TreeListView.FormatConditions>
                </dxg:TreeListView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>

</UserControl>
