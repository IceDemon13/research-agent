<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.ProductsSelectionView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type={x:Type viewModels:ProductsSelectionViewModel}}"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductsSelectionViewModel}}"
                              d:DesignHeight="480"
                              d:DesignWidth="640">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical">
        <dxlc:LayoutGroup Orientation="Vertical">
            <dxg:GridControl ItemsSource="{Binding Path=Items}"
                             SelectedItems="{Binding Path=SelectedItems}"
                             SelectionMode="Row">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Код"
                                    HeaderToolTip="Код товара"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="Id"
                                    AllowResizing="True"
                                    AllowBestFit="False"
                                    FixedWidth="True"
                                    MinWidth="24"
                                    Width="60"
                                    AllowMoving="False"
                                    AllowColumnFiltering="False"
                                    AllowEditing="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Товар"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    FieldName="FullName"
                                    AllowResizing="True"
                                    AllowBestFit="True"
                                    FixedWidth="False"
                                    MinWidth="24"
                                    AllowMoving="False"
                                    AllowColumnFiltering="False"
                                    AllowEditing="False">
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView ShowCheckBoxSelectorColumn="True"
                                   CheckBoxSelectorColumnWidth="24"
                                   NavigationStyle="Row"
                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Bottom">
            <dxe:CheckEdit Content="Печатать отдельные ГТ"
                           EditValue="{Binding Path=SeparateWarrantyCards, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneWay}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</controls:TelemartUserControl>
