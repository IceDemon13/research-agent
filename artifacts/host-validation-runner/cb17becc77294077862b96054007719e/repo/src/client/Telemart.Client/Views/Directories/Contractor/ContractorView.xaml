<controls:TelemartUserControl x:Class="Telemart.Client.Views.Directories.Contractor.ContractorView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Contractor"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              DataContext="{client:Container Type=viewModels:ContractorViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ContractorViewModel}}">
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="TextEditReadOnlyStyle"
                           TargetType="dxe:TextEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ComboBoxEditReadOnlyStyle"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="NullValueButtonPlacement"
                                        Value="EditBox" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="NotNullComboBoxEditReadOnlyStyle"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="AllowNullInput"
                                Value="False" />
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="LookUpEditReadOnlyStyle"
                           TargetType="dxg:LookUpEdit">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Setter Property="NullValueButtonPlacement"
                                        Value="EditBox" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SpinEditReadOnlyStyle"
                           TargetType="dxe:SpinEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsNew"
                                                 Mode="OneWay" />
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="NullValueButtonPlacement"
                                        Value="EditBox" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="LayoutGroupReadOnlyStyle"
                           TargetType="dxlc:LayoutGroup">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=IsVisible, ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            ScrollBars="None"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              SelectedTabIndex="{Binding Path=SelectedTabIndex, Mode=TwoWay}"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="SelectedTabChildChanged"
                                           Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
                <dxlc:LayoutGroup x:Name="InfoTab"
                                  Header="Инфо"
                                  Orientation="Horizontal"
                                  Padding="10">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="/Images/Contractor/information.png" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=GeneralInfoRoot, Converter={StaticResource BooleanToColorConverter}}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup x:Name="GeneralInfoRoot"
                                      Orientation="Vertical"
                                      dxe:ValidationService.IsValidationContainer="True">
                        <dxlc:LayoutItem Label="Родитель">
                            <dxg:LookUpEdit ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                            EditValue="{Binding Path=Model.ParentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            DisplayMember="Name"
                                            ValueMember="Id"
                                            AutoPopulateColumns="False"
                                            AutoComplete="False"
                                            IncrementalFiltering="True"
                                            FilterCondition="Like"
                                            FindMode="Always"
                                            ImmediatePopup="True"
                                            IsPopupAutoWidth="True"
                                            Style="{StaticResource LookUpEditReadOnlyStyle}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:FocusBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:SearchLookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl">
                                            <dxg:GridControl.Resources>
                                                <Style TargetType="dxg:GridColumn"
                                                       BasedOn="{StaticResource GeneralGridColumnStyle}"></Style>
                                            </dxg:GridControl.Resources>
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="Name"
                                                                Header="Папка"
                                                                AllowResizing="False"
                                                                FixedWidth="False" />
                                            </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView AutoWidth="True"
                                                                  AutoExpandAllNodes="True"
                                                                  KeyFieldName="Id"
                                                                  ParentFieldName="ParentId"
                                                                  ShowIndicator="False"
                                                                  UseEvenRowBackground="True"
                                                                  AlternationCount="2"
                                                                  AlternateRowBackground="{StaticResource AlternateRowBackgroundBrush}" />
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Форма">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=OwnershipForms, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.OwnershipFormId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              IsTextEditable="True"
                                              ImmediatePopup="True"
                                              IncrementalFiltering="True"
                                              ValidateOnTextInput="False"
                                              Style="{StaticResource ComboBoxEditReadOnlyStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Название">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static viewModels:ContractorConstants.NameMaxLength}"
                                          Style="{StaticResource TextEditReadOnlyStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Полное название">
                            <dxe:TextEdit EditValue="{Binding Path=FullName, Mode=OneWay, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource ReadOnlyEditorStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Страна">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Countries, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.CountryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ValueMember="Id"
                                              IsTextEditable="True"
                                              ImmediatePopup="True"
                                              IncrementalFiltering="True"
                                              ValidateOnTextInput="False"
                                              Style="{StaticResource ComboBoxEditReadOnlyStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Город">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ValueMember="Id"
                                              IsTextEditable="True"
                                              ImmediatePopup="True"
                                              IncrementalFiltering="True"
                                              ValidateOnTextInput="False"
                                              Style="{StaticResource ComboBoxEditReadOnlyStyle}" >
                                <dxe:ComboBoxEdit.Buttons>
                                    <dxe:ButtonInfo GlyphKind="Plus"
                                                    IsEnabled="True"
                                                    Command="{Binding Path=DataContext.CreateForeignCityCommand, ElementName=LayoutControl}"/>
                                </dxe:ComboBoxEdit.Buttons>
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Юр. адрес">
                            <dxe:TextEdit EditValue="{Binding Path=Model.LegalAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource TextEditReadOnlyStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Факт. адрес">
                            <dxe:TextEdit EditValue="{Binding Path=Model.ActualAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Style="{StaticResource TextEditReadOnlyStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Подразделение">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.Subdivision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              ItemTemplate="{StaticResource SubdivisionComboBoxItemTemplate}">
                                <dxe:ComboBoxEdit.Style>
                                    <Style TargetType="dxe:ComboBoxEdit">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                        <Setter Property="AllowDefaultButton"
                                                Value="False" />
                                        <Setter Property="NullValueButtonPlacement"
                                                Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsNew, Mode=OneWay}"
                                                         Value="True">
                                                <Setter Property="Opacity"
                                                        Value="{StaticResource EnabledElementOpacity}" />
                                                <Setter Property="AllowDefaultButton"
                                                        Value="True" />
                                                <Setter Property="NullValueButtonPlacement"
                                                        Value="EditBox" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Mode="OneWay"
                                                                  Converter="{converters:BooleanAndMultiValueConverter}">
                                                        <Binding Path="IsLockedByCurrentEmployee"
                                                                 Mode="OneWay" />
                                                        <Binding Path="Model.IsFolder"
                                                                 Mode="OneWay" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Opacity"
                                                        Value="{StaticResource EnabledElementOpacity}" />
                                                <Setter Property="AllowDefaultButton"
                                                        Value="True" />
                                                <Setter Property="NullValueButtonPlacement"
                                                        Value="EditBox" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxe:ComboBoxEdit.Style>
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Менеджер">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.Employee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              FilterCondition="Contains"
                                              IsTextEditable="True"
                                              ImmediatePopup="True"
                                              IncrementalFiltering="True"
                                              ValidateOnTextInput="False"
                                              Style="{StaticResource ComboBoxEditReadOnlyStyle}"></dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutGroup Orientation="Vertical"
                                          Visibility="{Binding Path=Model.IsFolder, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                            <dxlc:LayoutItem Label="Сайт">
                                <dxe:TextEdit EditValue="{Binding Path=Model.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource TextEditReadOnlyStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="ЕДРПОУ">
                                <dxe:TextEdit EditValue="{Binding Path=Model.Edrpou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MaskType="RegEx"
                                              Mask="\d+"
                                              MaskUseAsDisplayFormat="True"
                                              Style="{StaticResource TextEditReadOnlyStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="ИНН">
                                <dxe:TextEdit EditValue="{Binding Path=Model.Tin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MaskType="RegEx"
                                              Mask="\d{1,12}"
                                              MaskUseAsDisplayFormat="True"
                                              Style="{StaticResource TextEditReadOnlyStyle}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutItem Label="Комментарий"
                                         LabelVerticalAlignment="Top"
                                         VerticalAlignment="Stretch">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaxLength="{x:Static viewModels:ContractorConstants.CommentMaxLength}"
                                          TextWrapping="Wrap"
                                          AcceptsReturn="True"
                                          AcceptsTab="True"
                                          VerticalContentAlignment="Top"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource TextEditReadOnlyStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Физ. лицо">
                            <dxe:CheckEdit EditValue="{Binding Path=Model.IsIndividual, Mode=TwoWay}"
                                           IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                           Style="{StaticResource  ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Статус">
                            <dxlc:LayoutGroup Orientation="Horizontal"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource LayoutGroupReadOnlyStyle}">
                                <RadioButton Content="Активен"
                                             IsChecked="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                <RadioButton Content="Не активен"
                                             IsChecked="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                             VerticalAlignment="Center" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="SettingsTab"
                                  Header="Настройки"
                                  Orientation="Horizontal"
                                  Padding="10">
                    <dxlc:LayoutGroup.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="{dx:DXImage Image=Properties_16x16.png}" />
                                <TextBlock Text="{Binding Mode=OneWay}"
                                           Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=SettingsRoot, Converter={StaticResource BooleanToColorConverter}}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutGroup.HeaderTemplate>
                    <dxlc:LayoutGroup Orientation="Vertical">
                          <dxlc:LayoutGroup x:Name="SettingsRoot"
                                      Orientation="Horizontal"
                                      IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}"
                                      dxe:ValidationService.IsValidationContainer="True">
                        <dxlc:LayoutGroup.Resources>
                            <Style TargetType="dxlc:GroupBox"
                                   BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                                <Setter Property="Padding"
                                        Value="10" />
                                <Setter Property="BorderThickness"
                                        Value="1" />
                            </Style>
                        </dxlc:LayoutGroup.Resources>
                        <dxlc:LayoutGroup Header="Покупатель"
                                          View="GroupBox"
                                          Orientation="Vertical"
                                          VerticalAlignment="Stretch">
                            <dxlc:LayoutItem Label="Цена">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=PriceTypes, Mode=OneWay}"
                                                  EditValue="{Binding Path=Model.PriceTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="Name"
                                                  ValueMember="Id"
                                                  Style="{StaticResource NotNullComboBoxEditReadOnlyStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Тип">
                                <dxe:ComboBoxEdit EditValue="{Binding Path=Model.IsRetail, Mode=OneWay}"
                                                  AllowDefaultButton="False"
                                                  IsReadOnly="True"
                                                  Opacity="{StaticResource DisabledElementOpacity}">
                                    <dxe:ComboBoxEdit.Items>
                                        <dxe:CustomItem DisplayText="Розничный"
                                                        EditValue="{StaticResource TrueValue}" />
                                        <dxe:CustomItem DisplayText="Оптовый"
                                                        EditValue="{StaticResource FalseValue}" />
                                    </dxe:ComboBoxEdit.Items>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Отсрочка">
                                <dxe:SpinEdit EditValue="{Binding Path=Model.Limit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              EditValueType="{x:Type system:Int32}"
                                              HorizontalContentAlignment="Left"
                                              MaskType="Numeric"
                                              Mask="C0"
                                              MaskCulture="{x:Static business:CurrencyFormatingRules.UsdCultureInfo}"
                                              MinValue="0"
                                              MaxValue="1000000"
                                              AllowDefaultButton="False"
                                              AllowNullInput="True"
                                              NullText="Запрещена"
                                              Style="{StaticResource SpinEditReadOnlyStyle}"
                                              MaskUseAsDisplayFormat="True">
                                    <dxe:SpinEdit.NullValue>
                                        <system:Int32>0</system:Int32>
                                    </dxe:SpinEdit.NullValue>
                                </dxe:SpinEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Гарантия">
                                <dxe:ComboBoxEdit EditValue="{Binding Path=Model.RetailWarranty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  Style="{StaticResource NotNullComboBoxEditReadOnlyStyle}">
                                    <dxe:ComboBoxEdit.Items>
                                        <dxe:CustomItem DisplayText="Розница"
                                                        EditValue="{StaticResource TrueValue}" />
                                        <dxe:CustomItem DisplayText="Опт"
                                                        EditValue="{StaticResource FalseValue}" />
                                    </dxe:ComboBoxEdit.Items>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Старый клиент">
                                <dxe:ComboBoxEdit EditValue="{Binding Path=Model.OldClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  Style="{StaticResource NotNullComboBoxEditReadOnlyStyle}">
                                    <dxe:ComboBoxEdit.Items>
                                        <dxe:CustomItem DisplayText="Да"
                                                        EditValue="{StaticResource TrueValue}" />
                                        <dxe:CustomItem DisplayText="Нет"
                                                        EditValue="{StaticResource FalseValue}" />
                                    </dxe:ComboBoxEdit.Items>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Код 1С Бух.">
                                <dxe:TextEdit EditValue="{Binding Path=Model.Buh1CId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
