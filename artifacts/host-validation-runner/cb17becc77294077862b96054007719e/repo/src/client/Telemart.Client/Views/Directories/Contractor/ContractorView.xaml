                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Visibility="{Binding Path=IsHelpVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                              View="GroupBox"
                              GroupBoxStyle="{StaticResource GroupBoxFrameStyle}">
                <TextBlock TextWrapping="Wrap"
                           VerticalAlignment="Bottom">
                    <Span FontWeight="Bold"
                          Foreground="Red">Важно!</Span> Данные в этой вкладке сохраняются автоматически без нажатия кнопок <Span FontWeight="Bold">ОК</Span> и <Span FontWeight="Bold">Сохранить</Span></TextBlock>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Создать Telegram"
                            ToolTip="Создание группы с контрагентом и ботом"
                            Command="{Binding Path=CreateTelegramChatCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/comment.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <StackPanel.Visibility>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="Model.EmployeeLockId"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:ObjectToBooleanConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Заблокировано пользователем: "
                                   Foreground="Red" />
                        <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay}" />
                    </StackPanel>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="GeneralInfoRoot" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="SettingsRoot" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="ContactsRoot" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="TemplatesRoot" />
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="PurchaseRoot" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:FocusBehavior SourceName="LayoutControl"
                                                  PropertyName="IsVisible" />
                        </dxmvvm:Interaction.Behaviors>
                    </Button>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>