<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Invoice.InvoiceCurrencyRatesView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Invoice"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              DataContext="{client:Container Type=viewModels:InvoiceCurrencyRatesViewModel}"
                              Width="320"
                              Height="190"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:InvoiceCurrencyRatesViewModel}, IsDesignTimeCreatable=True}">

    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=IsVisible, ElementName=WaitImage, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=CurrencyRates, Mode=OneWay, ValidatesOnDataErrors=False}"
                             SelectionMode="None"
                             ShowBorder="True"
                             ClipToBounds="True">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                    <behaviors:LayoutSerializationBehavior FileName="invoice_currency_rates.xml" />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Валюта"
                                    HeaderToolTip="Название валюты"
                                    FieldName="Name"
                                    Width="100"
                                    MaxWidth="100"
                                    MinWidth="100"
                                    AllowResizing="False"
                                    AllowEditing="False"
                                    AllowColumnFiltering="False"
                                    AllowMoving="False"
                                    AllowBestFit="True"
                                    AllowSorting="True"
                                    HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Курс"
                                    HeaderToolTip="Курс валюты"
                                    AllowSorting="True"
                                    AllowColumnFiltering="False"
                                    AllowMoving="False"
                                    AllowEditing="True"
                                    FieldName="ConversionRate"
                                    MaxWidth="70"
                                    Width="70"
                                    MinWidth="70"
                                    HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                  MaskType="Numeric"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="TableView"
                                   EditorShowMode="MouseDown"
                                   AutoWidth="True"
                                   AllowGrouping="False"
                                   AllowFilterEditor="False"
                                   AllowSorting="True"
                                   AllowBestFit="False"
                                   AllowPrintDetails="True"
                                   AllowResizing="True"
                                   ShowAutoFilterRow="False"
                                   AllowMasterDetail="False"
                                   ShowGroupPanel="False"
                                   ShowIndicator="False"
                                   NavigationStyle="Cell"
                                   IsColumnMenuEnabled="False"
                                   IsColumnChooserVisible="False">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="Сохранить"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>