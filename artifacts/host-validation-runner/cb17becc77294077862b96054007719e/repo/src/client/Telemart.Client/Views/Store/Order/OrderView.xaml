                                            <dx:DXImage Margin="2 0 1 0"
                                                        Source="../../../Images/Common/book_addresses.png" />
                                        </dxe:ButtonInfo.Content>
                                    </dxe:ButtonInfo>
                                    <dxe:ButtonInfo GlyphKind="Custom"
                                                    ToolTip="Клиент"
                                                    Command="{Binding OpenCustomerCommand}"
                                                    Visibility="{Binding Path=OpenCustomerVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                        <dxe:ButtonInfo.Content>
                                            <dx:DXImage Margin="2 0 1 0"
                                                        Source="../../../Images/NavigationMenu/users_4.png" />
                                        </dxe:ButtonInfo.Content>
                                    </dxe:ButtonInfo>
                                </dxe:ButtonEdit>
