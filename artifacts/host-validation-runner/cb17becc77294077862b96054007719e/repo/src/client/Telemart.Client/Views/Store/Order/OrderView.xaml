<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.OrderView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:productInformation="clr-namespace:Telemart.Client.Views.Store.Order.ProductInformation"
                              xmlns:complaint="clr-namespace:Telemart.Client.Views.Complaint"
                              xmlns:mvvmEnhancements="clr-namespace:Telemart.Client.Common.MvvmEnhancements"
                              xmlns:controls1="clr-namespace:Telemart.Client.Controls"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderViewModel}}">
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ProductPriceKind.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CallState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Payment.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderProductSource.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Refund/RefundState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderProductStatus.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/BonusType.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/AdditionalServiceProductState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/AssemblyServiceState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <DataTemplate x:Key="OrderProductRowInfoTemplate">
                        <DockPanel>
                            <dxg:NameTextControl NameValue="Товар" TextValue="{Binding Path=ProductName}"
                                                             DockPanel.Dock="Top"/>
                        </DockPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="OrderProductRowsInfoTemplate">
                        <ListBox ItemsSource="{Binding}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <dxg:NameTextControl NameValue="Товар" TextValue="{Binding Path=Key}"
                                                             DockPanel.Dock="Top"/>
                                        <dxg:NameTextControl NameValue="Ошибка"
                                                             DockPanel.Dock="Bottom"
                                                             FontWeight="SemiBold"
                                                             Foreground="DarkRed"
                                                             Background="DarkRed"
                                                             TextValue="{Binding Path=Value, Mode=OneWay}"
                                                             Visibility="{Binding Path=Value, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DataTemplate>
                    <DataTemplate x:Key="DragOrderProductInfoTemplate">
                        <Border Padding="12,8,24,10">
                            <Border.Background>
                                <Binding Path="DropTargetType">
                                    <Binding.Converter>
                                        <dx:EnumToObjectConverter DefaultValue="#FFF0F0F0">

                                        </dx:EnumToObjectConverter>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Background>
                            <Border.BorderBrush>
                                <Binding Path="DropTargetType">
                                    <Binding.Converter>
                                        <dx:EnumToObjectConverter DefaultValue="#FFC8C8C8">

                                        </dx:EnumToObjectConverter>
                                    </Binding.Converter>
                                </Binding>
                            </Border.BorderBrush>
                            <StackPanel>
                                <TextBlock Name="rowCountTextBlock" Foreground="#FF949494" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <Binding Path="DraggingRows.Count" StringFormat="Перемещение {0} строк" />
                                    </TextBlock.Text>
                                    <TextBlock.Visibility>
                                        <Binding Path="DraggingRows.Count">
                                            <Binding.Converter>
                                                <dxg:CountToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Name="oneRowTextBlock" Foreground="#FF949494" FontWeight="Bold"
                                           Text="Перемещение 1 строки:">
                                    <TextBlock.Visibility>
                                        <Binding Path="DraggingRows.Count">
                                            <Binding.Converter>
                                                <dxg:CountToVisibilityConverter Invert="True" />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <ContentPresenter Name="rowInfoDragPresenter" Content="{Binding Path=FirstDraggingObject.ParentOrder.DraggedProductsErrors}"
                                                  ContentTemplate="{StaticResource OrderProductRowsInfoTemplate}">
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="DropOrderProductInfoTemplate">
                        <Border Name="border"
                                CornerRadius="0,0,5,5"
                                Padding="12,8,24,10"
                                BorderThickness="0,1,0,0"
                                Visibility="Visible">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DropTargetType,UpdateSourceTrigger=PropertyChanged}" Value="None">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <Binding Path="DropTargetType">
                                    <Binding.Converter>
                                        <dx:EnumToObjectConverter DefaultValue="#FFF0F0F0">

                                        </dx:EnumToObjectConverter>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Background>
                            <Border.BorderBrush>
                                <Binding Path="DropTargetType">
                                    <Binding.Converter>
                                        <dx:EnumToObjectConverter DefaultValue="#FFC8C8C8">

                                        </dx:EnumToObjectConverter>
                                    </Binding.Converter>
                                </Binding>
                            </Border.BorderBrush>
                            <StackPanel
                                Visibility="Visible">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DropTargetType,UpdateSourceTrigger=PropertyChanged}" Value="None">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Name="dropInfoText" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <Binding Path="DropTargetType">
                                            <Binding.Converter>
                                                <dx:EnumToObjectConverter>
                                                    <dx:EnumToObjectConverter.Values>
                                                        <dx:EnumObjectProvider x:Key="InsertRowsIntoGroup" Value="Переместить в дочернюю сборку:" />
                                                        <dx:EnumObjectProvider x:Key="InsertRowsAfter" Value="Вставить после товара:" />
                                                        <dx:EnumObjectProvider x:Key="InsertRowsBefore" Value="Вставить перед товаром:" />
                                                    </dx:EnumToObjectConverter.Values>
                                                </dx:EnumToObjectConverter>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ContentPresenter Name="rowInfoPresenter" Content="{Binding DropTargetRow}"
                                                  ContentTemplate="{StaticResource OrderProductRowInfoTemplate}">
                                    <ContentPresenter.Visibility>
                                        <Binding Path="DataContext.DropTargetType"
                                                 RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <dx:EnumToObjectConverter DefaultValue="Collapsed">
                                                    <dx:EnumToObjectConverter.Values>
                                                        <dx:EnumObjectProvider x:Key="InsertRowsAfter" Value="Visible" />
                                                        <dx:EnumObjectProvider x:Key="InsertRowsBefore" Value="Visible" />
                                                        <dx:EnumObjectProvider x:Key="InsertRowsIntoNode" Value="Hidden" />
                                                    </dx:EnumToObjectConverter.Values>
                                                </dx:EnumToObjectConverter>
                                            </Binding.Converter>
                                        </Binding>
                                    </ContentPresenter.Visibility>
                                </ContentPresenter>
                                <ItemsControl Name="groupInfoItemsControl" ItemsSource="{Binding GroupInfo}">
                                    <ItemsControl.Visibility>
                                        <Binding Path="DataContext.DropTargetType"
                                                 RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <dx:EnumToObjectConverter DefaultValue="Collapsed">
                                                    <dx:EnumToObjectConverter.Values>
                                                        <dx:EnumObjectProvider x:Key="InsertRowsIntoGroup" Value="Hidden" />
                                                    </dx:EnumToObjectConverter.Values>
                                                </dx:EnumToObjectConverter>
                                            </Binding.Converter>
                                        </Binding>
                                    </ItemsControl.Visibility>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <dxg:NameTextControl x:Name="groupInfoControl"
                                                                 NameValue="{Binding FieldName}"
                                                                 TextValue="{Binding Value}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger
                                Binding="{Binding Source={x:Static interop:BrowserInteropHelper.IsBrowserHosted}}"
                                Value="True"
                                xmlns:interop="clr-namespace:System.Windows.Interop;assembly=PresentationFramework">
                                <Setter Property="CornerRadius" TargetName="border" Value="0,0,0,0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <DataTemplate x:Key="DragOrderProductDataTemplate">
                        <dxg:HintControl>
                            <dxg:HintControl.Template>
                                <ControlTemplate>
                                    <StackPanel Width="500">
                                        <ContentPresenter Name="dragInfo" Content="{Binding}"
                                                          ContentTemplate="{StaticResource DragOrderProductInfoTemplate}"/>
                                        <ContentPresenter Name="dropInfo" Content="{Binding}"
                                                          ContentTemplate="{StaticResource DropOrderProductInfoTemplate}"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </dxg:HintControl.Template>
                        </dxg:HintControl>
                    </DataTemplate>
                    <DataTemplate x:Key="ContractorTemplateBarItemTemplate">
                        <ContentControl>
                            <dxb:BarButtonItem Content="{Binding Path=Name, Mode=OneWay}"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphSize="Small"
                                               Command="{Binding Path=DataContext.ApplyContractorTemplateCommand, Mode=OneWay, ElementName=CurrentUserControl}"
                                               CommandParameter="{Binding Mode=OneWay}"></dxb:BarButtonItem>
                        </ContentControl>
                    </DataTemplate>
                    <Style x:Key="OrderValidatableItemStyle"
                           TargetType="{x:Type Label}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=Valid, Mode=OneWay}"
                                         Value="False">
                                <Setter Property="Foreground"
                                        Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <dxmvvm:ObjectToObjectConverter x:Key="CarryTypeToGetDeliveryDateVisibilityConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="3"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="4"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="12"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="13"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="IsNewOrderToVisibilityConverter"
                                                    DefaultTarget="Visible">
                        <dxmvvm:MapItem Source="0"
                                        Target="Collapsed" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="IsNewOrderToBooleanConverter"
                                                    DefaultTarget="False">
                        <dxmvvm:MapItem Source="0"
                                        Target="True" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="OrderPaymentSignToImageConverter"
                                                    DefaultTarget="{x:Null}">
                        <dxmvvm:MapItem Source="-1"
                                        Target="{StaticResource CoinsDelete16}" />
                        <dxmvvm:MapItem Source="1"
                                        Target="{StaticResource CoinsAdd16}" />
                    </dxmvvm:ObjectToObjectConverter>
                    <SolidColorBrush x:Key="BlackBrush"
                                     Color="Black" />
                    <SolidColorBrush x:Key="RedBrush"
                                     Color="Red" />
                    <SolidColorBrush x:Key="GreenBrush"
                                     Color="Green" />
                    <dxmvvm:ObjectToObjectConverter x:Key="OrderPaymentSignToColorConverter"
                                                    DefaultTarget="{StaticResource BlackBrush}">
                        <dxmvvm:MapItem Source="-1"
                                        Target="{StaticResource RedBrush}" />
                        <dxmvvm:MapItem Source="1"
                                        Target="{StaticResource GreenBrush}" />
                    </dxmvvm:ObjectToObjectConverter>
                    <!--all conditions for disabling or allowing editing are grouped here, except PackageDeliveryCost field, Edit and Ok buttons-->
                    <Style x:Key="DisabledConditionsStyle"
                           TargetType="{x:Type FrameworkElement}">
                        <Setter Property="IsEnabled"
                                Value="{Binding IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay}" />
                    </Style>
                    <Style x:Key="DisabledConditionsContentElementStyle"
                           TargetType="{x:Type FrameworkContentElement}">
                        <Setter Property="IsEnabled"
                                Value="{Binding IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay}" />
                    </Style>
                    <Style x:Key="ReadOnlyGridStyle"
                           TargetType="dxg:GridControl"
                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DataContext.IsLockedByCurrentUserAndEditingAllowed, ElementName=CurrentUserControl, Mode=OneWay}"
                                         Value="False">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="BonusesReadOnlyGridStyle"
                           TargetType="dxg:GridControl"
                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DataContext.IsLockedByCurrentUserAndEditingAllowed, ElementName=CurrentUserControl, Mode=OneWay}"
                                         Value="True">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="OrderReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="{Binding Path=DataContext.IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=CurrentUserControl}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DataContext.IsLockedByCurrentUserAndEditingAllowed, ElementName=CurrentUserControl, Mode=OneWay}"
                                         Value="False">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="MemoEditReadOnlyConditionsStyle"
                           TargetType="{x:Type dxe:MemoEdit}">
                        <Setter Property="IsReadOnly"
                                Value="{Binding IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay}"
                                         Value="False">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="OrderPhoneTextEdit"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource PhoneTextEdit}">
                        <Setter Property="IsReadOnly"
                                Value="{Binding Path=IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay}"
                                         Value="False">
                                <Setter Property="Opacity"
                                        Value="0.6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!--End of conditions-->
                    <Style x:Key="LabelStyle"
                           TargetType="dxlc:LayoutItemLabel"
                           BasedOn="{StaticResource LayoutItemLabelStyle}">
                        <Setter Property="Margin"
                                Value="0 0 0 0" />
                        <Setter Property="MaxWidth"
                                Value="52" />
                    </Style>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin"
                                Value="0" />
                        <Setter Property="Padding"
                                Value="0" />
                    </Style>
                    <Style x:Key="ComboBoxReadOnlyConditionsStyle"
                           TargetType="dxe:ComboBoxEdit"
                           BasedOn="{StaticResource OrderReadOnlyConditionsStyle}">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="EditBox" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsLockedByCurrentUserAndEditingAllowed, Mode=OneWay}"
                                         Value="False">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="AdditionalServiceWarehouseComboBoxReadOnlyConditionsStyle"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource EnabledElementOpacity}" />
                        <Setter Property="NullValue"
                                Value="{x:Null}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="EditBox" />
                        <Setter Property="IsReadOnly"
                                Value="False" />
                        <Style.Triggers>
                            <DataTrigger Value="False">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentUserAndEditingAllowed" />
                                        <Binding Path="IsNotReadonlyAdditionalServiceWarehouse" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="False" />
                                <Setter Property="IsReadOnly"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:CurrentWindowService/>
        <dxmvvm:OpenFileDialogService Title="Выберите документ"
                                      Filter="PDF|*.pdf|Word 97-2003 Document|*.doc|Word Document|*.docx|JPEG|*.jpg|PNG|*.png"
                                      FilterIndex="4"
                                      Multiselect="True" />

    </dxmvvm:Interaction.Behaviors>
    <dxb:BarManager>
        <dxb:BarManager.Items>
            <!-- Add product items -->
            <viewComponents:BarLinkContainerItemEx x:Name="AddProductBarLinkContainer">
                <dxb:BarButtonItem x:Name="AddProductBarButtonItem"
                                   Content="Добавить"
                                   KeyGesture="Insert"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddProductCommand, Mode=OneTime}" />
                <dxb:BarButtonItem x:Name="AddProductListBarButtonItem"
                                   Content="Добавить из списка"
                                   KeyGesture="Ctrl+1"
                                   Glyph="../../../Images/Order/Bulk_add/bulk_add.png"
                                   Command="{Binding Path=BulkAddProductCommand, Mode=OneTime}" />
                <dxb:BarButtonItem x:Name="AddAssemblyProductBarButtonItem"
                                   Content="Добавить сборку"
                                   KeyGesture="Ctrl+2"
                                   Glyph="../../../Images/Common/computer_add_16x16.png"
                                   Command="{Binding Path=AddAssemblyCommand, Mode=OneTime}" />
                <dxb:BarButtonItem x:Name="AddAssembledComputerRuleBarButtonItem"
                                   Content="Добавить конфигурацию"
                                   KeyGesture="Ctrl+3"
                                   Glyph="../../../Images/Common/server_add.png"
                                   Command="{Binding Path=AddAssembledComputerRuleCommand, Mode=OneTime}" />
                <dxb:BarButtonItem x:Name="AddCustomAssemblyBarButtonItem"
                                   Content="Добавить сборку (ЛК)"
                                   KeyGesture="Ctrl+4"
                                   Glyph="../../../Images/NavigationMenu/users_4.png"
                                   Command="{Binding Path=AddCustomAssemblyCommand, Mode=OneTime}" />
                <dxb:BarButtonItem x:Name="AddFolderBarButtonItem"
                                   Content="Добавить пустую сборку"
                                   KeyGesture="Ctrl+5"
                                   Glyph="../../../Images/Common/folder.png"
                                   Command="{Binding Path=AddFolderCommand, Mode=OneTime}" />
            </viewComponents:BarLinkContainerItemEx>
            <!-- end -->
            <dxb:BarSubItem x:Name="AddProductBurSubItem"
                            Content="Добавить"
                            Glyph="{dx:DXImage Image=Add_16x16.png}"
                            IsEnabled="{Binding Path=HasEnabledItems, Mode=OneWay, ElementName=AddProductBarLinkContainer}"
                            LargeGlyph="{dx:DXImage Image=Add_32x32.png}">
                <dxb:BarSubItem.ItemLinks>
                    <dxb:BarLinkContainerItemLink BarItemName="AddProductBarLinkContainer" />
                </dxb:BarSubItem.ItemLinks>
            </dxb:BarSubItem>
            <!-- Assembly product items -->
            <viewComponents:BarLinkContainerItemEx x:Name="AssemblyProductBarLinkContainer">
                <dxb:BarButtonItem x:Name="EditAssemblyProductBarButtonItem"
                                   Content="Изменить"
                                   Glyph="../../../Images/Common/computer_edit_16x16.png"
                                   Command="{Binding Path=EditAssemblyCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarButtonItem x:Name="CheckAssemblyProductBarButtonItem"
                                   Content="Проверить"
                                   Glyph="../../../Images/Common/computer_link_16x16.png"
                                   Command="{Binding Path=CheckCompatibilityCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarButtonItem x:Name="CreateAssemblyProductBarButtonItem"
                                   Content="Создать"
                                   Glyph="../../../Images/Common/computer_add_16x16.png"
                                   Command="{Binding Path=CreateAssemblyWithProductsCommand, Mode=OneTime}"/>
            </viewComponents:BarLinkContainerItemEx>
            <!-- end -->
            <dxb:BarSubItem x:Name="AssemblyProductBurSubItem"
                            Content="Сборка"
                            Glyph="../../../Images/Common/computer_16x16.png"
                            IsEnabled="{Binding Path=HasEnabledItems, Mode=OneWay, ElementName=AssemblyProductBarLinkContainer}"
                            LargeGlyph="{dx:DXImage Image=Add_32x32.png}">
                <dxb:BarSubItem.ItemLinks>
                    <dxb:BarLinkContainerItemLink BarItemName="AssemblyProductBarLinkContainer" />
                </dxb:BarSubItem.ItemLinks>
            </dxb:BarSubItem>
            <!-- Add bundle items -->
            <viewComponents:BarLinkContainerItemEx x:Name="BundleBarLinkContainer">
                <dxb:BarButtonItem x:Name="AddBundleBarButtonItem"
                                   Content="Добавить"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddBundleCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=DataContext.SelectedProducts, Mode=OneWay, ElementName=GridControl}" />
                <dxb:BarButtonItem x:Name="DeleteBundleBarButtonItem"
                                   Content="Удалить"
                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                   Command="{Binding Path=DeleteBundleCommand, Mode=OneTime}"
                                   CommandParameter="{Binding Path=CurrentOrderProduct, Mode=OneWay}" />
            </viewComponents:BarLinkContainerItemEx>
            <!-- end -->
            <dxb:BarSubItem x:Name="AddBundleBurSubItem"
                            Content="Бандл"
                            Glyph="../../../Images/Common/module.png"
                            IsEnabled="{Binding Path=HasEnabledItems, Mode=OneWay, ElementName=BundleBarLinkContainer}"
                            LargeGlyph="{dx:DXImage Image=Add_32x32.png}">
                <dxb:BarSubItem.ItemLinks>
                    <dxb:BarLinkContainerItemLink BarItemName="BundleBarLinkContainer" />
                </dxb:BarSubItem.ItemLinks>
            </dxb:BarSubItem>
            <dxb:BarButtonItem x:Name="RemoveProductBarButtonItem"
                               Content="Удалить"
                               KeyGesture="Delete"
                               Glyph="{dx:DXImage Image=Delete_16x16.png}"
                               Command="{Binding Path=DeleteProductCommand, Mode=OneTime}"
                               CommandParameter="{Binding Path=DataContext.SelectedProducts, Mode=OneWay, ElementName=GridControl}" />
            <!-- State items -->
