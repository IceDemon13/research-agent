                                                    <DataTrigger Binding="{Binding Path=IsContractorEditable, Mode=OneWay}"
                                                                 Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="{StaticResource DisabledElementOpacity}" />
                                                        <Setter Property="AllowDefaultButton"
                                                                Value="False" />
                                                        <Setter Property="IsReadOnly"
                                                                Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </dxe:ComboBoxEdit.Style>
                                        <dxe:ComboBoxEdit.EditTemplate>
                                            <ControlTemplate>
                                                <dxlc:LayoutGroup Padding="0 4"
                                                                  ItemSpace="0"
                                                                  Orientation="Horizontal">
                                                    <dx:DXImage Source="{Binding Path=EditValue.Subdivision.Id, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}, ElementName=ContractorsComboBox}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding Path=Source, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                                Margin="4 0 0 0"
                                                                Width="16"
                                                                Height="16" />
                                                    <TextBox x:Name="PART_Editor" />
                                                </dxlc:LayoutGroup>
                                            </ControlTemplate>
                                        </dxe:ComboBoxEdit.EditTemplate>
                                        <dxe:ComboBoxEdit.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <dx:DXImage Source="{Binding Path=Subdivision.Id, Mode=OneWay, Converter={StaticResource SubdivisionImageConverter}}"
                                                                VerticalAlignment="Center"
                                                                Margin="0 0 5 0"
                                                                Width="16"
                                                                Height="16" />
                                                    <Label Content="{Binding Path=Name, Mode=OneWay}"
                                                           VerticalAlignment="Center"
