                                               Glyph="../../../Images/NavigationMenu/box_front_open.png"
                                               Command="{Binding Path=EditProductAddedByCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentOrderProduct, Mode=OneWay}" >
                                <dxb:BarButtonItem.IsVisible>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsEnabled"
                                                 Mode="OneWay"
                                                 RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="EditCreatedByCommand.IsExecuting"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </dxb:BarButtonItem.IsVisible>
                            </dxb:BarButtonItem>
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                    <dx:SimpleButton Content="Внешний заказ"
                                     Glyph="../../../Images/Parser/link_16_16.png"
                                     Command="{Binding Path=SetExternalOrderCommand, Mode=OneWay}">
                        <dx:SimpleButton.Visibility>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         RelativeSource="{RelativeSource Self}" />
                                <Binding Path="SetExternalOrderCommand.IsExecuting"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </dx:SimpleButton.Visibility>
                    </dx:SimpleButton>
                    <dx:SimpleButton Content="Контроль оплаты"
                                     Command="{Binding Path=PaymentControlCommand, Mode=OneWay}">
                        <dx:SimpleButton.Visibility>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         RelativeSource="{RelativeSource Self}" />
                                <Binding Path="PaymentControlCommand.IsExecuting"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </dx:SimpleButton.Visibility>
                    </dx:SimpleButton>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Height="22">
                    <dx:DropDownButton Content="Печать"
                                       Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                       Padding="8,0,0,0">
                        <dx:DropDownButton.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                <Binding Path="IsLockedByCurrentUserAndEditingAllowed"
                                         Mode="OneWay" />
                                <Binding Path="Id"
                                         Mode="OneWay"
                                         Converter="{StaticResource IsNewOrderToBooleanConverter}" />
                            </MultiBinding>
                        </dx:DropDownButton.IsEnabled>
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Лист на сборку"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintAssemblyCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Расх. Накладная"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintOrderCommand, Mode=OneTime}"
                                               CommandParameter="{x:Static dictionaries:OrderDocumentType.AcceptanceProtocolId}" />
                            <dxb:BarButtonItem Content="Гар. талон"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintWarrantyCardCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="ТТН"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintTrackNumberCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Реестр ШК"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintAssemblyReportCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Чек"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               IsVisible="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}}"
                                               Command="{Binding Path=PrintChequeCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Хрупкое"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=DocumentCommands.PrintStickerFragileCommand, Mode=OneWay}">
                                <dxb:BarButtonItem.CommandParameter>
                                    <MultiBinding Converter="{converters:PrintStickerParameterMultiValueConverter}">
                                        <Binding Path="SelectedCarryType.Id"
                                                 Mode="OneWay"/>
                                    </MultiBinding>
                                </dxb:BarButtonItem.CommandParameter>
                            </dxb:BarButtonItem>
                            <dxb:BarButtonItem Content="Вверх"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path= DocumentCommands.PrintStickerWayUpCommand, Mode=OneWay}">
                                <dxb:BarButtonItem.CommandParameter>
                                    <MultiBinding Converter="{converters:PrintStickerParameterMultiValueConverter}">
                                        <Binding Path="SelectedCarryType.Id"
                                                 Mode="OneWay"/>
                                    </MultiBinding>
                                </dxb:BarButtonItem.CommandParameter>
                            </dxb:BarButtonItem>
                            <dxb:BarButtonItem Content="Акт принятия гос. товара"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintActIncomeCommand, Mode=OneTime}"
                                               CommandParameter="{StaticResource True}"/>
                            <dxb:BarButtonItem Content="Акт возврата гос. товара"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               Command="{Binding Path=PrintActOutcomeCommand, Mode=OneTime}"/>
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                    <StackPanel Style="{StaticResource VerticalSeparatorStackPanelStyle}" />
                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      Visibility="{Binding Path=NeedCalculateLogistics, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}">
                        <dx:SimpleButton Content="Логистика"
                                         Glyph="{StaticResource Calculator16}"
                                         Command="{Binding Path=CalculateLogisticsCommand, Mode=OneTime}" />
                        <StackPanel Style="{StaticResource VerticalSeparatorStackPanelStyle}" />
                    </dxlc:LayoutGroup>
                    <StackPanel x:Name="OkButton"
                                Orientation="Horizontal"
                                Style="{StaticResource DisabledConditionsStyle}">
                        <dx:SimpleButton x:Name="OkBtn"
                                         Content="OK"
                                         Command="{Binding Path=OkCommand, Mode=OneTime}">
                            <dx:SimpleButton.IsEnabled>
                                <MultiBinding Mode="OneWay"
                                              Converter="{converters:BooleanAndMultiValueConverter}">
                                    <Binding Path="(dxe:ValidationService.HasValidationError)"
                                             ElementName="OrderFields"
                                             Mode="OneWay"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                    <Binding Path="IsOrderProductsValid"
                                             Mode="OneWay" />
                                    <Binding Path="IsLockedByCurrentUserAndEditingAllowed"
                                             Mode="OneWay" />
                                    <Binding Path="HasValidationError"
                                             Mode="OneWay"
                                             ElementName="ProductsTableView"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                </MultiBinding>
                            </dx:SimpleButton.IsEnabled>
                        </dx:SimpleButton>
                        <dx:SimpleButton Content="Сохранить"
                                         Command="{Binding Path=SaveCommand, Mode=OneTime}"
                                         IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkBtn}"
                                         Margin="8,0,0,0" />
                    </StackPanel>
                    <dx:SimpleButton Content="Отмена"
                                     Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dxb:BarManager>
</controls:TelemartUserControl>