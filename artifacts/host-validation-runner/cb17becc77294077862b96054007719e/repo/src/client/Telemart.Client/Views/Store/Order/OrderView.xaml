                                                      ImmediatePopup="True"
                                                      AllowDrop="False"
                                                      IncrementalFiltering="True"
                                                      CausesValidation="True"
                                                      ValidateOnTextInput="False"
                                                      IsTextEditable="True"
                                                      ApplyItemTemplateToSelectedItem="True"
                                                      NullValueButtonPlacement="None">
