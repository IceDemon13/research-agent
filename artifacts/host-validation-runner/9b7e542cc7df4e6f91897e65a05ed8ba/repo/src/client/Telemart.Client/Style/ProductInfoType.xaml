<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries">
    <BitmapImage x:Key="ComplectImage"
                 UriSource="/Images/Common/text_list_bullets_16x16.png" />
    <BitmapImage x:Key="AdvantagesImage"
                 UriSource="/Images/Common/star_16x16.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="ProductInfoTypeConverter">
        <dxmvvm:MapItem Source="{x:Static dictionaries:ProductInfoType.ComplectId}"
                        Target="{StaticResource ComplectImage}" />
        <dxmvvm:MapItem Source="{x:Static dictionaries:ProductInfoType.AdvantagesId}"
                        Target="{StaticResource AdvantagesImage}" />
    </dxmvvm:ObjectToObjectConverter>
</ResourceDictionary>