<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm">

    <BitmapImage x:Key="CategoryResourceImage"
                 UriSource="/Images/CategoryOptions/folder.png" />
    <BitmapImage x:Key="ProductResourceImage"
                 UriSource="/Images/CategoryOptions/box.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="CategoryOptionInheritanceModeImageConverter">
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource CategoryResourceImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource ProductResourceImage}" />
    </dxmvvm:ObjectToObjectConverter>

</ResourceDictionary>