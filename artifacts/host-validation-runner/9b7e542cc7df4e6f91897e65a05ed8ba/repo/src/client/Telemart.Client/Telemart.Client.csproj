  <Target Name="CreateSetup" AfterTargets="Publish">
    <Exec Command="..\..\..\tools\nuget\nuget.exe pack ..\..\..\build_scripts\$(ApplicationId).nuspec -Version $(PackageVersion) -OutputDirectory $(PackPath) -BasePath $(PublishDir)" />
    <Copy SourceFiles="install.gif" DestinationFiles="$(PackPath)\install.gif" />
    <Copy SourceFiles="Images\bug_fixing.ico" DestinationFiles="$(PackPath)\app.ico" />
    <Copy SourceFiles="Images\IconStaging.ico" DestinationFiles="$(PackPath)\app.ico" Condition=" '$(EnvironmentName)' == 'Staging' " />
    <Copy SourceFiles="Images\IconUat.ico" DestinationFiles="$(PackPath)\app.ico" Condition=" '$(EnvironmentName)' == 'Uat' " />
    <Copy SourceFiles="Images\Icon.ico" DestinationFiles="$(PackPath)\app.ico" Condition=" '$(EnvironmentName)' == 'Production' " />
    <Exec Command="..\..\tools\Squirrel.Windows.1.9.1\Squirrel.exe --releasify $(ApplicationId).$(PackageVersion).nupkg --no-msi --setupIcon &quot;.\app.ico&quot; -g .\install.gif" WorkingDirectory="$(PackPath)" />
  </Target>
