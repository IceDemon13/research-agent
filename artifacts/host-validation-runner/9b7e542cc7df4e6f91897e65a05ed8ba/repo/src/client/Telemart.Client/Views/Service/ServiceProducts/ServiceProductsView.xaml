<UserControl x:Class="Telemart.Client.Views.Service.ServiceProducts.ServiceProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceProducts"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             DataContext="{client:Container Type=viewModels:ServiceProductsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:ServiceProductsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=ServiceProductGridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding Path=View, ElementName=ServiceProductGridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditCommand, Mode=OneTime}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Экспорт"
                                   ToolTip="Экспортировать в Excel (Alt+E)"
                                   LargeGlyph="/Images/Parser/excel_32_32.png"
                                   Command="{Binding Path=ExportCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Mode=OneWay, ElementName=ServiceProductTableView}" />
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0"
                              Margin="0">
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Padding="0"
                                  MinHeight="230"
                                  Style="{StaticResource PanelStyle}">
                    <dxg:GridControl x:Name="ServiceProductGridControl"
                                     ItemsSource="{Binding Path=ServiceProducts, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedServiceProduct, Mode=TwoWay}"
                                     ShowBorder="False"
                                     SelectionMode="None"
                                     ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="service_products.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Номер"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Id"
                                            FixedWidth="True"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False"
                                            Width="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Заявка"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="ServiceRequestId"
                                            FixedWidth="True"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False"
                                            Width="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата"
                                            HeaderToolTip="Дата создания документа"
                                            FieldName="CreatedOn"
                                            FixedWidth="True"
                                            FilterPopupMode="Date"
                                            HorizontalHeaderContentAlignment="Center"
                                            Width="90">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Товар"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="DisplayProductName"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="SN"
                                            HeaderToolTip="Серийный номер"
                                            FieldName="Sn"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False"
                                            FixedWidth="True">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Цена"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="PriceUsd"
                                            FixedWidth="True"
                                            Width="50"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Цена закупки"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="PurchasedPrice"
                                            FixedWidth="True"
                                            Width="60"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit x:Name="PART_Editor"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{Binding Path=RowData.Row.PurchasedCurrencyId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}}"
                                                      MaskCulture="{Binding Path=RowData.Row.PurchasedCurrencyId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                                      MaskSaveLiteral="False"
                                                      IsFloatValue="True"
                                                      AllowDefaultButton="False"
                                                      HorizontalContentAlignment="Right" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Склад"
                                            HeaderToolTip="Склад"
                                            FieldName="WarehouseId"
                                            FixedWidth="True"
                                            Width="150"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Warehouses}"
                                                              ValueMember="Id"
                                                              DisplayMember="DisplayValue"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Поставщик"
                                            HeaderToolTip="Поставщик"
                                            FieldName="SupplierId"
                                            FixedWidth="True"
                                            Width="150"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Contractors}"
                                                              ValueMember="Id"
                                                              DisplayMember="DisplayValue"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Акт"
                                            HeaderToolTip="Акт"
                                            FieldName="ServiceActNumber"
                                            FixedWidth="True"
                                            Width="150"
                                            AllowColumnFiltering="False"
                                            AllowGrouping="False"/>
                            <dxg:GridColumn Header="Возврат в 1С"
                                            HeaderToolTip="Возврат в 1С"
                                            FieldName="Document1COut"
                                            FixedWidth="True"
                                            Width="150"
                                            AllowColumnFiltering="True"
                                            AllowGrouping="True"/>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="Статус"
                                            FieldName="State"
                                            FixedWidth="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Завершен"
                                            HeaderToolTip="Дата завершения роботы"
                                            FieldName="CompletedOn"
                                            Width="90"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            GroupInterval="Date"
                                            FixedWidth="True"
                                            AllowBestFit="True"
                                            AllowAutoFilter="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="ServiceProductTableView"
                                           AutoWidth="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           IsTotalSummaryMenuEnabled="False"
                                           ShowTotalSummary="False"
                                           AllowGrouping="True"
                                           AllowBestFit="True"
                                           AllowResizing="True"
                                           AllowSorting="True"
                                           AllowColumnFiltering="True"
                                           AllowColumnMoving="True"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=ServiceProductGridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                        </dxg:GridControl.GroupSummary>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="True"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=ServiceProductGridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Создан">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Order/Filter/calendar.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxlc:LayoutGroup Orientation="Horizontal"
                                                  VerticalAlignment="Center">
                                    <dxe:DateEdit EditValue="{Binding Path=Filter.CreatedOnAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch"
                                                  AllowNullInput="True"
                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                  AllowRoundOutOfRangeValue="False"
                                                  Style="{StaticResource BasicDateEdit}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                    <TextBlock Text="-"
                                               Width="8"
                                               TextAlignment="Center" />
                                    <dxe:DateEdit EditValue="{Binding Path=Filter.CreatedOnBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch"
                                                  AllowNullInput="True"
                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                  AllowRoundOutOfRangeValue="False"
                                                  Style="{StaticResource BasicDateEdit}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutItem>

                                <dxlc:LayoutItem Label="Завершен">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="/Images/Order/Filter/calendar.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxlc:LayoutGroup Orientation="Horizontal"
                                                      VerticalAlignment="Center"
                                                      ItemSpace="0">
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.CompletedOnAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      AllowNullInput="True"
                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                      AllowRoundOutOfRangeValue="False"
                                                      Style="{StaticResource BasicDateEdit}" />
                                        <TextBlock Text="-"
                                                   Width="18"
                                                   TextAlignment="Center" />
                                        <dxe:DateEdit EditValue="{Binding Path=Filter.CompletedOnBefore, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      AllowNullInput="True"
                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                      AllowRoundOutOfRangeValue="False"
                                                      Style="{StaticResource BasicDateEdit}" />
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Номер">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Common/cheque.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.ServiceProductNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Заявка">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Call/toolbox.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <controls:FilterNumbersPrintTextEdit EditValue="{Binding Path=Filter.ServiceRequestIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:FilterNumbersPrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Товар">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/package.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ButtonEdit EditValue="{Binding Path=Filter.Product, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    AllowDefaultButton="False">
                                        <dxe:ButtonInfo ButtonKind="Simple"
                                                        GlyphKind="Regular"
                                                        Command="{Binding Path=SelectProductCommand, Mode=OneTime}" />
                                    </dxe:ButtonEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="SN">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Product/barcode.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:TextEdit EditValue="{Binding Path=Filter.SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Склад">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/house.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Warehouses, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                      DisplayMember="DisplayValue"
                                                      ValueMember="Id"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}"
                                                      AllowNullInput="True"/>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../../Images/Order/Filter/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=States, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      ValueMember="Id"
                                                      EditValue="{Binding Path=Filter.SelectedStatuses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Товаров">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=ServiceProducts.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="На сумму">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:TextEdit EditValue="{Binding Path=TotalPrice, Mode=OneWay, FallbackValue=0}"
                                                      IsPrintingMode="True"
                                                      FontWeight="Bold"
                                                      MaskType="Numeric"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{x:Static business:CurrencyFormatingRules.UsdFormat}"
                                                      MaskCulture="{x:Static business:CurrencyFormatingRules.UsdCultureInfo}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>
</UserControl>