<controls:TelemartUserControl x:Class="Telemart.Client.Views.Discussions.DiscussionView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Discussions"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              DataContext="{client:Container Type=viewModels:DiscussionViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:DiscussionViewModel}}"
                              d:DesignHeight="540"
                              d:DesignWidth="600">
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTemplate x:Key="LookUpEditDiscussionTypeControlTemplate">
                <dxg:GridControl Name="PART_GridControl">
                    <dxg:GridControl.Resources>
                        <Style TargetType="dxg:GridColumn"
                               BasedOn="{StaticResource GeneralGridColumnStyle}">
                        </Style>
                    </dxg:GridControl.Resources>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Name"
                                        Header="Тип обсуждения"
                                        AllowResizing="False"
                                        FixedWidth="False" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TreeListView AutoWidth="True"
                                          AutoExpandAllNodes="False"
                                          KeyFieldName="Id"
                                          ParentFieldName="ParentId"
                                          ShowIndicator="False"
                                          UseEvenRowBackground="True"
                                          AlternationCount="2"
                                          FilteringMode="EntireBranch"
                                          ExpandNodesOnFiltering="True"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </ControlTemplate>
        </ResourceDictionary>

    </controls:TelemartUserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutGroup View="GroupBox"
                              ItemSpace="0"
                              Orientation="Vertical"
                              Header="Документы"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                        <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                            IsEnabled="True">
                            <dxb:BarButtonItem Content="Открыть"
                                               Glyph="/Images/Common/page_white_magnify.png"
                                               Command="{Binding Path=OpenDocumentCommand, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Создать"
                                               Glyph="{dx:DXImage Image=Add_16x16.png}"
                                               Command="{Binding Path=CreateDocumentCommand, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Удалить"
                                               Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                               Command="{Binding Path=DeleteDocumentCommand, Mode=OneWay}" />
                        </dxb:ToolBarControl>
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl ItemsSource="{Binding Path=Model.EntityDocuments, Mode=OneWay}"
                                         SelectedItem="{Binding Path=SelectedEntityDocument}"
                                         SelectionMode="Row"
                                         ShowBorder="False"
                                         MaxHeight="80">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:LayoutSerializationBehavior FileName="discussion.xml" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn Header="Документ"
                                                HeaderToolTip="Название документа"
                                                FieldName="EntityId"
                                                FixedWidth="False"
                                                MaxWidth="200"
                                                Width="130"
                                                MinWidth="100"
                                                AllowBestFit="False"
                                                AllowResizing="True"
                                                AllowGrouping="True"
                                                AllowSorting="True"
                                                AllowMoving="True"
                                                AllowColumnFiltering="False"
                                                AllowAutoFilter="False"
                                                ColumnFilterMode="DisplayText"
                                                FilterPopupMode="CheckedList">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Entities}"
                                                                  ValueMember="Id"
                                                                  DisplayMember="DisplayValue"
                                                                  HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Код документа"
                                                HeaderToolTip="Код документа"
                                                HorizontalHeaderContentAlignment="Center"
                                                FieldName="DocumentId"
                                                FixedWidth="False"
                                                Width="110"
                                                MinWidth="90"
                                                AllowBestFit="True"
                                                AllowResizing="True"
                                                AllowGrouping="False"
                                                AllowMoving="False"
                                                AllowAutoFilter="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True"
                                               ShowTotalSummary="False"
                                               ShowIndicator="False"
                                               ShowFixedTotalSummary="False"
                                               ShowAutoFilterRow="False"
                                               ShowSearchPanelMode="Never"
                                               ShowGroupPanel="False"
                                               IsColumnMenuEnabled="False"
                                               ShowColumnHeaders="True"
                                               AutoWidth="True"
                                               NavigationStyle="Row"
                                               AllowResizing="True"
                                               AllowEditing="False"
                                               AllowGrouping="False"
                                               AllowColumnMoving="False"
                                               AllowColumnFiltering="False"
                                               AllowSorting="True"
                                               AllowMoveColumnToDropArea="False">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding OpenDocumentCommand}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutItem Label="Тип">
                            <dxg:LookUpEdit ItemsSource="{Binding Path=DiscussionTypes, Mode=OneWay}"
                                            EditValue="{Binding Path=Model.TypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            DisplayMember="Name"
                                            ValueMember="Id"
                                            AutoPopulateColumns="False"
                                            IsReadOnly="{Binding Path=AllowEdit, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                            AutoComplete="False"
                                            FilterCondition="Like"
                                            FindMode="Always"
                                            IsPopupAutoWidth="True"
                                            InvalidValueBehavior="AllowLeaveEditor"
                                            Style="{StaticResource  SearchableLookUpReadOnlyConditionsStyle}"
                                            PopupContentTemplate="{StaticResource LookUpEditDiscussionTypeControlTemplate}">
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:SearchLookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:TextEdit EditValue="{Binding Path=Model.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          NullText="Заполните текст обсуждения"
                                          MaxLength="1000"
                                          TextWrapping="Wrap"
                                          AcceptsReturn="True"
                                          AcceptsTab="True"
                                          Height="200"
                                          IsReadOnly="{Binding AllowEdit, Mode=OneWay}"
                                          VerticalContentAlignment="Top"
                                          VerticalScrollBarVisibility="Auto"
                                          Opacity="{StaticResource EnabledElementOpacity}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="GotFocus"
                                                           Command="{Binding Path=OpenTypePropertiesCommand, Mode=OneWay}"
                                                           PassEventArgsToCommand="False" />
                                    <dxmvvm:EventToCommand EventName="MouseDoubleClick"
                                                           Command="{Binding Path=OpenTypePropertiesCommand, Mode=OneWay}"
                                                           PassEventArgsToCommand="False"/>
                                </dxmvvm:Interaction.Behaviors>

                            </dxe:TextEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical">
                   <dxlc:LayoutItem Label="Заголовок">
                            <dxe:TextEdit
                                IsReadOnly="True"
                                Style="{StaticResource ReadOnlyConditionsStyle}"
                                EditValue="{Binding Path=Model.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Исполнитель">
                            <dxg:LookUpEdit ItemsSource="{Binding Path=DepartmentEmployees, Mode=OneWay}"
                                            EditValue="{Binding Path=Model.ExecutorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            DisplayMember="DisplayName"
                                            ValueMember="EmployeeId"
                                            AutoPopulateColumns="False"
                                            IsReadOnly="{Binding Path=AllowEditBitrixProperties, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                            AutoComplete="False"
                                            FilterCondition="Like"
                                            FindMode="Always"
                                            IsPopupAutoWidth="True"
                                            InvalidValueBehavior="AllowLeaveEditor"
                                            Style="{StaticResource  SearchableLookUpReadOnlyConditionsStyle}"
                                            PopupContentTemplate="{StaticResource LookUpEditDepartmentEmployeeControlTemplate}">
                                <dxg:LookUpEdit.StyleSettings>
                                    <dxg:SearchLookUpEditStyleSettings />
                                </dxg:LookUpEdit.StyleSettings>
                            </dxg:LookUpEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Соисполнители">
                            <dxe:ComboBoxEdit
                                EditValue="{Binding Model.CoExecutorEmployeeIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                ItemsSource="{Binding Path=ActiveEmployees, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueMember="Id"
                                DisplayMember="DisplayValue"
                                IsReadOnly="{Binding Path=AllowEditBitrixProperties, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                Style="{StaticResource CheckedTokenComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Наблюдатели">
                            <dxe:ComboBoxEdit
                                EditValue="{Binding Model.AuditorEmployeeIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                ItemsSource="{Binding Path=ActiveEmployees, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueMember="Id"
                                DisplayMember="DisplayValue"
                                IsReadOnly="{Binding Path=AllowEditBitrixProperties, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                Style="{StaticResource CheckedTokenComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Хэштеги">
                            <dxe:ComboBoxEdit
                                IsReadOnly="{Binding Path=AllowEditBitrixProperties, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                EditValue="{Binding Model.HashtagIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                ItemsSource="{Binding Path=Hashtags, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueMember="Id"
                                DisplayMember="DisplayValue"
                                Style="{StaticResource CheckedTokenComboBoxReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Приоритет">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Priorities, Mode=OneWay}"
                                              ValueMember="Id"
                                              DisplayMember="DisplayValue"
                                              IsReadOnly="{Binding Path=AllowEdit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                              EditValue="{Binding Path=Model.PriorityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource LookupComboBoxStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Приоритет в Bitrix">
                            <dxe:CheckEdit EditValue="{Binding Path=Model.PriorityBitrix, Mode=TwoWay}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}"
                                           IsReadOnly="{Binding Path=AllowEditBitrixProperties, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Контроль задачи в Bitrix"
                                         Visibility="{Binding Path=IsNew, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                            <dxe:CheckEdit EditValue="{Binding Path=Model.TaskControlBitrix, Mode=TwoWay}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}"
                                           IsReadOnly="False"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Дедлайн">
                            <dxe:DateEdit
                                EditValue="{Binding Path=Model.Deadline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                MaskType="DateTime"
                                Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                MaskUseAsDisplayFormat="True"
                                IsTextEditable="False"
                                IsReadOnly="{Binding Path=AllowEditBitrixProperties, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                InvalidValueBehavior="AllowLeaveEditor"
                                Style="{StaticResource ReadOnlyConditionsStyle}"
                                AllowRoundOutOfRangeValue="True">
                                <dxe:DateEdit.StyleSettings>
                                    <dxe:DateEditNavigatorWithTimePickerStyleSettings/>
                                </dxe:DateEdit.StyleSettings>
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:FocusBehavior />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:DateEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Статус">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=States, Mode=OneWay}"
                                              ValueMember="Id"
                                              DisplayMember="DisplayValue"
                                              IsReadOnly="True"
                                              EditValue="{Binding Path=Model.StateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              Style="{StaticResource LookUpReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutGroup Orientation="Horizontal">
                            <dxlc:LayoutItem Label="Задача в Bitrix">
                                <dxe:TextEdit
                                    EditValue="{Binding Model.BitrixId, ValidatesOnDataErrors=True, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsReadOnly="True"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource ReadOnlyConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dx:SimpleButton
                                Command="{Binding Path=DataContext.OpenBitrixCommand, Mode=OneWay, ElementName=LayoutControl}"
                                Content="🔎"
                                Width="20"
                                MinWidth="20"
                                Height="20"
                                Padding="1 1 1 1"
                                HorizontalAlignment="Right"
                                IsEnabled="{Binding IsNew, Converter={dxmvvm:BooleanNegationConverter}}" />
                        </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>