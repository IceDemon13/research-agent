<UserControl x:Class="Telemart.Client.Views.Reporting.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxpg="http://schemas.devexpress.com/winfx/2008/xaml/pivotgrid"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxci="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Reporting"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:mvvm="clr-namespace:Telemart.Client.ViewModels.Reporting.Mvvm"
             xmlns:editors="clr-namespace:Telemart.Client.ViewComponents.Editors"
             xmlns:dxpgi="http://schemas.devexpress.com/winfx/2008/xaml/pivotgrid/internal"
             DataContext="{client:Container Type=viewModels:ReportViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ReportViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <DataTemplate x:Key="FormatConditionTemplate">
                        <ContentControl>
                            <dxg:FormatCondition Expression="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Expression, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 ApplyToRow="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ApplyToRow, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                                <dxg:FormatCondition.Format>
                                    <dx:Format Foreground="#FFCC0000" />
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </ContentControl>
                    </DataTemplate>
                    <DataTemplate x:Key="TextDataTemplate"
                                  DataType="{x:Type mvvm:ReportParameter}">
                        <dxe:TextEdit EditValue="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }" />
                    </DataTemplate>
                    <DataTemplate x:Key="CheckedTokenComboBoxDataTemplate"
                                  DataType="{x:Type mvvm:ReportParameter}">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=ComboBoxItems, Mode=OneWay}"
                                          EditValue="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
                                          ValueMember="Id"
                                          DisplayMember="DisplayValue"
                                          Style="{StaticResource CheckedTokenComboBoxStyle}" />
                    </DataTemplate>
                    <DataTemplate x:Key="TokenComboBoxDataTemplate"
                                  DataType="{x:Type mvvm:ReportParameter}">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=ComboBoxItems, Mode=OneWay}"
                                          EditValue="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
                                          ValueMember="Id"
                                          DisplayMember="DisplayValue"
                                          Style="{StaticResource TokenComboBoxStyle}" />
                    </DataTemplate>
                    <DataTemplate x:Key="DateTimeRangeDataTemplate"
                                  DataType="{x:Type mvvm:ReportParameter}">
                        <editors:DatePeriodEdit From="{Binding Path=Value.Item1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Till="{Binding Path=Value.Item2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedPeriod="{Binding Path=Value.PredefinedPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                    <DataTemplate x:Key="DecimalRangeDataTemplate"
                                  DataType="{x:Type mvvm:ReportParameter}">
                        <dxlc:LayoutGroup Orientation="Horizontal">
                            <dxlc:LayoutGroup.Resources>
                                <Style x:Key="SpinEditDecimalStyle"
                                       TargetType="{x:Type dxe:SpinEdit}">
                                    <Setter Property="MaskType"
                                            Value="Numeric" />
                                    <Setter Property="Mask"
                                            Value="####################.#########" />
                                    <Setter Property="MaskCulture"
                                            Value="en-Us" />
                                    <Setter Property="MaskUseAsDisplayFormat"
                                            Value="True" />
                                    <Setter Property="MaskSaveLiteral"
                                            Value="False" />
                                    <Setter Property="IsFloatValue"
                                            Value="True" />
                                    <Setter Property="AllowDefaultButton"
                                            Value="False" />
                                    <Setter Property="AllowNullInput"
                                            Value="True" />
                                    <Setter Property="NullValueButtonPlacement"
                                            Value="EditBox" />
                                    <Setter Property="NullValue"
                                            Value="{x:Null}" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Right" />
                                </Style>
                            </dxlc:LayoutGroup.Resources>
                            <dxe:SpinEdit EditValue="{Binding Path=Value.Item1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Stretch"
                                          Style="{StaticResource SpinEditDecimalStyle}" />
                            <TextBlock Text="-"
                                       Width="8"
                                       TextAlignment="Center" />
                            <dxe:SpinEdit EditValue="{Binding Path=Value.Item2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Stretch"
                                          Style="{StaticResource SpinEditDecimalStyle}" />
                        </dxlc:LayoutGroup>
                    </DataTemplate>
                    <mvvm:ReportParameterTemplateSelector x:Key="TemplateSelector" />
                    <DataTemplate x:Key="ReportFieldTemplate">
                        <ContentControl>
                            <dxpg:PivotGridField dx:XamlHelper.Name="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).UniqueName, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 Caption="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Caption, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 ToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Description, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 CellFormat="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).CellFormat, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 GroupInterval="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).GroupInterval, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                 SummaryType="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).SummaryType, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                                <dxpg:PivotGridField.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=DataContext.DataContext.Caption, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxpgi:FieldHeader}}}" />
                                    </DataTemplate>
                                </dxpg:PivotGridField.HeaderTemplate>
                            </dxpg:PivotGridField>
                        </ContentControl>
                    </DataTemplate>
                    <Style x:Key="ReportFieldStyle"
                           TargetType="{x:Type dxpg:PivotGridField}">
                    </Style>
                    <Style x:Key="ReportColumnStyle"
                           TargetType="dxg:GridColumn">
                        <Setter Property="Header"
                                Value="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="FieldName"
                                Value="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="HeaderToolTip"
                                Value="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="FixedWidth"
                                Value="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FixedWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="FilterPopupMode"
                                Value="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FilterPopupMode, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="AllowResizing"
                                Value="True" />
                        <Setter Property="AllowGrouping"
                                Value="True" />
                        <Setter Property="AllowSorting"
                                Value="True" />
                        <Setter Property="AllowMoving"
                                Value="True" />
                        <Setter Property="AllowColumnFiltering"
                                Value="True" />
                    </Style>
                    <DataTemplate x:Key="FormatableReportColumnTemplate">
                        <ContentControl>
                            <dxg:GridColumn>
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).DisplayFormat, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </ContentControl>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Top">
            <dxb:BarManager>
                <dxb:ToolBarControl AllowQuickCustomization="False"
                                    AllowCustomizationMenu="False"
                                    IsEnabled="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       IsVisible="{Binding Path=IsAnalyzeMode, Mode=OneWay}"
                                       Command="{x:Static dxpg:PivotGridCommands.ShowFieldList}"
                                       CommandTarget="{Binding ElementName=PivotGridControl}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       IsVisible="{Binding Path=IsAnalyzeMode, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                    <dxb:BarSubItem Content="Вид"
                                    LargeGlyph="../../Images/Common/layout_32x32.png"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top"
                                    IsVisible="{Binding Path=IsAnalyzeMode, Mode=OneWay}">
                        <dxb:BarButtonItem Content="Загрузить"
                                           Glyph="{dx:DXImage Image=Open2_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Open2_32x32.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=LoadAnalyzeReportLayoutsCommand, Mode=OneTime}"
                                           CommandParameter="{Binding ElementName=PivotGridControl}" />
                        <dxb:BarButtonItem Content="Сохранить"
                                           Glyph="{dx:DXImage Image=Save_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=SaveAnalyzeReportLayoutsCommand, Mode=OneTime}"
                                           CommandParameter="{Binding ElementName=PivotGridControl}" />
                    </dxb:BarSubItem>
                    <dxb:BarSubItem Content="Вид"
                                    LargeGlyph="../../Images/Common/layout_32x32.png"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top"
                                    IsVisible="{Binding Path=IsAnalyzeMode, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                        <dxb:BarButtonItem Content="Загрузить"
                                           Glyph="{dx:DXImage Image=Open2_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Open2_32x32.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=LoadPlainReportLayoutsCommand, Mode=OneTime}"
                                           CommandParameter="{Binding Mode=OneWay, ElementName=GridControl}" />
                        <dxb:BarButtonItem Content="Сохранить"
                                           Glyph="{dx:DXImage Image=Save_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=SavePlainReportLayoutsCommand, Mode=OneTime}"
                                           CommandParameter="{Binding Mode=OneWay, ElementName=GridControl}" />
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarCheckItem Content="Анализ"
                                      ToolTip="Анализ"
                                      LargeGlyph="{dx:DXImage Image=Show_32x32.png}"
                                      Glyph="{dx:DXImage Image=Show_16x16.png}"
                                      IsChecked="{Binding Path=IsAnalyzeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <dxb:BarCheckItem Content="  Отчет  "
                                      ToolTip="Отчет"
                                      LargeGlyph="{dx:DXImage Image=Report_32x32.png}"
                                      Glyph="{dx:DXImage Image=Report_16x16.png}"
                                      IsChecked="{Binding Path=IsAnalyzeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem x:Name="ExportAnalyzisDataBarButton"
                                       Content="В Excel"
                                       ToolTip="Экспортировать в Excel"
                                       LargeGlyph="../../Images/Parser/excel_32_32.png"
                                       IsVisible="{Binding Path=IsAnalyzeMode, Mode=OneWay}"
                                       ItemClick="ExportAnalyzisDataBarButtonOnItemClick" />
                    <dxb:BarButtonItem x:Name="ExportReportDataBarButton"
                                       Content="В Excel"
                                       ToolTip="Экспортировать в Excel"
                                       LargeGlyph="../../Images/Parser/excel_32_32.png"
                                       IsVisible="{Binding Path=IsAnalyzeMode, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                       ItemClick="ExportReportDataBarButtonOnItemClick" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Настройки"
                                       ToolTip="Настройки"
                                       LargeGlyph="../../Images/Common/cog_32x32.png"
                                       Command="{Binding Path=EditCommand, Mode=OneTime}"
                                       IsVisible="{Binding Path=IsAllowReportSettings, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Легенда"
                                       ToolTip="Легенда"
                                       LargeGlyph="../../Images/Common/help_32x32.png"
                                       Command="{Binding Path=LegendCommand, Mode=OneWay}" />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0"
                              Margin="0">
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Style="{StaticResource PanelStyle}">
                    <dxlc:LayoutControl Orientation="Vertical"
                                        ItemSpace="0"
                                        Margin="0"
                                        Padding="0">
                        <dxpg:PivotGridControl x:Name="PivotGridControl"
                                               DataSource="{Binding Path=DataSourceItems, Mode=OneWay}"
                                               FieldsSource="{Binding Path=FieldItems, Mode=OneWay}"
                                               FieldGeneratorTemplate="{StaticResource ReportFieldTemplate}"
                                               FieldGeneratorStyle="{StaticResource ReportFieldStyle}"
                                               ShowBorder="False"
                                               Padding="0"
                                               Margin="0"
                                               IsFieldListVisible="{Binding Path=IsFieldListVisible, Mode=TwoWay}"
                                               Visibility="{Binding Path=IsAnalyzeMode, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                               ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="Loaded"
                                                       Command="{Binding LoadPivotGridCommand}"
                                                       CommandParameter="{Binding Mode=OneWay, ElementName=PivotGridControl}"/>
                                <behaviors:PivotGridLayoutBehavior Layout="{Binding Path=PivotGridLayout, Mode=OneWay}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxpg:PivotGridControl>
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=DataSourceItems, Mode=OneWay}"
                                         ColumnsSource="{Binding Path=Columns, Mode=OneWay}"
                                         ColumnGeneratorTemplate="{StaticResource FormatableReportColumnTemplate}"
                                         ColumnGeneratorStyle="{StaticResource ReportColumnStyle}"
                                         SelectionMode="Cell"
                                         ShowBorder="False"
                                         Padding="0"
                                         Margin="0"
                                         AutoExpandAllGroups="True"
                                         ClipboardCopyMode="ExcludeHeader"
                                         ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}"
                                         Visibility="{Binding Path=IsAnalyzeMode, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                                         ItemsSourceChanged="GridControlOnItemsSourceChanged">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="Loaded"
                                                       Command="{Binding LoadGridCommand}"
                                                       CommandParameter="{Binding Mode=OneWay, ElementName=GridControl}"/>
                                <behaviors:GridLayoutBehavior Layout="{Binding Path=GridLayout, Mode=OneWay}" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem SummaryType="Count"
                                                     Alignment="Right"
                                                     Visible="True" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="TableView"
                                               FormatConditionGeneratorTemplate="{StaticResource FormatConditionTemplate}"
                                               FormatConditionsSource="{Binding Path=FormattingRules, Mode=OneWay}"
                                               ShowIndicator="False"
                                               NavigationStyle="Cell"
                                               AutoWidth="True"
                                               AllowEditing="False"
                                               AllowGrouping="True"
                                               AllowSorting="True"
                                               AllowColumnFiltering="True"
                                               AllowColumnMoving="True"
                                               AllowResizing="True"
                                               AllowBestFit="True"
                                               ShowSelectionRectangle="False"
                                               ClipboardCopyOptions="All"
                                               CustomCellAppearance="TableViewOnCustomCellAppearance"
                                               CustomRowAppearance="TableViewOnCustomRowAppearance"
                                               ShowFilterPopup="TableViewOnShowFilterPopup"
                                               IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                               Command="{Binding Path=HandleRowDoubleClickCommand, Mode=OneWay}"
                                                               PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="Параметры"
                                  ItemWidth="350"
                                  MinWidth="350"
                                  MaxWidth="500"
                                  AllowClose="False"
                                  AllowDrag="False"
                                  AllowDock="True"
                                  AutoHidden="False"
                                  FloatOnDoubleClick="False"
                                  behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsPanelClosed, Mode=TwoWay}">
                    <dxlc:LayoutControl Orientation="Vertical"
                                        IsEnabled="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                        ItemStyle="{StaticResource LayoutItemStyle}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutControlItemsBehaviour ItemsSource="{Binding Path=Parameters, Mode=OneWay}"
                                                                   ItemTemplateSelector="{StaticResource TemplateSelector}"
                                                                   RootGroupName="{Binding Path=Name, Mode=OneWay, ElementName=RootGroup}">
                            </behaviors:LayoutControlItemsBehaviour>
                        </dxmvvm:Interaction.Behaviors>
                        <dxlc:LayoutGroup Orientation="Vertical"
                                          x:Name="RootGroup" />
                        <dxlc:LayerSeparator Kind="Horizontal" />
                        <dxlc:LayoutItem Label="Записей"
                                         Height="20">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                <dxe:TextEdit EditValue="{Binding Path=DataSourceItems.Count, Mode=OneWay, FallbackValue=0}"
                                              IsPrintingMode="True"
                                              FontWeight="Bold" />
                                <dxe:TextEdit EditValue=" шт."
                                              IsPrintingMode="True" />
                            </StackPanel>
                        </dxlc:LayoutItem>
                        <dxlc:LayerSeparator Kind="Horizontal" />
                        <dxb:ToolBarControl GlyphSize="Small">
                            <dxb:BarButtonItem Content="Сформировать"
                                               Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                               Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                               GlyphAlignment="Left" />
                        </dxb:ToolBarControl>
                    </dxlc:LayoutControl>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>

</UserControl>