<UserControl x:Class="Telemart.Client.Views.Service.ServiceCenters.ServiceCentersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:serviceCenters="clr-namespace:Telemart.Client.ViewModels.Service.ServiceCenters"
             DataContext="{client:Container Type=serviceCenters:ServiceCentersViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type serviceCenters:ServiceCentersViewModel}}"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ServiceCenterRepairConfirmType.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        dxe:ValidationService.IsValidationContainer="True"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить (F5)"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Колонки"
                                   ToolTip="Колонки (F6)"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding ElementName=GridControl, Path=View}"
                                   IsEnabled="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   ToolTip="Создать сервисный центр (Insert)"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddServiceCenterCommand, Mode=OneWay}" />
                <dxb:BarButtonItem Content="Изменить"
                                   ToolTip="Изменить (F2)"
                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                   Command="{Binding Path=EditServiceCenterCommand, Mode=OneWay}"
                                   CommandParameter="{Binding Path=CurrentServiceCenter.Id, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxlc:LayerSeparator Height="1"
                             Kind="Horizontal" />
        <dxg:GridControl x:Name="GridControl"
                         ItemsSource="{Binding Path=ServiceCenters, Mode=OneWay}"
                         CurrentItem="{Binding Path=CurrentServiceCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectionMode="None"
                         ShowBorder="False">
            <dxg:GridControl.ShowLoadingPanel>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                    <Binding Path="RefreshCommand.IsExecuting" />
                </MultiBinding>
            </dxg:GridControl.ShowLoadingPanel>
            <!--<dxg:GridControl.Resources>
                <Style TargetType="dxg:GridColumn"
                       BasedOn="{StaticResource GeneralGridColumnStyle}" />
            </dxg:GridControl.Resources>-->
            <dxmvvm:Interaction.Behaviors>
                <dxmvvm:FocusBehavior />
                <behaviors:LayoutSerializationBehavior FileName="service_centers_1.xml" />
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Id"
                                Header="Код"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                HorizontalHeaderContentAlignment="Center"
                                FixedWidth="True"
                                Width="60"
                                MinWidth="24"
                                AllowMoving="False">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Type.Name"
                                Header="Тип"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FixedWidth="True"
                                AllowResizing="True"
                                AllowColumnFiltering="True"
                                FilterPopupMode="CheckedList"
                                AllowMoving="True"
                                AllowGrouping="True"
                                AllowSorting="True"
                                Width="80"
                                MinWidth="40" />
                <dxg:GridColumn FieldName="Name"
                                Header="Название"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FixedWidth="False"
                                AllowResizing="True"
                                AllowSorting="True"
                                AllowMoving="False"
                                MinWidth="80" />
                <dxg:GridColumn FieldName="CityId"
                                Header="Город"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FixedWidth="False"
                                AllowMoving="True"
                                AllowColumnFiltering="True"
                                AllowResizing="True"
                                AllowGrouping="True"
                                AllowSorting="True"
                                FilterPopupMode="CheckedList"
                                ColumnFilterMode="DisplayText"
                                MinWidth="80">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                                  DisplayMember="Name"
                                                  ValueMember="Id" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Employee"
                                Header="Ответственный"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FilterPopupMode="CheckedList"
                                ColumnFilterMode="DisplayText"
                                FixedWidth="False"
                                AllowMoving="True"
                                AllowGrouping="True"
                                AllowSorting="True"
                                AllowColumnFiltering="True"
                                AllowResizing="True"
                                MinWidth="80">
                </dxg:GridColumn>
                <dxg:GridColumn Header="СР"
                                HeaderToolTip="Согласование ремонта"
                                FieldName="RepairConfirmType"
                                FixedWidth="True"
                                Width="24"
                                MinWidth="24"
                                AllowBestFit="False"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowSorting="True"
                                AllowColumnFiltering="True"
                                FilterPopupMode="CheckedList"
                                DisplayTemplate="{StaticResource ServiceCenterRepairConfirmTypeColumnDisplayTemplate}">
                </dxg:GridColumn>
                <dxg:GridColumn Header="А"
                                HeaderToolTip="Активен"
                                FieldName="Active"
                                FixedWidth="True"
                                Width="24"
                                MinWidth="24"
                                AllowBestFit="False"
                                AllowResizing="False"
                                AllowGrouping="False"
                                AllowSorting="True"
                                AllowColumnFiltering="True"
                                FilterPopupMode="CheckedList"
                                HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dx:DXImage Width="16"
                                        Source="../../../Images/Common/tick.png"
                                        Visibility="{Binding Path=RowData.Row.Active, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               NavigationStyle="Cell"
                               AllowEditing="False"
                               AllowBestFit="True"
                               AllowSorting="True"
                               AllowDrop="False"
                               AllowGrouping="True"
                               ShowVerticalLines="True"
                               ShowHorizontalLines="True"
                               ShowIndicator="False"
                               AutoWidth="True"
                               UseEvenRowBackground="True"
                               AlternationCount="2"
                               ShowFilterPanelMode="Never">
                    <dxg:TableView.RowStyle>
                        <Style TargetType="dxg:RowControl">
                            <Setter Property="Opacity"
                                    Value="1" />
                            <Style.Triggers>
                                <DataTrigger Value="False">
                                    <DataTrigger.Binding>
                                        <Binding Path="Row.Active"
                                                 Mode="OneWay" />
                                    </DataTrigger.Binding>
                                    <Setter Property="Opacity"
                                            Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                               Command="{Binding Path=EditServiceCenterCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentServiceCenter.Id, Mode=OneWay}"
                                               PassEventArgsToCommand="False" />
                    </dxmvvm:Interaction.Behaviors>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem SummaryType="Count"
                                     Alignment="Right"
                                     Visible="True" />
            </dxg:GridControl.GroupSummary>
        </dxg:GridControl>
    </dxlc:LayoutControl>

</UserControl>