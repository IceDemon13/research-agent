<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.ChangeRequirementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:serviceRequests="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             DataContext="{client:Container Type=serviceRequests:ChangeRequirementViewModel}"
             Width="400"
             Height="360"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type serviceRequests:ChangeRequirementViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Требование">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=RequirementTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=RequirementType, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMember="Name" />
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup x:Name="ChangeLayoutGroup"
                                  Orientation="Vertical"
                                  VerticalAlignment="Top">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:IsEqualToVisibilityConverter}">
                            <Binding Path="RequirementType"
                                     Mode="OneWay" />
                            <Binding Source="{x:Static dictionaries:ServiceRequestRequirement.Change}"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <dxlc:LayoutItem Label="Товар">
                        <dxe:ButtonEdit EditValue="{Binding Path=ChangeOnProductName, Mode=OneWay, ValidatesOnDataErrors=True}"
                                        IsTextEditable="False"
                                        AllowDefaultButton="False">
                            <dxe:ButtonInfo ButtonKind="Simple"
                                            GlyphKind="Cancel"
                                            IsEnabled="{Binding Path=ChangeOnProductId, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}"
                                            Command="{Binding Path=RemoveProductCommand, Mode=OneWay}" />
                            <dxe:ButtonInfo ButtonKind="Simple"
                                            GlyphKind="Regular"
                                            Command="{Binding Path=SelectProductCommand, Mode=OneWay}" />
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="ReturnMoneyLayoutGroup"
                                  Orientation="Vertical"
                                  Visibility="{Binding Path=ReturnMoneyVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Top">
                    <dxlc:LayoutItem Label="Оплата">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=ReturnMoneyPaymentTypes, Mode=OneWay}"
                                          EditValue="{Binding Path=ReturnMoneyPaymentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          AllowNullInput="True"
                                          NullValue="{x:Null}"
                                          NullText="{StaticResource NullTextValue}"
                                          NullValueButtonPlacement="EditBox" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem x:Name="CashboxLayoutItem"
                                     Label="Касса"
                                     Visibility="{Binding Path=CashboxVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                          EditValue="{Binding Path=Cashbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          Style="{StaticResource SearchableComboBoxStyle}" />
                    </dxlc:LayoutItem>
                    <common:RequisitesView x:Name="RequisitesView" Model="{Binding Path=Requisites, Mode=OneWay}"/>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="RepairLayoutGroup"
                                  Orientation="Vertical"
                                  VerticalAlignment="Top">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:IsEqualToVisibilityConverter}">
                            <Binding Path="RequirementType"
                                     Mode="OneWay" />
                            <Binding Source="{x:Static dictionaries:ServiceRequestRequirement.Repair}"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <dxlc:LayoutItem Label="Срок">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=RepairDaysCollection, Mode=OneWay}"
                                          EditValue="{Binding Path=RepairDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          ValueMember="Id" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Тип ремонта">
                        <RadioButton Content="Гарантийный"
                                     IsChecked="True" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dx:SimpleButton Content="Изменить"
                                 Command="{Binding Path=OkCommand, Mode=OneWay}"
                                 HorizontalAlignment="Right">
                    <dx:SimpleButton.IsEnabled>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter}">
                            <Binding Path="(dxe:ValidationService.HasValidationError)"
                                     Mode="OneWay"
                                     ElementName="LayoutControl"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                            <Binding Path="IsValid"
                                     Mode="OneWay"
                                     ElementName="RequisitesView" />
                        </MultiBinding>
                    </dx:SimpleButton.IsEnabled>
                </dx:SimpleButton>
                <dx:SimpleButton Content="Отмена"
                                 HorizontalAlignment="Right"
                                 Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>