<UserControl x:Class="Telemart.Client.Views.SalesMap.SalesMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxmt="http://schemas.devexpress.com/winfx/2008/xaml/map/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.SalesMap"
             xmlns:salesmap="clr-namespace:Telemart.Client.Views.SalesMap"
             xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:contrs="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:SalesMapViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SalesMapViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="bubbleTemplate">
                <controls:CircleBorder Radius="{Binding Converter={salesmap:OrdersCountToRadiusConverter}}"
                                       Background="{Binding MapItem.Brush}"
                                       BorderBrush="Black"
                                       BorderThickness="1">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Converter={salesmap:OrdersCountToTextConverter}}">
                    </TextBlock>
                    <Border.ToolTip>
                        <ToolTip Placement="Top">
                            <ToolTip.Triggers>
                                <EventTrigger RoutedEvent="ToolTip.Opened">
                                    <BeginStoryboard>
                                        <Storyboard TargetProperty="Opacity">
                                            <DoubleAnimation From="0.0" To="1.0" Duration="0:0:0.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ToolTip.Triggers>
                            <ToolTip.Template>
                                <ControlTemplate x:Name="ToolTipTemplate">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True">
                                        <Border Background="{dxi:ThemeResource {dxmt:MapBrushesThemeKey ResourceKey=ToolTipBackground}}" />
                                        <ContentPresenter Content="{Binding}">
                                            <ContentPresenter.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="8"
                                                               Text="{Binding Converter={salesmap:OrdersCountToTooltipConverter}}"
                                                               FontSize="14"
                                                               TextWrapping="Wrap"
                                                               Foreground="{dxi:ThemeResource {dxmt:MapBrushesThemeKey ResourceKey=ToolTipForeground}}" />
                                                </DataTemplate>
                                            </ContentPresenter.ContentTemplate>
                                        </ContentPresenter>
                                    </Grid>
                                </ControlTemplate>
                            </ToolTip.Template>
                        </ToolTip>
                    </Border.ToolTip>
                </controls:CircleBorder>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Top"
                          ItemSpace="0">
            <dxb:BarManager>
                <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                    <dxb:BarItemSeparator />
                    <contrs:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Margin="0"
                              Orientation="Horizontal">
                <dxdo:LayoutGroup Orientation="Vertical">
                    <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                      AllowSizing="True">
                        <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}"
                                             OwnerLock="LoadingContent">
                            <dxm:MapControl x:Name="Map"
                                            CenterPoint="48.457,35.006"
                                            ZoomLevel="14"
                                            MouseDown="Map_MouseDown">
                                <dxm:ImageLayer>
                                    <dxm:BingMapDataProvider Kind="{Binding Path=AppliedMapKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             CultureName="ru-RU"
                                                             BingKey="zN3yopy4aCQ8xAyY2rnk~rzv96-K5gtr1YgAKR-5xlA~ApjY7d3PMqEH2DcGe7hJC-5rjDbtEbriCobNUwq1_S-SUrknzey0rwOpyRnkF0wo"/>
                                </dxm:ImageLayer>
                                <dxm:VectorLayer x:Name="ItemLayer">
                                    <dxm:VectorLayer.Colorizer>
                                        <dxm:KeyColorColorizer>
                                            <dxm:KeyColorColorizer.Colors>
                                                <Color>#FFFF5D6A</Color>
                                                <Color>#FF417CD9</Color>
                                                <Color>#FFFFDD74</Color>
                                                <Color>#16732D</Color>
                                                <Color>#FF8C68C3</Color>
                                                <Color>#000000</Color>
                                                <Color>#FFFFFF</Color>
                                                <Color>#FFAC14</Color>
                                                <Color>#41FAB3</Color>
                                                <Color>#686968</Color>
                                                <Color>#4503FC</Color>
                                                <Color>#2BFF00</Color>
                                                <Color>#FF4800</Color>
                                                <Color>#4A2B2B</Color>
                                                <Color>#432B4A</Color>
                                            </dxm:KeyColorColorizer.Colors>
                                            <dxm:KeyColorColorizer.ItemKeyProvider>
                                                <dxm:AttributeItemKeyProvider AttributeName="CarryName" />
                                            </dxm:KeyColorColorizer.ItemKeyProvider>
                                        </dxm:KeyColorColorizer>
                                    </dxm:VectorLayer.Colorizer>

                                    <dxm:ListSourceDataAdapter DataSource="{Binding Items}">
                                        <dxm:ListSourceDataAdapter.Clusterer>
                                            <dxm:DistanceBasedClusterer StepInPixels="40">
                                                <dxm:DistanceBasedClusterer.GroupProvider>
                                                    <dxm:AttributeGroupProvider AttributeName="CarryName"/>
                                                </dxm:DistanceBasedClusterer.GroupProvider>
                                                <dxm:DistanceBasedClusterer.ClusterSettings>
                                                    <dxm:MapCustomElementSettings ContentTemplate="{StaticResource bubbleTemplate}"/>
                                                </dxm:DistanceBasedClusterer.ClusterSettings>
                                            </dxm:DistanceBasedClusterer>
                                        </dxm:ListSourceDataAdapter.Clusterer>

                                        <dxm:ListSourceDataAdapter.ItemSettings>
                                            <dxm:MapCustomElementSettings>
                                                <dxm:MapCustomElementSettings.Template>
                                                    <ControlTemplate>
                                                        <ContentControl ContentTemplate="{StaticResource bubbleTemplate}"
                                                                        Content="{Binding}"/>
                                                    </ControlTemplate>
                                                </dxm:MapCustomElementSettings.Template>
                                            </dxm:MapCustomElementSettings>
                                        </dxm:ListSourceDataAdapter.ItemSettings>

                                        <dxm:ListSourceDataAdapter.AttributeMappings>
                                            <dxm:MapItemAttributeMapping Member="CarryName"
                                                                         Name="CarryName" />
                                            <dxm:MapItemAttributeMapping Member="OrdersCount"
                                                                         Name="OrdersCount" />
                                        </dxm:ListSourceDataAdapter.AttributeMappings>

                                        <dxm:ListSourceDataAdapter.Mappings>
                                            <dxm:MapItemMappingInfo Longitude="Longitude"
                                                                    Latitude="Latitude"/>
                                        </dxm:ListSourceDataAdapter.Mappings>
                                    </dxm:ListSourceDataAdapter>

                                </dxm:VectorLayer>
                                <dxm:MapControl.Legends>
                                    <dxm:ColorListLegend Alignment="TopRight"
                                                         Layer="{Binding Source={x:Reference ItemLayer}}"
                                                         Header="Точки выдачи" >
                                    </dxm:ColorListLegend>
                                </dxm:MapControl.Legends>
                                <dxm:MapControl.CoordinatesPanelOptions>
                                    <dxm:CoordinatesPanelOptions Margin="10,10,10,53" />
                                </dxm:MapControl.CoordinatesPanelOptions>
                                <dxm:MapControl.ScalePanelOptions>
                                    <dxm:ScalePanelOptions Margin="10,10,10,39" />
                                </dxm:MapControl.ScalePanelOptions>
                            </dxm:MapControl>
                        </dx:LoadingDecorator>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500"
                                  Orientation="Vertical">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      AllowHide="True"
                                      ItemWidth="340"
                                      FloatOnDoubleClick="False"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelOpened, Mode=TwoWay}">
                        <dxlc:LayoutControl Orientation="Vertical"
                                            ItemStyle="{StaticResource LayoutItemStyle}"
                                            IsEnabled="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxlc:LayoutItem Label="Дата X">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Order/Filter/calendar.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxlc:LayoutGroup Orientation="Horizontal"
                                                  VerticalAlignment="Center">
                                    <dxe:DateEdit EditValue="{Binding Path=DeliveryTimeAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                    <TextBlock Text="-"
                                               Width="8"
                                               TextAlignment="Center" />
                                    <dxe:DateEdit EditValue="{Binding Path=DeliveryTimeBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:DateEdit>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Доставка">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="/Images/Common/lorry_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Carries, Mode=OneWay}"
                                                  DisplayMember="Name"
                                                  EditValue="{Binding Path=SelectedCarries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource CheckedTokenComboBoxStyle}">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Карта">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="/Images/Common/world_16x16.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=MapKinds, Mode=OneWay}"
                                                  DisplayMember="Item1"
                                                  EditValue="{Binding Path=SelectedMapKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal" />
                            <dxlc:LayoutItem Label="Точек выдачи">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode=OneWay}"
                                                   Margin="24,0,0,0" />
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal" />
                            <dxlc:LayoutItem>
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       GlyphAlignment="Left"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       GlyphAlignment="Left"
                                                       Command="{Binding Path=ResetFilterCommand, Mode=OneWay}" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutControl>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>
</UserControl>