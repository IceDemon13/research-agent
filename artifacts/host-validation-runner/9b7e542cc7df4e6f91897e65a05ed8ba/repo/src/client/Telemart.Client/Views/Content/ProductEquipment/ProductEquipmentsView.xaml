<UserControl x:Class="Telemart.Client.Views.Content.ProductEquipment.ProductEquipmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Content.ProductEquipments"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:ProductEquipmentsViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:ProductEquipmentsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ProductInfoType.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:OpenFileDialogService x:Name="ImportFromExcelFileDialogService"
                                      Title="Выберите Excel файл для импорта"
                                      AddExtension="True"
                                      RestorePreviouslySelectedDirectory="True"
                                      Filter="Excel Workbook|*.xlsx"
                                      CheckFileExists="True"
                                      CheckPathExists="True" />
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxb:BarManager VerticalAlignment="Top">
            <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxb:BarButtonItem Content="Очистить"
                                   LargeGlyph="{dx:DXImage Image=New_32x32.png}"
                                   Glyph="{dx:DXImage Image=New_16x16.png}"
                                   Command="{Binding Path=ClearCommand, Mode=OneTime}" />
                <dxb:BarSubItem Content="Добавить"
                                LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                Glyph="{dx:DXImage Image=Add_16x16.png}"
                                BarItemDisplayMode="ContentAndGlyph"
                                GlyphAlignment="Top"
                                ItemLinksSource="{Binding ProductInfoTypes}">
                    <dxb:BarSubItem.ItemTemplate>
                        <DataTemplate DataType="dictionaries:ProductInfoType">
                            <ContentControl>
                                <dxb:BarButtonItem Content="{Binding AddButtonTitle}"
                                                   ToolTip="{Binding AddButtonTitle}"
                                                   Glyph="{Binding Id, Converter={StaticResource ProductInfoTypeConverter}}"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=DataContext.AddCommand, ElementName=LayoutControl}"
                                                   CommandParameter="{Binding}" />
                            </ContentControl>
                        </DataTemplate>
                    </dxb:BarSubItem.ItemTemplate>
                </dxb:BarSubItem>
                <dxb:BarButtonItem Content="Удалить"
                                   ToolTip="Удалить (Del)"
                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                   Command="{Binding Path=DeleteCommand, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Сохранить"
                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                   Glyph="{dx:DXImage Image=Save_16x16.png}"
                                   Command="{Binding Path=SaveCommand, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxlc:LayerSeparator Height="1"
                             Kind="Horizontal" />
        <dxg:GridControl x:Name="GridControl"
                         CurrentItem="{Binding Path=SelectedEquipment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ItemsSource="{Binding Path=Equipments, Mode=OneWay}"
                         ShowBorder="False"
                         SelectionMode="None"
                         DesignTimeDataObjectType="{x:Type viewModels:ProductEquipmentViewItem}">
            <dxg:GridControl.ShowLoadingPanel>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                    <Binding Path="AddCommand.IsExecuting" />
                    <Binding Path="SaveCommand.IsExecuting" />
                </MultiBinding>
            </dxg:GridControl.ShowLoadingPanel>
            <dxmvvm:Interaction.Behaviors>
                <behaviors:LayoutSerializationBehavior FileName="product_equipments.xml" />
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Тип"
                                HeaderToolTip="Тип"
                                FieldName="Type.Name"
                                FixedWidth="True"
                                Width="100" />
                <dxg:GridColumn Header="Название"
                                HeaderToolTip="Название"
                                FieldName="ExcelProductName" />
                <dxg:GridColumn Header="Товар"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FieldName="ProductName">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <dxe:TextEdit x:Name="PART_Editor" />
                                <dx:SimpleButton Grid.Column="1"
                                                 Command="{Binding Path=DataContext.SelectProductCommand, Mode=OneWay, ElementName=LayoutControl}"
                                                 Content="..."
                                                 Width="20"
                                                 MinWidth="20"
                                                 Height="20"
                                                 Padding="1" />
                            </Grid>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True"
                               AllowEditing="False"
                               NavigationStyle="Cell"
                               ShowIndicator="False"
                               ShowAutoFilterRow="False"
                               ShowFixedTotalSummary="False"
                               IsTotalSummaryMenuEnabled="False"
                               ShowTotalSummary="False"
                               ShowGroupPanel="False"
                               AllowGrouping="False"
                               AllowMoveColumnToDropArea="False"
                               AllowColumnMoving="False"
                               AllowColumnFiltering="False"
                               AllowSorting="True"
                               AllowResizing="True" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </dxlc:LayoutControl>
</UserControl>


