<UserControl x:Class="Telemart.Client.Views.Backlog.BacklogTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Backlog"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:BacklogTasksViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:BacklogTasksViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Priority.xaml" />
                <ResourceDictionary>
                    <converters:BacklogStatusSelectedItemConverter x:Key="StatusSelectedItemsConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Horizontal"
                        Padding="0"
                        ItemSpace="0">
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0"
                              Margin="0">
                <dxdo:LayoutPanel Caption="Категории"
                                  AllowClose="False"
                                  AllowDrag="False"
                                  AllowDock="True"
                                  AutoHidden="False"
                                  FloatOnDoubleClick="False"
                                  ShowPinButton="False"
                                  MinWidth="150"
                                  MaxWidth="400"
                                  ItemWidth="200">
                    <dxg:GridControl ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectionMode="None"
                                     ShowBorder="False">
                        <dxg:GridControl.ShowLoadingPanel>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="RefreshCommand.IsExecuting" />
                                <Binding Path="HandleLoadedCommand.IsExecuting" />
                            </MultiBinding>
                        </dxg:GridControl.ShowLoadingPanel>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name"
                                            VisibleIndex="0"
                                            SortIndex="1"
                                            SortOrder="Ascending" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TreeListView AutoExpandAllNodes="True"
                                              TreeDerivationMode="Selfreference"
                                              KeyFieldName="Id"
                                              ParentFieldName="ParentId"
                                              ShowColumnHeaders="False"
                                              NavigationStyle="Row"
                                              FilterMode="Extended"
                                              ShowSearchPanelMode="Always"
                                              SearchPanelHighlightResults="True"
                                              ExpandNodesOnFiltering="True"
                                              AllowEditing="False"
                                              AllowBestFit="True"
                                              AllowSorting="False"
                                              AllowDrop="False"
                                              ShowVerticalLines="False"
                                              ShowHorizontalLines="False"
                                              ShowIndicator="False"
                                              TreeLineStyle="Solid"
                                              AutoWidth="True"
                                              ShowExpandButtons="True"
                                              ShowFilterPanelMode="Never"
                                              UseEvenRowBackground="False">
                                <dxg:TreeListView.FormatConditions>
                                    <dxg:FormatCondition Expression="[ParentId] IS NOT NULL">
                                        <dx:Format FontStyle="Italic" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] &lt; 1">
                                        <dx:Format Foreground="DarkGray" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] = 0">
                                        <dx:Format TextDecorations="Strikethrough" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Marked] = 1">
                                        <dx:Format Foreground="Green" />
                                    </dxg:FormatCondition>
                                </dxg:TreeListView.FormatConditions>
                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Padding="0"
                                  MinHeight="230"
                                  Style="{StaticResource PanelStyle}">

                    <dxlc:LayoutGroup Orientation="Vertical"
                                      ItemSpace="0">
                            <dxb:BarManager VerticalAlignment="Top">
                                <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                                    <dxb:BarCheckItem Content="Избранные"
                                      ToolTip="Избранные"
                                      LargeGlyph="/Images/Common/star_32x32.png"
                                      Glyph="/Images/Common/star_16x16.png"
                                      IsChecked="{Binding Path=ShowOnlyFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarButtonItem Content="Создать"
                                                       ToolTip="Создать (Insert)"
                                                       LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                       Command="{Binding Path=AddCommand, Mode=OneTime}"
                                                       IsVisible="{Binding Path=CanCreate, Mode=OneWay}" />

                                    <dxb:BarSplitButtonItem Content="Изменить"
                                                            ToolTip="Изменить (F2)"
                                                            LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                                            Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                            GlyphAlignment="Top"
                                                            ArrowAlignment="Right"
                                                            BarItemDisplayMode="ContentAndGlyph"
                                                            IsEnabled="{Binding Path=SelectedTask, Converter={dxmvvm:ObjectToBooleanConverter}}"
                                                            Command="{Binding Path=EditCommand, Mode=OneTime}">
                                        <dxb:BarSplitButtonItem.PopupControl>
                                            <dxb:PopupMenu>
                                                <dxb:BarButtonItem Content="Уточнить"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Order/add_from_template.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.SpecifyBacklogTaskCommand, Mode=OneTime}" />
                                                <dxb:BarButtonItem Content="Передать в IT"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Common/android_16x16.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.TransferToItBacklogTaskCommand, Mode=OneTime}" />
                                                <dxb:BarButtonItem Content="Создать в Jira"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Common/cheque.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.CreateInJiraBacklogTaskCommand, Mode=OneTime}" />
                                                <dxb:BarButtonItem Content="Добавить в план"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Common/calendar_edit.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.AddToPlanBacklogTaskCommand, Mode=OneTime}" />
                                                <dxb:BarButtonItem Content="Отменить задачу"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Common/canceled.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.CancelBacklogTaskCommand, Mode=OneTime}" />
                                                <dxb:BarButtonItem Content="Завершить задачу"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Common/tick.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.CompleteBacklogTaskCommand, Mode=OneTime}" />
                                                <dxb:BarButtonItem Content="Реализовать"
                                                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                                                   Glyph="/Images/Common/tick_grey_16x16.png"
                                                                   BarItemDisplayMode="ContentAndGlyph"
                                                                   GlyphAlignment="Top"
                                                                   CommandParameter="{Binding Path=SelectedTask, Mode=OneWay}"
                                                                   Command="{Binding Path=DocumentCommands.RealizeBacklogTaskCommand, Mode=OneTime}" />
                                            </dxb:PopupMenu>
                                        </dxb:BarSplitButtonItem.PopupControl>
                                    </dxb:BarSplitButtonItem>
                                    <dxb:BarButtonItem Content="Квоты"
                                                       ToolTip="Квоты"
                                                       GlyphAlignment="Top"
                                                       BarItemDisplayMode="ContentAndGlyph"
                                                       LargeGlyph="../../Images/Common/session_idle_time.png"
                                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                       Command="{Binding Path=OpenQuotasCommand, Mode=OneTime}"/>
                                    <dxb:BarItemSeparator />
                                    <controls:WikiBarButtonItem />
                                </dxb:ToolBarControl>
                            </dxb:BarManager>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Tasks, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedTask, Mode=TwoWay}"
                                     ShowBorder="False"
                                     SelectionMode="None"
                                     AutoExpandAllGroups="True"
                                     ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="backlog_tasks_1.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Код"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Id"
                                            FixedWidth="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            MinWidth="48"
                                            Width="48">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Приоритет"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Priority"
                                            MinWidth="24"
                                            Width="85"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowAutoFilter="False"
                                            AllowSorting="True"
                                            FixedWidth="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            DisplayTemplate="{StaticResource PriorityColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Название"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Name"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowSorting="False"
                                            AllowColumnFiltering="False" />
                            <dxg:GridColumn Header="Битрикс"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="BitrixId"
                                            FixedWidth="True"
                                            Width="60"
                                            MinWidth="60"
                                            AllowBestFit="True"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="False"
                                            AllowSorting="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:HyperlinkEdit x:Name="PART_Editor"
                                                           HorizontalAlignment="Center"
                                                           AllowAutoNavigate="True"
                                                           RequestNavigation="BitrixId_OnRequestNavigation" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="JIRA"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="JiraId"
                                            FixedWidth="True"
                                            Width="60"
                                            MinWidth="60"
                                            AllowBestFit="True"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowAutoFilter="False"
                                            AllowColumnFiltering="False"
                                            AllowSorting="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:HyperlinkEdit x:Name="PART_Editor"
                                                           HorizontalAlignment="Center"
                                                           AllowAutoNavigate="True"
                                                           RequestNavigation="JiraId_OnRequestNavigation" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="State"
                                            Width="130"
                                            MinWidth="24"
                                            FixedWidth="True"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="Value"
                                            FilterPopupMode="CheckedList" />
                            <dxg:GridColumn Header="Est."
                                            HeaderToolTip="Время на разработку"
                                            FieldName="Estimate"
                                            FixedWidth="True"
                                            Width="40"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="False"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создал"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="CreatedBy"
                                            FixedWidth="True"
                                            Width="150"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            Visible="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=DataContext.AllEmployees, Mode=OneWay, ElementName=GridControl}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создана"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="CreatedOn"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="60"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="Date">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          NullText=""
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Заказчик"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="AuthorId"
                                            FixedWidth="True"
                                            Width="150"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="Value"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=DataContext.ActiveEmployees, Mode=OneWay, ElementName=GridControl}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Ответственный"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="Employee"
                                            FixedWidth="True"
                                            Width="150"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowSorting="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList" />
                            <dxg:GridColumn Header="Комментарий"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="Comment"
                                            FixedWidth="True"
                                            Width="150"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowSorting="False"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings TextTrimming="CharacterEllipsis"
                                                          AcceptsReturn="False"
                                                          DisplayTextConverter="{converters:MultiLineToSingleLineTextConverter}"
                                                          ShowTooltipForTrimmedText="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           IsTotalSummaryMenuEnabled="False"
                                           ShowTotalSummary="False"
                                           AllowGrouping="True"
                                           CustomCellAppearance="TableView_OnCustomCellAppearance"
                                           CustomRowAppearance="TableView_OnCustomRowAppearance"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="ShowFilterPopup"
                                                           Command="{Binding Path=ShowFilterPopupHandlerCommand, Mode=OneWay}"
                                                           PassEventArgsToCommand="True" />
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                        </dxg:GridControl.GroupSummary>
                    </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxdo:LayoutPanel>
                <dxdo:LayoutGroup Orientation="Vertical"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500">
                    <dxdo:LayoutPanel Caption="Поиск"
                                      ItemWidth="340"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowDock="True"
                                      AutoHidden="False"
                                      FloatOnDoubleClick="False"
                                      IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                      behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <dxlc:LayoutControl Name="FilterLayoutControl"
                                                Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Задача">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/accordion_32x32.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxg:PrintTextEdit EditValue="{Binding Path=Filter.TaskNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:PrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Битрикс">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/bitrix24.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxg:PrintTextEdit EditValue="{Binding Path=Filter.BitrixIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:PrintTextEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Заказчик">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/user.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Employees, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedAuthor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="DisplayValue"
                                                      Style="{StaticResource TokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Ответственный">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/user.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.ResponsibleEmployees, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedEmployees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="DisplayValue"
                                                      Style="{StaticResource TokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Статус">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/lightbulb.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Statuses, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      EditValue="{Binding Path=Filter.SelectedStatuses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StatusSelectedItemsConverter}}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Категория"
                                                 LabelVerticalAlignment="Top"
                                                 VerticalAlignment="Stretch"
                                                 MaxHeight="500">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Parser/folders_16_16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                        <dxg:GridControl x:Name="CategoriesGridControl"
                                                         ItemsSource="{Binding Path=Filter.Categories, Mode=OneWay}"
                                                         SelectionMode="Row">
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="Name" />
                                            </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView x:Name="TreeListView"
                                                                  TreeDerivationMode="Selfreference"
                                                                  ShowColumnHeaders="False"
                                                                  ShowCheckboxes="True"
                                                                  AllowRecursiveNodeChecking="True"
                                                                  KeyFieldName="Id"
                                                                  ParentFieldName="ParentId"
                                                                  CheckBoxFieldName="Checked"
                                                                  NavigationStyle="Row"
                                                                  FilterMode="Extended"
                                                                  ShowSearchPanelMode="Always"
                                                                  SearchPanelHighlightResults="True"
                                                                  ExpandNodesOnFiltering="True"
                                                                  AllowBestFit="True"
                                                                  AllowSorting="False"
                                                                  AllowDrop="False"
                                                                  ShowVerticalLines="False"
                                                                  ShowHorizontalLines="False"
                                                                  FetchSublevelChildrenOnExpand="False"
                                                                  ShowIndicator="False"
                                                                  TreeLineStyle="Solid"
                                                                  AutoWidth="True"
                                                                  ShowFilterPanelMode="Never"
                                                                  AutoExpandAllNodes="False"
                                                                  ShowExpandButtons="True"
                                                                  UseEvenRowBackground="False">
                                                </dxg:TreeListView>
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Задач">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=Tasks.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxb:ToolBarControl GlyphSize="Small">
                                    <dxb:BarButtonItem Content="Применить"
                                                       Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Отмена"
                                                       Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                       Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                       GlyphAlignment="Left" />
                                </dxb:ToolBarControl>
                            </dxlc:LayoutControl>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>
</UserControl>