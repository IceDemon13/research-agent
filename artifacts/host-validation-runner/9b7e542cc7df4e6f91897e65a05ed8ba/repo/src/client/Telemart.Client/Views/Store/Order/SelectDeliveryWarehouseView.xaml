<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.SelectDeliveryWarehouseView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              DataContext="{client:Container Type=viewModels:SelectDeliveryWarehouseViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="800"
                              d:DesignHeight="600"
                              d:DataContext="{d:DesignInstance Type=viewModels:SelectDeliveryWarehouseViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="LabelBoldStyle"
                           TargetType="dxlc:LayoutItemLabel">
                        <Setter Property="FontWeight"
                                Value="Bold" />
                    </Style>
                    <Style TargetType="dxg:GridColumn"
                           BasedOn="{StaticResource GeneralGridColumnStyle}">
                        <Setter Property="AllowSorting"
                                Value="True" />
                    </Style>
                    <system:Double x:Key="Zero">0</system:Double>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutControl">
        <dxlc:LayoutGroup Orientation="Vertical">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutItem Label="Текущий"
                                 LabelStyle="{StaticResource LabelBoldStyle}"
                                 AddColonToLabel="True">
                    <TextBlock Text="{Binding OldAddressValue, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup>
                <dxg:GridControl ItemsSource="{Binding Path=Places, Mode=OneWay}"
                                 CurrentItem="{Binding Path=Place, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionMode="None">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Number"
                                        Header="№"
                                        Width="50" />
                        <dxg:GridColumn FieldName="PlaceName"
                                        Header="Адрес"
                                        AllowResizing="True"
                                        FixedWidth="False" />
                        <dxg:GridColumn FieldName="LimitPostFinance"
                                        Header="Лимит"
                                        HeaderToolTip="Максимально допустимая сумма к оплате"
                                        MinWidth="70"
                                        Width="70"
                                        FixedWidth="True"
                                        Visible="{Binding IsVisibleColumnLimit, Mode=OneWay}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                                      DisplayFormat="{}{0} грн."
                                                      NullValue="{StaticResource Zero}"
                                                      NullText="∞" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="TotalMaxWeightAllowed"
                                        Header="Вес"
                                        HeaderToolTip="Максимальный вес"
                                        MinWidth="55"
                                        Width="55"
                                        FixedWidth="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                                      DisplayFormat="{}{0} кг"
                                                      NullValue="{StaticResource Zero}"
                                                      NullText="∞" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AutoWidth="True"
                                       NavigationStyle="Row"
                                       ShowGroupPanel="False"
                                       ShowIndicator="False"
                                       ShowSearchPanelMode="Always"
                                       ShowSearchPanelFindButton="True"
                                       IsColumnMenuEnabled="False"
                                       IsColumnChooserVisible="False">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding Path=RowDoubleClickCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                                <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                                                       Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="HandleLoadedCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Загрузка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  Orientation="Horizontal">
                    <dx:SimpleButton Content="OK"
                                     IsTabStop="True"
                                     Command="{Binding Path=OkCommand, Mode=OneWay}" />
                    <dx:SimpleButton Content="Отмена"
                                     IsTabStop="True"
                                     Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</controls:TelemartUserControl>