<controls:TelemartUserControl x:Class="Telemart.Client.Views.PromoCode.PromoCodeView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.PromoCode"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:promoCode="clr-namespace:Telemart.Client.Views.PromoCode"
             xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             DataContext="{client:Container Type=viewModels:PromoCodeViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:PromoCodeViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ComboBoxReadOnlyConditionsStyle"
                   TargetType="dxe:ComboBoxEdit">
                <Setter Property="IsReadOnly"
                        Value="True" />
                <Setter Property="Opacity"
                        Value="{StaticResource DisabledElementOpacity}" />
                <Setter Property="AllowDefaultButton"
                        Value="False" />
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="DataContext.IsNewOrIsLockedByCurrentEmployee"
                                         ElementName="CurrentUserControl"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="IsReadOnly"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource EnabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      VerticalAlignment="Top">
                        <dxlc:LayoutItem Label="Тип">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.TypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              ValueMember="Id"
                                              DisplayMember="Name"
                                              AllowNullInput="False"
                                              Style="{StaticResource ComboBoxReadOnlyConditionsStyle}"
                                              IsReadOnly="{Binding Path=AllowEditAllData, Converter={dxmvvm:BooleanNegationConverter}}">
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Действует">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxe:DateEdit EditValue="{Binding Path=Model.DateStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource DateEditReadOnlyConditionsStyle}"/>
                                <TextBlock Text="-"
                                           HorizontalAlignment="Left"/>
                                <dxe:DateEdit EditValue="{Binding Path=Model.DateEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource DateEditReadOnlyConditionsStyle}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Промокод">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            Mask="[A-Z0-9-]+"
                                            MaskType="RegEx"
                                            CharacterCasing="Upper"
                                            IsReadOnly="{Binding Path=AllowEdit, Converter={dxmvvm:BooleanNegationConverter}}">
                                <dxe:ButtonInfo ButtonKind="Simple"
                                                GlyphKind="Refresh"
                                                ToolTip="Сгенерировать"
                                                Visibility="{Binding Path=IsNew, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                Command="{Binding Path=GeneratePromoCodeCommand, Mode=OneTime}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Label="План продаж">
                            <dxe:TextEdit EditValue="{Binding Path=Model.SellPlan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          Mask="F0"
                                          AllowNullInput="True"
                                          EditValueType="{x:Type system:Int32}"
                                          MaskType="Numeric"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Заголовок">
                            <dxe:TextEdit EditValue="{Binding Path=Model.MetaTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Заголовок (укр)">
                            <dxe:TextEdit EditValue="{Binding Path=Model.MetaTitleUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Заголовок (англ)">
                            <dxe:TextEdit EditValue="{Binding Path=Model.MetaTitleEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Описание"
                                         VerticalAlignment="Stretch">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          VerticalContentAlignment="Top"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Описание (укр)"
                                         VerticalAlignment="Stretch">
                            <dxe:TextEdit EditValue="{Binding Path=Model.DescriptionUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          VerticalContentAlignment="Top"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Описание (англ)"
                                         VerticalAlignment="Stretch">
                            <dxe:TextEdit EditValue="{Binding Path=Model.DescriptionEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          VerticalContentAlignment="Top"
                                          IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Активная">
                            <dxe:CheckEdit EditValue="{Binding Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                           IsEnabled="{Binding Path=IsNewOrIsLockedByCurrentEmployee, UpdateSourceTrigger=PropertyChanged}"
                                           IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Отобр. в карточке"
                                         VerticalAlignment="Bottom">
                            <dxe:CheckEdit EditValue="{Binding Path=Model.ShowInSite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                           IsReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                           Style="{StaticResource ReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <common:SummaryItemsView SummaryItems="{Binding Path=SummaryViewItems, Mode=OneWay}"
                                             LabelColumnWidth="*"
                                             ContentColumnWidth="2*"
                                             Width="200"
                                             Visibility="{Binding Path=IsNew, Converter={dx:BooleanToVisibilityConverter Invert=True}}"/>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="0"
                                  Visibility="{Binding Path=IsProductsBlockVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                  View="GroupBox"
                                  GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="{Binding Path=AllowEdit, Mode=OneWay}">
                        <dxb:BarSubItem Content="Добавить"
                                        Glyph="{dx:DXImage Image=Add_16x16.png}">
                            <dxb:BarButtonItem Content="Товар"
                                               ToolTip="Товар"
                                               Glyph="../../Images/NavigationMenu/box_front_open.png"
                                               Command="{Binding Path=AddProductCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Категорию"
                                               ToolTip="Категорию"
                                               Glyph="../../Images/NavigationMenu/folder_wrench.png"
                                               Command="{Binding Path=AddCategoryCommand, Mode=OneTime}" />
                        </dxb:BarSubItem>
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteProductCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}">
                        </dxb:BarButtonItem>
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Model.Products, Mode=OneWay}"
                                     SelectionMode="Cell"
                                     ShowBorder="False">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Style>
                            <Style TargetType="dxg:GridControl"
                                   BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource EnabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:GridControl.Style>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Объект"
                                            FieldName="CategoryId"
                                            HeaderToolTip="Объект"
                                            AllowEditing="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Path=RowData.Row.IsProduct, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                                                <dx:DXImage Source="../../Images/NavigationMenu/box_front_open.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            Margin="5,0,0,0" />
                                                <TextBlock Text="{Binding Path=RowData.Row.ProductName, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Background="Transparent"
                                                           Margin="5,0,0,0" />
                                            </StackPanel>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                              IsReadOnly="True"
                                                              ItemsSource="{Binding Path=DataContext.Categories, ElementName=LayoutControl}"
                                                              ApplyItemTemplateToSelectedItem="True"
                                                              IsTextEditable="False"
                                                              ValueMember="Id"
                                                              Visibility="{Binding Path=RowData.Row.IsProduct, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                                                <dxe:ComboBoxEdit.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <dx:DXImage Source="../../Images/NavigationMenu/folder_wrench.png"
                                                                        Height="16"
                                                                        Width="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,0,0,0" />
                                                            <TextBlock Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Background="Transparent"
                                                                       Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </dxe:ComboBoxEdit.ItemTemplate>

                                            </dxe:ComboBoxEdit>
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DiscountModeId"
                                            Header="Тип"
                                            HeaderToolTip="Тип скидки"
                                            FixedWidth="True"
                                            AllowEditing="{Binding Path=AllowEditAllData}"
                                            Width="120">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding Converter={promoCode:IsProductToDiscountModesConverter}}"
                                                          DisplayMember="Name"
                                                          ValueMember="Id"/>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Amount"
                                            Header="Значение скидки"
                                            HeaderToolTip="Значение скидки"
                                            AllowEditing="{Binding Path=AllowEditAllData}"
                                            Width="110"
                                            MinWidth="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="N0"
                                                          AllowNullInput="True"
                                                          MaskType="Numeric"
                                                          HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ShowInSite"
                                            Header="К"
                                            HeaderToolTip="Отображать в карточке товара"
                                            FixedWidth="True"
                                            AllowEditing="{Binding Path=IsNewOrIsLockedByCurrentEmployee}"
                                            Width="26">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           EnableImmediatePosting="True"
                                           EditorShowMode="MouseDown"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           AllowResizing="True"
                                           AllowEditing="{Binding Path=IsNewOrIsLockedByCurrentEmployee}"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>

                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Visibility="{Binding Path=IsBundlesBlockVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                      Orientation="Vertical">
                        <dxlc:LayoutGroup View="GroupBox"
                                          Header="Категории бандла"
                                          Orientation="Vertical"
                                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                          ItemSpace="0">
                            <dxb:ToolBarControl VerticalAlignment="Top"
                                                Style="{StaticResource SmallToolBarStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                   Command="{Binding Path=AddBundleCategoryCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Редактировать"
                                                   Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                   Command="{Binding Path=EditBundleCategoryCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Удалить"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                   Command="{Binding Path=DeleteBundleCategoryCommand, Mode=OneWay}" />
                                <dxb:BarItemLinkSeparator />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl ItemsSource="{Binding Path=Model.BundleCategories, Mode=OneWay}"
                                             CurrentItem="{Binding Path=SelectedBundleCategory}"
                                             SelectionMode="Cell"
                                             x:Name="CategoriesGridControl"
                                             ShowBorder="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Style>
                                    <Style TargetType="dxg:GridControl"
                                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                                <Setter Property="Opacity"
                                                        Value="{StaticResource EnabledElementOpacity}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxg:GridControl.Style>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Категория"
                                                    FieldName="CategoryId"
                                                    HeaderToolTip="Категория"
                                                    AllowEditing="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <dx:DXImage
                                                        Source="../../Images/Order/gift_add.png"
                                                        Visibility="{Binding Path=RowData.Row.GiftImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                        Height="16"
                                                        Width="16"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Подарок" />
                                                    <dx:DXImage
                                                        Source="../../Images/Bonus/telemart_point.png"
                                                        Visibility="{Binding Path=RowData.Row.BonusesImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                        Height="16"
                                                        Width="16"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Кэшбек бонусами" />
                                                    <dx:DXImage
                                                        Source="../../Images/Order/tag_blue_16_16.png"
                                                        Visibility="{Binding Path=RowData.Row.DiscountAmountVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                        Height="16"
                                                        Width="16"
                                                        Margin="3,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Скидка" />
                                                    <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                                      IsReadOnly="True"
                                                                      ItemsSource="{Binding Path=DataContext.Categories, ElementName=LayoutControl}"
                                                                      ApplyItemTemplateToSelectedItem="True"
                                                                      IsTextEditable="False"
                                                                      ValueMember="Id">
                                                        <dxe:ComboBoxEdit.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <dx:DXImage
                                                                        Source="../../Images/NavigationMenu/folder_wrench.png"
                                                                        Height="16"
                                                                        Width="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,0,0,0" />

                                                                    <TextBlock
                                                                        Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        Background="Transparent"
                                                                        Margin="5,0,0,0" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </dxe:ComboBoxEdit.ItemTemplate>

                                                    </dxe:ComboBoxEdit>

                                                </StackPanel>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Хар-ка"
                                            HeaderToolTip="Характеристика"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="FeatureName"
                                            FixedWidth="False"
                                            MinWidth="100"
                                            AllowEditing="False"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Значение хар-ки"
                                            HeaderToolTip="Значение характеристики"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="FeatureValueName"
                                            FixedWidth="False"
                                            AllowEditing="False"
                                            MinWidth="100"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Тип скидки"
                                                    AllowEditing="{Binding Path=AllowEditAllData}"
                                                    HeaderToolTip="Тип скидки"
                                                    FieldName="DiscountModeId"
                                                    FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=ProductDiscountModes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      AllowNullInput="True"
                                                                      NullValueButtonPlacement="EditBox"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="DiscountAmount"
                                                    Header="Значение скидки"
                                                    HeaderToolTip="Значение скидки"
                                                    AllowEditing="{Binding Path=AllowEditAllData}"
                                                    Width="110"
                                                    MinWidth="50">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Mask="N0"
                                                                  AllowNullInput="True"
                                                                  MaskType="Numeric"
                                                                  HorizontalContentAlignment="Left"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Кол-во"
                                                FieldName="Quantity"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="50"
                                                AllowEditing="{Binding Path=AllowEditAllData}"
                                                IsEnabled="True"
                                                ReadOnly="False"
                                                AllowResizing="False"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                FixedWidth="True">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:SpinEdit x:Name="PART_Editor"
                                                          HorizontalContentAlignment="Center"
                                                          IsFloatValue="False"
                                                          Increment="1" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           ShowColumnHeaders="True"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           IsEnabled="True"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           EnableImmediatePosting="True"
                                           AllowMoveColumnToDropArea="False">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                                       Command="{Binding OnCategoriesCellValueChangedCommand}"
                                                                       PassEventArgsToCommand="True"/>
                                        </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox"
                                  Header="Товары бандла"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                            <dxb:ToolBarControl VerticalAlignment="Top"
                                        Style="{StaticResource SmallToolBarStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                            Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddBundleProductCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteBundleProductCommand, Mode=OneWay}" />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl ItemsSource="{Binding Path=Model.BundleProducts, Mode=OneWay}"
                                     CurrentItem="{Binding Path=SelectedBundleProduct, Mode=TwoWay}"
                                     SelectedItem="{Binding Path=SelectedBundleProduct, Mode=TwoWay}"
                                     SelectionMode="Cell"
                                     x:Name="ProductsGridControl"
                                     ShowBorder="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Style>
                                    <Style TargetType="dxg:GridControl"
                                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                                <Setter Property="Opacity"
                                                        Value="{StaticResource EnabledElementOpacity}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxg:GridControl.Style>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Код"
                                                    HeaderToolTip="Код товара"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="ProductId"
                                                    FixedWidth="False"
                                                    AllowEditing="False"
                                                    MinWidth="30"
                                                    Width="40"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn AllowEditing="False"
                                                    Header="Название"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    MinWidth="50"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    HeaderToolTip="Название товара">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                         <dx:DXImage Source="../../Images/Order/gift_add.png"
                                                                    Visibility="{Binding Path=RowData.Row.GiftImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                                    Height="16"
                                                                    Width="16"
                                                                    Margin="3,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    ToolTipService.ToolTip="Подарок" />
                                                        <dx:DXImage Source="../../Images/Bonus/telemart_point.png"
                                                                    Visibility="{Binding Path=RowData.Row.BonusesImageVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                                    Height="16"
                                                                    Width="16"
                                                                    Margin="3,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    ToolTipService.ToolTip="Кэшбек бонусами" />
                                                        <dx:DXImage Source="../../Images/Order/tag_blue_16_16.png"
                                                                    Visibility="{Binding Path=RowData.Row.DiscountAmountVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=False}}"
                                                                    Height="16"
                                                                    Width="16"
                                                                    Margin="3,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    ToolTipService.ToolTip="Скидка" />
                                                        <dx:DXImage Source="../../Images/NavigationMenu/box_front_open.png"
                                                                    Height="16"
                                                                    Width="16"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="5,0,0,0" />

                                                        <TextBlock Text="{Binding Path=RowData.Row.ProductName, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Background="Transparent"
                                                           Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Тип скидки"
                                                    AllowEditing="{Binding Path=AllowEditAllData}"
                                                    HeaderToolTip="Тип скидки"
                                                    FieldName="DiscountModeId"
                                                    FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=ProductDiscountModes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      NullValueButtonPlacement="EditBox"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="DiscountAmount"
                                                    Header="Значение скидки"
                                                    HeaderToolTip="Значение скидки"
                                                    FixedWidth="True"
                                                    AllowEditing="{Binding Path=AllowEditAllData}"
                                                    Width="110"
                                                    MinWidth="50">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Mask="N0"
                                                                  AllowNullInput="True"
                                                                  ValidateOnEnterKeyPressed="False"
                                                                  MaskType="Numeric"
                                                                  HorizontalContentAlignment="Left"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Кол-во"
                                                    FieldName="Quantity"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    Width="50"
                                                    AllowEditing="{Binding Path=AllowEditAllData}"
                                                    IsEnabled="True"
                                                    ReadOnly="False"
                                                    AllowResizing="False"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    AllowMoving="False"
                                                    FixedWidth="True">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:SpinEdit x:Name="PART_Editor"
                                                              HorizontalContentAlignment="Center"
                                                              IsFloatValue="False"
                                                              Increment="1" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           ShowColumnHeaders="True"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="False"
                                           AllowMoveColumnToDropArea="False" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Очистить кеш"
                            Command="{Binding CleanCacheDataCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}"/>
                </dxlc:LayoutGroup>
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, ElementName=OkButton}">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>