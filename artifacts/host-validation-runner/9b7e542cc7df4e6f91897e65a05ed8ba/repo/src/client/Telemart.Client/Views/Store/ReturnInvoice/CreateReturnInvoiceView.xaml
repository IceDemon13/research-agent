<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.ReturnInvoice.CreateReturnInvoiceView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.ReturnInvoice"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:productInformation="clr-namespace:Telemart.Client.Views.Store.Order.ProductInformation"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              DataContext="{client:Container Type=viewModels:CreateReturnInvoiceViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="980"
                              d:DesignHeight="700"
                              Width="927"
                              Height="500"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateReturnInvoiceViewModel}}">
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=IsVisible, Converter={dxmvvm:BooleanNegationConverter}, ElementName=WaitLayoutGroup}">
            <dxlc:LayoutGroup Name="Top"
                              Orientation="Horizontal">
                <dxlc:LayoutGroup Name="TopLeft"
                                  Orientation="Vertical"
                                  HorizontalAlignment="Stretch">
                    <dxlc:LayoutGroup Name="Fields"
                                      Orientation="Vertical">
                        <dxlc:LayoutItem Label="Дата возврата">
                            <dxe:DateEdit EditValue="{Binding Path=ReturnDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          MaskType="DateTime"
                                          Mask="dd.MM.yyyy"
                                          MaskUseAsDisplayFormat="True"
                                          IsTextEditable="False"
                                          AllowRoundOutOfRangeValue="True">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:FocusBehavior />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:DateEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Склад">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                              EditValue="{Binding Path=Warehouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Доставка">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                              DisplayMember="Name"
                                              EditValue="{Binding Path=CarryType, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              ItemTemplate="{StaticResource ValidatableComboBoxItemTemplate}"
                                              AllowNullInput="True" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Плательщик услуг доставки">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=TtnPayers, Mode=OneWay}"
                                          EditValue="{Binding Path=PayerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name" 
                                          ShowEditorButtons="True"
                                          NullValueButtonPlacement="EditBox"
                                          IsEnabled="{Binding IsEnableDeliveryInfo, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Город">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                              EditValue="{Binding Path=ReceiverCityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              Style="{StaticResource SearchableComboBoxStyle}" 
                                              ShowEditorButtons="True"
                                              NullValueButtonPlacement="EditBox"
                                              IsEnabled="{Binding IsEnableDeliveryInfo, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Отделение">
                            <dxe:ButtonEdit EditValue="{Binding Path=RecipientAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            IsReadOnly="True">
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                ToolTipService.ToolTip="Выбрать адрес"
                                                Command="{Binding Path=SelectNpWarehouseCommand, Mode=OneWay}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Name="Grid">
                        <dxg:GridControl x:Name="GridControl"
                                         ItemsSource="{Binding Path=Products, Mode=OneWay}"
                                         CurrentItem="{Binding Path=SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         SelectionMode="None">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn Header="Товар"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="ProductId"
                                                ReadOnly="True"
                                                AllowMoving="False"
                                                Width="65"/>
                                <dxg:GridColumn Header="Артикул"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="ProductPn"
                                                AllowMoving="False"
                                                ReadOnly="True"/>
                                <dxg:GridColumn Header="Доступно"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="MaxQuantity"
                                                ReadOnly="True"
                                                AllowMoving="False"
                                                Width="65"/>
                                <dxg:GridColumn Header="БН"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="BillsQuantity"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="65"
                                                ReadOnly="True"
                                                AllowMoving="False"/>
                                <dxg:GridColumn Header="Возвращено"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="QuantityReturned"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="65"
                                                ReadOnly="True"
                                                AllowMoving="False"/>
                                <dxg:GridColumn FieldName="OutQuantity"
                                                Header="Вернуть"
                                                HorizontalHeaderContentAlignment="Center"
                                                Width="{StaticResource QuantityColumnWidth}"
                                                MinWidth="{StaticResource MinQuantityColumnWidth}"
                                                AllowEditing="True"
                                                AllowResizing="False"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                AllowMoving="False"
                                                FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings HorizontalContentAlignment="Center"
                                                              IsFloatValue="False"
                                                              MinValue="0"
                                                              Increment="1" >
                                            <dxe:SpinEditSettings.ErrorToolTipContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={converters:SpinEditErrorToolTipConverter MinErrorText='Значение не может быть меньше 0',MaxErrorText='Кол-во возвращаемого товара не может быть больше, чем принято по накладной'}, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=dxe:SpinEdit}}"/>
                                                </DataTemplate>
                                            </dxe:SpinEditSettings.ErrorToolTipContentTemplate>
                                        </dxe:SpinEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Цена"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="Price"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowMoving="False"
                                                Width="72"
                                                AllowEditing="True"/>
                                <dxg:GridColumn Header="Валюта"
                                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                FieldName="Currency"
                                                ReadOnly="True"
                                                AllowMoving="False"
                                                Width="65"
                                                SortMode="Custom" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowResizing="False"
                                               AllowPerPixelScrolling="True"
                                               ShowGroupPanel="False"
                                               ShowIndicator="False"
                                               AutoWidth="True"
                                               AllowGrouping="False"/>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Name="TopRight"
                                  Orientation="Vertical"
                                  HorizontalAlignment="Right"
                                  Width="300"
                                  MaxWidth="300">
                    <dxlc:LayoutGroup Name="Info"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top">
                        <common:SummaryItemsView SummaryItems="{Binding Path=ReturnInvoiceItems, Mode=OneWay}"
                                                 LabelColumnWidth="*"
                                                 ContentColumnWidth="1.3*" />
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Name="ProductInfo"
                                      HorizontalAlignment="Stretch">
                        <productInformation:ProductInformation DataContext="{Binding Path=ProductInformation, Mode=OneWay}"
                                                               dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Path=DataContext, Mode=OneWay, ElementName=CurrentUserControl}" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="Bottom"
                              VerticalAlignment="Bottom"
                              Orientation="Horizontal">
                <viewComponents:WaitImage x:Name="BusyIndicator"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>