<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.ProductInformation.HotlineCompetitorsView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order.ProductInformation"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:HotlineCompetitorsViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:HotlineCompetitorsViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="600"
                              d:DesignHeight="340">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                               Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneWay}"
                               PassEventArgsToCommand="True" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0"
                              View="GroupBox">
                <dxlc:LayoutGroup.GroupBoxStyle>
                    <Style TargetType="dxlc:GroupBox">
                        <Setter Property="TitleVisibility"
                                Value="Collapsed"/>
                        <Setter Property="Padding"
                                Value="0"/>
                    </Style>
                </dxlc:LayoutGroup.GroupBoxStyle>
                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                    Visibility="{Binding Path=CanEdit, Converter={dx:BooleanToVisibilityConverter}}">
                    <dxb:BarButtonItem Content="Редактировать"
                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                       Command="{Binding Path=EditHotlineCompetitorCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}">
                    </dxb:BarButtonItem>
                </dxb:ToolBarControl>
                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}"
                            Visibility="{Binding Path=CanEdit, Converter={dx:BooleanToVisibilityConverter}}" />
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=HotlineCompetitors, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedHotlineCompetitor, Mode=TwoWay}"
                                 SelectionMode="Row"
                                 ShowBorder="False">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Id"
                                        Header="Код"
                                        HeaderToolTip="Код конкурента"
                                        FixedWidth="True"
                                        Width="50"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Name"
                                        Header="Название"
                                        HeaderToolTip="Название"/>
                        <dxg:GridColumn FieldName="AbcId"
                                        Header="К"
                                        HeaderToolTip="Класс"
                                        HorizontalHeaderContentAlignment="Center"
                                        FixedWidth="True"
                                        Width="30">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=AbcTypes}"
                                                          ValueMember="Id"
                                                          DisplayMember="Name"
                                                          HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Rating"
                                        Header="Р"
                                        HeaderToolTip="Рейтинг"
                                        HorizontalHeaderContentAlignment="Center"
                                        FixedWidth="True"
                                        Width="35">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ContractorId"
                                        Header="Контрагент"
                                        HeaderToolTip="Контрагент"
                                        FixedWidth="True"
                                        Width="200">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Contractors}"
                                                          ValueMember="Id"
                                                          DisplayMember="DisplayValue"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                                       ShowSearchPanelMode="Always"
                                       SearchPanelHighlightResults="True">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding EditHotlineCompetitorCommand}"
                                                       PassEventArgsToCommand="False"/>
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>

