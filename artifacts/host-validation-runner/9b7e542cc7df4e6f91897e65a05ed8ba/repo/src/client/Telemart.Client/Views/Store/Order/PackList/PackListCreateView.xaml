<UserControl x:Class="Telemart.Client.Views.Store.Order.PackList.PackListCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order.PackList"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:PackListCreateViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:PackListCreateViewModel}}"
             Width="410"
             MinHeight="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        IsEnabled="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutItem Label="Подразд.">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="../../../../Images/Order/Filter/building_go.png"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                              EditValue="{Binding Path=Model.SubdivisionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                              DisplayMember="Name"
                              ValueMember="Id">
            </dxe:ComboBoxEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Дата">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="../../../../Images/Order/Filter/calendar.png"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxe:DateEdit EditValue="{Binding Path=Model.Date, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource ReadOnlyConditionsStyle}"
                          IsEnabled="{Binding ChangePackListDate, Converter={dxmvvm:BooleanNegationConverter}}"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Время">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="../../../../Images/Order/Filter/time.png"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Center">
                <dxe:DateEdit EditValue="{Binding Path=Model.Time, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True, Mode=TwoWay}"
                              MaskUseAsDisplayFormat="True"
                              Mask="HH:mm"
                              MaskType="DateTime"
                              HorizontalAlignment="Stretch">
                    <dxe:DateEdit.StyleSettings>
                        <dxe:DateEditPickerStyleSettings />
                    </dxe:DateEdit.StyleSettings>
                </dxe:DateEdit>
            </dxlc:LayoutGroup>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Доставка">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="{StaticResource Lorry16}"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                              EditValue="{Binding Path=Model.CarryIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                              DisplayMember="Name"
                              ValueMember="Id"
                              Style="{StaticResource CheckedTokenComboBoxStyle}">
            </dxe:ComboBoxEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Склад">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="../../../../Images/Order/Filter/house.png"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxe:TextEdit EditValue="{Binding Path=Model.Warehouse.DisplayValue, Mode=OneWay}"
                          Style="{StaticResource ReadOnlyEditorStyle}">
            </dxe:TextEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Упаковщик">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="../../../../Images/Order/Filter/user.png"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                              EditValue="{Binding Path=Model.PackagerEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                              DisplayMember="Name"
                              ValueMember="Id">
            </dxe:ComboBoxEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="Сборщик">
            <dxlc:LayoutItem.LabelTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="../../../../Images/Order/Filter/user.png"
                                    Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </dxlc:LayoutItem.LabelTemplate>
            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                              EditValue="{Binding Path=Model.CollectorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                              DisplayMember="Name"
                              ValueMember="Id">
            </dxe:ComboBoxEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom">
            <viewComponents:WaitImage HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      BusyText="Создание..."
                                      Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
            <dxlc:LayoutGroup HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                <Button Content="Создать"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
