<UserControl x:Class="Telemart.Client.Views.SupplierBill.Create.CreateSupplierBillTextPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dragDropManagers="clr-namespace:Telemart.Client.Common.DragDropManagers"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.SupplierBill.Create"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             DataContext="{client:Container Type=viewModels:CreateSupplierBillTextPageViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateSupplierBillTextPageViewModel}}"
             d:DesignWidth="800"
             d:DesignHeight="450">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <system:Boolean x:Key="TrueValue">True</system:Boolean>
                    <system:Boolean x:Key="FalseValue">False</system:Boolean>

                    <dxmvvm:ObjectToObjectConverter x:Key="IdToVisibilityConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="5"
                                        Target="Visible"/>
                    </dxmvvm:ObjectToObjectConverter>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <DockPanel>
                <viewComponents:WaitImage VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          BusyText="Идет обработка..."
                                          Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <dxco:WizardButton Content="Назад"
                                       dxco:Wizard.IsButtonBack="True" />
                    <dxco:WizardButton Content="Далее"
                                       dxco:Wizard.IsButtonNext="True">
                        <dxco:WizardButton.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl" />
                                <Binding Path="IsLongOperationInProgress" />
                            </MultiBinding>
                        </dxco:WizardButton.IsEnabled>
                    </dxco:WizardButton>
                    <dxco:WizardButton Content="Отмена"
                                       dxco:Wizard.IsButtonCancel="True" />
                </StackPanel>
            </DockPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <avalonedit:TextEditor BorderBrush="DarkGray"
                                       BorderThickness="1"
                                       UseLayoutRounding="True"
                                       ShowLineNumbers="True"
                                       WordWrap="True"
                                       VerticalContentAlignment="Top"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Auto">
                    <avalonedit:TextEditor.Options>
                        <avalonedit:TextEditorOptions ShowSpaces="True"
                                                      ShowTabs="True" />
                    </avalonedit:TextEditor.Options>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior />
                        <behaviors:TextEditorContentBehavior EditText="{Binding Path=Model.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </dxmvvm:Interaction.Behaviors>
                </avalonedit:TextEditor>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  Width="160">
                    <dxlc:LayoutItem Label="Валюта"
                                     LabelPosition="Top">
                        <dxe:ComboBoxEdit
                            ItemsSource="{Binding Path=Model.Currencies, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                            ValueMember="Id"
                            DisplayMember="Title"
                            EditValue="{Binding Path=Model.CurrencyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Цена"
                                     LabelPosition="Top">
                        <dxe:ComboBoxEdit EditValue="{Binding Path=Model.PriceWithTax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsEnabled="{Binding Path=Model.PriceWithTaxEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <dxe:ComboBoxEdit.Items>
                                <dxe:CustomItem  DisplayText="Цена с НДС"
                                                 EditValue="{StaticResource TrueValue}" />
                                <dxe:CustomItem  DisplayText="Цена без НДС"
                                                 EditValue="{StaticResource FalseValue}" />
                            </dxe:ComboBoxEdit.Items>
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Порядок колонок"
                                     LabelPosition="Top"
                                     VerticalAlignment="Stretch">
                        <dxe:ListBoxEdit ItemsSource="{Binding Path=Model.ColumnItems, Mode=OneWay}"
                                         AllowItemHighlighting="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <dxe:ListBoxEdit.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </dxe:ListBoxEdit.ItemsPanel>
                            <dxe:ListBoxEdit.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Width="150">
                                        <TextBlock Text="{Binding Path=DisplayValue, Mode=OneWay}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="x"
                                                HorizontalAlignment="Right"
                                                Width="16"
                                                MinWidth="16"
                                                Padding="0 -1 0 2"
                                                Visibility="{Binding Id, Converter={StaticResource IdToVisibilityConverter}}"
                                                Command="{Binding Path=DataContext.RemoveColumnItemCommand, ElementName=LayoutControl}"
                                                CommandParameter="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </dxe:ListBoxEdit.ItemTemplate>
                            <dxmvvm:Interaction.Behaviors>
                                <dragDropManagers:MyListBoxDragDropManager x:Name="ListBoxDragDropManager" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxe:ListBoxEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>