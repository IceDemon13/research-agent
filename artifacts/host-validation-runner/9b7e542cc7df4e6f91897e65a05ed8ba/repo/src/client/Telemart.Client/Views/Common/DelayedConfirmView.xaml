<UserControl x:Class="Telemart.Client.Views.Common.DelayedConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:common="clr-namespace:Telemart.Client.ViewModels.Common"
             DataContext="{client:Container Type=common:DelayedConfirmViewModel}"
             Loaded="OnLoaded"
             Width="450"
             MinHeight="120"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type common:DelayedConfirmViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:EventToCommand EventName="Unloaded"
                               Command="{Binding Path=HandleUnloadedCommand, Mode=OneTime}" />
        <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                               Command="{Binding Path=HandlePreviewKeyDownCommand, Mode=OneTime}"
                               PassEventArgsToCommand="True" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemSpace="16"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutGroup Orientation="Vertical">
            <TextBlock Text="{Binding Path=Text, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       FontWeight="SemiBold">
            </TextBlock>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Command="{Binding Path=OkCommand, Mode=OneTime}"
                    Content="{Binding Path=YesText, Mode=OneWay}"
                    IsEnabled="{Binding Path=YesEnabled, Mode=OneWay}"
                    IsTabStop="True" />
            <Button x:Name="NoButton"
                    Content="Нет (N)"
                    Command="{Binding Path=NoCommand, Mode=OneTime}"
                    IsTabStop="True" />
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneTime}"
                    IsTabStop="True" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>