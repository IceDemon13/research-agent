<UserControl x:Class="Telemart.Client.Views.Directories.Employee.EmployeeCopyView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Employee"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:EmployeeCopyViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:EmployeeCopyViewModel}, IsDesignTimeCreatable=True}"
             Width="350"
             Height="280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="EmployeeCopyLayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Сотрудник">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=SelectedEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding Path=Employees}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxe:CheckEdit Content="Роли"
                                       EditValue="{Binding Path=IsCopyRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Операции"
                                       EditValue="{Binding Path=IsCopyOperation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Подразделения"
                                       EditValue="{Binding Path=IsCopySubdivision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Склады"
                                       EditValue="{Binding Path=IsCopyWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Кассы"
                                       EditValue="{Binding Path=IsCopyCashbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Категории"
                                       EditValue="{Binding Path=IsCopyCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}" 
                                              EditValue="{Binding SelectedRoleCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}" 
                                              EditValue="{Binding SelectedOparationCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}" 
                                              EditValue="{Binding SelectedSubdivisionCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}" 
                                              EditValue="{Binding SelectedWarehousesCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}" 
                                              EditValue="{Binding SelectedCashboxCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}" 
                                              EditValue="{Binding SelectedCategoryCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"/>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>