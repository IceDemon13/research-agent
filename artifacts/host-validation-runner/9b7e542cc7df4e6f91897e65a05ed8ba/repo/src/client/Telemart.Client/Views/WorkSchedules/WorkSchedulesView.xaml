<UserControl x:Class="Telemart.Client.Views.WorkSchedules.WorkSchedulesView"
             x:Name="UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.WorkSchedule"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:WorkSchedulesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:WorkSchedulesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="770">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}"/>
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <dxlc:LayoutGroup View="GroupBox"
                          Header="Графики"
                          Orientation="Vertical"
                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                          ItemSpace="0">
            <dxb:ToolBarControl>
                <dxb:BarButtonItem Content="Обновить"
                                           ToolTip="Обновить"
                                           LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshWorkSchedulesCommand, Mode=OneTime}"
                                           CommandTarget="{Binding ElementName=WorkScheduleGridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Добавить"
                                   ToolTip="Добавить"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddWorkScheduleCommand, Mode=OneTime}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Удалить"
                                   ToolTip="Удалить выбранную строку"
                                   LargeGlyph="../../Images/Actions/delete_32_32.png"
                                   Glyph="../../Images/Common/delete_16x16.png"
                                   Command="{Binding Path=DeleteWorkScheduleCommand, Mode=OneTime}"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   CommandParameter="{Binding CurrentItem, ElementName=WorkScheduleGridControl, Mode=OneWay}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Сохранить"
                                   ToolTip="Сохранить изменения в гриде"
                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                   Glyph="{dx:DXImage Image=Save_16x16.png}"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   Command="{Binding Path=SaveWorkSchedulesCommand, Mode=OneTime}"/>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
            <dxg:GridControl x:Name="WorkScheduleGridControl"
                             ItemsSource="{Binding Path=WorkSchedules, Mode=OneWay}"
                             CurrentItem="{Binding Path= SelectedWorkScheduleViewItem, Mode=TwoWay}"
                             ShowBorder="False"
                             SelectionMode="None"
                             IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanNegationConverter}}">
                     <dxg:GridControl.ShowLoadingPanel>
                         <MultiBinding Mode="OneWay"
                                       Converter="{converters:BooleanOrMultiValueConverter}">
                             <Binding Path="RefreshWorkSchedulesCommand.IsExecuting"
                                      Mode="OneWay" />
                         </MultiBinding>
                     </dxg:GridControl.ShowLoadingPanel>
                     <dxmvvm:Interaction.Behaviors>
                         <behaviors:LayoutSerializationBehavior FileName="work_schedules_2.xml"/>
                         <behaviors:CopyCurrentCellToClipboardBehavior />
                     </dxmvvm:Interaction.Behaviors>
                     <dxg:GridControl.Columns>
                         <dxg:GridColumn Header="Код"
                                         HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         HorizontalHeaderContentAlignment="Center"
                                         FieldName="Id"
                                         AllowEditing="False"
                                         ReadOnly="True"
                                         AllowMoving="False"
                                         FixedWidth="True"
                                         AllowResizing="False"
                                         AllowBestFit="False"
                                         AllowColumnFiltering="False"
                                         Width="40">
                             <dxg:GridColumn.EditSettings>
                                 <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                             </dxg:GridColumn.EditSettings>
                         </dxg:GridColumn>
                         <dxg:GridColumn Header="Тип графика"
                                         HeaderToolTip="Полное название типа графика"
                                         HorizontalHeaderContentAlignment="Center"
                                         FieldName="FullName"
                                         AllowMoving="False"
                                         FixedWidth="False"
                                         AllowResizing="True"
                                         AllowBestFit="False"
                                         AllowColumnFiltering="False"
                                         AllowEditing="False"
                                         MinWidth="100"
                                         Width="100"
                                         MaxWidth="200">
                         </dxg:GridColumn>
                         <dxg:GridColumn Header="Название графика"
                                         HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                         HorizontalHeaderContentAlignment="Center"
                                         FieldName="Name"
                                         AllowMoving="False"
                                         FixedWidth="False"
                                         AllowResizing="True"
                                         AllowBestFit="False"
                                         AllowColumnFiltering="False"
                                         AllowEditing="True"
                                         MinWidth="100"
                                         Width="100"
                                         MaxWidth="200">
                             <dxg:GridColumn.CellTemplate>
                                 <DataTemplate>
                                     <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                       ItemsSource="{Binding View.DataContext.AllNames, Mode=OneWay}"
                                                       Style="{StaticResource ButtonComboBoxEditStyle}"
                                                       SelectedItem="{Binding Path=RowData.Row.Name, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                                       AutoComplete="True"
                                                       ImmediatePopup="True"
                                                       ValidateOnTextInput="False"
                                                       IsTextEditable="False"
                                                       IncrementalFiltering="True"
                                                       IsReadOnly="False">
                                         <dxe:ComboBoxEdit.Buttons>
                                             <dxe:ButtonInfo GlyphKind="Plus"
                                                             IsEnabled="True"
                                                             Command="{Binding Path=View.DataContext.CreateNameCommand, Mode=OneWay}"
                                                             CommandParameter="{Binding Path=RowData.Row, Mode=OneWay}"/>
                                         </dxe:ComboBoxEdit.Buttons>
                                     </dxe:ComboBoxEdit>
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>
                         <dxg:GridColumn Header="От"
                                         HeaderToolTip="Время начала"
                                         FieldName="Start"
                                         Width="50"
                                         AllowResizing="False"
                                         FixedWidth="True"
                                         AllowAutoFilter="True"
                                         AllowColumnFiltering="True"
                                         FilterPopupMode="CheckedList"
                                         ColumnFilterMode="DisplayText"
                                         HorizontalHeaderContentAlignment="Center">
                             <dxg:GridColumn.CellTemplate>
                                 <DataTemplate>
                                     <dxe:TextEdit x:Name="PART_Editor"
                                                   HorizontalAlignment="Center"
                                                   EditValue="{Binding Path=RowData.Row.Start, Mode=TwoWay, Converter={converters:TimeSpanToDateTimeConverter},  ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                                   Style="{StaticResource TimeSpanTextEdit}" />
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>
                         <dxg:GridColumn Header="До"
                                         HeaderToolTip="Время окончания"
                                         FieldName="End"
                                         Width="50"
                                         AllowResizing="False"
                                         FixedWidth="True"
                                         AllowAutoFilter="True"
                                         AllowColumnFiltering="True"
                                         FilterPopupMode="CheckedList"
                                         ColumnFilterMode="DisplayText"
                                         HorizontalHeaderContentAlignment="Center">
                             <dxg:GridColumn.CellTemplate>
                                 <DataTemplate>
                                     <dxe:TextEdit x:Name="PART_Editor"
                                                   HorizontalAlignment="Center"
                                                   EditValue="{Binding Path=RowData.Row.End, Mode=TwoWay, Converter={converters:TimeSpanToDateTimeConverter},  ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                                   Style="{StaticResource TimeSpanTextEdit}" />
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>
                         <dxg:GridColumn Header="Дни"
                                         Binding="{Binding Days, Mode=TwoWay, Converter={converters:StringToDaysOfWeekConverter},  ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                         HeaderToolTip="День недели"
                                         AllowResizing="True"
                                         FixedWidth="False"
                                         Width="120"
                                         MinWidth="60"
                                         MaxWidth="200">
                             <dxg:GridColumn.CellTemplate>
                                 <DataTemplate>
                                     <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                       ItemsSource="{Binding Path=DataContext.DaysOfWeek, Mode=OneWay, ElementName=UserControl, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                                       DisplayMember="ShortName"
                                                       NullValueButtonPlacement="None"
                                                       Style="{StaticResource CheckedTokenComboBoxStyle}" />
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>
                         <dxg:GridColumn Header="И"
                                         HeaderToolTip="Изменена"
                                         FieldName="IsChanged"
                                         HorizontalHeaderContentAlignment="Center"
                                         AllowResizing="False"
                                         FixedWidth="True"
                                         AllowGrouping="False"
                                         Width="26">
                             <dxg:GridColumn.CellTemplate>
                                 <DataTemplate>
                                     <dx:DXImage Source="/Images/Order/Actions/pencil.png"
                                                         Height="16"
                                                         Width="16"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"
                                                         Margin="5,0,0,0">
                                         <dx:DXImage.Visibility>
                                             <MultiBinding Mode="OneWay"
                                                           Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                                 <Binding Path="RowData.Row.IsChanged"
                                                          Mode="OneWay" />
                                             </MultiBinding>
                                         </dx:DXImage.Visibility>
                                     </dx:DXImage>
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>
                     </dxg:GridControl.Columns>
                     <dxg:GridControl.View>
                         <dxg:TableView AllowEditing="True"
                                        AllowSorting="True"
                                        AllowGrouping="False"
                                        EditFormPostMode="Immediate"
                                        EnableImmediatePosting="True"
                                        AllowLeaveInvalidEditor="True"
                                        Style="{StaticResource ReadOnlyTableViewStyle}">
                             <dxmvvm:Interaction.Behaviors>
                                 <dxmvvm:EventToCommand EventName="ShowingEditor" Command="{Binding HandleWorkScheduleShowingEditorCommand}"
                                                        PassEventArgsToCommand="True"/>
                             </dxmvvm:Interaction.Behaviors>
                         </dxg:TableView>
                     </dxg:GridControl.View>
                 </dxg:GridControl>
            </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Grid.Column="1"
                          View="GroupBox"
                          Header="Исключения"
                          Orientation="Vertical"
                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                          ItemSpace="0">
            <dxb:ToolBarControl>
                <dxb:BarButtonItem Content="Обновить"
                                   ToolTip="Обновить"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshHolidaysCommand, Mode=OneTime}"
                                   CommandTarget="{Binding ElementName=HolidaysGridControl}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Добавить"
                                   ToolTip="Добавить"
                                   LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                   Command="{Binding Path=AddHolidayCommand, Mode=OneTime}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Удалить"
                                   ToolTip="Удалить выбранную строку"
                                   LargeGlyph="../../Images/Actions/delete_32_32.png"
                                   Glyph="../../Images/Common/delete_16x16.png"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   Command="{Binding Path=DeleteHolidayCommand, Mode=OneTime}"
                                   CommandParameter="{Binding CurrentItem, ElementName=HolidaysGridControl, Mode=OneWay}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Сохранить"
                                   ToolTip="Сохранить изменения в гриде"
                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                   Glyph="{dx:DXImage Image=Save_16x16.png}"
                                   Style="{StaticResource IsVisibleBasedOnEnabledBarButtonItemStyle}"
                                   Command="{Binding Path=SaveHolidaysCommand, Mode=OneTime}"/>
                    <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
            <dxg:GridControl x:Name="HolidaysGridControl"
                             ItemsSource="{Binding Path=Holidays, Mode=OneWay}"
                             CurrentItem="{Binding Path= SelectedHolday, Mode=TwoWay}"
                             ShowBorder="False"
                             SelectionMode="None"
                             DesignTimeDataSourceRowCount="5"
                             IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxg:GridControl.ShowLoadingPanel>
                    <MultiBinding Mode="OneWay"
                                  Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="RefreshHolidaysCommand.IsExecuting"
                                 Mode="OneWay" />
                    </MultiBinding>
                </dxg:GridControl.ShowLoadingPanel>
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:LayoutSerializationBehavior FileName="holidays_2.xml"/>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Код"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="Id"
                                    AllowEditing="False"
                                    ReadOnly="True"
                                    AllowMoving="False"
                                    FixedWidth="True"
                                    AllowResizing="False"
                                    AllowBestFit="False"
                                    AllowColumnFiltering="False"
                                    Width="40">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Дата"
                                    HeaderToolTip="Дата выходного"
                                    FieldName="Date"
                                    Width="90"
                                    AllowResizing="False"
                                    FixedWidth="True"
                                    AllowAutoFilter="True"
                                    AllowColumnFiltering="False"
                                    HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                  NullText=""
                                                  MaskType="DateTime"
                                                  MaskUseAsDisplayFormat="True"
                                                  Mask="{x:Static business:DateFormattingRules.DateFormatYear}"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Тип графика"
                                    HeaderToolTip="Полное название типа графика"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="FullName"
                                    AllowMoving="False"
                                    FixedWidth="False"
                                    AllowResizing="True"
                                    AllowBestFit="False"
                                    AllowColumnFiltering="False"
                                    AllowEditing="False"
                                    MinWidth="100"
                                    Width="100"
                                    MaxWidth="200"/>
                    <dxg:GridColumn Header="От"
                                    HeaderToolTip="Время начала"
                                    FieldName="Start"
                                    Width="50"
                                    AllowResizing="False"
                                    FixedWidth="True"
                                    AllowAutoFilter="True"
                                    AllowColumnFiltering="True"
                                    FilterPopupMode="CheckedList"
                                    ColumnFilterMode="DisplayText"
                                    HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              HorizontalAlignment="Center"
                                              EditValue="{Binding Path=RowData.Row.Start, Mode=TwoWay, Converter={converters:TimeSpanToDateTimeConverter},  ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource TimeSpanTextEdit}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="До"
                                    HeaderToolTip="Время окончания"
                                    FieldName="End"
                                    Width="60"
                                    AllowResizing="False"
                                    FixedWidth="True"
                                    AllowAutoFilter="True"
                                    AllowColumnFiltering="True"
                                    FilterPopupMode="CheckedList"
                                    ColumnFilterMode="DisplayText"
                                    HorizontalHeaderContentAlignment="Center">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              HorizontalAlignment="Center"
                                              EditValue="{Binding Path=RowData.Row.End, Mode=TwoWay, Converter={converters:TimeSpanToDateTimeConverter},  ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource TimeSpanTextEdit}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Ф"
                                    HeaderToolTip="Формат исключения"
                                    FieldName="IsChanged"
                                    HorizontalHeaderContentAlignment="Center"
                                    AllowResizing="False"
                                    FixedWidth="True"
                                    AllowSorting="False"
                                    AllowGrouping="False"
                                    Width="26">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Common/theater.png"
                                                Height="16"
                                                Width="16"
                                                ToolTip="Выходной"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="5,0,0,0">
                                        <dx:DXImage.Visibility>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                                <Binding Path="RowData.Row.IsWeekend"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </dx:DXImage.Visibility>
                                    </dx:DXImage>
                                    <dx:DXImage Source="/Images/Common/house_table.png"
                                                Height="16"
                                                Width="16"
                                                ToolTip="Временный график"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="5,0,0,0">
                                        <dx:DXImage.Visibility>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                                <Binding Path="RowData.Row.IsGraphicOverride"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </dx:DXImage.Visibility>
                                    </dx:DXImage>
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="И"
                                    HeaderToolTip="Изменена"
                                    FieldName="IsChanged"
                                    HorizontalHeaderContentAlignment="Center"
                                    AllowResizing="False"
                                    FixedWidth="True"
                                    AllowGrouping="False"
                                    Width="26">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dx:DXImage Source="/Images/Order/Actions/pencil.png"
                                            Height="16"
                                            Width="16"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="5,0,0,0">
                                    <dx:DXImage.Visibility>
                                        <MultiBinding Mode="OneWay"
                                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                            <Binding Path="RowData.Row.IsChanged"
                                                     Mode="OneWay" />
                                        </MultiBinding>
                                    </dx:DXImage.Visibility>
                                </dx:DXImage>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowEditing="{Binding  Path=IsChangingHolіdays, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                   AllowSorting="True"
                                   AllowGrouping="False"
                                   EditFormPostMode="Immediate"
                                   EnableImmediatePosting="True"
                                   AllowLeaveInvalidEditor="True"
                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="ShowingEditor" Command="{Binding HandleHolidaysShowingEditorCommand}"
                                                   PassEventArgsToCommand="True"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>