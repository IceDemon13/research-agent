<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.OrderProductBulkAddView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              DataContext="{client:Container Type=viewModels:OrderProductBulkAddViewModel}"
                              Loaded="BulkAddViewOnLoaded"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderProductBulkAddViewModel}}"
                              d:DesignHeight="480"
                              d:DesignWidth="640">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=HandleTextCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical">
        <dxlc:LayoutGroup>
            <dxe:TextEdit x:Name="RawTextEdit"
                          EditValue="{Binding Path=RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          TextWrapping="Wrap"
                          AcceptsReturn="True"
                          AcceptsTab="True"
                          VerticalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Top" />
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxg:GridControl ItemsSource="{Binding Path=Items, Mode=OneWay}"
                             ClipboardCopyMode="ExcludeHeader"
                             ShowLoadingPanel="{Binding Path=HandleTextCommand.IsExecuting, Mode=OneWay}">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="Код"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="70"
                                    MinWidth="70"
                                    FixedWidth="True"
                                    Binding="{Binding Path=RowData.Row.Product.Id, Mode=OneWay}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Название"
                                    HorizontalHeaderContentAlignment="Left"
                                    Binding="{Binding Path=RowData.Row.ProductDisplayName, Mode=OneWay}">
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Шт."
                                    Width="45"
                                    MinWidth="45"
                                    FixedWidth="True"
                                    HorizontalHeaderContentAlignment="Center"
                                    Binding="{Binding Path=RowData.Row.Quantity, Mode=OneWay}"
                                    HeaderToolTip="Кол-во">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header=" "
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="20"
                                    MinWidth="20"
                                    FixedWidth="True"
                                    Binding="{Binding Path=RowData.Row.Product, Mode=OneWay}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Order/Bulk_add/tick.png"
                                                Height="16"
                                                Width="16"
                                                Margin="2 0 0 0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding Path=RowData.Row.IsValid, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                    <dx:DXImage Source="/Images/Order/Bulk_add/error.png"
                                                Height="16"
                                                Width="16"
                                                Margin="2 0 0 0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding Path=RowData.Row.IsValid, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView CheckBoxSelectorColumnWidth="24"
                                   ShowCheckBoxSelectorColumn="True"
                                   EditorShowMode="MouseDownFocused"
                                   AllowGrouping="False"
                                   AllowFilterEditor="False"
                                   AllowSorting="False"
                                   AllowBestFit="True"
                                   AllowResizing="False"
                                   IsColumnChooserVisible="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Center"
                          HorizontalAlignment="Right">
            <StackPanel IsEnabled="{Binding Path=HandleTextCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        Orientation="Horizontal">
                <Button x:Name="HandleRaw"
                        Content="Обработать"
                        Width="90"
                        Margin="0 0 8 0"
                        Command="{Binding Path=HandleTextCommand, Mode=OneWay}" />
                <Button x:Name="OkBtn"
                        Content="Добавить"
                        Command="{Binding Path=OkCommand, Mode=OneWay}" />
            </StackPanel>
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</controls:TelemartUserControl>
