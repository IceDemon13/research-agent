<UserControl x:Class="Telemart.Client.Views.Quotas.QuotasAddView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Quotas"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             DataContext="{client:Container Type=viewModels:QuotasAddViewModel}"
             mc:Ignorable="d"
             Width="870"
             Height="500"
             MinHeight="300"
             d:DataContext="{d:DesignInstance Type=viewModels:QuotasAddViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Выберите месяц">
                    <dxe:DateEdit EditValue="{Binding Path=QuotaDate, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="MM.yyyy"
                                  MaskType="DateTime"
                                  HorizontalAlignment="Stretch">
                        <dxe:DateEdit.StyleSettings>
                            <dxe:DateEditPickerStyleSettings />
                        </dxe:DateEdit.StyleSettings>
                    </dxe:DateEdit>
                </dxlc:LayoutItem>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=QuotaAddViewItems, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedQuotaAddViewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 SelectionMode="None">
                    <dxg:GridColumn Header="Отдел"
                                    HorizontalHeaderContentAlignment="Center"
                                    FieldName="DepartmentId"
                                    Width="200"
                                    AllowEditing="False"
                                    AllowBestFit="True"
                                    AllowGrouping="False"
                                    AllowColumnFiltering="True"
                                    ColumnFilterMode="DisplayText"
                                    FilterPopupMode="CheckedList"
                                    AllowAutoFilter="False"
                                    FixedWidth="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Departments, Mode=OneWay}"
                                                      ValueMember="Id"
                                                      DisplayMember="DisplayValue"
                                                      HorizontalContentAlignment="Left"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="PlanValue"
                                    Header="Базовый план"
                                    HeaderToolTip="Базовый план"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="160"
                                    AllowEditing="True"
                                    AllowResizing="False"
                                    AllowMoving="False"
                                    FixedWidth="True"
                                    AllowGrouping="False"
                                    AllowColumnFiltering="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric"
                                                  MaskUseAsDisplayFormat="True"
                                                  Mask="##"
                                                  HorizontalContentAlignment="Left"
                                                  MaskSaveLiteral="False">
                            </dxe:TextEditSettings>
                        </dxg:GridColumn.EditSettings>
                        <dxg:GridColumn.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}"
                                   BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                <Setter Property="Background"
                                        Value="LightGray" />
                            </Style>
                        </dxg:GridColumn.CellStyle>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Долг"
                                    HeaderToolTip="Долг за прошедший период"
                                    FieldName="Duty"
                                    ReadOnly="True"
                                    AllowMoving="False"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="100"
                                    AllowSorting="True"
                                    AllowGrouping="False"
                                    AllowColumnFiltering="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Рассчетный план"
                                    HeaderToolTip="Рассчетный план на месяц"
                                    FieldName="CalculatedNewValue"
                                    ReadOnly="True"
                                    AllowMoving="False"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="160"
                                    AllowSorting="True"
                                    AllowGrouping="False"
                                    AllowColumnFiltering="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Прошлый факт. план"
                                    HeaderToolTip="Фактический план за прошлый месяц"
                                    FieldName="OldValue"
                                    ReadOnly="True"
                                    AllowMoving="False"
                                    Width="160"
                                    HorizontalHeaderContentAlignment="Center"
                                    AllowSorting="True"
                                    AllowGrouping="False"
                                    AllowColumnFiltering="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="NewValue"
                                    Header="Факт. план"
                                    HeaderToolTip="Фактический план за текущий месяц"
                                    HorizontalHeaderContentAlignment="Center"
                                    Width="160"
                                    AllowEditing="True"
                                    AllowResizing="False"
                                    AllowMoving="False"
                                    FixedWidth="True"
                                    AllowGrouping="False"
                                    AllowColumnFiltering="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric"
                                                  MaskUseAsDisplayFormat="True"
                                                  Mask="##"
                                                  HorizontalContentAlignment="Left"
                                                  MaskSaveLiteral="False">
                            </dxe:TextEditSettings>
                        </dxg:GridColumn.EditSettings>
                        <dxg:GridColumn.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}"
                                   BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                                <Setter Property="Background"
                                        Value="LightGray" />
                            </Style>
                        </dxg:GridColumn.CellStyle>
                    </dxg:GridColumn>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       AllowResizing="False"
                                       AllowPerPixelScrolling="True"
                                       ShowGroupPanel="False"
                                       AllowDrop="False"
                                       AllowMoveColumnToDropArea="False"
                                       ShowIndicator="False"
                                       AutoWidth="True"
                                       AllowLeaveInvalidEditor="True"
                                       AllowCommitOnValidationAttributeError="True">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                       Command="{Binding Path=HandleValueChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                <dxlc:LayoutItem Label="План квот">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Path=SumPlanQuotas, Mode=OneWay}"
                                   FontWeight="Bold" />
                        <TextBlock Text="/"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding Path=MaxQuotaIt, Mode=OneWay}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" ч." />
                    </StackPanel>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Факт квот">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Path=SumQuotas, Mode=OneWay}"
                                   FontWeight="Bold" />
                        <TextBlock Text="/"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding Path=MaxQuotaIt, Mode=OneWay}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" ч." />
                    </StackPanel>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="Bottom"
                              VerticalAlignment="Bottom"
                              Orientation="Horizontal">
                <viewComponents:WaitImage x:Name="BusyIndicator"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>