<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.Diagnostics.ConfirmProductReturnPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests.Diagnostics"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             xmlns:common="clr-namespace:Telemart.Client.Views.Common"
             DataContext="{client:Container Type=viewModels:ConfirmProductReturnPageViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ConfirmProductReturnPageViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Назад"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True">
                    <dxco:WizardButton.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="IsEnabled"
                                    Value="True" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Mode="OneWay"
                                                      Converter="{converters:BooleanOrMultiValueConverter}">
                                            <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                     Mode="OneWay"
                                                     ElementName="LayoutControl" />
                                            <Binding Path="IsLongOperationInProgress"
                                                     Mode="OneWay" />
                                            <Binding Path="IsValid"
                                                     Mode="OneWay"
                                                     ElementName="RequisitesView"
                                                     Converter="{dxmvvm:BooleanNegationConverter}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxco:WizardButton.Style>
                </dxco:WizardButton>
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding Mode=OneWay}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Horizontal"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Цена продажи">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Model.CompensationPrices, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.CompensationPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      IsReadOnly="{Binding Path=IsReadOnly, Mode=OneWay}"
                                      Style="{StaticResource LookUpReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Цена списания">
                    <dxe:SpinEdit EditValue="{Binding Path=Model.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="{Binding Path=Model.CompensationPrice.CurrencyId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}, FallbackValue={x:Static business:CurrencyFormatingRules.UahFormat}}"
                                  MaskCulture="{Binding Path=Model.CompensationPrice.CurrencyId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}, FallbackValue={x:Static business:CurrencyFormatingRules.UahCultureInfo}}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="False"
                                  HorizontalContentAlignment="Left"
                                  IsReadOnly="{Binding Path=IsReadOnly, Mode=OneWay}"
                                  Style="{StaticResource SpinEditReadOnlyConditionsStyle}"  />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий">
                    <dxe:TextEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                </dxlc:LayoutItem>
                <common:RequisitesView x:Name="RequisitesView" Model="{Binding Path=Model.Requisites, Mode=OneWay}"/>

            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>