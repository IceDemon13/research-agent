                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxprg:PropertyDefinition.Style>
                        <dxprg:PropertyDefinition.HeaderTemplate>
                            <DataTemplate>
                                <views:CategoryOptionActionsView DataContext="{Binding Path=DataContext.NameOptionModel, RelativeSource={RelativeSource AncestorType=views:CategoryOptionsView}}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.HeaderTemplate>
                        <dxprg:PropertyDefinition.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              BorderThickness="0"
                                              EditMode="InplaceActive"
                                              EditValue="{Binding DataObject.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MaxLength="100"
                                              MaskUseAsDisplayFormat="True"
                                              Style="{StaticResource CategoryTextEditStyle}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="NameUkr"
