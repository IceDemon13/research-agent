                                              EditValue="{Binding DataObject.NameFullEn}">
                                </dxe:TextEdit>
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="Manufactor"
