<UserControl x:Class="Telemart.Client.Views.Directories.Category.CategoryOptionsView"
             x:Name="CurrentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:views="clr-namespace:Telemart.Client.Views.Directories.Category"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Category"
             mc:Ignorable="d"
             dxe:ValidationService.IsValidationContainer="True"
             d:DataContext="{d:DesignInstance Type=viewModels:CategoryOptionsViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <system:Double x:Key="ThreeLinesHeight">53</system:Double>
                    <SolidColorBrush x:Key="ReadOnlyTextColor"
                                     Color="DarkGray" />
                    <DataTemplate x:Key="ReadOnlyHeader">
                        <TextBlock Text="{Binding Path=Header}"
                                   Foreground="{StaticResource ReadOnlyTextColor}"
                                   FontStyle="Normal" />
                    </DataTemplate>
                    <Style TargetType="dxe:CheckEditSettings">
                        <Setter Property="IsThreeState"
                                Value="False"></Setter>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"></Setter>
                    </Style>
                    <Style TargetType="dxe:ComboBoxEdit">
                        <EventSetter Event="EditValueChanged"
                                     Handler="ComboBoxEditValueChanged" />
                    </Style>
                    <Style TargetType="dxprg:PropertyGridView">
                        <Setter Property="AlternationCount"
                                Value="2" />
                    </Style>
                    <Style x:Key="CategoryTextEditStyle"
                           TargetType="dxe:TextEdit">
                        <Setter Property="InvalidValueBehavior"
                                Value="AllowLeaveEditor" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch"
          SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <dxprg:PropertyGridControl SelectedObject="{Binding}"
                                       ShowDescriptionIn="ToolTip"
                                       ExpandCategoriesWhenSelectedObjectChanged="True"
                                       ShowCategories="Visible"
                                       ShowSearchBox="False"
                                       MaxWidth="900"
                                       HeaderColumnMinWidth="100"
                                       ShowToolPanel="False"
                                       SortMode="Custom"
                                       ShowMenuButtonInRows="False"
                                       HorizontalAlignment="Stretch"
                                       ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                       dx:ScrollBarExtensions.ScrollBarMode="Standard">
                <dxprg:PropertyGridControl.Style>
                    <Style TargetType="dxprg:PropertyGridControl">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsOptionsLockedByCurrentEmployee"
                                                 Mode="OneWay"
                                                 UpdateSourceTrigger="PropertyChanged" />
                                        <Binding Path="IsEditingAllowed"
                                                 Mode="OneWay"
                                                 UpdateSourceTrigger="PropertyChanged" />
                                        <Binding Path="IsLongOperationInProgress"
                                                 Mode="OneWay"
                                                 UpdateSourceTrigger="PropertyChanged"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxprg:PropertyGridControl.Style>
                <dxprg:PropertyGridControl.PropertyDefinitions>
                    <dxprg:PropertyDefinition Path="Id"
                                              HeaderTemplate="{StaticResource ResourceKey=ReadOnlyHeader}"
                                              IsReadOnly="True">
                        <dxprg:PropertyDefinition.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              BorderThickness="0"
                                              EditMode="InplaceActive"
                                              IsEnabled="False"
                                              IsReadOnly="True"
                                              Foreground="{StaticResource ReadOnlyTextColor}"
                                              EditValue="{Binding DataObject.Id}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="ParentId"
                                              HeaderTemplate="{StaticResource ResourceKey=ReadOnlyHeader}"
                                              IsReadOnly="True">
                        <dxprg:PropertyDefinition.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              BorderThickness="0"
                                              EditMode="InplaceActive"
                                              IsReadOnly="True"
                                              Foreground="{StaticResource ReadOnlyTextColor}"
                                              EditValue="{Binding DataObject.ParentId}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="Category1C"
                                              HeaderTemplate="{StaticResource ResourceKey=ReadOnlyHeader}"
                                              IsReadOnly="True">
                        <dxprg:PropertyDefinition.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              BorderThickness="0"
                                              EditMode="InplaceActive"
                                              IsReadOnly="True"
                                              Foreground="{StaticResource ReadOnlyTextColor}"
                                              EditValue="{Binding DataObject.Category1C}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="YandexMarketHid"
                                              PostOnEditValueChanged="True">
                        <dxprg:PropertyDefinition.Style>
                            <Style TargetType="dxprg:PropertyDefinition">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Setter Property="IsReadOnly"
                                        Value="True" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding Path=YandexMarketHidOptionModel.IsEditable, Mode=OneWay}">
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                        <Setter Property="IsReadOnly"
                                                Value="False" />
                                        <Setter Property="Opacity"
                                                Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxprg:PropertyDefinition.Style>
                        <dxprg:PropertyDefinition.HeaderTemplate>
                            <DataTemplate>
                                <views:CategoryOptionActionsView DataContext="{Binding Path=DataContext.YandexMarketHidOptionModel, RelativeSource={RelativeSource AncestorType=views:CategoryOptionsView}}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.HeaderTemplate>
                        <dxprg:PropertyDefinition.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit x:Name="PART_Editor"
                                              BorderThickness="0"
                                              EditMode="InplaceActive"
                                              EditValue="{Binding DataObject.YandexMarketHid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              MaskType="RegEx"
                                              Mask="\d{1,9}"
                                              MaxLength="9"
                                              MaskUseAsDisplayFormat="False"
                                              Style="{StaticResource CategoryTextEditStyle}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="Name"
