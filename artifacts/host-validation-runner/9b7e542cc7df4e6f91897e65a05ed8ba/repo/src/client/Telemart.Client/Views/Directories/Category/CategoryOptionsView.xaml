                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="IsParent"
                                              HeaderTemplate="{StaticResource ResourceKey=ReadOnlyHeader}"
                                              IsReadOnly="True">
                        <dxprg:PropertyDefinition.CellTemplate>
                            <DataTemplate>
                                <dxe:CheckEdit Name="PART_Editor"
                                               EditValue="{Binding DataObject.IsParent}"
                                               HorizontalAlignment="Left"
                                               Margin="5 0 0 0" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
