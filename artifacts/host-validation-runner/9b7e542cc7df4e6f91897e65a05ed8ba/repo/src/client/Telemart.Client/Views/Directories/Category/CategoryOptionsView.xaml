                                              EditValue="{Binding DataObject.NameFullUkr}">
                                </dxe:TextEdit>
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="NameFullEn"
