                                              EditValue="{Binding DataObject.TradeInServiceCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              EditValuePostMode="Immediate"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              TextWrapping="Wrap"
                                              AcceptsReturn="True"
