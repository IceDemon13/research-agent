                                              Style="{StaticResource CategoryTextEditStyle}" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>
                    <dxprg:PropertyDefinition Path="NameFull"
