                                <dxe:ComboBoxEdit Name="PART_Editor"
                                                  ItemsSource="{Binding Path=DataContext.ActiveValues, RelativeSource={RelativeSource AncestorType=views:CategoryOptionsView}}"
                                                  EditValue="{Binding DataObject.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="Name"
                                                  ValueMember="Id" />
                            </DataTemplate>
                        </dxprg:PropertyDefinition.CellTemplate>
                    </dxprg:PropertyDefinition>

