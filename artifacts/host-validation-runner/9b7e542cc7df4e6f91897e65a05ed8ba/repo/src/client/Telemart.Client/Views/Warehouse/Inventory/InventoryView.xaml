<controls:TelemartUserControl x:Class="Telemart.Client.Views.Warehouse.Inventory.InventoryView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:inventory="clr-namespace:Telemart.Client.ViewModels.Warehouse.Inventory"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              mc:Ignorable="d"
                              x:Name="CurrentUserControl"
                              DataContext="{client:Container Type=inventory:InventoryViewModel}"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type inventory:InventoryViewModel}}"
                              d:DesignHeight="506"
                              d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml"></ResourceDictionary>
                <ResourceDictionary></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand}" />
        <dxmvvm:KeyToCommand KeyGesture="Delete"
                             Command="{Binding Path=ResetProductRealQuantityCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        dxe:ValidationService.IsValidationContainer="True"
                        ItemSpace="8">
        <dxlc:LayoutControl.IsEnabled>
            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                <Binding Path="HandleLoadedCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="LockCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="OkCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="SaveCommand.IsExecuting"
                         Mode="OneWay" />
                <Binding Path="CompleteInventoryCommand.IsExecuting"
                         Mode="OneWay" />
            </MultiBinding>
        </dxlc:LayoutControl.IsEnabled>

        <dxlc:LayoutGroup Orientation="Horizontal">
            <dxlc:LayoutGroup Orientation="Vertical"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ItemSpace="0">
                <dxb:ToolBarControl BarItemDisplayMode="Default"
                                    GlyphSize="Small"
                                    Margin="0"
                                    Padding="0">
                    <dxb:BarButtonItem Content="Удалить"
                                       ToolTip="Удалить (Delete)"
                                       LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       Command="{Binding Path=ResetProductRealQuantityCommand, Mode=OneWay}">
                        <dxb:BarButtonItem.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="HandleLoadedCommand.IsExecuting"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay" />
                                <Binding Path="IsCompleted"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </dxb:BarButtonItem.IsEnabled>
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Экспорт в Excel"
                                       Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}"
                                       Command="{Binding Path=ExportToExcelCommand, Mode=OneWay}"
                                       CommandParameter="{Binding ElementName=TableView}"
                                       KeyGesture="Alt+E">
                    </dxb:BarButtonItem>
                </dxb:ToolBarControl>
                <dxg:GridControl VerticalAlignment="Stretch"
                                 ItemsSource="{Binding Path=InventoriedProducts, Mode=OneWay}"
                                 SelectedItem="{Binding Path=SelectedInventoryProduct, Mode=TwoWay}"
                                 CurrentItem="{Binding Path=SelectedInventoryProduct, Mode=TwoWay}"
                                 SelectionMode="None"
                                 ShowBorder="True"
                                 ShowLoadingPanel="{Binding Path=IsEnabled, Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                 DesignTimeDataObjectType="{x:Type inventory:InventoryProductViewItem}"
                                 DesignTimeDataSourceRowCount="4"
                                 CopyingToClipboard="OnCopyingToClipboard">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:LayoutSerializationBehavior FileName="inventory3.xml" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Style>
                        <Style TargetType="dxg:GridControl">
                            <Setter Property="Opacity"
                                    Value="{StaticResource EnabledElementOpacity}" />
                            <Setter Property="dx:ScrollBarExtensions.ScrollBarMode"
                                    Value="TouchOverlap">
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                            <Binding Path="IsLockedByCurrentEmployee"
                                                     Mode="OneWay"
                                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                                            <Binding Path="IsCompleted"
                                                     Mode="OneWay" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Opacity"
                                            Value="{StaticResource DisabledElementOpacity}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:GridControl.Style>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="ParentCategoryName"
                                        Header="Категория"
                                        AllowBestFit="True"
                                        AllowMoving="True"
                                        FixedWidth="True"
                                        MinWidth="40"
                                        Width="160"
                                        AllowGrouping="True"
                                        AllowColumnFiltering="False"
                                        HorizontalHeaderContentAlignment="Left">
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ProductId"
                                        HorizontalHeaderContentAlignment="Center"
                                        Header="Код"
                                        Width="100"
                                        MinWidth="30"
                                        MaxWidth="100"
                                        AllowResizing="False"
                                        FixedWidth="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="FullName"
                                        AllowMoving="True"
                                        Header="Название"
                                        AllowBestFit="True"
                                        AllowGrouping="False"
                                        Width="100"
                                        MinWidth="30"
                                        MaxWidth="250"
                                        FixedWidth="False"
                                        AllowResizing="True"
                                        HorizontalHeaderContentAlignment="Left">
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="CurrentInventoryQuantity"
                                        Header="План"
                                        AllowSorting="False"
                                        AllowBestFit="True"
                                        FixedWidth="True"
                                        MinWidth="30"
                                        Width="80"
                                        Visible="{Binding Path=VisibleIsCompletedWithGroup, Mode=OneWay}"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="CurrentInventoryQuantityReal"
                                        Header="Факт"
                                        AllowSorting="False"
                                        AllowEditing="True"
                                        AllowBestFit="True"
                                        FixedWidth="True"
                                        MinWidth="30"
                                        Width="80"
                                        HorizontalHeaderContentAlignment="Center"
                                        ReadOnly="True"
                                        Visible="{Binding Path=VisibleWithGroup, Mode=OneWay}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:SpinEdit x:Name="PART_Editor"
                                                  HorizontalContentAlignment="Center"
                                                  MaskType="Numeric"
                                                  EditMode="InplaceActive"
                                                  Mask="n0"
                                                  MinValue="0"
                                                  EditValueType="{x:Type system:Int32}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Quantity"
                                        Header="{Binding GroupHeaderNamePlan, Mode=OneWay}"
                                        AllowSorting="False"
                                        AllowBestFit="True"
                                        FixedWidth="True"
                                        MinWidth="30"
                                        Width="80"
                                        Visible="{Binding Path=IsCompleted, Mode=OneWay}"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="QuantityReal"
                                        Header="{Binding GroupHeaderNameFact, Mode=OneWay}"
                                        AllowSorting="False"
                                        AllowEditing="True"
                                        AllowBestFit="True"
                                        FixedWidth="True"
                                        MinWidth="30"
                                        Width="80"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.ReadOnly>
                                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                    <Binding Path="IsLockedByCurrentEmployee"
                                             Mode="OneWay"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                    <Binding Path="IsCompleted"
                                             Mode="OneWay" />
                                </MultiBinding>
                            </dxg:GridColumn.ReadOnly>
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:SpinEdit x:Name="PART_Editor"
                                                  HorizontalContentAlignment="Center"
                                                  MaskType="Numeric"
                                                  EditMode="InplaceActive"
                                                  Mask="n0"
                                                  MinValue="0"
                                                  EditValueType="{x:Type system:Int32}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       AllowPerPixelScrolling="True"
                                       ShowGroupPanel="True"
                                       AllowMoveColumnToDropArea="False"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup x:Name="CenterRight"
                              Orientation="Vertical"
                              HorizontalAlignment="Right"
                              Width="300"
                              MaxWidth="300">
                <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                              LabelColumnWidth="*"
                                              ContentColumnWidth="1.3*"
                                              VerticalAlignment="Top" />
                 <dxlc:LayoutItem Label="Категории"
                                 LabelVerticalAlignment="Top">
                    <dxg:GridControl ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                     ShowBorder="True"
                                     Height="275">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name"
                                            VisibleIndex="0" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TreeListView  AutoExpandAllNodes="True"
                                               TreeDerivationMode="Selfreference"
                                               ShowColumnHeaders="False"
                                               AllowRecursiveNodeChecking="True"
                                               CheckBoxFieldName="Selected"
                                               IsCheckBoxEnabledFieldName="Enabled"
                                               ShowCheckboxes="True"
                                               NavigationStyle="Row"
                                               KeyFieldName="Id"
                                               ParentFieldName="ParentId"
                                               FilterMode="Extended"
                                               ShowSearchPanelMode="Always"
                                               SearchPanelHighlightResults="True"
                                               ExpandNodesOnFiltering="True"
                                               AllowEditing="False"
                                               AllowBestFit="True"
                                               AllowSorting="False"
                                               AllowDrop="False"
                                               ShowVerticalLines="False"
                                               ShowHorizontalLines="False"
                                               FetchSublevelChildrenOnExpand="False"
                                               ShowIndicator="False"
                                               TreeLineStyle="Solid"
                                               AutoWidth="True"
                                               ShowFilterPanelMode="Never"
                                               ShowExpandButtons="True"
                                               UseEvenRowBackground="False">
                                <dxg:TreeListView.FormatConditions>
                                    <dxg:FormatCondition Expression="[IsParent] = FALSE AND [IsBrand] = False">
                                        <dx:Format FontStyle="Italic" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="[Active] = 0">
                                        <dx:Format TextDecorations="Strikethrough" />
                                    </dxg:FormatCondition>
                                </dxg:TreeListView.FormatConditions>
                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup VerticalAlignment="Bottom"
                          dxlc:LayoutControl.AllowVerticalSizing="True">
            <dxlc:LayoutGroup.MinHeight>
                <Binding Path="MinHeight"
                         Mode="OneWay"
                         ElementName="RecognizeBarcodeView" />
            </dxlc:LayoutGroup.MinHeight>
            <dxlc:LayoutGroup.Height>
                <Binding Path="MinHeight"
                         Mode="OneWay"
                         ElementName="RecognizeBarcodeView" />
            </dxlc:LayoutGroup.Height>
            <dxlc:LayoutGroup.MaxHeight>
                <MultiBinding
                    Converter="{converters:ResizableLayoutGroupMaxDimensionConverter OppositeMinDimensionValue=160}">
                    <Binding Path="ActualHeight"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    <Binding Path="ItemSpace"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    <Binding Path="Padding"
                             RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                </MultiBinding>
            </dxlc:LayoutGroup.MaxHeight>
            <dxlc:LayoutGroup.Style>
                <Style TargetType="dxlc:LayoutGroup">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="Opacity"
                            Value="{StaticResource DisabledElementOpacity}" />
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                    <Binding Path="HandleLoadedCommand.IsExecuting"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                    <Binding Path="IsLockedByCurrentEmployee"
                                             Mode="OneWay" />
                                    <Binding Path="IsCompleted"
                                             Mode="OneWay"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="IsEnabled"
                                    Value="True" />
                            <Setter Property="Opacity"
                                    Value="{StaticResource EnabledElementOpacity}" />
                        </DataTrigger>
                        <DataTrigger Value="False">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                    <Binding Path="HandleLoadedCommand.IsExecuting"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                    <Binding Path="IsLockedByCurrentEmployee"
                                             Mode="OneWay" />
                                    <Binding Path="IsCompleted"
                                             Mode="OneWay"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="IsEnabled"
                                    Value="False" />
                            <Setter Property="Opacity"
                                    Value="{StaticResource DisabledElementOpacity}" />
                        </DataTrigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                    <Binding Path="DataContext.IsCompleted"
                                             ElementName="CurrentUserControl"
                                             Mode="OneWay"
                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </dxlc:LayoutGroup.Style>
            <common:RecognizeBarcodeView x:Name="RecognizeBarcodeView"
                                         DataContext="{Binding Path=RecognizeBarcodeViewModel, Mode=OneWay}" />
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup x:Name="Bottom"
                          Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom"
                          ItemSpace="20">
            <dxe:CheckEdit Content="Передавать только отксанированные остатки"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           EditValue="{Binding Inventory.TransferScannedBalances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource ReadOnlyConditionsStyle}"
                           Visibility="{Binding Path=IsReadOnly, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True} }">
                <dxe:CheckEdit.IsReadOnly>
                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="IsLockedByCurrentEmployee" Mode="OneWay" Converter="{dxmvvm:BooleanNegationConverter}" />
                        <Binding Path="IsCompleted" Mode="OneWay" />
                    </MultiBinding>
                </dxe:CheckEdit.IsReadOnly>
            </dxe:CheckEdit>
            <Button Content="Редактировать"
                    Width="105"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Command="{Binding Path=LockCommand, Mode=OneWay}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsLocked"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                        <Binding Path="IsCompleted"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                        <Binding Path="HandleLoadedCommand.IsExecuting"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              ItemSpace="0">
                <dxlc:LayoutGroup.Style>
                    <Style TargetType="dxlc:LayoutGroup">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                        <Binding Path="IsLocked"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxlc:LayoutGroup.Style>
                <TextBlock Text="Редактирует: "
                           Foreground="Red" />
                <TextBlock Text="{Binding Path=Inventory.EmployeeLock.Name, Mode=OneWay}" />
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                <dx:DropDownButton Content="Печать"
                                   Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                   Padding="8,0,0,0">
                    <dxb:PopupMenu>
                        <dxb:BarButtonItem Content="Остатки"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../../Images/Common/barcode_16x16.png"
                                           Command="{Binding Path=PrintLeftoversCommand, Mode=OneTime}" />
                    </dxb:PopupMenu>
                </dx:DropDownButton>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  ItemSpace="8">
                    <dxlc:LayoutGroup.Style>
                        <Style TargetType="dxlc:LayoutGroup">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                            <Binding Path="IsCompleted"
                                                     Mode="OneWay"
                                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxlc:LayoutGroup.Style>

                    <Button Content="Завершить"
                            Width="85"
                            Command="{Binding Path=CompleteInventoryCommand, Mode=OneWay}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.Visibility>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                <Binding Path="IsLocked"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="HandleLoadedCommand.IsExecuting"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>
                    <Button x:Name="OkBtn"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button x:Name="SaveBtn"
                            Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Mode="OneWay"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                </dxlc:LayoutGroup>
                <Button Content="Результат"
                        Width="80"
                        Command="{Binding Path=ShowResultsCommand, Mode=OneWay}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                            <Binding Path="IsCompleted"
                                                     Mode="OneWay" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</controls:TelemartUserControl>