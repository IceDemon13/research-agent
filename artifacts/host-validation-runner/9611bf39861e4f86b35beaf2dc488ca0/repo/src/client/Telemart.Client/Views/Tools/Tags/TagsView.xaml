<UserControl x:Class="Telemart.Client.Views.Tools.Tags.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:helpers="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:themes="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Tools.Tags"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:TagsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:TagsViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Language.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ColorItemTemplate">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent">
                    <Ellipse Fill="{Binding Path=Color, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}}"
                             Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                             Stroke="Gray"
                             StrokeThickness="0.5"
                             Margin="3 0 0 0"
                             Width="14"
                             Height="14" />
                    <Label Content="{Binding Path=Name, Mode=OneWay}"
                           Background="Transparent"
                           Margin="5,0,0,0" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <dxb:BarManager>
                <dxb:ToolBarControl>
                    <dxb:BarButtonItem Content="Очистить"
                                       LargeGlyph="{dx:DXImage Image=New_32x32.png}"
                                       Glyph="{dx:DXImage Image=New_16x16.png}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:ConfirmationBehavior Command="{Binding Path=ResetCommand, Mode=OneWay}"
                                                         MessageText="Очистить таблицу?"
                                                         MessageButton="YesNo"
                                                         MessageIcon="Question" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxb:BarButtonItem>
                    <dxb:BarSubItem Content="Добавить"
                                    LargeGlyph="{dx:DXImage Image=AddFile_32x32.png}"
                                    Glyph="{dx:DXImage Image=AddFile_16x16.png}"
                                    IsEnabled="{Binding Path=SelectedWarehouse, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                        <dxb:BarButtonItem Content="Вручную"
                                           LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Авто"
                                           LargeGlyph="{dx:DXImage Image=Task_32x32.png}"
                                           Glyph="{dx:DXImage Image=Task_16x16.png}"
                                           Command="{Binding Path=FillCommand, Mode=OneWay}" />
                    </dxb:BarSubItem>
                    <dxb:BarButtonItem Content="Удалить"
                                       LargeGlyph="{dx:DXImage Image=DeleteList_32x32.png}"
                                       Glyph="{dx:DXImage Image=DeleteList_16x16.png}"
                                       Command="{Binding Path=RemoveCommand, Mode=OneWay}"
                                       CommandTarget="{Binding View, ElementName=GridControl}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Печать"
                                       LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       Command="{Binding Path=PrintCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Сохранить"
                                       LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                       Glyph="{dx:DXImage Image=Save_16x16.png}"
                                       Command="{Binding Path=SaveCommand, Mode=OneWay}"
                                       CommandParameter="{Binding ElementName=TableView}" />
                    <dxb:BarButtonItem Content="Лог"
                                       ToolTip="Отправить лог"
                                       LargeGlyph="{dx:DXImage Image=VerticalAxisLogScale_32x32.png}"
                                       Glyph="{dx:DXImage Image=VerticalAxisLogScale_16x16.png}"
                                       Command="{Binding Path=SendLogsCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
            <StackPanel Grid.Column="1"
                        Background="DarkGray"
                        Margin="2,5,0,5"
                        Style="{StaticResource VerticalSeparatorStackPanelStyle}" />
            <dxlc:LayoutControl Grid.Column="2"
                                Orientation="Vertical"
                                ItemStyle="{StaticResource LayoutItemStyle}"
                                ItemSpace="6"
                                Padding="8,6,0,6">
                <dxlc:LayoutItem Label="Тип цены">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Prices, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Склад">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedWarehouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>
            <dxlc:LayoutControl Grid.Column="3"
                                Orientation="Vertical"
                                ItemStyle="{StaticResource LayoutItemStyle}"
                                ItemSpace="6"
                                Padding="8,6,0,6">
                <dxlc:LayoutItem Label="Язык">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Languages, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemTemplate="{StaticResource LanguageComboBoxItemTemplate}"
                                      ApplyItemTemplateToSelectedItem="True"
                                      IsTextEditable="False"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutControl>
        </Grid>
        <dxg:GridControl Grid.Row="1"
                         x:Name="GridControl"
                         ItemsSource="{Binding Path=TagsCollectionView, Mode=OneWay}"
                         SelectedItems="{Binding Path=SelectedTags, Mode=OneWay}"
                         SelectionMode="Row"
                         AutoExpandAllGroups="True">
            <dxg:GridControl.ShowLoadingPanel>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                    <Binding Path="HandleLoadedCommand.IsExecuting" />
                    <Binding Path="PrintCommand.IsExecuting" />
                    <Binding Path="AddCommand.IsExecuting" />
                    <Binding Path="FillCommand.IsExecuting" />
                </MultiBinding>
            </dxg:GridControl.ShowLoadingPanel>
            <dxg:GridControl.Resources>
                <Style TargetType="dxg:GridColumn"
                       BasedOn="{StaticResource GeneralGridColumnStyle}">
                    <Setter Property="ShowInColumnChooser"
                            Value="False" />
                </Style>
            </dxg:GridControl.Resources>
            <dxmvvm:Interaction.Behaviors>
                <behaviors:LayoutSerializationBehavior FileName="tags2.xml" />
                <behaviors:CopyCurrentCellToClipboardBehavior />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Категория"
                                FieldName="DisplayCategory"
                                AllowResizing="True"
                                FixedWidth="False"
                                MinWidth="200">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                              TextWrapping="Wrap" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Название"
                                FieldName="DisplayName"
                                AllowResizing="True"
                                FixedWidth="False"
                                MinWidth="200">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                              TextWrapping="Wrap" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Цена"
                                FieldName="Price"
                                FixedWidth="True"
                                MinWidth="120"
                                Width="140">
                    <dxg:GridColumn.EditSettings>
                        <dxe:SpinEditSettings HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Перечеркнутая цена"
                                FieldName="PricePrev"
                                FixedWidth="True"
                                MinWidth="120"
                                Width="140">
                    <dxg:GridColumn.EditSettings>
                        <dxe:SpinEditSettings HorizontalContentAlignment="Left" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Color"
                                Name="Color"
                                Header="Цвет"
                                HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                FixedWidth="True"
                                MinWidth="21"
                                Width="80"
                                AllowGrouping="True"
                                AllowResizing="False"
                                AllowColumnFiltering="True"
                                ColumnFilterMode="DisplayText"
                                FilterPopupMode="CheckedList"
                                AllowMoving="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Background="Transparent">
                                <Ellipse Fill="{Binding Path=RowData.Row.Color.Hex, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}, PresentationTraceSources.TraceLevel=High}"
                                         Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                         Stroke="Gray"
                                         StrokeThickness="0.5"
                                         Margin="3 0 0 0"
                                         Width="14"
                                         Height="14" />
                                <TextBox x:Name="PART_Editor"
                                         Text="{Binding Path=RowData.Row.Color.Name, Mode=OneWay}"
                                         Style="{DynamicResource {themes:TextEditThemeKey ResourceKey=TextStyle}}"
                                         helpers:EditorMarginHelper.Margin="2,2,2,2,0,2,2,2" />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Формат"
                                FieldName="TagFormat"
                                FixedWidth="True"
                                MinWidth="120"
                                Width="140"
                                AllowColumnFiltering="True"
                                AllowEditing="True">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=TagFormats, Mode=OneWay}"
                                                  DisplayMember="Title"
                                                  HorizontalContentAlignment="Left"
                                                  TextWrapping="Wrap" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="TableView"
                               ShowCheckBoxSelectorColumn="True"
                               ShowCheckBoxSelectorInGroupRow="True"
                               CheckBoxSelectorColumnWidth="24"
                               AutoWidth="True"
                               AllowEditing="False"
                               AllowSorting="False"
                               NavigationStyle="Cell"
                               ShowIndicator="False"
                               ShowGroupPanel="False"
                               ShowAutoFilterRow="False"
                               AllowConditionalFormattingMenu="False"
                               AllowFixedColumnMenu="False"
                               IsColumnMenuEnabled="False"
                               ShowSearchPanelMode="Never"
                               AllowCommitOnValidationAttributeError="True"
                               EnableImmediatePosting="True">
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>

</UserControl>