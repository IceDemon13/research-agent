<UserControl x:Class="Telemart.Client.Views.LogisticsMap.LogisticsMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.LogisticsMap"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:dxdiag="http://schemas.devexpress.com/winfx/2008/xaml/diagram"
             DataContext="{client:Container Type=viewModels:LogisticsMapViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:LogisticsMapViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/AssemblyServiceState.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup VerticalAlignment="Top"
                          Orientation="Horizontal">
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl HorizontalAlignment="Left">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Открыть"
                                       ToolTip="Открыть"
                                       LargeGlyph="../../Images/Common/application_cascade.png"
                                       Command="{Binding Path=OpenItemCommand, Mode=OneTime}"
                                       CommandParameter="{Binding Path=SelectedDiagramItem}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarButtonItem Content="Двигать"
                                       ToolTip="Двигать диаграмму"
                                       LargeGlyph="../../Images/Common/hand.png"
                                       Command="{Binding Path=SelectPanToolCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarButtonItem Content="Указатель"
                                       ToolTip="Выбрать указатель"
                                       LargeGlyph="../../Images/Common/cursor.png"
                                       Command="{Binding Path=SelectPointerToolCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>

            <Label Content="{Binding Path=SelectedDiagramItemText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   FontWeight="SemiBold"
                   Margin="0,15,10,0"
                   FontSize="17"/>

        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Margin="0"
                                  Orientation="Horizontal">
                    <dxdo:LayoutGroup>
                        <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                          AllowSizing="True">
                            <Grid>
                                <dxdiag:DiagramControl x:Name="diagramControl"
                                                       ToolboxVisibility="Closed"
                                                       Background="Transparent"
                                                       ShowGrid="False"
                                                       ShowPanAndZoomPanel="False"
                                                       ShowMeasureUnit="False"
                                                       ShowRulers="False"
                                                       AllowCopyItems="False"
                                                       SelectionMode="Single"
                                                       SelectionChanged="DiagramControl_OnSelectionChanged"
                                                       MouseDoubleClick="DiagramControl_OnMouseDoubleClick"
                                                       ShowPageBreaks="False"
                                                       PropertiesPanelVisibility="Closed">
                                </dxdiag:DiagramControl>
                            </Grid>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                    <dxdo:LayoutGroup MinWidth="360"
                                      MaxWidth="500"
                                      ItemWidth="360"
                                      Orientation="Vertical">
                        <dxdo:LayoutPanel Caption="Поиск"
                                          AllowClose="False"
                                          AllowDrag="False"
                                          AllowDock="True"
                                          AutoHidden="False"
                                          AllowHide="True"
                                          FloatOnDoubleClick="False"
                                          MinWidth="360"
                                          MaxWidth="500"
                                          ItemWidth="360"
                                          IsEnabled="True"
                                          behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                            <dxlc:LayoutControl Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Типы складов">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/baggage_cart_box_16x16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllWarehouseTypeIds, Mode=OneWay}"
                                                      DisplayMember="DisplayValue"
                                                      EditValue="{Binding Path=SelectedWarehouseTypeIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Склады">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/house.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllWarehouses, Mode=OneWay}"
                                                      DisplayMember="Name"
                                                      EditValue="{Binding Path=SelectedWarehouses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Поставщики">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/building_go.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllSuppliers, Mode=OneWay}"
                                                      DisplayMember="DisplayValue"
                                                      EditValue="{Binding Path=SelectedSuppliers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CheckedTokenComboBoxStyle}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ComboBoxEdit>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="КШ"
                                                 ToolTip="Коэффициент ширины диаграммы в зависимости от кол-ва складов.">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/gear_16x16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=WidthCoefficients, Mode=OneWay}"
                                                      IsTextEditable="False"
                                                      SelectedItem="{Binding Path=SelectedWidthCoefficient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="ОМ"
                                                 ToolTip="Отображать только основные маршруты поставщиков">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/arrow_up_16x16.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:CheckEdit EditValue="{Binding Path=OnlyMainSupplierRoutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Без логистики"
                                                 ToolTip="Отображать объекты без логистики">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/house_table.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:CheckEdit EditValue="{Binding Path=WithoutLogistics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem>
                                    <dxb:ToolBarControl GlyphSize="Small">
                                        <dxb:BarButtonItem Content="Применить"
                                                           Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                           GlyphAlignment="Left"
                                                           Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItem Content="Отмена"
                                                           Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                           GlyphAlignment="Left"
                                                           Command="{Binding Path=ResetFilterCommand, Mode=OneWay}" />
                                    </dxb:ToolBarControl>
                                </dxlc:LayoutItem>
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>