<controls:TelemartUserControl x:Class="Telemart.Client.Views.SendSmsView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              Width="500"
                              Height="510"
                              DataContext="{client:Container Type=viewModels:SendSmsViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:SendSmsViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ReadOnlyPhoneTextEdit"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource PhoneTextEdit}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="0.6" />
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding Path=DataContext.Phone2, ElementName=CurrentUserControl, Mode=OneWay, Converter={dxmvvm:ObjectToBooleanConverter}}">
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            dxe:ValidationService.IsValidationContainer="True"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Подразделение">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Subdivisions, Mode=OneWay}"
                                      SelectedItem="{Binding Path=Subdivision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ShowEditorButtons="False"
                                      Style="{StaticResource ReadOnlyEditorStyle}">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Телефон">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Phones, Mode=OneWay}"
                                      EditValue="{Binding Path=Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyPhoneTextEdit}">
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <dxe:TextEdit Text="{Binding Mode=OneWay}"
                                              IsPrintingMode="True"
                                              Style="{StaticResource ReadOnlyPhoneTextEdit}" />
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Шаблон"
                                 Visibility="{Binding Path=Templates, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Templates, Mode=OneWay}"
                                      SelectedItem="{Binding Path=Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="DisplayName">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Сумма"
                                 Visibility="{Binding Path=AmountVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:TextEdit IsReadOnly="{Binding Path=AmountReadOnly, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                  MaskType="Numeric"
                                  Mask="######"
                                  IsEnabled="{Binding Path=AmountReadOnly, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                  EditValue="{Binding Path=Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  EditValueType="{x:Type system:Decimal}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Предложение"
                                 Visibility="{Binding Path=CreditOffersVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=CreditOffers, Mode=OneWay}"
                                      SelectedItem="{Binding Path=CreditOffer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name">
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="Способ отправки">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=SendMessageTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=SendMessageTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ValueMember="Id"
                                      DisplayMember="Name"/>
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="СМС"
                                 Height="100"
                                 LabelVerticalAlignment="Top">
                    <dxe:TextEdit x:Name="SmsTextEdit"
                                  Text="{Binding Path=SmsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  VerticalContentAlignment="Top"
                                  IsReadOnly ="{Binding Path=SmsTextEnabled, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ReadOnlyConditionsStyle}">
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Символов">
                    <TextBlock Text="{Binding Path=Text.Length, Mode=OneWay, ElementName=SmsTextEdit}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Viber"
                                 Height="100"
                                 LabelVerticalAlignment="Top">
                    <dxe:TextEdit x:Name="ViberTextEdit"
                                  Text="{Binding Path=ViberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  VerticalContentAlignment="Top"
                                  IsReadOnly ="{Binding Path=ViberTextEnabled, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ReadOnlyConditionsStyle}">
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Символов">
                    <TextBlock Text="{Binding Path=Text.Length, Mode=OneWay, ElementName=ViberTextEdit}"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                    <Button Content="Отправить"
                            Width="106"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=ValidationContainer, Converter={dx:NegationConverter}}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../Images/Order/Menu/mail_yellow.png"
                                                Stretch="Fill" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Отмена"
                            Width="103"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>