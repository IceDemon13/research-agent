<controls:TelemartUserControl x:Class="Telemart.Client.Views.Segment.RecalculateSegmentsView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Segment"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              DataContext="{client:Container Type=viewModels:RecalculateSegmentsViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:RecalculateSegmentsViewModel}}">

    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup View="GroupBox"
                              Header="Категории"
                              Orientation="Vertical"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                              Visibility="{Binding Path=ShowResultGrid, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                              ItemSpace="0">
                <dxg:GridControl x:Name="CategoriesGridControl"
                                 ItemsSource="{Binding Path=ParentCategories, Mode=OneWay}"
                                 SelectedItems="{Binding Path=SelectedParentCategories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="True"
                                 SelectionMode="Row"
                                 AutoExpandAllGroups="True"
                                 ShowBorder="False">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                        <behaviors:LayoutSerializationBehavior FileName="recalculate_segments.xml" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Id"
                                        HeaderToolTip="Код категории"
                                        Header="Код"
                                        FixedWidth="True"
                                        Width="50"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        MinWidth="50"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Name"
                                        Header="Категория"
                                        AllowColumnFiltering="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        MinWidth="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        Width="160"
                                        MaxWidth="180"
                                        HeaderToolTip="Название категории"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="EmployeeId"
                                        Header="Ответственный"
                                        AllowColumnFiltering="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        MinWidth="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        GroupIndex="0"
                                        Width="160"
                                        MaxWidth="180"
                                        HeaderToolTip="Ответственный"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees}"
                                                          ValueMember="Id"
                                                          DisplayMember="DisplayValue"
                                                          HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowPerPixelScrolling="True"
                                       ShowTotalSummary="False"
                                       ShowIndicator="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowCheckBoxSelectorInGroupRow="True"
                                       CheckBoxSelectorColumnWidth="24"
                                       ShowSearchPanelMode="Never"
                                       ShowGroupPanel="True"
                                       IsColumnMenuEnabled="False"
                                       ShowCheckBoxSelectorColumn="True"
                                       AutoWidth="True"
                                       IsEnabled="True"
                                       AllowResizing="True"
                                       AllowEditing="True"
                                       AllowGrouping="True"
                                       NavigationStyle="Row"
                                       AllowColumnMoving="False"
                                       AllowColumnFiltering="False"
                                       AllowSorting="True"
                                       AllowMoveColumnToDropArea="False" />
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup View="GroupBox"
                              Header="Результат"
                              Orientation="Vertical"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                              ItemSpace="0"
                              Visibility="{Binding Path=ShowResultGrid, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dxg:GridControl x:Name="ResultGridControl"
                                 ItemsSource="{Binding Path=ResultCategories, Mode=OneWay}"
                                 IsEnabled="True"
                                 SelectionMode="Cell"
                                 AutoExpandAllGroups="True"
                                 ShowBorder="False">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                        <behaviors:LayoutSerializationBehavior FileName="recalculate_segments_result.xml" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="ParentCategoryId"
                                        HeaderToolTip="Код категории"
                                        Header="Код"
                                        FixedWidth="True"
                                        Width="50"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        MinWidth="50"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ParentCategoryName"
                                        Header="Категория"
                                        AllowColumnFiltering="True"
                                        AllowGrouping="True"
                                        GroupIndex="0"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        MinWidth="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        Width="160"
                                        MaxWidth="180"
                                        HeaderToolTip="Название категории"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="SegmentName"
                                        Header="Название сегмента"
                                        AllowColumnFiltering="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        MinWidth="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        Width="160"
                                        MaxWidth="180"
                                        HeaderToolTip="Название сегмента"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="CalculatedProductsQuantity"
                                        Header="Товаров распределено"
                                        AllowColumnFiltering="True"
                                        AllowGrouping="True"
                                        AllowSorting="True"
                                        AllowMoving="True"
                                        MinWidth="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        Width="160"
                                        MaxWidth="180"
                                        HeaderToolTip="Товаров распределено"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowPerPixelScrolling="True"
                                       ShowTotalSummary="False"
                                       ShowIndicator="False"
                                       ShowFixedTotalSummary="False"
                                       ShowAutoFilterRow="False"
                                       ShowSearchPanelMode="Never"
                                       ShowGroupPanel="True"
                                       IsColumnMenuEnabled="False"
                                       AutoWidth="True"
                                       NavigationStyle="Cell"
                                       AllowResizing="True"
                                       AllowEditing="True"
                                       AllowGrouping="False"
                                       AllowColumnMoving="False"
                                       AllowColumnFiltering="False"
                                       AllowSorting="True"
                                       CustomCellAppearance="TableViewOnCustomCellAppearance"
                                       AllowMoveColumnToDropArea="False" >
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition Expression="[NoSegment] = TRUE"
                                                     FieldName="CalculatedProductsQuantity">
                                    <dx:Format Background="{StaticResource RetroRedColor}"
                                               Foreground="Black"
                                               FontWeight="SemiBold"/>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[NoSegmentNotFilledFeatures] = TRUE"
                                                     FieldName="CalculatedProductsQuantity">
                                    <dx:Format Background="{StaticResource BrazilOrangeColor}"
                                               Foreground="Black"
                                               FontWeight="SemiBold"/>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[NoSegment] = TRUE OR [NoSegmentNotFilledFeatures] = TRUE"
                                                     FieldName="SegmentName">
                                    <dx:Format FontStyle="Italic"
                                               FontWeight="SemiBold"/>
                                </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="{Binding Path=OkButtonText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>