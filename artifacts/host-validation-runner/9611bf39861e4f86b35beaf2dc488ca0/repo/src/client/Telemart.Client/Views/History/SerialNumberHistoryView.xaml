<UserControl x:Class="Telemart.Client.Views.History.SerialNumberHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:serialNumber="clr-namespace:Telemart.Client.ViewModels.History.SerialNumber"
             Width="800"
             Height="450"
             DataContext="{client:Container Type=serialNumber:SerialNumberHistoryViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type serialNumber:SerialNumberHistoryViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:CurrentWindowService />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="SN">
                    <dxlc:LayoutGroup>
                        <dxe:TextEdit EditValue="{Binding Path=SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      NullText="Введите SN"
                                      MaxLength="64">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:FocusBehavior />
                                <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                     Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                                     CommandParameter="{Binding Path=SerialNumber, Mode=OneWay}" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxe:TextEdit.Style>
                                <Style TargetType="dxe:TextEdit">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsReadOnly, Mode=OneWay}"
                                                     Value="True">
                                            <Setter Property="IsReadOnly"
                                                    Value="True" />
                                            <Setter Property="Opacity"
                                                    Value="{StaticResource DisabledElementOpacity}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </dxe:TextEdit.Style>
                        </dxe:TextEdit>
                        <dx:SimpleButton Content="Поиск"
                                         Glyph="../../../Images/Order/Nomenclature/find.png"
                                         HorizontalAlignment="Right"
                                         Visibility="{Binding Path=IsReadOnly, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                                         Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                         CommandParameter="{Binding Path=SerialNumber, Mode=OneWay}">
                        </dx:SimpleButton>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=Records, Mode=OneWay}"
                                 ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}"
                                 SelectionMode="None"
                                 DesignTimeDataObjectType="{x:Type serialNumber:SerialNumberHistoryViewItem}"
                                 DesignTimeDataSourceRowCount="3"
                                 DesignTimeUseDistinctSampleValues="True">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Дата"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="DateTime"
                                        FixedWidth="True"
                                        Width="85"
                                        MinWidth="85">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                      NullText=""
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                      MaskType="DateTime">
                                    <dxe:DateEditSettings.NullValue>
                                        <system:DateTime>1/1/0001</system:DateTime>
                                    </dxe:DateEditSettings.NullValue>
                                </dxe:DateEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Документ"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="DocumentTypeRu"
                                        FixedWidth="True"
                                        Width="100"
                                        MinWidth="60">
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Номер"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="DocumentId"
                                        FixedWidth="True"
                                        MinWidth="50"
                                        Width="50">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Инфо"
                                        HorizontalHeaderContentAlignment="Left"
                                        FieldName="Info"
                                        FixedWidth="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings TextTrimming="CharacterEllipsis"
                                                      AcceptsReturn="True"
                                                      DisplayTextConverter="{converters:MultiLineToSingleLineTextConverter}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowSorting="True"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding Path=ViewDocumentCommand, Mode=OneTime}"
                                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>