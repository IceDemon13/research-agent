<UserControl x:Class="Telemart.Client.Views.Payment.CreditOffersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:payments="clr-namespace:Telemart.Client.ViewModels.Payments"
             mc:Ignorable="d"
             DataContext="{client:Container Type=payments:CreditOffersViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type payments:CreditOffersViewModel}}"
             Width="1250"
             Height="700"
             d:DesignWidth="1280"
             d:DesignHeight="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <DockPanel>
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Минимальная маржа по товарам, %">
                    <dxe:TextEdit MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="C2"
                                  IsEnabled="{Binding Path=MinProductMarginPercentReadOnlyMode, Mode=OneWay,Converter={dxmvvm:BooleanNegationConverter}}"
                                  MaskSaveLiteral="False"
                                  EditValue="{Binding Path=MinProductMarginPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" >
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Минимальное количество платежей по товару">
                    <dxe:TextEdit MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="##"
                                  IsEnabled="{Binding Path=ReadOnlyMode, Mode=OneWay,Converter={dxmvvm:BooleanNegationConverter}}"
                                  MaskSaveLiteral="False"
                                  AllowNullInput="True"
                                  EditValue="{Binding Path=MinPartialPayCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" >
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="0"
                                  View="GroupBox"
                                  IsEnabled="True"
                                  GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="True">
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCreditOfferCommand, Mode=OneWay}" />
                    </dxb:ToolBarControl>
                    
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=CreditOffers, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     VerticalAlignment="Stretch"
                                     IsEnabled="{Binding Path=ReadOnlyMode, Mode=OneWay,Converter={dxmvvm:BooleanNegationConverter}}"
                                     HorizontalAlignment="Stretch"
                                     SelectionMode="Cell">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Название"
                                            HeaderToolTip="Название кредитного предложения"
                                            FieldName="Name"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="50"
                                            Width="250">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings  />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Название (укр.)"
                                            HeaderToolTip="Украинское название кредитного предложения"
                                            FieldName="NameUkr"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="50"
                                            Width="250">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings  />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Название (англ.)"
                                            HeaderToolTip="Английское название кредитного предложения"
                                            FieldName="NameEn"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="50"
                                            Width="250">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings  />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Способ оплаты"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            HorizontalHeaderContentAlignment="Left"
                                            FieldName="PaymentId"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowMoving="False"
                                            MinWidth="100"
                                            Width="300"
                                            MaxWidth="300"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            AllowAutoFilter="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=CreditPayments}"
                                                              ValueMember="Id"
                                                              DisplayMember="DisplayValue"
                                                              HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Кол-во платежей"
                                            HeaderToolTip="Количество платежей"
                                            FieldName="CreditPartCount"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="50"
                                            Width="145">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="##"
                                                          MaskSaveLiteral="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Кол-во месяцев"
                                            HeaderToolTip="Количество месяцев"
                                            FieldName="Month"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="145">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="##"
                                                          MaskSaveLiteral="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Комиссия"
                                            HeaderToolTip="Комиссия провайдера"
                                            FieldName="Fee"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="100">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskSaveLiteral="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="А"
                                            HeaderToolTip="Активное предложение"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Active"
                                            AllowMoving="False"
                                            AllowEditing="True"
                                            FixedWidth="True"
                                            MaxWidth="36"
                                            Width="36"
                                            MinWidth="36">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:CheckEdit x:Name="PART_Editor"
                                                       HorizontalAlignment="Left"
                                                       Margin="3,0,0,0"
                                                       IsThreeState="False">
                                        </dxe:CheckEdit>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>


                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowResizing="True"
                                           AllowPerPixelScrolling="True"
                                           ShowGroupPanel="False"
                                           AutoWidth="True"
                                           AllowEditing="True"
                                           ShowIndicator="False"
                                           AllowGrouping="False" >
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                
                
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="HandleLoadedCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsTabStop="True"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=ValidationContainer, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            IsTabStop="True"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>
</UserControl>