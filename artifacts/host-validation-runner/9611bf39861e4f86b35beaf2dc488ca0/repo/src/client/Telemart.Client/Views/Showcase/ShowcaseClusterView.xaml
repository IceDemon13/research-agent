<UserControl x:Class="Telemart.Client.Views.Showcase.ShowcaseClusterView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Showcase"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             DataContext="{client:Container Type=viewModels:ShowcaseClusterViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ShowcaseClusterViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Категория">
                    <dxlc:LayoutItem.LabelTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:DXImage Source="../../../Images/Parser/folders_16_16.png"
                                            Style="{StaticResource ImageStyle}" />
                                <TextBlock Text="{Binding Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxlc:LayoutItem.LabelTemplate>
                    <dxg:LookUpEdit x:Name="CategoryLookUpEdit"
                                    ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                    EditValue="{Binding Path=SelectedCategoryIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                    DisplayMember="Name"
                                    ValueMember="Id"
                                    AutoPopulateColumns="False"
                                    AutoComplete="False"
                                    IncrementalFiltering="False"
                                    FilterCondition="Default"
                                    FindMode="Always"
                                    ImmediatePopup="True"
                                    IsPopupAutoWidth="True"
                                    VerticalAlignment="Top"
                                    NullText="Выберите категорию"
                                    NullValueButtonPlacement="EditBox"
                                    IsEnabled="{Binding SearchByFilterCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                    Style="{StaticResource LookUpReadOnlyConditionsStyle}">
                        <dxg:LookUpEdit.StyleSettings>
                            <dxg:MultiSelectLookUpEditStyleSettings />
                        </dxg:LookUpEdit.StyleSettings>
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                   Command="{Binding Path=SearchByFilterCommand, Mode=OneWay}"
                                                   PassEventArgsToCommand="True" />
                            <dxmvvm:EventToCommand EventName="EditValueChanging"
                                                   Command="{Binding Path=AllowSearchByFilterCommand, Mode=OneWay}"
                                                   PassEventArgsToCommand="True"
                                                   />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <dxg:GridControl x:Name="PART_GridControl">
                                    <dxg:GridControl.Resources>
                                        <Style TargetType="dxg:GridColumn"
                                               BasedOn="{StaticResource GeneralGridColumnStyle}">
                                        </Style>
                                    </dxg:GridControl.Resources>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="Name"
                                                        Header="Папка"
                                                        AllowResizing="False"
                                                        FixedWidth="False" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView AutoWidth="True"
                                                          AutoExpandAllNodes="False"
                                                          KeyFieldName="Id"
                                                          ParentFieldName="ParentId"
                                                          ShowIndicator="False"
                                                          UseEvenRowBackground="True"
                                                          AlternationCount="2"
                                                          FilteringMode="EntireBranch"
                                                          ExpandNodesOnFiltering="True"
                                                          ShowCheckboxes="True"
                                                          CheckBoxFieldName="Selected"
                                                          AllowRecursiveNodeChecking="True"
                                                          SearchPanelAllowFilter="True"
                                                          ShowSearchPanelMode="Always"
                                                          SearchPanelHighlightResults="True"
                                                          SearchPanelFindFilter="Like">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand EventName="NodeCheckStateChanged"
                                                                       Command="{Binding Path=HandleNodeCheckStateChangedCommand, Mode=OneWay}" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TreeListView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="0"
                                  View="GroupBox"
                                  GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="True">
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddShowcaseClusterCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteShowcaseClusterCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Заполнить"
                                           Glyph="../../../Images/Common/android.png"
                                           Command="{Binding Path=ShowcaseClusterFillCommand, Mode=OneTime}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="ShowcaseCategoriesGridControl"
                                     ItemsSource="{Binding Path=ShowcaseClusters, Mode=OneWay}"
                                     SelectedItem="{Binding Path=SelectedShowcaseCluster, Mode=TwoWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False">
                        <dxg:GridControl.ShowLoadingPanel>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="SearchByFilterCommand.IsExecuting"/>
                                <Binding Path="SaveCommand.IsExecuting"/>
                                <Binding Path="AddShowcaseClusterCommand.IsExecuting"/>
                            </MultiBinding>
                        </dxg:GridControl.ShowLoadingPanel>
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Кластер"
                                            FieldName="ClusterId"
                                            FixedWidth="False"
                                            Width="100"
                                            AllowEditing="False"
                                            MinWidth="70"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowMoving="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Clusters}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Категория"
                                            FieldName="CategoryId"
                                            FixedWidth="False"
                                            Width="100"
                                            ReadOnly="False"
                                            AllowEditing="False"
                                            MinWidth="70"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Categories}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name"
                                                              HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Локации"
                                            Binding="{Binding LocationIds, Mode=TwoWay, Converter={converters:IntItemsConverter},  UpdateSourceTrigger=PropertyChanged}"
                                            HeaderToolTip="Локации, которые входят в кластер"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            Width="120"
                                            MinWidth="60"
                                            MaxWidth="200"
                                            AllowEditing="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding Path=DataContext.Locations, Mode=OneWay, ElementName=CurrentUserControl, UpdateSourceTrigger=PropertyChanged}"
                                                          EditValue="{Binding RowData.Row.LocationIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={converters:IntItemsConverter}}"
                                                          DisplayMember="Name"
                                                          ValueMember="Id"
                                                          Style="{StaticResource ReadOnlyGridCheckedTokenComboBoxStyle}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="QuantityLocation"
                                            Header="План по локации"
                                            HorizontalHeaderContentAlignment="Center"
                                            MinWidth="50"
                                            Width="100"
                                            MaxWidth="100"
                                            AllowEditing="True"
                                            AllowResizing="True"
                                            AllowMoving="False"
                                            FixedWidth="True"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            HeaderToolTip="SKU плановое по локации">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings HorizontalContentAlignment="Center"
                                                          IsFloatValue="False"
                                                          MinValue="0"
                                                          MaxValue="9999"
                                                          Increment="1">
                                    </dxe:SpinEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="CountLocations"
                                            Header="Кол-во локаций"
                                            MinWidth="50"
                                            Width="100"
                                            MaxWidth="100"
                                            HeaderToolTip="Колличество локаций в кластере"
                                            AllowGrouping="True"
                                            AllowMoving="True"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="QuantityClusterPlan"
                                            Header="План по кластеру"
                                            MinWidth="30"
                                            Width="50"
                                            MaxWidth="100"
                                            AllowResizing="True"
                                            HeaderToolTip="SKU плановое по кластеру"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="QuantityClusterFact"
                                            Header="Факт по кластеру"
                                            MinWidth="50"
                                            Width="100"
                                            MaxWidth="100"
                                            HeaderToolTip="SKU фактическое по кластеру"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Изменил"
                                            FieldName="ModifiedBy"
                                            AllowGrouping="True"
                                            AllowMoving="True"
                                            AllowEditing="False"
                                            Width="150"
                                            MinWidth="40">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                                                  DisplayMember="DisplayValue"
                                                                  ValueMember="Id" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Изменено"
                                                HeaderToolTip="Дата изменения"
                                                FieldName="ModifiedOn"
                                                FixedWidth="True"
                                                MinWidth="70"
                                                Width="90"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowGrouping="True"
                                                AllowMoving="True"
                                                GroupInterval="Date">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                              NullText=""
                                                              MaskUseAsDisplayFormat="True"
                                                              Mask="dd.MM.yy HH:mm"
                                                              MaskType="DateTime">
                                            <dxe:DateEditSettings.NullValue>
                                                <system:DateTime>1/1/0001</system:DateTime>
                                            </dxe:DateEditSettings.NullValue>
                                        </dxe:DateEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="True"
                                           IsColumnMenuEnabled="False"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           AllowResizing="True"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           AllowMoveColumnToDropArea="False">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
             <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>



</UserControl>