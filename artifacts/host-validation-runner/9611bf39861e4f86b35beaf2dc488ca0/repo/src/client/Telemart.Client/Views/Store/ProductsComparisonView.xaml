<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.ProductsComparisonView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:store="clr-namespace:Telemart.Client.ViewModels.Store"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              mc:Ignorable="d"
                              d:DesignWidth="640"
                              d:DesignHeight="480">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Del"
                             Command="{Binding Path=RemoveProductCommand, Mode=OneTime}"
                             CommandParameter="{Binding Path=SelectedProduct, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Insert"
                             Command="{Binding Path=AddProductCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+P"
                             Command="{Binding Path=PrintOurBarcodesCommand, Mode=OneTime}"
                             CommandParameter="{Binding Path=SelectedProduct, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="F12"
                             Command="{Binding Path=DocumentCommands.ShowProductCardCommand, Mode=OneTime}"
                             CommandParameter="{Binding Path=SelectedProduct.ProductId, Mode=OneWay}" />
        <dxmvvm:CurrentWindowService ClosingCommand="{Binding Path=WindowClosingCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            IsEnabled="{Binding Path=IsRecognitionInProgress, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              ItemSpace="0">
                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                    <dxb:BarButtonItem Content="Добавить (Insert)"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=AddProductCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Удалить (Del)"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       Command="{Binding Path=RemoveProductCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarButtonItem Content="Настройки (F12)"
                                       Glyph="../../Images/Common/gear_16x16.png"
                                       Command="{Binding Path=DocumentCommands.ShowProductCardCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=SelectedProduct.ProductId, Mode=OneWay}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Content="Напечатать наш ШК (Ctrl+P)"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       Command="{Binding Path=PrintOurBarcodesCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarButtonItem Content="Напечатать импортный стикер"
                                       Glyph="{dx:DXImage Image=Print_16x16.png}"
                                       Command="{Binding Path=PrintImportStickerCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarButtonItem Content="Сгенерировать SN"
                                       Glyph="{dx:DXImage Image=Barcode_16x16.png}"
                                       Command="{Binding Path=GenerateSerialNumbersCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=GridControl}" LargeGlyph="{dx:DXImage Image=Barcode_32x32.png}" />
                </dxb:ToolBarControl>
                <dxlc:LayoutItem>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Path=VisibleWarningText, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True}}">
                        <Image Source="../../../Images/warning.png"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Path=WarningText, Mode=OneWay}"
                               Foreground="Firebrick"
                               TextWrapping="Wrap"
                               Margin="5,0,0,0" />
                    </StackPanel>
                </dxlc:LayoutItem>
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=ProductComparisonViewItems, Mode=OneWay}"
                                 CurrentItem="{Binding Path=SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionMode="None"
                                 ClipboardCopyMode="ExcludeHeader">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.ShowLoadingPanel>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="OkCommand.IsExecuting" />
                        </MultiBinding>
                    </dxg:GridControl.ShowLoadingPanel>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Товар"
                                        HeaderToolTip="Товар"
                                        FieldName="FullName" />
                        <dxg:GridColumn Header="Кол-во"
                                        HeaderToolTip="Количество"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="QuantityReal"
                                        FixedWidth="True"
                                        Width="55">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ButtonEdit x:Name="PART_Editor"
                                                    HorizontalContentAlignment="Center"
                                                    AllowDefaultButton="False"
                                                    IsTextEditable="False">
                                        <dxe:ButtonInfo GlyphKind="Search"
                                                        Visibility="{Binding Path=RowData.Row.KeepSerial, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                        Command="{Binding Path=EditSerialsCommand, Mode=OneWay, ElementName=GridControl}"
                                                        CommandParameter="{Binding Path=RowData.Row, Mode=OneWay}"
                                                        Click="ButtonInfoOnClick"
                                                        Margin="0"/>
                                        <dxe:ButtonInfo GlyphKind="Edit"
                                                        Command="{Binding Path=SetQuantityRealCommand, Mode=OneWay, ElementName=GridControl}"
                                                        CommandParameter="{Binding Path=RowData.Row, Mode=OneWay}"
                                                        Click="ButtonInfoOnClick"
                                                        Margin="0">
                                            <dxe:ButtonInfo.Visibility>
                                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                    <Binding Path="RowData.Row.KeepSerial"
                                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                                    <Binding Path="RowData.Row.SelfBarcode" />
                                                </MultiBinding>
                                            </dxe:ButtonInfo.Visibility>
                                        </dxe:ButtonInfo>
                                        <dxe:ButtonInfo GlyphKind="Cancel"
                                                        Command="{Binding Path=ResetQuantityRealCommand, Mode=OneWay, ElementName=GridControl}"
                                                        CommandParameter="{Binding Path=RowData.Row, Mode=OneWay}"
                                                        Click="ButtonInfoOnClick"
                                                        Margin="0">
                                            <dxe:ButtonInfo.Visibility>
                                                <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                    <Binding Path="RowData.Row.KeepSerial"
                                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                                    <Binding Path="RowData.Row.SelfBarcode"
                                                             Converter="{dxmvvm:BooleanNegationConverter}" />
                                                </MultiBinding>
                                            </dxe:ButtonInfo.Visibility>
                                        </dxe:ButtonInfo>
                                    </dxe:ButtonEdit>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="С"
                                        HeaderToolTip="По товару ведется учет SN"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="KeepSerial"
                                        FixedWidth="True"
                                        Width="24"
                                        MinWidth="24">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dx:DXImage Width="16"
                                                Source="../../Images/Contractor/tick.png"
                                                Visibility="{Binding Path=RowData.Row.KeepSerial, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Ш"
                                        HeaderToolTip="Необходимо печатать наш ШК"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="SelfBarcode"
                                        FixedWidth="True"
                                        Width="24"
                                        MinWidth="24">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dx:DXImage Width="16"
                                                Source="../../Images/Contractor/tick.png"
                                                Visibility="{Binding Path=RowData.Row.SelfBarcode, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowResizing="False"
                                       AllowSorting="True"
                                       EditorShowMode="MouseDown"
                                       EditorButtonShowMode="ShowAlways"
                                       ShowSearchPanelMode="Always"
                                       SearchPanelFindFilter="Default"
                                       ShowSearchPanelFindButton="True"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                       Command="{Binding Path=EditQuantityRealCommand, Mode=OneTime}"
                                                       CommandParameter="{Binding Path=SelectedProduct, Mode=OneWay}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              dxlc:LayoutControl.AllowVerticalSizing="True">
                <dxlc:LayoutGroup.MinHeight>
                    <Binding Path="MinHeight"
                             Mode="OneWay"
                             ElementName="RecognizeBarcodeView" />
                </dxlc:LayoutGroup.MinHeight>
                <dxlc:LayoutGroup.Height>
                    <Binding Path="MinHeight"
                             Mode="OneWay"
                             ElementName="RecognizeBarcodeView" />
                </dxlc:LayoutGroup.Height>
                <dxlc:LayoutGroup.MaxHeight>
                    <MultiBinding Converter="{converters:ResizableLayoutGroupMaxDimensionConverter OppositeMinDimensionValue=160}">
                        <Binding Path="ActualHeight"
                                 RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                        <Binding Path="ItemSpace"
                                 RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                        <Binding Path="Padding"
                                 RelativeSource="{RelativeSource AncestorType=dxlc:LayoutControl}" />
                    </MultiBinding>
                </dxlc:LayoutGroup.MaxHeight>
                <common:RecognizeBarcodeView x:Name="RecognizeBarcodeView"
                                             DataContext="{Binding Path=RecognizeBarcodeViewModel, Mode=OneWay}" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Command="{Binding Path=OkCommand, Mode=OneWay}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>
