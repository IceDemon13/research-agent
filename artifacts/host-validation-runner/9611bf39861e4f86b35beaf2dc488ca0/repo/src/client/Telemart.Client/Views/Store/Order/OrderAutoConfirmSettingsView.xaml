<UserControl x:Class="Telemart.Client.Views.Store.Order.OrderAutoConfirmSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:OrderAutoConfirmSettingsViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderAutoConfirmSettingsViewModel}}"
             Width="1183"
             Height="700"
             d:DesignWidth="1183"
             d:DesignHeight="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <DockPanel>
        <dxlc:LayoutControl x:Name="ValidationContainer"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup Header="Общие настройки"
                                  View="GroupBox"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0"
                                  Orientation="Vertical"
                                  HorizontalAlignment="Stretch">
                    <dxlc:LayoutItem Label="{Binding Path=AllowableOnlyDontCall.DisplayName, Mode=OneWay}" Margin=" 10 5 0 0"
                                     ToolTip="{Binding AllowableOnlyDontCall.Description, Mode=OneWay}"
                                     HorizontalAlignment="Left">
                        <dxe:CheckEdit EditValue="{Binding Path=AllowableOnlyDontCall.BoolValue, Mode=TwoWay}"
                                       ToolTip="{Binding AllowableOnlyDontCall.Description, Mode=OneWay}"
                                       IsThreeState="False"/>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutGroup Orientation="Horizontal" Margin="10 0 0 5">
                        <dxlc:LayoutItem Label="{Binding Path=AllowSalesHistoryDeviation.DisplayName, Mode=OneWay}"
                                         HorizontalAlignment="Left"
                                         ToolTip="{Binding AllowSalesHistoryDeviation.Description, Mode=OneWay}">
                            <dxe:CheckEdit EditValue="{Binding Path=AllowSalesHistoryDeviation.BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsThreeState="False"
                                           ToolTip="{Binding AllowSalesHistoryDeviation.Description, Mode=OneWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                           Command="{Binding Path=HandleToActiveChangedCommand, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:CheckEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="{Binding Path=SalesHistoryDays.DisplayName, Mode=OneWay}"
                                         HorizontalAlignment="Left"
                                         MaxWidth="250"
                                         ToolTip="{Binding SalesHistoryDays.Description, Mode=OneWay}">
                            <dxe:SpinEdit EditValue="{Binding Path=SalesHistoryDays.IntValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          AllowNullInput="False"
                                          IsFloatValue="False"
                                          InvalidValueBehavior="AllowLeaveEditor"
                                          AllowDefaultButton="True"
                                          EditValueType="{x:Type system:Int32}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"
                                          IsReadOnly="{Binding SalesHistoryDeviation.Active, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                          ToolTip="{Binding SalesHistoryDays.Description, Mode=OneWay}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="{Binding Path=SalesHistoryDeviation.DisplayName, Mode=OneWay}"
                                         HorizontalAlignment="Left"
                                         MaxWidth="250"
                                         ToolTip="{Binding SalesHistoryDeviation.Description, Mode=OneWay}">
                            <dxe:SpinEdit EditValue="{Binding Path=SalesHistoryDeviation.IntValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True }"
                                          MaskType="Numeric"
                                          MaskUseAsDisplayFormat="True"
                                          MaskSaveLiteral="False"
                                          AllowNullInput="False"
                                          IsFloatValue="False"
                                          InvalidValueBehavior="AllowLeaveEditor"
                                          AllowDefaultButton="True"
                                          EditValueType="{x:Type system:Int32}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}"
                                          IsReadOnly="{Binding SalesHistoryDeviation.Active, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                          ToolTip="{Binding SalesHistoryDeviation.Description, Mode=OneWay}"/>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="0"
                                  View="GroupBox"
                                  IsEnabled="True"
                                  GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                        IsEnabled="True">
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=DeleteCommand, Mode=OneWay}" />
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Settings, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     SelectedItem="{Binding Path=SelectedSetting, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     CurrentItem="{Binding Path=SelectedSetting, ValidatesOnDataErrors=True, Mode=TwoWay}"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     SelectionMode="Cell">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="order_auto_confirm_settings.xml" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Доставка"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Carry"
                                            ReadOnly="False"
                                            AllowMoving="False"
                                            IsEnabled="True"
                                            AllowColumnFiltering="True"
                                            AllowSorting="True"
                                            AllowEditing="True"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            HorizontalHeaderContentAlignment="Center"
                                            Width="120">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding Path=DataContext.Carries, ElementName=ValidationContainer}"
                                                          DisplayMember="Name"
                                                          FontWeight="SemiBold"
                                                          ApplyItemTemplateToSelectedItem="True"
                                                          IsEnabled="{Binding Path=RowData.Row.Carry}"
                                                          HorizontalContentAlignment="Left" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Оплата"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Payment"
                                            ReadOnly="False"
                                            AllowMoving="False"
                                            AllowColumnFiltering="True"
                                            IsEnabled="True"
                                            AllowSorting="True"
                                            AllowEditing="True"
                                            HorizontalHeaderContentAlignment="Center"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="120">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                          ItemsSource="{Binding Path=DataContext.Payments, ElementName=ValidationContainer}"
                                                          DisplayMember="Name"
                                                          FontWeight="SemiBold"
                                                          ApplyItemTemplateToSelectedItem="True"
                                                          IsEnabled="{Binding Path=RowData.Row.Payment}"
                                                          HorizontalContentAlignment="Left" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn AllowSorting="False"
                                                        ReadOnly="True"
                                                        IsEnabled="False"
                                                        AllowColumnFiltering="False"
                                                        AllowEditing="False"
                                                        AllowMoving="False"
                                                        FixedWidth="True"
                                                        AllowResizing="False"
                                                        Width="2">
                                <dxg:GridColumn.CellStyle>
                                    <Style
                                        BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}"
                                        TargetType="{x:Type dxg:LightweightCellEditor}">
                                        <Setter Property="Background" Value="Gray" />
                                    </Style>
                                </dxg:GridColumn.CellStyle>
                                <dxg:GridColumn.HeaderStyle>
                                    <Style TargetType="dxg:GridColumnHeader">
                                        <Setter Property="Background" Value="Gray" />
                                    </Style>
                                </dxg:GridColumn.HeaderStyle>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Макс. сумма заказа"
                                            HeaderToolTip="Максимальная сумма заказа"
                                            FieldName="MaxSumLimit"
                                            AllowSorting="True"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="150">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskSaveLiteral="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Мин. % рент."
                                            HeaderToolTip="Минимальный процент рентабельности"
                                            FieldName="MinExtraChargePercent"
                                            ReadOnly="False"
                                            AllowSorting="True"
                                            AllowEditing="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="120">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskSaveLiteral="False" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Макс. кол-во товара"
                                            HeaderToolTip="Максимальное количество товара"
                                            FieldName="MaxProductQuantity"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="150">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="###" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Макс. кол-во строк"
                                            HeaderToolTip="Максимальное количество строк"
                                            FieldName="MaxLinesQuantity"
                                            ReadOnly="False"
                                            AllowEditing="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowResizing="True"
                                            FixedWidth="False"
                                            MinWidth="40"
                                            Width="150">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="###" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn
                                Header="Источники"
                                HeaderToolTip="Источники товара"
                                Width="340"
                                AllowGrouping="False"
                                AllowSorting="False"
                                IsEnabled="True"
                                ReadOnly="False"
                                AllowEditing="True"
                                AllowColumnFiltering="True"
                                AllowResizing="True"
                                FixedWidth="False"
                                MinWidth="40"
                                FilterPopupMode="CheckedList">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit
                                            DisplayMember="DisplayValue"
                                            ValueMember="Id"
                                            ShowPopupIfReadOnly="False"
                                            IncrementalFiltering="True"
                                            IsTextEditable="False"
                                            ValidateOnEnterKeyPressed="False"
                                            AllowLiveDataShaping="False"
                                            AllowUpdateTwoWayBoundPropertiesOnSynchronization="False"
                                            IsEnabled="True"
                                            ItemsSource="{Binding Path=DataContext.OrderProductSources, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ElementName=ValidationContainer}"
                                            EditValue="{Binding Path=RowData.Row.OrderProductSources, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            ApplyItemTemplateToSelectedItem="False"
                                            Style="{StaticResource GridCheckedTokenComboBoxStyle}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AllowResizing="True"
                                           AllowPerPixelScrolling="True"
                                           ShowGroupPanel="False"
                                           AutoWidth="True"
                                           AllowEditing="True"
                                           CustomCellAppearance="TableView_OnCustomCellAppearance"
                                           ShowIndicator="False"
                                           AllowGrouping="False" >
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="HandleLoadedCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsTabStop="True"
                            IsEnabled="True" />
                    <Button Content="Отмена"
                            IsTabStop="True"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>
</UserControl>