                            <dxb:BarButtonItem Content="Вычислить (F8)"
                                               Glyph="{StaticResource Calculator16}"
                                               Command="{Binding Path=DataContext.CalcPricesCommand, Mode=OneWay, ElementName=GridControl}"
                                               CommandParameter="True"/>
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Очистить выше"
                                               Glyph="{StaticResource PageWhiteGet16}"
                                               ItemClick="BarItemClearUpItemClick" />
                            <dxb:BarButtonItem Content="Очистить ниже"
                                               Glyph="{StaticResource PageWhitePut16}"
                                               ItemClick="BarItemClearDownItemClick"/>
                            <dxb:BarButtonItem Content="Анализ рассчета робота"
                                               Glyph="../../../Images/Common/page_white_magnify.png"
                                               Command="{Binding Path=DataContext.ShowPropertyChangesCommand, Mode=OneWay, ElementName=GridControl}" />
                        </dxg:TableView.RowCellMenuCustomizations>
                        <dxg:TableView.GroupRowStyle>
                            <Style>
                                <Setter Property="ToolTipService.ToolTip" Value="{Binding Path=Row.SegmentToolTip}"/>
                            </Style>
                        </dxg:TableView.GroupRowStyle>
                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition Expression="[Active] &lt; 1"
                                                 FieldName="Name">
                                <dx:Format Foreground="DarkGray" />
                            </dxg:FormatCondition>
                            <dxg:FormatCondition Expression="[Active] = 0"
                                                 FieldName="Name">
                                <dx:Format TextDecorations="Strikethrough" />
                            </dxg:FormatCondition>
                            <dxg:FormatCondition Expression="[SegmentOrderQuantityAbcId] = 1 OR [SegmentProfitAbcId] = 1 OR [SegmentPriceOutAbcId] = 1"
                                                 FieldName="Name">
                                <dx:Format Background="LightGreen"
                                           Foreground="Black"/>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition Expression="1 = 1"
                                                 FieldName="OrdersCurrentMonth"
                                                 ApplyToRow="False">
                                <dx:Format Background="LightCyan"
                                           Foreground="Black"/>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition Expression="1 = 1"
                                                 FieldName="OrdersLastMonth"
                                                 ApplyToRow="False">
                                <dx:Format Background="LightCyan"
                                           Foreground="Black"/>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition Expression="1 = 1"
                                                 FieldName="OrdersBeforeLastMonth"
                                                 ApplyToRow="False">
                                <dx:Format Background="LightCyan"
                                           Foreground="Black"/>
                            </dxg:FormatCondition>
                            <dxg:FormatCondition Expression="[HotlinePosition] is not null and [HotlinePosition] &lt; 15"
                                                 FieldName="HotlinePosition">
                                <dx:Format Foreground="Green" />
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup View="Tabs"
                          Width="{StaticResource ProductInfoWidth}"
                          SelectedTabIndex="{Binding Path=RightPanelSelectedTabIndex, Mode=TwoWay}"
                          TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                          TabStyle="{StaticResource LayoutGroupTabStyle}">
            <dxlc:LayoutGroup Header="Поиск"
                              Margin="8,12,8,8">
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemStyle="{StaticResource LayoutItemStyle}"
                                  Margin="0,0,0,0">
                    <dxlc:LayoutItem Label="Название">
                        <dxlc:LayoutItem.LabelTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Parser/book_16_16.png"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBlock Text="{Binding Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutItem.LabelTemplate>
                        <dxe:TextEdit EditValue="{Binding Path=SearchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                     Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Контрагент">
                        <dxlc:LayoutItem.LabelTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Order/Filter/user_suit.png"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBlock Text="{Binding Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutItem.LabelTemplate>
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                          DisplayMember="DisplayValue"
                                          EditValue="{Binding Path=SelectedContractors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ComboBoxItemsConverter}}"
                                          Style="{StaticResource CheckedTokenComboBoxStyle}">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Наличие">
                        <dxlc:LayoutItem.LabelTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Order/Filter/package.png"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBlock Text="{Binding Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutItem.LabelTemplate>
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=AvailTypes, Mode=OneWay}"
                                          DisplayMember="DisplayValue"
                                          EditValue="{Binding Path=SelectedAvailTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ComboBoxItemsConverter}}"
                                          Style="{StaticResource CheckedTokenComboBoxStyle}">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Тип товара">
                        <dxlc:LayoutItem.LabelTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Order/Filter/package.png"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBlock Text="{Binding Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutItem.LabelTemplate>
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=ProductTypes, Mode=OneWay}"
                                          DisplayMember="DisplayValue"
                                          EditValue="{Binding Path=SelectedProductTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ComboBoxItemsConverter}}"
                                          Style="{StaticResource CheckedTokenComboBoxStyle}">
                        </dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Категория">
                        <dxlc:LayoutItem.LabelTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Parser/folders_16_16.png"
                                                Style="{StaticResource ImageStyle}" />
                                    <TextBlock Text="{Binding Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutItem.LabelTemplate>
                        <dxg:LookUpEdit x:Name="FilterCategoryLookUpEdit"
                                        ItemsSource="{Binding Path=Categories, Mode=OneWay}"
                                        EditValue="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        DisplayMember="Name"
                                        AutoPopulateColumns="False"
                                        AutoComplete="False"
                                        IncrementalFiltering="True"
                                        FilterCondition="Like"
                                        FindMode="Always"
                                        ImmediatePopup="True"
                                        IsPopupAutoWidth="True"
                                        VerticalAlignment="Top"
                                        NullText="Выберите категорию"
                                        NullValueButtonPlacement="EditBox">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                       Command="{Binding Path=SearchByFilterCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="False" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.StyleSettings>
                                <dxg:SearchLookUpEditStyleSettings />
                            </dxg:LookUpEdit.StyleSettings>
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl x:Name="PART_GridControl">
                                        <dxg:GridControl.Resources>
                                            <Style TargetType="dxg:GridColumn"
                                                   BasedOn="{StaticResource GeneralGridColumnStyle}">
                                            </Style>
                                        </dxg:GridControl.Resources>
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Name"
                                                            Header="Папка"
                                                            AllowResizing="False"
                                                            FixedWidth="False" />
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView AutoWidth="True"
                                                              AutoExpandAllNodes="False"
                                                              KeyFieldName="Id"
                                                              ParentFieldName="ParentId"
                                                              ShowIndicator="False"
                                                              UseEvenRowBackground="True"
                                                              ShowSearchPanelMode="Always"
                                                              AlternationCount="2"
                                                              FilteringMode="EntireBranch"
                                                              ExpandNodesOnFiltering="True"/>
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayerSeparator Kind="Horizontal" />
                    <commonViews:CategoryFiltersView AccordionItems="{Binding Path=FilterItems, Mode=OneWay}"
                                                IsSplashScreenShown="{Binding Path=SearchByFilterCommand.IsExecuting, Mode=OneWay}" />
                    <dxlc:LayerSeparator Kind="Horizontal" />
                    <dxlc:LayoutItem Label="Товаров">
                        <dxlc:LayoutItem.LabelTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Style="{StaticResource ImageStyle}" />
                                    <TextBlock Text="{Binding Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutItem.LabelTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=Products.Count, Mode=OneWay, FallbackValue=0}"
                                       FontWeight="Bold" />
                            <TextBlock Text=" шт." />
                        </StackPanel>
                    </dxlc:LayoutItem>
                    <dxlc:LayerSeparator Kind="Horizontal"
                                         Thickness="1"
                                         Height="1" />
                    <dxb:ToolBarControl GlyphSize="Small">
                        <dxb:BarButtonItem Content="Применить"
                                           Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                           Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                           GlyphAlignment="Left" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItem Content="Отмена"
                                           Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                           Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                           GlyphAlignment="Left" />
                    </dxb:ToolBarControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="Инфо">
                <productInformation:ProductInformation DataContext="{Binding Path=ProductInformation, Mode=OneWay}"
                                                       dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Path=DataContext, Mode=OneWay, ElementName=GridControl}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>