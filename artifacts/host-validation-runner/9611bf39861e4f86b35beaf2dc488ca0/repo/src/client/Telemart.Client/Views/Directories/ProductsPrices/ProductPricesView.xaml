<UserControl x:Class="Telemart.Client.Views.Directories.ProductsPrices.ProductPricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.ProductsPrices"
             xmlns:productInformation="clr-namespace:Telemart.Client.Views.Store.Order.ProductInformation"
             xmlns:common="clr-namespace:Telemart.Client.Common"
             xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:ProductPricesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductPricesViewModel}}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/BonusType.xaml" />
                <ResourceDictionary>
                    <system:Double x:Key="ProductInfoWidth">300</system:Double>
                    <system:Int32 x:Key="Int32Zero">0</system:Int32>
                    <system:Decimal x:Key="DecimalZero">0</system:Decimal>
                    <system:Double x:Key="DoubleZero">0</system:Double>
                    <dxg:GridColumnWidth x:Key="PriceColumnWidth">78</dxg:GridColumnWidth>
                    <converters:ComboBoxItemsConverter x:Key="ComboBoxItemsConverter" />
                    <dxmvvm:ObjectToObjectConverter x:Key="BoolConverter">
                        <dxmvvm:MapItem Source="0"
                                        Target="-" />
                        <dxmvvm:MapItem Source="1"
                                        Target="+" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:BooleanToObjectConverter x:Key="BoolAltConverter"
                                                     TrueValue="+"
                                                     FalseValue="-">
                    </dxmvvm:BooleanToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="DisplayCurrencyModeToImageSourceConverter"
                                                    DefaultTarget="{dx:DXImage Image=FormatNumberCurrency_32x32.png}">
                    </dxmvvm:ObjectToObjectConverter>
                    <Style x:Key="BasicGridColumnStyle"
                           TargetType="{x:Type dxg:GridColumn}">
                        <Setter Property="FixedWidth"
                                Value="True" />
                        <Setter Property="HorizontalHeaderContentAlignment"
                                Value="Center" />
                        <Setter Property="EditSettings">
                            <Setter.Value>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="PartialPayTextEditStyle"
                           TargetType="{x:Type dxe:TextEdit}">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Right" />
                        <Setter Property="AllowNullInput"
                                Value="True" />
                        <Setter Property="InvalidValueBehavior"
                                Value="AllowLeaveEditor" />
                        <Setter Property="ValidateOnTextInput"
                                Value="True" />
                        <Setter Property="MaskType"
                                Value="Numeric" />
                        <Setter Property="Mask"
                                Value="F0" />
                    </Style>
                    <Style x:Key="PriceGridColumnStyle"
                           TargetType="{x:Type dxg:GridColumn}">
                        <Setter Property="Width"
                                Value="{StaticResource PriceColumnWidth}" />
                        <Setter Property="MinWidth"
                                Value="{StaticResource MinPriceColumnWidth}" />
                        <Setter Property="FixedWidth"
                                Value="True" />
                        <Setter Property="HorizontalHeaderContentAlignment"
                                Value="Right" />
                        <Setter Property="EditSettings">
                            <Setter.Value>
                                <dxe:TextEditSettings HorizontalContentAlignment="Right" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ChargeGridColumnStyle"
                           TargetType="{x:Type dxg:GridColumn}"
                           BasedOn="{StaticResource BasicGridColumnStyle}">
                        <Setter Property="Header"
                                Value="%" />
                        <Setter Property="HeaderToolTip"
                                Value="Рентабельность" />
                        <Setter Property="Width"
                                Value="50" />
                        <Setter Property="CellTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <dxe:TextEdit x:Name="PART_Editor"
                                                  HorizontalContentAlignment="Center"
                                                  MaskType="Numeric"
                                                  Mask="P1"
                                                  MaskUseAsDisplayFormat="True">
                                        <dxe:TextEdit.Style>
                                            <Style TargetType="dxe:TextEdit">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=EditValue, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={viewModels:ExtraChargeConverter}}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </dxe:TextEdit.Style>
                                    </dxe:TextEdit>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="ColorItemTemplate">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                            <Ellipse Fill="{Binding Path=Hex, Mode=OneWay, Converter={converters:HexToSolidColorBrushConverter}}"
                                     Visibility="{Binding Path=Fill, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                     Stroke="Gray"
                                     StrokeThickness="0.5"
                                     Margin="3 0 0 0"
                                     Width="14"
                                     Height="14" />
                            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                                   VerticalAlignment="Top"
                                   Margin="5,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:OpenFileDialogService x:Name="ImportFromExcelFileDialogService"
                                      Title="Выберите Excel файл для импорта"
                                      AddExtension="True"
                                      RestorePreviouslySelectedDirectory="True"
                                      Filter="Excel Workbook|*.xlsx"
                                      CheckFileExists="True"
                                      CheckPathExists="True" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Orientation="Horizontal"
                        ItemSpace="4"
                        Padding="2"
                        IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=GridControl}">
        <dxlc:LayoutGroup Orientation="Vertical"
                          ItemSpace="0">
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl AllowQuickCustomization="False"
                                    AllowCustomizationMenu="False"
                                    IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarSubItem Content="Вид"
                                    LargeGlyph="../../../Images/Common/layout_32x32.png"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top"
                                    IsVisible="True">
                        <dxb:BarButtonItem Content="Загрузить"
                                           Glyph="{dx:DXImage Image=Open2_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Open2_32x32.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=ModuleLayoutService.LoadLayoutCommand, Mode=OneTime}"
                                           CommandParameter="{Binding ElementName=GridControl}"/>
                        <dxb:BarButtonItem Content="Сохранить"
                                           Glyph="{dx:DXImage Image=Save_16x16.png}"
                                           LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=ModuleLayoutService.SaveLayoutCommand, Mode=OneTime}"
                                           CommandParameter="{Binding ElementName=GridControl}"/>
                    </dxb:BarSubItem>
                    <dxb:BarSubItem  Content="Валюта"
                                     ToolTip="{Binding Path=DisplayCurrencyMode, Mode=OneWay, Converter={converters:EnumToDisplayTextConverter}}"
                                     BarItemDisplayMode="ContentAndGlyph"
                                     GlyphAlignment="Top"
                                     LargeGlyph="{Binding Path=DisplayCurrencyMode, Mode=OneWay, Converter={StaticResource DisplayCurrencyModeToImageSourceConverter}}">
                        <dxb:BarCheckItem Content="В валюте цены (F9)"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=DisplayCurrencyMode, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:DisplayCurrencyMode.Default}, Mode=OneWay}"
                                          Command="{Binding Path=SetDisplayCurrencyModeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:DisplayCurrencyMode.Default}" />
                        <dxb:BarCheckItem Content="В валюте товара (F10)"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=DisplayCurrencyMode, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:DisplayCurrencyMode.Product}, Mode=OneWay}"
                                          Command="{Binding Path=SetDisplayCurrencyModeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:DisplayCurrencyMode.Product}" />
                        <dxb:BarCheckItem Content="В гривне (F11)"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=DisplayCurrencyMode, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:DisplayCurrencyMode.Uah}, Mode=OneWay}"
                                          Command="{Binding Path=SetDisplayCurrencyModeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:DisplayCurrencyMode.Uah}" />
                        <dxb:BarCheckItem Content="В долларах (F12)"
                                          BarItemDisplayMode="Content"
                                          IsChecked="{Binding Path=DisplayCurrencyMode, Converter={converters:IsEqualConverter}, ConverterParameter={x:Static viewModels:DisplayCurrencyMode.Usd}, Mode=OneWay}"
                                          Command="{Binding Path=SetDisplayCurrencyModeCommand, Mode=OneWay}"
                                          CommandParameter="{x:Static viewModels:DisplayCurrencyMode.Usd}" />
                    </dxb:BarSubItem>
                    <dxb:BarButtonItem Content="Сохранить"
                                       ToolTip="Сохранить в БД (Ctrl+S)"
                                       LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                       Command="{Binding Path=SaveCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Робот"
                                       Glyph="../../../Images/Common/android_16x16.png"
                                       LargeGlyph="../../../Images/Common/android_32x32.png"
                                       Command="{Binding Path=RobotCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=SelectedCategory, Mode=OneWay}" />
                    <dxb:BarSubItem Content="Вычислить"
                                    LargeGlyph="../../../Images/Common/calculator_32x32.png"
                                    BarItemDisplayMode="ContentAndGlyph"
                                    GlyphAlignment="Top"
                                    IsVisible="True">
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Всю таблицу (Ctrl+F8)"
                                           Glyph="../../../Images/Common/page_white.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=CalcPricesCommand, Mode=OneWay}"
                                           CommandParameter="False"/>
                        <dxb:BarButtonItem Content="Текущую строку (F8)"
                                           Glyph="../../../Images/Common/page_green_16x16.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=CalcPricesCommand, Mode=OneWay}"
                                           CommandParameter="True"/>
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Робот (Old)"
                                       LargeGlyph="../../../Images/Common/android_32x32.png"
                                       Command="{Binding Path=ShowCalcPricesDialogCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Content="Вычислить (Old)"
                                       ToolTip="Вычислить"
                                       LargeGlyph="../../../Images/Common/calculator_32x32.png"
                                       Command="{Binding Path=OldCalcPricesCommand, Mode=OneWay}">
                    </dxb:BarButtonItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarSubItem  Content="Отчеты"
                                     ToolTip="Отчеты"
                                     BarItemDisplayMode="ContentAndGlyph"
                                     GlyphAlignment="Top"
                                     LargeGlyph="../../../Images/Common/report_32x32.png">
                        <dxb:BarButtonItem Content="Нарушители РРЦ"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../../Images/Common/price_watch_16x16.png"
                                           Command="{Binding Path=ShowRrpPriceViolatorsCommand, Mode=OneWay}" />
                    </dxb:BarSubItem>
                    <dxb:BarSubItem  Content="Excel"
                                     ToolTip="Excel"
                                     BarItemDisplayMode="ContentAndGlyph"
                                     GlyphAlignment="Top"
                                     LargeGlyph="../../../Images/Parser/excel_32_32.png">
                        <dxb:BarButtonItem Content="Экспорт"
                                           ToolTip="Экспортировать в Excel (Alt+E)"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../../Images/Common/arrow_up_16x16.png"
                                           Command="{Binding Path=ExportCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Mode=OneWay, ElementName=TableView}" />
                        <dxb:BarButtonItem Content="Импорт"
                                           ToolTip="Импортировать из Excel (спарсить)"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           Glyph="../../../Images/Common/xml_exports_16x16.png"
                                           Command="{Binding Path=ParseExcelPriceCommand, Mode=OneWay}"/>
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=Products, Mode=OneWay}"
                             CurrentItem="{Binding Path=CurrentProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CurrentColumn="{Binding Path=CurrentColumn, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                             SelectionMode="None"
                             ShowBorder="True"
                             DesignTimeUseDistinctSampleValues="True"
                             DesignTimeDataSourceRowCount="16"
                             CustomColumnSort="GridControlOnCustomColumnSort"
                             UseFieldNameForSerialization="True">
                <dxg:GridControl.ShowLoadingPanel>
                    <MultiBinding Mode="OneWay"
                                  Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="RefreshCommand.IsExecuting"
                                 Mode="OneWay" />
                        <Binding Path="SaveCommand.IsExecuting"
                                 Mode="OneWay" />
                    </MultiBinding>
                </dxg:GridControl.ShowLoadingPanel>
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:LayoutSerializationBehavior FileName="products_prices_12.xml" />
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                    <behaviors:GridLayoutBehavior Layout="{Binding Path=ModuleLayoutService.Layout, Mode=OneWay}" />
                    <dxmvvm:EventToCommand EventName="CustomColumnSort"
                                           Command="{Binding Path=HandleCustomColumnSortCommand, Mode=OneWay}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Bands>
                    <dxg:GridControlBand x:Name="ProductBand"
                                         Header="Товар"
                                         Fixed="Left"
                                         AllowResizing="True" >
                        <dxg:GridColumn FieldName="DisplayName"
                                        Header="Название"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FixedWidth="False"
                                        Width="500">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="IsChanged"
                                        Header="И"
                                        HeaderToolTip="Изменена"
                                        HorizontalHeaderContentAlignment="Center"
                                        AllowResizing="False"
                                        FixedWidth="True"
                                        Width="26">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dx:DXImage Source="/Images/Order/Actions/pencil.png"
                                                Height="16"
                                                Width="16"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="5,0,0,0">
                                        <dx:DXImage.Visibility>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                                                <Binding Path="RowData.Row.IsChanged"
                                                         Mode="OneWay" />
                                                <Binding Path="RowData.Row.Telemart1PriceData.IsChanged"
                                                         Mode="OneWay" />
                                                <Binding Path="RowData.Row.Telemart3PriceData.IsChanged"
                                                         Mode="OneWay" />
                                                <Binding Path="RowData.Row.Telemart2PriceData.IsChanged"
                                                         Mode="OneWay" />
                                                <Binding Path="RowData.Row.Telemart4PriceData.IsChanged"
                                                         Mode="OneWay" />
                                                <Binding Path="RowData.Row.Telemart5PriceData.IsChanged"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </dx:DXImage.Visibility>
                                    </dx:DXImage>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand x:Name="InfoBand"
                                         Header="Инфо">
                        <dxg:GridColumn x:Name="Id"
                                        FieldName="Id"
                                        Header="Код"
                                        HeaderToolTip="Код товара"
                                        Width="65"
                                        Style="{StaticResource BasicGridColumnStyle}">
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="Pn"
                                        FieldName="Pn"
                                        Header="Артикул"
                                        HeaderToolTip="Артикул товара"
                                        HorizontalHeaderContentAlignment="Left"
                                        FixedWidth="True"
                                        Width="80">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="ProductType"
                                        FieldName="ProductTypeId"
                                        Header="Тип товара"
                                        HeaderToolTip="Тип товара"
                                        HorizontalHeaderContentAlignment="Center"
                                        FixedWidth="True"
                                        MinWidth="40"
                                        Width="100"
                                        AllowEditing="False"
                                        AllowColumnFiltering="True"
                                        FilterPopupMode="CheckedList">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path= DataContext.ProductTypes, Mode=OneWay, ElementName=GridControl}"
                                                          ValueMember="Id"
                                                          DisplayMember="DisplayValue"
                                                          HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="CreatedOn"
                                        FieldName="CreatedOn"
                                        Header="Создан"
                                        HeaderToolTip="Дата создания товара"
                                        Width="85"
                                        Visible="False"
                                        Style="{StaticResource BasicGridColumnStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                      MaskType="DateTime">
                                </dxe:DateEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="Position"
                                        FieldName="Position"
                                        Header="Позиция"
                                        HeaderToolTip="Позиция в каталоге"
                                        Width="65"
                                        Style="{StaticResource BasicGridColumnStyle}">
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="Ratio"
                                        FieldName="Ratio"
                                        Header="Р"
                                        HeaderToolTip="Рейтинг"
                                        Width="30"
                                        AllowEditing="True"
                                        Style="{StaticResource BasicGridColumnStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings MinValue="0"
                                                      MaxValue="99"
                                                      IsFloatValue="False"
                                                      AllowDefaultButton="False"
                                                      NullValue="{StaticResource Int32Zero}"
                                                      NullText=""
                                                      HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="HotlinePosition"
                                        FieldName="HotlinePosition"
                                        HeaderToolTip="Рейтинг Hotline"
                                        Width="30"
                                        Style="{StaticResource BasicGridColumnStyle}"
                                        SortMode="Custom">
                            <dxg:GridColumn.HeaderTemplate>
                                <DataTemplate>
                                    <dx:DXImage Source="../../../Images/Common/hotline_favicon_16x16.png"
                                                Width="16"
                                                Height="16" />
                                </DataTemplate>
                            </dxg:GridColumn.HeaderTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="PriceInPriceData_DisplayPriceOld"
                                        FieldName="PriceInPriceData.DisplayPriceOld"
                                        Header="Вход"
                                        HeaderToolTip="Вход"
                                        Width="68"
                                        AllowColumnFiltering="True"
                                        Style="{StaticResource PriceGridColumnStyle}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:SpinEdit x:Name="PART_Editor"
                                                  MaskType="Numeric"
                                                  MaskUseAsDisplayFormat="True"
                                                  Mask="{Binding Path=RowData.Row.PriceInPriceData.DisplayCurrencyId, Mode=OneWay, Converter={StaticResource CurrencyIdToMaskConverter}}"
                                                  MaskCulture="{Binding Path=RowData.Row.PriceInPriceData.DisplayCurrencyId, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                                  MaskSaveLiteral="False"
                                                  IsFloatValue="True"
                                                  AllowDefaultButton="False"
                                                  HorizontalContentAlignment="Right"
                                                  NullValue="{StaticResource DecimalZero}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="PriceComment"
                                        FieldName="PriceComment"
                                        Header="Комментарий"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        HorizontalHeaderContentAlignment="Left"
                                        FixedWidth="False"
                                        AllowEditing="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                                      TextTrimming="CharacterEllipsis"
                                                      AcceptsReturn="False"
                                                      ShowTooltipForTrimmedText="True"
                                                      DisplayTextConverter="{converters:MultiLineToSingleLineTextConverter}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand x:Name="StatisticsBand"
                                         Header="Статистика">
                        <dxg:GridColumn x:Name="Visits"
                                        FieldName="Visits"
                                        Header="Пос."
                                        HeaderToolTip="Кол-во посещений за 14 дней"
                                        Width="48"
                                        Style="{StaticResource BasicGridColumnStyle}">
                        </dxg:GridColumn>

                        <dxg:GridColumn x:Name="SalesBeforeLastMonth"
                                        FieldName="SalesBeforeLastMonth"
                                        Header="{Binding Path=SalesBeforeLastMonthHeader, Mode=OneWay, Converter={converters:StringFormatConverter}, ConverterParameter={}{0}(Т)}"
                                        HeaderToolTip="{Binding Path=SalesBeforeLastMonthHeaderToolTip, Mode=OneWay}"
                                        Width="40"
                                        Style="{StaticResource BasicGridColumnStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                      NullValue="{StaticResource Int32Zero}"
                                                      NullText="" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn x:Name="OrdersBeforeLastMonth"
                                        FieldName="OrdersBeforeLastMonth"
                                        Header="{Binding Path=SalesBeforeLastMonthHeader, Mode=OneWay, Converter={converters:StringFormatConverter}, ConverterParameter={}{0}(З)}"
                                        HeaderToolTip="{Binding Path=SalesBeforeLastMonthHeaderToolTip, Mode=OneWay}"
                                        Width="40"
