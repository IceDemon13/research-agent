<UserControl x:Class="Telemart.Client.Views.Novaposhta.CreateNovaposhtaTtnView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Novaposhta"
             DataContext="{client:Container Type=viewModels:CreateNovaposhtaTtnViewModel}"
             Loaded="OnLoaded"
             Width="925"
             Height="570"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:CreateNovaposhtaTtnViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="GroupBoxStyle"
                           BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}"
                           TargetType="dxlc:GroupBox">
                        <Setter Property="Padding"
                                Value="8" />
                        <Setter Property="BorderThickness"
                                Value="1" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            StretchContentVertically="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Horizontal">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutGroup Header="Отправитель"
                                      View="GroupBox"
                                      Orientation="Vertical"
                                      GroupBoxStyle="{StaticResource GroupBoxStyle}">
                        <dxlc:LayoutItem Label="Контрагент">
                            <dxe:ComboBoxEdit x:Name="NpContractorComboBoxEdit"
                                              ItemsSource="{Binding Path=NpContractors, Mode=OneWay}"
                                              EditValue="{Binding Path=NpContractorRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              ValueMember="Id"
                                              DisplayMember="Name"
                                              Style="{StaticResource SearchableComboBoxStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Склад">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                              EditValue="{Binding Path=WarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              ValueMember="Id"
                                              DisplayMember="DisplayValue"
                                              Style="{StaticResource SearchableComboBoxStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Отправитель">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                              EditValue="{Binding Path=Sender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              Style="{StaticResource SearchableComboBoxStyle}">
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Телефон">
                            <dxe:TextEdit EditValue="{Binding Path=SenderPhone, Mode=OneWay, ValidatesOnDataErrors=True}"
                                          IsReadOnly="True"
                                          Opacity="{StaticResource DisabledElementOpacity}"
                                          Style="{StaticResource PhoneTextEdit}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Получатель"
                                      View="GroupBox"
                                      Orientation="Vertical"
                                      VerticalAlignment="Stretch"
                                      GroupBoxStyle="{StaticResource GroupBoxStyle}">
                        <dxlc:LayoutItem Label="Контрагент">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                              EditValue="{Binding Path=SelectedContractor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="Name"
                                              Style="{StaticResource SearchableComboBoxStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="ЄДРПОУ"
                                         Visibility="{Binding VisibilityEdrpou, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                            <dxe:TextEdit EditValue="{Binding Path=Edrpou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=RecipientReadOnly}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>

                        <dxlc:LayoutItem Label="Получатель">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=ContractorContacts, Mode=OneWay}"
                                              EditValue="{Binding Path=SelectedContractorContact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="FullName"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Фамилия">
                            <dxe:TextEdit EditValue="{Binding Path=RecipientLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=RecipientReadOnly}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Имя">
                            <dxe:TextEdit EditValue="{Binding Path=RecipientFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=RecipientReadOnly}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Отчество">
                            <dxe:TextEdit EditValue="{Binding Path=RecipientMiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=RecipientReadOnly}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Телефон">
                            <dxe:TextEdit EditValue="{Binding Path=RecipientPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          IsReadOnly="{Binding Path=RecipientReadOnly}"
                                          Style="{StaticResource PhoneTextEditReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Город">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                              EditValue="{Binding Path=CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              IsReadOnly="{Binding Path=RecipientReadOnly}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Тип доставки">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=ServiceTypes, Mode=OneWay}"
                                          EditValue="{Binding Path=ServiceTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          ValueMember="Id" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Отделение">
                            <dxe:ButtonEdit EditValue="{Binding Path=RecipientAddress, Mode=OneWay, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            IsReadOnly="True">
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                ToolTipService.ToolTip="Выбрать адрес"
                                                Command="{Binding Path=SelectNpWarehouseCommand, Mode=OneWay}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <TextBlock Text="ТТН будет создана на юр. лицо"
                                       Foreground="Green">
                                <TextBlock.Visibility>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True, HiddenInsteadOfCollapsed=True}">
                                        <Binding Path="VisibilityEdrpou"
                                                 Mode="OneWay"/>
                                        <Binding Path="OkCommand.IsExecuting"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Header="Посылка"
                                  View="GroupBox"
                                  Orientation="Vertical"
                                  VerticalAlignment="Stretch"
                                  GroupBoxStyle="{StaticResource GroupBoxStyle}">
                    <dxlc:LayoutItem Label="Тип">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=TtnSources, Mode=OneWay}"
                                          EditValue="{Binding Path=TtnSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name"
                                          ValueMember="Id" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Описание">
                        <dxe:TextEdit EditValue="{Binding Path=Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      NullText="Описание груза"
                                      MaxLength="20" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Плательщик">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=PayerTypes, Mode=OneWay}"
                                          EditValue="{Binding Path=PayerTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="DisplayValue"
                                          ValueMember="Id" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Страховка">
                        <dxe:SpinEdit EditValue="{Binding Path=PackageInsurance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Increment="100"
                                      IsFloatValue="False"
                                      ValidateOnTextInput="True"
                                      ValidateOnEnterKeyPressed="True"
                                      InvalidValueBehavior="AllowLeaveEditor">
                        </dxe:SpinEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Мест">
                        <dxe:SpinEdit EditValue="{Binding Path=PackagePlaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Increment="1"
                                      IsFloatValue="False"
                                      ValidateOnTextInput="True"
                                      ValidateOnEnterKeyPressed="True"
                                      InvalidValueBehavior="AllowLeaveEditor">
                        </dxe:SpinEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Вес">
                        <dxe:SpinEdit EditValue="{Binding Path=PackageWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      EditValueType="{x:Type system:Decimal}"
                                      MaskUseAsDisplayFormat="True"
                                      MaskCulture="en-US"
                                      Mask="F1"
                                      MaskSaveLiteral="False"
                                      IsFloatValue="True"
                                      ValidateOnTextInput="True"
                                      ValidateOnEnterKeyPressed="True"
                                      InvalidValueBehavior="AllowLeaveEditor">
                        </dxe:SpinEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Обоснование"
                                     LabelVerticalAlignment="Top"
                                     VerticalAlignment="Stretch">
                        <dxe:TextEdit EditValue="{Binding Path=Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      NullText="Задача в битрикс, номер заказа и т.д."
                                      MaxLength="100"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Top" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Создаем ТТН"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                    <CheckBox Content="Не добавлять в заявку"
                              IsChecked="{Binding Path=NotAddToApplication, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Left"/>
                    <dx:SimpleButton Content="OK"
                                     HorizontalAlignment="Right"
                                     Command="{Binding Path=OkCommand, Mode=OneWay}"
                                     IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <dx:SimpleButton Content="Отмена"
                                     HorizontalAlignment="Right"
                                     Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>