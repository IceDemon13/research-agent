<controls:TelemartUserControl x:Class="Telemart.Client.Views.Dialogs.GetTextFromUserView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:dialogs="clr-namespace:Telemart.Client.ViewModels.Dialogs"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              DataContext="{client:Container Type=dialogs:GetTextFromUserViewModel}"
                              Width="400"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type dialogs:GetTextFromUserViewModel}}">
    <controls:TelemartUserControl.Style>
        <Style TargetType="controls:TelemartUserControl">
            <Setter Property="Height">
                <Setter.Value>
                    <system:Double>76</system:Double>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsMultiline}"
                             Value="True">
                    <Setter Property="Height">
                        <Setter.Value>
                            <system:Double>150</system:Double>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </controls:TelemartUserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ContentTextEditStyle"
                   TargetType="dxe:TextEdit">
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="AcceptsReturn"
                        Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsMultiline}"
                                 Value="True">
                        <Setter Property="VerticalContentAlignment"
                                Value="Top" />
                        <Setter Property="TextWrapping"
                                Value="Wrap" />
                        <Setter Property="AcceptsReturn"
                                Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="{Binding Path=SelectKey, Mode=OneWay}"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="ValidationContainer"
                        Orientation="Vertical"
                        dxe:ValidationService.IsValidationContainer="True"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxlc:LayoutGroup Orientation="Vertical">
            <dxlc:LayoutItem Label="{Binding Path=ContentCaption, Mode=OneWay}"
                             VerticalAlignment="Stretch">
                <dxe:TextEdit EditValue="{Binding Path=Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Mask="{Binding Path=ContentMask, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                              MaskSaveLiteral="False"
                              MaskUseAsDisplayFormat="{Binding Path=UseMask, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                              MaskType="{Binding Path=MaskType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ContentTextEditStyle}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:TextEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right">
            <Button Content="OK"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    IsTabStop="True"
                    IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=ValidationContainer, Converter={dxmvvm:BooleanNegationConverter}}" />
            <Button Content="Отмена"
                    IsTabStop="True"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</controls:TelemartUserControl>