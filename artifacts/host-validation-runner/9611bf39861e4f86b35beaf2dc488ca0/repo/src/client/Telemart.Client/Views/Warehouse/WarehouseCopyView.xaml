<UserControl x:Class="Telemart.Client.Views.Warehouse.WarehouseCopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse"
             mc:Ignorable="d"
             DataContext="{client:Container Type=viewModels:WarehouseCopyViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:WarehouseCopyViewModel}, IsDesignTimeCreatable=True}"
             Width="350"
             Height="200"
             d:DesignHeight="200" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="EmployeeCopyLayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Склад">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=SelectedWarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=Warehouses}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxe:CheckEdit Content="Перемещения"
                                       EditValue="{Binding Path=IsCopyMovements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Доставки"
                                       EditValue="{Binding Path=IsCopyDeliveries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="Visible" />
                        <dxe:CheckEdit Content="Производительность"
                                       EditValue="{Binding Path=IsCopyPerfomances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsReadOnly="{Binding CanCopyPerfomance, Converter={dxmvvm:BooleanNegationConverter}}"
                                       Visibility="Visible"
                                       Style="{StaticResource ReadOnlyConditionsStyle}"/>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}"
                                              EditValue="{Binding SelectedMovementsCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              IsReadOnly="{Binding IsCopyMovements, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}"
                                              EditValue="{Binding SelectedDeliveriesCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              IsReadOnly="{Binding IsCopyDeliveries, Converter={dxmvvm:BooleanNegationConverter}}"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dxe:ComboBoxEdit ItemsSource="{Binding CopyChoices, Mode=OneWay}"
                                              EditValue="{Binding SelectedPerfomancesCopyChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              AllowNullInput="False"
                                              NullValueButtonPlacement="None"
                                              Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}">
                                <dxe:ComboBoxEdit.IsReadOnly>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                        <Binding Path="CanCopyPerfomance"/>
                                        <Binding Path="IsCopyPerfomances"/>
                                    </MultiBinding>
                                </dxe:ComboBoxEdit.IsReadOnly>
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup VerticalAlignment="Bottom">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"/>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>