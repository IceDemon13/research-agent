<UserControl x:Class="Telemart.Client.Views.Store.Order.CreateContractorTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             DataContext="{client:Container Type=viewModels:CreateContractorTemplateViewModel}"
             Width="600"
             Height="362"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CreateContractorTemplateViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            dxe:ValidationService.IsValidationContainer="True"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
            <dxlc:LayoutItem Label="Номер заказа">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxe:ButtonEdit EditValue="{Binding Path=OrderId, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                    MaskType="Numeric"
                                    Mask="d"
                                    AllowDefaultButton="False"
                                    AllowNullInput="True"
                                    NullValue="{x:Null}"
                                    InvalidValueBehavior="AllowLeaveEditor">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:FocusBehavior />
                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                 Command="{Binding Path=FillFromOrderCommand, Mode=OneWay}"
                                                 CommandParameter="{Binding Path=OrderId, Mode=OneWay}" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ButtonEdit>
                    <Button Content="Заполнить"
                            Width="84"
                            Command="{Binding Path=FillFromOrderCommand, Mode=OneWay}"
                            CommandParameter="{Binding Path=OrderId, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Примечание">
                <dxe:TextEdit EditValue="{Binding Path=Notation, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              MaxLength="10" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название">
                <dxe:TextEdit EditValue="{Binding Path=Name, Mode=OneWay, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyEditorStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup x:Name="TemplateProperties"
                              Orientation="Horizontal"
                              Header="Данные из заказа"
                              View="GroupBox">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutItem Label="Фамилия">
                        <dxe:TextEdit Text="{Binding Path=LastName, Mode=OneWay}"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Имя">
                        <dxe:TextEdit Text="{Binding Path=FirstName, Mode=OneWay}"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Отчество">
                        <dxe:TextEdit Text="{Binding Path=MiddleName, Mode=OneWay}"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Телефон">
                        <dxe:TextEdit EditValue="{Binding Path=Phone, Mode=OneWay}"
                                      MaskType="Simple"
                                      Mask="(000) 000-00-00"
                                      MaskUseAsDisplayFormat="True"
                                      Style="{StaticResource ReadOnlyEditorStyle}">
                        </dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label=" "
                                     AddColonToLabel="False">
                        <dxe:TextEdit EditValue="{Binding Path=Phone2, Mode=OneWay}"
                                      MaskType="Simple"
                                      Mask="(000) 000-00-00"
                                      MaskUseAsDisplayFormat="True"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="E-mail">
                        <dxe:TextEdit EditValue="{Binding Path=Email, Mode=OneWay}"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutItem Label="Город">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                          EditValue="{Binding Path=City, Mode=OneWay}"
                                          DisplayMember="Name"
                                          ShowEditorButtons="False"
                                          Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Доставка">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                          EditValue="{Binding Path=CarryId, Mode=OneWay}"
                                          DisplayMember="Name"
                                          ValueMember="Id"
                                          ShowEditorButtons="False"
                                          Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Адрес">
                        <dxe:TextEdit EditValue="{Binding Path=Address, Mode=OneWay}"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Склад">
                        <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                          EditValue="{Binding Path=WarehouseId, Mode=OneWay}"
                                          DisplayMember="Name"
                                          ValueMember="Id"
                                          ShowEditorButtons="False"
                                          Style="{StaticResource ReadOnlyEditorStyle}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="FillFromOrderCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <Button Content="ОК"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        HorizontalAlignment="Right"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>
