<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.FiscalRegistrar.StoreFiscalRegistrarView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.FiscalRegistrar"
                              xmlns:controlWiki="clr-namespace:Telemart.Client.Controls"
                              xmlns:entities="clr-namespace:Telemart.Client.FiscalRegistrar.Entities;assembly=Telemart.Client.FiscalRegistrar"
                              DataContext="{client:Container Type=viewModels:StoreFiscalRegistrarViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:StoreFiscalRegistrarViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="600"
                              d:DesignHeight="338">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            StretchContentVertically="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Header="Товары"
                              Orientation="Vertical"
                              ItemSpace="0"
                              View="GroupBox"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                <dxb:ToolBarControl GlyphSize="Small"
                                    BarItemDisplayMode="Default"
                                    AllowCustomizationMenu="False"
                                    AllowQuickCustomization="False">
                    <dxb:BarButtonItem Content="Добавить"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=AddCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Добавить все товары из заказа"
                                       Glyph="{dx:DXImage 'Images/XAF/ModelEditor_Categorized.png'}"
                                       Command="{Binding Path=AddAllFromOrderCommand, Mode=OneWay}" />
                    <dxb:BarButtonItem Content="Удалить"
                                       Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                       Command="{Binding Path=RemoveCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Path=CurrentItem, ElementName=GridControl}" />
                    <dxb:BarItemSeparator />
                    <controlWiki:WikiBarButtonItem />
                </dxb:ToolBarControl>
                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=NomenclatureItems, Mode=OneWay}"
                                 SelectionMode="None"
                                 ShowBorder="False"
                                 DesignTimeDataObjectType="{x:Type viewModels:StoreFiscalRegistrarViewItem}"
                                 dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="NameFullUa"
                                        Header="Товар"
                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                        FixedWidth="False"
                                        MinWidth="80">
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Quantity"
                                        Header="Кол-во"
                                        HeaderToolTip="Количество"
                                        HorizontalHeaderContentAlignment="Center"
                                        AllowEditing="True"
                                        FixedWidth="True"
                                        MinWidth="24"
                                        Width="70">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings HorizontalContentAlignment="Center"
                                                      MaskUseAsDisplayFormat="True"
                                                      IsFloatValue="False"
                                                      MinValue="1"
                                                      MaxValue="99" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Price"
                                        Header="Цена"
                                        HorizontalHeaderContentAlignment="Right"
                                        AllowEditing="True"
                                        FixedWidth="True"
                                        MinWidth="24"
                                        Width="70">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings HorizontalContentAlignment="Right"
                                                      MaskType="Numeric"
                                                      Mask="{x:Static business:CurrencyFormatingRules.UahFormat}"
                                                      MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                                      MaskUseAsDisplayFormat="True"
                                                      IsFloatValue="False"
                                                      MinValue="1"
                                                      MaxValue="999999" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       EditorShowMode="MouseDownFocused"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                       Command="{Binding Path=DataContext.HandleProductPropertyChangedCommand, Mode=OneWay, ElementName=LayoutControl}" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="Инфо"
                              Orientation="Vertical"
                              View="GroupBox"
                              VerticalAlignment="Bottom"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                <dxlc:LayoutItem Label="Заказ">
                    <dxe:TextEdit EditValue="{Binding Path=OrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  HorizontalContentAlignment="Right"
                                  MaskType="Numeric"
                                  Mask="F0"
                                  MaxLength="9">
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Способ оплаты">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=PaymentTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=PaymentTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="К оплате">
                    <dxe:SpinEdit EditValue="{Binding Path=ToPayAmount, Mode=OneWay, ValidatesOnDataErrors=True}"
                                  EditValueType="{x:Type system:Decimal}"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="C0"
                                  MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="False"
                                  Style="{StaticResource ReadOnlyEditorStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Сумма">
                    <dxe:SpinEdit EditValue="{Binding Path=Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  EditValueType="{x:Type system:Decimal}"
                                  MinValue="0"
                                  MaxValue="1000000"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="C0"
                                  MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Сдача">
                    <dxe:SpinEdit EditValue="{Binding Path=ShortChange, Mode=OneWay}"
                                  EditValueType="{x:Type system:Decimal}"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="C0"
                                  MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="False"
                                  Style="{StaticResource ReadOnlyEditorStyle}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Подключаемся к РРО"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <dx:SimpleButton Content="Касса"
                                     Glyph="../../../Images/Common/money_bag_16x16.png"
                                     Command="{Binding Path=CashboxOperationsCommand, Mode=OneWay}" />
                    <dx:SimpleButton Content="Возврат"
                                     IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                     Command="{Binding Path=PrintChequeCommand, Mode=OneWay}"
                                     CommandParameter="{x:Static entities:ChequeType.Refund}"/>
                    <dx:SimpleButton Content="Продажа"
                                     IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                     Command="{Binding Path=PrintChequeCommand, Mode=OneWay}"
                                     CommandParameter="{x:Static entities:ChequeType.Receive}"/>
                    <dx:SimpleButton Content="Отмена"
                                     Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>