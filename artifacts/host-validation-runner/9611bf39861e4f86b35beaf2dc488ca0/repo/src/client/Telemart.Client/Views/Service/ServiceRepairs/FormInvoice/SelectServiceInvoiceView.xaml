<UserControl x:Class="Telemart.Client.Views.Service.ServiceRepairs.FormInvoice.SelectServiceInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:formInvoice="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs.FormInvoice"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:store="clr-namespace:Telemart.Client.ViewModels.Service.ServiceInvoices"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             mc:Ignorable="d"
             DataContext="{client:Container Type=formInvoice:SelectServiceInvoiceViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type formInvoice:SelectRequestsViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ServiceInvoiceState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary>
                    <dxmvvm:ObjectToObjectConverter x:Key="CreateInvoiceVisibilityConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="0"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="InvoiceVisibilityConverter"
                                                    DefaultTarget="Visible">
                        <dxmvvm:MapItem Source="0"
                                        Target="Collapsed" />
                    </dxmvvm:ObjectToObjectConverter>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Назад"
                                   dxco:Wizard.IsButtonBack="True" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True" />
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxg:GridControl x:Name="GridControl"
                             ItemsSource="{Binding Path=Model.ServiceInvoices, Mode=OneWay}"
                             CurrentItem="{Binding Path=Model.SelectedServiceInvoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ShowBorder="True"
                             SelectionMode="None"
                             DesignTimeDataObjectType="{x:Type store:ServiceInvoiceViewItem}">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Id"
                                    Header="Номер"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FixedWidth="True"
                                    MinWidth="72"
                                    Width="72">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <dxe:TextEdit x:Name="PART_Editor"
                                                  HorizontalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  Visibility="{Binding Path=RowData.Row.Id, Mode=OneWay, Converter={StaticResource InvoiceVisibilityConverter}}" />
                                    <Button Visibility="{Binding Path=RowData.Row.Id, Mode=OneWay, Converter={StaticResource CreateInvoiceVisibilityConverter}}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource NoBordersButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="{dx:DXImage Image=Add_16x16.png}" />
                                            <TextBlock Text="Создать"
                                                       Margin="4,0,0,0" />
                                        </StackPanel>
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:ConfirmationBehavior Command="{Binding Path=DataContext.CreateServiceInvoiceCommand, Mode=OneWay, ElementName=GridControl}"
                                                                         MessageText="Вы уверены?"
                                                                         MessageButton="YesNo"
                                                                         MessageIcon="Question"
                                                                         MessageTitle="Подтверждение"/>
                                        </dxmvvm:Interaction.Behaviors>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="SendDate"
                                    Header="Отправка"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Center"
                                    FixedWidth="True"
                                    MinWidth="70"
                                    Width="70">
                        <dxg:GridColumn.EditSettings>
                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                  MaskUseAsDisplayFormat="True"
                                                  Mask="{x:Static business:DateFormattingRules.DateFormat}"
                                                  MaskType="DateTime">
                            </dxe:DateEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="CarryType"
                                    Header="Доставка"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    AllowBestFit="True"
                                    FixedWidth="False"
                                    DisplayTemplate="{StaticResource CarryTypeColumnDisplayTemplate}">
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="State"
                                    Header="Статус"
                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                    HorizontalHeaderContentAlignment="Left"
                                    AllowBestFit="True"
                                    FixedWidth="False"
                                    MinWidth="26"
                                    DisplayTemplate="{StaticResource ServiceInvoiceStateColumnDisplayTemplate}">
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowGrouping="False"
                                   AllowFilterEditor="False"
                                   AllowSorting="False"
                                   AllowBestFit="True"
                                   IsTotalSummaryMenuEnabled="False"
                                   IsColumnChooserVisible="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutControl>
    </DockPanel>

</UserControl>
