<UserControl x:Class="Telemart.Client.Views.Store.ReturnInvoice.ChangeAddressReturnInvoiceView"
             x:Name="CurrentUserControl"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:local="clr-namespace:Telemart.Client.Views.Store.ReturnInvoice"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.ReturnInvoice"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             DataContext="{client:Container Type=viewModels:ChangeAddressReturnInvoiceViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type TypeName= viewModels:ChangeAddressReturnInvoiceViewModel},IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Width="460"
             Height="240"
             d:DesignHeight="240" 
             d:DesignWidth="460">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="AddressControl"
                            Orientation="Vertical"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay,Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">
            <dxlc:LayoutGroup Name="FieldsAddress"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Дата возврата">
                    <dxe:DateEdit EditValue="{Binding Path=ReturnDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaskType="DateTime"
                                  Mask="dd.MM.yyyy"
                                  MaskUseAsDisplayFormat="True"
                                  IsTextEditable="True"
                                  AllowRoundOutOfRangeValue="True"
                                  ValidateOnTextInput="False">
                    </dxe:DateEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Склад">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Path=Warehouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Доставка">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                              DisplayMember="Name"
                                              EditValue="{Binding Path=CarryType, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              ItemTemplate="{StaticResource ValidatableComboBoxItemTemplate}"
                                              AllowNullInput="True" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Плательщик услуг доставки">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=TtnPayers, Mode=OneWay}"
                                          EditValue="{Binding Path=PayerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          DisplayMember="Name" 
                                          AllowNullInput="True"
                                          ShowEditorButtons="True"
                                          NullValueButtonPlacement="EditBox"
                                          IsEnabled="{Binding IsEnableDeliveryInfo, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Город">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                              EditValue="{Binding Path=ReceiverCityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              DisplayMember="DisplayValue"
                                              ValueMember="Id"
                                              ShowEditorButtons="True"
                                              NullValueButtonPlacement="EditBox"
                                              Style="{StaticResource SearchableComboBoxStyle}"
                                              IsEnabled="{Binding IsEnableDeliveryInfo, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Отделение">
                            <dxe:ButtonEdit EditValue="{Binding Path=RecipientAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            AllowDefaultButton="False"
                                            IsReadOnly="True">
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                ToolTipService.ToolTip="Выбрать адрес"
                                                Command="{Binding Path=SelectNpWarehouseCommand, Mode=OneWay}" />
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Создание..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=AddressControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>
