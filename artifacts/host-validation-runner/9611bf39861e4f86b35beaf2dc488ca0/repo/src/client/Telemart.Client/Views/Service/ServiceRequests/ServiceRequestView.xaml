                                <commonViews:CrmInfoView x:Name="CrmInfoView"
                                                         ClientContacts="{Binding Path=ClientContactsHistoryItems, Mode=OneWay}"
                                                         ShowLoadingPanel="{Binding Path=RefreshCrmCommand.IsExecuting, Mode=OneWay}" />
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup x:Name="DiscussionsLayoutGroup"
                                              Header="{Binding Path=Model.DiscussionsCount, Mode=OneWay, FallbackValue=?}"
                                              Orientation="Vertical"
                                              ItemSpace="0">
                                <dxlc:LayoutGroup.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="{StaticResource Comments16}" />
                                            <TextBlock Text="{Binding StringFormat=Обсуждения ({0})}"
                                                       Margin="5,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutGroup.HeaderTemplate>
                                <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                                    <dxb:BarButtonItem Content="Обновить"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                                       Command="{Binding Path=RefreshDiscussionsCommand, Mode=OneWay}" />
                                    <dxb:BarButtonItem Content="Изменить"
                                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                                       LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                                       Command="{Binding Path=EditDiscussionCommand, Mode=OneWay}"
                                                       CommandParameter="{Binding Path=CurrentItem, ElementName=DiscussionsGridControl}" />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarButtonItem Content="Закрыть"
                                                       Glyph="../../../Images/Invoice/lockResource.png"
                                                       IsVisible="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                       Command="{Binding Path=CloseDiscussionCommand, Mode=OneWay}"></dxb:BarButtonItem>
                                </dxb:ToolBarControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxg:GridControl x:Name="DiscussionsGridControl"
                                                 ItemsSource="{Binding Path=Discussions, Mode=OneWay}"
                                                 SelectionMode="None"
                                                 ShowBorder="False"
                                                 dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                                                 DesignTimeDataObjectType="{x:Type viewModels:ServiceRequestDiscussionViewItem}"
                                                 DesignTimeDataSourceRowCount="6">
                                    <dxg:GridControl.ShowLoadingPanel>
                                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                            <Binding Path="RefreshDiscussionsCommand.IsExecuting" />
                                            <Binding Path="AddDiscussionCommand.IsExecuting" />
                                            <Binding Path="EditDiscussionCommand.IsExecuting" />
                                            <Binding Path="CloseDiscussionCommand.IsExecuting" />
                                        </MultiBinding>
                                    </dxg:GridControl.ShowLoadingPanel>
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="CreatedOn"
                                                        Header="Дата"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        AllowBestFit="True"
                                                        AllowColumnFiltering="False"
                                                        MinWidth="90"
                                                        Width="90"
                                                        FixedWidth="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                      VerticalContentAlignment="Top"
                                                                      NullText=""
                                                                      MaskUseAsDisplayFormat="True"
                                                                      Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                      MaskType="DateTime"></dxe:DateEditSettings>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Author"
                                                        Header="Автор"
                                                        AllowBestFit="True"
                                                        FixedWidth="True"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        Width="120"
                                                        MinWidth="80"
                                                        HorizontalHeaderContentAlignment="Left">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Left"
                                                                      VerticalContentAlignment="Top" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Message"
                                                        Header="Сообщение"
                                                        HorizontalHeaderContentAlignment="Left"
                                                        AllowBestFit="True"
                                                        AllowColumnFiltering="False"
                                                        MinWidth="150"
                                                        FixedWidth="False">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,0,4,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    Visibility="{Binding Path=RowData.Row.ByServiceManager, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                                    Width="28"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Path=RowData.Row.Message, Mode=OneWay}"
                                                                   Grid.Column="1"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="None" />
                                                    </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView UseEvenRowBackground="False"
                                                       AllowSorting="False"
                                                       AllowGrouping="False"
                                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                                            <dxg:TableView.FormatConditions>
                                                <dxg:FormatCondition Expression="[ByServiceManager] = TRUE">
                                                    <dx:Format Background="{StaticResource AlternateRowBackgroundBrush}"
                                                               Foreground="Black"/>
                                                </dxg:FormatCondition>
                                                <dxg:FormatCondition Expression="[ByServiceManager] = FALSE"
                                                                     FieldName="Message">
                                                    <dx:Format FontWeight="SemiBold" />
                                                </dxg:FormatCondition>
                                            </dxg:TableView.FormatConditions>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxlc:LayoutGroup Orientation="Vertical"
                                                  VerticalAlignment="Bottom">
                                    <dxe:ButtonEdit EditValue="{Binding Path=DiscussionMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AllowDefaultButton="False"
                                                    NullValue="{x:Null}"
                                                    ShowNullText="True"
                                                    NullText="Введите текст сообщения"
                                                    ShowBorder="False"
                                                    Height="22">
                                        <dxe:ButtonInfo GlyphKind="Custom"
                                                        ToolTipService.ToolTip="Написать"
                                                        Command="{Binding Path=AddDiscussionCommand, Mode=OneWay}"
                                                        CommandParameter="{Binding Path=DiscussionMessage, Mode=OneWay}"
                                                        Margin="1,1,0,1">
                                            <dxe:ButtonInfo.Content>
                                                <TextBlock Text="Отправить"
                                                           Margin="8,0,8,0" />
                                            </dxe:ButtonInfo.Content>
                                        </dxe:ButtonInfo>
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                                 Command="{Binding Path=AddDiscussionCommand, Mode=OneWay}"
                                                                 CommandParameter="{Binding Path=DiscussionMessage, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ButtonEdit>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup x:Name="HistoryLayoutGroup"
                                              Header="История"
                                              Orientation="Vertical"
                                              ItemSpace="0">
                                <dxlc:LayoutGroup.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="/Images/Common/clock_history_frame_16x16.png" />
                                            <TextBlock Text="{Binding}"
                                                       Margin="5,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutGroup.HeaderTemplate>
                                <dxb:ToolBarControl GlyphSize="Small"
                                                    BarItemDisplayMode="Default"
                                                    AllowCustomizationMenu="False"
                                                    AllowQuickCustomization="False">
                                    <dxb:BarButtonItem Content="Обновить"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                                       Command="{Binding Path=RefreshAuditEntriesCommand, Mode=OneWay}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Content="Развернуть"
                                                       Glyph="../../../Images/Actions/toggle_expand_16_16.png"
                                                       Command="dxg:GridCommands.ExpandAllGroups"
                                                       CommandTarget="{Binding Path=View, ElementName=HistoryGridControl}" />
                                    <dxb:BarButtonItem Content="Свернуть"
                                                       Glyph="../../../Images/Actions/toggle_16_16.png"
                                                       Command="dxg:GridCommands.CollapseAllGroups"
                                                       CommandTarget="{Binding Path=View, ElementName=HistoryGridControl}" />
                                </dxb:ToolBarControl>
                                <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                                <dxg:GridControl x:Name="HistoryGridControl"
                                                 ItemsSource="{Binding Path=AuditEntries, Mode=OneWay}"
                                                 ShowLoadingPanel="{Binding Path=RefreshAuditEntriesCommand.IsExecuting, Mode=OneWay}"
                                                 SelectionMode="Row"
                                                 ShowBorder="False"
                                                 dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                                                 AutoExpandAllGroups="True"
                                                 FilterString="{Binding Path=HistoryActiveFilterString, Mode=TwoWay}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:LayoutSerializationBehavior FileName="service_request_history.xml" />
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Сотрудник"
                                                        FieldName="Caption"
                                                        GroupIndex="0"
                                                        SortOrder="Descending"
                                                        SortMode="Value"
                                                        SortIndex="0"
                                                        AllowGrouping="True" />
                                        <dxg:GridColumn Header="Свойство"
                                                        FieldName="PropertyName"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText" />
                                        <dxg:GridColumn Header="Старое значение"
                                                        FieldName="OldValueFormatted"
                                                        AllowColumnFiltering="False" />
                                        <dxg:GridColumn Header="Новое значение"
                                                        FieldName="NewValueFormatted"
                                                        AllowColumnFiltering="False" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowColumnFiltering="True"
                                                       AllowGrouping="True"
                                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                                            <dxg:TableView.GroupValueTemplate>
                                                <DataTemplate>
                                                    <Border Style="{Binding Path=View.GroupValueContentStyle}">
                                                        <TextBlock HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Path=Value}" />
                                                    </Border>
                                                </DataTemplate>
                                            </dxg:TableView.GroupValueTemplate>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup x:Name="ComplaintsLayoutGroup"
                                              Header="{Binding Path=Model.ComplaintsCountString, Mode=OneWay, FallbackValue=?}"
                                              Orientation="Vertical"
                                              ItemSpace="0">
                                <dxlc:LayoutGroup.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Common/thumb_down_16x16.png" />
                                            <TextBlock Text="{Binding StringFormat=Жалобы ({0})}"
                                                       Margin="5,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutGroup.HeaderTemplate>
                                <complaint:ComplaintsDocumentControlView AddComplaintCommand="{Binding AddComplaintCommand}"
                                                                         Complaints="{Binding Complaints}"
                                                                         RefreshComplaintsCommand="{Binding RefreshComplaintsCommand}" />
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Header="Справка"
                                          View="GroupBox"
                                          VerticalAlignment="Bottom"
                                          Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap"
                                       VerticalAlignment="Bottom">
                                    <Span Foreground="Red"
                                          FontWeight="Bold">Помните!</Span> Клиент также видит все сообщения в данной вкладке!</TextBlock>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup x:Name="InfoPropertiesLayoutGroup"
                                      Orientation="Vertical"
                                      Width="260">
                        <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                                      LabelColumnWidth="*"
                                                      ContentColumnWidth="1.9*" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility></TextBlock>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  UseLayoutRounding="True"
                                  Height="22">
                    <viewComponents:EditCommentButton Command="{Binding Path=EditCommentCommand, Mode=OneWay}"
                                                      Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Редактировать"
                                     Glyph="/Images/CategoryOptions/pencil.png"
                                     Command="{Binding Path=LockCommand, Mode=OneWay}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Принять"
                                     Command="{Binding Path=TakeRequestCommand, Mode=OneWay}"
                                     Glyph="{dx:DXImage Image=PublicFix_16x16.png}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Восстановить"
                                     Command="{Binding Path=ReopenRequestCommand, Mode=OneWay}"
                                     Glyph="{StaticResource ArrowRedo16}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Перепринять"
                                     Command="{Binding Path=ResetRequestCommand, Mode=OneWay}"
                                     Glyph="{StaticResource ArrowUndo16}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Перекомплектовать"
                                     Command="{Binding Path=RecomplectCommand, Mode=OneWay}"
                                     Glyph="/Images/Common/arrow_refresh.png"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Отменить"
                                     Command="{Binding Path=CancelRequestCommand, Mode=OneWay}"
                                     Glyph="../../../Images/Common/canceled.png"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Диагностика"
                                     Command="{Binding Path=DiagnoseRequestCommand, Mode=OneWay}"
                                     Glyph="{dx:DXImage Image=Technology_16x16.png}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Обменять"
                                     Command="{Binding Path=CompensateRequestCommand, Mode=OneWay}"
                                     Glyph="{dx:DXImage Image=BOSaleItem_16x16.png}"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:SimpleButton Content="Завершить"
                                     Command="{Binding Path=CompleteRequestCommand, Mode=OneWay}"
                                     Glyph="../../../Images/Common/tick.png"
                                     Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}" />
                    <dx:DropDownButton Content="Обработать"
                                       Glyph="../../../Images/Common/lightning_16x16.png"
                                       Visibility="{Binding OnConfirmationVisible, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}">
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Изменить решение"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/arrow_undo_16x16.png"
                                               Command="{Binding Path=DenyConfirmCommand}" />
                            <dxb:BarButtonItem Content="Передать клиенту"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/lorry_16x16.png"
                                               Command="{Binding Path=AcceptConfirmCommand}" />
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                    <TextBlock Text="Заявка обработана. Редактирование невозможно."
                               Foreground="Red"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Visibility="{Binding Path=Model.IsCompleted, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Right">
                    <dx:DropDownButton Content="Печать"
                                       IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                       Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                       Padding="8,0,0,0">
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Квитанция"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/document_comment_below_16x16.png"
                                               Command="{Binding Path=PrintAktCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Акт дефектовки"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/page_white_bug.png"
                                               Command="{Binding Path=PrintDefectivenessActCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Гар. талон"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/document_notes_16x16.png"
                                               Command="{Binding Path=PrintWarrantyCardCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Наш SN"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/barcode_16x16.png"
                                               Command="{Binding Path=PrintSerialNumberCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="ТТН"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/novaposhta_16x16.png"
                                               Command="{Binding Path=PrintTrackNumberCommand, Mode=OneTime}"
                                               CommandParameter="{Binding Path=Model.TtnOut, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Возвратная накл."
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/arrow_redo_16x16.png"
                                               Command="{Binding Path=PrintReturnReportCommand, Mode=OneTime}"
                                               CommandParameter="{Binding Path=Model.TtnOut, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Заявление на возврат"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="../../../Images/Common/page_red_16x16.png"
                                               Command="{Binding Path=PrintReturnProtocolReportCommand, Mode=OneTime}"
                                               CommandParameter="{Binding Path=Model.TtnOut, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Чек"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               IsVisible="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}}"
                                               Command="{Binding Path=PrintChequeCommand, Mode=OneTime}" />
                            <dxb:BarButtonItem Content="Акт выполненных работ"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               Glyph="{dx:DXImage Image=Print_16x16.png}"
                                               LargeGlyph="{dx:DXImage Image=Print_32x32.png}"
                                               IsVisible="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}}"
                                               Command="{Binding Path=PrintIssuanceCertificateCommand, Mode=OneTime}" />
                        </dxb:PopupMenu>
                    </dx:DropDownButton>
                    <StackPanel Style="{StaticResource VerticalSeparatorStackPanelStyle}" />
                    <Button x:Name="OkButton"
                            Content="ОК"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl" />
                                                <Binding Path="Model.IsCompleted"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}"></Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}"
                            IsVisibleChanged="ButtonIsVisibleChanged"></Button>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>