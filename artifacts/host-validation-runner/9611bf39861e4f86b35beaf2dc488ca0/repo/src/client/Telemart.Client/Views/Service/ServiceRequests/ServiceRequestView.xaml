<controls:TelemartUserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.ServiceRequestView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests"
                              xmlns:serviceRepairs="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRepairs"
                              xmlns:complaint="clr-namespace:Telemart.Client.Views.Complaint"
                              DataContext="{client:Container Type=viewModels:ServiceRequestViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="1600"
                              d:DesignHeight="768"
                              d:DataContext="{d:DesignInstance Type=viewModels:ServiceRequestViewModel, IsDesignTimeCreatable=True}">
    <controls:TelemartUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CallState.xaml" />
                <ResourceDictionary>
                    <system:String x:Key="NotInfoValue">(нет инфо)</system:String>

                    <Style x:Key="DisabledConditionsContentElementStyle"
                           TargetType="{x:Type FrameworkContentElement}">
                        <Setter Property="IsEnabled"
                                Value="{Binding IsLockedByCurrentEmployee, Mode=OneWay}" />
                    </Style>
                    <Style x:Key="ReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ServiceRequestDocumentComboBoxStyle"
                           TargetType="{x:Type dxe:ComboBoxEdit}"
                          >
                    </Style>
                    <Style TargetType="{x:Type dxe:ComboBoxEdit}"
                           BasedOn="{StaticResource ReadOnlyConditionsStyle}">
                        <Setter Property="AllowDefaultButton"
                                Value="{Binding Path=IsReadOnly, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}" />
                    </Style>
                    <Style x:Key="DisabledEditingComboBoxStyle"
                           TargetType="{x:Type dxe:ComboBoxEdit}"
                           BasedOn="{StaticResource ReadOnlyConditionsStyle}">
                        <Setter Property="AllowDefaultButton"
                                Value="{Binding Path=IsReadOnly, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="IsTextEditable"
                                Value="{Binding Path=IsReadOnly, RelativeSource={RelativeSource Self}}" />
                    </Style>
                    <Style TargetType="{x:Type dxe:TextEdit}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ServiceRequestPhoneTextEdit"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource PhoneTextEdit}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="{x:Type dxe:ButtonEdit}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="MemoEditStyle"
                           TargetType="{x:Type dxe:MemoEdit}">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="MaxLength"
                                Value="255" />
                        <Setter Property="TextWrapping"
                                Value="Wrap" />
                        <Setter Property="PopupMinWidth"
                                Value="200" />
                        <Setter Property="PopupMaxWidth"
                                Value="500" />
                        <Setter Property="PopupMaxHeight"
                                Value="300" />
                        <Setter Property="AcceptsReturn"
                                Value="True" />
                        <Setter Property="AcceptsTab"
                                Value="True" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Top" />
                        <Setter Property="MemoVerticalScrollBarVisibility"
                                Value="Auto" />
                        <Setter Property="MemoHorizontalScrollBarVisibility"
                                Value="Auto" />
                        <Setter Property="MemoTextWrapping"
                                Value="Wrap" />
                        <Setter Property="ShowIcon"
                                Value="False" />
                        <Setter Property="ShowSizeGrip"
                                Value="True" />
                    </Style>
                    <dxmvvm:ObjectToObjectConverter x:Key="TabNameToHelpVisibilityConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="DocumentsLayoutGroup"
                                        Target="Visible" />
                        <dxmvvm:MapItem Source="CallsLayoutGroup"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                    <dxmvvm:ObjectToObjectConverter x:Key="DisussionsWarningVisibilityConverter"
                                                    DefaultTarget="Collapsed">
                        <dxmvvm:MapItem Source="DiscussionsLayoutGroup"
                                        Target="Visible" />
                    </dxmvvm:ObjectToObjectConverter>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:TelemartUserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
        <dxmvvm:OpenFileDialogService Title="Выберите документ"
                                      Filter="PDF|*.pdf|Word 97-2003 Document|*.doc|Word Document|*.docx|JPEG|*.jpg|PNG|*.png"
                                      FilterIndex="4"
                                      Multiselect="True" />
        <dxmvvm:CurrentWindowService />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">
            <dxlc:LayoutControl.IsEnabled>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                    <Binding Path="SaveCommand.IsExecuting" />
                    <Binding Path="OkCommand.IsExecuting" />
                    <Binding Path="LockCommand.IsExecuting" />
                    <Binding Path="RemoveDocumentCommand.IsExecuting" />
                    <Binding Path="AddDiscussionCommand.IsExecuting" />
                    <Binding Path="CloseDiscussionCommand.IsExecuting" />
                </MultiBinding>
            </dxlc:LayoutControl.IsEnabled>
            <dxlc:LayoutGroup Orientation="Vertical"
                              VerticalAlignment="Stretch">
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  VerticalAlignment="Top">
                    <dxlc:LayoutGroup x:Name="MainPropertiesLayoutGroup"
                                      Header="Товар"
                                      Orientation="Vertical"
                                      VerticalAlignment="Stretch"
                                      View="GroupBox">
                        <dxlc:LayoutItem Label="Название">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.ProductFullName, Mode=OneWay}"
                                            AllowDefaultButton="False">
                                <dxe:ButtonEdit.Style>
                                    <Style BasedOn="{StaticResource ReadOnlyEditorStyle}"
                                           TargetType="{x:Type dxe:ButtonEdit}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding Path=Model.OriginalProductDiffersFromCurrent, Mode=OneWay}">
                                                <Setter Property="Background"
                                                        Value="Yellow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxe:ButtonEdit.Style>
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                Command="{Binding Path=ChangeProductCommand, Mode=OneWay}"
                                                Visibility="{Binding Path=ChangeProductVisible, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}" />
                                <dxe:ButtonInfo GlyphKind="Search"
                                                Command="{Binding Path=DocumentCommands.ShowProductCardCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Path=Model.ProductId, Mode=OneWay}" />
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                         Command="{Binding Path=DocumentCommands.ShowProductCardCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=Model.ProductId, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="SN">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.SerialNumber, Mode=OneWay}"
                                            AllowDefaultButton="False"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Search"
                                                Command="{Binding Path=DocumentCommands.ShowSerialNumberHistoryCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Path=Model.SerialNumber, Mode=OneWay}" />
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                         Command="{Binding Path=DocumentCommands.ShowSerialNumberHistoryCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=Model.SerialNumber, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Состояние">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Appearance, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Комплектация">
                            <dxe:TextEdit EditValue="{Binding Path=Model.CompletenessComment, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Дефект">
                            <dxe:MemoEdit EditValue="{Binding Path=Model.StatedDefect, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                          MaxLength="1000"
                                          ShowIcon="False"
                                          VerticalContentAlignment="Top"
                                          VerticalScrollBarVisibility="Auto"
                                          PopupMaxWidth="100"
                                          MemoTextWrapping="Wrap"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup x:Name="RequirementLayoutGroup"
                                      Header="Заявка"
                                      Orientation="Vertical"
                                      VerticalAlignment="Stretch"
                                      View="GroupBox">
                        <dxlc:LayoutItem Label="Требование">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.RequirementSummary, Mode=OneWay}"
                                            AllowDefaultButton="False"
                                            ToolTip="{Binding Path=Model.RequirementSummary, Mode=OneWay}"
                                            Height="22"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Edit"
                                                Command="{Binding Path=ChangeRequirementCommand, Mode=OneWay}" />
                                <dxe:ButtonInfo GlyphKind="Custom"
                                                Command="{Binding Path=OpenRequirementOnHistoryCommand, Mode=OneWay}">
                                    <dxe:ButtonInfo.Content>
                                        <dx:DXImage Source="../../../Images/Common/clock_history_frame_16x16.png" />
                                    </dxe:ButtonInfo.Content>
                                </dxe:ButtonInfo>
                                <dxe:ButtonInfo GlyphKind="Custom"
                                                ToolTip="Реквизиты"
                                                Visibility="{Binding Path=ShowRequisitesVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                Command="{Binding Path=ShowRequisitesCommand, Mode=OneWay}">
                                    <dxe:ButtonInfo.Content>
                                        <dx:DXImage Source="../../../Images/Common/user_green.png" />
                                    </dxe:ButtonInfo.Content>
                                </dxe:ButtonInfo>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Решение">
                            <dxe:MemoEdit EditValue="{Binding Path=Model.RequirementResolutionSummary, Mode=OneWay}"
                                          MaxHeight="50"
                                          Style="{StaticResource MemoEditStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Подменный фонд">
                            <dxe:TextEdit EditValue="{Binding Path=Model.ExchangeFund, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Комментарий"
                                         LabelVerticalAlignment="Top"
                                         VerticalAlignment="Stretch">
                            <dxe:TextEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                          VerticalContentAlignment="Top"
                                          VerticalScrollBarVisibility="Auto"
                                          AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          MaxHeight="50"
                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup x:Name="RelatedDocumentsLayoutGroup"
                                      Header="Связанные "
                                      Orientation="Vertical"
                                      VerticalAlignment="Stretch"
                                      View="GroupBox"
                                      Width="260">
                        <dxlc:LayoutItem Label="Заказ">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.OrderId, Mode=OneWay}"
                                            AllowDefaultButton="False"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Search"
                                                Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Path=Model.OrderId, Mode=OneWay}" />
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                         Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=Model.OrderId, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Закупался">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.PurchasedSummary, Mode=OneWay}"
                                            NullText="{StaticResource NotInfoValue}"
                                            AllowDefaultButton="False"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Search"
                                                Command="{Binding Path=ShowInvoiceCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Path=Model.InvoiceId, Mode=OneWay}" />
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                         Command="{Binding Path=ShowInvoiceCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=Model.InvoiceId, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Обм. заказ">
                            <dxe:ButtonEdit EditValue="{Binding Path=Model.OrderNewId, Mode=OneWay}"
                                            NullText="{StaticResource NotInfoValue}"
                                            AllowDefaultButton="False"
                                            Style="{StaticResource ReadOnlyEditorStyle}">
                                <dxe:ButtonInfo GlyphKind="Search"
                                                Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                                CommandParameter="{Binding Path=Model.OrderNewId, Mode=OneWay}" />
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:KeyToCommand KeyGesture="Enter"
                                                         Command="{Binding Path=OpenOrderCommand, Mode=OneWay}"
                                                         CommandParameter="{Binding Path=Model.OrderNewId, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:ButtonEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Возврат ДС">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Model.RefundIds, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.SelectedRefundId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              AllowDefaultButton="False"
                                              IsTextEditable="False"
                                              AllowNullInput="False">
                                <dxe:ComboBoxEdit.Buttons>
                                    <dxe:ButtonInfo GlyphKind="Search"
                                                    Command="{Binding Path=ShowMoneyRefundCommand, Mode=OneWay}"
                                                    CommandParameter="{Binding Path=Model.SelectedRefundId, Mode=OneWay}" />
                                </dxe:ComboBoxEdit.Buttons>
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Серв. товары">
                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Model.ServiceProductIds, Mode=OneWay}"
                                              EditValue="{Binding Path=Model.SelectedServiceProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                              AllowDefaultButton="False"
                                              IsTextEditable="False"
                                              AllowNullInput="False">
                                <dxe:ComboBoxEdit.Buttons>
                                    <dxe:ButtonInfo GlyphKind="Search"
                                                    Command="{Binding Path=ShowServiceProductCommand, Mode=OneWay}"
                                                    CommandParameter="{Binding Path=Model.SelectedServiceProductId, Mode=OneWay}" />
                                </dxe:ComboBoxEdit.Buttons>
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutGroup Orientation="Vertical">
                        <dxlc:LayoutGroup x:Name="TabsLayoutGroup"
                                          View="Tabs"
                                          VerticalAlignment="Stretch"
                                          TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                                          TabStyle="{StaticResource LayoutGroupTabStyle}"
                                          SelectedTabIndex="{Binding Path=SelectedTabIndex, Mode=TwoWay}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="SelectedTabChildChanged"
                                                       Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxlc:LayoutGroup x:Name="LogisticsLayoutGroup"
                                              Header="Инфо"
                                              Orientation="Horizontal"
                                              Margin="8">
                                <dxlc:LayoutGroup.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../../Images/Common/information.png" />
                                            <TextBlock Text="{Binding}"
                                                       Margin="5,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutGroup.HeaderTemplate>
                                <dxlc:LayoutGroup Orientation="Vertical">
                                    <dxlc:LayoutGroup Header="Получение"
                                                      View="GroupBox"
                                                      Orientation="Vertical"
                                                      VerticalAlignment="Top">
                                        <dxlc:LayoutItem Label="Доставка">
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                                              EditValue="{Binding Path=Model.CarryIn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              DisplayMember="Name"
                                                              AllowNullInput="True"
                                                              NullText="{StaticResource NullTextValue}"
                                                              NullValueButtonPlacement="EditBox"
                                                              Style="{StaticResource DisabledEditingComboBoxStyle}"
                                                              IsEnabled="{Binding IsDeliveryChangeEnabled}">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                                           Command="{Binding Path=HandleCarryInChangedCommand, Mode=OneTime}" />
                                                </dxmvvm:Interaction.Behaviors>
                                            </dxe:ComboBoxEdit>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Склад">
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                              EditValue="{Binding Path=WarehouseIn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              DisplayMember="Name"
                                                              AllowNullInput="True"
                                                              NullText="{StaticResource NullTextValue}"
                                                              NullValueButtonPlacement="EditBox"
                                                              Style="{StaticResource DisabledEditingComboBoxStyle}">
                                            </dxe:ComboBoxEdit>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="ТТН">
                                            <dxe:TextEdit EditValue="{Binding Path=Model.TtnIn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                          Style="{StaticResource ReadOnlyConditionsStyle}" />
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutGroup>
                                    <dxlc:LayoutGroup Header="Отправка"
                                                      View="GroupBox"
                                                      Orientation="Vertical"
                                                      VerticalAlignment="Stretch">
                                        <dxlc:LayoutItem Label="Доставка">
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=CarryTypes, Mode=OneWay}"
                                                              EditValue="{Binding Path=Model.CarryOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              DisplayMember="Name"
                                                              AllowNullInput="True"
                                                              NullText="{StaticResource NullTextValue}"
                                                              NullValueButtonPlacement="EditBox"
                                                              Style="{StaticResource DisabledEditingComboBoxStyle}"
                                                              IsEnabled="{Binding IsDeliveryChangeEnabled}"/>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Город">
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                                              EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                              DisplayMember="DisplayValue"
                                                              ValueMember="Id"
                                                              FilterCondition="StartsWith"
                                                              ImmediatePopup="True"
                                                              IncrementalFiltering="True"
                                                              ValidateOnTextInput="False"
                                                              IsTextEditable="True"
                                                              ApplyItemTemplateToSelectedItem="True">
                                                <dxe:ComboBoxEdit.Style>
                                                    <Style TargetType="{x:Type dxe:ComboBoxEdit}">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                                                        <Binding Path="IsLockedByCurrentEmployee"
                                                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="ShowEditorButtons"
                                                                        Value="False" />
                                                                <Setter Property="IsReadOnly"
                                                                        Value="True" />
                                                                <Setter Property="Opacity"
                                                                        Value="{StaticResource DisabledElementOpacity}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </dxe:ComboBoxEdit.Style>
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                                           Command="{Binding Path=HandleCityChangedCommand, Mode=OneTime}" />
                                                </dxmvvm:Interaction.Behaviors>
                                            </dxe:ComboBoxEdit>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutGroup Orientation="Vertical">
                                            <dxlc:LayoutItem Label="Адрес">
                                                <dxe:ButtonEdit EditValue="{Binding Path=Model.DeliveryDataOut, ValidatesOnDataErrors=True}"
                                                                IsTextEditable="False"
                                                                AllowDefaultButton="False"
