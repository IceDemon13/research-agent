<UserControl x:Class="Telemart.Client.Views.Store.Order.OrderEditPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order"
             Loaded="OnLoaded"
             Width="370"
             Height="140"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:OrderEditPaymentViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Старая">
                    <dxe:ComboBoxEdit x:Name="OldPaymentComboBox"
                                      ItemsSource="{Binding Path=AllPayments, Mode=OneWay}"
                                      EditValue="{Binding Path=CurrentPaymentId, Mode=OneWay}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      AllowDefaultButton="False"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новая">
                    <dxe:ComboBoxEdit x:Name="NewPaymentComboBox"
                                      ItemsSource="{Binding Path=AllowedPayments, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedPaymentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      IsReadOnly="{Binding Path=ReadOnlySelectedPayment, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Path=ReadOnlySelectedPayment, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                      InvalidValueBehavior="AllowLeaveEditor"
                                      Style="{StaticResource SearchableComboBoxStyle}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="Validate"
                                                   PassEventArgsToCommand="True"
                                                   Command="{Binding Path=ValidatePaymentCommand, Mode=OneTime}" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsTabStop="True"/>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>