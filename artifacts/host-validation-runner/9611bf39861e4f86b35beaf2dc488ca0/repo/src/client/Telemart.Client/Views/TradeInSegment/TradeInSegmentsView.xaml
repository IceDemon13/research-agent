<UserControl x:Name="CurrentControl"
             x:Class="Telemart.Client.Views.TradeInSegment.TradeInSegmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.TradeInSegment"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:TradeInSegmentsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type=viewModels:TradeInSegmentsViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary>
                    <Style TargetType="dxg:GridColumn">
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="FixedWidth"
                                Value="True" />
                        <Setter Property="ShowInColumnChooser"
                                Value="True" />
                        <Setter Property="HorizontalHeaderContentAlignment"
                                Value="Center" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl Height="Auto"
                                AllowQuickCustomization="False"
                                AllowCustomizationMenu="False">
                <dxb:ToolBarControl.IsEnabled>
                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="RefreshCommand.IsExecuting"
                                 Mode="OneWay"
                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                    </MultiBinding>
                </dxb:ToolBarControl.IsEnabled>
                <dxb:BarButtonItem Content="Обновить"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                   KeyGesture="F5" />
                <dxb:BarButtonItem Content="Колонки"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding ElementName=AssembledComputerRulesGrid, Path=View}"
                                   KeyGesture="F6" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Content="Создать"
                                   GlyphAlignment="Top"
                                   LargeGlyph="../../Images/Common/segment_add.png"
                                   Command="{Binding Path=CreateCommand, Mode=OneWay}"
                                   KeyGesture="Insert" />
                <dxb:BarButtonItem Content="Изменить"
                                   LargeGlyph="../../Images/Common/segment_edit.png"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=EditCommand}"
                                   KeyGesture="F2" />
                <dxb:BarButtonItem Content="Удалить"
                                   ToolTip="Удалить"
                                   LargeGlyph="../../Images/Common/segment_delete.png"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=DeleteCommand}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Управление коэф."
                                   ToolTip="Управление коэффициентами оценки"
                                   LargeGlyph="../../Images/TradeIn/ruby_gear.png"
                                   Command="{Binding Path=OpenCoefsEditorCommand, Mode=OneTime}"/>
                <dxb:BarButtonItem Content="{Binding Path = ChangeAutoEvaluationButtonContent, Mode = OneWay}"
                                   ToolTip="Автооценка"
                                   LargeGlyph="../../Images/Common/android_32x32.png"
                                   Glyph="../../Images/Common/android_16x16.png"
                                   Command="{Binding Path=ChangeAutoEvaluationCommand, Mode=OneTime}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="Наст. хар-тик"
                                   ToolTip="Настойка сегментообразующих характеристик по категориям Trade-In"
                                   LargeGlyph="../../Images/Common/segment_settings.png"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=CategorySettingsCommand}"/>
                <dxb:BarButtonItem Content="Пересчитать"
                                   ToolTip="Пересчитать товары по сегментам Trade-In"
                                   LargeGlyph="../../Images/Common/calculate-segments.png"
                                   GlyphAlignment="Top"
                                   Command="{Binding Path=RecalculateCommand}"/>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup>
                <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                  AllowSizing="True">
                    <dxg:GridControl x:Name="AssembledComputerRulesGrid"
                                     ItemsSource="{Binding Path=Segments}"
                                     SelectedItem="{Binding Path=SelectedSegment}"
                                     ShowLoadingPanel="{Binding Path=IsLongOperationInProgress}"
                                     SelectionMode="None"
                                     ShowBorder="False">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="trade_in_segments.xml" />
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Код"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Id"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="90"
                                            AllowResizing="False"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="True"
                                            SortOrder="Ascending"
                                            SortIndex="0">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Название"
                                            HeaderToolTip="Название сегмента"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Name"
                                            FixedWidth="False"
                                            Width="160"
                                            MinWidth="80"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False"
                                            FilterPopupMode="CheckedList">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Цена, грн"
                                            HeaderToolTip="Цена, грн"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Price"
                                            FixedWidth="False"
                                            Width="80"
                                            MinWidth="60"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowSorting="True"
                                            AllowMoving="False"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="False">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Категория"
                                            HeaderToolTip="Название категории"
                                            FieldName="CategoryName"
                                            FixedWidth="False"
                                            MaxWidth="180"
                                            Width="140"
                                            MinWidth="100"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Значения"
                                            HeaderToolTip="Значения характеристик по сегменту"
                                            FieldName="FeatureString"
                                            FixedWidth="False"
                                            MaxWidth="400"
                                            Width="200"
                                            MinWidth="140"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Ответственный"
                                            HeaderToolTip="Ответственный сотрудник за сегмент"
                                            FieldName="EmployeeName"
                                            FixedWidth="False"
                                            Width="100"
                                            MinWidth="100"
                                            MaxWidth="140"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Изменен"
                                            HeaderToolTip="Дата изменения сегмента"
                                            FieldName="ModifiedOn"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            FixedWidth="True"
                                            Width="90"
                                            MinWidth="70"
                                            MaxWidth="120"
                                            AllowColumnFiltering="False"
                                            HorizontalHeaderContentAlignment="Left"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Изменил"
                                            HeaderToolTip="Сотрудник, который последний изменил сегмент"
                                            FieldName="ModifiedByName"
                                            FixedWidth="False"
                                            MaxWidth="140"
                                            Width="100"
                                            MinWidth="80"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Visible="False"
                                            FieldName="AnyNewFeatures"
                                            FixedWidth="False"
                                            MaxWidth="0"
                                            Width="0"
                                            MinWidth="0"
                                            AllowResizing="False"
                                            AllowBestFit="False"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="False">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создан"
                                            HeaderToolTip="Дата создания"
                                            FieldName="CreatedOn"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            FixedWidth="True"
                                            MaxWidth="120"
                                            Width="80"
                                            MinWidth="70"
                                            AllowColumnFiltering="False"
                                            HorizontalHeaderContentAlignment="Left"
                                            ColumnFilterMode="DisplayText"
                                            FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="{x:Static business:DateFormattingRules.FullDateTimeFormat}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Создал"
                                            HeaderToolTip="Сотрудник, который создал сегмент"
                                            FieldName="CreatedByName"
                                            FixedWidth="False"
                                            MaxWidth="140"
                                            Width="100"
                                            MinWidth="80"
                                            AllowResizing="True"
                                            AllowBestFit="True"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           ShowGroupPanel="True"
                                           AllowGrouping="True"
                                           CustomCellAppearance="TableViewOnCustomCellAppearance"
                                           IsTotalSummaryMenuEnabled="False"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           ShowTotalSummary="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                           PassEventArgsToCommand="False" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition Expression="[AnyNewFeatures] = True"
                                                         FieldName="FeatureString">
                                        <dx:Format Background="{StaticResource PinkColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                                <dxg:TableView.ColumnHeaderContentStyle>
                                    <Style TargetType="dxg:HeaderContentControl">
                                        <Setter Property="FontWeight"
                                                Value="Normal" />
                                    </Style>
                                </dxg:TableView.ColumnHeaderContentStyle>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                        </dxg:GridControl.GroupSummary>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</UserControl>