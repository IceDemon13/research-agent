<UserControl x:Class="Telemart.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels"
             xmlns:telemartAnimatedGif="clr-namespace:TelemartAnimatedGif;assembly=TelemartAnimatedGif"
             Loaded="LoginViewOnLoaded"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:LoginViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <system:Double x:Key="FontSize">14</system:Double>
                    <Style x:Key="LoginLayoutItemStyle"
                           TargetType="dxlc:LayoutItem"
                           BasedOn="{StaticResource LayoutItemStyle}">
                        <Setter Property="FontSize"
                                Value="{StaticResource FontSize}"></Setter>
                        <Setter Property="FontWeight"
                                Value="DemiBold"></Setter>
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Width"
                                Value="80"></Setter>
                        <Setter Property="FontSize"
                                Value="{StaticResource FontSize}"></Setter>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="{StaticResource FontSize}"></Setter>
                    </Style>
                    <Style TargetType="{x:Type dx:WaitIndicatorContainer}">
                        <Setter Property="Height"
                                Value="56" />
                        <Setter Property="Width"
                                Value="200" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="Margin"
                                Value="0" />
                    </Style>
                    <Style TargetType="dxlc:GroupBox">
                        <Setter Property="TitleVisibility" Value="Collapsed" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="KeyUp"
                               Command="{Binding Path=HandleKeyUpCommand, Mode=OneWay}"
                               PassEventArgsToCommand="True" />
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:EventToCommand EventName="IsVisibleChanged"
                               Command="{Binding Path=IsVisibleChangedCommand, Mode=OneWay}"
                               PassEventArgsToCommand="True"/>
    </dxmvvm:Interaction.Behaviors>
        <dxlc:LayoutControl ItemSpace="12"
                            ItemStyle="{StaticResource LoginLayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Vertical"
                              View="GroupBox"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <TextBlock TextAlignment="Left"
                               Text="Добро пожаловать в Telemart.Client"
                               FontSize="18"
                               FontWeight="DemiBold" />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical"
                                  ItemSpace="12"
                                  IsEnabled="{Binding Path=AuthenticateCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxlc:LayoutItem Label="Логин">
                        <TextBox x:Name="LoginTextBox"
                                 Text="{Binding Path=Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="LoginTextBoxOnPreviewKeyDown">
                        </TextBox>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Пароль">
                        <dxe:PasswordBoxEdit x:Name="PasswordBoxEdit"
                                             Text="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="PreviewKeyDown"
                                                       Command="{Binding Path=HandlePasswordBoxKeyDownCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxe:PasswordBoxEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Stretch"
                                  ItemSpace="12">
                    <Image telemartAnimatedGif:ImageBehavior.AnimatedSource="{StaticResource WaitImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Visibility="{Binding Path=AuthenticateCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                    <Button Content="Вход"
                            Command="{Binding Path=AuthenticateCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=AuthenticateCommand.IsExecuting, Converter={dxmvvm:BooleanNegationConverter}}"
                            BorderThickness="0"
                            HorizontalAlignment="Right" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}"
                            HorizontalAlignment="Right" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

</UserControl>