<controls:TelemartUserControl x:Class="Telemart.Client.Views.Service.ServiceInvoices.CompleteServiceInvoiceView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:serviceInvoices="clr-namespace:Telemart.Client.ViewModels.Service.ServiceInvoices"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              mc:Ignorable="d"
                              x:Name="CurrentUserControl"
                              DataContext="{client:Container Type=serviceInvoices:CompleteServiceInvoiceViewModel}"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type serviceInvoices:CompleteServiceInvoiceViewModel}}"
                              Width="750"
                              MinWidth="300"
                              MinHeight="400"
                              Height="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Name="Center"
                              Orientation="Vertical">
                <dxg:GridControl x:Name="GridControl"
                                 ItemsSource="{Binding Path=ServiceInvoiceProducts, Mode=OneWay, ValidatesOnDataErrors=False}"
                                 CurrentItem="{Binding Path=SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                 ShowLoadingPanel="{Binding Path=IsEnabled, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, ElementName=LayoutControl}"
                                 SelectionMode="None"
                                 ShowBorder="True"
                                 ClipToBounds="True">
                    <dxmvvm:Interaction.Behaviors>
                        <behaviors:CopyCurrentCellToClipboardBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Товар"
                                        FieldName="ProductName"
                                        Width="210"
                                        MinWidth="80"
                                        HorizontalHeaderContentAlignment="Left">
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="SN"
                                        FieldName="SerialNumber"
                                        FixedWidth="True"
                                        Width="120"
                                        MinWidth="40"
                                        HorizontalHeaderContentAlignment="Left" />
                        <dxg:GridColumn Header="Дефект"
                                        FieldName="Defect"
                                        MinWidth="40" />
                        <dxg:GridColumn Header="П"
                                        HeaderToolTip="Принята"
                                        HorizontalHeaderContentAlignment="Center"
                                        FieldName="Accepted"
                                        AllowEditing="True"
                                        FixedWidth="True"
                                        MaxWidth="26"
                                        Width="26"
                                        MinWidth="26"
                                        AllowResizing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:CheckEditSettings HorizontalContentAlignment="Center" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Сохранка"
                                        FieldName="RepairInvoice"
                                        FixedWidth="True"
                                        Width="130"
                                        AllowEditing="True"
                                        MinWidth="40">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaxLength="30" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="TableView"
                                       AllowGrouping="False"
                                       AllowFilterEditor="False"
                                       AllowSorting="False"
                                       AllowBestFit="True"
                                       AllowPrintDetails="True"
                                       AllowMasterDetail="False"
                                       IsColumnChooserVisible="False"
                                       Style="{StaticResource ReadOnlyTableViewStyle}">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                <Button Content="OK"
                        Width="90"
                        IsTabStop="True"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}"
                        Command="{Binding Path=OkCommand, Mode=OneWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior />
                    </dxmvvm:Interaction.Behaviors>
                </Button>
                <Button Content="Отмена"
                        IsTabStop="True"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>
