<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="NewImage"
                 UriSource="/Images/Movement/State/1.png" />
    <BitmapImage x:Key="LeftImage"
                 UriSource="/Images/Movement/State/2.png" />
    <BitmapImage x:Key="ReceivedImage"
                 UriSource="/Images/Movement/State/3.png" />
    <BitmapImage x:Key="ArrivedImage"
                 UriSource="/Images/Movement/State/4.png" />
    <BitmapImage x:Key="CancelledImage"
                 UriSource="/Images/Movement/State/5.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="MovementStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource NewImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource LeftImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource ReceivedImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource ArrivedImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource CancelledImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="MovementStateComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:MovementState}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource MovementStateImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="MovementStateColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource MovementStateComboBoxItemTemplate}"/>
    </ControlTemplate>
</ResourceDictionary>