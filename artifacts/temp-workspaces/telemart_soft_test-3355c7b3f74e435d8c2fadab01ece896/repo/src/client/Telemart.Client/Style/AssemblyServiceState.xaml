<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">
    <BitmapImage x:Key="WaitingImage"
                 UriSource="/Images/Common/carry2.png" />
    <BitmapImage x:Key="WarehouseImage"
                 UriSource="/Images/Common/house.png" />
    <BitmapImage x:Key="AssemblingImage"
                 UriSource="/Images/Common/account_functions.png" />
    <BitmapImage x:Key="CompletedImage"
                 UriSource="/Images/Common/computer_go.png" />
    <BitmapImage x:Key="AssembledImage"
                 UriSource="/Images/Common/computer_16x16.png" />
    <BitmapImage x:Key="TestingImage"
                 UriSource="/Images/Common/computer_error.png" />
    <BitmapImage x:Key="DisassembledImage"
                 UriSource="/Images/Common/wrench_orange.png" />
    <BitmapImage x:Key="DisassemblingImage"
                 UriSource="/Images/Common/account_functions.png"/>
    <dxmvvm:ObjectToObjectConverter x:Key="AssemblyServiceStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource WaitingImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource WarehouseImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource AssemblingImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource CompletedImage}" />
        <dxmvvm:MapItem Source="5"
                        Target="{StaticResource AssembledImage}" />
        <dxmvvm:MapItem Source="6"
                        Target="{StaticResource TestingImage}" />
        <dxmvvm:MapItem Source="7"
                        Target="{StaticResource DisassembledImage}" />
        <dxmvvm:MapItem Source="8"
                        Target="{StaticResource DisassemblingImage}" />
    </dxmvvm:ObjectToObjectConverter>
    <DataTemplate x:Key="AssemblyServiceComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:AssemblyServiceState}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource AssemblyServiceStateImageConverter}}"
                        ToolTip="{Binding Path=Name, Mode=OneWay}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>
    <ControlTemplate x:Key="AssemblyServiceStateColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource AssemblyServiceComboBoxItemTemplate}" />
    </ControlTemplate>
</ResourceDictionary>