<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries">

    <BitmapImage x:Key="RedImage"
                 UriSource="/Images/Sms/mail_red_16x16.png" />
    <BitmapImage x:Key="GreenImage"
                 UriSource="/Images/Sms/mail_green_16x16.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="SmsStateImageConverter">
        <dxmvvm:MapItem Source="1"
                        Target="{StaticResource RedImage}" />
        <dxmvvm:MapItem Source="2"
                        Target="{StaticResource GreenImage}" />
        <dxmvvm:MapItem Source="3"
                        Target="{StaticResource RedImage}" />
        <dxmvvm:MapItem Source="4"
                        Target="{StaticResource RedImage}" />
    </dxmvvm:ObjectToObjectConverter>

    <DataTemplate x:Key="SmsStateComboBoxItemTemplate"
                  DataType="{x:Type dictionaries:SmsState}">
        <StackPanel Orientation="Horizontal"
                    Background="Transparent"
                    Height="20">
            <dx:DXImage Source="{Binding Path=Id, Mode=OneWay, Converter={StaticResource SmsStateImageConverter}}"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0" />
            <TextBlock Text="{Binding Path=Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <ControlTemplate x:Key="SmsStateColumnDisplayTemplate">
        <ContentControl Content="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                        ContentTemplate="{StaticResource SmsStateComboBoxItemTemplate}" />
    </ControlTemplate>
</ResourceDictionary>