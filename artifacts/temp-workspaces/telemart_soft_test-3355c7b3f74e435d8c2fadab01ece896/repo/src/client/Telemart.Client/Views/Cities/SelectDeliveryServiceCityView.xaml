<UserControl x:Class="Telemart.Client.Views.Cities.SelectDeliveryServiceCityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Cities"
             xmlns:client="clr-namespace:Telemart.Client"
             DataContext="{client:Container Type=viewModels:SelectDeliveryServiceCityViewModel}"
             mc:Ignorable="d"
             Width="800"
             Height="600"
             d:DataContext="{d:DesignInstance Type=viewModels:SelectDeliveryServiceCityViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style TargetType="dxg:GridColumn"
                           BasedOn="{StaticResource GeneralGridColumnStyle}">
                        <Setter Property="AllowSorting"
                                Value="True" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>


    <dxlc:LayoutControl x:Name="LayoutControl">
        <dxlc:LayoutGroup  Orientation="Vertical">
            <dxg:GridControl ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                             CurrentItem="{Binding Path=SelectedCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectionMode="None">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:FocusBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Name"
                                    FixedWidth="False"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True"
                                   NavigationStyle="Row"
                                   ShowColumnHeaders="False"
                                   ShowGroupPanel="False"
                                   ShowIndicator="False"
                                   ShowSearchPanelMode="Always"
                                   ShowSearchPanelFindButton="True"
                                   IsColumnMenuEnabled="False"
                                   IsColumnChooserVisible="False">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                   Command="{Binding Path=OkCommand, Mode=OneWay}"
                                                   PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition Expression="Active = 0"
                                                 ApplyToRow="True">
                                <dxg:FormatCondition.Format>
                                    <dx:Format Foreground="DarkGray"/>
                                </dxg:FormatCondition.Format>
                            </dxg:FormatCondition>
                        </dxg:TableView.FormatConditions>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutGroup HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                <dx:SimpleButton Content="OK"
                                 IsTabStop="True"
                                 Command="{Binding Path=OkCommand, Mode=OneWay}" />
                <dx:SimpleButton Content="Отмена"
                                 IsTabStop="True"
                                 Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>

