<controls:TelemartUserControl x:Class="Telemart.Client.Views.Store.Order.AddOrderPaymentView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:order="clr-namespace:Telemart.Client.ViewModels.Store.Order"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:common="clr-namespace:Telemart.Client.Common"
                              DataContext="{client:Container Type=order:AddOrderPaymentViewModel}"
                              Width="350"
                              Height="257"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type order:AddOrderPaymentViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Валюта">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Currencies, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Title" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Способ">
                    <dxe:ComboBoxEdit x:Name="PaymentComboBoxEdit"
                                      ItemsSource="{Binding Path=PaymentTypes, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedPaymentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      AllowNullInput="True"
                                      NullValue="{x:Null}"
                                      NullText="{StaticResource NullTextValue}"
                                      NullValueButtonPlacement="EditBox" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Касса">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cashboxes, Mode=OneWay}"
                                      EditValue="{Binding Path=SelectedCashboxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      Style="{StaticResource SearchableComboBoxStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="К оплате">
                    <dxe:SpinEdit EditValue="{Binding Path=ToPayAmount, Mode=OneWay}"
                                  EditValueType="{x:Type system:Decimal}"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="C2"
                                  MaskCulture="{Binding Path=SelectedCurrency.Id, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}, FallbackValue={x:Static business:CurrencyFormatingRules.UahCultureInfo}}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="False"
                                  Style="{StaticResource ReadOnlyEditorStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Сумма">
                    <dxe:SpinEdit EditValue="{Binding Path=Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  EditValueType="{x:Type system:Decimal}"
                                  MinValue="0"
                                  MaxValue="{x:Static common:Constants.MaxProductPrice}"
                                  MaskType="Numeric"
                                  MaskUseAsDisplayFormat="True"
                                  Mask="C2"
                                  MaskCulture="{Binding Path=SelectedCurrency.Id, Mode=OneWay, Converter={converters:CurrencyToMaskCultureConverter}}"
                                  MaskSaveLiteral="False"
                                  IsFloatValue="True"
                                  AllowDefaultButton="True" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Внесена">
                    <dxe:DateEdit EditValue="{Binding Path=ReceivedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MinValue="{Binding Path=ReceivedOnMinValue}"
                                  MaxValue="{Binding Path=ReceivedOnMaxValue}"
                                  MaskType="DateTimeAdvancingCaret"
                                  MaskUseAsDisplayFormat="True"
                                  AllowNullInput="True"
                                  NullValueButtonPlacement="EditBox"
                                  NullValue="{x:Null}"
                                  NullText="{StaticResource NullTextValue}">
                        <dxe:DateEdit.StyleSettings>
                            <dxe:DateEditCalendarStyleSettings />
                        </dxe:DateEdit.StyleSettings>
                    </dxe:DateEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Комментарий">
                    <dxe:MemoEdit EditValue="{Binding Path=Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Height="22"
                                  TextWrapping="Wrap"
                                  PopupMinWidth="200"
                                  PopupMaxWidth="500"
                                  AcceptsReturn="True"
                                  AcceptsTab="True"
                                  VerticalContentAlignment="Top"
                                  MemoVerticalScrollBarVisibility="Auto"
                                  MemoHorizontalScrollBarVisibility="Auto"
                                  MemoTextWrapping="Wrap"
                                  ShowIcon="False"
                                  ShowSizeGrip="True">
                    </dxe:MemoEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup HorizontalAlignment="Right">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}"
                            IsTabStop="True"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}"
                            IsTabStop="True" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>