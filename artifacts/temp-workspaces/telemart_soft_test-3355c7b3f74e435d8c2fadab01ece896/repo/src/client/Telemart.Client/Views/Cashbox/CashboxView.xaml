<UserControl x:Class="Telemart.Client.Views.Cashbox.CashboxView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Cashbox"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             DataContext="{client:Container Type=viewModels:CashboxViewModel}"
             Width="500"
             Height="500"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:CashboxViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="SearchableComboBoxReadOnlyConditionsStyle"
                           BasedOn="{StaticResource SearchableComboBoxStyle}"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 Mode="OneWay"
                                                 ElementName="CurrentUserControl" />
                                        <Binding Path="DataContext.IsNew"
                                                 Mode="OneWay"
                                                 ElementName="CurrentUserControl" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="CheckedTokenComboBoxReadOnlyConditionsStyle"
                           BasedOn="{StaticResource CheckedTokenComboBoxStyle}"
                           TargetType="dxe:ComboBoxEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Setter Property="AllowDefaultButton"
                                Value="False" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="None" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 Mode="OneWay"
                                                 ElementName="CurrentUserControl" />
                                        <Binding Path="DataContext.IsNew"
                                                 Mode="OneWay"
                                                 ElementName="CurrentUserControl" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                                <Setter Property="AllowDefaultButton"
                                        Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Название">
                    <dxe:TextEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                  EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Тип">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.TypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=Types, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="Name"
                                      Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Способ подключения">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.ConnectTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=ConnectTypes, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="Name"
                                      Style="{StaticResource LookUpReadOnlyConditionsStyle}" >
                        <dxe:ComboBoxEdit.IsReadOnly>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                <Binding Path="Model.AllowEditConnectType"/>
                            </MultiBinding>
                        </dxe:ComboBoxEdit.IsReadOnly>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Логин">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.CredentialId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=CashboxCredentialLogins, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"
                                      Style="{StaticResource LookUpReadOnlyConditionsStyle}" >
                        <dxe:ComboBoxEdit.IsReadOnly>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                <Binding Path="Model.AllowEditCredentials"/>
                            </MultiBinding>
                        </dxe:ComboBoxEdit.IsReadOnly>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Ответственный">
                    <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox"
                                      DisplayMember="DisplayValue"
                                      ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.Employee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Валюта">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.CurrencyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=Currencies, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="Title"
                                      Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Способ">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.AllowedPayments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={converters:IntItemsConverter}}"
                                      ItemsSource="{Binding Path=Payments, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"
                                      Style="{StaticResource CheckedTokenComboBoxReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Юр. лицо">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.LegalEntityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=LegalEntities, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"
                                      Style="{StaticResource LookUpReadOnlyConditionsStyle}" >
                        <dxe:ComboBoxEdit.IsReadOnly>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                <Binding Path="AllowEditLegalEntity"/>
                            </MultiBinding>
                        </dxe:ComboBoxEdit.IsReadOnly>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Склад"
                                 Visibility="{Binding Path=Model.WarehouseVisible, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                      EditValue="{Binding Path=Model.WarehouseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"
                                      HorizontalContentAlignment="Left"
                                      Style="{StaticResource SearchableComboBoxReadOnlyConditionsStyle}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Сейф">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=Model.StrongboxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=StrongboxCashboxes, Mode=OneWay}"
                                      ValueMember="Id"
                                      DisplayMember="DisplayValue"
                                      Style="{StaticResource LookUpReadOnlyConditionsStyle}" >
                        <dxe:ComboBoxEdit.IsReadOnly>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                <Binding Path="Model.AllowEditStrongbox"/>
                            </MultiBinding>
                        </dxe:ComboBoxEdit.IsReadOnly>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Несгораемый остаток">
                    <dxe:SpinEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                  EditValue="{Binding Model.IncombustibleAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}"
                                  MinValue="0"
                                  AllowNullInput="True"
                                  Mask="####.00"
                                  MaskType="Numeric"
                                  InvalidValueBehavior="AllowLeaveEditor"
                                  EditValueType="{x:Type system:Decimal}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Банковский счет">
                    <dxe:TextEdit EditValue="{Binding Model.PaymentAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  AllowNullInput="True"
                                  Style="{StaticResource ReadOnlyConditionsStyle}"
                                  InvalidValueBehavior="AllowLeaveEditor" >
                        <dxe:TextEdit.IsReadOnly>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter Inverse=True}">
                                <Binding Path="IsNewOrIsLockedByCurrentEmployee"/>
                                <Binding Path="Model.IsNotReadonlyPaymentAccount"/>
                            </MultiBinding>
                        </dxe:TextEdit.IsReadOnly>
                    </dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup>
                    <dxlc:LayoutItem Label="Комиссия">
                        <dxe:SpinEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                      EditValue="{Binding Model.Fee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}"
                                      MinValue="0"
                                      AllowNullInput="True"
                                      Mask="##.00"
                                      MaskType="Numeric"
                                      InvalidValueBehavior="AllowLeaveEditor"
                                      EditValueType="{x:Type system:Decimal}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="%, минимум">
                        <dxe:SpinEdit IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                      EditValue="{Binding Model.MinFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}"
                                      MinValue="0"
                                      AllowNullInput="True"
                                      Mask="###.00"
                                      MaskType="Numeric"
                                      InvalidValueBehavior="AllowLeaveEditor"
                                      EditValueType="{x:Type system:Decimal}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutItem Label="Статус">
                    <dxlc:LayoutGroup Orientation="Horizontal"
                                      HorizontalAlignment="Left">
                        <dxlc:LayoutGroup.Style>
                            <Style TargetType="dxlc:LayoutGroup">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource DisabledElementOpacity}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsNew"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True" />
                                        <Setter Property="Opacity"
                                                Value="{StaticResource EnabledElementOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxlc:LayoutGroup.Style>
                        <RadioButton Content="Активен"
                                     IsChecked="{Binding Path=Model.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                        <RadioButton Content="Не активен"
                                     IsChecked="{Binding Path=Model.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                     VerticalAlignment="Center" />
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Автовнесение">
                    <dxe:CheckEdit EditValue="{Binding Path=Model.AutoPay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                   Style="{StaticResource ReadOnlyConditionsStyle}"
                                   IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup x:Name="ButtonsLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                                <Binding Path="IsNew"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="True"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>