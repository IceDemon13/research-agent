<UserControl x:Class="Telemart.Client.Views.Cities.CityView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Cities"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             DataContext="{client:Container Type=viewModels:CityViewModel}"
             Width="560"
             Height="510"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:CityViewModel}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <dxmvvm:BooleanToObjectConverter x:Key="ActiveToIntConverter"
                                             NullValue="{x:Null}">
                <dxmvvm:BooleanToObjectConverter.TrueValue>
                    <system:Int32>1</system:Int32>
                </dxmvvm:BooleanToObjectConverter.TrueValue>
                <dxmvvm:BooleanToObjectConverter.FalseValue>
                    <system:Int32>2</system:Int32>
                </dxmvvm:BooleanToObjectConverter.FalseValue>
            </dxmvvm:BooleanToObjectConverter>

            <Style x:Key="ComboBoxEditReadOnlyConditionsStyle"
                   TargetType="dxe:ComboBoxEdit">
                <Setter Property="AllowDefaultButton"
                        Value="False" />
                <Setter Property="IsTextEditable"
                        Value="True" />
                <Setter Property="IsReadOnly"
                        Value="True" />
                <Setter Property="Opacity"
                        Value="{StaticResource DisabledElementOpacity}" />
                <Setter Property="NullValueButtonPlacement"
                        Value="None" />
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                         ElementName="CurrentUserControl"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="IsTextEditable"
                                Value="False" />
                        <Setter Property="IsReadOnly"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource EnabledElementOpacity}" />
                        <Setter Property="NullValueButtonPlacement"
                                Value="EditBox" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyConditionsStyle"
                   TargetType="dxe:BaseEdit">
                <Setter Property="IsReadOnly"
                        Value="True" />
                <Setter Property="Opacity"
                        Value="{StaticResource DisabledElementOpacity}" />
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                         ElementName="CurrentUserControl"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="IsReadOnly"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource EnabledElementOpacity}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=IsVisible, ElementName=WaitImage, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Название">
                <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (укр)">
                <dxe:TextEdit EditValue="{Binding Path=Model.NameUkr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Название (англ)">
                <dxe:TextEdit EditValue="{Binding Path=Model.NameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup View="GroupBox"
                              Header="Доставка"
                              Orientation="Vertical"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                              ItemSpace="0">
                            <dxb:ToolBarControl VerticalAlignment="Top"
                                                Style="{StaticResource SmallToolBarStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                   Command="{Binding Path=AddCityCarryCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Удалить"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                   Command="{Binding Path=DeleteCityCarryCommand, Mode=OneWay}" />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl ItemsSource="{Binding Path=Model.CityCarries, Mode=OneWay}"
                                             CurrentItem="{Binding Path=SelectedCityCarry, Mode=TwoWay}"
                                             SelectionMode="None"
                                             x:Name="CityCarriesGridControl"
                                             ShowBorder="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Style>
                                    <Style TargetType="dxg:GridControl"
                                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                                        <Setter Property="Opacity"
                                                Value="{StaticResource DisabledElementOpacity}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay}">
                                                <Setter Property="Opacity"
                                                        Value="{StaticResource EnabledElementOpacity}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxg:GridControl.Style>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="AvailOnWeb"
                                                    Header="Д"
                                                    FixedWidth="True"
                                                    Width="25"
                                                    AllowResizing="False"
                                                    HeaderToolTip="Доступен на сайте"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    AllowColumnFiltering="False"
                                                    ReadOnly="{Binding Path=IsNewOrIsLockedByCurrentEmployee, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                                    AllowSorting="True">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox x:Name="PART_Editor"
                                                          IsEnabled="{Binding Path=DataContext.IsNewOrIsLockedByCurrentEmployee, ElementName=CityCarriesGridControl, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          IsChecked="{Binding RowData.Row.AvailOnWeb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn AllowEditing="False"
                                                    Header="Название"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    MinWidth="80"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    FieldName="CarryId"
                                                    HeaderToolTip="Название способа доставки">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                      ItemsSource="{Binding Path=Carries, Mode=OneWay}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn AllowEditing="False"
                                                    Header="Создал"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    MinWidth="80"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    FieldName="CreatedBy"
                                                    HeaderToolTip="Создал">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings HorizontalContentAlignment="Left"
                                                                      ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="DisplayValue" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowPerPixelScrolling="True"
                                           ShowTotalSummary="False"
                                           ShowIndicator="False"
                                           ShowFixedTotalSummary="False"
                                           ShowAutoFilterRow="False"
                                           ShowSearchPanelMode="Never"
                                           ShowGroupPanel="False"
                                           IsColumnMenuEnabled="False"
                                           ShowColumnHeaders="True"
                                           AutoWidth="True"
                                           NavigationStyle="Cell"
                                           IsEnabled="True"
                                           AllowResizing="True"
                                           AllowEditing="False"
                                           AllowGrouping="False"
                                           AllowColumnMoving="False"
                                           AllowColumnFiltering="False"
                                           AllowSorting="True"
                                           EnableImmediatePosting="True"
                                           AllowMoveColumnToDropArea="False">
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
            <dxlc:LayoutItem Label="Порядок">
                <dxe:SpinEdit EditValue="{Binding Model.Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MinValue="1"
                              MaxValue="100"
                              AllowNullInput="False"
                              IsFloatValue="False"
                              InvalidValueBehavior="AllowLeaveEditor"
                              EditValueType="{x:Type system:Int32}"
                              Style="{StaticResource ReadOnlyConditionsStyle}" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Область">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Areas, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.AreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  ShowEditorButtons="True"
                                  NullValueButtonPlacement="EditBox"
                                  DisplayMember="Name"
                                  ValueMember="Id"
                                  Style="{StaticResource ComboBoxEditReadOnlyConditionsStyle}">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Район">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Districts, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.DistrictId, Mode=TwoWay}"
                                  ShowEditorButtons="True"
                                  NullValueButtonPlacement="EditBox"
                                  DisplayMember="Name"
                                  ValueMember="Id"
                                  Style="{StaticResource ComboBoxEditReadOnlyConditionsStyle}">
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Город НП">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=NpCitites, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.NpCityRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="CityRef"
                                  PopupOpening="CityComboBoxEditOnPopupOpening"
                                  Style="{StaticResource ComboBoxEditReadOnlyConditionsStyle}"
                                  IsEnabled="{Binding Path=IsEnableDeliveryCities, Mode=OneWay }">
                    <dxe:ComboBoxEdit.Buttons>
                        <dxe:ButtonInfo GlyphKind="Regular"
                                        IsDefaultButton="True"
                                        Command="{Binding Path=SetNpCityCommand, Mode=OneWay}" />
                    </dxe:ComboBoxEdit.Buttons>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Город МЭ">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=MeCities, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.MeCityRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="CityRef"
                                  PopupOpening="CityComboBoxEditOnPopupOpening"
                                  Style="{StaticResource ComboBoxEditReadOnlyConditionsStyle}"
                                  IsEnabled="{Binding Path=IsEnableDeliveryCities, Mode=OneWay }">
                    <dxe:ComboBoxEdit.Buttons>
                        <dxe:ButtonInfo GlyphKind="Regular"
                                        IsDefaultButton="True"
                                        Command="{Binding Path=SetMeCityCommand, Mode=OneWay}" />
                    </dxe:ComboBoxEdit.Buttons>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Город УП">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=UpCitites, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.UpCityIdStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="CityRef"
                                  PopupOpening="CityComboBoxEditOnPopupOpening"
                                  Style="{StaticResource ComboBoxEditReadOnlyConditionsStyle}"
                                  IsEnabled="{Binding Path=IsEnableDeliveryCities, Mode=OneWay }">
                    <dxe:ComboBoxEdit.Buttons>
                        <dxe:ButtonInfo GlyphKind="Regular"
                                        IsDefaultButton="True"
                                        Command="{Binding Path=SetUpCityCommand, Mode=OneWay}" />
                    </dxe:ComboBoxEdit.Buttons>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Город Uklon">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=UklonCities, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.UklonCityIdStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="CityRef"
                                  PopupOpening="CityComboBoxEditOnPopupOpening"
                                  Style="{StaticResource ComboBoxEditReadOnlyConditionsStyle}"
                                  IsEnabled="{Binding Path=IsEnableDeliveryCities, Mode=OneWay }">
                    <dxe:ComboBoxEdit.Buttons>
                        <dxe:ButtonInfo GlyphKind="Regular"
                                        IsDefaultButton="True"
                                        Command="{Binding Path=SetUklonCityCommand, Mode=OneWay}" />
                    </dxe:ComboBoxEdit.Buttons>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup x:Name="ButtonsLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </dxlc:LayoutGroup>

                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Mode="OneWay"
                                      Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="SaveCommand.IsExecuting"
                                     Mode="OneWay" />
                            <Binding Path="LockCommand.IsExecuting"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Mode="OneWay"
                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         Mode="OneWay"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>