<UserControl x:Class="Telemart.Client.Views.Dialogs.CallDialogView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Dialogs.Call"
                              xmlns:controls1="clr-namespace:Telemart.Client.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:oktell="clr-namespace:Telemart.Client.Oktell;assembly=Telemart.Client.Oktell"
                              xmlns:transferObjects="clr-namespace:Telemart.Client.TransferObjects;assembly=Telemart.Client.TransferObjects"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:CallDialogViewModel}"
                              d:DataContext="{d:DesignInstance Type={x:Type viewModels:CallDialogViewModel}, IsDesignTimeCreatable=True}"
                              d:DesignWidth="370"
                              d:DesignHeight="156">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <dxmvvm:BooleanToObjectConverter x:Key="BooleanToTimerStateConverter"
                                             TrueValue="{x:Static controls1:TimerState.Start}"
                                             FalseValue="{x:Static controls1:TimerState.Stop}"></dxmvvm:BooleanToObjectConverter>

            <Style x:Key="ComboBoxReadOnlyConditionsStyle"
                   TargetType="dxe:ComboBoxEdit">
                <Setter Property="IsReadOnly"
                        Value="True" />
                <Setter Property="Opacity"
                        Value="{StaticResource DisabledElementOpacity}" />
                <Setter Property="AllowDefaultButton"
                        Value="False" />
                <Setter Property="IsTextEditable"
                        Value="True" />
                <Style.Triggers>
                    <DataTrigger Value="False">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="DataContext.IsConnected"
                                         ElementName="CurrentUserControl"
                                         Mode="OneWay" />
                                <Binding Path="DataContext.IsRinging"
                                         ElementName="CurrentUserControl"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="IsReadOnly"
                                Value="False" />
                        <Setter Property="AllowDefaultButton"
                                Value="True" />
                        <Setter Property="IsTextEditable"
                                Value="False" />
                        <Setter Property="Opacity"
                                Value="{StaticResource EnabledElementOpacity}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutItem Label="Клиент">
                <dxe:TextEdit EditValue="{Binding Path=Fio, Mode=OneWay}"
                              Style="{StaticResource ReadOnlyEditorStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Телефон">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Phones}"
                                  EditValue="{Binding Path=SelectedPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ComboBoxReadOnlyConditionsStyle}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Тематика">
                <dxe:TextEdit EditValue="{Binding Path=Ivr, Mode=OneWay}"
                              Style="{StaticResource ReadOnlyEditorStyle}"
                              ToolTip="{Binding Path=Ivr, Mode=OneWay}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <controls1:TimerTextBlock VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          State="{Binding IsConnected, Mode=OneWay, Converter={StaticResource BooleanToTimerStateConverter}}"
                                          Visibility="{Binding Path=IsConnected, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}"/>
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <dx:SimpleButton Content="Позвонить"
                                     Glyph="../../Images/Common/phone_sound_16x16.png"
                                     Command="{Binding Path=StartCallCommand, Mode=OneWay}"
                                     Visibility="{Binding StartCallVisible, Converter={dx:BooleanToVisibilityConverter}}"/>
                    <dx:SimpleButton Content="Ответить"
                                     Glyph="../../Images/Common/phone-call-up_16x16.png"
                                     HorizontalAlignment="Left"
                                     Command="{Binding Path=ApplyCallCommand, Mode=OneWay}"
                                     Visibility="{Binding ApplyCallVisible, Converter={dx:BooleanToVisibilityConverter}}"/>
                    <dx:SimpleButton Content="Отклонить"
                                     Glyph="../../Images/Common/phone-call-down_16x16.png"
                                     HorizontalAlignment="Left"
                                     Command="{Binding Path=CancelCallCommand, Mode=OneWay}"
                                     Visibility="{Binding CancelCallVisible, Converter={dx:BooleanToVisibilityConverter}}"/>
                    <dx:SimpleButton Content="Завершить"
                                     HorizontalAlignment="Left"
                                     Glyph="../../Images/Common/phone-call-down_16x16.png"
                                     Command="{Binding Path=EndCallCommand, Mode=OneWay}"
                                     Visibility="{Binding EndCallVisible, Converter={dx:BooleanToVisibilityConverter}}"/>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>