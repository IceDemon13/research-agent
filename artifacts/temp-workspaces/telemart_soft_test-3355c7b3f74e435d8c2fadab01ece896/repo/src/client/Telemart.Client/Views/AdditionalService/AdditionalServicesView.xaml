<UserControl x:Class="Telemart.Client.Views.AdditionalService.AdditionalServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AdditionalService"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             DataContext="{client:Container Type=viewModels:AdditionalServicesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AdditionalServicesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/OrderStatus.xaml" />
                <ResourceDictionary>
                    <HierarchicalDataTemplate DataType="{x:Type viewModels:AdditionalServiceGroupViewItem}"
                                              ItemsSource="{Binding Path=Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=DataContext.Name}"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Padding="5 0 5 1" />
                            <dx:DXImage Source="../../Images/Common/lock.png"
                                        Height="16"
                                        Width="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding Path=DataContext.EmployeeLockId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}}">
                                <dx:DXImage.ToolTip>
                                    <ToolTip>
                                        <dxlc:LayoutControl Orientation="Vertical">
                                            <dxlc:LayoutItem Label="Редактирует:">
                                                <TextBlock Text="{Binding Path=DataContext.EmployeeLockName, Mode=OneWay}"
                                                           FontWeight="Bold" />
                                            </dxlc:LayoutItem>
                                        </dxlc:LayoutControl>
                                    </ToolTip>
                                </dx:DXImage.ToolTip>
                            </dx:DXImage>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup>
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl
                    IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                    <dxb:BarCheckItem  Content="Неактивные"
                                   ToolTip="Неактивные"
                                   Glyph="/Images/Contractor/bin.png"
                                   IsChecked="{Binding Path=ShowInactiveServices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarSubItem Content="Создать"
                                    ToolTip="Создать"
                                    GlyphAlignment="Top"
                                    LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                    Glyph="{dx:DXImage Image=Add_16x16.png}">
                        <dxb:BarButtonItem Content="Создать услугу"
                                           ToolTip="Создать услугу (Insert)"
                                           GlyphAlignment="Top"
                                           LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Создать группу"
                                           Glyph="../../Images/Common/folder.png"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=AddGroupCommand, Mode=OneTime}" />
                    </dxb:BarSubItem>
                    <dxb:BarButtonItem Content="Изменить"
                                       ToolTip="Изменить (F2)"
                                       LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                       Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                       Command="{Binding Path=EditCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Порядок"
                                       ToolTip="Порядок"
                                       LargeGlyph="../../Images/Common/accordion_32x32.png"
                                       Command="{Binding Path=ReorderCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarButtonItem Content="Перенос"
                                       ToolTip="Перенос"
                                       LargeGlyph="../../Images/Common/folders_32x32.png"
                                       Command="{Binding Path=MoveCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Приоритет"
                                       ToolTip="Приоритет"
                                       LargeGlyph="../../Images/Common/microformats.png"
                                       Command="{Binding Path=ReorderPriorityCommand, Mode=OneTime}"
                                       CommandTarget="{Binding ElementName=LayoutRoot}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Margin="0"
                                  Orientation="Horizontal">
                    <dxdo:LayoutGroup>
                        <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                          AllowSizing="True">
                            <dxg:GridControl x:Name="GridControl"
                                             ItemsSource="{Binding Path=AdditionalServiceGroups, Mode=OneWay}"
                                             CurrentItem="{Binding Path=SelectedElement, Mode=TwoWay}"
                                             AllowDrop="False"
                                             ShowBorder="False"
                                             SelectionMode="None"
                                             AutoExpandAllGroups="True">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:LayoutSerializationBehavior FileName="additional_services_1.xml" />
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.ShowLoadingPanel>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="RefreshCommand.IsExecuting" />
                                    </MultiBinding>
                                </dxg:GridControl.ShowLoadingPanel>
                                <dxg:GridControl.Resources>
                                    <Style TargetType="dxg:GridColumn"
                                           BasedOn="{StaticResource GeneralGridColumnStyle}" />
                                </dxg:GridControl.Resources>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Код"
                                                    HeaderToolTip="Номер услуги"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Id"
                                                    FixedWidth="True"
                                                    Width="60"
                                                    MinWidth="60"
                                                    AllowBestFit="True"
                                                    AllowResizing="False"
                                                    AllowGrouping="False"
                                                    AllowMoving="False"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Название"
                                                    HeaderToolTip="Название услуги"
                                                    FieldName="Name"
                                                    FixedWidth="False"
                                                    Width="110"
                                                    MinWidth="110"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="False"
                                                    AllowMoving="False"
                                                    AllowAutoFilter="False" />
                                    <dxg:GridColumn Header="Тип приоритета"
                                                    HeaderToolTip="Тип приоритета"
                                                    FieldName="PriorityTypeId"
                                                    FixedWidth="True"
                                                    Width="100"
                                                    MinWidth="100"
                                                    AllowBestFit="True"
                                                    AllowResizing="False"
                                                    AllowGrouping="False"
                                                    AllowMoving="False"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=PriorityTypes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="А"
                                                    HeaderToolTip="Активная"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Active"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dx:DXImage Source="../../Images/Common/tick.png"
                                                            Width="16"
                                                            Height="16"
                                                            Visibility="{Binding Path=RowData.Row.Active, Mode=OneWay, Converter={dxmvvm:NumericToVisibilityConverter}}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="И"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    HeaderToolTip="Информация"
                                                    FieldName="EmployeeLockId"
                                                    FixedWidth="True"
                                                    Width="24"
                                                    MinWidth="24"
                                                    AllowBestFit="False"
                                                    AllowResizing="False"
                                                    AllowGrouping="False"
                                                    AllowColumnFiltering="False"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dx:DXImage Source="../../Images/Common/lock.png"
                                                            Height="16"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding Path=RowData.Row.EmployeeLockId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}}">
                                                    <dx:DXImage.ToolTip>
                                                        <ToolTip>
                                                            <dxlc:LayoutControl Orientation="Vertical">
                                                                <dxlc:LayoutItem Label="Услугу редактирует:">
                                                                    <TextBlock Text="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay}"
                                                                               FontWeight="Bold" />
                                                                </dxlc:LayoutItem>
                                                            </dxlc:LayoutControl>
                                                        </ToolTip>
                                                    </dx:DXImage.ToolTip>
                                                </dx:DXImage>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TreeListView AllowBestFit="True"
                                                      AllowEditing="True"
                                                      AllowFilterEditor="False"
                                                      AllowColumnFiltering="False"
                                                      AllowColumnMoving="False"
                                                      AllowDrop="False"
                                                      AllowSorting="False"
                                                      NavigationStyle="Cell"
                                                      AutoWidth="True"
                                                      ShowIndicator="False"
                                                      EditorShowMode="MouseDownFocused"
                                                      AllowMoveColumnToDropArea="False"
                                                      AutoExpandAllNodes="True"
                                                      IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}"
                                                      AllowChildNodeSourceUpdates="True"
                                                      TreeDerivationMode="HierarchicalDataTemplate">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                                   Command="{Binding Path=EditCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>