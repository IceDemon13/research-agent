<controls:TelemartUserControl x:Class="Telemart.Client.Views.SupplierBill.SupplierBillView"
                              x:Name="CurrentUserControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:business="clr-namespace:Telemart.Client.Business"
                              xmlns:common="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.SupplierBill"
                              DataContext="{client:Container Type=viewModels:SupplierBillViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="800"
                              d:DesignHeight="600"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:SupplierBillViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="DataContext.IsLockedByCurrentEmployee"
                                                 ElementName="CurrentUserControl"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
        <dxmvvm:OpenFileDialogService Title="Выберите документ"
                                      Filter="PDF|*.pdf|Word 97-2003 Document|*.doc|Word Document|*.docx|JPEG|*.jpg|PNG|*.png"
                                      Multiselect="True" />
        <dxmvvm:SaveFileDialogService Filter="XML|*.xml"
                                      DefaultExt="xml" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=BusyIndicatorLayoutGroup, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup VerticalAlignment="Top">
                <dxlc:LayoutGroup Orientation="Vertical"
                                  VerticalAlignment="Stretch">
                    <dxlc:LayoutItem Label="Номер счета">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource ReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Выставлен">
                        <dxe:DateEdit EditValue="{Binding Path=Model.InvoicedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MinValue="{Binding Path=InvoicedOnMinValue, Mode=OneWay}"
                                      MaxValue="{Binding Path=InvoicedOnMaxValue, Mode=OneWay}"
                                      MaskUseAsDisplayFormat="True"
                                      Mask="{x:Static business:DateFormattingRules.DateFormat}"
                                      MaskType="DateTime"
                                      Style="{StaticResource ReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Комментарий"
                                     LabelVerticalAlignment="Top"
                                     VerticalAlignment="Stretch">
                        <dxe:TextEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      MaxHeight="200"
                                      MaxLength="1000"
                                      TextWrapping="Wrap"
                                      AcceptsReturn="True"
                                      AcceptsTab="True"
                                      VerticalContentAlignment="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ReadOnlyConditionsStyle}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <common:SummaryItemsView x:Name="SummaryItemsView"
                                         SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                         LabelColumnWidth="*"
                                         ContentColumnWidth="3*"
                                         Width="300"
                                         VerticalAlignment="Stretch" />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup View="Tabs"
                              VerticalAlignment="Stretch"
                              TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                              TabStyle="{StaticResource LayoutGroupTabStyle}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="SelectedTabChildChanged"
                                           Command="{Binding Path=HandleTabSelectionChangedCommand, Mode=OneWay}"
                                           PassEventArgsToCommand="True" />
                </dxmvvm:Interaction.Behaviors>
                <dxlc:LayoutGroup x:Name="Tab0"
                                  Orientation="Vertical"
                                  ItemSpace="0"
                                  Header="Товары">
                    <dxg:GridControl x:Name="GridControl"
                                     ItemsSource="{Binding Path=Model.Products, Mode=OneWay}"
                                     SelectionMode="Row"
                                     ShowBorder="False">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="ProductName"
                                            Header="Товар"
                                            HeaderToolTip="Товар" />
                            <dxg:GridColumn FieldName="Quantity"
                                            Header="Кол-во"
                                            HeaderToolTip="Количество"
                                            HorizontalHeaderContentAlignment="Center"
                                            FixedWidth="True"
                                            Width="{StaticResource QuantityColumnWidth}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PriceTax"
                                            Header="Цена"
                                            Visible="{Binding Path=Model.Tax, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                            HeaderToolTip="Цена с НДС"
                                            HorizontalHeaderContentAlignment="Right"
                                            FixedWidth="True"
                                            Width="{StaticResource PriceColumnWidth}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                                          MaskSaveLiteral="False"
                                                          IsFloatValue="True"
                                                          AllowDefaultButton="False"
                                                          HorizontalContentAlignment="Right" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Price"
                                            Header="Цена"
                                            HeaderToolTip="Цена без НДС"
                                            Visible="{Binding Path=Model.Tax, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                            HorizontalHeaderContentAlignment="Right"
                                            FixedWidth="True"
                                            Width="{StaticResource PriceColumnWidth}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings MaskType="Numeric"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="C2"
                                                          MaskCulture="{x:Static business:CurrencyFormatingRules.UahCultureInfo}"
                                                          MaskSaveLiteral="False"
                                                          IsFloatValue="True"
                                                          AllowDefaultButton="False"
                                                          HorizontalContentAlignment="Right" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="Tab1"
                                  Orientation="Vertical"
                                  ItemSpace="0"
                                  Header="Файлы">
                    <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}">
                        <dxb:BarButtonItem Content="Обновить"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshDocumentsCommand, Mode=OneWay}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Добавить"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           Command="{Binding Path=AddDocumentCommand, Mode=OneWay}" />
                        <dxb:BarButtonItem Content="Удалить"
                                           Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                           Command="{Binding Path=RemoveDocumentCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, ElementName=DocumentsGridControl}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Печать"
                                           Glyph="{dx:DXImage Image=Print_16x16.png}"
                                           Command="{Binding Path=PrintDocumentCommand, Mode=OneWay}"
                                           CommandParameter="{Binding Path=CurrentItem, ElementName=DocumentsGridControl}" />
                        <dxb:BarButtonItem Content="QR"
                                           ToolTip="QR код на telegram бота для загрузки документов"
                                           Glyph="../../Images/Common/qr.png"
                                           Command="{Binding Path=ShowDocumentsBotQrCommand, Mode=OneWay}"/>
                    </dxb:ToolBarControl>
                    <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl x:Name="DocumentsGridControl"
                                     ItemsSource="{Binding Path=Model.Documents, Mode=OneWay}"
                                     ShowBorder="False"
                                     SelectionMode="None"
                                     dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap">
                        <dxg:GridControl.ShowLoadingPanel>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="RefreshDocumentsCommand.IsExecuting" />
                                <Binding Path="PrintDocumentCommand.IsExecuting" />
                            </MultiBinding>
                        </dxg:GridControl.ShowLoadingPanel>
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Документ"
                                            FieldName="Name" />
                            <dxg:GridColumn Header="Тип"
                                            FieldName="TypeId"
                                            FixedWidth="True"
                                            Width="120">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=DocumentTypes}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Дата"
                                            FieldName="CreatedOn"
                                            FixedWidth="True"
                                            Width="95"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Сотрудник"
                                            FieldName="CreatedBy">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees}"
                                                              ValueMember="Id"
                                                              DisplayMember="DisplayValue" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Model.EmployeeLockName, Mode=OneWay, StringFormat={}Редактирует: {0}}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                            <Binding Path="Model.EmployeeLockId"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:ObjectToBooleanConverter}" />
                            <Binding Path="IsLockedByCurrentEmployee"
                                     Mode="OneWay"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <dxlc:LayoutGroup x:Name="ButtonsLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="IsVisible"
                                     ElementName="BusyIndicatorLayoutGroup"
                                     Converter="{dxmvvm:BooleanNegationConverter}" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource VisibilityBasedOnEnabledButtonStyle}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../Images/CategoryOptions/pencil.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <dx:SimpleButton Content="Обработать"
                                     Command="{Binding Path=ProcessBillCommand, Mode=OneTime}"
                                     Glyph="{StaticResource Lightning16}"
                                     Visibility="{Binding Path=NotLockedAndNewState, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    </dx:SimpleButton>
                    <dx:SimpleButton Content="Отменить"
                                     Command="{Binding Path=CancelBillCommand, Mode=OneTime}"
                                     Glyph="../../Images/Common/canceled.png"
                                     Visibility="{Binding Path=NotLockedAndNewState, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    </dx:SimpleButton>
                    <dx:SimpleButton Content="Завершить"
                                     Command="{Binding Path=CompleteBillCommand, Mode=OneTime}"
                                     Glyph="../../Images/Common/tick.png"
                                     Visibility="{Binding Path=NotLockedAndProcessedState, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    </dx:SimpleButton>
                    <dx:SimpleButton Content="В XML"
                                     Command="{Binding Path=SerializeIntoXmlCommand, Mode=OneTime}"
                                     Glyph="../../Images/Common/xml_exports_16x16.png"
                                     Visibility="{Binding Path=NotLockedAndProcessedState, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    </dx:SimpleButton>
                    <dx:SimpleButton Content="Отменить"
                                     Command="{Binding Path=CancelCompletedCommand, Mode=OneTime}"
                                     Glyph="../../Images/Common/canceled.png"
                                     Visibility="{Binding Path=NotLockedAndNeedStateForCancel, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    </dx:SimpleButton>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup x:Name="BusyIndicatorLayoutGroup"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                    <dxlc:LayoutGroup.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="SaveCommand.IsExecuting" />
                            <Binding Path="LockCommand.IsExecuting" />
                            <Binding Path="ProcessBillCommand.IsExecuting" />
                            <Binding Path="CancelBillCommand.IsExecuting" />
                            <Binding Path="CompleteBillCommand.IsExecuting" />
                        </MultiBinding>
                    </dxlc:LayoutGroup.Visibility>
                    <viewComponents:WaitImage HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="Обработка..." />
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl"
                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                <Binding Path="IsLockedByCurrentEmployee" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                <Binding Path="IsEnabled"
                                         Mode="OneWay"
                                         ElementName="OkButton" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>