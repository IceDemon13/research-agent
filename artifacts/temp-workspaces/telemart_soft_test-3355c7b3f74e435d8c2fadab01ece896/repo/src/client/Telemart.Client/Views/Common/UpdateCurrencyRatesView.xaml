<UserControl x:Class="Telemart.Client.Views.Common.UpdateCurrencyRatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Common"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             DataContext="{client:Container Type=viewModels:UpdateCurrencyRatesViewModel}"
             Width="370"
             Height="520"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:UpdateCurrencyRatesViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneTime}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneTime}" />
        <dxmvvm:CurrentWindowService />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            IsEnabled="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanNegationConverter}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup x:Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Основные курсы"
                                  Orientation="Vertical"
                                  Height="150"
                                  MaxHeight="150"
                                  MinHeight="150"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      ItemSpace="0"
                                      View="GroupBox"
                                      GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl ItemsSource="{Binding Path=ToUahCurrencyTypeRates, Mode=OneWay}"
                                         SelectionMode="None"
                                         SelectedItem="{Binding Path= SelectedToUahCurrencyTypeRate, Mode=TwoWay}"
                                         ShowBorder="False">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="CurrentItemChanged"
                                                       Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="False" />
                                <dxmvvm:EventToCommand EventName="LostFocus"
                                                       Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="False" />
                                <dxmvvm:EventToCommand EventName="GotFocus"
                                                       Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="False" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Name"
                                                Header="Название"
                                                HeaderToolTip="Название курс"
                                                FixedWidth="True"
                                                Width="140"
                                                MinWidth="140"
                                                MaxWidth="140"
                                                AllowEditing="False"
                                                AllowResizing="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False"
                                                HorizontalHeaderContentAlignment="Left">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Курс"
                                                HeaderToolTip="Курс"
                                                AllowSorting="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False"
                                                AllowEditing="True"
                                                ReadOnly="False"
                                                FieldName="ConversionRate"
                                                MaxWidth="80"
                                                Width="80"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                              MaskType="Numeric"
                                                              Mask="###.000000"
                                                              MaskUseAsDisplayFormat="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True"
                                               ShowTotalSummary="False"
                                               ShowIndicator="False"
                                               ShowFixedTotalSummary="False"
                                               ShowAutoFilterRow="False"
                                               ShowSearchPanelMode="Never"
                                               ShowGroupPanel="False"
                                               IsColumnMenuEnabled="False"
                                               AutoWidth="True"
                                               CustomCellAppearance="TableView_CustomCellAppearance"
                                               AllowResizing="True"
                                               AllowEditing="True"
                                               AllowGrouping="False"
                                               NavigationStyle="Cell"
                                               AllowColumnMoving="False"
                                               AllowColumnFiltering="False"
                                               AllowSorting="True"
                                               AllowMoveColumnToDropArea="False">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="ConversionRate"
                                                             Expression="[ConversionRateInitialChanged] = True">
                                            <dx:Format Foreground="{StaticResource DotnetCore}"
                                                       FontWeight="ExtraBold"/>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup View="GroupBox"
                                  Header="Кросс-курсы"
                                  Orientation="Vertical"
                                  GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                                  ItemSpace="0">
                    <dxlc:LayoutGroup Orientation="Vertical"
                                      ItemSpace="0"
                                      View="GroupBox"
                                      GroupBoxStyle="{StaticResource SummaryGroupBoxViewStyle}">
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl ItemsSource="{Binding Path=OtherCurrencyTypeRates, Mode=OneWay}"
                                         SelectionMode="None"
                                         ShowBorder="False">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="GotFocus"
                                                       Command="{Binding Path=HandleSelectionChangedCommand, Mode=OneWay}"
                                                       PassEventArgsToCommand="False" />
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Name"
                                                Header="Название"
                                                HeaderToolTip="Название курс"
                                                FixedWidth="True"
                                                Width="140"
                                                MinWidth="140"
                                                MaxWidth="140"
                                                AllowEditing="False"
                                                AllowResizing="False"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False"
                                                HorizontalHeaderContentAlignment="Left">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Курс"
                                                HeaderToolTip="Курс"
                                                AllowSorting="True"
                                                AllowColumnFiltering="False"
                                                AllowMoving="False"
                                                AllowEditing="True"
                                                FieldName="ConversionRate"
                                                MaxWidth="80"
                                                ReadOnly="False"
                                                Width="80"
                                                MinWidth="80"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                              MaskType="Numeric"
                                                              Mask="##0.000000####################"
                                                              MaskUseAsDisplayFormat="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True"
                                               ShowTotalSummary="False"
                                               ShowIndicator="False"
                                               ShowFixedTotalSummary="False"
                                               ShowAutoFilterRow="False"
                                               ShowSearchPanelMode="Never"
                                               ShowGroupPanel="False"
                                               IsColumnMenuEnabled="False"
                                               AutoWidth="True"
                                               AllowResizing="True"
                                               AllowEditing="True"
                                               CustomCellAppearance="TableView_CustomCellAppearance"
                                               AllowGrouping="False"
                                               AllowColumnMoving="False"
                                               NavigationStyle="Cell"
                                               AllowColumnFiltering="False"
                                               AllowSorting="True"
                                               AllowMoveColumnToDropArea="False">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="ConversionRate"
                                                             Expression="[ConversionRateChanged] = True">
                                            <dx:Format Foreground="{StaticResource DotnetCore}"
                                                       FontWeight="ExtraBold"/>
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneTime}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        HorizontalAlignment="Right" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneTime}"
                        HorizontalAlignment="Right" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</UserControl>