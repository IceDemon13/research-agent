<controls:TelemartUserControl x:Class="Telemart.Client.Views.Dialogs.AddDocumentsView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              mc:Ignorable="d"
                              d:DesignWidth="500"
                              d:DesignHeight="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dxlc:LayoutControl Orientation="Vertical"
                        x:Name="LayoutControl"
                        IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxg:GridControl ItemsSource="{Binding Path=Files}"
                         SelectionMode="None">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="FileName"
                                Header="Файл"
                                HeaderToolTip="Файл"
                                FixedWidth="False"/>
                <dxg:GridColumn FieldName="DocumentTypeId"
                                Header="Тип"
                                Visible="{Binding Path=ShowTypes}"
                                HeaderToolTip="Тип"
                                FixedWidth="True"
                                AllowEditing="True"
                                Width="100">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding Types}"
                                                  ValueMember="Id"
                                                  DisplayMember="DisplayValue"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="DocumentName"
                                Header="Название"
                                HeaderToolTip="Название"
                                FixedWidth="True"
                                Width="150"
                                AllowEditing="True"/>
                <dxg:GridColumn Header="C"
                                HeaderToolTip="Статус"
                                Width="24"
                                FixedWidth="True"
                                HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical"
                                        Margin="0 2 0 0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <dx:DXImage Source="../../Images/Common/tick.png"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding Path=RowData.Row.IsSuccess, Converter={dx:BooleanToVisibilityConverter}}" />
                                <dx:DXImage Source="../../Images/warning.png"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding Path=RowData.Row.ErrorMessage}"
                                            Visibility="{Binding Path=RowData.Row.IsError, Converter={dx:BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView NavigationStyle="Cell"
                               AllowEditing="False"
                               AllowColumnMoving="False"
                               AllowColumnFiltering="False"
                               AllowMoveColumnToDropArea="False"
                               AllowBestFit="True"
                               AllowResizing="True"
                               ShowIndicator="False"
                               AllowSorting="True"
                               AutoWidth="True"
                               IsColumnMenuEnabled="False"
                               AllowGrouping="False"
                               ShowGroupPanel="False">
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom">
            <viewComponents:WaitImage HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      BusyText="Добавление документов..."
                                      Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                <Button Content="OK"
                        Command="{Binding Path=OkCommand, Mode=OneWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:FocusBehavior/>
                    </dxmvvm:Interaction.Behaviors>
                </Button>
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</controls:TelemartUserControl>



