<UserControl x:Class="Telemart.Client.Views.Store.Order.PackList.PackListEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store.Order.PackList"
             DataContext="{client:Container Type=viewModels:PackListEditViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:PackListEditViewModel}}"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="450"
             Height="250"
             Width="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    
    <dx:LoadingDecorator OwnerLock="LoadingContent"
                         IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting}">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}"
                            IsEnabled="{Binding ElementName=WaitImage, Path=IsVisible, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            Padding="8">
            <dxlc:LayoutGroup Orientation="Vertical"
                              Header="Упаковщик"
                              View="GroupBox"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Padding="10">
                <dxlc:LayoutItem Label="Tекущее значение">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      IsReadOnly="True"
                                      EditValue="{Binding Path=CurrentPackagerEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                      AllowNullInput="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новое значение">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      IsReadOnly="{Binding AllowChangePackerAndCollector, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                      EditValue="{Binding Path=SelectedPackagerEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                      AllowNullInput="True"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Vertical"
                              Header="Сборщик"
                              View="GroupBox"
                              GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Padding="10">
                <dxlc:LayoutItem Label="Tекущее значение">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      IsReadOnly="True"
                                      EditValue="{Binding Path=CurrentCollectorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                      AllowNullInput="True"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Новое значение">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                      DisplayMember="Name"
                                      ValueMember="Id"
                                      IsReadOnly="{Binding AllowChangePackerAndCollector, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={dxmvvm:BooleanNegationConverter}}"
                                      EditValue="{Binding Path=SelectedCollectorEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"
                                      AllowNullInput="True"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                <Button Content="Ок"
                        Command="{Binding Path=OkCommand, Mode=OneWay}"
                        IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}" />
                <Button Content="Отмена"
                        Command="{Binding Path=CancelCommand, Mode=OneWay}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>
