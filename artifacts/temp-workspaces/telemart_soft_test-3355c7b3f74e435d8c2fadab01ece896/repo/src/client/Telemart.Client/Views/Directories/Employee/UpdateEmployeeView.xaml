<controls:TelemartUserControl x:Class="Telemart.Client.Views.Directories.Employee.UpdateEmployeeView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:system="clr-namespace:System;assembly=mscorlib"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Employee"
                              xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
                              DataContext="{client:Container Type=viewModels:UpdateEmployeeViewModel}"
                              mc:Ignorable="d"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:UpdateEmployeeViewModel}}"
                              d:DesignWidth="640"
                              d:DesignHeight="430">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Telemart.Client;component/Style/Subdivision.xaml" />
                <ResourceDictionary>
                    <Style x:Key="TableViewStyle"
                           TargetType="dxg:TableView"
                           BasedOn="{StaticResource {x:Type dxg:TableView}}">
                        <Setter Property="ShowGroupPanel"
                                Value="False" />
                        <Setter Property="ShowIndicator"
                                Value="False" />
                        <Setter Property="ShowVerticalLines"
                                Value="False" />
                        <Setter Property="ShowHorizontalLines"
                                Value="False" />
                        <Setter Property="AutoWidth"
                                Value="True" />
                        <Setter Property="EnableImmediatePosting"
                                Value="True" />
                        <Setter Property="AllowColumnFiltering"
                                Value="False" />
                        <Setter Property="AllowGrouping"
                                Value="False" />
                        <Setter Property="IsColumnMenuEnabled"
                                Value="False" />
                        <Setter Property="NavigationStyle"
                                Value="Cell" />
                        <Setter Property="AllowSorting"
                                Value="False" />
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="AllowColumnMoving"
                                Value="False" />
                    </Style>
                    <Style x:Key="ReadOnlyConditionsStyle"
                           TargetType="dxe:BaseEdit">
                        <Setter Property="IsReadOnly"
                                Value="True" />
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsReadOnly"
                                        Value="False" />
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ReadOnlyGridControlStyle"
                           TargetType="dxg:GridControl"
                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                        <Setter Property="Opacity"
                                Value="{StaticResource DisabledElementOpacity}" />
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Mode="OneWay"
                                                  Converter="{converters:BooleanOrMultiValueConverter}">
                                        <Binding Path="IsLockedByCurrentEmployee"
                                                 Mode="OneWay" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Opacity"
                                        Value="{StaticResource EnabledElementOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ReadOnlyTextBoxConditionsStyle"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource ReadOnlyConditionsStyle}">
                    </Style>
                    <Style x:Key="ReadOnlyComboBoxConditionsStyle"
                           TargetType="{x:Type dxe:ComboBoxEdit}"
                           BasedOn="{StaticResource ReadOnlyConditionsStyle}">
                        <Setter Property="AllowDefaultButton"
                                Value="{Binding Path=IsReadOnly, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}, RelativeSource={RelativeSource Self}}" />
                    </Style>
                    <Style x:Key="ReadOnlyListBoxConditionsStyle"
                           TargetType="{x:Type dxe:ListBoxEdit}"
                           BasedOn="{StaticResource ReadOnlyConditionsStyle}">
                    </Style>
                    <Style x:Key="GroupBoxBorderWithNoPaddingStyle"
                           TargetType="dxlc:GroupBox"
                           BasedOn="{StaticResource GroupBoxWithNoPaddingStyle}">
                        <Setter Property="BorderThickness"
                                Value="1" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime }" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutControl.IsEnabled>
                <MultiBinding Mode="OneWay"
                              Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                    <Binding Path="SaveCommand.IsExecuting"
                             Mode="OneWay" />
                    <Binding Path="OkCommand.IsExecuting"
                             Mode="OneWay" />
                    <Binding Path="LockCommand.IsExecuting"
                             Mode="OneWay" />
                </MultiBinding>
            </dxlc:LayoutControl.IsEnabled>
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutGroup View="Tabs"
                                  VerticalAlignment="Stretch"
                                  TabsStyle="{StaticResource LayoutGroupTabsStyle}"
                                  TabStyle="{StaticResource LayoutGroupTabStyle}">
                    <dxlc:LayoutGroup Header="Инфо"
                                      Orientation="Horizontal"
                                      Padding="10">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Contractor/information.png" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Foreground="{Binding Path=(dxe:ValidationService.HasValidationError), Mode=OneWay, ElementName=LayoutControl, Converter={StaticResource BooleanToColorConverter}}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutGroup Orientation="Vertical">
                            <dxlc:LayoutItem Label="ФИО">
                                <dxe:TextEdit Text="{Binding Path=Model.Name, Mode=OneWay}"
                                              Style="{StaticResource ReadOnlyEditorStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Подразделение">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllSubdivisions, Mode=OneWay}"
                                                  EditValue="{Binding Path= Model.SubdivisionId, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                                  DisplayMember="Item.DisplayValue"
                                                  ValueMember="Item.Id"
                                                  Style="{StaticResource ReadOnlyComboBoxConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Отдел">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllDepartments, Mode=OneWay}"
                                                  EditValue="{Binding Path= Model.DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  Style="{StaticResource ReadOnlyComboBoxConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Должность">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Positions, Mode=OneWay}"
                                                  EditValue="{Binding Model.Position, Mode=TwoWay}"
                                                  FilterCondition="Contains"
                                                  ImmediatePopup="True"
                                                  AllowDrop="False"
                                                  ValidateOnTextInput="False"
                                                  IncrementalFiltering="True"
                                                  IsTextEditable="True"
                                                  Style="{StaticResource ReadOnlyComboBoxConditionsStyle}"
                                                  Validate="BaseEditOnValidate" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Логин">
                                <dxe:TextEdit Text="{Binding Path=Model.Login, Mode=OneWay}"
                                              Style="{StaticResource ReadOnlyEditorStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Почта">
                                <dxe:TextEdit Text="{Binding Path=Model.Email, Mode=OneWay}"
                                              Style="{StaticResource ReadOnlyEditorStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Телефон">
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dxe:TextEdit Text="{Binding Path=Model.Phone1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  MaskType="Simple"
                                                  Mask="(000) 000-00-00"
                                                  MaskUseAsDisplayFormat="True"
                                                  MaskSaveLiteral="False"
                                                  Style="{StaticResource ReadOnlyTextBoxConditionsStyle}" />
                                    <dxe:TextEdit Text="{Binding Path=Model.Phone2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  MaskType="Simple"
                                                  Mask="(000) 000-00-00"
                                                  MaskUseAsDisplayFormat="True"
                                                  MaskSaveLiteral="False"
                                                  Style="{StaticResource ReadOnlyTextBoxConditionsStyle}" />
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Skype">
                                <dxe:TextEdit Text="{Binding Path=Model.Skype, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ReadOnlyTextBoxConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Telegram">
                                <dxe:TextEdit Text="{Binding Path=Model.Telegram, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ReadOnlyTextBoxConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Город">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=AllCities, Mode=OneWay}"
                                                  EditValue="{Binding Path= Model.CityId, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id"
                                                  Style="{StaticResource ReadOnlyComboBoxConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Шаблон">
                                <dxe:ButtonEdit EditValue="{Binding Path=ContractorTemplateName, Mode=OneWay, ValidatesOnDataErrors=True}"
                                                AllowDefaultButton="False"
                                                Style="{StaticResource ReadOnlyConditionsStyle}">
                                    <dxe:ButtonInfo GlyphKind="Cancel"
                                                    Command="{Binding DeleteContractorTemplateCommand}"/>
                                    <dxe:ButtonInfo GlyphKind="Plus"
                                                    Command="{Binding SelectContractorTemplateCommand}"/>
                                </dxe:ButtonEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Ключ">
                                <dxe:TextEdit Text="{Binding Path=Model.CardKey, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ReadOnlyTextBoxConditionsStyle}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Блокировать прогу">
                                <dxe:CheckEdit EditValue="{Binding Path=Model.ClientAccessDenied, Mode=TwoWay}"
                                               ToolTip="Блокировать доступ в Telemart.Client"
                                               IsReadOnly="{Binding IsNewOrIsLockedByCurrentEmployee, Converter={dxmvvm:BooleanNegationConverter}}"
                                               Style="{StaticResource ReadOnlyConditionsStyle}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <commonViews:SummaryItemsView SummaryItems="{Binding Path=SummaryItems, Mode=OneWay}"
                                                      LabelColumnWidth="*"
                                                      ContentColumnWidth="1.9*"
                                                      Width="200"
                                                      VerticalAlignment="Top" />
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Права"
                                      Orientation="Horizontal"
                                      Padding="8">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Order/Filter/user_suit.png" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutGroup Header="Роли"
                                          View="GroupBox"
                                          Width="180"
                                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                            <dxg:GridControl ItemsSource="{Binding Path=AllRoles, Mode=OneWay}"
                                             SelectionMode="None"
                                             ShowBorder="False"
                                             Style="{StaticResource ReadOnlyGridControlStyle}">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="IsChecked"
                                                    ReadOnly="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                                    Width="24"
                                                    FixedWidth="True"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    AllowResizing="False"
                                                    AllowEditing="True">
                                        <dxg:GridColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <dxe:CheckEdit IsEnabled="{Binding Path=DataContext.IsLockedByCurrentEmployee, Mode=OneWay, ElementName=LayoutControl}"
                                                               EditValue="{Binding Path=DataContext.RoleCheckAllState, Mode=TwoWay, ElementName=LayoutControl}"
                                                               Margin="0,-5" />
                                            </DataTemplate>
                                        </dxg:GridColumn.HeaderTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Роль"
                                                    FieldName="Item"
                                                    ReadOnly="True" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView Style="{StaticResource TableViewStyle}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                                   Command="{Binding Path=RoleChangedCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Header="Операции"
                                          View="GroupBox"
                                          Orientation="Vertical"
                                          ItemSpace="0"
                                          GroupBoxStyle="{StaticResource GroupBoxBorderWithNoPaddingStyle}">
                            <dxb:ToolBarControl IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}"
                                                Style="{StaticResource SmallToolBarStyle}">
                                <dxb:BarButtonItem Content="Добавить"
                                                   Glyph="{dx:DXImage Image=Add_16x16.png}"
                                                   Command="{Binding Path=AddOperationCommand, Mode=OneWay}" />
                                <dxb:BarButtonItem Content="Удалить"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                                   Command="{Binding Path=DeleteOperationCommand, Mode=OneWay}"
                                                   CommandParameter="{Binding Path=CurrentItem, Mode=OneWay, ElementName=EmployeeOperationsGridControl}" />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="EmployeeOperationsGridControl"
                                             ItemsSource="{Binding Path=Model.EmployeeOperations, Mode=OneWay}"
                                             SelectionMode="None"
                                             ShowBorder="False"
                                             Style="{StaticResource ReadOnlyGridControlStyle}">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:LayoutSerializationBehavior FileName="update_employee_view_operations.xml" />
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Операция"
                                                    FieldName="Name"
                                                    AllowEditing="False" />
                                    <dxg:GridColumn Header="Описание"
                                                    FieldName="Description"
                                                    AllowEditing="False" />
                                    <dxg:GridColumn Header="Действие"
                                                    FieldName="Allow"
                                                    AllowEditing="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings IsTextEditable="False">
                                                <dxe:ComboBoxEditSettings.Items>
                                                    <dxe:CustomItem  DisplayText="Разрешить">
                                                        <dxe:CustomItem.EditValue>
                                                            <system:Boolean>
                                                                True
                                                            </system:Boolean>
                                                        </dxe:CustomItem.EditValue>
                                                    </dxe:CustomItem>
                                                    <dxe:CustomItem  DisplayText="Запретить">
                                                        <dxe:CustomItem.EditValue>
                                                            <system:Boolean>
                                                                False
                                                            </system:Boolean>
                                                        </dxe:CustomItem.EditValue>
                                                    </dxe:CustomItem>
                                                </dxe:ComboBoxEditSettings.Items>
                                            </dxe:ComboBoxEditSettings>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AllowEditing="True"
                                                   ShowVerticalLines="True"
                                                   ShowHorizontalLines="True"
                                                   Style="{StaticResource TableViewStyle}">
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Подразделения">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Order/Filter/building_go.png" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxg:GridControl ItemsSource="{Binding Path=AllSubdivisions, Mode=OneWay}"
                                         SelectionMode="None"
                                         ShowBorder="False"
                                         Style="{StaticResource ReadOnlyGridControlStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="IsChecked"
                                                ReadOnly="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                                Width="24"
                                                FixedWidth="True"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowResizing="False"
                                                AllowEditing="True">
                                    <dxg:GridColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit IsEnabled="{Binding Path=DataContext.IsLockedByCurrentEmployee, Mode=OneWay, ElementName=LayoutControl}"
                                                           EditValue="{Binding Path=DataContext.SubdivisionCheckAllState, Mode=TwoWay, ElementName=LayoutControl}"
                                                           Margin="0,-5" />
                                        </DataTemplate>
                                    </dxg:GridColumn.HeaderTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Подразделение"
                                                FieldName="Item.DisplayValue"
                                                ReadOnly="True" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView Style="{StaticResource TableViewStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                               Command="{Binding Path=SubdivisionChangedCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Склады"
                                      Orientation="Vertical">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/Order/Filter/house.png" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxg:GridControl ItemsSource="{Binding Path=AllWarehouses, Mode=OneWay}"
                                         SelectionMode="None"
                                         ShowBorder="False"
                                         Style="{StaticResource ReadOnlyGridControlStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="IsChecked"
                                                ReadOnly="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                                Width="24"
                                                FixedWidth="True"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowResizing="False"
                                                AllowEditing="True">
                                    <dxg:GridColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit IsEnabled="{Binding Path=DataContext.IsLockedByCurrentEmployee, Mode=OneWay, ElementName=LayoutControl}"
                                                           EditValue="{Binding Path=DataContext.WarehouseCheckAllState, Mode=TwoWay, ElementName=LayoutControl}"
                                                           Margin="0,-5" />
                                        </DataTemplate>
                                    </dxg:GridColumn.HeaderTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Склад"
                                                FieldName="Item.Name"
                                                ReadOnly="True" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView Style="{StaticResource TableViewStyle}"
                                               ShowSearchPanelMode="Always"
                                               SearchPanelHighlightResults="True">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                               Command="{Binding Path=WarehouseChangedCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Кассы">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/cheque.png" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxg:GridControl ItemsSource="{Binding Path=AllCashboxes, Mode=OneWay}"
                                         SelectionMode="None"
                                         ShowBorder="False"
                                         Style="{StaticResource ReadOnlyGridControlStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="IsChecked"
                                                ReadOnly="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                                Width="24"
                                                FixedWidth="True"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowResizing="False"
                                                AllowEditing="True">
                                    <dxg:GridColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit IsEnabled="{Binding Path=DataContext.IsLockedByCurrentEmployee, Mode=OneWay, ElementName=LayoutControl}"
                                                           EditValue="{Binding Path=DataContext.CashboxCheckAllState, Mode=TwoWay, ElementName=LayoutControl}"
                                                           Margin="0,-5" />
                                        </DataTemplate>
                                    </dxg:GridColumn.HeaderTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Касса"
                                                FieldName="Item.Name"
                                                ReadOnly="True" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView Style="{StaticResource TableViewStyle}"
                                               ShowSearchPanelMode="Always"
                                               SearchPanelHighlightResults="True">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                               Command="{Binding Path=CashboxChangedCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Категории">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/ProductsCatalog/folder_table_32x32.png"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxlc:LayoutGroup Orientation="Vertical"
                                          ItemSpace="0">
                            <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                                IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                                <dxb:BarButtonItem Content="Развернуть"
                                                   ToolTip="{Binding Path=Content, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                   Glyph="../../../Images/Actions/toggle_expand_16_16.png"
                                                   Command="{Binding Path=View.Commands.(dxg:TreeListViewCommands.ExpandAllNodes), Mode=OneTime, ElementName=GridControl}" />
                                <dxb:BarButtonItem Content="Свернуть"
                                                   ToolTip="{Binding Path=Content, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                   Glyph="../../../Images/Actions/toggle_16_16.png"
                                                   Command="{Binding Path=View.Commands.(dxg:TreeListViewCommands.CollapseAllNodes), Mode=OneTime, ElementName=GridControl}" />
                            </dxb:ToolBarControl>
                            <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                            <dxg:GridControl x:Name="GridControl"
                                             ItemsSource="{Binding Path=AllCategories, Mode=OneWay}"
                                             SelectionMode="Row"
                                             ShowBorder="False"
                                             ItemsSourceChanged="GridControlOnItemsSourceChanged">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="NameWithId" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TreeListView x:Name="TreeListView"
                                                      TreeDerivationMode="Selfreference"
                                                      ShowColumnHeaders="False"
                                                      ShowCheckboxes="True"
                                                      CheckBoxFieldName="Selected"
                                                      AllowRecursiveNodeChecking="True"
                                                      KeyFieldName="Id"
                                                      ParentFieldName="ParentId"
                                                      NavigationStyle="Row"
                                                      FilterMode="Extended"
                                                      ShowSearchPanelMode="Always"
                                                      SearchPanelHighlightResults="True"
                                                      ExpandNodesOnFiltering="True"
                                                      AllowEditing="False"
                                                      AllowBestFit="True"
                                                      AllowSorting="False"
                                                      AllowDrop="False"
                                                      ShowVerticalLines="False"
                                                      ShowHorizontalLines="False"
                                                      FetchSublevelChildrenOnExpand="False"
                                                      ShowIndicator="False"
                                                      TreeLineStyle="Solid"
                                                      AutoWidth="True"
                                                      ShowFilterPanelMode="Never"
                                                      AutoExpandAllNodes="False"
                                                      ShowExpandButtons="True"
                                                      UseEvenRowBackground="False">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="NodeCheckStateChanged"
                                                                   Command="{Binding Path=HandleNodeCheckStateChangedCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                        <dxg:TreeListView.FormatConditions>
                                            <dxg:FormatCondition Expression="[IsParent] = FALSE AND [IsBrand] = False">
                                                <dx:Format FontStyle="Italic" />
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition Expression="[Active] &lt; 0.5">
                                                <dx:Format Foreground="DarkGray" />
                                            </dxg:FormatCondition>
                                            <dxg:FormatCondition Expression="[Active] = 0">
                                                <dx:Format TextDecorations="Strikethrough" />
                                            </dxg:FormatCondition>
                                        </dxg:TreeListView.FormatConditions>
                                    </dxg:TreeListView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Header="Учетки"
                                      Orientation="Vertical"
                                      ItemSpace="0"
                                      Padding="0"
                                      Margin="0">
                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="../../../Images/Common/group_key.png" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>
                        <dxb:ToolBarControl Style="{StaticResource SmallToolBarStyle}"
                                            IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                            <dxb:BarButtonItem Content="Добавить"
                                               Glyph="{dx:DXImage Image=Add_16x16.png}"
                                               Command="{Binding CreateAccountCommand, Mode=OneWay}"
                                               IsEnabled="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay}">
                            </dxb:BarButtonItem>
                        </dxb:ToolBarControl>
                        <StackPanel Style="{StaticResource SeparatorStackPanelStyle}" />
                        <dxg:GridControl ItemsSource="{Binding Path=EmployeeAccounts, Mode=OneWay}"
                                         SelectionMode="None"
                                         ShowBorder="False"
                                         Style="{StaticResource ReadOnlyGridControlStyle}">
                            <dxmvvm:Interaction.Behaviors>
                                <behaviors:CopyCurrentCellToClipboardBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="IsChecked"
                                                ReadOnly="{Binding Path=IsLockedByCurrentEmployee, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                                Width="24"
                                                FixedWidth="True"
                                                HorizontalHeaderContentAlignment="Center"
                                                AllowResizing="False"
                                                AllowEditing="True">
                                    <dxg:GridColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit IsEnabled="{Binding Path=DataContext.IsLockedByCurrentEmployee, Mode=OneWay, ElementName=LayoutControl}"
                                                           EditValue="{Binding Path=DataContext.AccountCheckAllState, Mode=TwoWay, ElementName=LayoutControl}"
                                                           Margin="0,-5" />
                                        </DataTemplate>
                                    </dxg:GridColumn.HeaderTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Сайт"
                                                FieldName="Item.Account"
                                                ReadOnly="True">
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="Логин"
                                                FieldName="Item.Login"
                                                ReadOnly="True" />
                                <dxg:GridColumn Header="Пароль"
                                                FieldName="Item.DisplayPassword"
                                                ReadOnly="True" >
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView Style="{StaticResource TableViewStyle}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="CellValueChanged"
                                                               Command="{Binding Path=AccountChangedCommand, Mode=OneWay}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  Visibility="{Binding Path=IsVisible, Mode=OneWay, ElementName=WaitImage, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
                    <Button Content="Редактировать"
                            Command="{Binding Path=LockCommand, Mode=OneWay}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource {x:Type Button}}"
                                   TargetType="{x:Type Button}">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay" />
                                                <Binding Path="AllowModulesAccess"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="/Images/CategoryOptions/pencil.png"
                                                Stretch="Fill"
                                                Width="16"
                                                Height="16" />
                                    <TextBlock Text="{Binding Mode=OneWay}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <dx:SimpleButton x:Name="CopyButton"
                                     Glyph="../../../Images/Order/Menu/copy.png"
                                     Width="24"
                                     MinWidth="24"
                                     Margin="0,0,-4,0"
                                     Command="{Binding CopyEmployeeCommand, Mode=OneTime}"
                                     Visibility="{Binding IsLockedByCurrentEmployee, Mode=OneWay,  Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    </dx:SimpleButton>
                </dxlc:LayoutGroup>
                <viewComponents:WaitImage x:Name="WaitImage"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Сохранение...">
                    <viewComponents:WaitImage.Visibility>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter ToVisibility=True}">
                            <Binding Path="OkCommand.IsExecuting" />
                            <Binding Path="SaveCommand.IsExecuting" />
                        </MultiBinding>
                    </viewComponents:WaitImage.Visibility>
                </viewComponents:WaitImage>
                <dxlc:LayoutGroup HorizontalAlignment="Right">
                    <Button x:Name="OkButton"
                            Content="ОК"
                            Command="{Binding Path=OkCommand, Mode=OneTime}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled"
                                        Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanOrMultiValueConverter}">
                                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                                         Mode="OneWay"
                                                         ElementName="LayoutControl" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Mode="OneWay"
                                                          Converter="{converters:BooleanAndMultiValueConverter}">
                                                <Binding Path="IsLockedByCurrentEmployee"
                                                         Mode="OneWay"
                                                         Converter="{dxmvvm:BooleanNegationConverter}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Сохранить"
                            Command="{Binding Path=SaveCommand, Mode=OneTime}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, ElementName=OkButton}">
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneTime}">
                    </Button>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>

</controls:TelemartUserControl>