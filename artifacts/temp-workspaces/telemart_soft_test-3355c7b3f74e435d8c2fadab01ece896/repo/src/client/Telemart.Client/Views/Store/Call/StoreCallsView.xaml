                                                        <Style TargetType="dxg:GridColumn"
                                                               BasedOn="{StaticResource GeneralGridColumnStyle}">
                                                        </Style>
                                                    </dxg:GridControl.Resources>
                                                    <dxg:GridControl.Columns>
                                                        <dxg:GridColumn FieldName="Name"
                                                                        Header="Название"
                                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                                        AllowResizing="False"
                                                                        FixedWidth="False">
                                                            <dxg:GridColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <dxe:TextEdit x:Name="PART_Editor">
                                                                        <dxe:TextEdit.Style>
                                                                            <Style TargetType="{x:Type dxe:TextEdit}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True"
                                                                                                 Binding="{Binding Path=RowData.Row.ParentId, Converter={dxmvvm:ObjectToBooleanConverter Inverse=True}}">
                                                                                        <Setter Property="FontWeight"
                                                                                                Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </dxe:TextEdit.Style>
                                                                    </dxe:TextEdit>
                                                                </DataTemplate>
                                                            </dxg:GridColumn.CellTemplate>
                                                        </dxg:GridColumn>
                                                        <dxg:GridColumn FieldName="Position"
                                                                        Header="Position"
                                                                        Visible="False"
                                                                        SortOrder="Ascending" />
                                                    </dxg:GridControl.Columns>
                                                    <dxg:GridControl.View>
                                                        <dxg:TreeListView KeyFieldName="Id"
                                                                          ParentFieldName="ParentId"
                                                                          AutoWidth="True"
                                                                          AutoExpandAllNodes="True"
                                                                          ShowIndicator="False"
                                                                          UseEvenRowBackground="True"
                                                                          AlternationCount="2"
                                                                          AlternateRowBackground="{StaticResource AlternateRowBackgroundBrush}" />
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
