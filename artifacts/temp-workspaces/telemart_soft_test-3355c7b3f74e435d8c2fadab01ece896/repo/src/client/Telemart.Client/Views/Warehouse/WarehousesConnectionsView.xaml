<UserControl x:Class="Telemart.Client.Views.Warehouse.WarehousesConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Warehouse.Connections"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors" 
             xmlns:dxgn="http://schemas.devexpress.com/winfx/2008/xaml/gantt" 
             xmlns:business="clr-namespace:Telemart.Client.Business"
             DataContext="{client:Container Type=viewModels:WarehousesConnectionsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type=viewModels:WarehousesConnectionsViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Top">
            <dxb:BarManager>
                <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GanttControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxdo:DockLayoutManager>
            <dxdo:LayoutGroup Orientation="Horizontal"
                              Padding="0"
                              Margin="0">
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowContextMenu="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="True"
                                  FloatOnDoubleClick="False"
                                  Style="{StaticResource PanelStyle}">
                    <dxgn:GanttControl x:Name="GanttControl"
                                       ItemsSource="{Binding Path=Connections, Mode=OneWay}"
                                       ShowBorder="False"
                                       SelectionMode="None"
                                       DesignTimeDataSourceRowCount="16"
                                       DesignTimeUseDistinctSampleValues="True">
                        <dxgn:GanttControl.ShowLoadingPanel>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="RefreshCommand.IsExecuting" />
                            </MultiBinding>
                        </dxgn:GanttControl.ShowLoadingPanel>
                        <dxgn:GanttControl.Columns>
                            <dxgn:GanttColumn FieldName="FromWarehouseId"
                                              Header="Отправитель"
                                              AllowBestFit="True">
                                <dxgn:GanttColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Warehouses}"
                                                              ValueMember="Id"
                                                              DisplayMember="DisplayValue"/>
                                </dxgn:GanttColumn.EditSettings>
                            </dxgn:GanttColumn>
                            <dxgn:GanttColumn FieldName="ToWarehouseId"
                                              Header="Получатель"
                                              AllowBestFit="True">
                                <dxgn:GanttColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Warehouses}"
                                                              ValueMember="Id"
                                                              DisplayMember="DisplayValue"/>
                                </dxgn:GanttColumn.EditSettings>
                            </dxgn:GanttColumn>
                            <dxgn:GanttColumn BindTo="StartDate"
                                              Header="Создание"
                                              FixedWidth="True"
                                              Width="90"
                                              AllowBestFit="True">
                                <dxgn:GanttColumn.EditSettings>
                                    <dxe:DateEditSettings MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxgn:GanttColumn.EditSettings>
                            </dxgn:GanttColumn>
                            <dxgn:GanttColumn BindTo="FinishDate"
                                              Header="Принятие"
                                              FixedWidth="True"
                                              Width="90"
                                              AllowBestFit="True">
                                <dxgn:GanttColumn.EditSettings>
                                    <dxe:DateEditSettings MaskUseAsDisplayFormat="True"
                                                          Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                          MaskType="DateTime" />
                                </dxgn:GanttColumn.EditSettings>
                            </dxgn:GanttColumn>
                            <dxgn:GanttColumn FieldName="Weight"
                                              Header="Сложность"
                                              FixedWidth="True"
                                              Width="70">
                                <dxgn:GanttColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxgn:GanttColumn.EditSettings>
                            </dxgn:GanttColumn>
                        </dxgn:GanttControl.Columns>
                        <dxgn:GanttControl.View>
                            <dxgn:GanttView AutoWidth="True"
                                            ChildNodesPath="Connections"
                                            TreeDerivationMode="ChildNodesSelector"
                                            StartDateMapping="StartDate"
                                            FinishDateMapping="EndDate"
                                            AllowEditing="False"
                                            NavigationStyle="Cell"
                                            ShowIndicator="False"
                                            ShowAutoFilterRow="False"
                                            ShowFixedTotalSummary="False"
                                            IsTotalSummaryMenuEnabled="False"
                                            ShowTotalSummary="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           PassEventArgsToCommand="False"
                                                           Command="{Binding EditRoutesCommand, Mode=OneWay}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=GanttControl}"/>
                                </dxmvvm:Interaction.Behaviors>
                            </dxgn:GanttView>
                        </dxgn:GanttControl.View>
                    </dxgn:GanttControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="Поиск"
                                  ItemWidth="340"
                                  MinWidth="340"
                                  MaxWidth="500"
                                  AllowClose="False"
                                  AllowDrag="False"
                                  AllowDock="True"
                                  AutoHidden="True"
                                  FloatOnDoubleClick="False"
                                  IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GanttControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                  behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <dxlc:LayoutControl x:Name="FilterLayoutControl"
                                            Orientation="Vertical"
                                            ItemStyle="{StaticResource LayoutItemStyle}">
                            <dxlc:LayoutItem Label="Создание">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Order/Filter/calendar.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:DateEdit EditValue="{Binding Path=DateStart, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                              MaskUseAsDisplayFormat="True"
                                              Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                              MaskType="DateTime"  >
                                    <dxe:DateEdit.StyleSettings>
                                        <dxe:DateEditNavigatorWithTimePickerStyleSettings/>
                                    </dxe:DateEdit.StyleSettings>
                                </dxe:DateEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Отправитель">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Order/Filter/house.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                  EditValue="{Binding Path=WarehouseFromId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Получатель">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Order/Filter/house.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                  EditValue="{Binding Path=WarehouseToId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                  DisplayMember="DisplayValue"
                                                  ValueMember="Id">
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>

                            <dxlc:LayoutItem Label="Макс. кол-во транзитов">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Source="../../Images/Order/Filter/calendar.png"
                                                        Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <dxe:TextEdit EditValue="{Binding Path=MaxTransitCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal" />
                            <dxlc:LayoutItem Label="Маршрутов">
                                <dxlc:LayoutItem.LabelTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <dx:DXImage Style="{StaticResource ImageStyle}" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxlc:LayoutItem.LabelTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=Connections.Count, Mode=OneWay}"
                                               FontWeight="Bold" />
                                    <TextBlock Text=" шт." />
                                </StackPanel>
                            </dxlc:LayoutItem>
                            <dxlc:LayerSeparator Kind="Horizontal" />
                            <dxb:ToolBarControl GlyphSize="Small">
                                <dxb:BarButtonItem Content="Применить"
                                                   Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                   GlyphAlignment="Left" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItem Content="Отмена"
                                                   Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                   Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                   GlyphAlignment="Left" />
                            </dxb:ToolBarControl>
                        </dxlc:LayoutControl>
                    </ScrollViewer>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>

</UserControl>
