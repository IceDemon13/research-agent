<UserControl x:Class="Telemart.Client.Views.Service.ServiceRequests.Create.SelectOrderPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceRequests.Create"
             DataContext="{client:Container Type=viewModels:SelectOrderPageViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:SelectOrderPageViewModel}}"
             d:DesignWidth="600"
             d:DesignHeight="280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/Contractor.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <DockPanel>
        <dx:DialogFooter>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <viewComponents:WaitImage VerticalAlignment="Center"
                                          Visibility="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxco:WizardButton Content="Далее"
                                   dxco:Wizard.IsButtonNext="True">
                    <dxco:WizardButton.IsEnabled>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                            <Binding Path="(dxe:ValidationService.HasValidationError)"
                                     ElementName="LayoutControl" />
                            <Binding Path="IsLongOperationInProgress" />
                        </MultiBinding>
                    </dxco:WizardButton.IsEnabled>
                </dxco:WizardButton>
                <dxco:WizardButton Content="Отмена"
                                   dxco:Wizard.IsButtonCancel="True" />
            </StackPanel>
        </dx:DialogFooter>
        <ContentPresenter DockPanel.Dock="Top"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource WizardHeaderTemplate}" />
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            dxe:ValidationService.IsValidationContainer="True"
                            IsEnabled="{Binding Path=IsLongOperationInProgress, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}">
            <dxlc:LayoutGroup  Orientation="Vertical"
                               VerticalAlignment="Stretch">
                <dxlc:LayoutItem Label="Искать по">
                    <dxe:ListBoxEdit EditValue="{Binding Path=Model.SearchMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ItemsSource="{Binding Path=SearchModes, Mode=OneWay}"
                                     DisplayMember="Key"
                                     ValueMember="Value"
                                     ShowBorder="False">
                        <dxe:ListBoxEdit.ItemsPanel>
                            <ItemsPanelTemplate>
                                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                                  ItemSpace="8" />
                            </ItemsPanelTemplate>
                        </dxe:ListBoxEdit.ItemsPanel>
                        <dxe:ListBoxEdit.StyleSettings>
                            <dxe:RadioListBoxEditStyleSettings />
                        </dxe:ListBoxEdit.StyleSettings>
                    </dxe:ListBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Заказ">
                    <dxlc:LayoutItem.Visibility>
                        <Binding Path="Model.SearchMode"
                                 Mode="OneWay"
                                 Converter="{converters:IsEqualConverter ToVisibility=True}"
                                 ConverterParameter="{x:Static viewModels:SearchOrderMode.OrderNumber}" />
                    </dxlc:LayoutItem.Visibility>
                    <dxe:TextEdit EditValue="{Binding Path=Model.SearchOrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  MaskType="Numeric"
                                  Mask="f0"
                                  MaskUseAsDisplayFormat="True"></dxe:TextEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutGroup.Visibility>
                        <Binding Path="Model.SearchMode"
                                 Mode="OneWay"
                                 Converter="{converters:IsEqualConverter ToVisibility=True}"
                                 ConverterParameter="{x:Static viewModels:SearchOrderMode.SerialNumber}" />
                    </dxlc:LayoutGroup.Visibility>
                    <dxlc:LayoutItem Label="SN">
                        <dxe:TextEdit EditValue="{Binding Path=Model.SearchSerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"></dxe:TextEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Клиент">
                        <dxe:ComboBoxEdit EditValue="{Binding Path=Model.SearchContractorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                                          ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                          ValueMember="Id"
                                          DisplayMember="Name"
                                          NullValueButtonPlacement="EditBox"
                                          Height="22"
                                          ItemTemplate="{StaticResource ContractorItemTemplate}"
                                          Style="{StaticResource SearchableComboBoxStyle}"></dxe:ComboBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Товар">
                        <dxe:ButtonEdit EditValue="{Binding Path=Model.SearchProductName, Mode=OneWay, ValidatesOnDataErrors=True}"
                                        IsTextEditable="False"
                                        AllowDefaultButton="False">
                            <dxe:ButtonInfo ButtonKind="Simple"
                                            GlyphKind="Cancel"
                                            Command="{Binding Path=ClearProductCommand, Mode=OneTime}" />
                            <dxe:ButtonInfo ButtonKind="Simple"
                                            GlyphKind="Regular"
                                            Command="{Binding Path=SelectProductCommand, Mode=OneTime}" />
                        </dxe:ButtonEdit>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>
</UserControl>
