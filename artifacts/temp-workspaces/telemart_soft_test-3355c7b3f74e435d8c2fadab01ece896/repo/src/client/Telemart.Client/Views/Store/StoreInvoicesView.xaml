<UserControl x:Name="CurrentControl"
             x:Class="Telemart.Client.Views.Store.StoreInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:store="clr-namespace:Telemart.Client.Views.Store"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:StoreInvoicesViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="768"
             d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance Type=viewModels:StoreInvoicesViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/InvoiceState.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CarryType.xaml" />
                <ResourceDictionary>
                    <Style TargetType="dxg:GridColumn">
                        <Setter Property="AllowEditing"
                                Value="False" />
                        <Setter Property="FixedWidth"
                                Value="True" />
                        <Setter Property="ShowInColumnChooser"
                                Value="True" />
                        <Setter Property="HorizontalHeaderContentAlignment"
                                Value="Center" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <dxb:BarManager Grid.Row="0">
            <dxb:ToolBarControl Height="Auto"
                                AllowQuickCustomization="False"
                                AllowCustomizationMenu="False">
                <dxb:ToolBarControl.IsEnabled>
                    <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                        <Binding Path="RefreshCommand.IsExecuting"
                                 Mode="OneWay"
                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                    </MultiBinding>
                </dxb:ToolBarControl.IsEnabled>
                <dxb:BarButtonItem Content="Обновить"
                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                   Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                   KeyGesture="F5" />
                <dxb:BarButtonItem Content="Колонки"
                                   LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                   Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                   Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                   CommandTarget="{Binding ElementName=InvoicesGrid, Path=View}"
                                   KeyGesture="F6" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarSplitButtonItem Content="Создать"
                                        GlyphAlignment="Top"
                                        LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                        Glyph="{dx:DXImage Image=Add_16x16.png}"
                                        Command="{Binding Path=CreateInvoiceCommand, Mode=OneWay}"
                                        IsVisible="{Binding Path=IsAddAllowed, Mode=OneWay}"
                                        KeyGesture="Insert">
                    <dxb:BarSplitButtonItem.PopupControl>
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Возврат"
                                               Glyph="../../Images/Common/arrow_redo16x16.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               IsEnabled="{Binding Path=CanCreateReturnInvoice, Mode=OneWay, ValidatesOnDataErrors=True}"
                                               Command="{Binding DocumentCommands.ShowCreateReturnInvoiceCommand}"
                                               CommandParameter="{Binding Path=SelectedInvoice.Id, Mode=OneWay}" />
                        </dxb:PopupMenu>
                    </dxb:BarSplitButtonItem.PopupControl>
                </dxb:BarSplitButtonItem>
                <dxb:BarSplitButtonItem Content="Изменить"
                                        LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                        Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                        GlyphAlignment="Top"
                                        Command="{Binding EditCommand}"
                                        CommandParameter="{Binding Path=View.FocusedRow, ElementName=InvoicesGrid}"
                                        IsVisible="{Binding Path=IsEditAllowed, Mode=OneWay}"
                                        KeyGesture="F2">
                    <dxb:BarSplitButtonItem.PopupControl>
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Логистику"
                                               Glyph="../../Images/Common/calendar_edit.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Command="{Binding Path=EditInvoiceLogisticsCommand, Mode=OneTime}"
                                               CommandParameter="{Binding Path=SelectedInvoice, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Курс"
                                               Glyph="../../Images/Common/money_dollar.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               IsVisible="{Binding SetCurrencyRateAllowed}"
                                               Command="{Binding Path=SetCurrencyRateCommand, Mode=OneTime}"
                                               CommandParameter="{Binding Path=SelectedInvoice, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Склад"
                                               Glyph="../../../Images/Order/Filter/house.png"
                                               BarItemDisplayMode="ContentAndGlyph"
                                               GlyphAlignment="Top"
                                               Command="{Binding Path=EditInvoiceWarehouseCommand, Mode=OneTime}"
                                               CommandParameter="{Binding Path=SelectedInvoice, Mode=OneWay}"/>
                        </dxb:PopupMenu>
                    </dxb:BarSplitButtonItem.PopupControl>
                </dxb:BarSplitButtonItem>
                <dxb:BarButtonItem Content="Удалить"
                                   IsEnabled="False"
                                   IsVisible="False"
                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                   Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                   KeyGesture="Delete" />
                <dxb:BarButtonItem Content="Сверить неск."
                                   ToolTip="Сверить несколько"
                                   LargeGlyph="/Images/Common/table_insert.png"
                                   Command="{Binding Path=MassInvoiceAcceptCommand, Mode=OneTime}" />
                <dxb:BarSubItem Content="Бюджет"
                                ToolTip="Инструменты"
                                IsVisible="{Binding Path=InvoiceBudgetsTabVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                LargeGlyph="../../Images/Common/session_idle_time.png"
                                GlyphAlignment="Top"
                                BarItemDisplayMode="ContentAndGlyph">
                    <dxb:BarButtonItem Content="Общий"
                                       ToolTip="Общий бюджет по компании"
                                       Glyph="../../Images/Common/page.png"
                                       Command="{Binding Path=EditInvoiceBudgetsCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="По категориям"
                                       ToolTip="Бюджет по категориям"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="../../Images/CategoryOptions/folder.png"
                                       Command="{Binding Path=EditInvoiceCategoryBudgetsCommand, Mode=OneTime}" />
                </dxb:BarSubItem>
                
                <dxb:BarSubItem Content="Инстр."
                                ToolTip="Инструменты"
                                LargeGlyph="pack://application:,,,/Telemart.Client;component/Images/Common/setting_tools_32x32.png"
                                Glyph="pack://application:,,,/Telemart.Client;component/Images/Common/setting_tools_16x16.png"
                                GlyphAlignment="Top"
                                BarItemDisplayMode="ContentAndGlyph">
                    <dxb:BarButtonItem Content="Печать SN"
                                       ToolTip="Печать SN"
                                       Glyph="{dx:DXImage Image=Printer_16x16.png}"
                                       Command="{Binding Path=PrintSnCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Печать нашего ШК"
                                       BarItemDisplayMode="ContentAndGlyph"
                                       Glyph="../../Images/Common/barcode_16x16.png"
                                       Command="{Binding Path=PrintOurBarcodeCommand, Mode=OneTime}" />
                </dxb:BarSubItem>
                <dxb:BarItemSeparator />
                <controls:WikiBarButtonItem />
            </dxb:ToolBarControl>
        </dxb:BarManager>
        <dxdo:DockLayoutManager Grid.Row="1">
            <dxdo:LayoutGroup>
                <dxdo:LayoutPanel AllowActivate="False"
                                  AllowClose="False"
                                  AllowContextMenu="False"
                                  AllowDock="False"
                                  AllowDrag="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  AllowMaximize="False"
                                  AllowMinimize="False"
                                  AllowMove="False"
                                  AllowRestore="False"
                                  AllowRename="False"
                                  AllowSizing="False"
                                  FloatOnDoubleClick="False">
                    <dxg:GridControl x:Name="InvoicesGrid"
                                     ItemsSource="{Binding Path=Invoices}"
                                     SelectedItem="{Binding Path=SelectedInvoice}"
                                     ShowLoadingPanel="{Binding Path=IsLongOperationInProgress}"
                                     SelectionMode="None"
                                     CurrentItem="{Binding Path=CurrentInvoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ShowBorder="False"
                                     AutoExpandAllGroups="True">
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:LayoutSerializationBehavior FileName="invoices_10.xml" />
                            <behaviors:AutoUpdateBehaviour Interval="00:01:00"/>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Номер"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="Id"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="False"
                                            AllowColumnFiltering="False"
                                            SortIndex="2"
                                            SortOrder="Descending"
                                            MinWidth="50"
                                            Width="60"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Получение"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="DateGet"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            GroupIndex="0"
                                            GroupInterval="Date"
                                            AllowBestFit="False"
                                            SortIndex="0"
                                            SortOrder="Ascending"
                                            AllowColumnFiltering="True"
                                            MinWidth="100"
                                            Width="100"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          Mask="dd.MM.yyyy HH:mm"
                                                          MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Прибытие"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="DateArrive"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            GroupInterval="Date"
                                            AllowBestFit="False"
                                            AllowColumnFiltering="True"
                                            MinWidth="100"
                                            Width="100"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                          Mask="dd.MM.yyyy HH:mm"
                                                          MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Поставщик"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="SupplierId"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            SortIndex="1"
                                            SortOrder="Ascending"
                                            FixedWidth="False"
                                            MinWidth="140"
                                            Width="140"
                                            AllowAutoFilter="True"
                                            HorizontalHeaderContentAlignment="Left">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Contractors, Mode=OneWay}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Склад"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="WarehouseId"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            FixedWidth="True"
                                            MinWidth="110"
                                            Width="110"
                                            AllowAutoFilter="True"
                                            HorizontalHeaderContentAlignment="Left">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Warehouses, Mode=OneWay}"
                                                              ValueMember="Id"
                                                              DisplayMember="Name" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Со склада"
                                            HeaderToolTip="Склад поставщика"
                                            FieldName="SupplierWarehouseName"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            FixedWidth="True"
                                            AllowAutoFilter="True"
                                            MinWidth="110"
                                            Width="110"
                                            HorizontalHeaderContentAlignment="Left" />
                            <dxg:GridColumn Header="Доставка"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="CarryType"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            ColumnFilterMode="DisplayText"
                                            FixedWidth="False"
                                            MinWidth="110"
                                            Width="110"
                                            AllowAutoFilter="True"
                                            HorizontalHeaderContentAlignment="Left"
                                            DisplayTemplate="{StaticResource CarryTypeColumnDisplayTemplate}"></dxg:GridColumn>
                            <dxg:GridColumn Header="Сумма"
                                            FieldName="TotalPrice"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            MinWidth="100"
                                            Width="170"
                                            AllowAutoFilter="True"
                                            HorizontalHeaderContentAlignment="Left">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Stretch">
                                            <dx:DXImage Source="{Binding Path=RowData.Row.PriceImage, Mode=OneWay}"
                                                        Margin="4,0,0,0"
                                                        Width="16"
                                                        Height="16" />
                                            <dxe:TextEdit x:Name="PART_Editor"
                                                          Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="БН"
                                            HeaderToolTip="БН"
                                            FieldName="ProductQuantityStr"
                                            AllowSorting="True"
                                            Width="55"
                                            MinWidth="55"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Вес"
                                            HeaderToolTip="Вес"
                                            FieldName="ProductsWeight"
                                            AllowSorting="True"
                                            Width="45"
                                            MinWidth="45"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Статус"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="State"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            MinWidth="26"
                                            Width="80"
                                            AllowAutoFilter="True"
                                            HorizontalHeaderContentAlignment="Left"
                                            DisplayTemplate="{StaticResource InvoiceStateColumnDisplayTemplate}"></dxg:GridColumn>
                            <dxg:GridColumn Header="Курс"
                                            HeaderToolTip="Курс валют"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="CurrencyRateStr"
                                            AllowResizing="False"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            FixedWidth="True"
                                            AllowAutoFilter="True"
                                            MinWidth="80"
                                            Width="120"
                                            MaxWidth="160">
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DateClose"
                                            Header="Согласование"
                                            HeaderToolTip="Согласование"
                                            HorizontalHeaderContentAlignment="Center"
                                            FixedWidth="True"
                                            MinWidth="85"
                                            Width="85"
                                            AllowGrouping="True"
                                            AllowColumnFiltering="True"
                                            GroupInterval="Date"
                                            AllowAutoFilter="True"
                                            AllowSorting="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:DateEdit x:Name="PART_Editor"
                                                      MaskUseAsDisplayFormat="True"
                                                      Mask="dd.MM.yyyy HH:mm"
                                                      HorizontalContentAlignment="Center"/>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Водитель"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="EmployeeCarrier.Name"
                                            Visible="False"
                                            AllowResizing="True"
                                            AllowGrouping="True"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="True"
                                            FilterPopupMode="CheckedList"
                                            MinWidth="24"
                                            Width="100"
                                            HorizontalHeaderContentAlignment="Left"
                                            AllowAutoFilter="True" />
                            <dxg:GridColumn Header="АР"
                                            HeaderToolTip="Авто-резерв"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="SupplierAutoReserve"
                                            Width="26"
                                            AllowResizing="False"
                                            FilterPopupMode="CheckedList"
                                            FixedWidth="True"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="З"
                                            HeaderToolTip="Заблокирован"
                                            FieldName="EmployeeLock"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="True"
                                            AllowColumnFiltering="False"
                                            MinWidth="26"
                                            Width="26"
                                            AllowAutoFilter="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding Path=RowData.Row.EmployeeLock, Mode=TwoWay, Converter={converters:ObjectToVisibilityConverter}}">
                                            <dx:DXImage Source="../../Images/Common/lock.png"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <dx:DXImage.ToolTip>
                                                    <ToolTip>
                                                        <dxlc:LayoutControl Orientation="Vertical">
                                                            <dxlc:LayoutControl.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight"
                                                                            Value="Bold"></Setter>
                                                                </Style>
                                                            </dxlc:LayoutControl.Resources>
                                                            <dxlc:LayoutItem Label="Накладную заблокировал:">
                                                                <TextBlock Text="{Binding Path=RowData.Row.EmployeeLock.Name, Mode=OneWay}"></TextBlock>
                                                            </dxlc:LayoutItem>
                                                        </dxlc:LayoutControl>
                                                    </ToolTip>
                                                </dx:DXImage.ToolTip>
                                            </dx:DXImage>
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="ТТН"
                                            HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                            FieldName="TtnsStr"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowBestFit="False"
                                            AllowColumnFiltering="False"
                                            MinWidth="100"
                                            Width="150"
                                            AllowAutoFilter="True"
                                            HorizontalHeaderContentAlignment="Left">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings TextWrapping="NoWrap"
                                                          ShowTooltipForTrimmedText="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Комментарий"
                                            FieldName="Comment"
                                            FixedWidth="True"
                                            Width="24"
                                            MinWidth="24"
                                            AllowBestFit="False"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="False"
                                            AllowSorting="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxlc:LayoutGroup Orientation="Horizontal"
                                                          Height="22">
                                            <dx:DXImage Source="../../Images/Common/comment.png"
                                                        Height="16"
                                                        Width="16"
                                                        VerticalAlignment="Center"
                                                        Margin="4 0 0 0">
                                                <dx:DXImage.ToolTip>
                                                    <ToolTip>
                                                        <dxlc:LayoutItem
                                                            Visibility="{Binding Path=RowData.Row.Comment, Mode=OneWay, Converter={converters:StringToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Path=RowData.Row.Comment, Mode=OneWay}"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="200" />
                                                        </dxlc:LayoutItem>
                                                    </ToolTip>
                                                </dx:DXImage.ToolTip>
                                                <dx:DXImage.Visibility>
                                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter ToVisibility=True}">
                                                        <Binding Path="RowData.Row.Comment"
                                                                 Converter="{dxmvvm:StringToBooleanConverter}" />
                                                    </MultiBinding>
                                                </dx:DXImage.Visibility>
                                            </dx:DXImage>
                                            <TextBlock Text="{Binding Path=RowData.Row.Comment, Mode=OneWay, Converter={converters:MultiLineToSingleLineTextConverter}}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Visibility="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget, Converter={converters:TrimmedTextBlockVisibilityConverter}}">
                                                        <ToolTip.Content>
                                                            <TextBlock Text="{Binding Path=RowData.Row.Comment}"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="200" />
                                                        </ToolTip.Content>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </dxlc:LayoutGroup>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView ShowCheckBoxSelectorColumn="False"
                                           ShowCheckBoxSelectorInGroupRow="False"
                                           ShowGroupedColumns="True"
                                           CheckBoxSelectorColumnWidth="24"
                                           AllowResizing="True"
                                           AutoWidth="True"
                                           AllowEditing="False"
                                           NavigationStyle="Cell"
                                           ShowIndicator="False"
                                           ShowAutoFilterRow="False"
                                           ShowFixedTotalSummary="False"
                                           IsTotalSummaryMenuEnabled="False"
                                           IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           ShowTotalSummary="False"
                                           CustomCellAppearance="TableViewOnCustomCellAppearance">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition FieldName="Id"
                                                         Expression="Not [State.Id] In (4, 5) And [SourceCurrentDateX] = True">
                                        <dx:Format Background="{StaticResource LightGreenColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="Not [State.Id] In (4, 5) And [DateGet] &lt; Now()"
                                                         FieldName="DateGet">
                                        <dx:Format Background="{StaticResource PinkColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition Expression="(Not [State.Id] In (2, 3, 4, 5) AND [DateArrive] &lt; Now()) OR ([State.Id] = 2 AND Now() &gt; AddMinutes([DateArrive], -15))"
                                                         FieldName="DateArrive">
                                        <dx:Format Background="{StaticResource PinkColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="DateClose"
                                                         Expression="LocalDateTimeNow() &gt;= AddHours([DateClose], -1) And LocalDateTimeNow() &lt; AddMinutes([DateClose], -30)">
                                        <dx:Format Background="{StaticResource RoseColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="DateClose"
                                                         Expression="LocalDateTimeNow() &gt;= AddMinutes([DateClose], -30) And LocalDateTimeNow() &lt; [DateClose]">
                                        <dx:Format Background="{StaticResource PinkColor}"
                                                   Foreground="Black"/>
                                    </dxg:FormatCondition>
                                    <dxg:IconSetFormatCondition Expression="[ProductsBillsQuantity] - [ProductsQuantityExceptReturned]"
                                                                SelectiveExpression="[ProductQuantityVisible] = 1"
                                                                FieldName="ProductQuantityStr">
                                        <dx:IconSetFormat ElementThresholdType="Number">
                                            <dx:IconSetElement ThresholdComparisonType="GreaterOrEqual"
                                                               Threshold="0">
                                                <dx:IconSetElement.Icon>
                                                    <BitmapImage UriSource="pack://application:,,,/DevExpress.Xpf.Core.v24.2;component/Core/ConditionalFormatting/Images/IconSets/Symbols23_1.png"
                                                                 UriCachePolicy="{x:Null}" />
                                                </dx:IconSetElement.Icon>
                                            </dx:IconSetElement>
                                        </dx:IconSetFormat>
                                    </dxg:IconSetFormatCondition>
                                </dxg:TableView.FormatConditions>
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditCommand, Mode=OneWay}"
                                                           CommandParameter="{Binding Path=CurrentItem, ElementName=InvoicesGrid}"
                                                           PassEventArgsToCommand="False" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:TableView.ColumnHeaderContentStyle>
                                    <Style TargetType="dxg:HeaderContentControl">
                                        <Setter Property="FontWeight"
                                                Value="Normal" />
                                    </Style>
                                </dxg:TableView.ColumnHeaderContentStyle>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count"
                                                 Alignment="Right"
                                                 Visible="True" />
                        </dxg:GridControl.GroupSummary>
                    </dxg:GridControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="Поиск"
                                  ItemWidth="335"
                                  MinWidth="335"
                                  MaxWidth="500"
                                  AllowClose="False"
                                  AllowDrag="False"
                                  AllowDock="True"
                                  AutoHidden="False"
                                  FloatOnDoubleClick="False"
                                  IsEnabled="{Binding IsLongOperationInProgress, Converter={dxmvvm:BooleanNegationConverter}}"
                                  behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelOpened, Mode=TwoWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <store:StoreInvoicesFilterView DataContext="{Binding Path=Filter, Mode=OneWay}" />
                        <Separator Grid.Row="1"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Margin="10,0,10,0" />
                        <dxb:ToolBarControl Grid.Row="2"
                                            GlyphSize="Small"
                                            Margin="10 5 10 5">
                            <dxb:BarButtonItem Content="Применить"
                                               Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                               Command="{Binding RefreshCommand}"
                                               GlyphAlignment="Left" />
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Отмена"
                                               Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                               Command="{Binding CancelFilteringCommand}"
                                               GlyphAlignment="Left" />
                        </dxb:ToolBarControl>
                    </Grid>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</UserControl>