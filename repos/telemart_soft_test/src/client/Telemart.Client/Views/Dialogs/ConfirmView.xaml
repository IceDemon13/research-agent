<controls:TelemartUserControl x:Class="Telemart.Client.Views.Dialogs.ConfirmView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:dialogs="clr-namespace:Telemart.Client.ViewModels.Dialogs"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              DataContext="{client:Container Type=dialogs:ConfirmViewModel}"
                              mc:Ignorable="d"
                              Width="380"
                              Height="170"
                              Loaded="OnLoaded"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type dialogs:ConfirmViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Event="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl Orientation="Vertical"
                            x:Name="ValidationContainer"
                            dxe:ValidationService.IsValidationContainer="True"
                            ItemStyle="{StaticResource LayoutItemStyle}">
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Center">
                <dxlc:LayoutItem Margin="20,0,0,15"
                                 Width="70">
                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="74"
                               Foreground="Blue"
                               Text="?">
                    </TextBlock>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem>
                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="-10,20,0,0"
                               FontSize="14"
                               Text="{Binding Path=Text, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                    </TextBlock>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Right">
                <dx:SimpleButton Content="ДА"
                                 x:Name="OkButton"
                                 Glyph="../../Images/Common/tick.png"
                                 Command="{Binding Path=OkCommand, Mode=OneTime}"
                                 IsTabStop="True"
                                 IsEnabled="True" />
                <dx:SimpleButton Content="НЕТ"
                                 Glyph="../../Images/Common/canceled.png"
                                 IsTabStop="True"
                                 Command="{Binding Path=CancelCommand, Mode=OneTime}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</controls:TelemartUserControl>
