        <dxmvvm:SaveFileDialogService x:Name="ExcelSaveFileDialogService"
                                      Title="Export Data Dialog"
                                      AddExtension="True"
                                      CheckPathExists="True"
                                      Filter="Excel Workbook|*.xlsx">
        </dxmvvm:SaveFileDialogService>
        <dxmvvm:SaveFileDialogService x:Name="XlsSaveFileDialogService"
                                      Title="Export Data Dialog"
                                      AddExtension="True"
                                      CheckPathExists="True"
                                      Filter="Excel Workbook|*.xls">
        </dxmvvm:SaveFileDialogService>
    </dxmvvm:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="FlatButtonStyle"
                           TargetType="dx:SimpleButton">
                        <Setter Property="BorderThickness"
                                Value="0" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxdo:DockLayoutManager x:Name="LayoutRoot"
                            AllowDocumentSelector="False">
        <dxdo:LayoutGroup>
            <dxdo:LayoutGroup Orientation="Vertical"
                              ItemWidth="250">
                <dxdo:LayoutPanel AllowClose="False"
                                  AllowDrag="False"
                                  AllowDock="True"
                                  AutoHidden="False"
                                  ShowHideButton="False"
                                  ShowPinButton="False"
                                  ShowRestoreButton="True"
                                  FloatOnDoubleClick="False"
                                  AllowSizing="False"
                                  ItemHeight="150"
                                  ItemWidth="250"
                                  Visibility="{Binding IsVisibilityCallDialog, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                    <dialogs:CallDialogView DataContext="{Binding Path=CallDialog, Mode=OneWay}"
                                                                                                                                                                                                                                 BorderThickness="0"/>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="Меню"
                                ItemWidth="Auto"
                                 AllowClose="False"
                                AllowDrag="False"
                                AllowDock="True"
                                AutoHidden="False"
                                ShowHideButton="True"
                                ShowPinButton="True"
                                ShowRestoreButton="True"
                                FloatOnDoubleClick="False"
                                AllowSizing="False">
                    <dxn:NavBarControl ItemsSource="{Binding Path=NavGroups, Mode=OneWay}">
                        <dxn:NavBarControl.Resources>
                            <Style TargetType="dxn:NavBarGroup">
                                <Setter Property="Header"
                                    Value="{Binding Path=Header, Mode=OneWay}" />
                                <Setter Property="ItemsSource"
                                    Value="{Binding Path=NavItems, Mode=OneWay}" />
                                <Setter Property="IsVisible"
                                    Value="{Binding Path=NavItems.Count, Mode=OneWay, Converter={dxmvvm:NumericToBooleanConverter}}" />
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Header, Mode=OneWay}"
                                                   Padding="8,4,12,0"
                                                   FontSize="16"
                                                   FontWeight="Light" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="dxn:NavBarItem">
                                <Setter Property="Content"
                                        Value="{Binding Mode=OneWay}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Grid Margin="10,1,10,1"
                                                HorizontalAlignment="Stretch"
                                                Background="Transparent"
                                                ToolTip="{Binding Path=HeaderToolTip, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <dx:SimpleButton Grid.Column="0"
                                                                 Background="Transparent"
                                                                 Command="{Binding Path=DataContext.ShowModuleCommand, Mode=OneWay, ElementName=LayoutRoot}"
                                                                 CommandParameter="{Binding Mode=OneWay}"
                                                                 Style="{StaticResource FlatButtonStyle}">
                                                    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <dx:DXImage Grid.Column="0"
                                                                Source="{Binding Path=Image, Mode=OneWay, Converter={converters:ImageConverter}}"
                                                                Width="16"
                                                                Height="16" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Path=Header, Mode=OneWay}"
                                                               Padding="4,0,0,0"
                                                               FontSize="13"
                                                               FontWeight="Normal" />
                                                </Grid>
                                                </dx:SimpleButton>
                                                <dx:SimpleButton Grid.Column="1"
                                                                 Background="Transparent"
                                                                 Visibility="{Binding Path=CanBeOpenedSimultaneously, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                                 Command="{Binding Path=DataContext.ShowModuleSimultaneouslyCommand, Mode=OneWay, ElementName=LayoutRoot}"
                                                                 CommandParameter="{Binding Mode=OneWay}"
                                                                 Style="{StaticResource FlatButtonStyle}">
                                                    <dx:DXImage Source="../Images/Common/bullet_add_16x16.png"
                                                                Width="16"
                                                                Height="16" />
                                                </dx:SimpleButton>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        </dxn:NavBarControl.Resources>
                    <dxn:NavBarControl.View>
                        <dxn:ExplorerBarView />
                    </dxn:NavBarControl.View>
                </dxn:NavBarControl>
            </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
            <dxdo:LayoutPanel AllowClose="False"
                              AllowDock="False"
                              AllowDrag="False"
                              ShowPinButton="False"
                              ShowCaption="False"
                              ShowBorder="False">
                <dx:DXTabControl AllowMerging="{x:Null}"
                                 Padding="0"
                                 TabContentCacheMode="CacheAllTabs"
                                 KeyDown="DxTabControlKeyDown">
                    <dx:DXTabControl.ItemHeaderTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ModuleHeader}">
                            <Grid ToolTip="{Binding Path=Title, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <dx:DXImage Grid.Column="0"
                                            Source="{Binding Path=Image, Mode=OneWay, Converter={converters:ImageConverter}}"
                                            Width="16"
                                            Height="16"
                                            Visibility="{Binding HasImage, Converter={dx:BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Path=Title, Mode=OneWay}"
                                           Padding="4,0,0,0"
                                           FontSize="13"
                                           FontWeight="Normal" />
                            </Grid>
                        </DataTemplate>
                    </dx:DXTabControl.ItemHeaderTemplate>
                    <dxmvvm:Interaction.Behaviors>
                        <dx:TabbedWindowDocumentUIService ShowNewItemOnStartup="False" />
                    </dxmvvm:Interaction.Behaviors>
                    <dx:DXTabControl.View>
                        <dx:TabControlStretchView HeaderLocation="Top"
                                                  ShowHeaderMenu="True"
                                                  HideButtonShowMode="InAllTabsAndHeaderArea"
                                                  RemoveTabItemsOnHiding="True"
                                                  CloseWindowOnSingleTabItemHiding="False"
                                                  SingleTabItemHideMode="Hide"
                                                  DragDropMode="ReorderOnly"/>
                    </dx:DXTabControl.View>
                </dx:DXTabControl>
            </dxdo:LayoutPanel>
        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>

</UserControl>