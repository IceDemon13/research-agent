                    <Setter Property="Width"
                            Value="{Binding Content.DataContext.Width, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Height"
                            Value="{Binding Content.DataContext.Height, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MinWidth"
                            Value="{Binding Content.DataContext.MinWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MinHeight"
                            Value="{Binding Content.DataContext.MinHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MaxWidth"
                            Value="{Binding Content.DataContext.MaxWidth, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="MaxHeight"
                            Value="{Binding Content.DataContext.MaxHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="WindowStyle"
                            Value="ToolWindow" />
                    <Setter Property="TitleAlignment"
                            Value="Center" />
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>
        <dx:WindowedDocumentUIService x:Name="NotModalSizeableDocumentManagerService"
