        <dx:WindowedDocumentUIService x:Name="OrderDocumentManagerService"
                                      DocumentShowMode="Default"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterScreen"
                                      WindowType="{x:Type dx:ThemedWindow}">
            <dx:WindowedDocumentUIService.WindowStyle>
                <Style TargetType="{x:Type dx:ThemedWindow}">
                    <Setter Property="ResizeMode"
                            Value="CanResizeWithGrip" />
                    <Setter Property="dxi:ThemedWindowOptions.AllowSystemMenu"
                            Value="False" />
                    <Setter Property="Width"
                            Value="1400" />
                    <Setter Property="Height"
                            Value="700" />
                    <Setter Property="MinWidth"
                            Value="1400" />
                    <Setter Property="MinHeight"
                            Value="700" />
                    <Setter Property="TitleAlignment"
                            Value="Center" />
                    <Setter Property="Top"
                            Value="{Binding Content.DataContext.Top, Mode=TwoWay, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Left"
                            Value="{Binding Content.DataContext.Left, Mode=TwoWay, RelativeSource={RelativeSource Self}}" />
                     <Setter Property="HeaderItemsSource">
                        <Setter.Value>
                            <dx:ThemedWindowHeaderItemsCollection>
                                <dx:SimpleButton Width="30"
                                                 Glyph="/Images/Common/user_comment_16x16.png"
                                                 Content="Обсуждения"
                                                 ToolTip="Обсуждения"
                                                 Command="{x:Static common:StyleCommands.OpenDocumentDiscussionsCommand}"
                                                 BorderBrush="Transparent"
                                                 CommandParameter="{Binding }"
                                                 Visibility="{Binding IsEnabled, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                 Background="Transparent"
                                                 Margin="0 0 5 0">
                                </dx:SimpleButton>
                                <dx:SimpleButton Width="30"
                                                 Glyph="/Images/Common/price_watch_16x16.png"
                                                 Content="Аналитика"
                                                 ToolTip="Аналитика"
                                                 Command="{x:Static common:StyleCommands.SetModuleAnalyticsPositionCommand}"
                                                 BorderBrush="Transparent"
                                                 CommandParameter="{Binding }"
                                                 Visibility="{Binding IsEnabled, Mode=OneWay, RelativeSource={RelativeSource Self}, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                 Background="Transparent"
                                                 Margin="0 0 5 0">
                                </dx:SimpleButton>
                            </dx:ThemedWindowHeaderItemsCollection>
                        </Setter.Value>
                    </Setter>
                </Style>
            </dx:WindowedDocumentUIService.WindowStyle>
        </dx:WindowedDocumentUIService>
        <dx:WindowedDocumentUIService x:Name="DialogDocumentManagerService"
                                      DocumentShowMode="Dialog"
                                      SetWindowOwner="True"
                                      WindowStartupLocation="CenterOwner"
                                      WindowType="{x:Type dx:ThemedWindow}">
