<UserControl x:Class="Telemart.Client.Views.Store.ProductBarcodesDeleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:store="clr-namespace:Telemart.Client.ViewModels.Store"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d"
             x:Name="CurrentUserControl"
             DataContext="{client:Container Type=store:ProductBarcodesDeleteViewModel}"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type store:ProductBarcodesDeleteViewModel}}"
             d:DesignHeight="300"
             d:DesignWidth="300"
             MaxWidth="1024"
             Width="550"
             MinWidth="550"
             MaxHeight="400"
             MinHeight="100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding HandleLoadedCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical">
        <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Text="Выберите Штрих-код для удаления"/>
        <dxlc:LayoutGroup Name="Center"
                          Orientation="Vertical">
            <dxg:GridControl ItemsSource="{Binding Path=Barcodes, Mode=OneWay}"
                             SelectedItem="{Binding Path=SelectedBarcode, Mode=TwoWay}"
                             SelectionMode="None">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Column"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                                   ShowCheckBoxSelectorColumn="False"
                                   AllowResizing="False"
                                   AllowSorting="False"
                                   ShowColumnHeaders="False">
                        <dxmvvm:Interaction.Behaviors>
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right">
            <Button Name="OkButton"
                    Content="Удалить"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    Width="100" />
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}"
                    Width="100" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>
