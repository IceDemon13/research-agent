<controls:TelemartUserControl x:Class="Telemart.Client.Views.Validation.ValidationResultView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Validation"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              DataContext="{client:Container Type=viewModels:ValidationResultViewModel}"
                              mc:Ignorable="d"
                              d:DesignWidth="640"
                              d:DesignHeight="480"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ValidationResultViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style TargetType="{x:Type dxg:GridControl}"
                           BasedOn="{StaticResource {x:Type dxg:GridControl}}">
                        <Setter Property="SelectionMode"
                                Value="Row"></Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Name="LayoutControl"
                        dxe:ValidationService.IsValidationContainer="True"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}">
        <dxlc:LayoutGroup>
            <dxg:GridControl ItemsSource="{Binding Path=Items, Mode=OneWay}"
                             DesignTimeDataObjectType="{x:Type viewModels:ValidationResultItem}"
                             DesignTimeDataSourceRowCount="4">
                <dxmvvm:Interaction.Behaviors>
                    <behaviors:CopyCurrentCellToClipboardBehavior />
                </dxmvvm:Interaction.Behaviors>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header=" "
                                    FieldName="IsError"
                                    FixedWidth="True"
                                    AllowResizing="False"
                                    Width="24">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Image>
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="{StaticResource ErrorImage}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RowData.Row.NotificationImageId}" Value="1">
                                                    <Setter Property="Source" Value="{StaticResource InfoImage}" />
                                                    <Setter Property="ToolTip" Value="Информация"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RowData.Row.NotificationImageId}" Value="2">
                                                    <Setter Property="Source" Value="{StaticResource WarningImage}" />
                                                    <Setter Property="ToolTip" Value="Предупреждение"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RowData.Row.NotificationImageId}" Value="3">
                                                    <Setter Property="Source" Value="{StaticResource ErrorImage}" />
                                                    <Setter Property="ToolTip" Value="Ошибка"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="Сообщение"
                                    FieldName="Message"
                                    FixedWidth="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings>
                                <dxe:TextEditSettings.TrimmedTextToolTipContentTemplate>
                                    <DataTemplate>
                                        <TextBlock MaxWidth="600"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </dxe:TextEditSettings.TrimmedTextToolTipContentTemplate>
                            </dxe:TextEditSettings>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowSorting="False"
                                   Style="{StaticResource ReadOnlyTableViewStyle}" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right">
            <Button Content="Продолжить"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    Width="100"
                    IsEnabled="{Binding Path=HasErrors, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}"
                    Width="100" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</controls:TelemartUserControl>