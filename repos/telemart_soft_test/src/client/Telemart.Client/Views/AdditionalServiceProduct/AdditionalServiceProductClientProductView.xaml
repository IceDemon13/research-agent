<UserControl x:Class="Telemart.Client.Views.AdditionalServiceProduct.AdditionalServiceProductClientProductView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.AdditionalServiceProduct"
             DataContext="{client:Container Type=viewModels:AdditionalServiceProductClientProductViewModel}"
             d:DataContext="{d:DesignInstance Type={x:Type viewModels:AdditionalServiceProductClientProductViewModel}, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             Width="450"
             Height="230"
             d:DesignHeight="200"
             d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/ReadOnlyConditionStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>

    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent"
                         Margin="0">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            IsEnabled="{Binding Path=OkCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutGroup Orientation="Vertical">
                <dxlc:LayoutItem Label="Склад принятия">
                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=AdditionalServiceWarehouses, Mode=OneWay}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"
                                      IsReadOnly="{Binding IsLocked, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                      EditValue="{Binding Path=AdditionalServiceWarehouseId, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SearchableLookUpReadOnlyConditionsStyle}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Товар">
                    <dxe:TextEdit EditValue="{Binding Path=Product, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  IsReadOnly="{Binding IsLocked, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Серийний номер">
                    <dxe:TextEdit EditValue="{Binding Path=SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  IsReadOnly="{Binding IsLocked, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Описание и комплектация"
                                 LabelVerticalAlignment="Top"
                                 VerticalAlignment="Stretch">
                    <dxe:TextEdit EditValue="{Binding Path=Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  VerticalContentAlignment="Top"
                                  MaxLength="255"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  VerticalScrollBarVisibility="Auto"
                                  IsReadOnly="{Binding IsLocked, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"
                                  Style="{StaticResource ReadOnlyConditionsStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Оставить товар у нас">
                    <dxe:CheckEdit EditValue="{Binding Path=KeepGuestProduct, Mode=TwoWay}"
                                   Style="{StaticResource ReadOnlyConditionsStyle}"
                                   IsReadOnly="{Binding IsLocked, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}"/>
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom">
                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}"
                            IsEnabled="{Binding Path=(dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Mode=OneWay, Converter={dxmvvm:BooleanNegationConverter}}" />
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>