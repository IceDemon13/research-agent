<UserControl x:Name="CurrentUserControl"
             x:Class="Telemart.Client.Views.Directories.Contractor.ContractorContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Directories.Contractor"
             Width="340"
             Height="465"
             DataContext="{client:Container Type=viewModels:ContractorContactViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ContractorContactViewModel}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary>
                    <Style x:Key="MaskPhoneTextEdit"
                           TargetType="{x:Type dxe:TextEdit}"
                           BasedOn="{StaticResource PhoneTextEdit}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsHaveMaskPhone, Mode=OneWay}"
                                         Value="True">
                                <Setter Property="MaskType" Value="RegEx" />
                                <Setter Property="Mask" Value="\d{1,20}"/>
                                <Setter Property="MaskUseAsDisplayFormat" Value="True"/>
                                <Setter Property="NullValue" Value="" />
                                <Setter Property="AllowNullInput" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
    <dxlc:LayoutControl x:Name="LayoutControl"
                        Orientation="Vertical"
                        ItemStyle="{StaticResource LayoutItemStyle}"
                        dxe:ValidationService.IsValidationContainer="True">
        <dxlc:LayoutGroup x:Name="Center"
                          Orientation="Vertical">
            <dxlc:LayoutItem Label="Фамилия">
                <dxe:TextEdit EditValue="{Binding Path=Model.Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Имя">
                <dxe:TextEdit EditValue="{Binding Path=Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Отчество">
                <dxe:TextEdit EditValue="{Binding Path=Model.Patronymic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Фамилия (англ.)">
                <dxe:TextEdit EditValue="{Binding Path=Model.SurnameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Имя (англ.)">
                <dxe:TextEdit EditValue="{Binding Path=Model.NameEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="100" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Должность">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Positions, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.Positions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True, Converter={converters:ComboBoxItemsConverter}}"
                                  DisplayMember="DisplayValue"
                                  Style="{StaticResource CheckedTokenComboBoxStyle}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Страна">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Countries, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.CountryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="Id"
                                  IsTextEditable="True"
                                  ImmediatePopup="True"
                                  IncrementalFiltering="True"
                                  ValidateOnTextInput="False"
                                  ApplyItemTemplateToSelectedItem="True">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="EditValueChanged" Command="{Binding ChangeCountryCommand}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Город">
                <dxe:ComboBoxEdit ItemsSource="{Binding Path=Cities, Mode=OneWay}"
                                  EditValue="{Binding Path=Model.CityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"
                                  DisplayMember="Name"
                                  ValueMember="Id"
                                  IsTextEditable="True"
                                  ImmediatePopup="True"
                                  IncrementalFiltering="True"
                                  ValidateOnTextInput="False"
                                  ApplyItemTemplateToSelectedItem="True">
                    <dxe:ComboBoxEdit.Buttons>
                        <dxe:ButtonInfo GlyphKind="Plus"
                                        IsEnabled="True"
                                        Command="{Binding Path=DataContext.CreateForeignCityCommand, ElementName=LayoutControl}"/>
                    </dxe:ComboBoxEdit.Buttons>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Телефон">
                <dxlc:LayoutGroup View="Group">
                    <dxe:TextEdit EditValue="{Binding Path=Model.Phone1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource MaskPhoneTextEdit}" />
                    <dxe:TextEdit EditValue="{Binding Path=Model.Phone2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaskPhoneTextEdit}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Email">
                <dxe:ButtonEdit EditValue="{Binding Path=Model.Email, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                                AllowDefaultButton="False">
                    <dxe:ButtonInfo GlyphKind="Custom"
                                    ToolTipService.ToolTip="Написать"
                                    Command="{Binding Path=MailToCommand, Mode=OneWay}"
                                    Margin="1,1,0,1">
                        <dxe:ButtonInfo.Content>
                            <dx:DXImage Margin="2 1"
                                        Source="/Images/Contractor/email_go.png" />
                        </dxe:ButtonInfo.Content>
                    </dxe:ButtonInfo>

                </dxe:ButtonEdit>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Skype">
                <dxe:TextEdit EditValue="{Binding Path=Model.Skype, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="{x:Static viewModels:ContractorConstants.SkypeMaxLength}" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Комментарий">
                <dxe:MemoEdit EditValue="{Binding Path=Model.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              MaxLength="{x:Static viewModels:ContractorConstants.CommentMaxLength}"
                              Height="22"
                              TextWrapping="Wrap"
                              PopupMinWidth="200"
                              PopupMaxWidth="500"
                              PopupMaxHeight="300"
                              AcceptsReturn="True"
                              AcceptsTab="True"
                              VerticalContentAlignment="Top"
                              MemoVerticalScrollBarVisibility="Auto"
                              MemoHorizontalScrollBarVisibility="Auto"
                              MemoTextWrapping="Wrap"
                              ShowIcon="False"
                              ShowSizeGrip="True" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Статус">
                <dxe:ListBoxEdit EditValue="{Binding Path=Model.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding Path=ContactStatuses, Mode=OneWay}"
                                 DisplayMember="Key"
                                 ValueMember="Value"
                                 ShowBorder="False">
                    <dxe:ListBoxEdit.ItemsPanel>
                        <ItemsPanelTemplate>
                            <dxlc:LayoutGroup HorizontalAlignment="Left"
                                              ItemSpace="8" />
                        </ItemsPanelTemplate>
                    </dxe:ListBoxEdit.ItemsPanel>
                    <dxe:ListBoxEdit.StyleSettings>
                        <dxe:RadioListBoxEditStyleSettings />
                    </dxe:ListBoxEdit.StyleSettings>
                </dxe:ListBoxEdit>
            </dxlc:LayoutItem>

        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
            <Button Content="OK"
                    Command="{Binding Path=OkCommand, Mode=OneWay}"
                    IsEnabled="{Binding (dxe:ValidationService.HasValidationError), ElementName=LayoutControl, Converter={dxmvvm:BooleanNegationConverter}}">
            </Button>
            <Button Content="Отмена"
                    Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>
