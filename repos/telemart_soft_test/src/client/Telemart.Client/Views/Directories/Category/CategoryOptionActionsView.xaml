<UserControl x:Class="Telemart.Client.Views.Directories.Category.CategoryOptionActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CategoryOptionInheritanceMode.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ConverterGroup x:Key="CategoryOptionInheritanceModeVisibleConverter" >
                <StaticResource ResourceKey="CategoryOptionInheritanceModeImageConverter"/>
                <dxmvvm:ObjectToBooleanConverter/>
                <dxmvvm:BooleanToVisibilityConverter/>
            </converters:ConverterGroup>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dx:DXMessageBoxService />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel x:Name="LayoutRoot"
               LastChildFill="False"
               VerticalAlignment="Stretch"
               Height="Auto">
        <DockPanel.Background>
            <Binding Path="IsCurrentValueEqualToParent"
                     Mode="OneWay">
                <Binding.Converter>
                    <dxmvvm:BooleanToObjectConverter>
                        <dxmvvm:BooleanToObjectConverter.FalseValue>
                            <SolidColorBrush Color="LightGreen" />
                        </dxmvvm:BooleanToObjectConverter.FalseValue>
                        <dxmvvm:BooleanToObjectConverter.TrueValue>
                            <SolidColorBrush Color="Transparent" />
                        </dxmvvm:BooleanToObjectConverter.TrueValue>
                    </dxmvvm:BooleanToObjectConverter>
                </Binding.Converter>
            </Binding>
        </DockPanel.Background>
        <StackPanel HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    DockPanel.Dock="Left">
            <dx:DXImage Source="{Binding Path=InheritanceMode.Id, Mode=OneWay, TargetNullValue={x:Null}, Converter={StaticResource CategoryOptionInheritanceModeImageConverter}}"
                        DataContext="{Binding}"
                        PreviewMouseLeftButtonDown="ImagePreviewMouseLeftButtonDown"
                        Visibility="{Binding Path=InheritanceMode.Id, Mode=OneWay, Converter={StaticResource CategoryOptionInheritanceModeVisibleConverter}}"
                        Height="16"
                        Width="16"
                        Margin="0 0 5 0">
                <dx:DXImage.ToolTip>
                    <ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Родительское значение: " />
                            <TextBlock Text="{Binding Path=ParentDisplayValue, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </ToolTip>
                </dx:DXImage.ToolTip>
                <dxb:BarManager.DXContextMenu>
                    <dxb:PopupMenu>
                        <dxb:PopupMenu.Items>
                            <dxb:BarButtonItem Content="Установить родительское значение"
                                               Glyph="../../../Images/CategoryOptions/MoveUp_16x16.png"
                                               Command="{Binding Path=SetParentValueCommand, Mode=OneWay}">
                                <dxb:BarButtonItem.IsEnabled>
                                    <MultiBinding Converter="{converters:BooleanAndMultiValueConverter}">
                                        <Binding Path="IsInherited"
                                                 Mode="OneWay"
                                                 Converter="{dxmvvm:BooleanNegationConverter}" />
                                        <Binding Path="InheritanceMode"
                                                 Mode="OneWay"
                                                 Converter="{converters:IsNotEqualConverter}"
                                                 ConverterParameter="{x:Static dictionaries:CategoryOptionInheritanceMode.NonInheritable}" />
                                    </MultiBinding>
                                </dxb:BarButtonItem.IsEnabled>
                            </dxb:BarButtonItem>
                            <dxb:BarButtonItem Content="Сбросить"
                                               Glyph="../../../Images/CategoryOptions/Reset_16x16.png"
                                               Command="{Binding Path=ResetCommand, Mode=OneWay}"
                                               IsEnabled="{Binding Path=IsCurrentValueChanged, Mode=OneWay}">
                            </dxb:BarButtonItem>
                        </dxb:PopupMenu.Items>
                    </dxb:PopupMenu>
                </dxb:BarManager.DXContextMenu>
            </dx:DXImage>
            <dx:DXImage Source="../../../Images/CategoryOptions/lock.png"
                        Height="16"
                        Width="16"
                        HorizontalAlignment="Left"
                        Margin="0 0 5 0"
                        Visibility="{Binding Path=IsEditable, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter Invert=True}}"
                        ToolTip="Редактирование запрещено" />
        </StackPanel>
        <TextBlock Text="{Binding Path=DisplayName, Mode=OneWay}"
                   DockPanel.Dock="Left"
                   Foreground="#FF3C3C3C"
                   FontStyle="Normal" />
        <dx:DXImage Source="../../../Images/CategoryOptions/pencil.png"
                    Height="16"
                    Width="16"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Margin="0 0 5 0"
                    Visibility="{Binding Path=IsCurrentValueChanged, Mode=OneWay, Converter={dx:BooleanToVisibilityConverter}}">
            <dx:DXImage.ToolTip>
                <ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Базовое значение: " />
                        <TextBlock Text="{Binding Path=InitialValue, Mode=OneWay}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </ToolTip>
            </dx:DXImage.ToolTip>
        </dx:DXImage>
    </DockPanel>
</UserControl>
