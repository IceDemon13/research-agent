<UserControl x:Class="Telemart.Client.Views.Service.ServiceProducts.ServiceProductDiscountView"
             x:Name="CurrentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
             xmlns:viewComponents="clr-namespace:Telemart.Client.ViewComponents"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Service.ServiceProducts"
             xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
             DataContext="{client:Container Type=viewModels:ServiceProductDiscountViewModel}"
             Width="500"
             Height="550"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ServiceProductDiscountViewModel}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="FlipItemTemplate">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel x:Name="Grid_Content">
                        <Image Margin="1"
                               VerticalAlignment="Center"
                               Source="{Binding}"
                               MaxHeight="400"/>
                        <TextBlock Text="{Binding Path= DataContext.ErrorText, Mode=OneWay, ElementName=LayoutControl}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Esc"
                             Command="{Binding Path=CancelCommand, Mode=OneWay}" />
        <dxmvvm:KeyToCommand KeyGesture="Ctrl+Enter"
                             Command="{Binding Path=OkCommand, Mode=OneWay}" />
        <dxmvvm:FolderBrowserDialogService Description="Выберите папку с фотографиями товара"
                                           RestorePreviouslySelectedDirectory="True" />
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutControl"
                            Orientation="Vertical"
                            ItemStyle="{StaticResource LayoutItemStyle}"
                            Visibility="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=True, Inverse=True}}"
                            dxe:ValidationService.IsValidationContainer="True">
            <dxlc:LayoutControl.IsEnabled>
                <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                    <Binding Path="OkCommand.IsExecuting" />
                </MultiBinding>
            </dxlc:LayoutControl.IsEnabled>
            <dxlc:LayoutGroup Name="Center"
                              Orientation="Vertical">
                <dxlc:LayoutItem Label="Склад">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=WarehouseId, Mode=OneWay}"
                                      ItemsSource="{Binding Path=Warehouses}"
                                      DisplayMember="DisplayValue"
                                      ValueMember="Id"
                                      AllowDefaultButton="False"
                                      IsTextEditable="True"
                                      Style="{StaticResource ReadOnlyEditorStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Товар">
                    <dxe:TextEdit EditValue="{Binding Path=ProductName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  Style="{StaticResource ReadOnlyEditorStyle}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Уценка">
                    <dxe:ComboBoxEdit EditValue="{Binding Path=ProductDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                      ItemsSource="{Binding Path=DiscountProducts}"
                                      DisplayMember="NameUkr">
                        <dxe:ComboBoxEdit.Buttons>
                            <dxe:ButtonInfo GlyphKind="Plus"
                                            Command="{Binding Path=CreateDiscountProductCommand, Mode=OneWay}" />
                        </dxe:ComboBoxEdit.Buttons>
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                   Command="{Binding ProductDiscountChangedCommand, Mode=OneWay}"
                                                   PassEventArgsToCommand="False" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="SN">
                    <dxe:TextEdit EditValue="{Binding Path=SerialNumber, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="True"
                                  Opacity="{StaticResource DisabledElementOpacity}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="Фото"
                                 VerticalAlignment="Stretch"
                                 LabelVerticalAlignment="Top">
                    <Border BorderThickness="1"
                            BorderBrush="Gray">
                        <dxwui:FlipView HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding Path=Images, Mode=OneWay}"
                                        ItemTemplate="{StaticResource FlipItemTemplate}" />
                    </Border>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Bottom">
                <viewComponents:WaitImage HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          BusyText="Обработка..."
                                          Visibility="{Binding Path=OkCommand.IsExecuting, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                <dxlc:LayoutGroup Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom">
                    <Button Content="OK"
                            Command="{Binding Path=OkCommand, Mode=OneWay}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter Inverse=True}">
                                <Binding Path="(dxe:ValidationService.HasValidationError)"
                                         ElementName="LayoutControl" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Content="Отмена"
                            Command="{Binding Path=CancelCommand, Mode=OneWay}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>