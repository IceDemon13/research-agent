<UserControl x:Class="Telemart.Client.Views.SupplierCurrency.SupplierCurrenciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.SupplierCurrency"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             DataContext="{client:Container Type=viewModels:SupplierCurrenciesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SupplierCurrenciesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="770">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}"/>
    </dxmvvm:Interaction.Behaviors>
    <dx:LoadingDecorator IsSplashScreenShown="{Binding Path=HandleLoadedCommand.IsExecuting, Mode=OneWay}"
                         OwnerLock="LoadingContent">
        <dxlc:LayoutControl x:Name="LayoutRoot"
                            Orientation="Vertical"
                            Padding="0"
                            ItemSpace="0">
            <dxlc:LayoutGroup>
                <dxb:BarManager VerticalAlignment="Top">
                    <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                        <dxb:BarButtonItem Content="Обновить"
                                           ToolTip="Обновить (F5)"
                                           LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                           Command="{Binding Path=RefreshCommand, Mode=OneTime}"
                                           CommandTarget="{Binding ElementName=LayoutRoot}" />
                        <dxb:BarButtonItem Content="Колонки"
                                           ToolTip="Колонки (F6)"
                                           LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                           Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                           Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                           CommandTarget="{Binding Path=View, ElementName=GridControl}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Content="Задать"
                                           LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                           Glyph="{dx:DXImage Image=Add_16x16.png}"
                                           BarItemDisplayMode="ContentAndGlyph"
                                           GlyphAlignment="Top"
                                           Command="{Binding Path=SetCoursesCommand, Mode=OneTime}"/>
                        <dxb:BarItemSeparator />
                        <controls:WikiBarButtonItem />
                    </dxb:ToolBarControl>
                </dxb:BarManager>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup>
                <dxdo:DockLayoutManager>
                    <dxdo:LayoutGroup Margin="0"
                                      Orientation="Horizontal">
                        <dxdo:LayoutGroup>
                            <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                              AllowSizing="True">
                                <dxg:GridControl x:Name="GridControl"
                                                 ItemsSource="{Binding Path=SupplierCurrencies, Mode=OneWay}"
                                                 CurrentItem="{Binding Path=SelectedSupplierCurrency, Mode=TwoWay}"
                                                 ShowBorder="False"
                                                 SelectionMode="None"
                                                 AutoExpandAllGroups="True"
                                                 ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                                    <dxmvvm:Interaction.Behaviors>
                                        <behaviors:LayoutSerializationBehavior FileName="supplier_currencies_model.xml" />
                                        <behaviors:CopyCurrentCellToClipboardBehavior />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Дата"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        HeaderToolTip="Дата добавления"
                                                        FieldName="CreatedOn"
                                                        SortIndex="0"
                                                        SortOrder="Ascending"
                                                        MinWidth="100"
                                                        Width="100">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                      Mask="dd.MM.yyyy HH:mm"
                                                                      MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Контрагент"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        FieldName="SupplierId"
                                                        AllowResizing="True"
                                                        AllowGrouping="True"
                                                        AllowBestFit="True"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText"
                                                        SortIndex="1"
                                                        SortOrder="Ascending"
                                                        FixedWidth="False"
                                                        MinWidth="140"
                                                        Width="140"
                                                        AllowAutoFilter="True"
                                                        HorizontalHeaderContentAlignment="Left">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path= Suppliers, Mode=OneWay}"
                                                                          ValueMember="Id"
                                                                          DisplayMember="Name" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Валюта"
                                                        HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="CurrencyId"
                                                        Width="50"
                                                        FixedWidth="True"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Currencies}"
                                                                          DisplayMember="Title"
                                                                          ValueMember="Id"
                                                                          HorizontalContentAlignment="Center" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Курс"
                                                        HeaderToolTip="Курс валют"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="Rate"
                                                        AllowResizing="False"
                                                        AllowGrouping="False"
                                                        AllowBestFit="True"
                                                        AllowColumnFiltering="False"
                                                        FixedWidth="True"
                                                        AllowAutoFilter="False"
                                                        MinWidth="80"
                                                        Width="120"
                                                        MaxWidth="160"/>
                                        <dxg:GridColumn Header="Рост,%"
                                                        HeaderToolTip="Рост относительно последнего курса"
                                                        HorizontalHeaderContentAlignment="Center"
                                                        FieldName="Deviation"
                                                        AllowResizing="False"
                                                        AllowGrouping="False"
                                                        AllowBestFit="True"
                                                        AllowColumnFiltering="False"
                                                        FixedWidth="True"
                                                        AllowAutoFilter="False"
                                                        MinWidth="80"
                                                        Width="120"
                                                        MaxWidth="160"
                                                        ReadOnly="True">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Left">
                                                                <dx:DXImage Source="/Images/Arrows/up_red_16_16.png"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Visibility="{Binding Path=RowData.Row.DeviationUp, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                                                <dx:DXImage Source="/Images/Arrows/down_green_16_16.png"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Visibility="{Binding Path=RowData.Row.DeviationDown, Mode=OneWay, Converter={dxmvvm:BooleanToVisibilityConverter}}" />
                                                            </StackPanel>
                                                            <dxe:SpinEdit x:Name="PART_Editor"
                                                                          Grid.Column="1"
                                                                          MaskType="Numeric"
                                                                          MaskUseAsDisplayFormat="True"
                                                                          MaskSaveLiteral="False"
                                                                          IsFloatValue="True"
                                                                          AllowDefaultButton="False"
                                                                          HorizontalContentAlignment="Right"
                                                                          Mask="##0.00"
                                                                          IsReadOnly="True"/>
                                                        </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="Создал"
                                                        FieldName="CreatedBy"
                                                        AllowResizing="True"
                                                        AllowBestFit="True"
                                                        AllowColumnFiltering="True"
                                                        FilterPopupMode="CheckedList"
                                                        ColumnFilterMode="DisplayText"
                                                        SortIndex="1"
                                                        SortOrder="Ascending"
                                                        FixedWidth="False"
                                                        MinWidth="140"
                                                        Width="140"
                                                        AllowAutoFilter="True"
                                                        HorizontalHeaderContentAlignment="Left">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=Employees, Mode=OneWay}"
                                                                          DisplayMember="DisplayValue"
                                                                          ValueMember="Id" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView ShowCheckBoxSelectorColumn="False"
                                                       ShowCheckBoxSelectorInGroupRow="False"
                                                       ShowGroupedColumns="True"
                                                       AllowResizing="True"
                                                       AutoWidth="True"
                                                       AllowEditing="False"
                                                       NavigationStyle="Row"
                                                       ShowIndicator="False"
                                                       ShowAutoFilterRow="False"
                                                       ShowFixedTotalSummary="False"
                                                       IsTotalSummaryMenuEnabled="False"
                                                       ShowTotalSummary="False"/>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxdo:LayoutPanel>
                            <dxdo:LayoutPanel Caption="Поиск"
                                              ItemWidth="355"
                                              MinWidth="355"
                                              MaxWidth="500"
                                              AllowClose="False"
                                              AllowDrag="False"
                                              AllowDock="True"
                                              AutoHidden="False"
                                              FloatOnDoubleClick="False"
                                              behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <dxlc:LayoutControl Orientation="Vertical"
                                                        ItemStyle="{StaticResource LayoutItemStyle}">
                                        <dxlc:LayoutItem Label="Дата">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Source="../../../Images/Order/Filter/calendar.png"
                                                                        Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <dxlc:LayoutGroup Orientation="Horizontal"
                                                                  VerticalAlignment="Center">
                                                <dxe:DateEdit EditValue="{Binding Path=Filter.DateAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  NullText="Не заполнено"
                                                                  NullValueButtonPlacement="EditBox"/>
                                                <TextBlock Text="-"
                                                               Width="8"
                                                               TextAlignment="Center" />
                                                <dxe:DateEdit EditValue="{Binding Path=Filter.DateBefore, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  NullText="Не заполнено"
                                                                  NullValueButtonPlacement="EditBox"/>
                                            </dxlc:LayoutGroup>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem Label="Контрагент">
                                            <dxlc:LayoutItem.LabelTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <dx:DXImage Source="../../../Images/Invoice/Filter/user_suit.png"
                                                                    Style="{StaticResource ImageStyle}" />
                                                        <TextBlock Text="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </dxlc:LayoutItem.LabelTemplate>
                                            <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Suppliers, Mode=OneWay}"
                                                              DisplayMember="DisplayValue"
                                                              EditValue="{Binding Path=Filter.SelectedSuppliers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource TokenComboBoxStyle}"></dxe:ComboBoxEdit>
                                        </dxlc:LayoutItem>
                                        <dxb:ToolBarControl GlyphSize="Small">
                                            <dxb:BarButtonItem Content="Применить"
                                                               Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                               Command="{Binding Path=RefreshCommand, Mode=OneWay}"
                                                               GlyphAlignment="Left" />
                                            <dxb:BarItemLinkSeparator />
                                            <dxb:BarButtonItem Content="Отмена"
                                                               Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                               Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}"
                                                               GlyphAlignment="Left" />
                                        </dxb:ToolBarControl>
                                    </dxlc:LayoutControl>
                                </ScrollViewer>
                            </dxdo:LayoutPanel>
                        </dxdo:LayoutGroup>
                    </dxdo:LayoutGroup>
                </dxdo:DockLayoutManager>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </dx:LoadingDecorator>
</UserControl>
