<controls:TelemartUserControl x:Class="Telemart.Client.Views.Content.ProductFeatureGroups.ProductFeaturesCatalogView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                              xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                              xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                              xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                              xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                              xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                              xmlns:client="clr-namespace:Telemart.Client"
                              xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                              xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
                              xmlns:converters="clr-namespace:Telemart.Client.Common.Converters"
                              xmlns:controlswiki="clr-namespace:Telemart.Client.Controls"
                              xmlns:commonViews="clr-namespace:Telemart.Client.Views.Common"
                              xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.Content.ProductFeatureGroups"
                              xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries"
                              xmlns:dictionaries1="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
                              mc:Ignorable="d"
                              DataContext="{client:Container Type=viewModels:ProductFeaturesCatalogViewModel}"
                              d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type viewModels:ProductFeaturesCatalogViewModel}}"
                              d:DesignWidth="1024"
                              d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
                <ResourceDictionary Source="/Telemart.Client;component/Style/CommonImages.xaml" />
                <ResourceDictionary>
                    <HierarchicalDataTemplate DataType="{x:Type viewModels:FeatureGroupViewItem}"
                                              ItemsSource="{Binding Path=Features}">
                        <TextBlock Text="{Binding Path=DataContext.Name}"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Padding="5 0 0 0" />
                    </HierarchicalDataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneTime}" />
    </dxmvvm:Interaction.Behaviors>

    <dxdo:DockLayoutManager>
        <dxdo:LayoutGroup Orientation="Horizontal"
                          Margin="0"
                          Padding="0">
            <dxdo:LayoutPanel Caption="Категории"
                              AllowClose="False"
                              AllowDrag="False"
                              AllowDock="True"
                              AutoHidden="False"
                              FloatOnDoubleClick="False"
                              ShowPinButton="False"
                              MinWidth="150"
                              MaxWidth="400"
                              ItemWidth="210">
                <commonViews:CategoryTreeView Categories="{Binding Path=Categories, Mode=OneWay}"
                                              SelectedCategory="{Binding Path=SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionMode="None"
                                              ShowBorder="False"
                                              FilterString="[IsParent] = True">
                    <commonViews:CategoryTreeView.ShowLoadingPanel>
                        <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                            <Binding Path="RefreshCommand.IsExecuting" />
                            <Binding Path="HandleLoadedCommand.IsExecuting" />
                        </MultiBinding>
                    </commonViews:CategoryTreeView.ShowLoadingPanel>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="CurrentItemChanged"
                                               Command="{Binding Path=RefreshCommand}" />
                    </dxmvvm:Interaction.Behaviors>
                </commonViews:CategoryTreeView>
            </dxdo:LayoutPanel>
            <dxdo:LayoutPanel Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <dxb:BarManager>
                        <dxb:ToolBarControl AllowQuickCustomization="False"
                                            AllowCustomizationMenu="False"
                                            IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:FocusBehavior />
                            </dxmvvm:Interaction.Behaviors>
                            <dxb:BarButtonItem Content="Обновить"
                                               ToolTip="Обновить (F5)"
                                               LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                               Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                               Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                            <dxb:BarItemSeparator />
                            <dxb:BarSubItem Content="Создать"
                                            ToolTip="Создать"
                                            LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                            Glyph="{dx:DXImage Image=Add_16x16.png}"
                                            BarItemDisplayMode="ContentAndGlyph"
                                            GlyphAlignment="Top">
                                <dxb:BarButtonItem Content="Группу"
                                                   ToolTip="Группу"
                                                   Glyph="../../../Images/Common/folder.png"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=AddFeatureGroupCommand, Mode=OneTime}" />
                                <dxb:BarButtonItem Content="Характеристику"
                                                   ToolTip="Характеристику"
                                                   Glyph="../../../Images/Common/gear_16x16.png"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=AddFeatureCommand, Mode=OneTime}"
                                                   CommandParameter="{Binding Path=CurrentFeature, Mode=OneWay}" />
                            </dxb:BarSubItem>
                            <dxb:BarButtonItem Content="Изменить"
                                               ToolTip="Изменить (F2)"
                                               LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                               Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                               Command="{Binding Path=EditFeatureCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentFeature, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Удалить"
                                               ToolTip="Удалить (Delete)"
                                               LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                               Glyph="{dx:DXImage Image=Delete_16x16.png}"
                                               Command="{Binding Path=DeleteFeatureCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentFeature, Mode=OneWay}" />
                            <dxb:BarItemSeparator />
                            <dxb:BarButtonItem Content="Порядок"
                                               LargeGlyph="{StaticResource Accordion32}"
                                               Command="{Binding Path=ReorderCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentFeature, Mode=OneWay}" />
                            <dxb:BarButtonItem Content="Значения"
                                               LargeGlyph="../../../Images/Common/list_32x32.png"
                                               Command="{Binding Path=FeatureValuesCommand, Mode=OneWay}"
                                               CommandParameter="{Binding Path=CurrentFeature, Mode=OneWay}" />
                            <dxb:BarSubItem Content="Маска"
                                            ToolTip="Маска"
                                            LargeGlyph="../../../Images/Common/mask.png"
                                            BarItemDisplayMode="ContentAndGlyph"
                                            GlyphAlignment="Top">
                                <dxb:BarButtonItem Content="Русская"
                                                   ToolTip="Русская маска"
                                                   Glyph="../../../Images/Common/flag_russia.png"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=EditMaskCommand, Mode=OneTime}"
                                                   CommandParameter="{x:Static dictionaries1:Language.RussianId}"/>
                                <dxb:BarButtonItem Content="Украинская"
                                                   ToolTip="Украинская маска"
                                                   Glyph="../../../Images/Common/flag_ukraine.png"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=EditMaskCommand, Mode=OneTime}"
                                                   CommandParameter="{x:Static dictionaries1:Language.UkrainianId}"/>
                                <dxb:BarButtonItem Content="Английская"
                                                   ToolTip="Английская маска"
                                                   Glyph="../../../Images/Common/flag_great_britain.png"
                                                   BarItemDisplayMode="ContentAndGlyph"
                                                   GlyphAlignment="Top"
                                                   Command="{Binding Path=EditMaskCommand, Mode=OneTime}"
                                                   CommandParameter="{x:Static dictionaries1:Language.EnglishId}"/>
                            </dxb:BarSubItem>
                            <dxb:BarButtonItem Content="Парсер"
                                               ToolTip="Парсер характеристик"
                                               LargeGlyph="/Images/Common/order_settings.png"
                                               Command="{Binding Path=ShowFeatureContractorParserSourceCommand, Mode=OneTime}"/>
                            <dxb:BarItemSeparator />
                            <controlswiki:WikiBarButtonItem />
                        </dxb:ToolBarControl>
                    </dxb:BarManager>
                    <StackPanel Grid.Row="1"
                                Style="{StaticResource SeparatorStackPanelStyle}" />
                    <dxg:GridControl Grid.Row="2"
                                     x:Name="GridControl"
                                     ItemsSource="{Binding Path=Features, Mode=OneWay}"
                                     CurrentItem="{Binding Path=CurrentFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AllowDrop="False"
                                     ShowBorder="False"
                                     SelectionMode="None"
                                     AutoExpandAllGroups="True"
                                     ItemsSourceChanged="GridControlOnItemsSourceChanged">
                        <dxg:GridControl.ShowLoadingPanel>
                            <MultiBinding Converter="{converters:BooleanOrMultiValueConverter}">
                                <Binding Path="RefreshCommand.IsExecuting" />
                            </MultiBinding>
                        </dxg:GridControl.ShowLoadingPanel>
                        <dxmvvm:Interaction.Behaviors>
                            <behaviors:CopyCurrentCellToClipboardBehavior />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Resources>
                            <Style TargetType="dxg:GridColumn"
                                   BasedOn="{StaticResource GeneralGridColumnStyle}" />
                        </dxg:GridControl.Resources>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Код"
                                            HorizontalHeaderContentAlignment="Center"
                                            FieldName="Id"
                                            ShowInColumnChooser="False"
                                            Width="70"
                                            AllowSorting="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Название"
                                            FieldName="Name"
                                            FixedWidth="False">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Подсказка"
                                            FieldName="Hint"
                                            FixedWidth="False">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Суффикс"
                                            FieldName="Suffix">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="С"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Отображается на сайте Telemart.ua"
                                            FieldName="ShowOnSite"
                                            FixedWidth="True"
                                            Width="24"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="-"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Не выводить на сайте значения '-'"
                                            FieldName="HideMinus"
                                            FixedWidth="True"
                                            Width="24"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Ц"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Печатать хар-ку в ценниках"
                                            FieldName="PrintInTags"
                                            FixedWidth="True"
                                            Width="24"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="М"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Мультиязычная"
                                            FieldName="MultiLanguage"
                                            FixedWidth="True"
                                            Width="24"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}" />
                            <dxg:GridColumn Header="Р"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Ручной ввод"
                                            FieldName="ManualInput"
                                            FixedWidth="True"
                                            Width="24"
                                            DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}" />
                            <dxg:GridColumn Header="З"
                                            HorizontalHeaderContentAlignment="Center"
                                            HeaderToolTip="Заблокировал"
                                            FieldName="EmployeeLockId"
                                            FixedWidth="True"
                                            Width="24"
                                            MinWidth="24"
                                            AllowBestFit="True"
                                            AllowResizing="True"
                                            AllowGrouping="False"
                                            AllowColumnFiltering="False"
                                            AllowAutoFilter="False"
                                            AllowSorting="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dx:DXImage Source="../../../Images/Common/lock.png"
                                                    Height="16"
                                                    Width="16"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Path=RowData.Row.EmployeeLockId, Mode=OneWay, Converter={converters:ObjectToVisibilityConverter}, ConverterParameter=True}"
                                                    HorizontalAlignment="Center">
                                            <dx:DXImage.ToolTip>
                                                <dxlc:LayoutControl Orientation="Vertical">
                                                    <dxlc:LayoutControl.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight"
                                                                    Value="Bold" />
                                                        </Style>
                                                    </dxlc:LayoutControl.Resources>
                                                    <dxlc:LayoutItem Label="Заблокировал:">
                                                        <TextBlock Text="{Binding Path=RowData.Row.EmployeeLockName, Mode=OneWay}" />
                                                    </dxlc:LayoutItem>
                                                </dxlc:LayoutControl>
                                            </dx:DXImage.ToolTip>
                                        </dx:DXImage>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TreeListView x:Name="TreeListView"
                                              AllowBestFit="True"
                                              AllowEditing="True"
                                              AllowFilterEditor="False"
                                              AllowColumnFiltering="False"
                                              AllowColumnMoving="False"
                                              AllowDrop="False"
                                              AllowSorting="True"
                                              NavigationStyle="Cell"
                                              AutoWidth="True"
                                              ShowIndicator="False"
                                              EditorShowMode="MouseDownFocused"
                                              AllowMoveColumnToDropArea="False"
                                              AutoExpandAllNodes="True"
                                              TreeDerivationMode="HierarchicalDataTemplate">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                           Command="{Binding Path=EditFeatureCommand, Mode=OneWay}"
                                                           CommandParameter="{Binding Path=CurrentFeature, Mode=OneWay}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TreeListView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </Grid>
            </dxdo:LayoutPanel>
        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>
</controls:TelemartUserControl>