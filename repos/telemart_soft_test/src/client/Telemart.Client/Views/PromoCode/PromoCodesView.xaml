<UserControl x:Class="Telemart.Client.Views.PromoCode.PromoCodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:client="clr-namespace:Telemart.Client"
             xmlns:behaviors="clr-namespace:Telemart.Client.Common.Behaviors"
             xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels.PromoCode"
             xmlns:business="clr-namespace:Telemart.Client.Business"
             xmlns:controls="clr-namespace:Telemart.Client.Controls"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             DataContext="{client:Container Type=viewModels:PromoCodesViewModel}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PromoCodesViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1024"
             d:DesignHeight="768">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Telemart.Client;component/Style/MainStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding Path=HandleLoadedCommand, Mode=OneWay}" />
    </dxmvvm:Interaction.Behaviors>


    <dxlc:LayoutControl x:Name="LayoutRoot"
                        Orientation="Vertical"
                        Padding="0"
                        ItemSpace="0">
        <dxlc:LayoutGroup>
            <dxb:BarManager VerticalAlignment="Top">
                <dxb:ToolBarControl IsEnabled="{Binding Path=ShowLoadingPanel, Mode=OneWay, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}">
                    <dxb:BarButtonItem Content="Обновить"
                                       ToolTip="Обновить (F5)"
                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                       Command="{Binding Path=RefreshCommand, Mode=OneTime}" />
                    <dxb:BarButtonItem Content="Колонки"
                                       ToolTip="Колонки (F6)"
                                       Glyph="{dx:DXImage Image=Columns_16x16.png}"
                                       LargeGlyph="{dx:DXImage Image=Columns_32x32.png}"
                                       Command="{x:Static dxg:GridCommands.ShowColumnChooser}"
                                       CommandTarget="{Binding Path=View, Mode=OneWay, ElementName=GridControl}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Создать"
                                       ToolTip="Создать (Insert)"
                                       LargeGlyph="{dx:DXImage Image=Add_32x32.png}"
                                       Glyph="{dx:DXImage Image=Add_16x16.png}"
                                       Command="{Binding Path=CreateCommand, Mode=OneTime}"
                                       IsVisible="True" />
                    <dxb:BarSplitButtonItem Content="Изменить"
                                            ToolTip="Изменить (F2)"
                                            GlyphAlignment="Top"
                                            Glyph="{dx:DXImage Image=Edit_16x16.png}"
                                            LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                            Command="{Binding Path=EditCommand, Mode=OneTime}"
                                            IsVisible="{Binding Path=CanEdit, Mode=OneWay}">
                        <dxb:PopupMenu>
                            <dxb:BarButtonItem Content="Отобр. в карточке"
                                               ToolTip="Отобр. в карточке"
                                               Glyph="../../Images/Common/from_web_16x16.png"
                                               Command="{Binding Path=SetShowOnSiteCommand, Mode=OneTime}" />
                        </dxb:PopupMenu>
                    </dxb:BarSplitButtonItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Content="Экспорт"
                                       ToolTip="Экспортировать в Excel (Alt+E)"
                                       LargeGlyph="/Images/Parser/excel_32_32.png"
                                       Command="{Binding Path=ExportCommand, Mode=OneWay}"
                                       CommandParameter="{Binding Mode=OneWay, ElementName=TableView}" />
                    <controls:WikiBarButtonItem />
                </dxb:ToolBarControl>
            </dxb:BarManager>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup>
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Margin="0"
                                  Orientation="Horizontal">
                    <dxdo:LayoutGroup>
                        <dxdo:LayoutPanel Style="{StaticResource PanelStyle}"
                                          AllowSizing="True">
                            <dxg:GridControl x:Name="GridControl"
                                             ItemsSource="{Binding Path=PromoCodes, Mode=OneWay}"
                                             CurrentItem="{Binding Path=SelectedPromoCode, Mode=TwoWay}"
                                             ShowBorder="False"
                                             SelectionMode="None"
                                             ShowLoadingPanel="{Binding Path=RefreshCommand.IsExecuting, Mode=OneWay}">
                                <dxmvvm:Interaction.Behaviors>
                                    <behaviors:LayoutSerializationBehavior FileName="cashboxes_1.xml" />
                                    <behaviors:CopyCurrentCellToClipboardBehavior />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Код"
                                                    HeaderToolTip="Код промокода"
                                                    FieldName="Id"
                                                    FixedWidth="True"
                                                    AllowColumnFiltering="False"
                                                    AllowGrouping="False"
                                                    Width="50"
                                                    HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Промокод"
                                                    HeaderToolTip="Промокод"
                                                    FieldName="Value"
                                                    FixedWidth="True"
                                                    Width="200"
                                                    AllowColumnFiltering="False"
                                                    AllowGrouping="False">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Заголовок"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    FieldName="MetaTitle"
                                                    AllowColumnFiltering="False"
                                                    AllowGrouping="False" />
                                    <dxg:GridColumn Header="Дата начала"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="DateStart"
                                                    FixedWidth="True"
                                                    Width="90"
                                                    MinWidth="60"
                                                    AllowBestFit="True"
                                                    AllowSorting="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    FilterPopupMode="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  NullText=""
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Дата окончания"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="DateEnd"
                                                    FixedWidth="True"
                                                    Width="90"
                                                    MinWidth="60"
                                                    AllowBestFit="True"
                                                    AllowSorting="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    FilterPopupMode="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  NullText=""
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Тип"
                                                    HeaderToolTip="Тип акции"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    FieldName="TypeId"
                                                    AllowBestFit="True"
                                                    AllowResizing="True"
                                                    MinWidth="40"
                                                    Width="60"
                                                    MaxWidth="150"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    FilterPopupMode="CheckedList"
                                                    AllowAutoFilter="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=PromoCodeTypes}"
                                                                      ValueMember="Id"
                                                                      DisplayMember="Name"
                                                                      HorizontalContentAlignment="Left" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="План продаж"
                                                    HeaderToolTip="План продаж"
                                                    FieldName="SellPlan"
                                                    FixedWidth="True"
                                                    Width="100"
                                                    AllowColumnFiltering="False"
                                                    AllowGrouping="False">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Создал"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Left"
                                                    FieldName="CreatedBy"
                                                    FixedWidth="True"
                                                    Width="150"
                                                    MinWidth="24"
                                                    AllowBestFit="True"
                                                    AllowSorting="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    ColumnFilterMode="Value"
                                                    FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings ItemsSource="{Binding Path=DataContext.Employees, Mode=OneWay, ElementName=GridControl}"
                                                                      DisplayMember="DisplayValue"
                                                                      ValueMember="Id" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Создан"
                                                    HeaderToolTip="{Binding Path=Header, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="CreatedOn"
                                                    FixedWidth="True"
                                                    Width="90"
                                                    MinWidth="60"
                                                    AllowBestFit="True"
                                                    AllowSorting="True"
                                                    AllowResizing="True"
                                                    AllowGrouping="True"
                                                    AllowColumnFiltering="True"
                                                    AllowAutoFilter="False"
                                                    FilterPopupMode="Date">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings HorizontalContentAlignment="Center"
                                                                  NullText=""
                                                                  MaskUseAsDisplayFormat="True"
                                                                  Mask="{x:Static business:DateFormattingRules.FullDateTimeFormat}"
                                                                  MaskType="DateTime" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="К"
                                                    HeaderToolTip="Отображать в карточке товара"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="ShowInSite"
                                                    Width="26"
                                                    FilterPopupMode="CheckedList"
                                                    FixedWidth="True"
                                                    DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="А"
                                                    HeaderToolTip="Активная"
                                                    HorizontalHeaderContentAlignment="Center"
                                                    FieldName="Active"
                                                    Width="26"
                                                    FilterPopupMode="CheckedList"
                                                    FixedWidth="True"
                                                    DisplayTemplate="{StaticResource BooleanTickColumnDisplayTemplate}">
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="True"
                                                   x:Name="TableView"
                                                   AllowEditing="False"
                                                   NavigationStyle="Cell"
                                                   ShowIndicator="False"
                                                   ShowAutoFilterRow="False"
                                                   ShowFixedTotalSummary="False"
                                                   IsTotalSummaryMenuEnabled="False"
                                                   ShowTotalSummary="False"
                                                   AllowSorting="True"
                                                   AllowGrouping="True"
                                                   AllowColumnFiltering="True"
                                                   AllowColumnMoving="True"
                                                   AllowResizing="True"
                                                   AllowBestFit="True"
                                                   IsColumnChooserVisible="{Binding Path=IsColumnChooserVisible, Mode=TwoWay}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand EventName="RowDoubleClick"
                                                                   Command="{Binding Path=EditCommand, Mode=OneWay}" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                                <dxg:GridControl.GroupSummary>
                                    <dxg:GridSummaryItem SummaryType="Count"
                                                         Alignment="Right"
                                                         Visible="True" />
                                </dxg:GridControl.GroupSummary>
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                    <dxdo:LayoutGroup MinWidth="360"
                                      MaxWidth="500"
                                      ItemWidth="360"
                                      Orientation="Vertical">
                        <dxdo:LayoutPanel Caption="Поиск"
                                          AllowClose="False"
                                          AllowDrag="False"
                                          AllowDock="True"
                                          AutoHidden="False"
                                          AllowHide="True"
                                          FloatOnDoubleClick="False"
                                          MinWidth="360"
                                          MaxWidth="500"
                                          ItemWidth="360"
                                          IsEnabled="{Binding Path=ShowLoadingPanel, ElementName=GridControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                          behaviors:LayoutPanelAttachedProperty.Show="{Binding Path=IsSearchPanelClosed, Mode=TwoWay}">
                            <dxlc:LayoutControl Orientation="Vertical"
                                                ItemStyle="{StaticResource LayoutItemStyle}">
                                <dxlc:LayoutItem Label="Создал">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/building.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Employees, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedCreatedByEmployees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="DisplayValue"
                                                      Style="{StaticResource TokenComboBoxStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Тип">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Order/Filter/user_green.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding Path=Filter.Types, Mode=OneWay}"
                                                      EditValue="{Binding Path=Filter.SelectedTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMember="Name"
                                                      Style="{StaticResource TokenComboBoxStyle}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Активная">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Source="../../Images/Common/tick.png"
                                                            Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <dxe:CheckEdit EditValue="{Binding Path=Filter.Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsThreeState="True" />
                                </dxlc:LayoutItem>


                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem Label="Акций">
                                    <dxlc:LayoutItem.LabelTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <dx:DXImage Style="{StaticResource ImageStyle}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxlc:LayoutItem.LabelTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=PromoCodes.Count, Mode=OneWay}"
                                                   FontWeight="Bold" />
                                        <TextBlock Text=" шт." />
                                    </StackPanel>
                                </dxlc:LayoutItem>
                                <dxlc:LayerSeparator Kind="Horizontal" />
                                <dxlc:LayoutItem>
                                    <dxb:ToolBarControl GlyphSize="Small">
                                        <dxb:BarButtonItem Content="Применить"
                                                           Glyph="{dx:DXImage Image=Apply_16x16.png}"
                                                           GlyphAlignment="Left"
                                                           Command="{Binding Path=RefreshCommand, Mode=OneWay}" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItem Content="Отмена"
                                                           Glyph="{dx:DXImage Image=Cancel_16x16.png}"
                                                           GlyphAlignment="Left"
                                                           Command="{Binding Path=CancelFilteringCommand, Mode=OneWay}" />
                                    </dxb:ToolBarControl>
                                </dxlc:LayoutItem>
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>