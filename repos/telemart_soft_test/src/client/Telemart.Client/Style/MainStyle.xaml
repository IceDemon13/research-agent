<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
                    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
                    xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
                    xmlns:viewModels="clr-namespace:Telemart.Client.ViewModels"
                    xmlns:mvvmEnhancements="clr-namespace:Telemart.Client.Common.MvvmEnhancements"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries;assembly=Telemart.Client.Dictionaries"
                    xmlns:controls="clr-namespace:Telemart.Client.Common.Controls"
                    xmlns:common="clr-namespace:Telemart.Client.Common"
                    xmlns:controls1="clr-namespace:Telemart.Client.Controls"
                    mc:Ignorable="d">

    <BitmapImage x:Key="WaitImage" UriSource="/Images/wait.gif" />

    <BitmapImage x:Key="OkImage" UriSource="/Images/ok.png" />
    <BitmapImage x:Key="WarningImage" UriSource="/Images/warning.png" />
    <BitmapImage x:Key="ErrorImage" UriSource="/Images/error.png" />
    <BitmapImage x:Key="InfoImage" UriSource="/Images/Common/information.png" />

    <BitmapImage x:Key="BulletGreenImageSource" UriSource="/Images/Common/bullet_green_16x16.png" />
    <BitmapImage x:Key="BulletYellowImageSource" UriSource="/Images/Common/bullet_yellow_16x16.png" />
    <BitmapImage x:Key="BulletRedImageSource" UriSource="/Images/Common/bullet_red_16x16.png" />
    <system:Double x:Key="DisabledElementOpacity">0.6</system:Double>
    <system:Double x:Key="EnabledElementOpacity">1</system:Double>

    <dxg:GridColumnWidth x:Key="PriceColumnWidth">70</dxg:GridColumnWidth>
    <dxg:GridColumnWidth x:Key="QuantityColumnWidth">60</dxg:GridColumnWidth>
    <system:Double x:Key="MinPriceColumnWidth">64</system:Double>
    <system:Double x:Key="MinQuantityColumnWidth">50</system:Double>

    <system:String x:Key="NullTextValue">(не задано)</system:String>

    <system:String x:Key="NegateParam">Negate</system:String>

    <system:Boolean x:Key="TrueValue">True</system:Boolean>
    <system:Boolean x:Key="FalseValue">False</system:Boolean>

    <system:Int16 x:Key="AutoSource">0</system:Int16>
    <system:Int16 x:Key="SaveSource">1</system:Int16>
    <system:Int16 x:Key="DeleteSource">2</system:Int16>

    <Brush x:Key="LightGreenColor">#CEFFCE</Brush>
    <Brush x:Key="ChineaseGreenColor">#B5FFC9</Brush>
    <Brush x:Key="NeoRedColor">#FFC7D4</Brush>
    <Brush x:Key="RoseColor">#F9E3E0</Brush>
    <Brush x:Key="PinkColor">#E07F8A</Brush>
    <Brush x:Key="TurquoiseColor">#7FFFD4</Brush>
    <Brush x:Key="RetroRedColor">#FF6C47</Brush>
    <Brush x:Key="BrazilOrangeColor">#FFC370</Brush>
    <Brush x:Key="SmokeGrey">#B5B1B0 </Brush>
    <Brush x:Key="IndonesianLava">#FFB265 </Brush>
    <Brush x:Key="GoldenFever">#CFA130</Brush>
    <Brush x:Key="DotnetCore">#743691</Brush>
    <Brush x:Key="RedCherry">#FFCC0000</Brush>
    <Brush x:Key="Black">#FF252525</Brush>
    <Brush x:Key="HoneyLight">#FFE67D</Brush>
    <dxi:ThemeResource x:Key="Foreground" ThemeKey="{dxt:PaletteBrushThemeKey ResourceKey=Foreground}"/>
    <dxi:ThemeResource x:Key="AltForeground" ThemeKey="{dxt:PaletteBrushThemeKey ResourceKey=AltPressed}"/>
    <dxi:ThemeResource x:Key="AltBackground" ThemeKey="{dxt:PaletteBrushThemeKey ResourceKey=HoverBackground}"/>
    <dxi:ThemeResource x:Key="AltHover" ThemeKey="{dxt:PaletteBrushThemeKey ResourceKey=AltHover}"></dxi:ThemeResource>
    <dxmvvm:ObjectToObjectConverter x:Key="CurrencyIdToMaskConverter">
        <dxmvvm:MapItem Source="{x:Static dictionaries:Currency.UahId}" Target="c0"/>
        <dxmvvm:MapItem Source="{x:Static dictionaries:Currency.UsdId}" Target="c2"/>
    </dxmvvm:ObjectToObjectConverter>

    <dxmvvm:ObjectToObjectConverter x:Key="IsFocusedToColorConverter"
                                    DefaultTarget="Gray">
        <dxmvvm:MapItem Source="True"
                        Target="LightGreen" />
        <dxmvvm:MapItem Source="False"
                        Target="LightPink" />
    </dxmvvm:ObjectToObjectConverter>

    <dxmvvm:ObjectToObjectConverter x:Key="IsPaidToColorConverter"
                                    DefaultTarget="Black">
        <dxmvvm:MapItem Source="True"
                        Target="Black" />
        <dxmvvm:MapItem Source="False"
                        Target="DarkGray" />
    </dxmvvm:ObjectToObjectConverter>

    <dxmvvm:ObjectToObjectConverter x:Key="BooleanToColorConverter"
                                    DefaultTarget="#FF3C3C3C"
                                    DefaultSource="False">
        <dxmvvm:MapItem Source="False"
                        Target="#FF3C3C3C" />
        <dxmvvm:MapItem Source="True"
                        Target="Red" />
    </dxmvvm:ObjectToObjectConverter>

    <Style x:Key="NoBordersButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

    <Style TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="80"/>
    </Style>

    <Style TargetType="{x:Type dx:SimpleButton}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="22" />
    </Style>

    <SolidColorBrush x:Key="AlternateRowBackgroundBrush" Color="#777771" />

    <SolidColorBrush x:Key="RegularTextBackgroundBrush" Color="#FF3C3C3C" />

    <Style TargetType="dxg:TreeListControl">
        <Setter Property="dx:ScrollBarExtensions.ScrollBarMode" Value="TouchOverlap"></Setter>
    </Style>

    <Style TargetType="dxprg:PropertyGridControl">
        <Setter Property="dx:ScrollBarExtensions.ScrollBarMode" Value="Standard"></Setter>
    </Style>

    <Style TargetType="dxg:GridControl">
        <Setter Property="dx:ScrollBarExtensions.ScrollBarMode" Value="TouchOverlap"></Setter>
    </Style>

    <Style TargetType="dxb:ToolBarControl">
        <Setter Property="AllowQuickCustomization" Value="False"/>
        <Setter Property="AllowCustomizationMenu" Value="False"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="BarItemDisplayMode" Value="ContentAndGlyph"/>
        <Setter Property="GlyphSize" Value="Large"/>
    </Style>

    <Style x:Key="SmallToolBarStyle" TargetType="dxb:ToolBarControl" BasedOn="{StaticResource {x:Type dxb:ToolBarControl}}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BarItemDisplayMode" Value="Default" />
        <Setter Property="GlyphSize" Value="Small" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style x:Key="BarItemStyle" TargetType="dxb:BarItem">
        <Setter Property="GlyphAlignment" Value="Top"></Setter>
    </Style>
    <Style TargetType="dxb:BarSubItem" BasedOn="{StaticResource BarItemStyle}">
    </Style>
    <Style TargetType="dxb:BarCheckItem" BasedOn="{StaticResource BarItemStyle}">
    </Style>
    <Style TargetType="dxb:BarButtonItem" BasedOn="{StaticResource BarItemStyle}">
    </Style>

    <Style TargetType="dxg:TableView">
        <Setter Property="AllowCascadeUpdate" Value="False"></Setter>
        <Setter Property="AllowPerPixelScrolling" Value="False"></Setter>
        <Setter Property="AllowScrollAnimation" Value="True"></Setter>
        <Setter Property="AllowFixedGroups" Value="True"></Setter>
        <Setter Property="ScrollAnimationMode" Value="EaseOut"></Setter>
        <Setter Property="ScrollingMode" Value="Smart"></Setter>
        <Setter Property="UseEvenRowBackground" Value="True"></Setter>
        <Setter Property="AlternationCount" Value="2"></Setter>
        <Setter Property="SearchPanelPosition" Value="OverGroupPanel"></Setter>
        <Setter Property="ColumnHeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BandHeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="dxg:TreeListView">
        <Setter Property="AllowCascadeUpdate" Value="False" />
        <Setter Property="AllowPerPixelScrolling" Value="False" />
        <Setter Property="AllowScrollAnimation" Value="True" />
        <Setter Property="ScrollAnimationMode" Value="EaseOut" />
        <Setter Property="ScrollingMode" Value="Smart" />
        <Setter Property="UseEvenRowBackground" Value="True" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="ColumnHeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="dxlc:LayoutControl">
        <Setter Property="ItemSpace" Value="8"></Setter>
    </Style>

    <Style TargetType="dxlc:LayoutGroup">
        <Setter Property="ItemSpace" Value="8"></Setter>
    </Style>

    <Style TargetType="{x:Type dxlc:LayerSeparator}">
        <Setter Property="Thickness"
                Value="1" />
        <Setter Property="Height"
                Value="1" />
    </Style>

    <Style x:Key="SeparatorStackPanelStyle"
           TargetType="{x:Type StackPanel}">
        <Setter Property="Height"
                Value="1" />
        <Setter Property="Background"
                Value="DarkGray" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
    </Style>

    <Style x:Key="VerticalSeparatorStackPanelStyle"
           TargetType="{x:Type StackPanel}">
        <Setter Property="Width"
                Value="1" />
        <Setter Property="Background"
                Value="DarkGray" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
    </Style>

    <Style x:Key="LayoutGroupTabStyle" TargetType="{x:Type dx:DXTabItem}">
        <Setter Property="Padding" Value="8,4,8,2" />
    </Style>

    <Style x:Key="LayoutGroupTabsStyle" TargetType="{x:Type dx:DXTabControl}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <DataTemplate x:Key="WizardHeaderTemplate">
        <Grid Background="{Binding Source={x:Static SystemParameters.WindowGlassBrush}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="14"
                       FontWeight="Bold"
                       Margin="12,10,0,0"
                       Text="{Binding Header}" />
            <TextBlock Grid.Row="1"
                       FontSize="12"
                       Margin="12,8,0,8"
                       Text="{Binding Description}" />
            <Grid Grid.Row="2" Background="DarkGray" UseLayoutRounding="True" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ValidatableComboBoxItemTemplate"
                  DataType="{x:Type mvvmEnhancements:ValidatableItem}">
        <Label Content="{Binding Path=Name, Mode=OneWay}"
               Padding="5 2 0 2">
            <Label.Style>
                <Style TargetType="{x:Type Label}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Valid, Mode=OneWay}"
                                     Value="False">
                            <Setter Property="Foreground"
                                    Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </DataTemplate>

    <Style x:Key="PhoneTextEdit" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="MaskType" Value="Simple"/>
        <Setter Property="Mask" Value="(000) 000-00-00"/>
        <Setter Property="MaskUseAsDisplayFormat" Value="True"/>
        <Setter Property="MaskSaveLiteral" Value="False"/>
        <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor"/>
    </Style>

    <Style x:Key="EdrpouTextEdit" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="MaskType" Value="Simple" />
        <Setter Property="Mask" Value="00000000" />
        <Setter Property="MaskUseAsDisplayFormat" Value="True" />
        <Setter Property="MaskSaveLiteral" Value="False" />
    </Style>

    <Style x:Key="CardNumberTextEdit" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="MaskType" Value="Simple" />
        <Setter Property="Mask" Value="0000 0000 0000 0000" />
        <Setter Property="MaskUseAsDisplayFormat" Value="True" />
        <Setter Property="MaskSaveLiteral" Value="False" />
    </Style>

    <Style x:Key="MfoTextEdit" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="MaskType" Value="Simple" />
        <Setter Property="Mask" Value="000000" />
        <Setter Property="MaskUseAsDisplayFormat" Value="True" />
        <Setter Property="MaskSaveLiteral" Value="False" />
    </Style>

    <Style x:Key="OkpoTextEdit" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="MaskType" Value="Simple" />
        <Setter Property="Mask" Value="00000000" />
        <Setter Property="MaskUseAsDisplayFormat" Value="True" />
        <Setter Property="MaskSaveLiteral" Value="False" />
    </Style>

    <Style x:Key="BasicDateEdit" TargetType="{x:Type dxe:DateEdit}">
        <Setter Property="AllowRoundOutOfRangeValue" Value="True"/>
        <Setter Property="NullText" Value="не заполнено"></Setter>
        <Setter Property="ShowNullText" Value="True"></Setter>
        <Setter Property="MaskUseAsDisplayFormat" Value="True"></Setter>
        <Setter Property="Mask" Value="g"></Setter>
        <Setter Property="MaskType" Value="DateTimeAdvancingCaret"></Setter>
        <Setter Property="StyleSettings">
            <Setter.Value>
                <dxe:DateEditCalendarStyleSettings/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BasicMemoEditStyle"
           TargetType="{x:Type dxe:MemoEdit}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="PopupMinWidth" Value="200" />
        <Setter Property="PopupMaxWidth" Value="500" />
        <Setter Property="PopupMaxHeight" Value="300" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MemoVerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MemoHorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="MemoTextWrapping" Value="Wrap" />
        <Setter Property="ShowIcon" Value="False" />
        <Setter Property="ShowSizeGrip" Value="True" />
        <Setter Property="Height" Value="22" />
    </Style>

    <Style x:Key="ReadOnlyDateEditorStyle"
           TargetType="{x:Type dxe:DateEdit}"
           BasedOn="{StaticResource BasicDateEdit}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}" />
    </Style>

    <Style x:Key="ReadOnlyEditorStyle" TargetType="{x:Type dxe:BaseEdit}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}" />
    </Style>

    <Style x:Key="ReadOnlyLookUpEditStyle" TargetType="{x:Type dxe:LookUpEditBase}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}" />
        <Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentControl>
                        <dxmvvm:EventToCommand EventName="PopupOpening"
                                               Command="{x:Static common:StyleCommands.LookUpEditPopupOpening}"
                                               PassEventArgsToCommand="True"/>
                    </ContentControl>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="AllowDefaultButton"
                Value="False" />
    </Style>

    <Style x:Key="SimpleTableViewStyle" TargetType="{x:Type dxg:TableView}">
        <Setter Property="ShowTotalSummary" Value="False"/>
        <Setter Property="ShowGroupPanel" Value="False"/>
        <Setter Property="ShowIndicator" Value="False"/>
        <Setter Property="ShowGroupFooters" Value="False"/>
        <Setter Property="ShowFixedTotalSummary" Value="False"/>
        <Setter Property="ShowAutoFilterRow" Value="False"></Setter>
        <Setter Property="ShowSearchPanelMode" Value="Never"></Setter>
        <Setter Property="AllowResizing" Value="False"></Setter>
        <Setter Property="IsColumnMenuEnabled" Value="False"></Setter>
        <Setter Property="AllowPerPixelScrolling" Value="True" />
        <Setter Property="VerticalScrollbarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollbarVisibility" Value="Hidden"/>
        <Setter Property="AutoWidth" Value="True"/>
        <Setter Property="NavigationStyle" Value="None"/>
        <!--<Setter Property="ShowVerticalLines" Value="False"/>
            <Setter Property="ShowHorizontalLines" Value="False"/>-->
    </Style>

    <Style x:Key="ReadOnlyTableViewStyle" TargetType="{x:Type dxg:TableView}" BasedOn="{StaticResource {x:Type dxg:TableView}}">
        <Setter Property="ShowTotalSummary" Value="False"/>
        <Setter Property="ShowGroupPanel" Value="False"/>
        <Setter Property="ShowIndicator" Value="False"/>
        <Setter Property="ShowGroupFooters" Value="False"/>
        <Setter Property="ShowFixedTotalSummary" Value="False"/>
        <Setter Property="ShowAutoFilterRow" Value="False"/>
        <Setter Property="ShowSearchPanelMode" Value="Never"/>
        <Setter Property="AllowResizing" Value="True"/>
        <Setter Property="IsColumnMenuEnabled" Value="False"/>
        <Setter Property="AutoWidth" Value="True"/>
        <Setter Property="NavigationStyle" Value="Cell"/>
        <Setter Property="AllowEditing" Value="False"/>
        <Setter Property="AllowColumnFiltering" Value="False"/>
        <Setter Property="AllowColumnMoving" Value="False"/>
    </Style>

    <Style x:Key="SimpleGridControlStyle" TargetType="{x:Type dxg:GridControl}">
        <Setter Property="MaxHeight" Value="1000" />
        <Setter Property="EnableSmartColumnsGeneration" Value="True" />
        <!--<Setter Property="ShowBorder" Value="False" />-->
        <Setter Property="SelectionMode" Value="Row" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="GeneralGridColumnStyle" TargetType="dxg:GridColumn">
        <Setter Property="AllowSorting" Value="False"></Setter>
        <Setter Property="AllowAutoFilter" Value="False"></Setter>
        <Setter Property="AllowBestFit" Value="False"></Setter>
        <Setter Property="AllowCellMerge" Value="False"></Setter>
        <Setter Property="AllowColumnFiltering" Value="False"></Setter>
        <Setter Property="AllowGrouping" Value="False"></Setter>
        <Setter Property="AllowMoving" Value="False"></Setter>
        <Setter Property="AllowResizing" Value="False"></Setter>
        <Setter Property="AllowEditing" Value="False"></Setter>
        <Setter Property="FixedWidth" Value="True"></Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Mode=OneWay}" FontWeight="Bold" Width="{TemplateBinding Width}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeneralTreeListColumnStyle" TargetType="dxg:TreeListColumn">
        <Setter Property="AllowSorting" Value="False"></Setter>
        <Setter Property="AllowAutoFilter" Value="False"></Setter>
        <Setter Property="AllowBestFit" Value="False"></Setter>
        <Setter Property="AllowCellMerge" Value="False"></Setter>
        <Setter Property="AllowColumnFiltering" Value="False"></Setter>
        <Setter Property="AllowMoving" Value="False"></Setter>
        <Setter Property="AllowResizing" Value="False"></Setter>
        <Setter Property="AllowEditing" Value="False"></Setter>
        <Setter Property="FixedWidth" Value="True"></Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="Bold" Width="{TemplateBinding Width}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayoutItemLabelStyle" TargetType="dxlc:LayoutItemLabel">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="Margin" Value="0,0,4,0"></Setter>
    </Style>
    <Style x:Key="LayoutItemBoldLabelStyle" TargetType="dxlc:LayoutItemLabel" BasedOn="{StaticResource LayoutItemLabelStyle}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="LayoutItemStyle" TargetType="dxlc:LayoutItem">
        <Setter Property="LabelPosition" Value="Left"/>
        <Setter Property="LabelStyle" Value="{StaticResource LayoutItemLabelStyle}"/>
        <Setter Property="AddColonToLabel" Value="True"></Setter>
    </Style>
    <Style x:Key="LayoutItemBoldStyle" TargetType="dxlc:LayoutItem" BasedOn="{StaticResource LayoutItemStyle}">
        <Setter Property="LabelStyle" Value="{StaticResource LayoutItemBoldLabelStyle}"/>
    </Style>
    <Style x:Key="GroupBoxViewStyle" TargetType="dxlc:GroupBox">
        <Setter Property="HeaderTemplate" Value="{x:Null}"></Setter>
        <Setter Property="TitleVisibility" Value="Collapsed"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="#FFD6D6D6"></Setter>
        <Setter Property="ShowShadow" Value="Never"></Setter>
        <Setter Property="Padding" Value="8,4,8,8"></Setter>
    </Style>
    <Style x:Key="GroupBoxBorderStyle" TargetType="dxlc:GroupBox">
        <Setter Property="HeaderTemplate" Value="{x:Null}"></Setter>
        <Setter Property="TitleVisibility" Value="Hidden"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="#FFD6D6D6"></Setter>
        <Setter Property="ShowShadow" Value="Never"></Setter>
    </Style>
    <Style x:Key="GroupBoxFrameStyle"
           TargetType="dxlc:GroupBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dxlc:GroupBox">
                    <dx:GroupFrame Header="{TemplateBinding Header}"
                                   HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                   Content="{TemplateBinding Content}"
                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                   VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                    </dx:GroupFrame>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SummaryGroupBoxViewStyle" TargetType="dxlc:GroupBox" BasedOn="{StaticResource GroupBoxViewStyle}">
        <Setter Property="Padding" Value="0 0 0 0"/>
        <Setter Property="Header" Value="{x:Null}"></Setter>
    </Style>
    <Style x:Key="GroupBoxWithNoPaddingStyle" TargetType="dxlc:GroupBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TitleBackground" Value="{Binding Source={x:Static SystemParameters.WindowGlassBrush}}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="GroupBoxNoBorderStyle" TargetType="dxlc:GroupBox">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    
    <Style x:Key="GroupBorderWithHeaderStyle" TargetType="dxlc:GroupBox">
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="#FFD6D6D6"></Setter>
        <Setter Property="ShowShadow" Value="Never"></Setter>
    </Style>

    <Style x:Key="GroupBoxBorderWithNoPaddingStyle" TargetType="dxlc:GroupBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TitleBackground" Value="{Binding Source={x:Static SystemParameters.WindowGlassBrush}}" />
    </Style>

    <Style x:Key="GroupBoxWithHeaderStyle" TargetType="dxlc:GroupBox">
        <Setter Property="TitleBackground" Value="{Binding Source={x:Static SystemParameters.WindowGlassBrush}}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <DataTemplate x:Key="CustomNotificationTemplate" DataType="viewModels:CustomNotificationViewModel">
        <Border Background="#FF004D99"
                BorderThickness="1"
                BorderBrush="DarkBlue"
                Margin="0,0,4,0"
                Width="400">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <dx:DXImage Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                       Source="{Binding Path=Image, Mode=OneWay}"
                       Margin="8"
                       Width="32"
                       Height="32"
                       VerticalAlignment="Top"/>
                <dxe:TextEdit Grid.Column="1" Grid.Row="0" Text="{Binding Caption, Mode=OneWay}"
                              IsPrintingMode="True"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="White"
                              Margin="4,8,0,0"
                              VerticalAlignment="Top"/>
                <dxe:TextEdit Grid.Column="1" Grid.Row="1"
                              Text="{Binding Content, Mode=OneWay}"
                              VerticalAlignment="Top"
                              IsPrintingMode="True"
                              Height="Auto"
                              TextWrapping="Wrap"
                              AcceptsReturn="True"
                              FontSize="14"
                              Foreground="White"
                              MaxWidth="333"
                              Margin="4,4,4,0"/>
            </Grid>
        </Border>
    </DataTemplate>
