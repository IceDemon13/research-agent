    </ControlTemplate>
    
    <DataTemplate x:Key="BooleanTickWithCrossItemTemplate"
                  DataType="{x:Type system:Boolean}">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <dx:DXImage x:Name="CrossImage"
                        Source="/Images/Common/cross.png"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="5,0,0,0"
                        Visibility="Collapsed" />
            <dx:DXImage x:Name="TickImage"
                        Source="/Images/Common/tick.png"
                        Height="16"
                        Width="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="5,0,0,0"
                        Visibility="Collapsed" />
        </StackPanel>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="True">
                <Setter TargetName="TickImage" Property="Visibility" Value="Visible" />
            </DataTrigger>
            
            <DataTrigger Binding="{Binding}" Value="False">
                <Setter TargetName="CrossImage" Property="Visibility" Value="Visible" />
            </DataTrigger>

            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter TargetName="CrossImage" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TickImage" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

