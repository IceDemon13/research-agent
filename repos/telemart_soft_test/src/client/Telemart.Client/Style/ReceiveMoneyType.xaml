<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dictionaries="clr-namespace:Telemart.Client.Dictionaries"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm">

    <BitmapImage x:Key="NpImage"
                 UriSource="/Images/Common/novaposhta_16x16.png" />
    <BitmapImage x:Key="OrderImage"
                 UriSource="/Images/Common/lorry_16x16.png" />
    <BitmapImage x:Key="ExcelImage"
                 UriSource="/Images/Common/table_excel_16x16.png" />
    <BitmapImage x:Key="UkrposhtaImage"
                 UriSource="/Images/Order/Carry/ukrposhta_logo.png" />
    <BitmapImage x:Key="MeestExpressImage"
                 UriSource="/Images/Order/Carry/carry12.png" />

    <dxmvvm:ObjectToObjectConverter x:Key="ReceiveMoneyTypeConverter">
        <dxmvvm:MapItem Source="{x:Static dictionaries:MoneyReceiveRecognizeType.TtnId}"
                        Target="{StaticResource NpImage}" />
        <dxmvvm:MapItem Source="{x:Static dictionaries:MoneyReceiveRecognizeType.OrderId}"
                        Target="{StaticResource OrderImage}" />
        <dxmvvm:MapItem Source="{x:Static dictionaries:MoneyReceiveRecognizeType.ExcelId}"
                        Target="{StaticResource ExcelImage}" />
        <dxmvvm:MapItem Source="{x:Static dictionaries:MoneyReceiveRecognizeType.ExcelUkrposhtaId}"
                        Target="{StaticResource UkrposhtaImage}" />
        <dxmvvm:MapItem Source="{x:Static dictionaries:MoneyReceiveRecognizeType.ExcelMeestTtnId}"
                        Target="{StaticResource MeestExpressImage}" />
    </dxmvvm:ObjectToObjectConverter>

</ResourceDictionary>